# Copia este fichero como .env y ajusta las rutas a tu máquina. El .env no se
# versiona. Solo lo necesitan las herramientas que leen el juego instalado o los
# árboles descompilados; el build, los chequeos y los tests funcionan sin él.

# La carpeta data del juego.
DATA_DIR=C:\Program Files (x86)\Steam\steamapps\common\Battle Brothers\data

# Herramientas de descompilado: sq.exe, bbsq.exe y comparer/ con los árboles.
BB_HERRAMIENTAS=C:\ruta\a\bbros\bin
