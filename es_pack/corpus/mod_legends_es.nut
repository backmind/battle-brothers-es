    // context: legend_hunting_big_game.create.m.Description
    {
        en = "When fighting beasts, this character gains an additional modifier that deals bonus damage based on the target's missing health. When not fighting beasts, they gain [color=%positive%]+10%[/color] ranged weapon damage but no additional modifier. Only works with ranged weapons."
        es = "Al luchar contra bestias, este personaje obtiene un modificador adicional que inflige daño extra en función de la salud que le falta al objetivo. Cuando no lucha contra bestias, obtiene [color=%positive%]+10%[/color] de daño con armas a distancia, pero ningún modificador adicional. Solo funciona con armas a distancia."
    }
