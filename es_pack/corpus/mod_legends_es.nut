        en = "<user:str> uses Fortify"
        es = "<user> usa Fortificar"
    }
    // FILE: scripts\skills\actives\legend_grapple_skill.nut
    // context: legend_grapple_skill.create.m.Description
    {
        en = "Grab, hold, and restrain a target, reducing their melee defense by 12 and initiative by 30% for 2 turns. A particularly lucky or skilled maneuver may disarm the opponent. One hand must be free to use."
        es = "Agarra, sujeta e inmoviliza a un objetivo, reduciendo su Defensa cuerpo a cuerpo en [color=#8f1e1e]12[/color] y su Iniciativa en un [color=#8f1e1e]30%[/color] durante [color=#8f1e1e]2[/color] turnos. Una maniobra especialmente afortunada o hábil puede desarmar al oponente. Requiere tener una mano libre."
    }
    // context: legend_grapple_skill.getTooltip.ret.push().text
    {
        en = "Has a [color=%positive%]100%[/color] chance to grapple on a hit"
        es = "Tiene un [color=%positive%]100%[/color] de probabilidad de agarrar al impactar"
    }
    // context: legend_grapple_skill.getTooltip.ret.push().text
    {
        en = "Has a [color=%negative%]-20%[/color] chance to hit"
        es = "Tiene un [color=%negative%]-20%[/color] de probabilidad de impactar"
    }
    // context: legend_grapple_skill.getTooltip.ret.push().text
    {
        en = "Has a [color=%positive%]100%[/color] chance to disarm on a hit due to unarmed mastery"
        es = "Tiene un [color=%positive%]100%[/color] de probabilidad de desarmar al impactar gracias al Dominio sin Armas"
    }
    // context: legend_grapple_skill.getTooltip.ret.push().text
    {
        en = "Has [color=%positive%]+10%[/color] chance to hit due to unarmed mastery"
        es = "Tiene un [color=%positive%]+10%[/color] de probabilidad de impactar gracias al Dominio sin Armas"
    }
    // context: legend_grapple_skill.getTooltip.ret.push().text
    {
        en = "Has a [color=%positive%]50%[/color] chance to disarm"
        es = "Tiene un [color=%positive%]50%[/color] de probabilidad de desarmar"
    }
    // context: legend_grapple_skill.onUse.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(_user) + " has grappled " + this.Const.UI.getColorizedEntityName(target) + " for two turns");
        mode = "pattern"
        en = "<user:str> has grappled <target:str> for two turns"
        es = "<user> ha agarrado a <target> durante dos turnos"
    }
    // FILE: scripts\skills\actives\legend_gruesome_feast_skill.nut
    // context: legend_gruesome_feast_skill.create.m.Description
    {
        en = "Feast on a corpse to regain health and cure injuries. Will daze and disgust any ally within four tiles."
        es = "Devora un cadáver para recuperar salud y curar heridas. Atontará y asqueará a cualquier aliado en un radio de cuatro casillas."
    }
    // context: legend_gruesome_feast_skill.onUse.a.worsenMood()
