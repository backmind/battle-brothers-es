        es = ""
    }
    // FILE: scripts\items\accessory\gloves\legend_named_glove.nut
    // context: legend_named_glove.createRandomName
    {
        // return this.getRandomCharacterName(this.Const.Strings.KnightNames) + "\'s ";
        mode = "pattern"
        en = "<this.getRandomCharacterName(this.Const.Strings.KnightNames)>'s "
        es = ""
    }
    // context: legend_named_glove.createRandomName
    {
        // return this.getRandomCharacterName(this.Const.Strings.BanditLeaderNames) + "\'s ";
        mode = "pattern"
        en = "<this.getRandomCharacterName(this.Const.Strings.BanditLeaderNames)>'s "
        es = ""
    }
    // context: legend_named_glove.onEquip.setName()
