    // FILE: scripts\skills\effects\legend_apothecary_mushrooms_effect.nut
    // context: legend_apothecary_mushrooms_effect.getDescription
    {
        // return "I can see infinity! This character is in a mushroom-induced trance and seems to barely be tied to reality. They move gracefully, avoiding attacks and barely feeling pain, but seem hesitant to hurt anything or anyone. The effect will slowly wear off over [color=%negative%]" + this.m.TurnsLeft + "[/color] more turn(s).";
        mode = "pattern"
        en = "I can see infinity! This character is in a mushroom-induced trance and seems to barely be tied to reality. They move gracefully, avoiding attacks and barely feeling pain, but seem hesitant to hurt anything or anyone. The effect will slowly wear off over [color=%negative%]<turns:int>[/color] more turn(s)."
        es = "¡Puedo ver el infinito! Este personaje está en un trance inducido por hongos y apenas parece conectado con la realidad. Se mueve con elegancia, esquivando ataques y sin apenas sentir dolor, pero parece reacio a hacer daño a nada ni a nadie. El efecto se disipará poco a poco a lo largo de [color=%negative%]<turns>[/color] turno(s) más."
    }
