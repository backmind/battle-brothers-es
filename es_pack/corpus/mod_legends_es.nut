    }
    // FILE: scripts\skills\actives\legend_firefield_skill.nut
    // context: legend_firefield_skill.create.m.Description
    {
        en = "Unleash a raging inferno at the target location that burns all beings, damaging them twice."
        es = "Desata un infierno abrasador en la ubicación objetivo que quema a todos los seres y los daña dos veces."
    }
    // context: legend_firefield_skill.getTooltip.ret.extend().text
