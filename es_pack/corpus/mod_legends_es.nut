        en = "Includes a set of sturdy metal pauldrons."
        es = "Incluye un juego de robustas hombreras de metal."
    }
    // FILE: scripts\items\legend_armor\armor_upgrades\legend_metal_plating_upgrade.nut
    // en = "Metal Plates and Rivets"
    // en base_es
    // context: legend_metal_plating_upgrade.create.m.Description
    {
        en = "Thick metal plates riveted to the underlying armor. Crude, but simple way to add protection."
        es = "Gruesas placas de metal remachadas a la armadura. Un método tosco, pero sencillo, de agregar protección."
    }
    // context: legend_metal_plating_upgrade.create.m.ArmorDescription
