        // text = "Has a range of [color=%positive%]1" + "[/color] tile"
        en = "Has a range of [color=%positive%]1[/color] tile"
        es = "Tiene un alcance de [color=%positive%]1[/color] casilla"
    }
    // context: legend_flagellate_skill.getTooltip.ret.push().text
    {
        // text = "Inflicts 3 bleeds each dealing a stacking [color=%damage%]" + dmg + "[/color] bleeding damage per turn, for 2 turns"
