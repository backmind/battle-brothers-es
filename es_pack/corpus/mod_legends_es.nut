    {
        en = "This necklace fashioned from trophies taken of slain Hexe Coven Leaders declares the one wearing it a veteran of battle against vile sorcery, and not easily daunted."
        es = "Este collar elaborado a partir de trofeos tomados de Líderes del aquelarre de Hexen asesinadas declara que quien lo lleva es un veterano de la batalla contra la hechicería vil y no se deja intimidar fácilmente."
    }
    // context: legend_hexen_leader_trophy_item.getTooltip.result.push().text
    {
        en = "[color=%positive%]+10[/color] Resolve"
        es = "[color=%positive%]+10[/color] de Resolución"
    }
    // FILE: scripts\items\accessory\legend_pack_large.nut
    // context: legend_pack_large.create.m.Name
    {
        en = "Merchant's pack"
        es = "Mochila de mercader"
    }
    // context: legend_pack_large.create.m.Description
    {
        en = "A backpack worn by merchants to carry many more supplies"
        es = "Una mochila que usan los mercaderes para cargar muchos más suministros"
    }
    // FILE: scripts\items\accessory\legend_pack_small.nut
    // context: legend_pack_small.create.m.Name
    {
        en = "Traveler's Sash"
        es = "Faja de viajero"
    }
    // context: legend_pack_small.create.m.Description
    {
        en = "A sash worn by travelers to help carry additional supplies"
        es = "Una faja que usan los viajeros para llevar suministros adicionales"
    }
    // FILE: scripts\items\accessory\legend_sighthound_item.nut
    // context: legend_sighthound_item.create.m.Name
    {
        // this.m.Name = this.Const.Strings.WardogNames[this.Math.rand(0, this.Const.Strings.WardogNames.len() - 1)] + " the Sighthound";
        mode = "pattern"
        en = "<name:str> the Sighthound"
        es = "<name> el Lebrel"
    }
    // context: legend_sighthound_item.create.m.Description
    {
        // corrige base: sobra «aunque es un poco más lento que sus hermanos del sur más ágiles», que el inglés no tiene; falta «routing» (enemigos en desbandada); «unleashed» es «soltar», no «utilizar».
        en = "A strong and loyal southern sighthound bred for war. Can be unleashed in battle for scouting, tracking or running down routing enemies."
        es = "Un lebrel del sur fuerte y leal criado para la guerra. Se puede soltar en la batalla para explorar, rastrear o perseguir a los enemigos en desbandada."
    }
    // context: legend_sighthound_item.getDescription
    {
        en = "The collar of a sighthound that has been unleashed onto the battlefield."
        es = "El collar de un lebrel que ha sido desatado en el campo de batalla."
    }
    // context: legend_sighthound_item.getName
    {
        en = "Sighthound Collar"
        es = "Collar de lebrel"
    }
    // context: legend_sighthound_item.onEquip.::Legends.Actives.grant()._skill.m.Name
    {
        en = "Unleash Sighthound"
        es = "Liberar lebrel"
    }
    // context: legend_sighthound_item.onEquip.::Legends.Actives.grant()._skill.m.Description
    {
        en = "Unleash your sighthound and send him charging into the enemy. Needs a free tile adjacent."
        es = "Suelta a tu lebrel y mándalo a la carga contra el enemigo. Necesita una casilla libre adyacente."
    }
    // FILE: scripts\items\accessory\legend_skin_ghoul_blood_flask_item.nut
    // context: legend_skin_ghoul_blood_flask_item.create.m.Name
    {
        en = "Flask of Skin Ghoul Blood"
        es = "Frasco de sangre de necrófago desollado"
    }
    // context: legend_skin_ghoul_blood_flask_item.create.m.Description
    {
        en = "This flask holds the blood of a skin ghoul, it will heal any skin it touches. If taken internally it will spread through your body, knitting flesh and closing wounds, and who knows what else."
        es = "Este frasco contiene la sangre de un necrófago desollado; cura cualquier piel que toque. Si se toma por vía interna, se extiende por todo el cuerpo, uniendo la carne y cerrando las heridas, y quién sabe qué más."
    }
    // context: legend_skin_ghoul_blood_flask_item.getTooltip.result.push().text
    {
        en = "Restores up to [color=%positive%]+10%[/color] of max health"
        es = "Restaura hasta un [color=%positive%]+10%[/color] de los Puntos de vida máximos"
    }
    // FILE: scripts\items\accessory\legend_stollwurm_blood_flask_item.nut
    // context: legend_stollwurm_blood_flask_item.create.m.Name
    {
        en = "Flask of Stollwurm Blood"
        es = "Frasco de sangre de Stollwurm"
    }
    // context: legend_stollwurm_blood_flask_item.create.m.Description
    {
        en = "This flask holds the blood of a stollwurm, that will grant intense strength and fortitude. Spreading all through your body it will turn your skin to stone for a short time."
        es = "Este frasco contiene la sangre de un stollwurm, que otorga una fuerza y una fortaleza intensas. Al extenderse por todo el cuerpo, convierte tu piel en piedra durante un breve tiempo."
    }
    // context: legend_stollwurm_blood_flask_item.getTooltip.result.push().text
    {
        en = "grants [color=%positive%]50%[/color] damage reduction, and immunity to stun, grab and knockback for three turns"
        es = "otorga un [color=%positive%]50%[/color] de reducción de daño e inmunidad al aturdimiento, los agarres y los empujones durante tres turnos"
    }
    // FILE: scripts\items\accessory\legend_therianthropy_potion_item.nut
    // context: legend_therianthropy_potion_item.create.m.Name
    {
        en = "Therianthropic Potion"
        es = "Poción teriantrópica"
    }
    // context: legend_therianthropy_potion_item.create.m.Description
    {
        en = "A foul concoction that blends the essences of beasts with that of men. Drink at your own peril."
        es = "Un brebaje inmundo que mezcla la esencia de las bestias con la de los hombres. Bébelo por tu cuenta y riesgo."
    }
    // FILE: scripts\items\accessory\legend_warbear_item.nut
    // context: legend_warbear_item.getName
    {
        en = "Bear Collar"
        es = "Collar de oso"
    }
    // context: legend_warbear_item.getDescription
    {
        en = "The collar of a bear that has been unleashed onto the battlefield."
        es = "El collar de un oso que ha sido desatado en el campo de batalla."
    }
    // context: legend_warbear_item.create.m.Name
    {
        // this.m.Name = this.Const.Strings.WarbearNames[this.Math.rand(0, this.Const.Strings.WarbearNames.len() - 1)] + " the Bear";
        mode = "pattern"
        en = "<name:str> the Bear"
        es = "<name> el Oso"
    }
    // context: legend_warbear_item.create.m.Description
    {
        en = "A strong and wild bear, not fully tamed, but powerful in battle. Can be unleashed to devastating effect, perhaps not near your allies."
        es = "Un oso fuerte y salvaje, no del todo domado, pero poderoso en la batalla. Se puede soltar con efectos devastadores, quizá no cerca de tus aliados."
    }
    // FILE: scripts\items\accessory\legend_wardog_item.nut
    // en = "<name:str> the Wardog"
    // en base_es
    // en = "A strong and loyal dog bred for war. Can be unleashed in battle for scouting, tracking or running down routing enemies."
    // en base_es
    // en = "The collar of a wardog that has been unleashed onto the battlefield."
    // en base_es
    // FILE: scripts\items\accessory\legend_warhound_item.nut
    // en = "<name:str> the Warhound"
    // en base_es
    // en = "A strong and loyal northern hound bred for war. Can be unleashed in battle for scouting, tracking or running down routing enemies."
    // en base_es
    // en = "The collar of a warhound that has been unleashed onto the battlefield."
    // en base_es
    // en = "Warhound Collar"
    // en base_es
    // en = "Unleash Warhound"
    // en base_es
    // en = "Unleash your warhound and send him charging into the enemy. Needs a free tile adjacent."
    // en base_es
    // FILE: scripts\items\accessory\legend_white_wolf_item.nut
    // context: legend_white_wolf_item.create.m.Name
    {
        // this.m.Name = this.Const.Strings.WardogNames[this.Math.rand(0, this.Const.Strings.WardogNames.len() - 1)] + " the White Wolf";
        mode = "pattern"
        en = "<name:str> the White Wolf"
        es = "<name> el Lobo Blanco"
    }
    // context: legend_white_wolf_item.create.m.Description
    {
        en = "A legendary white wolf, tamed to be a loyal companion in battle. Can be unleashed in battle."
        es = "Un legendario lobo blanco, domado para ser un compañero leal en la batalla. Se puede soltar en la batalla."
    }
    // en = "Wolf Collar"
    // en base_es
    // context: legend_white_wolf_item.getDescription
    {
        en = "The collar of a white wolf that has been unleashed onto the battlefield."
        es = "El collar de un lobo blanco que ha sido desatado en el campo de batalla."
    }
    // FILE: scripts\items\accessory\legend_wolf_item.nut
    // en = "The collar of a wolf that has been unleashed onto the battlefield."
    // en base_es
    // en = "<name:str> the Wolf"
    // en base_es
    // en = "A strong and wild wolf, tamed to be a loyal companion in battle. Can be unleashed in battle for scouting, tracking or running down routing enemies."
    // en base_es
    // FILE: scripts\items\accessory\legend_wolfsbane_necklace_item.nut
    // context: legend_wolfsbane_necklace_item.create.m.Name
    {
        en = "Wolfsbane Necklace"
        es = "Collar de acónito"
    }
    // context: legend_wolfsbane_necklace_item.create.m.Description
    {
        en = "This necklace fashioned from wolfsbane is used to surpress therianthropic beastly transformations."
        es = "Este collar hecho de acónito se usa para suprimir las transformaciones bestiales de la teriantropía."
    }
    // context: legend_wolfsbane_necklace_item.getTooltip.result.push().text
    {
        en = "Stops the wearer transforming into a werecreature"
        es = "Impide que quien lo lleva se transforme en una criatura cambiaformas"
    }
    // FILE: scripts\items\accessory\special\legend_arena_collar_item.nut
    // context: legend_arena_collar_item.create.m.Name
    {
        en = "Legend Arena Collar"
        es = "Collar de la Arena"
    }
    // context: legend_arena_collar_item.create.m.Description
    {
        // corrige base: errata «de la arena en sur» → «de las arenas del sur» (el inglés dice «southern arenas», en plural).
        en = "A collar worn by combatants in the Grand Tournament."
        es = "Un collar que llevan los combatientes del Gran Torneo."
    }
    // FILE: scripts\items\accessory\special\legend_oms_amphora_item.nut
    // context: legend_oms_amphora_item.getName
    {
        // return this.item.getName() + " (Consumed)";
        mode = "pattern"
        en = "<name:str> (Consumed)"
        es = "<name> (Consumida)"
    }
    // context: legend_oms_amphora_item.create.m.Name
    {
        en = "Ancient Amphora"
        es = "Ánfora antigua"
    }
    // context: legend_oms_amphora_item.create.m.Description
    {
        en = "An ancient glazed pot that has seen much use before your time. It depicts specific characters fighting over ripe fields with the amphora at the centre - a sickly grey mulch resides inside. When emptied, the vessel appears to gradually refill from a second chamber within the walls of the item. The freshness of the drink does not improve."
        es = "Una antigua vasija vidriada que ha visto mucho uso antes de tu tiempo. Representa a ciertos personajes que luchan sobre campos maduros con el ánfora en el centro; dentro reposa un mantillo gris y enfermizo. Al vaciarla, la vasija parece rellenarse poco a poco desde una segunda cámara oculta en sus paredes. La frescura de la bebida no mejora."
    }
    // context: legend_oms_amphora_item.getTooltip.result.push().text
    {
        en = "You aren't sure what it does. You've heard of an ancient witch living in a hut in the forest and an Oracle somewhere in the south who might know more about this"
        es = "No sabes muy bien qué hace. Has oído hablar de una antigua bruja que vive en una choza en el bosque y de un Oráculo en algún lugar del sur que quizá sepan algo más"
    }
    // context: legend_oms_amphora_item.getTooltip.result.push().text
    {
        en = "Drinking in battle provides a random status effect. May be harmful or helpful. Refills after every battle"
        es = "Beber de ella en batalla otorga un efecto de estado aleatorio. Puede ser perjudicial o beneficioso. Se rellena tras cada batalla"
    }
    // FILE: scripts\items\accessory\special\legend_oms_fate_item.nut
    // context: legend_oms_fate_item.create.m.Name
    {
        en = "The 'Book of Fate'"
        es = "El 'Libro del Destino'"
    }
    // context: legend_oms_fate_item.create.m.Description
    {
        en = "This volume titled 'Book of Fate' contains a single, thick page between two slabs of old leather from an unknown animal. The page is blank on both sides and stained throughout - some say that if the holder sees only a blank page they are fully in control of their destiny...or soon to die. This is possibly an elaborate scam, but you can't deny the item does feel much heavier than it should do."
        es = "Este volumen titulado «Libro del Destino» contiene una única y gruesa página entre dos tapas de cuero viejo de un animal desconocido. La página está en blanco por ambas caras y manchada de arriba abajo; hay quien dice que si quien lo sostiene solo ve una página en blanco, tiene pleno control de su destino... o está a punto de morir. Posiblemente sea una estafa elaborada, pero no puedes negar que el objeto pesa mucho más de lo que debería."
    }
    // context: legend_oms_fate_item.getTooltip.result.push().text
    {
        en = "Chance to survive after being struck down will always be zero. Gain +40% chance to reroll an attack that would normally hit you"
        es = "La probabilidad de sobrevivir a un golpe mortal siempre será cero. Otorga un +40% de probabilidad de obligar a repetir la tirada de un ataque que normalmente te alcanzaría"
    }
    // FILE: scripts\items\accessory\special\legend_oms_ledger_item.nut
    // context: legend_oms_ledger_item.create.m.Name
    {
        en = "Bound Skin Ledger"
        es = "Libro mayor encuadernado en piel"
    }
    // context: legend_oms_ledger_item.create.m.Description
    {
        en = "A small ledger that is made of skin, inside the pages are names laid out in rows, some crossed or or with symbols beside them. Closing and opening the book again results in the names and markings changing once again."
        es = "Un pequeño libro de cuentas hecho de piel; en sus páginas hay nombres dispuestos en filas, algunos tachados o con símbolos al lado. Al cerrar y volver a abrir el libro, los nombres y las marcas vuelven a cambiar."
    }
    // context: legend_oms_ledger_item.getTooltip.result.push().text
    {
        en = "You aren't sure what it does. You've heard of an ancient Witch living in a hut in the forest and an Oracle somewhere in the south who might know more about this"
        es = "No sabes muy bien qué hace. Has oído hablar de una antigua Bruja que vive en una choza en el bosque y de un Oráculo en algún lugar del sur que quizá sepan más sobre esto"
    }
    // context: legend_oms_ledger_item.getTooltip.result.push().text
    {
        en = "Melee damage received from undead reduced by 50%"
        es = "El daño cuerpo a cuerpo recibido de no muertos se reduce un 50%"
    }
    // FILE: scripts\items\accessory\special\legend_oms_paw_item.nut
    // context: legend_oms_paw_item.create.m.Name
    {
        en = "Curious Paw"
        es = "Zarpa curiosa"
    }
    // context: legend_oms_paw_item.create.m.Description
    {
        en = "A preserved hand that is somewhere between that of a large man and a beast. It has been cleanly cut at the wrist and shows no sign of decay."
        es = "Una mano conservada que está a medio camino entre la de un hombre corpulento y la de una bestia. La han cortado limpiamente por la muñeca y no muestra signos de descomposición."
    }
    // context: legend_oms_paw_item.getTooltip.result.push().text
    {
        en = "Adds an addition +6 to fatigue recovery per turn. Increases the effect from morale effects and mental attacks by 50%"
        es = "Añade un +6 adicional a la recuperación de fatiga por turno. Aumenta en un 50% los efectos de moral y de los ataques mentales"
    }
    // FILE: scripts\items\accessory\special\legend_oms_rib_item.nut
    // context: legend_oms_rib_item.create.m.Name
    {
        en = "Saint's Rib"
        es = "Costilla del santo"
    }
    // context: legend_oms_rib_item.create.m.Description
    {
        en = "A supposed rib bone from a long dead saint, locked away in a secure chest. Apparently the figure in question was killed by a volley of arrows — it has been picked clean and preserved with great care and thought. More superstitious minds claim it to be warm to the touch."
        es = "Una supuesta costilla de un santo muerto hace mucho tiempo, guardada bajo llave en un cofre seguro. Al parecer, el personaje en cuestión murió bajo una andanada de flechas; la costilla ha sido descarnada por completo y conservada con gran esmero y cuidado. Las mentes más supersticiosas aseguran que está tibia al tacto."
    }
    // context: legend_oms_rib_item.getTooltip.result.push().text
    {
        en = "Damage from ranged weapons reduced by 66%. Damage received from melee weapons increased by 33%"
        es = "El daño de las armas a distancia se reduce un 66%. El daño recibido de armas cuerpo a cuerpo aumenta un 33%"
    }
    // FILE: scripts\items\ammo\legend_armor_piercing_arrows.nut
    // context: legend_armor_piercing_arrows.create.m.Name
    {
        en = "Armor Piercing Arrows"
        es = "Flechas antiarmadura"
    }
    // context: legend_armor_piercing_arrows.create.m.Description
    {
        en = "A quiver of arrows with piercing tips, designed for punching through thick armor. Is automatically refilled after each battle if you have enough ammunition. Grants 30% more armor piercing, but 10% less damage while wielding a bow."
        es = "Un carcaj de flechas con puntas perforantes, diseñadas para atravesar armaduras gruesas. Se recarga automáticamente después de cada batalla si tienes suficiente munición. Otorga un 30% más de daño que ignora la armadura, pero un 10% menos de daño al empuñar un arco."
    }
    // context: legend_armor_piercing_arrows.getTooltip.result.push().text
    {
        // text = "Contains [color=%positive%]" + this.m.Ammo + "[/color] arrows"
        mode = "pattern"
        en = "Contains [color=%positive%]<ammo:int>[/color] arrows"
        es = "Contiene [color=%positive%]<ammo>[/color] flechas"
    }
    // context: legend_armor_piercing_arrows.getTooltip.result.push().text
    {
        en = "[color=%negative%]Is empty and useless[/color]"
        es = "[color=%negative%]Está vacío y es inútil[/color]"
    }
    // FILE: scripts\items\ammo\legend_armor_piercing_bolts.nut
    // context: legend_armor_piercing_bolts.create.m.Name
    {
        en = "Armor Piercing Bolts"
        es = "Virotes antiarmadura"
    }
    // context: legend_armor_piercing_bolts.create.m.Description
    {
        en = "A large quiver of bolts with thin piercing tips, designed for piercing armor, but doing less damage to flesh. Is automatically refilled after each battle if you have enough global ammunition. Grants 20% more armor piercing damage, but 10% less damage, while wielding a crossbow."
        es = "Un carcaj grande de virotes con finas puntas perforantes, diseñados para atravesar armaduras, pero que hacen menos daño a la carne. Se recarga automáticamente después de cada batalla si tienes suficiente munición en reserva. Otorga un 20% más de daño que ignora la armadura, pero un 10% menos de daño, al empuñar una ballesta."
    }
    // context: legend_armor_piercing_bolts.getTooltip.result.push().text
    {
        // text = "Contains [color=%positive%]" + this.m.Ammo + "[/color] bolts"
        mode = "pattern"
        en = "Contains [color=%positive%]<ammo:int>[/color] bolts"
        es = "Contiene [color=%positive%]<ammo>[/color] virotes"
    }
    // FILE: scripts\items\ammo\legend_broad_head_arrows.nut
    // context: legend_broad_head_arrows.create.m.Name
    {
        en = "Broad Head Arrows"
        es = "Flechas de punta ancha"
    }
    // context: legend_broad_head_arrows.create.m.Description
    {
        en = "A quiver of arrows with broad tips, designed for tearing flesh, but easily stopped by armor. Is automatically refilled after each battle if you have enough global ammunition. Grants 10% more damage, but 10% less armor piercing damage while wielding a bow."
        es = "Un carcaj de flechas con puntas anchas, diseñadas para desgarrar la carne, pero que la armadura detiene con facilidad. Se recarga automáticamente después de cada batalla si tienes suficiente munición en reserva. Otorga un 10% más de daño, pero un 10% menos de daño que ignora la armadura al empuñar un arco."
    }
    // FILE: scripts\items\ammo\legend_broad_head_bolts.nut
    // context: legend_broad_head_bolts.create.m.Name
    {
        en = "Broad Head Bolts"
        es = "Virotes de punta ancha"
    }
    // context: legend_broad_head_bolts.create.m.Description
    {
        en = "A quiver of bolts with broad tips, designed for tearing flesh, but easily stopped by armor. Is automatically refilled after each battle if you have enough global ammunition. Grants 10% more damage, but 10% less armor piercing damage while wielding a crossbow."
        es = "Un carcaj de virotes con puntas anchas, diseñados para desgarrar la carne, pero que la armadura detiene con facilidad. Se recarga automáticamente después de cada batalla si tienes suficiente munición en reserva. Otorga un 10% más de daño, pero un 10% menos de daño que ignora la armadura al empuñar una ballesta."
    }
    // FILE: scripts\items\ammo\legend_darts.nut
    // context: legend_darts.create.m.Name
    {
        en = "Bag of Darts"
        es = "Bolsa de dardos"
    }
    // context: legend_darts.create.m.Description
    {
        en = "A bag of darts, required to use blow guns of all kinds. Is automatically refilled after each battle if you have enough ammunition."
        es = "Una bolsa de dardos, necesaria para usar cerbatanas de todo tipo. Se recarga automáticamente después de cada batalla si tienes suficiente munición."
    }
    // context: legend_darts.getTooltip.result.push().text
    {
        // text = "Contains [color=%positive%]" + this.m.Ammo + "[/color] darts"
        mode = "pattern"
        en = "Contains [color=%positive%]<ammo:int>[/color] darts"
        es = "Contiene [color=%positive%]<ammo>[/color] dardos"
    }
    // FILE: scripts\items\ammo\legend_huge_quiver_of_arrows.nut
    // context: legend_huge_quiver_of_arrows.create.m.Name
    {
        en = "Huge Quiver of Arrows"
        es = "Carcaj enorme de flechas"
    }
    // context: legend_huge_quiver_of_arrows.create.m.Description
    {
        en = "A huge quiver of arrows, required to use bows of all kinds. Is automatically refilled after each battle if you have enough ammunition."
        es = "Un carcaj enorme de flechas, necesario para usar arcos de todo tipo. Se recarga automáticamente después de cada batalla si tienes suficiente munición."
    }
    // FILE: scripts\items\ammo\legend_huge_quiver_of_bolts.nut
    // context: legend_huge_quiver_of_bolts.create.m.Name
    {
        en = "Huge Quiver of Bolts"
        es = "Carcaj enorme de virotes"
    }
    // context: legend_huge_quiver_of_bolts.create.m.Description
    {
        en = "A huge quiver of bolts, required to use crossbows. Is automatically refilled after each battle if you have enough ammunition."
        es = "Un carcaj enorme de virotes, necesario para usar ballestas. Se recarga automáticamente después de cada batalla si tienes suficiente munición."
    }
    // FILE: scripts\items\ammo\legend_large_armor_piercing_arrows.nut
    // context: legend_large_armor_piercing_arrows.create.m.Name
    {
        en = "Large Quiver of Armor Piercing Arrows"
        es = "Carcaj grande de flechas antiarmadura"
    }
    // context: legend_large_armor_piercing_arrows.create.m.Description
    {
        en = "A large quiver of arrows with piercing tips, designed for punching through thick armor. Is automatically refilled after each battle if you have enough ammunition. Grants 30% more armor piercing, but 10% less damage while wielding a bow."
        es = "Un carcaj grande de flechas con puntas perforantes, diseñadas para atravesar armaduras gruesas. Se recarga automáticamente después de cada batalla si tienes suficiente munición. Otorga un 30% más de daño que ignora la armadura, pero un 10% menos de daño al empuñar un arco."
    }
    // FILE: scripts\items\ammo\legend_large_armor_piercing_bolts.nut
