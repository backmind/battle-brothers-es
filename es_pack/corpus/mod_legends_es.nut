    // en base_es
    // context: legend_mail_patch_upgrade.create.m.Description
    {
        en = "A large patch of mail that can be added to any armor to protect the arms and the shoulders."
        es = "Un gran parche de malla que se puede agregar a cualquier armadura para proteger los brazos y los hombros."
