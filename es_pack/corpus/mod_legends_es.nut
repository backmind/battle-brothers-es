        en = "\nThis item has the power of the rune sigil of Durability:\n[color=%positive%]+%bonus1%[/color] additional Durability added to shield.\nHas [color=%positive%]%bonus2%%[/color] chance to ignore damage to shield.\n	"
        es = "\nEste objeto posee el poder del sello rúnico de Durabilidad:\n[color=%positive%]+%bonus1%[/color] de Durabilidad adicional para el escudo.\nTiene una probabilidad del [color=%positive%]%bonus2%%[/color] de ignorar el daño al escudo.\n	"
