    // FILE: mod_legends\hooks\retinue\followers\surgeon_follower.nut
    // context: surgeon_follower.o.create.m.Name
    {
        en = "Triage Table"
        es = ""
    }
    // context: surgeon_follower.o.create.m.Description
    {
        en = "Having an area set up and ready to treat the worst injuries could be the hair between life and death for the company. Maybe even yourself...one day."
        es = ""
