    // context: legend_wake_ally_aoe_skill.getTooltip.ret.text
    {
        // corrige base: sobra el punto final, que el inglés no lleva en este texto de tooltip
        en = "Removes the Sleeping and Nightmares status effects"
        es = "Elimina los efectos de estado 'Durmiendo' y 'Pesadillas'"
    }
    // FILE: scripts\skills\actives\legend_warfork_disarm_skill.nut
    // context: legend_warfork_disarm_skill.create.m.Description
    {
        en = "Use the warfork's particular shape to temporarily disarm an opponent on a hit. A disarmed opponent can not use any weapon skills, but may still use other skills and move freely. Unarmed targets can not be disarmed."
        es = "Aprovecha la forma particular de la horca de guerra para desarmar temporalmente a un oponente al impactar. Un oponente desarmado no puede usar ninguna habilidad de arma, pero sí otras habilidades, y puede moverse libremente. Los objetivos sin armas no pueden ser desarmados."
    }
    // FILE: scripts\skills\actives\legend_werewolf_claws_skill.nut
