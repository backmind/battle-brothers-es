    {
        en = "Scouting Party"
        es = "Partida de exploración"
    }
    // context: legend_camp_legion_hunt_nobles_contract.spawnEnemies.party.setDescription()
    {
        en = "A small scouting party of a Noble house."
        es = "Una pequeña partida de exploración de una casa noble."
    }
    // en = "Patrol"
    // en base_es
    // context: legend_camp_legion_hunt_nobles_contract.spawnRevengeEnemies.party.setDescription()
    {
        en = "A large force hunting you down."
        es = "Una gran fuerza que te da caza."
    }
    // FILE: scripts\contracts\contracts\legend_camp_smuggle_contract.nut
    // context: legend_camp_smuggle_contract.::inherit().create.m.Name
    {
        en = "Smuggle item"
        es = "Contrabando"
    }
    // context: legend_camp_smuggle_contract.::inherit().create.m.DescriptionTemplates
    {
        en = "Bandits want to procure an item, but as outlaws they cannot enter town."
        es = "Unos bandidos quieren conseguir un objeto, pero como son forajidos no pueden entrar en la ciudad."
    }
    // context: legend_camp_smuggle_contract.::inherit().create.m.DescriptionTemplates
    {
        en = "Local criminal is in dire need of new equipment. You can help them smuggle goods."
        es = "Una figura del hampa local necesita con urgencia equipo nuevo. Puedes ayudarla a pasar mercancía de contrabando."
    }
    // context: legend_camp_smuggle_contract.::inherit().create.m.DescriptionTemplates
    {
        en = "Mysterious cargo, back alley handovers - honest pay for dishonest work."
        es = "Cargamento misterioso, entregas en callejones: paga honrada por un trabajo poco honrado."
    }
    // context: legend_camp_smuggle_contract.::inherit().createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        // "Pick up requested item from " + this.Contract.m.Town.getName()
        mode = "pattern"
        en = "Pick up requested item from <town:str>"
        es = "Recoge el objeto solicitado en <town>"
    }
    // context: legend_camp_smuggle_contract.::inherit().createStates.m.States.push().ID
    // en = "Delivery"  // identificador de estado del contrato (ID), no se muestra
    // context: legend_camp_smuggle_contract.::inherit().createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        en = "Deliver requested item to bandit camp"
        es = "Entrega el objeto solicitado en el campamento bandido"
    }
    // en = "Revenge"
    // context: legend_camp_smuggle_contract.::inherit().createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        en = "Wait for your employer to contact you"
        es = "Espera a que tu patrón se ponga en contacto contigo"
    }
    // context: legend_camp_smuggle_contract.::inherit().createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_camp_hunt.png[/img]{With a cocky grin, %employer% strolls into your tent like %they_employer% owns the place. %SPEECH_ON%I need a favor. %Town%'s got something of mine, but I'm not welcome here. Could you, uh, go shopping for me?%SPEECH_OFF% }"
        es = "[img]gfx/ui/events/legend_camp_hunt.png[/img]{Con una sonrisa arrogante, %employer% entra en tu tienda como si fuera dueñ%o_employer% del lugar. %SPEECH_ON%Necesito un favor. En %Town% tienen algo mío, pero aquí no soy bienvenid%o_employer%. ¿Podrías, eh, ir de compras por mí?%SPEECH_OFF% }"
    }
    // context: legend_camp_smuggle_contract.::inherit().createScreens.m.Screens.push().Options.Text
    {
        en = "{The %companyname% can help for the right price. | Let's talk crowns.}"
        es = "{%companyname% puede ayudar por el precio adecuado. | Hablemos de coronas.}"
    }
    // en = "\x7bThis doesn't sound like our kind of work. | This won't be worth the risk.\x7d"
    // en base_es
    // context: legend_camp_smuggle_contract.::inherit().createScreens.m.Screens.push().Title
    {
        en = "Inside town"
        es = "En la ciudad"
    }
    // context: legend_camp_smuggle_contract.::inherit().createScreens.m.Screens.push().Text.::format()
    {
        // Text = ::format("[img]gfx/ui/events/event_112.png[/img]{%s | %s | %s}",
        //  "A smuggler meets you behind the tavern, tossing a chest into your hands. %SPEECH_ON%Road's clear - for now. And if it starts squeaking, you didn\'t get it from me.%SPEECH_OFF%",
        //  "A nervous clerk meets you by the well, handing off a small chest. %SPEECH_ON%Here! Just take it and go. I never saw you, understood?%SPEECH_OFF%",
        //  "As you near the market, a passing drunk addresses you with a slurred greeting, then produces a small box from under their ragged cloak. %SPEECH_ON%Took you long enough, take it and be quick, the boss is waiting.%SPEECH_OFF%He pushes the box into your chest and slink past, quickly resuming their act with a hiccup and some surprisingly good singing."
        en = "[img]gfx/ui/events/event_112.png[/img]{A smuggler meets you behind the tavern, tossing a chest into your hands. %SPEECH_ON%Road's clear - for now. And if it starts squeaking, you didn't get it from me.%SPEECH_OFF% | A nervous clerk meets you by the well, handing off a small chest. %SPEECH_ON%Here! Just take it and go. I never saw you, understood?%SPEECH_OFF% | As you near the market, a passing drunk addresses you with a slurred greeting, then produces a small box from under their ragged cloak. %SPEECH_ON%Took you long enough, take it and be quick, the boss is waiting.%SPEECH_OFF%He pushes the box into your chest and slink past, quickly resuming their act with a hiccup and some surprisingly good singing.}"
        es = "[img]gfx/ui/events/event_112.png[/img]{Un contrabandista se encuentra contigo detrás de la taberna y te lanza un cofre a las manos. %SPEECH_ON%El camino está despejado, por ahora. Y si empieza a chillar, no te lo di yo.%SPEECH_OFF% | Un escribiente nervioso te espera junto al pozo y te entrega un pequeño cofre. %SPEECH_ON%¡Toma! Llévatelo y vete. Nunca te he visto, ¿entendido?%SPEECH_OFF% | Al acercarte al mercado, un borracho que pasa te saluda arrastrando las palabras y saca una cajita de debajo de su capa andrajosa. %SPEECH_ON%Cuánto has tardado. Tómala y date prisa, que el jefe espera.%SPEECH_OFF%Te planta la caja contra el pecho y se escabulle, retomando enseguida su papel con un hipo y unos cánticos sorprendentemente buenos.}"
    }
    // context: legend_camp_smuggle_contract.::inherit().createScreens.m.Screens.push().Options.Text
    {
        en = "{Pick the package and head out.}"
        es = "{Recoge el paquete y en marcha.}"
    }
    // context: legend_camp_smuggle_contract.::inherit().createScreens.m.Screens.push().Title
    {
        en = "At bandit camp..."
        es = "En el campamento bandido..."
    }
    // context: legend_camp_smuggle_contract.::inherit().createScreens.m.Screens.push().Text.::format()
    {
        // Text = ::format("[img]gfx/ui/events/event_05.png[/img]{%s | %s}",
        //  "You arrive at the camp, package in hand — but you're not alone. Steel flashes from the treeline as enemies pour in. %SPEECH_ON%You bastards, lay down your arms and surrender the contraband!%SPEECH_OFF%",
        //  "As you hand the package to %employer%'s hands, a rustling sounds come from nearby bushes. %SPEECH_ON%Thought you could smuggle goods into outlaw hands under our noses and get away with it? Get them all!%SPEECH_OFF%"
        en = "[img]gfx/ui/events/event_05.png[/img]{You arrive at the camp, package in hand — but you're not alone. Steel flashes from the treeline as enemies pour in. %SPEECH_ON%You bastards, lay down your arms and surrender the contraband!%SPEECH_OFF% | As you hand the package to %employer%'s hands, a rustling sounds come from nearby bushes. %SPEECH_ON%Thought you could smuggle goods into outlaw hands under our noses and get away with it? Get them all!%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_05.png[/img]{Llegas al campamento con el paquete en la mano, pero no estás solo. El acero destella en la linde del bosque y los enemigos se abalanzan. %SPEECH_ON%¡Bastardos, depongan las armas y entreguen el contrabando!%SPEECH_OFF% | Cuando pones el paquete en manos de %employer%, se oye un crujido de hojas en unos arbustos cercanos. %SPEECH_ON%¿Creían que podían pasar mercancía a manos de forajidos en nuestras narices y salirse con la suya? ¡Atrápenlos a todos!%SPEECH_OFF%}"
    }
    // context: legend_camp_smuggle_contract.::inherit().createScreens.m.Screens.push().Options.Text
    {
        en = "{Oh shit.}"
        es = "{Oh, mierda.}"
    }
    // context: legend_camp_smuggle_contract.::inherit().createScreens.m.Screens.push().Text.::format()
    {
        // Text = ::format("[img]gfx/ui/events/event_05.png[/img]{%s | %s}",
        //  "You hand over the package over to the %employer%.%SPEECH_ON%Give me that and scram.%SPEECH_OFF%You leave the camp, wondering if you really did the right thing.",
        //  "As you near the camp, several figures approach with steel at the ready. %randombrother% reaches for %their_randombrother% weapon, but stops as one of the bandits speak. %SPEECH_ON%You have it?%SPEECH_OFF% A nod and gesture to the package in your arms disarms any tension. %They_employer% produces a purse, tossing it your way. You catch it as you set the package on the floor. %SPEECH_ON%As agreed, it's %reward_completion% crowns. Now, if you don\'t mind.%SPEECH_OFF% %They_employer% looks away from the camp, then back to you. %SPEECH_ON%Piss off.%SPEECH_OFF%"
        en = "[img]gfx/ui/events/event_05.png[/img]{You hand over the package over to the %employer%.%SPEECH_ON%Give me that and scram.%SPEECH_OFF%You leave the camp, wondering if you really did the right thing. | As you near the camp, several figures approach with steel at the ready. %randombrother% reaches for %their_randombrother% weapon, but stops as one of the bandits speak. %SPEECH_ON%You have it?%SPEECH_OFF% A nod and gesture to the package in your arms disarms any tension. %They_employer% produces a purse, tossing it your way. You catch it as you set the package on the floor. %SPEECH_ON%As agreed, it's %reward_completion% crowns. Now, if you don't mind.%SPEECH_OFF% %They_employer% looks away from the camp, then back to you. %SPEECH_ON%Piss off.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_05.png[/img]{Le entregas el paquete a %employer%.%SPEECH_ON%Dame eso y lárgate.%SPEECH_OFF%Te vas del campamento preguntándote si de verdad has hecho lo correcto. | Al acercarte al campamento, varias figuras se aproximan con el acero listo. %randombrother% echa mano a su arma, pero se detiene cuando uno de los bandidos habla. %SPEECH_ON%¿Lo tienes?%SPEECH_OFF% Un asentimiento y un gesto hacia el paquete que llevas en brazos disipan cualquier tensión. Saca una bolsa y te la lanza. La atrapas mientras dejas el paquete en el suelo. %SPEECH_ON%Lo acordado: %reward_completion% coronas. Y ahora, si no te importa.%SPEECH_OFF% Aparta la vista hacia el campamento y luego vuelve a mirarte. %SPEECH_ON%Vete a la mierda.%SPEECH_OFF%}"
    }
    // context: legend_camp_smuggle_contract.::inherit().createScreens.m.Screens.push().Options.Text
    {
        en = "{Perhaps, such is life.}"
        es = "{Quizá. Así es la vida.}"
    }
    // en = "You gain <v:val_tag> Crowns"
    // en base_es
    // context: legend_camp_smuggle_contract.::inherit().createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]{Defeated, you run from the battlefield. Package is lost.}"
        es = "[img]gfx/ui/events/event_05.png[/img]{Derrotado, huyes del campo de batalla. El paquete se ha perdido.}"
    }
    // context: legend_camp_smuggle_contract.::inherit().createScreens.m.Screens.push().Options.Text
    {
        en = "{This is not worth losing the company over...}"
        es = "{No vale la pena perder la compañía por esto...}"
    }
    // context: legend_camp_smuggle_contract.::inherit().createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]{Defeated, you run from the battlefield. Package is lost, your employer at mercy of local authorities. Let's hope there will be no further consequences.}"
        es = "[img]gfx/ui/events/event_05.png[/img]{Derrotado, huyes del campo de batalla. El paquete se ha perdido y tu patrón queda a merced de las autoridades locales. Esperemos que no haya más consecuencias.}"
    }
    // en = "<settlement:str> Militia"
    // en base_es
    // en = "Brave men defending their homes with their lives. Farmers, craftsmen, artisans - but not one real soldier."
    // en base_es
    // context: legend_camp_smuggle_contract.::inherit().spawnPursuitParty.party.setDescription()
    {
        // party.setDescription(party.getDescription() + " Small mercenary contingent attached.");
        mode = "pattern"
        en = "<desc:str> Small mercenary contingent attached."
        es = "<desc> Lleva consigo un pequeño contingente de mercenarios."
    }
    // context: legend_camp_smuggle_contract.::inherit().spawnRevengeParty.party.::World.FactionManager.getFactionOfType(::Const.FactionType.Bandits).spawnEntity()
    {
        en = "Your employer"
        es = "Tu patrón"
    }
    // context: legend_camp_smuggle_contract.::inherit().spawnRevengeParty.party.setDescription()
    {
        en = "Bandit army of your employer."
        es = "El ejército bandido de tu patrón."
    }
    // context: legend_camp_smuggle_contract.::inherit().onPrepareVariables._vars.push()
    // en = "Town"  // nombre de variable para el token %Town% (onPrepareVariables), no se muestra
    // FILE: scripts\contracts\contracts\legend_camp_unhold_bondage_contract.nut
    // context: legend_camp_unhold_bondage_contract.create.m.Name
    {
        en = "Capture Unhold"
        es = "Captura al trol"
    }
    // context: legend_camp_unhold_bondage_contract.create.m.DescriptionTemplates
    {
        en = "Friendly barbarian tribe seeks unhold line-breakers. This should be interesting."
        es = "Una tribu bárbara amiga busca troles para romper líneas. Esto promete ser interesante."
    }
    // context: legend_camp_unhold_bondage_contract.create.m.DescriptionTemplates
    {
        en = "Local barbarian warlord in the market for a personal unhold. Alive, preferably..."
        es = "Un caudillo bárbaro de la zona busca un trol propio. Vivo, a ser posible..."
    }
    // context: legend_camp_unhold_bondage_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        en = "Equip provided nets"
        es = "Equipa las redes proporcionadas"
    }
    // context: legend_camp_unhold_bondage_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        en = "Hunt and capture at least one unhold"
        es = "Caza y captura al menos un trol"
    }
    // context: legend_camp_unhold_bondage_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_camp_hunt.png[/img]{Sat around the fire in camp, the sudden appearance of a barbarian warrior in full armour sends the company into a scramble. Some grab weapons, others holler for others to come quick, and you reach for your sword as the barbarian puts their hands to their side, gesturing calm. Equally as surprising as their sudden appearance in the middle of camp, they speak directly to you in fluent, albeit strained common tongue.%SPEECH_ON%Fear not, captain. I am here as a messenger only. My tribe has an offer for you, an opportunity to enrich us both. Besides, if you kill me, my tribe will know, and your company will not survive the night.%SPEECH_OFF%Well then. More of the company pours in, confused as to how and why a barbarian is directly addressing the captain of a mercenary company which often profits through the slaughter of their kin. You match their gesture of calm, lowering your sword back to its sheath. A nod and reassuring look to the company shows your interest in the unusual proposal.%SPEECH_ON%Unholds, you call them. We need them. War comes, our tribe is depleted, and we need more of the giantkin to fight against our enemies. We would give you our means, you would capture them and deliver them to us. Your reward would be great.%SPEECH_OFF%One of the men scoffs at the notion, another proclaims their scepticism. The barbarian looks sincere, and the opportunity could be lucrative – if you survive the ordeal. Carefully, you respond...}"
        es = "[img]gfx/ui/events/legend_camp_hunt.png[/img]{Mientras están sentados alrededor del fuego del campamento, la repentina aparición de un guerrero bárbaro con armadura completa siembra el revuelo en la compañía. Unos agarran las armas, otros gritan a los demás que acudan rápido, y tú echas mano a la espada mientras el bárbaro baja las manos a los costados en un gesto de calma. Tan sorprendente como su repentina aparición en mitad del campamento es que te hable directamente en una lengua común fluida, aunque forzada.%SPEECH_ON%No temas, capitán. Solo vengo como mensajero. Mi tribu tiene una oferta para ti, una oportunidad de enriquecernos ambos. Además, si me matas, mi tribu lo sabrá y tu compañía no sobrevivirá a la noche.%SPEECH_OFF%Vaya, pues. Llegan más miembros de la compañía, sin entender cómo ni por qué un bárbaro se dirige directamente al capitán de una compañía de mercenarios que a menudo se lucra masacrando a los suyos. Imitas su gesto de calma y devuelves la espada a la vaina. Un asentimiento y una mirada tranquilizadora a la compañía muestran tu interés por la insólita propuesta.%SPEECH_ON%Troles, los llaman ustedes. Los necesitamos. Se acerca la guerra, nuestra tribu está mermada y necesitamos más de la estirpe de los gigantes para luchar contra nuestros enemigos. Nosotros les daríamos los medios; ustedes los capturarían y nos los entregarían. Su recompensa sería grande.%SPEECH_OFF%Uno de los hombres se burla de la idea; otro proclama su escepticismo. El bárbaro parece sincero, y la oportunidad podría ser lucrativa, si sobreviven a la prueba. Con cuidado, respondes...}"
    }
    // context: legend_camp_unhold_bondage_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{ What can you offer us? | We can do this – for the right price. | Subduing unholds won't come cheap. }"
        es = "{ ¿Qué puedes ofrecernos? | Podemos hacerlo, por el precio adecuado. | Someter troles no saldrá barato. }"
    }
    // context: legend_camp_unhold_bondage_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{ The risks are too high - we refuse. | We aren't equipped for such a task. | We kill unholds, not capture them. Count us out. }"
        es = "{ Los riesgos son demasiado altos; nos negamos. | No estamos equipados para semejante tarea. | Nosotros matamos troles, no los capturamos. No cuentes con nosotros. }"
    }
    // context: legend_camp_unhold_bondage_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{Your employer's tip paid off – a pack of bumbling unholds presents itself as you follow their messy tracks. Hunched around the carcass of a [deer/wolf/horse], the lumbering giants tear pieces of their meal and appear eager to feast. If you squinted just right, they would resemble some amongst the company. The unhold's session of fine dining is cut short however when one spots your company and jumps up with a holler. Like a flock of bulbous sheep, the rest burst into a noisy display of dominance and posture up to defend their meal, or perhaps to make a new one of you. Ordering the company into formation, you address the men as the beasts break into a feverish dash towards you. | A colossal pile of steaming unhold shit announces your quarry is close, and the looming silhouette ahead all but confirms what your eyes and nose suggested. A pack of unholds ahead chortle amongst themselves, their brutish grunting and snorting unmistakable, even at this distance. One confidently scratches its behind, then sniffs its soiled hand, stopping in shock when it spots you and the company awkwardly looking on in mixed amusement and disgust. Its surprise is short lived however, as it calls out to the others with a cruel roar that makes your throat sore just by hearing it. Forming up, the company braces for the coming wave of muscle and malice. | Unholds are far from subtle beasts, and just by following a trail of fresh carnage and beastly merriment, you discover the unholds your employer directed you to capture. They're apparently deep in a session of play-fighting, their weapons consisting of pulped human corpses and the malformed mass of what appears to be a cow as they club and slap each other. One clumsy movement later, and one of their man-clubs had been sundered in two, a shrill vocalisation betraying frustration at the loss of their toy. Soon enough, one spots you and points, the rest of the pack exploding with a sick sense of anticipation for a new addition to their flesh-arsenal. You order the company into formation as the beasts close in.}"
        es = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{El soplo de tu patrón ha dado resultado: una manada de troles torpes aparece mientras sigues su desordenado rastro. Encorvados alrededor del cadáver de un [ciervo/lobo/caballo], los pesados gigantes arrancan pedazos de su comida y parecen ansiosos por darse un festín. Entrecerrando los ojos lo justo, se parecerían a algunos miembros de la compañía. Sin embargo, el refinado banquete de los troles se interrumpe cuando uno ve a tu compañía y se levanta de un salto con un bramido. Como un rebaño de ovejas bulbosas, los demás estallan en una ruidosa exhibición de dominio y adoptan una postura para defender su comida, o quizá para hacer de ti la siguiente. Ordenas a la compañía formar y te diriges a los hombres mientras las bestias se lanzan en una carrera febril hacia ti. | Una colosal pila de mierda de trol humeante anuncia que tu presa está cerca, y la silueta que se cierne más adelante casi confirma lo que sugerían tus ojos y tu nariz. Una manada de troles ríe por lo bajo entre sí; sus gruñidos y resoplidos brutales son inconfundibles, incluso a esta distancia. Uno se rasca el trasero con aplomo y luego se huele la mano sucia, y se queda paralizado al verte a ti y a la compañía mirando con incomodidad, entre divertidos y asqueados. Su sorpresa dura poco, sin embargo, pues llama a los demás con un rugido cruel que te deja la garganta dolorida con solo oírlo. La compañía forma y se prepara para la oleada de músculo y malicia que se avecina. | Los troles distan mucho de ser bestias sutiles y, con solo seguir un rastro de carnicería fresca y jolgorio bestial, das con los troles que tu patrón te mandó capturar. Por lo visto, están enfrascados en una pelea de juego, con armas que consisten en cadáveres humanos hechos pulpa y la masa deforme de lo que parece una vaca, con las que se aporrean y se abofetean. Un movimiento torpe después, una de sus mazas humanas se ha partido en dos, y una vocalización estridente delata la frustración por la pérdida de su juguete. No tarda uno en verte y señalarte, y el resto de la manada estalla con una enfermiza expectación ante la nueva incorporación a su arsenal de carne. Ordenas a la compañía formar mientras las bestias se acercan.}"
    }
    // context: legend_camp_unhold_bondage_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{ Remember, we need one alive! Charge! | Attack! Subdue them! | Remember our contract - weaken, then capture them! }"
        es = "{ ¡Recuerden, necesitamos uno vivo! ¡A la carga! | ¡Al ataque! ¡Sométanlos! | Recuerden el contrato: ¡debilítenlos y luego captúrenlos! }"
    }
    // context: legend_camp_unhold_bondage_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{Your barbarian employer approaches, war party in tow. Quickly assessing your company and scowling at the noticeable lack of a trapped unhold, the leader stops his men and shouts across to you.%SPEECH_ON%We had a deal, [i]leigumaðr[/i]. You have failed your end, and for that you must die.%SPEECH_OFF%A fair enough logic, at least from a savage perspective. You order the company to form ranks as your employer-made-enemy charges, seeking to right your wrong through copious violence and bloodshed. | The sound of barbarian merriment alerts you to your employer's return. When your company and the lack of its unhold cargo come into view, their sounds of celebration are quickly snuffed out. A few quiet moments pass, the savage host perhaps deciding what to do next whilst your men nervously look on. The all too familiar blare of a barbarian war horn shatters the silence, and the once amicable band of northern raiders breaks into a murderous charge. With a sigh, you order the company into battle formation. | Drums and horns herald the arrival of a barbarian war party. For a moment, you wonder if another barbarian host other than your employer is in the area, but such hopes are crushed when you see %employer% leading the warband. It's clear they know you could not capture the unhold they requested, and have come to give you your just reward. Brandishing a skull, your employer throws it into the earth and crushes it underfoot, seemingly a signal for the host to charge. You order the company into fighting formation as the barbarians come to claim your skull as some ritual compensation.}"
        es = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{Tu patrón bárbaro se acerca con su partida de guerra a la zaga. Tras evaluar rápidamente a tu compañía y fruncir el ceño ante la evidente ausencia de un trol capturado, el líder detiene a sus hombres y te grita.%SPEECH_ON%Teníamos un trato, [i]leigumaðr[/i]. No has cumplido tu parte, y por eso debes morir.%SPEECH_OFF%Una lógica bastante razonable, al menos desde una perspectiva salvaje. Ordenas a la compañía formar filas mientras tu patrón, ahora convertido en enemigo, carga para enmendar tu error con abundante violencia y derramamiento de sangre. | El sonido del jolgorio bárbaro te avisa del regreso de tu patrón. Cuando tu compañía, y la falta de su cargamento de trol, aparecen a la vista, sus sonidos de celebración se apagan de golpe. Pasan unos momentos de silencio; quizá la horda salvaje decide qué hacer a continuación mientras tus hombres miran nerviosos. El sonido demasiado familiar de un cuerno de guerra bárbaro rompe el silencio, y la otrora amistosa banda de saqueadores norteños se lanza a una carga asesina. Con un suspiro, ordenas a la compañía adoptar formación de combate. | Tambores y cuernos anuncian la llegada de una partida de guerra bárbara. Por un momento te preguntas si hay en la zona otra horda bárbara distinta de la de tu patrón, pero esas esperanzas se desvanecen cuando ves a %employer% al frente de la banda de guerra. Está claro que saben que no pudiste capturar el trol que pidieron, y han venido a darte tu merecido. Tu patrón blande un cráneo, lo arroja al suelo y lo aplasta con el pie, en lo que parece la señal para que la horda cargue. Ordenas a la compañía formar para el combate mientras los bárbaros vienen a reclamar tu cráneo como una especie de compensación ritual.}"
    }
    // context: legend_camp_unhold_bondage_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{ To battle! | To arms! | Fight, men! }"
        es = "{ ¡A la batalla! | ¡A las armas! | ¡Luchen, hombres! }"
    }
    // context: legend_camp_unhold_bondage_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_113.png[/img]{The giant falls under the punishment of the company and the strange barbarian nets that glom to their fleshy form. What was only moments ago a violently animated and bloodthirsty avatar of chaos had now been transformed into a sad mass of whimpering flesh and bone. What fight was in the beast appears to have been drained from them through whatever poison the nets are coated with; you order the company to quickly haul the giant into the rough metal cage the barbarians provided, taking good care not to dislodge the net from it. One of the men responsible for casting the strange traps examines some of the slimey poison on their hands, shivers, then quickly wipes it onto their legs. | You'd be forgiven for thinking the giantkin dead upon inspecting it: its muscles appear loose and free, its body splayed across the floor in a puddle of flesh and fur. Only when you lock eyes with the beast do you confirm it still lives, the nets having an almost supernatural effect on the behemoths as it appears helpless to stand against you. What poisons the barbarians wield you do not know, but the sight of an unhold rendered limp from one of their poisoned nets is enough to instil unease in all present. Remembering your contract, you order the men to drag the beast and hitch it to the wagon, taking care to keep the glossy net away from any open wounds... | After the ferocious battle, you're frankly shocked to confirm the unhold had survived the carnage and was now politely sat on the floor covered in the barbarian netting. It appears almost between consciousness and sleep, its head fighting to stay upright, and the confusion in its once malevolent face speaking to the efficacy of the barbarian tradition of unhold taming. You watch as some of the beast's wounds quicken before you, and half expect it to kick back into a violent rage, but it remains dormant. %randombrother% approaches.%SPEECH_ON%I don't like that, captain. It was fighting for its life not a moment past, and now look at it. It's not right...%SPEECH_OFF%Maybe, maybe not. Regardless, we have a contract to fulfil, and pondering the place of unholds in our world and the barbarian's wont help us complete it. You order the giant prepared for transport.}"
        es = "[img]gfx/ui/events/event_113.png[/img]{El gigante cae bajo el castigo de la compañía y de las extrañas redes bárbaras que se adhieren a su cuerpo carnoso. Lo que hace solo unos instantes era un avatar del caos, violento, frenético y sediento de sangre, se ha convertido ahora en una triste masa de carne y huesos que gimotea. Las ganas de pelea que tuviera la bestia parecen haberse esfumado por obra del veneno que recubre las redes; ordenas a la compañía meter rápidamente al gigante en la tosca jaula de metal que proporcionaron los bárbaros, con mucho cuidado de no desprenderle la red. Uno de los hombres encargados de lanzar las extrañas trampas examina un poco del viscoso veneno que tiene en las manos, se estremece y se lo limpia enseguida en las piernas. | Nadie te culparía por creer muerto al gigante al examinarlo: sus músculos parecen flojos y sueltos, y su cuerpo yace despatarrado en el suelo como un charco de carne y pelo. Solo cuando cruzas la mirada con la bestia confirmas que sigue con vida; las redes tienen un efecto casi sobrenatural en estos colosos, pues parece incapaz de alzarse contra ti. No sabes qué venenos manejan los bárbaros, pero ver a un trol reducido a un fardo flácido por una de sus redes envenenadas basta para inquietar a todos los presentes. Recordando el contrato, ordenas a los hombres arrastrar a la bestia y atarla al carro, con cuidado de mantener la red brillante lejos de cualquier herida abierta... | Después de la feroz batalla, te sorprende de veras comprobar que el trol ha sobrevivido a la carnicería y ahora está sentado educadamente en el suelo, cubierto por la red bárbara. Parece a medio camino entre la consciencia y el sueño, con la cabeza luchando por mantenerse erguida, y la confusión de su rostro, antes malévolo, habla de la eficacia de la tradición bárbara de doma de troles. Ves cómo algunas de las heridas de la bestia se cierran ante tus ojos y medio esperas que vuelva a estallar en una furia violenta, pero sigue aletargada. %randombrother% se acerca.%SPEECH_ON%Esto no me gusta, capitán. Hace un momento luchaba por su vida, y míralo ahora. No es normal...%SPEECH_OFF%Puede que sí, puede que no. Sea como sea, tenemos un contrato que cumplir, y darle vueltas al lugar de los troles en nuestro mundo y en el de los bárbaros no nos ayudará a cumplirlo. Ordenas preparar al gigante para el transporte.}"
    }
    // context: legend_camp_unhold_bondage_contract.createScreens.m.Screens.push().Options.Text
    {
        en = " { Time to get paid. | Our employer awaits. | Onwards, we have a 'package' to deliver. }"
        es = " { Hora de cobrar. | Nuestro patrón nos espera. | Adelante, tenemos un 'paquete' que entregar. }"
    }
    // context: legend_camp_unhold_bondage_contract.createScreens.m.Screens.push().start.Text
    {
        en = "[img]gfx/ui/events/event_113.png[/img]{Well, the unholds are dead, but your employer didn't want dead: they wanted the beasts alive, and all you have to show is a quickly cooling pile of giant corpses. Some of the men loiter about, exchanging awkward glances, perhaps considering the fallout when the barbarians learn of this fuck up. After a moment, some begin to hack apart the beasts for trophies, if only to distract themselves from the northmen's wrath which will no doubt manifest soon. | As the last unhold goes down, the cheer of the company is quickly replaced with apprehension and uncertainty. The beasts are dead, much to your dismay and the coming fury of your barbarian employer. With no living giants to take back, you can expect an icy reception, and the men know it. For now, you encourage them to strip the unholds for trophies, trying to make a good event out of such a mess. | Chunks of giant flesh and bone dot the field of battle, which on any other day would spell a tremendous victory for the company. Today however, it spells a disastrous cock-up: you had a contract with your employer to capture one of the unholds – alive. Though the men pick through the mess of corpses for mementos, you doubt they can restore the beasts to life. You have no doubt however that there will be a reckoning from your employer, but for now, all you can do is rest.}"
        es = "[img]gfx/ui/events/event_113.png[/img]{Bueno, los troles están muertos, pero tu patrón no los quería muertos: quería a las bestias vivas, y lo único que tienes para enseñar es una pila de cadáveres de gigante que se enfría a toda prisa. Algunos de los hombres merodean por ahí intercambiando miradas incómodas, quizá pensando en lo que pasará cuando los bárbaros se enteren de que la han jodido. Al cabo de un momento, algunos empiezan a despedazar a las bestias para sacar trofeos, aunque solo sea para distraerse de la ira de los norteños, que sin duda no tardará en desatarse. | Cuando cae el último trol, los vítores de la compañía dan paso enseguida a la inquietud y la incertidumbre. Las bestias están muertas, para tu consternación y para la furia que se avecina de tu patrón bárbaro. Sin gigantes vivos que llevar de vuelta, puedes esperar un recibimiento gélido, y los hombres lo saben. Por ahora, los animas a despojar a los troles de trofeos, intentando sacar algo bueno de semejante desastre. | Pedazos de carne y hueso de gigante salpican el campo de batalla, lo que cualquier otro día significaría una victoria tremenda para la compañía. Hoy, sin embargo, significa una cagada monumental: tenías un contrato con tu patrón para capturar a uno de los troles, vivo. Aunque los hombres rebuscan recuerdos entre el amasijo de cadáveres, dudas que puedan devolver la vida a las bestias. Lo que no dudas es que tu patrón te pedirá cuentas, pero por ahora lo único que puedes hacer es descansar.}"
    }
    // context: legend_camp_unhold_bondage_contract.createScreens.m.Screens.push().start.Options.Text
    {
        en = "{ Blast it! Let's get out of here! | Well, shit. We should leave. | That could have gone better... }"
        es = "{ ¡Maldita sea! ¡Salgamos de aquí! | Bueno, mierda. Deberíamos irnos. | Podría haber salido mejor... }"
    }
    // context: legend_camp_unhold_bondage_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_31.png[/img]{The barbarian host rises at the sight of the bound and caged unhold. Several of the more hardened warriors approach and measure the specimen brought before them; %employer% is amongst those brave enough to examine the beast up close, ducking and bobbing around the metal prison to confirm its quality. A sudden explosion of stunted rage sends some of the men reeling, earning laughs from the seasoned barbarians. Though the beast strains against its restraints, it quickly abandons its efforts, resigning against the bars with a huff. %SPEECH_ON%Good work, [i]leigumaðr[/i]. I can see its spirit is still strong, despite your violent work. You have earned your price.%SPEECH_OFF%%employer% gestures to a chest containing your agreed upon pay: a collection of barbarian trinkets and artefacts of the north that should sell for a crown or two somewhere warmer. Looking back at the unhold, you can almost sense sadness and mourning in its vacant eyes, but it closes them with a sigh before you can be sure. | The company leads the unhold with a system of prodding spears, ropes, and nets towards the barbarian employer. Their unfamiliarity with such a task is apparent, and for once you're relieved to see barbarian trappers and handlers approach to take over wrangling the beast. The handover is thankfully bloodless, most eyes fixed on the placated yet ever-hazardous unhold mere feet beside you. %employer% however remains fixed on you, a stoic yet visibly satisfied nod tells you the job is done, and they gesture a thrall to hand over your reward. \nInside an odd smelling sack of unknown leather, you count your prize of an assortment of barbarian treasures and baubles. You add the valuables to inventory, making sure to discretely discard the strange sack they came with. | Not long after the unhold is subdued and an uneasy peace restored to the battlefield, a swarm of barbarians descend upon the scene of your beast wrangling. For a moment you expect the whole situation was a trap to weaken and lure the company to their doom, but %employer% quickly sweeps those fears away with a broad smile and open arms.%SPEECH_ON%Good fight, outsider. My tribe enjoyed your performance, as did I...%SPEECH_OFF%They produce a fine box of carved bone and gold, and begin counting out your reward- a collection of barbarian curios as stand-in for crowns. Brushing away what you can only explain as an ivory phallus from the box, the barbarian leader quickly passes you your reward, perhaps hoping to distract from the growing confusion. Beside, you feel the burning hatred of the captured unhold sear your flesh as their life is traded for trinkets.%SPEECH_ON%Now. Begone, and hope my new trophy does not recognise you when we next meet.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_31.png[/img]{La horda bárbara se levanta al ver al trol atado y enjaulado. Varios de los guerreros más curtidos se acercan y evalúan el ejemplar que les han traído; %employer% está entre quienes tienen el valor de examinar a la bestia de cerca, agachándose y moviéndose alrededor de la prisión de metal para comprobar su calidad. Un repentino estallido de rabia contenida hace retroceder a algunos de los hombres, lo que arranca carcajadas a los bárbaros veteranos. Aunque la bestia forcejea contra sus ataduras, abandona pronto sus esfuerzos y se deja caer resignada contra los barrotes con un resoplido. %SPEECH_ON%Buen trabajo, [i]leigumaðr[/i]. Veo que su espíritu sigue fuerte, a pesar de tu violento trabajo. Te has ganado tu precio.%SPEECH_OFF%%employer% señala un cofre que contiene la paga acordada: una colección de baratijas bárbaras y artefactos del norte que deberían venderse por una o dos coronas en algún lugar más cálido. Al volver a mirar al trol, casi puedes percibir tristeza y duelo en sus ojos vacíos, pero los cierra con un suspiro antes de que puedas estar seguro. | La compañía conduce al trol hacia %employer% con un sistema de lanzas para azuzarlo, cuerdas y redes. Su falta de costumbre en semejante tarea es evidente y, por una vez, te alivia ver que se acercan tramperos y cuidadores bárbaros para encargarse de manejar a la bestia. Por suerte, la entrega es incruenta; la mayoría de las miradas están fijas en el trol, apaciguado pero siempre peligroso, a escasos pasos de ti. %employer%, en cambio, sigue con la mirada fija en ti; un asentimiento estoico pero visiblemente satisfecho te dice que el trabajo está hecho, y hace un gesto a un siervo para que te entregue la recompensa. \nDentro de un saco de cuero desconocido y de olor extraño, cuentas tu premio: un surtido de tesoros y chucherías bárbaras. Añades los objetos de valor al inventario, asegurándote de deshacerte discretamente del extraño saco en que venían. | Poco después de someter al trol y de que una paz incómoda vuelva al campo de batalla, un enjambre de bárbaros desciende sobre el escenario de tu doma. Por un momento crees que todo ha sido una trampa para debilitar a la compañía y arrastrarla a su perdición, pero %employer% disipa enseguida esos temores con una amplia sonrisa y los brazos abiertos.%SPEECH_ON%Buena pelea, forastero. Mi tribu disfrutó de tu actuación, igual que yo...%SPEECH_OFF%Saca una fina caja de hueso tallado y oro y empieza a contar tu recompensa: una colección de curiosidades bárbaras a falta de coronas. Tras apartar de la caja lo que solo puedes describir como un falo de marfil, %employer% te pasa rápidamente la recompensa, quizá con la esperanza de distraer de la creciente confusión. A tu lado, sientes cómo el odio ardiente del trol capturado te abrasa la carne mientras cambian su vida por baratijas.%SPEECH_ON%Y ahora, lárgate, y reza para que mi nuevo trofeo no te reconozca la próxima vez que nos veamos.%SPEECH_OFF%}"
    }
    // context: legend_camp_unhold_bondage_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{With the company scattered or dead, the unholds content themselves with laughing at your truly embarrassing performance. Some of the beasts point and make rough vocalisations, others bounce around in a sick dance, clapping their hands together as the company retreats to lick their wounds. When you spot a barbarian scout shaking their head at your sorry display of soldiery, you realise the contract is all but forfeit, and that your employer is soon to be aware of your failure to capture one of the beasts. | While simple beasts, the giants pack a mean punch, and the company simply couldn't withstand their onslaught. With the company having pulled back, it's clear to the tailing barbarian host that you aren't up for the task of wrangling unholds. The hollers and grating laughter of your victorious foes punctuates the mood, and you're frankly grateful they're happy to send your men off with a beastly chorus instead of a renewed assault. | It seemed simple, to slap a few nets on some bumbling beasts and call it a day. The harsh realities of such a task however dashed any notions of ease as the company is routed from the battlefield, bruised and battered by the unhold menace. On your retreat, the laughter of spectating barbarians almost matches the giants for their cruelty, with it being clear your employer saw everything in spectacular detail.}"
        es = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{Con la compañía dispersa o muerta, los troles se conforman con reírse de tu actuación, verdaderamente bochornosa. Algunas de las bestias señalan y emiten sonidos toscos; otras dan saltos en una danza enfermiza y dan palmas mientras la compañía se retira a lamerse las heridas. Cuando ves a un explorador bárbaro negando con la cabeza ante tu lamentable exhibición militar, te das cuenta de que el contrato está prácticamente perdido y de que tu patrón no tardará en enterarse de que no has logrado capturar a una de las bestias. | Aunque son bestias simples, los gigantes pegan fuerte, y la compañía sencillamente no pudo resistir su embestida. Con la compañía en retirada, la horda bárbara que te seguía tiene claro que no estás a la altura de la tarea de domar troles. Los bramidos y las risas chirriantes de tus enemigos victoriosos marcan el ambiente, y francamente agradeces que se contenten con despedir a tus hombres con un coro bestial en lugar de con un nuevo asalto. | Parecía sencillo: echar unas cuantas redes sobre unas bestias torpes y dar el día por terminado. Pero la dura realidad de semejante tarea echó por tierra cualquier idea de facilidad cuando la compañía fue expulsada del campo de batalla, magullada y maltrecha por la amenaza de los troles. En tu retirada, las risas de los bárbaros que observaban casi igualan en crueldad a las de los gigantes, y está claro que tu patrón lo vio todo con todo lujo de detalles.}"
    }
    // en = "Unholds"
    // en base_es
    // context: legend_camp_unhold_bondage_contract.spawnRevengeEnemies.party.setDescription()
    {
        en = "A warband of your barbarian employer."
        es = "Una banda de guerra de tu patrón bárbaro."
    }
    // FILE: scripts\contracts\contracts\legend_deliver_money_contract.nut
    // context: legend_deliver_money_contract.create.m.Name
    {
        en = "Treasury Transfer"
        es = "Traslado del tesoro"
    }
    // context: legend_deliver_money_contract.create.m.DescriptionTemplates
    {
        en = "Shipments of coin between settlements can be dangerous, albeit lucrative work."
        es = "Transportar monedas entre asentamientos puede ser un trabajo peligroso, aunque lucrativo."
    }
    // context: legend_deliver_money_contract.create.m.DescriptionTemplates
    {
        en = "Transport the gold securely, profit from your delivery. Or get murdered along the way."
        es = "Transporta el oro con seguridad y saca provecho de la entrega. O haz que te asesinen por el camino."
    }
    // context: legend_deliver_money_contract.create.m.DescriptionTemplates
    {
        en = "Transport a valuable consignment of coin securely, competitive compensation provided."
        es = "Transporta con seguridad un valioso cargamento de monedas. Se ofrece una compensación competitiva."
    }
    // context: legend_deliver_money_contract.create.m.DescriptionTemplates
    {
        en = "Deliver a large shipment of coin to another settlement, with maximum security."
        es = "Entrega un gran cargamento de monedas en otro asentamiento, con la máxima seguridad."
    }
    // context: legend_deliver_money_contract.create.m.DescriptionTemplates
    {
        en = "Express, armed delivery is certainly a specialist service you can provide."
        es = "La entrega urgente y armada es, sin duda, un servicio especializado que puedes ofrecer."
    }
    // context: legend_deliver_money_contract.create.m.DescriptionTemplates
    {
        en = "Nobody wants this job, as the couriers on the last three shipments were all dead before they even made it halfway."
        es = "Nadie quiere este trabajo, pues los mensajeros de los tres últimos envíos murieron todos antes de llegar siquiera a mitad de camino."
    }
    // context: legend_deliver_money_contract.create.m.DescriptionTemplates
    {
        en = "From pickup to drop-off, secure the coin at all times and be on your guard."
        es = "Desde la recogida hasta la entrega, protege las monedas en todo momento y mantente en guardia."
    }
    // context: legend_deliver_money_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        en = "Deliver coins to %recipient% in %objective% about %days% to the %direction% by road. Do not spend it on the way."
        es = "Entrega las monedas a %recipient% en %objective%, a unos %days% al %direction% por el camino. No las gastes durante el trayecto."
    }
    // en = "Deliver cargo to %recipient% in %objective% about %days% to the %direction% by road"
    // en base_es
    // en = "Mercenaries1"
    // en = "Thieves1"
    // en = "Failed to deliver cargo"
    // en base_es
    // en = "Follow the thieves' tracks and return your cargo"
    // en base_es
    // context: legend_deliver_money_contract.createStates.m.States.push().update.Contract.setScreen()
    // en = "Thieves2"
    // identificador de pantalla
    // context: legend_deliver_money_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_04.png[/img]{%employer% shoves a sizeable chest into your hands before he or you even says a word.%SPEECH_ON%This is the pay for a nearby merchant, I need to you deliver these crowns!%SPEECH_OFF%He looks at you seriously.%SPEECH_ON%I need that taken to %objective% where a man by the name of %recipient% is waiting for it. It may look small, but that chest is the pay for a whole company of merchants. You interested? Or is it a little too heavy for your arms?%SPEECH_OFF% | You find %employer% closing a small chest of coins. He quickly glances up, as though you might have been thieves.%SPEECH_ON%Sellsword! Thank you for coming.%SPEECH_OFF%He locks the chest quickly. Then he pats the chest a few times, even caresses it a little.%SPEECH_ON%This here cargo has to be delivered safely to %objective%. A man by the name of %recipient% is waiting for it. I do not believe the task will be easy, as the chest contains an investment in a new enterprise. There are people who'd go to great lengths to acquire this kind of coin, which is why I'm turning to a man of your... experiences. Are you interested in doing this for me?%SPEECH_OFF% | As you enter %employer%'s room one of his servants is fiddling with the lock on a small chest of coins.%SPEECH_ON%Good seeing you, sellsword. One moment, please. No, idiot, it's the other key!%SPEECH_OFF%His servant bumbles at a ring of keys, trying each one until finally finding the right one. Finished, he wipes the sweat off his brow and looks to you.%SPEECH_ON%I need this here chest delivered to %objective% about %days% %direction% by road. It's going to %recipient%, you know. Him. Alright, maybe you don't know him. What I do know is that this may not ordinarily be your line of work, but I'm willing to pay some serious crowns for you to see it through. That's your real business, right? Earning some crowns?%SPEECH_OFF% | %employer% folds his hands together when he sees you.%SPEECH_ON%This might be a strange question, but how interested are you in making a delivery for me?%SPEECH_OFF%You explain that, for the right price, such a journey would be a welcome departure from the usual killing and dying that goes on around you. The man claps his hands together.%SPEECH_ON%Excellent! Unfortunately, I don't expect it to be quite like that. It's of enough import to garner unsavory attention, which is why I'm looking to hire sellswords in the first place. It's going to %objective%, %days% or so %direction% of here by road, where a man by the name of %recipient% is waiting for it to fall into his hands. So, you see, this won't be the 'departure' you speak of, but it can be a fine payday if you're interested.%SPEECH_OFF% | %employer%'s men are standing around a chest of gold. Their employer shoos them away when he sees you.%SPEECH_ON%Welcome, welcome. Good seeing you. I'm in need of armed guards to have this here package delivered to a man by the name of %recipient% in %objective%. I reckon it's about %days% of travel for a company as your. How interested would you be in doing that for me?%SPEECH_OFF% | %employer%'s got his feet up on his table when you enter. He puts his hands behind his head, looking a little too relaxed for your tastes.%SPEECH_ON%Good tidings, captain. What say you take a leave from all that killing and dying.%SPEECH_OFF%He raises an eyebrow at your response, which is precisely none at all.%SPEECH_ON%Huh, I figured you'd jump on that opportunity. No matter, it was a lie: I need you to take a certain package to %recipient%, a fellow residing in %objective%. This cargo has undoubtedly garnered some ill-intentioned eyes which is why I need your men watching it for me. If you're interested, which you should be, let's talk numbers.%SPEECH_OFF% | %employer% welcomes you, waving you in.%SPEECH_ON%Very well, now that you're here, would you please shut the door behind you?%SPEECH_OFF%One of the man's guards pokes his head around the corner. You smile as you slowly shut him out. Turning around, you find %employer% walking toward a window. He stares out as he talks.%SPEECH_ON%I need something... it's a, uh, well you don't need to know what it is. I need this 'something' delivered to a fellow called %recipient%. He's waiting for it in %objective%. It's important that it actually gets there, important enough for an armed escort for %days% of travel, which is why I'm turning to you and your company. What say you, mercenary?%SPEECH_OFF% | Dim candles barely light the room enough for you to see, it's %employer% sitting behind his desk while his shadows dance on the walls by the tune of flickering lights.%SPEECH_ON%Would you lend your swords to me if I paid you good coin? I need {a small chest | an important investment | business starting funds} delivered safely to %recipient% in %objective%, about %days% of travel %direction% of here. Men have killed each other over this much coin, so you must be ready to defend it with your life.%SPEECH_OFF%He takes a pause, measuring your response.%SPEECH_ON%I will write a sealed letter with instructions to pay you as you deliver the item to my contact in %objective%. What say you?%SPEECH_OFF% | A servant bids you to wait for %employer%, who, he says, will be right with you. And so you wait, and wait, and wait. And finally, as you are about to leave for the second time, %employer% throws open the doors and rushes towards you.%SPEECH_ON%Who's this, again? The mercenary?%SPEECH_OFF%His assistant nods and %employer% sets on a smile.%SPEECH_ON%Oh most fortuitous to have you in %townname%, good captain!\n\nIt is imperative that some coin of mine reach %objective% as safely and quickly as possible. You are precisely who I need, for no common brigand would dare attack you and your men.\n\nYes, I'd like to hire you for escort. Make sure the crowns are delivered to %recipient%, no detours of course. Can we come to an understanding?%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_04.png[/img]{%employer% te pone en las manos un cofre considerable antes de que ninguno de los dos diga una palabra.%SPEECH_ON%Esta es la paga de un mercader de por aquí. ¡Necesito que entregues estas coronas!%SPEECH_OFF%Te mira con seriedad.%SPEECH_ON%Necesito que lo lleves a %objective%, donde un hombre llamado %recipient% lo está esperando. Puede que parezca pequeño, pero ese cofre es la paga de toda una compañía de mercaderes. ¿Te interesa? ¿O pesa un poco demasiado para tus brazos?%SPEECH_OFF% | Encuentras a %employer% cerrando un pequeño cofre de monedas. Levanta la vista rápidamente, como si ustedes fueran ladrones.%SPEECH_ON%¡Mercenario! Gracias por venir.%SPEECH_OFF%Echa la llave al cofre a toda prisa. Luego le da unas palmaditas, e incluso lo acaricia un poco.%SPEECH_ON%Esta carga tiene que llegar sana y salva a %objective%. Un hombre llamado %recipient% la está esperando. No creo que la tarea sea fácil, pues el cofre contiene una inversión en una nueva empresa. Hay gente que haría lo que fuera por hacerse con tanto dinero, y por eso recurro a un hombre de tu... experiencia. ¿Te interesa hacer esto por mí?%SPEECH_OFF% | Al entrar en la habitación de %employer%, uno de sus sirvientes está forcejeando con la cerradura de un pequeño cofre de monedas.%SPEECH_ON%Me alegra verte, mercenario. Un momento, por favor. ¡No, idiota, es la otra llave!%SPEECH_OFF%El sirviente se enreda con un manojo de llaves y las prueba una a una hasta que por fin da con la buena. Una vez terminado, se enjuga el sudor de la frente y te mira.%SPEECH_ON%Necesito que este cofre llegue a %objective%, a unos %days% al %direction% por el camino. Es para %recipient%, ya sabes. Ese. Bueno, quizá no lo conozcas. Lo que sí sé es que esto no suele ser lo tuyo, pero estoy dispuesto a pagar unas buenas coronas para que lo lleves a término. Ese es tu verdadero negocio, ¿no? ¿Ganar unas coronas?%SPEECH_OFF% | %employer% junta las manos al verte.%SPEECH_ON%Puede que sea una pregunta extraña, pero ¿hasta qué punto te interesaría hacer una entrega para mí?%SPEECH_OFF%Le explicas que, por el precio adecuado, un viaje así sería un respiro bienvenido de la matanza y la muerte que te rodean a diario. El hombre da una palmada.%SPEECH_ON%¡Excelente! Por desgracia, no creo que vaya a ser exactamente así. Es lo bastante importante como para atraer atenciones indeseables, y por eso busco contratar mercenarios en primer lugar. Va a %objective%, a unos %days% al %direction% de aquí por el camino, donde un hombre llamado %recipient% espera tenerlo en sus manos. Así que, como ves, esto no será el 'respiro' del que hablas, pero puede ser una buena paga si te interesa.%SPEECH_OFF% | Los hombres de %employer% rodean un cofre de oro. Su patrón los espanta en cuanto te ve.%SPEECH_ON%Bienvenido, bienvenido. Me alegra verte. Necesito guardias armados para que este paquete llegue a un hombre llamado %recipient%, en %objective%. Calculo que son unos %days% de viaje para una compañía como la tuya. ¿Te interesaría hacerlo por mí?%SPEECH_OFF% | %employer% tiene los pies sobre la mesa cuando entras. Se pone las manos detrás de la cabeza, con un aire demasiado relajado para tu gusto.%SPEECH_ON%Saludos, capitán. ¿Qué te parece tomarte un descanso de tanta matanza y tanta muerte?%SPEECH_OFF%Arquea una ceja ante tu respuesta, que es exactamente ninguna.%SPEECH_ON%Vaya, pensé que te lanzarías sobre la oportunidad. No importa, era mentira: necesito que lleves cierto paquete a %recipient%, un tipo que vive en %objective%. Esta carga sin duda ha atraído miradas malintencionadas, y por eso necesito que tus hombres la vigilen por mí. Si te interesa, y debería interesarte, hablemos de números.%SPEECH_OFF% | %employer% te da la bienvenida y te hace pasar con un gesto.%SPEECH_ON%Muy bien, ahora que estás aquí, ¿podrías cerrar la puerta detrás de ti?%SPEECH_OFF%Uno de los guardias del hombre asoma la cabeza por la esquina. Sonríes mientras cierras la puerta despacio y lo dejas fuera. Al darte la vuelta, ves a %employer% caminando hacia una ventana. Mira hacia fuera mientras habla.%SPEECH_ON%Necesito algo... es un, eh, bueno, no necesitas saber qué es. Necesito que este 'algo' llegue a un tipo llamado %recipient%. Lo está esperando en %objective%. Es importante que llegue de verdad, tanto como para merecer una escolta armada durante %days% de viaje, y por eso recurro a ti y a tu compañía. ¿Qué dices, mercenario?%SPEECH_OFF% | Unas velas tenues apenas iluminan la habitación lo suficiente para ver. Es %employer%, tras su escritorio, mientras su sombra baila en las paredes al compás de las llamas parpadeantes.%SPEECH_ON%¿Me prestarías tus espadas si te pagara buenas monedas? Necesito que lleves sin percances {un pequeño cofre | una inversión importante | los fondos para un negocio nuevo} a %recipient%, en %objective%, a unos %days% de viaje al %direction% de aquí. Hay hombres que se han matado entre sí por esta cantidad de dinero, así que debes estar dispuesto a defenderlo con tu vida.%SPEECH_OFF%Hace una pausa, sopesando tu respuesta.%SPEECH_ON%Escribiré una carta sellada con instrucciones para que te paguen cuando entregues la mercancía a mi contacto en %objective%. ¿Qué dices?%SPEECH_OFF% | Un sirviente te pide que esperes a %employer%, que, según dice, te atenderá enseguida. Y así esperas, y esperas, y esperas. Y por fin, cuando estás a punto de marcharte por segunda vez, %employer% abre las puertas de par en par y se apresura hacia ti.%SPEECH_ON%¿Quién es este, otra vez? ¿El mercenario?%SPEECH_OFF%Su asistente asiente y %employer% esboza una sonrisa.%SPEECH_ON%¡Oh, qué fortuna tenerte en %townname%, buen capitán!\n\nEs imperativo que unas monedas mías lleguen a %objective% lo más rápido y seguro posible. Eres justo quien necesito, pues ningún bandido común se atrevería a atacarte a ti y a tus hombres.\n\nSí, quiero contratarte como escolta. Asegúrate de que las coronas lleguen a %recipient%, sin desvíos, por supuesto. ¿Podemos llegar a un acuerdo?%SPEECH_OFF%}"
    }
    // context: legend_deliver_money_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{Let's talk recompense. | What is the pay?}"
        es = "{Hablemos de la recompensa. | ¿Cuál es la paga?}"
    }
    // en = "\x7bNot interested. | Our travels will not take us there for a while. | This is not the kind of work we're looking for.\x7d"
    // en base_es
    // en = "Along the road..."
    // en base_es
    // en = "[img]gfx/ui/events/event_07.png[/img]\x7bWhile on the road, a band of well-armed men cross your path. | Marching toward %objective%, a few men interrupt your quiet travels, the clinky-clank of their weapons and armor filling the air as they step into formation. | Your travels, unfortunately, are not to be simple. A number of men have stepped out in front of you, clearly blocking your way. | Some armed and well armored men have come out to make something of a metal impasse. They look as though they intend to make sure you go no farther. | A few of the men come to a stop. You go to the front to figure out what is going on, only to see a line of well-armed men standing in %companyname%'s way. Well, this should be interesting.\x7d The enemy lieutenant steps forward and pounds his chest with his fist clenched.%SPEECH_ON%\x7bIt is us, the %mercband%, that stand before you. Slayers of beasts beyond imagination, the last hope of this godsforsaken land! | The name is %mercband% and we're well known throughout this land as splitters of heads, drinkers of kegs and lovers of ladies! | 'Tis the legendary %mercband% standing before you. It is we, saviors of %randomtown% and slayers of the false king! | Behold my proud band, the %mercband%! We, who fought off a hundred orcs to save a city from certain doom. What have you to your name? | You're talking to a man of the %mercband%. No common brigand, foul greenskin, bag of coins or skirt ever escaped from us!\x7d%SPEECH_OFF%After the man finishes his posturing and personal pontificating, he points at the cargo you are carrying.%SPEECH_ON%\x7bSo now that you realize the danger you are in, why don't you go ahead and hand that cargo over? | I hope you realize who you've come to face, pathetic sellsword, so that you may best make sure your men make it to their beds tonight. All you need to do is hand over the cargo and we won't have to add you to the history of %mercband%. | Ah, I bet you'd like to be a part of our history, wouldn't you? Well, good news, all you gotta do is not hand over that cargo and we'll scribble you in with our swords. Of course, you can escape the scribe's pen if you just give us that cargo. | Now, if it isn't the %companyname%. As much as I'd like add you to our list of victories, I'll give you a chance here, mercenary to mercenary. All you have to do is hand over that cargo and we'll be on our way. How's that sound?\x7d%SPEECH_OFF%\x7bHmm, well it was a bombastic request if nothing else. | Well, the theatrics were pretty entertaining if nothing else. | You don't quite understand the need for showmanship, but there's little doubt about the seriousness of this new situation you've found yourself in. | While you appreciated the superlatives and hyperbole, there remains the very terse reality that these men do actually mean business.\x7d"
    // en base_es
    // en = "If you want it, come and take it!"
    // en base_es
    // en = "Mercs"
    // en = "It's not worth dying over. Take that damn cargo and be gone."
    // en base_es
    // context: legend_deliver_money_contract.createScreens.m.Screens.push().Options.getResult
    // en = "Mercenaries2"  // identificador de pantalla que devuelve getResult, no se muestra
    // context: legend_deliver_money_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "Se ríen de ti mientras se marchan" -> "mientras te marchas" (en: "as you leave", quien se va es el capitán)
        // corrige base: "¡Como quitarle un caramelo a un niño!" rebaja "Like charming a whore!"; pasa a "¡Más fácil que seducir a una puta!"
        // corrige base: "Comprate unos pantalones nuevos" cambia el sentido y lleva errata (Cómprate); "shinebox" es el guiño a Goodfellas, pasa a "Consíguete una caja de limpiabotas"
        // corrige base: "pusiste en peligro las vidas" rebaja "spent the lives", pasa a "sacrificaste"; se recupera "the old gods know what" que la 1.0 omitía
        // corrige base: "Su líder" -> "su lugarteniente" (lieutenant); "cuando estaba en tus zapatos" es calco y no es "when I was coming up", pasa a "cuando empezaba"
        en = "[img]gfx/ui/events/event_07.png[/img]{Not wanting a fight, you hand the chest over. They laugh as they take it off your hands.%SPEECH_ON%Good choice, mercenary. Maybe someday you'll be the one doing the threatening.%SPEECH_OFF% | The cargo, whatever it is, isn't worth the lives of your men. You hand the crate over and the mercenaries take it. They laugh at you as you leave.%SPEECH_ON%Like charming a whore!%SPEECH_OFF% | This does not seem like the time or place to be sacrificing your men in the name of %employer%'s delivery service. You hand the cargo over. The mercenaries take it then make their leave, their lieutenant flipping you a crown that spins its way into the mud.%SPEECH_ON%Get yerself a shinebox, kid, this work ain't cut out for you.%SPEECH_OFF% | The mercenaries are well armed and you don't know if you could sleep at night knowing you spent the lives of your men just for some silly crate carrying the old gods know what. With a nod, you hand the chest over. The mercenary band gladly takes it from you, their lieutenant pausing to nod back with respect.%SPEECH_ON%A wise choice. Don't think I didn't make many like it when I was coming up.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_07.png[/img]{Como no quieres pelear, entregas el cofre. Se ríen mientras te lo quitan de las manos.%SPEECH_ON%Buena elección, mercenario. Tal vez algún día seas tú quien haga las amenazas.%SPEECH_OFF% | La carga, sea lo que sea, no vale la vida de tus hombres. Entregas la caja y los mercenarios se la llevan. Se ríen de ti mientras te marchas.%SPEECH_ON%¡Más fácil que seducir a una puta!%SPEECH_OFF% | Este no parece el momento ni el lugar para sacrificar a tus hombres en nombre del servicio de entregas de %employer%. Entregas la carga. Los mercenarios la toman y se marchan, y su lugarteniente te lanza una corona que gira hasta caer en el barro.%SPEECH_ON%Consíguete una caja de limpiabotas, chico, este trabajo no es para ti.%SPEECH_OFF% | Los mercenarios están bien armados y no sabes si podrías dormir por la noche sabiendo que sacrificaste las vidas de tus hombres por una simple caja que lleva sabrán los viejos dioses qué. Con un gesto de cabeza, entregas el cofre. La banda de mercenarios lo recibe con gusto, y su lugarteniente se detiene para devolverte el gesto con respeto.%SPEECH_ON%Una sabia elección. No creas que no tomé muchas como esa cuando empezaba.%SPEECH_OFF%}"
    }
    // en = "Hrm..."
    // en base_es
    // context: legend_deliver_money_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "te dicen que te vayas a la mierda y no te metas" pierde "and die"; pasa a "y te mueras"
        en = "[img]gfx/ui/events/event_07.png[/img]{While on the roads, you come across a band of bounty hunters. Their prisoner calls out to you, voice cracking, and begging for your mercy and claiming to be innocent. The bounty hunters tell you to fark off and die. | You're traveling the roads when you come across a group of well-armed bounty hunters. They're yanking along someone shackled from head to toe.%SPEECH_ON%You want no part of this fellow.%SPEECH_OFF%One man says, striking his prisoner in the back of the shins. The prisoner yelps and crawls to you on bloodied hands and knees.%SPEECH_ON%They're all liars! These men will kill me even though I've done nothing wrong! Save me, gentlefolk, I beg of you!%SPEECH_OFF% | You come across a large band of bounty hunters, your two groups oddly mirroring one another, though your purposes in this world clearly diverge. They're transporting a prisoner who has been chained and mouth stuffed with a rag. The prisoner yells out to you, almost pleading, choking on words until red in the face. One of the bounty hunters spits.%SPEECH_ON%Pay no mind, stranger, and get on down the road. Best there be no trouble between men such as we.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_07.png[/img]{Mientras recorres los caminos, te topas con una banda de cazarrecompensas. La persona que llevan presa te llama a gritos, con la voz quebrada, suplicando tu clemencia y asegurando su inocencia. Los cazarrecompensas te dicen que te vayas a la mierda y te mueras. | Vas por los caminos cuando te encuentras con un grupo de cazarrecompensas bien armados. Llevan a rastras a alguien con grilletes de pies a cabeza.%SPEECH_ON%No quieras tener nada que ver con esto.%SPEECH_OFF%Dice uno de ellos, golpeándole la parte de atrás de las espinillas. Quien lleva los grilletes chilla y se arrastra hacia ti sobre manos y rodillas ensangrentadas.%SPEECH_ON%¡Son todos unos mentirosos! ¡Estos hombres me matarán aunque no haya hecho nada malo! ¡Sálvenme, buena gente, les suplico!%SPEECH_OFF% | Te encuentras con una gran banda de cazarrecompensas; tus hombres y ellos parecen extrañamente el reflejo unos de otros, aunque sus propósitos en este mundo son claramente distintos. Llevan a alguien con cadenas y un trapo metido en la boca. Esa persona te grita, casi suplicando, ahogándose con sus propias palabras hasta que se le pone la cara roja. Uno de los cazarrecompensas escupe.%SPEECH_ON%No hagas caso, desconocido, y sigue tu camino. Mejor que no haya problemas entre hombres como nosotros.%SPEECH_OFF%}"
    }
    // en = "This isn't any of our business."
    // en base_es
    // en = "Perhaps we can buy the prisoner?"
    // en base_es
    // context: legend_deliver_money_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "buscando el paquete, pero no hay nada ahi" omite el símil de la amante ("as though it were a lover. But she's not there") y lleva errata (ahí)
        // corrige base: "demasiado patras arriba" lleva errata (patas) y rebaja "too shite"; pasa a "una mierda demasiado grande para eso"
        en = "[img]gfx/ui/events/event_05.png[/img]{You raise up from a nap and turn over, looking for the chest as though it were a lover. But she's not there and neither is the money. Quickly getting to your feet, you begin ordering the men to attention. %randombrother% runs up and says there are footprints leading off from the site. | While taking a rest, you hear a disturbance somewhere in the camp. You rush to it to find %randombrother% face down in the dirt, rubbing the back of his head.%SPEECH_ON%Sorry sir, I was taking a piss, and then they went on ahead and took it out of me. Also, they stole the package.%SPEECH_OFF%You ask the mercenary repeat that last part.%SPEECH_ON%Goddamn thieves have stolen the goods!%SPEECH_OFF%Time to track those bastards down and get it back. | Naturally, it wouldn't be an ordinary trip. No, this world is too shite for that to be the case. It appears thieves have taken off with the cargo. Luckily, they've left a hell of a lot of evidence, namely footprints and dragmarks from toting the package around. They should be easy to find... | Just once you'd like to have a nice walk from one town to the next. Instead, your agreement with %employer% has attracted trouble once again. Thieves, somehow, managed to sneak into the camp and make off with the cargo. The good news is that they didn't manage to sneak back out: you've found their footprints and they won't be hard to follow.}"
        es = "[img]gfx/ui/events/event_05.png[/img]{Te levantas de una siesta y te das la vuelta, buscando el cofre como si fuera una amante. Pero ella no está, y el dinero tampoco. Te pones en pie de un salto y empiezas a ordenar a los hombres que se pongan alerta. %randombrother% llega corriendo y dice que hay huellas que se alejan del lugar. | Mientras descansas, oyes un alboroto en algún lugar del campamento. Te apresuras a ir y encuentras a %randombrother% boca abajo en la tierra, frotándose la nuca.%SPEECH_ON%Disculpe, señor, estaba meando y entonces apareció alguien y me dejó fuera de combate. Además, se llevaron el paquete.%SPEECH_OFF%Le pides que repita esa última parte.%SPEECH_ON%¡Esos malditos ladrones han robado la mercancía!%SPEECH_OFF%Es hora de rastrear a esos bastardos y recuperarla. | Naturalmente, no iba a ser un viaje cualquiera. No, este mundo es una mierda demasiado grande para eso. Parece que unos ladrones se han largado con la carga. Por suerte, han dejado un montón de pistas, en concreto huellas y marcas de arrastre de llevar el paquete de un lado a otro. Deberían ser fáciles de encontrar... | Solo por una vez te gustaría dar un paseo tranquilo de un pueblo a otro. En cambio, tu acuerdo con %employer% ha atraído problemas una vez más. Los ladrones, de alguna manera, lograron colarse en el campamento y llevarse la carga. La buena noticia es que no lograron volver a salir sin ser vistos: has encontrado sus huellas y no será difícil seguirlos.}"
    }
    // en = "We follow their tracks!"
    // en base_es
    // en = "[img]gfx/ui/events/event_22.png[/img]\x7bThief blood runs thick. You manage to find your employer's goods still in the camp, all locked and safe. He doesn't need to know about this little excursion. | Well, everything's right where it should be. %employer%'s cargo was found underneath a thief's writhing body. You made sure to kick him off before running him through. Wouldn't want to get blood on the package, after all. | Killing off the last of the thieves, you and the men spread out through the brigands' camp looking for the package. %randombrother% spots it right quick, the container still held in the clutches of a dead fool. The mercenary fumbles with the corpse's grasp and, in frustration, simply cuts the arms off the bastard. You retrieve the package and hold it a little closer for the trip going forward. | Staring over the bodies of the felled thieves, you wonder if %employer% needs to know about this. The package looks alright. Some blood and bone on it, but you can rub that right off. | The package's a little scuffed, but it'll be fine. Alright, there's blood all over it and a thief's degloved finger is all smashed up into one of the latches. Those issues aside, everything is perfectly fine.\x7d"
    // en base_es
    // en = "Back where it belongs."
    // en base_es
    // en = "Along the way..."
    // en base_es
    // en = "I want to know what's going on."
    // en base_es
    // en = "Leave that thing alone."
    // en base_es
    // en = "[img]gfx/ui/events/event_55.png[/img]\x7bThe battle over, you quickly rush back over to the artifact, finding it floating in the air. %randombrother% runs up to your side.%SPEECH_ON%Destroy it, sir, before it causes any more trouble!%SPEECH_OFF% | Your men weren't the only thing to survive the battle - the artifact, or whatever remains of its pulsing power, floats innocently where you'd last seen it. The thing is an orb swirling with energy, occasionally rattling, sometimes whispering a language you know not of. %randombrother% nods toward it.%SPEECH_ON%Smash it, sir. Smash it and let us be done with this horror.%SPEECH_OFF% | Such power was not meant for this world! The artifact has taken the shape of an orb the size of your fist. It floats off the ground, humming as though singing a song from another world. The thing almost seems to be waiting for you, like a dog would wait its master.%SPEECH_ON%Sir.%SPEECH_OFF%%randombrother% tugs on your shoulder.%SPEECH_ON%Sir, please, destroy it. Let us not take that thing another step with us!%SPEECH_OFF%\x7d"
    // en base_es
    // en = "We have to destroy it."
    // en base_es
    // en = "We're paid to deliver this, so that's what we'll do."
    // en base_es
    // en = "[img]gfx/ui/events/event_55.png[/img]\x7bYou take out your sword and stand before the artifact with the blade slowly raised over your head.%SPEECH_ON%Don't do it!%SPEECH_OFF%Glancing over your shoulder, you see %randombrother% and the other men scowling at you. Blackness surrounds them and the whole world as far as your eye can see. Their eyes glow red, pulsing furiously with every spoken word.%SPEECH_ON%You shall burn forever! Burn forever! Destroy it and you shall burn! Burn! BURN!%SPEECH_OFF%Screaming, you turn around and slice your sword through the relic. It splits effortlessly in two and a wave of color sweeps back into your world. Sweat pours from your forehead as you find yourself leaning on the pommel of your weapon. You look back to see your mercenary company staring at you.%SPEECH_ON%Sir, are you alright?%SPEECH_OFF%You sheathe your sword and nod, but you've never felt so horrified in all your life. %employer% won't be happy, but he and his anger be damned! | Just as soon as the thought of destroying the relic crosses your mind, so too does a wave of horrified screaming. The shrill crying of women and children, their voices cracking with terror as though they had come running at you all on fire. They scream at you in hundreds of languages, but every so often the one you know passes you and it's always with the same word: DON'T.\n\n You draw your sword and swing it back over your head. The artifact hums and vibrates. Smoky tendrils waft off it and a brutish heat washes over you. DON'T.\n\n You steady your grip.\n\n Davkul. Yekh'la. Imshudda. Pezrant. DON'T.\n\nYou swallow and steady your aim.\n\n DON'T.RAVWEET.URRLA.OSHARO.EBBURRO.MEHT'JAKA.DON'T.DON'T.DON'T.DO--\n\n The strike is true, the word is lost, the artifact falls to the earth in twine. You fall with it, to your knees, and a few of the company's brothers come to lift you back up. %employer% won't be happy, but you can't help but feel as though you've spared this world a horror it need not ever see or hear.\x7d"
    // en base_es
    // en = "It's done."
    // en base_es
    // en = "[img]gfx/ui/events/event_55.png[/img]\x7bYou shake your head and get another crate, carefully pushing the floating artifact into it then closing the lid. %employer% was paying you good money and, well, you plan on seeing it through. But for some reason you're not sure if that choice is your own, or if this strange relic's whispering is guiding your hand for you. | You go and retrieve a wooden chest and lift it up to the artifact, quickly closing the lid over it. A few of the mercenaries shake their head. It's probably not the best of ideas, but for some reason you fill compelled to finish your task. | Better judgment says you should destroy this horrible relic, but better judgment fails once more. You take a wooden chest and move it over the artifact before closing the lid and snapping shut the latches. You've no idea what you are doing this, but your body is filled with newfound energy as you get ready to get back on the road.\x7d"
    // en base_es
    // en = "We should move on."
    // en base_es
    // context: legend_deliver_money_contract.createScreens.m.Screens.push().Title
    {
        en = "Arriving without the crowns"
        es = "Llegada sin las coronas"
    }
    // context: legend_deliver_money_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_43.png[/img]{You arrive at the destination, but without the coins. %SPEECH_ON%Where is the coin?%SPEECH_OFF% they ask, but you shrug and say you spent it already. Most of the villagers look shocked and angry, a few sigh in disappointment and one begins crying as they realize this means no food.  %SPEECH_ON%Get out you filthy cold-hearted mercenaries!  Don't you ever come back you scum!! %SPEECH_OFF% }  "
        es = "[img]gfx/ui/events/event_43.png[/img]{Llegas a tu destino, pero sin las monedas. %SPEECH_ON%¿Dónde está el dinero?%SPEECH_OFF% preguntan, pero te encoges de hombros y dices que ya te lo has gastado. La mayoría de los aldeanos se muestran consternados y furiosos, unos cuantos suspiran decepcionados y alguien rompe a llorar al darse cuenta de que eso significa que no habrá comida.  %SPEECH_ON%¡Largo de aquí, mercenarios asquerosos y sin corazón!  ¡¡No vuelvan nunca más, escoria!! %SPEECH_OFF% }  "
    }
    // context: legend_deliver_money_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "Maybe we shouldn't have spent their money."
        es = "Quizá no debimos gastarnos su dinero."
    }
    // context: legend_deliver_money_contract.createScreens.m.Screens.push().Options.getResult.recipientFaction.addPlayerRelation()
    {
        en = "spent all their money instead of delivering it"
        es = "se gastó todo su dinero en lugar de entregarlo"
    }
    // context: legend_deliver_money_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "con las manos detrás de la espalda" no es "hands clasped over his stomach"; pasa a "entrelazadas sobre la barriga"
        // corrige base: "Cargas con el paquete y se la entregas" -> "se lo" (concordancia); "un hombre encapuchado" -> "con túnica" (robed); "alza al corcel" -> "encabrita al corcel" (rears)
        en = "[img]gfx/ui/events/event_20.png[/img]{%recipient%'s waiting for you as you enter the town. %They_recipient% hurriedly takes the chest off your hands.%SPEECH_ON%Oh, ohhh I did not think you would get here.%SPEECH_OFF%%Their_recipient% grubby fingers dance along the chest carrying the cargo. %They_recipient% turns around and barks an order to one of %their_recipient% men. They step forward and hand you a satchel of crowns. | Finally, you've made it. %recipient% is standing there in the middle of the road, %their_recipient% hands clasped over %their_recipient% stomach, a slick grin on %their_recipient% cheeky face.%SPEECH_ON%Sellsword, I was not sure you'd make it.%SPEECH_OFF%You lug the cargo up and hand it over.%SPEECH_ON%Oh yeah, and why do you say that?%SPEECH_OFF%The %person_recipient% takes the box and hands it off to a robed man who quickly hurries away with it tucked under an arm. %recipient% laughs as %they_recipient% hands you a satchel of crowns.%SPEECH_ON%The roads are rough these days, are they not?%SPEECH_OFF%You understand %they're_recipient% making small talk, anything to get your attention off the cargo you just handed over. Whatever, you got your pay, that's good enough for you. | %recipient% welcomes you and a few of %their_recipient% men hurry over to take the cargo. %They_recipient% claps you on the shoulders.%SPEECH_ON%I take it your journey went well?%SPEECH_OFF%You spare %them_recipient% the details and inquire about your pay.%SPEECH_ON%Bah, a sellsword through and through. %randomname%! Get this man what he deserves!%SPEECH_OFF%One of %recipient%'s bodyguards walks over and hands you a small chest of crowns. | After some looking, a man asks who you're looking for. When you say %recipient%, he points you out toward a nearby paddock where a %person_recipient% is strutting about on a rather opulent looking horse.\n\n You walk on over and the %person_recipient% rears the steed and asks if that's the cargo %employer% sent. You nod.%SPEECH_ON%Leave it there at your feet. I'll come and get it.%SPEECH_OFF%You don't, instead asking about your pay. The %person_recipient% sighs and whistles to a bodyguard who hurries over.%SPEECH_ON%See to it that this sellsword gets the pay he deserves.%SPEECH_OFF%Finally, you put the crate on the ground and make your leave.} "
        es = "[img]gfx/ui/events/event_20.png[/img]{%recipient% te está esperando cuando entras en el pueblo. Te quita el cofre de las manos a toda prisa.%SPEECH_ON%Oh, ohhh, no pensé que llegarías.%SPEECH_OFF%Sus dedos mugrientos danzan sobre el cofre que contiene la carga. Se da la vuelta y le ladra una orden a uno de sus hombres. Este se adelanta y te entrega una bolsa de coronas. | Por fin lo has logrado. %recipient% está de pie en medio del camino, con las manos entrelazadas sobre la barriga y una sonrisa astuta en la cara descarada.%SPEECH_ON%Mercenario, no estaba segur%o_recipient% de que lo lograras.%SPEECH_OFF%Cargas con el bulto y se lo entregas.%SPEECH_ON%Ah, ¿sí? ¿Y por qué lo dices?%SPEECH_OFF%%Art_recipient% %hombre_recipient% toma la caja y se la pasa a un hombre con túnica que se aleja a toda prisa con ella bajo el brazo. %recipient% se ríe mientras te entrega una bolsa de coronas.%SPEECH_ON%Los caminos andan revueltos estos días, ¿no?%SPEECH_OFF%Entiendes que solo te está dando conversación, cualquier cosa para desviar tu atención de la carga que acabas de entregar. Da igual, ya tienes tu paga, y con eso te basta. | %recipient% te da la bienvenida y algunos de sus hombres se apresuran a recoger la carga. Te da unas palmadas en los hombros.%SPEECH_ON%Deduzco que el viaje fue bien, ¿no?%SPEECH_OFF%Le ahorras los detalles y preguntas por tu paga.%SPEECH_ON%Bah, un mercenario de pies a cabeza. ¡%randomname%! ¡Dale a este hombre lo que se merece!%SPEECH_OFF%Uno de los guardaespaldas de %recipient% se acerca y te entrega un pequeño cofre de coronas. | Tras buscar un poco, un hombre te pregunta a quién buscas. Cuando dices %recipient%, te señala un corral cercano donde %un_recipient% %hombre_recipient% se pavonea sobre un caballo de aspecto bastante opulento.\n\n Te acercas y %art_recipient% %hombre_recipient% encabrita al corcel y pregunta si esa es la carga que envió %employer%. Asientes.%SPEECH_ON%Déjala ahí, a tus pies. Ya iré a recogerla.%SPEECH_OFF%No lo haces, y en cambio preguntas por tu paga. %Art_recipient% %hombre_recipient% suspira y silba a un guardaespaldas, que se acerca a toda prisa.%SPEECH_ON%Asegúrate de que este mercenario reciba la paga que se merece.%SPEECH_OFF%Por fin, dejas la caja en el suelo y te marchas.} "
    }
    // context: legend_deliver_money_contract.createScreens.m.Screens.push().Options.getResult.recipientFaction.addPlayerRelation()
    {
        en = "Delivered the crowns"
        es = "Entregó las coronas"
    }
    // en = "mercband"
    // FILE: scripts\contracts\contracts\legend_hunting_basilisks_contract.nut
    // context: legend_hunting_basilisks_contract.create.m.Name
    {
        en = "Basilisk Infestation"
        es = "Plaga de basiliscos"
    }
    // context: legend_hunting_basilisks_contract.create.m.DescriptionTemplates
    {
        en = "An ominous clucking floats across the fields at dawn. Locals tell tales of a bloodthirsty beast standing taller than a man."
        es = "Al alba, un cacareo ominoso flota sobre los campos. Los lugareños hablan de una bestia sanguinaria más alta que un hombre."
    }
    // context: legend_hunting_basilisks_contract.create.m.DescriptionTemplates
    {
        en = "Underestimate these giant chickens at your peril. A single one can either kill or feed an entire company."
        es = "Subestima a estas gallinas gigantes bajo tu propio riesgo. Una sola puede matar o alimentar a toda una compañía."
    }
    // context: legend_hunting_basilisks_contract.create.m.DescriptionTemplates
    {
        en = "With eyes that shine like burning coals and a bawk that chills the blood, a basilisk is not to be trifled with."
        es = "Con unos ojos que brillan como brasas y un cloqueo que hiela la sangre, con un basilisco no se juega."
    }
    // context: legend_hunting_basilisks_contract.create.m.DescriptionTemplates
    {
        en = "The thick plumage provides formidable protection against weapons and spells, making it a challenging adversary."
        es = "Su espeso plumaje lo protege formidablemente de armas y hechizos, lo que lo convierte en un adversario temible."
    }
    // context: legend_hunting_basilisks_contract.create.m.DescriptionTemplates
    {
        en = "Powerful pecks and thrashing wings create a whirlwind of destruction that can quickly incapacitate unwary adventurers."
        es = "Sus potentes picotazos y sus alas desatadas crean un torbellino de destrucción que puede dejar fuera de combate en un instante a los aventureros desprevenidos."
    }
    // context: legend_hunting_basilisks_contract.create.m.DescriptionTemplates
    {
        en = "Beware the deceptively agile movements, for its powerful talons can shred armor and flesh alike with ease."
        es = "Cuidado con sus movimientos, más ágiles de lo que parecen, pues sus poderosas garras desgarran con facilidad tanto armadura como carne."
    }
    // context: legend_hunting_basilisks_contract.create.m.DescriptionTemplates
    {
        en = "The reports could be dismissed as a fever dream, if not for the corpses left behind."
        es = "Los informes podrían descartarse como un delirio febril, de no ser por los cadáveres que dejan atrás."
    }
    // context: legend_hunting_basilisks_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        // "Hunt down basilisks in the woods around " + this.Contract.m.Home.getName()
        mode = "pattern"
        en = "Hunt down basilisks in the woods around <town:str>"
        es = "Caza basiliscos en los bosques alrededor de <town>"
    }
    // context: legend_hunting_basilisks_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_43.png[/img]{%employer% sinks into their chair and stares through you. Peasants with pitchforks swan around outside, voices are raised beyond the window and then start to dissipate moments later. %employer% runs their hands through their hair and meets your gaze. %SPEECH_ON%I have been in talks with the leaders of that mob outside for the best part of the day. Their crops are trampled, stolen or half eaten in their fields. Some even say their livestock has gone missing.%SPEECH_OFF% They rise from the chair and move towards the window. %SPEECH_ON%They want me to replace everything they lost, Sellsword. But the best I can do is put an end to it. Some of these madmen claim chickens larger than a man swallowed their lambs whole. I don't care who or what has been doing this, but make sure you put an end to it.%SPEECH_OFF% %employer% turns to face you. %SPEECH_ON%Do I have your interest, Sellsword?%SPEECH_OFF% | A group of men leave a much finer building than any of them could possibly claim ownership to combined, they are dressed in clothes clearly not worn often, the fine cloth contrasting horribly against their sun-blotched skin and calloused hands. They move past %companyname% spitting curses and fighting amongst themselves. You enter the building and there %employer% sits, sipping wine and leafing through parchment papers. They speak to you without acknowledging your presence. %SPEECH_ON%I don't doubt you saw that miserable bunch that just left. Those simple fools claim that a giant chicken swallowed their dog whole and trampled their crops. Tosh! To me, Sellsword, it sounds like your standard corpse-eater or perhaps some kind of elaborate brigand scheme to frighten us.%SPEECH_OFF% They move some papers into a new pile and produce a bag of crowns from a draw, seemingly with rehearsed effort. Their tone becomes more moody and disapproving. %SPEECH_ON%I keep a rainy day fund for these things, whatever the problem is - fix it and it's yours.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_43.png[/img]{%employer% se hunde en su silla y mira a través de ti. Fuera deambulan campesinos con horcas; al otro lado de la ventana se alzan voces que, momentos después, empiezan a apagarse. %employer% se pasa las manos por el pelo y te mira a los ojos. %SPEECH_ON%Llevo casi todo el día negociando con los cabecillas de esa turba de ahí fuera. Sus cosechas están pisoteadas, robadas o medio comidas en los campos. Algunos incluso dicen que les ha desaparecido el ganado.%SPEECH_OFF% Se levanta de la silla y se dirige a la ventana. %SPEECH_ON%Quieren que les reponga todo lo que han perdido, mercenario. Pero lo mejor que puedo hacer es acabar con esto. Algunos de esos locos aseguran que unas gallinas más grandes que un hombre se tragaron enteros a sus corderos. Me da igual quién o qué haya hecho esto, pero asegúrate de acabar con ello.%SPEECH_OFF% %employer% se vuelve hacia ti. %SPEECH_ON%¿Te interesa, mercenario?%SPEECH_OFF% | Un grupo de hombres sale de un edificio mucho más lujoso de lo que todos ellos juntos podrían llegar a poseer. Visten ropas que a todas luces no se ponen a menudo, y la tela fina contrasta horriblemente con su piel manchada por el sol y sus manos encallecidas. Pasan junto a %companyname% escupiendo maldiciones y peleándose entre ellos. Entras en el edificio y allí está %employer%, bebiendo vino a sorbos y hojeando unos pergaminos. Te habla sin dar muestras de reparar en tu presencia. %SPEECH_ON%No dudo que viste a ese grupo de desgraciados que acaba de salir. Esos pobres tontos aseguran que una gallina gigante se tragó entero a su perro y pisoteó sus cosechas. ¡Bobadas! A mí, mercenario, me suena a un comecadáveres corriente, o quizá a alguna treta elaborada de los bandidos para asustarnos.%SPEECH_OFF% Pasa unos papeles a un nuevo montón y saca una bolsa de coronas de un cajón, con un esfuerzo que parece ensayado. Su tono se vuelve más hosco y desaprobador. %SPEECH_ON%Guardo unos ahorros para tiempos de vacas flacas. Sea cual sea el problema, resuélvelo y son tuyos.%SPEECH_OFF%}"
    }
    // en = "\x7bHow many crowns can you muster? | Let's talk pay. | Let's talk crowns.\x7d"
    // en base_es
    // context: legend_hunting_basilisks_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{I'd prefer to hunt smaller chickens.}"
        es = "{Prefiero cazar gallinas más pequeñas.}"
    }
    // context: legend_hunting_basilisks_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_25.png[/img]{You smell it before you see it, but you still almost trip over the half decomposed carcass of a giant bird. %randombrother% is not so lucky, and trips over the wing to disturb a flurry of flies and worms. %SPEECH_ON%Farkin' 'ell%SPEECH_OFF% As they brush the slime from their boots, you notice the sheer size of this monster and the pointed beak which is still sharp enough cut your hand on. The eyes have been picked out and the feathers are ruined - what meat remains has spoiled here in the heat on the forest floor. | %companyname% trapises further into the woods, part of the land far from the eyes and care of men. A large nest, much larger than that of what you are hunting, lies in a ditch below a thick treeline. Bones of large animals and men litter the nest and surrounding area - some remains are crushed or torn apart while others are only missing hands or feet. %randombrother% picks through the remains %SPEECH_ON%Lizard nest. Not what we're here for, long gone by the looks of things...%SPEECH_OFF% You noticed some eggs within the nest differ slightly in size and shape. | You come across a ditch that is filled with a stagnant pool of filth and remains. Various corpses of both animal and man litter this place, some obviously dragged dead while others were more more alive.}"
        es = "[img]gfx/ui/events/event_25.png[/img]{Lo hueles antes de verlo, pero aun así casi tropiezas con el cadáver medio descompuesto de un ave gigante. %randombrother% no tiene tanta suerte y tropieza con el ala, levantando una nube de moscas y gusanos. %SPEECH_ON%¡Me cago en todo!%SPEECH_OFF% Mientras se limpia el limo de las botas, te fijas en el tamaño descomunal de este monstruo y en el pico puntiagudo, todavía lo bastante afilado para cortarte la mano. Le han picoteado los ojos y las plumas están arruinadas; la carne que queda se ha echado a perder aquí, con el calor, sobre el suelo del bosque. | %companyname% se adentra más en el bosque, en una parte de estas tierras lejos de la mirada y el cuidado de los hombres. Un nido grande, mucho más grande que el de lo que estás cazando, yace en una zanja bajo una espesa hilera de árboles. Huesos de animales grandes y de hombres cubren el nido y los alrededores: algunos restos están aplastados o despedazados, mientras que a otros solo les faltan las manos o los pies. %randombrother% hurga entre los restos %SPEECH_ON%Nido de Lagarto. No es lo que buscamos; por lo que parece, hace tiempo que se fue...%SPEECH_OFF% Te fijas en que algunos huevos del nido difieren ligeramente en tamaño y forma. | Llegas a una zanja llena de un charco estancado de inmundicia y restos. Varios cadáveres, tanto de animales como de hombres, cubren el lugar; algunos fueron claramente arrastrados ya muertos y otros, bastante más vivos.}"
    }
    // en = "Keep your eyes peeled."
    // en base_es
    // context: legend_hunting_basilisks_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_44.png[/img]{Breaking through the brush, you are met with absolute bedlam from the beasts - who are currently chasing one another around their nests and occasionally engaging in acts of opportunistic murder of their smaller kind. The smell is a mixture of a butcher's market and tavern vomit. Some of the larger and battle-scarred basilisks have no concern of their surroundings and are safety tucked in their nests woven of branches, bones and filth. Some eggs have hatched recently while others appear to be smashed or crushed. Whatever the case, these monsters have been here for some time and will be more than willing to defend their nests. | Traversing a slope downwards, you fall into a shallow puddle of mud and filth. As you crawl out, you snap a femur of a deer carcass strewn out at the pool's edge.\n\n For a moment, the woods fall silent. Then in the distance you feel long and heavy strides becoming louder each second... | You make an effort to move through the mire of filth left behind by these animals, you wish it were mud, but the smell would suggest otherwise. %randombrother% falls into a deeper patch and lets out a curse as they recover. After a moment, the forest comes alive with shrieking and calling all around you. Whatever element of surprise you had is gone now...}"
        es = "[img]gfx/ui/events/event_44.png[/img]{Al abrirte paso entre la maleza, te recibe el caos absoluto de las bestias, que se persiguen unas a otras alrededor de sus nidos y de vez en cuando aprovechan para asesinar a los ejemplares más pequeños de su especie. El olor es una mezcla de mercado de carniceros y vómito de taberna. Algunos de los basiliscos más grandes, llenos de cicatrices de batalla, no prestan atención a lo que los rodea y descansan a salvo en sus nidos, tejidos con ramas, huesos e inmundicia. Algunos huevos han eclosionado hace poco, mientras que otros parecen rotos o aplastados. Sea como sea, estos monstruos llevan aquí un tiempo y estarán más que dispuestos a defender sus nidos. | Al bajar por una pendiente, caes en un charco poco profundo de barro e inmundicia. Al salir a rastras, partes el fémur del cadáver de un ciervo tirado a la orilla del charco.\n\n Por un momento, el bosque queda en silencio. Luego, a lo lejos, sientes unas zancadas largas y pesadas que suenan cada vez más fuerte... | Te esfuerzas por avanzar a través del lodazal de inmundicia que han dejado estos animales; ojalá fuera barro, pero el olor sugiere otra cosa. %randombrother% cae en una zona más honda y suelta una maldición mientras se recompone. Al cabo de un momento, el bosque cobra vida con chillidos y graznidos a tu alrededor. Lo que tuvieras de factor sorpresa ya se ha perdido...}"
    }
    // context: legend_hunting_basilisks_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_128.png[/img]{The cackling and screams die down as the remaining basilisks retreat into the woods, tackling and attacking each other to create distractions as they go. Feathers, gore and the wafting smell of warm birdshit assaults your senses. You didn't get all of them, but you'd like to think that their descendants of those that got away will tell stories of how you massacred their ancestors.\n\n You make extra effort to burn the nests and smash the eggs for good measure.}"
        es = "[img]gfx/ui/events/event_128.png[/img]{Los cacareos y los chillidos se apagan mientras los basiliscos que quedan se retiran al bosque, embistiéndose y atacándose entre sí para crear distracciones a su paso. Plumas, vísceras y el olor de mierda de pájaro caliente asaltan tus sentidos. No acabaste con todos, pero te gusta pensar que los descendientes de los que escaparon contarán historias de cómo masacraste a sus antepasados.\n\n Te tomas la molestia de quemar los nidos y romper los huevos, por si acaso.}"
    }
    // en = "Let's be done with this, we have crowns to collect."
    // en base_es
    // context: legend_hunting_basilisks_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_128.png[/img]{With the battle over, the screeching dies down and %companyname% finishes off the wounded basilisks. Some of them are barely ruined at all, and provide some additional feathers. They look valuable and you wonder if you could fashion something out of them...}"
        es = "[img]gfx/ui/events/event_128.png[/img]{Terminada la batalla, los chillidos se apagan y %companyname% remata a los basiliscos heridos. Algunos apenas están dañados y proporcionan unas cuantas plumas más. Parecen valiosas y te preguntas si podrías fabricar algo con ellas...}"
    }
    // en = "Back to %townname%!"
    // en base_es
    // context: legend_hunting_basilisks_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_128.png[/img]{After the noise of battle dies down and the smell rises, you notice a discarded and broken bow stamped into the mud at the edge of the nest clearing. A smaller basilisk has met it's end courtesy of several arrows firmly placed in it's skull. A tree branch cracks and above you, a hunter in tattered clothes and various wounds smiles down upon you as if they were a mocking, filthy angel. %SPEECH_ON%Much faster then they look, eh?%SPEECH_OFF% The tree they have claimed is pocked with deep gouges and claw marks from every angle, only abruptly ending a few feet up the trunk. The anger of each strike is so fierce that it almost seems as if the objective was to bring the tree itself down. %SPEECH_ON%Got the smaller one but that only made the bigger ones more angry. Meat is good if you know where to cut and there's plenty of it... say, you got room for one more?%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_128.png[/img]{Cuando el estruendo de la batalla se apaga y el hedor aumenta, ves un arco roto y abandonado, hundido en el barro al borde del claro de los nidos. Un basilisco más pequeño ha encontrado su fin gracias a varias flechas bien clavadas en el cráneo. Una rama cruje y, sobre ti, una figura con ropas de cazador hechas jirones y varias heridas te sonríe desde arriba como un ángel burlón y mugriento. %SPEECH_ON%Son mucho más rápidos de lo que parecen, ¿eh?%SPEECH_OFF% El árbol en el que se ha refugiado está lleno de surcos profundos y marcas de garras por todos lados, que terminan de golpe a unos pocos pies tronco arriba. La furia de cada golpe es tan feroz que casi parece que el objetivo era derribar el propio árbol. %SPEECH_ON%Acabé con el pequeño, pero eso solo enfureció más a los grandes. La carne está buena si sabes por dónde cortar, y hay de sobra... oye, ¿tienes sitio para alguien más?%SPEECH_OFF%}"
    }
    // en = "Welcome to the company!"
    // en base_es
    // en = "You'll have to find your luck elsewhere."
    // en base_es
    // context: legend_hunting_basilisks_contract.createScreens.m.Screens.push().start.Contract.m.Dude.getBackground().m.RawDescription
    {
        en = "You found %name% cornered by basilisks in the woods where the hunter quickly became the hunted and climbed a tree to survive. While they jest about the situation with everyone else, you can't help but notice a simmering anger whenever they see a coup of chickens."
        es = "Encontraste a %name% en el bosque, con unos basiliscos cerrándole el paso: quien iba de caza pasó enseguida a ser la presa y tuvo que subirse a un árbol para sobrevivir. Aunque bromea con todos sobre lo ocurrido, no puedes evitar notar una rabia contenida cada vez que ve un gallinero."
    }
    // context: legend_hunting_basilisks_contract.createScreens.m.Screens.push().start.Contract.m.Dude.worsenMood()
    {
        en = "Almost consumed alive by basilisks"
        es = "Casi sirvió de comida a unos basiliscos"
    }
    // context: legend_hunting_basilisks_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_85.png[/img]{%employer% greets you as you enter the room. While they remain solemn their nose suggests otherwise. A decorated servant stands by with a bag of crowns, this is almost a ceremony of sorts. %SPEECH_ON%Well done Sellsword! We all appreciate you ridding us of these...what did you call them, Wellington?%SPEECH_OFF% The steward looks at %employer% sheepishly. %SPEECH_ON%Cockatrices, Sir.%SPEECH_OFF% Two guards look at one another at the doorway almost out of your view, grinning ear-to-ear. %SPEECH_ON%Thank you for your expertise here, Sellsword!%SPEECH_OFF% Before you can correct them, a coin bag arrives in your hands and you are quickly escorted out of the hall. A servant rapidly cleans the filth left in %companyname%'s wake.\n\n Some of the peasants bring you food and drink as further thanks before you leave.}"
        es = "[img]gfx/ui/events/event_85.png[/img]{%employer% te saluda al entrar en la sala. Aunque mantiene la solemnidad, su nariz delata otra cosa. Un sirviente engalanado aguarda al lado con una bolsa de coronas; es casi una especie de ceremonia. %SPEECH_ON%¡Bien hecho, mercenario! Todos te agradecemos que nos hayas librado de estos... ¿cómo los llamaste, Wellington?%SPEECH_OFF% El mayordomo mira a %employer% con timidez. %SPEECH_ON%Cocatrices, señor.%SPEECH_OFF% Dos guardias se miran en la puerta, casi fuera de tu vista, sonriendo de oreja a oreja. %SPEECH_ON%¡Gracias por tu pericia, mercenario!%SPEECH_OFF% Antes de que puedas corregir el error, te ponen una bolsa de monedas en las manos y te acompañan rápidamente fuera de la sala. Un sirviente se apresura a limpiar la mugre que %companyname% ha dejado a su paso.\n\n Antes de que te marches, algunos campesinos te traen comida y bebida como muestra adicional de gratitud.}"
    }
    // context: legend_hunting_basilisks_contract.createScreens.m.Screens.push().Options.getResult.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation()
    {
        en = "Rid the town of basilisks"
        es = "Libró al pueblo de basiliscos"
    }
    // en = "beastslayer"
    // context: legend_hunting_basilisks_contract.spawnEnemies.party.setDescription()
    {
        en = "A stampede of basilisks hunting for food"
        es = "Una estampida de basiliscos en busca de comida"
    }
    // FILE: scripts\contracts\contracts\legend_hunting_coven_leader_contract.nut
    // context: legend_hunting_coven_leader_contract.create.m.Name
    {
        en = "A Cavort with the Coven (Legendary)"
        es = "Retozo con el aquelarre (Legendario)"
    }
    // context: legend_hunting_coven_leader_contract.create.m.DescriptionTemplates
    {
        en = "Dark rituals, flawless beauty, a nobleman's ardor. Twisted and maniacal, you must face the coven of witches."
        es = "Rituales oscuros, belleza impecable, el ardor de un noble. Debes enfrentarte al retorcido y maníaco aquelarre de brujas."
    }
    // context: legend_hunting_coven_leader_contract.create.m.DescriptionTemplates
    {
        en = "The Coven is a cabal of dark souls and twisted minds, their sinister powers spreads their malevolent influence far and wide."
        es = "El aquelarre es una camarilla de almas oscuras y mentes retorcidas, cuyos siniestros poderes extienden su influencia malévola por todas partes."
    }
    // context: legend_hunting_coven_leader_contract.create.m.DescriptionTemplates
    {
        en = "A Coven is a cesspit of dark magic and corruption. Burn them all, and quickly! Lest they claim your soul."
        es = "Un aquelarre es una cloaca de magia oscura y corrupción. ¡Quémalas a todas, y deprisa! No sea que se queden con tu alma."
    }
    // context: legend_hunting_coven_leader_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        en = "Stay around %townname% and protect %employer%'s playboy son"
        es = "Permanece en %townname% y protege al hijo mujeriego de %employer%"
    }
    // en = "Curse"
    // context: legend_hunting_coven_leader_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_79.png[/img]{You enter the keep of %employer% and are ushered down corridors and into a darkened bedroom lit by candles. The whole room appears to be arranged as some kind of lover's nest, centered around a huge canopied bed, the largest you have ever seen. The side tables are arrayed with wine bottles and the floor sprinkled with rose petals. You begin to imagine what must have happened in this space, but your thoughts are cut off by a gruff voice from a large man in rich robes. %SPEECH_ON%Disgusting isn't it? A den of debauchery and heresy, in my own house! Performed by my own blood no less. I tried to raise my kin right, gave them all the opportunity in the world. How do they repay me? With hedonous acts that tarnish our good name! Can you believe the youth of today?%SPEECH_OFF% You shift in place, thinking of the best way to reply, but he continues. %SPEECH_ON%It's a disgrace. The sex and alcohol is not the worst of it though, the boy has terrible taste in prostitutes and fell in with witches.  Now they are saying he agreed to give up the town in exchange for some debaucherous act with the leader of the coven. Well I am not giving up the town my ancestors built up from dirt. You are to accompany him out to meet the leader, and 'negotiate' a new 'deal'.%SPEECH_OFF%   | Unusually your employer %protectee% meets you outside of town in a grove of trees.%SPEECH_ON%Thank the gods you came, I was worried my dad %employer% would see you first.  You see I have gotten in some trouble, and I would prefer to resolve it before he does, perhaps win back some respect. %SPEECH_OFF% You ask what kind of trouble. %SPEECH_ON%One night while out carousing, I met a group of women, the most beautiful i have ever seen. They looked at me from across the crowded inn, and we drunk and danced the night away, winding up in my room at the keep. There were five of them, and we were joking around playing games, the kind where you end up with fewer clothes and more alcohol. It sounds foolish now, but they were so suple and inviting. They offered to let me have my way with all of them, if I would offer them the keys to the town. I was so drunk and my manhood was so enraged, that I would offer anything for a chance to sleep with five gorgeous women at once. They danced and massaged, they did such unspeakable things to me, and to each other. It grew to a fever pitch, until at the very height of the moment as I climaxed, it all started to go wrong. The one who was atop me seemed to lose weight in an instant, her bosom shriveled and her skin fell in wrinkles, spotted and crusted. It was foul. Before I knew it, I was completely surrounded by the fetid stench of five disgusting old women. They cackled, with maddening glee. Then they held up the contract I had signed. %SPEECH_OFF%  The man looks deflated, and looks up at you pleadingly %SPEECH_ON%   I have to make this right. I am sure I can negotiate a better deal, perhaps plead with them for mercy. Will you accompany me out to see the coven? %SPEECH_OFF% }"
        es = "[img]gfx/ui/events/event_79.png[/img]{Entras en la fortaleza de %employer% y te conducen por pasillos hasta un dormitorio en penumbra iluminado con velas. Toda la habitación parece dispuesta como una especie de nido de amor, en torno a una enorme cama con dosel, la más grande que has visto nunca. Las mesitas están llenas de botellas de vino y el suelo, sembrado de pétalos de rosa. Empiezas a imaginar lo que debe de haber pasado aquí, pero la voz áspera de un hombre corpulento con ropas lujosas interrumpe tus pensamientos. %SPEECH_ON%Asqueroso, ¿verdad? ¡Un antro de libertinaje y herejía, en mi propia casa! Y obra de mi propia sangre, nada menos. Intenté criar bien a los míos, les di todas las oportunidades del mundo. ¿Y cómo me lo pagan? ¡Con actos hedonistas que manchan nuestro buen nombre! ¡La juventud de hoy en día! ¿Puedes creerlo?%SPEECH_OFF% Te remueves en el sitio, pensando en la mejor forma de responder, pero él continúa. %SPEECH_ON%Es una vergüenza. Aunque el sexo y el alcohol no son lo peor: el muchacho tiene un gusto pésimo para las prostitutas y acabó metido con brujas.  Ahora dicen que aceptó entregar el pueblo a cambio de algún acto depravado con la líder del aquelarre. Pues yo no pienso entregar el pueblo que mis antepasados levantaron de la nada. Lo acompañarás a reunirse con la líder y 'negociarás' un nuevo 'trato'.%SPEECH_OFF%   | Contra lo habitual, tu patrón %protectee% se reúne contigo fuera del pueblo, en una arboleda.%SPEECH_ON%Gracias a los dioses que has venido. Temía que mi padre, %employer%, te viera antes.  Verás, me he metido en un lío, y preferiría resolverlo antes de que lo haga él, y quizá recuperar algo de respeto. %SPEECH_OFF% Le preguntas qué clase de lío. %SPEECH_ON%Una noche, estando de juerga, conocí a un grupo de mujeres, las más hermosas que he visto nunca. Me miraron desde el otro lado de la posada abarrotada, y bebimos y bailamos toda la noche, hasta acabar en mi habitación de la fortaleza. Eran cinco, y estábamos bromeando y jugando a esos juegos en los que acabas con menos ropa y más alcohol. Ahora suena estúpido, pero eran tan flexibles y tan provocativas. Se ofrecieron a dejarme hacer con todas ellas lo que quisiera si les entregaba las llaves del pueblo. Estaba tan borracho y mi virilidad tan enardecida que habría ofrecido cualquier cosa por la ocasión de acostarme con cinco mujeres preciosas a la vez. Bailaron y me dieron masajes, me hicieron cosas inconfesables, a mí y entre ellas. La cosa fue subiendo de tono hasta que, en el momento culminante, justo cuando llegaba al clímax, todo empezó a torcerse. La que estaba encima de mí pareció adelgazar de golpe; sus pechos se marchitaron y su piel se llenó de arrugas, manchas y costras. Era repugnante. Antes de darme cuenta, estaba rodeado por completo del hedor fétido de cinco viejas asquerosas. Se carcajeaban con un regocijo enloquecedor. Luego alzaron el contrato que yo había firmado. %SPEECH_OFF%  El hombre parece abatido y te mira suplicante %SPEECH_ON%   Tengo que arreglar esto. Estoy seguro de que puedo negociar un trato mejor, o quizá suplicarles clemencia. ¿Me acompañarás a ver al aquelarre? %SPEECH_OFF% }"
    }
    // en = "\x7bYou'll have to pay us very well in order to take on this enemy. | Convince me this is worth it with a full pouch of crowns. | I expect to be paid very well to fight an enemy as this.\x7d"
    // en base_es
    // en = "\x7bSounds to me like you should honor your pact. | This won't be worth the risk. | I'd rather not get the company involved with an enemy like this.\x7d"
    // en base_es
    // context: legend_hunting_coven_leader_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "otra mujer me ha ganado esa mano" no se entiende y no es "another woman done beat them to the punch"; pasa a "otra mujer se les adelantó"
        // corrige base: "eso sonaba como una locura total" pierde la cigarra ("cicada cockamamie") por la que el capitán pregunta justo después; pasa a "paparruchas de cigarra"
        en = "[img]gfx/ui/events/event_79.png[/img]{%randombrother% comes up to you. %They're_randombrother% auguring %their_randombrother% ear with a pinky.%SPEECH_ON%Hey there captain. You seen any of them saucy broads yet?%SPEECH_OFF%Hearing this, %randombrother2% comes over. %They_randombrother2% leans in.%SPEECH_ON%Hey, the way I hear it them hexes ARE quite the lookers, but that's how they get ya. They fool ya with their charms and then eat yer very soul.%SPEECH_OFF%Laughing, %randombrother% wipes the wax on %randombrother2%'s garb.%SPEECH_ON%They'll have to go to %randomtown% to get my soul, then, cause another woman done beat them to the punch.%SPEECH_OFF% | You're inspecting inventory when %randombrother% comes up. You'd sent %them_randombrother% to scout the lands and %they're_randombrother% readied a report.%SPEECH_ON%Sir, nothing sighted as of yet, but I got talking to some of the locals. The way they have it, the witches make pacts with regular folk and then trade on the investment years later, usually with great interest. They said they can fool you into seeing them as licentious minxes. They can bed you right into the grave! I said that sounded like cicada cockamamie to me.%SPEECH_OFF%Nodding, you ask the man what the hell a cicada is. %They_randombrother% laughs.%SPEECH_ON%Seriously? It's a kind of nut, sir.%SPEECH_OFF% | The brothers are idling the time away, bantering about women and witches alike and if there's any real significant difference at all. %randombrother% holds %their_randombrother% hand out.%SPEECH_ON%Now in all seriousness, I've heard tales of these wenches. They can put a hex on you to make you see things. They'll make you sign bloodpacts and if you don't pay they'll cut your kneecaps out and use them for divination. Hell, when I was a child, my neighbor made a deal with one and then he disappeared. I later saw a mysterious woman walking around with a fresh skull being used for a lantern!%SPEECH_OFF%%randombrother2% nods attentively.%SPEECH_ON%That's incredible, but does anybody know what a witch does?%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_79.png[/img]{%randombrother% se te acerca. Se está hurgando la oreja con el meñique.%SPEECH_ON%Eh, capitán. ¿Ya has visto a alguna de esas mozas atrevidas?%SPEECH_OFF%Al oírlo, %randombrother2% se acerca y se inclina hacia delante.%SPEECH_ON%Oye, por lo que tengo entendido, esas brujas SÍ que son guapas, pero así es como te atrapan. Te engatusan con sus encantos y luego se comen tu alma.%SPEECH_OFF%Entre risas, %randombrother% limpia la cera en la ropa de %randombrother2%.%SPEECH_ON%Pues tendrán que ir a %randomtown% a buscar mi alma, porque otra mujer se les adelantó.%SPEECH_OFF% | Estás revisando el inventario cuando %randombrother% se acerca. %Lo_randombrother% habías enviado a explorar la zona y ya tiene listo un informe.%SPEECH_ON%Señor, de momento no hemos visto nada, pero he estado hablando con algunos lugareños. Según ellos, las brujas hacen pactos con la gente corriente y años después cobran la inversión, normalmente con grandes intereses. Dicen que pueden engañarte para que las veas como unas zorras lascivas. ¡Te pueden llevar a la tumba en la cama! Yo les dije que eso me sonaba a paparruchas de cigarra.%SPEECH_OFF%Asintiendo, le preguntas qué diablos es una cigarra. Se ríe.%SPEECH_ON%¿En serio? Es un tipo de fruto seco, señor.%SPEECH_OFF% | Los hermanos matan el tiempo bromeando sobre mujeres y brujas por igual, y sobre si hay alguna diferencia real entre unas y otras. %randombrother% extiende la mano.%SPEECH_ON%Ahora en serio, he oído historias sobre esas mujeres. Pueden echarte un maleficio para que veas cosas. Te hacen firmar pactos de sangre y, si no pagas, te arrancan las rótulas y las usan para adivinar el futuro. ¡Demonios, cuando era niñ%o_randombrother%, mi vecino hizo un trato con una y luego desapareció! ¡Más tarde vi a una mujer misteriosa paseándose con un cráneo fresco que usaba de linterna!%SPEECH_OFF%%randombrother2% asiente con atención.%SPEECH_ON%Es increíble, pero ¿alguien sabe qué hace una bruja?%SPEECH_OFF%}"
    }
    // en = "Stay focused, lads."
    // en base_es
    // context: legend_hunting_coven_leader_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "Se pasea con un vestido de seda agitado por el viento" y "con una intensidad" rebajan "thighs slipping in and out of a silk dress" y "licentiousness"
        // corrige base: "pero eres tan insensible" rebaja y cambia "the cock slackens, and the pride returns"; pasa a "la verga se afloja y el orgullo regresa"
        // corrige base: "del espesor" -> "de la espesura" (errata); "un titiritero que comanda desde las nubes" -> "que gobierna las nubes" (in command of the clouds)
        en = "[img]gfx/ui/events/event_106.png[/img]{A lone woman crosses your path and approaches between a gap of trees. She saunters with her thighs slipping in and out of a silk dress. Her skin is spotless and emerald eyes stare between locks of red with licentiousness you haven't seen since you were just a lad. You know this woman is a witch for such perfection cannot stand in this world and in these parts it is like putting on makeup to go to the grave. Which is what she has done. You draw your sword and tell her to face her doom with honor. The witch's skin wrinkles to true, ghastly form, and she cackles with delight.%SPEECH_ON%Ah, for a moment I had you, but the cock slackens, and the pride returns. You've such delightful scents, sellsword. I'll make sure they save you just for me.%SPEECH_OFF%Before you can ask what she means, the two trees she stand between blossom with the stretching of spider legs. Great black bulbs emerge from the thicket and scuttle to the terra below, the webknechts clacking their mandibles with imago hunger. The witch's hands go up and her fingers dance like a puppeteer in command of the clouds above.}"
        es = "[img]gfx/ui/events/event_106.png[/img]{Una mujer solitaria se cruza en tu camino y se acerca por un hueco entre los árboles. Camina contoneándose, con los muslos asomando y ocultándose bajo un vestido de seda. Su piel es impecable y sus ojos esmeralda te miran entre mechones pelirrojos con una lascivia que no veías desde que eras un muchacho. Sabes que esta mujer es una bruja, pues semejante perfección no puede existir en este mundo, y en estas tierras es como maquillarse para ir a la tumba. Que es lo que ha hecho. Desenvainas la espada y le dices que afronte su destino con honor. La piel de la bruja se arruga hasta mostrar su verdadera y espantosa forma, y se carcajea con deleite.%SPEECH_ON%Ah, por un momento te tuve, pero la verga se afloja y el orgullo regresa. Tienes unos aromas deliciosos, mercenario. Me aseguraré de que te guarden solo para mí.%SPEECH_OFF%Antes de que puedas preguntarle qué quiere decir, de los dos árboles entre los que se encuentra brotan patas de araña que se estiran. Grandes bulbos negros emergen de la espesura y se escabullen hasta el suelo; las tejedoras de redes chasquean las mandíbulas con un hambre de imago. Las manos de la bruja se alzan y sus dedos danzan como los de un titiritero que gobierna las nubes del cielo.}"
    }
    // context: legend_hunting_coven_leader_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "como los estertores finales" no es "like final congregates upon a dying world"; pasa a "como los últimos fieles congregados"
        // corrige base: "tu rostrocon el tiempo" -> "tu rostro con el tiempo" (errata)
        en = "[img]gfx/ui/events/event_106.png[/img]{%randombrother% whistles and tips %their_randombrother% cap at the beautiful ladies which have arrived seemingly out of nowhere to swoon before the company. You hold the sellsword back and step forward, but before you can speak one of the women holds her hands up and strides to meet you.%SPEECH_ON%Let me show you my true self, sellsword.%SPEECH_OFF%Her arms go to her sides and there turn grey and shrivel like wet almond skin. Once bright and silken hair falls out in long wispy strands until her grotesque skull is bared, the last roots there holding clumped assemblage of gnats and lice like final congregates upon a dying world. She bows, her face up toward you with a yellow grin shorn across it.%SPEECH_ON%We've great power, sellsword, of this you surely see. I offer you a deal.%SPEECH_OFF%She produces a tiny vial in each hand, one carrying a drop of green liquid, the other blue. She smiles and spins them in her fingers as she talks.%SPEECH_ON%A drink for the body, or for the spirit. Men would kill for either. I offer you one in exchange for the firstborn's life. What worth is the offspring of a stranger? You've slaughtered your fair share, have you not? Stand aside, sellsword, and let us have this one. Or confront us, risk your men's lives, and your own, all for some runt who won't remember your face in due time. It's your choice.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_106.png[/img]{%randombrother% silba y se quita el sombrero ante las hermosas damas que han llegado aparentemente de la nada para cautivar a la compañía. Retienes %al_randombrother% mercenari%o_randombrother% y das un paso adelante, pero antes de que puedas hablar, una de las mujeres levanta las manos y se acerca a ti.%SPEECH_ON%Déjame mostrarte mi verdadero yo, mercenario.%SPEECH_OFF%Sus brazos caen a los costados y allí se vuelven grises y se marchitan como piel de almendra mojada. El cabello, antes brillante y sedoso, cae en largos mechones ralos hasta que su grotesco cráneo queda al descubierto, y las últimas raíces sostienen un grupo apelmazado de mosquitos y piojos como los últimos fieles congregados sobre un mundo moribundo. Se inclina, con el rostro alzado hacia ti y una sonrisa amarillenta atravesándolo.%SPEECH_ON%Tenemos un gran poder, mercenario, de eso seguramente te has dado cuenta. Te ofrezco un trato.%SPEECH_OFF%La mujer saca un pequeño frasco en cada mano; uno contiene una gota de líquido verde, el otro, azul. Sonríe y los hace girar entre los dedos mientras habla.%SPEECH_ON%Una bebida para el cuerpo o para el espíritu. Los hombres matarían por cualquiera de ellas. Te ofrezco una a cambio de la vida del primogénito. ¿Qué valor tiene el hijo de un desconocido? Ya has matado a unos cuantos, ¿no es así? Hazte a un lado, mercenario, y déjanos llevárnoslo. O enfréntanos, arriesga la vida de tus hombres y la tuya propia, todo por un mocoso que no recordará tu rostro con el tiempo. Es tu elección.%SPEECH_OFF%}"
    }
    // en = "I will never yield that boy to you hags. To arms!"
    // en base_es
    // en = "I desire a drink for the body."
    // en base_es
    // en = "I desire a drink for the spirit."
    // en base_es
    // context: legend_hunting_coven_leader_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "es la desaparición del primogénito" no es "the demise" (muerte); "qué tan lejos" es regional, pasa a "a qué distancia"
        en = "[img]gfx/ui/events/event_106.png[/img]{The witch smiles.%SPEECH_ON%A man is nothing without an able body to maneuver him through the world. Here you are, sellsword. Please, do not waste it.%SPEECH_OFF%She tosses you the vial. Twisting through the air, it winks viridian spectra across the earth, each dip of its faint light springing forth a tiny flower out of unseeded mud. You catch the glass. It vibrates in your hand, and the ache of your bones slowly depart, as though your fist had been asleep all this time and you just didn't know it. When you look up for an explanation the witches are already gone. A lone cry is all that's left, piping up in the great distance yet with no way to ascertain just how far off it is. No doubt it is the demise of %employer%'s son.}"
        es = "[img]gfx/ui/events/event_106.png[/img]{La bruja sonríe.%SPEECH_ON%Un hombre no es nada sin un cuerpo capaz de moverse por el mundo. Aquí lo tienes, mercenario. Por favor, no lo desperdicies.%SPEECH_OFF%Te arroja el frasco. Girando en el aire, destella espectros verde esmeralda sobre la tierra, y en cada destello de su débil luz hace brotar una pequeña flor del lodo, sin semillas aparentes. Atrapas el frasco. Vibra en tu mano y el dolor de tus huesos se va desvaneciendo lentamente, como si tu puño hubiera estado dormido todo este tiempo y tú simplemente no lo supieras. Cuando levantas la vista en busca de una explicación, las brujas ya se han ido. Solo queda un grito solitario, que resuena a lo lejos sin forma de saber a qué distancia está. Sin duda, es la muerte del hijo de %employer%.}"
    }
    // en = "Betrayed <x:str> and struck a deal with witches"
    // en base_es
    // context: legend_hunting_coven_leader_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_106.png[/img]{With a flip of her hand and a bump of her wrist the witch shunts the green vial down her sleeve. The remaining blue vial she holds out to you.%SPEECH_ON%A smart man you are, sellsword.%SPEECH_OFF%She snorts harshly, her fat nose shriveling into a maggot's girth before flopping back down.%SPEECH_ON%I do sense sharp minded men in your blood, sellsword. I'd almost want to have the blood for myself.%SPEECH_OFF%Her eyes stare at you like a cat upon a delimbed cricket, a cricket which still dares to move. But then her smile returns, more gum than teeth, more black than pink.%SPEECH_ON%Ah, well, a deal is a deal. Here you are.%SPEECH_OFF%She throws the vial through the air and by the time you catch it and look back the witches are gone. You hear the faint cry of horrific torture, its distance seemingly both near and far, and you've little doubt that it is the demise of %employer%'s son.}"
        es = "[img]gfx/ui/events/event_106.png[/img]{Con un giro de la mano y un golpe de muñeca, la bruja oculta el frasco verde en su manga. El frasco azul restante lo sostiene frente a ti.%SPEECH_ON%Eres un hombre astuto, mercenario.%SPEECH_OFF%Resopla bruscamente, y su nariz gorda se encoge hasta el grosor de una larva antes de volver a caer.%SPEECH_ON%Siento hombres de mente aguda en tu sangre, mercenario. Casi desearía tener esa sangre para mí.%SPEECH_OFF%Sus ojos te miran como un gato a un grillo sin patas, un grillo que aún se atreve a moverse. Pero luego su sonrisa regresa, más encías que dientes, más negra que rosada.%SPEECH_ON%Ah, bueno, un trato es un trato. Aquí lo tienes.%SPEECH_OFF%Lanza el frasco por el aire y, cuando lo atrapas y vuelves a mirar, las brujas ya se han ido. Oyes el débil grito de una tortura horrible, a una distancia que parece a la vez cercana y lejana, y no te cabe duda de que es la muerte del hijo de %employer%.}"
    }
    // en = "[img]gfx/ui/events/event_106.png[/img]\x7b%randombrother% whistles and yells out.%SPEECH_ON%We've company. Nice... beautiful company...%SPEECH_OFF%A licentious looking woman is approaching the band. She sashays over the ground with ease, one finger playing with her ear, the other pinching a stone hanging over her bulging bosom. You clap the sellsword on the shoulder.%SPEECH_ON%That's no ordinary lady.%SPEECH_OFF%Just as the words leave your lips, the woman's ample and youthful features shrivel into a patterned grey and her luxurious hair withers from her pate and what you're left with is a hag, grinning with nothing but evil intentions. To arms! Keep %protectee% safe! | You spot a woman approaching the party. She's wearing bright red and a necklace sways over and between her ample bosom. It's quite the sight, but she is flawless and such a thing does not exist in this world.\n\nYou draw your sword. The lady sees the steel and then looks at you with a wily grin. Plots of hair fall from her head and what's left shrivels into grey wisps. Her skin shrinks into pale valleys and her fingernails grow so long they curl. She points a finger at you and screams that nobody will prevent the conclusion of the pact she's made. You yell out to the company to make sure %protectee% is kept out of harm's way. | A woman is spotted approaching the company. The sellswords are ensorcelled by her beauty, but you know better. You draw your sword and clang it loud enough to draw the ire of this supposed lady. She sneers and her lips snap back with a grin that goes from nearly ear to ear. Her skin tightens until it creases and turns a pale grey. She laughs and laughs as her hair falls out. The witch points a finger at you.%SPEECH_ON%Ah, I smell your ancestry, sellsword, but it matters not where you come from. The pact must be paid by the firstborn's blood and anyone who stands in our way will bleed in kind!%SPEECH_OFF%The company falls into formation and you tell %protectee% to keep his head down.\x7d"
    // en base_es
    // en = "[img]gfx/ui/events/event_124.png[/img]\x7bAs you start your return trip to %employer%, you find %superstitious% staring down at a witch. You can see the damned woman's lips are still moving and you rush over. She's speaking in curses which you shutup with the heel of your boot. Teeth flutter from rent gums as she laughs. You draw your sword and stab it between her eyes, putting her to rest once and for all. %superstitious% is just about shaking.%SPEECH_ON%She knew all about me! She knew everything, captain! She knew everything! She knew when I'd die and how!%SPEECH_OFF%You tell the man to ignore every word the witch told him. Nodding, he rejoins the company, but his face grimaces with fortunes that can't go unheard.\x7d"
    // en base_es
    // en = "Don't think about it."
    // en base_es
    // en = "<dude:str> is afraid"
    // en base_es
    // en = "Was cursed by a witch"
    // en base_es
    // en = "[img]gfx/ui/events/event_124.png[/img]\x7bAs the men recover from battle, a young peasant runs across the field hollering and whooping. You turn to see him fall before a witch and hold her ghastly, leathery body up, clutching it between his arms and rocking back and forth. Seeing you, he spits curses.%SPEECH_ON%Why'd you do it, huh? Goddam bastards the lot of ya! She was wed to me a fortnight ago and now I must bury her. Well I say take me with her! Do your worst, you savages! This world will bury us both, my love!%SPEECH_OFF%You raise an eyebrow. The man must have been bewitched sometime before your arrival, probably a lackey for the witches. Whatever you think, a few of the men are a bit disturbed by the sight of the grieving boy. However, one hardier sellsword with a slick grin and his hand on his weapon asks if he should grant the kid his request. You shake your head no and order the men back into formation.\x7d "
    // en base_es
    // en = "Poor fool."
    // en base_es
    // context: legend_hunting_coven_leader_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "no pudo haber sido lo más mínimo de divertido" es agramatical; pasa a "no pudo tener ni la menor gracia"
        en = "[img]gfx/ui/events/event_124.png[/img]{The battle over, %randombrother% comes to your side. %They_randombrother% says %protectee% died during the fight. Says his eyeballs are gone as is his tongue, that his face looks like two wet rags folding in on each other. No point in going back to %employer% now. | You look down at %protectee%'s corpse. The eyeballs have been yanked and hang down his cheeks like wet craw. His face is stretched into a smile, though whatever put it that way couldn't have been the least bit funny. %randombrother% asks if the company should return to %employer% and you shake your head no. | You find %employer%'s firstborn crumpled on the ground. Every joint has been scooped or carved out, though when or how this happened is beyond you. %randombrother% tries to move the body, but it twists and clatters like a stringless puppet. The sellsword grimaces and throws the corpse back to the ground where it rimples into a basket of its own ribcage, the head egglike in the nest. There's no point in returning to %employer% now.}"
        es = "[img]gfx/ui/events/event_124.png[/img]{Terminada la batalla, %randombrother% se acerca a tu lado. Dice que %protectee% murió durante la pelea. Dice que le arrancaron los ojos y la lengua, y que su rostro parece dos trapos húmedos plegándose uno sobre el otro. Ya no tiene sentido regresar con %employer%. | Bajas la vista hacia el cadáver de %protectee%. Le han arrancado los globos oculares, que le cuelgan por las mejillas como caracoles mojados. Su rostro está estirado en una sonrisa, aunque lo que lo dejó así no pudo tener ni la menor gracia. %randombrother% pregunta si la compañía debería regresar con %employer% y niegas con la cabeza. | Encuentras al primogénito de %employer% desplomado en el suelo. Le han vaciado o arrancado todas las articulaciones, aunque no alcanzas a entender cuándo ni cómo ocurrió. %randombrother% intenta mover el cuerpo, pero se retuerce y traquetea como una marioneta sin hilos. %Art_randombrother% mercenari%o_randombrother% hace una mueca y arroja el cadáver de vuelta al suelo, donde se pliega en una cesta formada por sus propias costillas, con la cabeza como un huevo en el nido. Ya no tiene sentido regresar con %employer%.}"
    }
    // en = "Shite, shite, shite!"
    // en base_es
    // en = "Failed to protect <x:str>\'s firstborn son"
    // en base_es
    // en = "[img]gfx/ui/events/event_16.png[/img]\x7b%employer% was paying you to protect %protectee%. The firstborn is hard to protect when you leave %townname% and abandon him to the witches. Don't bother going back for your pay. | You had been tasked to keep %protectee% safe in %townname%, or did you forget? Don't bother going back, the firstborn is no doubt already dead or, worse, taken by the witches for some nefarious purpose.\x7d"
    // en base_es
    // en = "Oh, damn."
    // en base_es
    // en = "[img]gfx/ui/events/event_79.png[/img]\x7b%employer% embraces %protectee%, holding the firstborn tight. He looks at you.%SPEECH_ON%So it's done then, all the witches are dead?%SPEECH_OFF%You nod. The townsman nods back.%SPEECH_ON%Thank you! Thank you, mercenary!%SPEECH_OFF%He points you to a chest in the corner of the room. It's full of your payment. | You return %protectee% to %employer%. The townsman and firstborn embrace like the telling of two separate dreams of identical circumstance, slowly coming together despite the appeals of reality. Finally, they hug and clench one another and pause to stare at one another to be sure it's all real. You tell %employer% that every witch is dead, but that he should keep the tale to himself. He nods.%SPEECH_ON%Spirits feed on hubris, I know that much, and I shall take this story to the grave. I thank you for what you've done today, sellsword. I thank you to such lengths you could not possibly know. I've but one way to express my appreciation.%SPEECH_OFF%He brings you a satchel of gold. The sight of the bag bulging with coin brings a warm smile to your face. | %protectee% runs from your side and into the arms of %employer%. The townsman looks over his firstborn's shoulders.%SPEECH_ON%So it's done then, we are free of the curse?%SPEECH_OFF%You shrug and respond.%SPEECH_ON%You're free of the witches.%SPEECH_OFF%The townsman purses his lips and nods.%SPEECH_ON%Well, that's good enough. Your payment is over there in the satchel, as much as promised.%SPEECH_OFF%\x7d"
    // en base_es
    // en = "All worked out in the end."
    // en base_es
    // context: legend_hunting_coven_leader_contract.createScreens.m.Screens.push().Options.getResult.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation()
    {
        // this.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation(this.Const.World.Assets.RelationCivilianContractSuccess, "Protected " + this.Contract.getEmployer().getName() + "\'s the town");
        mode = "pattern"
        en = "Protected <employer:str>'s the town"
        es = "Protegió el pueblo de <employer>"
    }
    // en = "superstitious"
    // en = "protectee"
    // FILE: scripts\contracts\contracts\legend_hunting_demon_alps_contract.nut
    // context: legend_hunting_demon_alps_contract.create.m.Name
    {
        en = "Ending the Terror Demon (Legendary)"
        es = "Acabar con el Demonio del Terror (Legendario)"
    }
    // context: legend_hunting_demon_alps_contract.create.m.DescriptionTemplates
    {
        en = "Alps are nightmares made flesh, yet they can be beaten. These reports though... sound downright demonic."
        es = "Los Alps son pesadillas hechas carne, pero se les puede vencer. Estos informes, sin embargo... suenan francamente demoníacos."
    }
    // context: legend_hunting_demon_alps_contract.create.m.DescriptionTemplates
    {
        en = "Beware these souldrinkers, for they are cunning and elusive, wreathed in the flames of hell."
        es = "Cuidado con estos bebedores de almas, pues son astutos y escurridizos, y van envueltos en las llamas del infierno."
    }
    // context: legend_hunting_demon_alps_contract.create.m.DescriptionTemplates
    {
        en = "Flamewalkers are creatures of darkness and despair, their very touch draining the life force from their victims."
        es = "Los caminantes de fuego son criaturas de oscuridad y desesperación; su mero contacto drena la fuerza vital de sus víctimas."
    }
    // context: legend_hunting_demon_alps_contract.start.names
    {
        en = "demons"
        es = "demonios"
    }
    // context: legend_hunting_demon_alps_contract.start.names
    {
        en = "dreameaters"
        es = "devorasueños"
    }
    // context: legend_hunting_demon_alps_contract.start.names
    {
        en = "souldrinkers"
        es = "bebedores de almas"
    }
    // context: legend_hunting_demon_alps_contract.start.names
    {
        en = "deathstalkers"
        es = "acechamuertes"
    }
    // context: legend_hunting_demon_alps_contract.start.names
    {
        en = "soulblights"
        es = "plagas de almas"
    }
    // context: legend_hunting_demon_alps_contract.start.names
    {
        en = "flamewalkers"
        es = "caminantes de fuego"
    }
    // context: legend_hunting_demon_alps_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        // "End the demons stalking " + this.Contract.m.Home.getName() + " at night"
        mode = "pattern"
        en = "End the demons stalking <home:str> at night"
        es = "Acaba con los demonios que acechan <home> por la noche"
    }
    // context: legend_hunting_demon_alps_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_68.png[/img]{The height of %employer%'s keep gives an impressive view of the surrounding country. From up here you could imagine yourself as lord of all you survey. Unfortunately, all you survey is not worth much. The people below you look haggard and sleep deprived. They shamble along like walking corpses, between burned out houses and blackened fields. A woman is howling in the distance, holding charred remains in a small blanket. %employer% joins you at the bannister and sighs heavily at the sight before you. He looks across the horizon for a time, like a stern man thinking through intense emotions. At last he speaks, a deep gruff voice in soft low tones. %SPEECH_ON%You look upon my father's lands. He carved this keep out of the raw earth, raised up a whole town for his kin. Then the night terrors came, in blood and fire they destroyed his dream. When he fought back, they destroyed him too.%SPEECH_OFF%The pain is obvious on %employer%'s face, but he turns away from the thought and towards you with iron determination. %SPEECH_ON%So, dream hunter, your arrival here so soon after the demons must not be a coincidence. I suppose you must have tracked the terrors here, in search of coin no doubt? Well, you shall have it. %SPEECH_OFF% His huge hand slaps you on the shoulder and he smiles as if finding dark humour in the situation. %SPEECH_ON% The nightmares have taken so much from me already, it seems only fitting that the rest should be taken by a dream hunter. If you return with a demon head, I will empty my coffers to you.%SPEECH_OFF% }"
        es = "[img]gfx/ui/events/event_68.png[/img]{Desde lo alto de la fortaleza de %employer% se domina una vista impresionante de la comarca. Desde aquí arriba podrías imaginarte señor de todo cuanto alcanza la vista. Por desgracia, todo cuanto alcanza la vista no vale gran cosa. La gente de abajo se ve demacrada y falta de sueño. Se arrastran como cadáveres andantes entre casas calcinadas y campos ennegrecidos. A lo lejos aúlla una mujer que sostiene unos restos carbonizados envueltos en una mantita. %employer% se reúne contigo en la baranda y suspira hondo ante la escena. Contempla el horizonte un rato, como un hombre severo que rumia emociones intensas. Por fin habla, con una voz grave y áspera, en tono bajo y suave. %SPEECH_ON%Contemplas las tierras de mi padre. Él talló esta fortaleza en la tierra virgen y levantó todo un pueblo para los suyos. Luego llegaron los terrores nocturnos y, entre sangre y fuego, destruyeron su sueño. Cuando les plantó cara, también lo destruyeron a él.%SPEECH_OFF%El dolor se ve claro en el rostro de %employer%, pero aparta ese pensamiento y se vuelve hacia ti con una determinación férrea. %SPEECH_ON%Así que, cazador de sueños, que hayas llegado tan poco después que los demonios no puede ser casualidad. Supongo que habrás seguido el rastro de esos terrores hasta aquí, en busca de monedas, sin duda. Pues las tendrás. %SPEECH_OFF% Su enorme mano te da una palmada en el hombro y sonríe como si le encontrara un humor negro a la situación. %SPEECH_ON% Las pesadillas ya me han quitado tanto que parece lo justo que lo que queda se lo lleve un cazador de sueños. Si vuelves con una cabeza de demonio, vaciaré mis arcas para ti.%SPEECH_OFF% }"
    }
    // context: legend_hunting_demon_alps_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{How many crowns can you muster? | And how many coins are in that coffer? | What is the total? | How much is left?}"
        es = "{¿Cuántas coronas puedes reunir? | ¿Y cuántas monedas hay en esas arcas? | ¿Cuál es el total? | ¿Cuánto queda?}"
    }
    // en = "\x7bThis doesn't sound like mercenary work. | This doesn't sound like our kind of work. | That's not the kind of work we're looking for.\x7d"
    // en base_es
    // en = "Near %townname%..."
    // en base_es
    // context: legend_hunting_demon_alps_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_71.png[/img]{As you walk past the smouldering ruins of a farmhouse, you notice a young teenage girl curled up in a burned out doorway. She stares into the middle distance, seemingly through you, not at you. %randombrother% walks up and asks if she knows where to find those that did this. The girl keeps looking through you, but speaks softly through cracked lips. %SPEECH_ON%You don't find them. They find you. There is no hiding. Every night they come, and every night they take someone. %SPEECH_OFF% %randombrother% asks if there is anything the girl needs, but she has gone silent and will say no more. | While you're checking your map and getting a lay of the land, %randombrother% comes up with a little girl at his side. She looks barely old enough to talk, and yet it clear she want's to tell you something. You bend down and she whispers in your ear.%SPEECH_ON%They mostly come at night, mostly.%SPEECH_OFF%. With that she turns and runs off into a burned out orchard, cackling with fiendish glee. }"
        es = "[img]gfx/ui/events/event_71.png[/img]{Al pasar junto a las ruinas humeantes de una granja, ves a una muchacha adolescente acurrucada en un umbral calcinado. Mira al vacío, aparentemente a través de ti y no a ti. %randombrother% se acerca y le pregunta si sabe dónde encontrar a quienes hicieron esto. La muchacha sigue mirando a través de ti, pero habla en voz baja con los labios agrietados. %SPEECH_ON%No los encuentras tú. Te encuentran ellos. No hay dónde esconderse. Vienen todas las noches, y todas las noches se llevan a alguien. %SPEECH_OFF% %randombrother% pregunta si la muchacha necesita algo, pero se ha quedado callada y no dirá nada más. | Mientras consultas el mapa y te haces una idea del terreno, %randombrother% se acerca con una niña al lado. Apenas parece tener edad para hablar, y aun así está claro que quiere decirte algo. Te agachas y ella te susurra al oído.%SPEECH_ON%Casi siempre vienen de noche, casi siempre.%SPEECH_OFF%. Dicho esto, se da la vuelta y echa a correr hacia un huerto calcinado, riendo con un regocijo diabólico. }"
    }
    // en = "\x7bKeep your eyes peeled. | We need to be ready for this. | Stay awake, people.\x7d"
    // en base_es
    // context: legend_hunting_demon_alps_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_demonalp.png[/img]{%randombrother% hurriedly comes to your side.%SPEECH_ON%Something's moving just yonder.%SPEECH_OFF%You take your eyes to the perimeter of the patrol. Whatever it is, it's not moving so much as slipping over the ground. It looks like a bloody skinned deer pacing backwards and its eyes leave streams of jet black behind as though to etch horror itself over the earth. You tell the men to grab their weapons. | Assessing your map by a torchlight, you suddenly see a black shape bounding through the darkness. It is a mess of limbs cartwheeling over the earth, flailing forward with unseemly speed. It stalks as low as a snake, yet you hear the choking snarl of someone dying in their sleep. You order the men to arms. | A dark red shape stalks the rim of the company's patrol. It crouches in the tall grass and stares at the company. Finally, you walk forward and hold your arms out and close your eyes. Immediately, %randombrother% calls out.%SPEECH_ON%Sir get back! Sir, oh by the gods there are more!%SPEECH_OFF%You open your eyes and nod. Finally, they've come.}"
        es = "[img]gfx/ui/events/legend_demonalp.png[/img]{%randombrother% se acerca a toda prisa.%SPEECH_ON%Algo se mueve justo allí.%SPEECH_OFF%Diriges la mirada al perímetro de la patrulla. Sea lo que sea, más que moverse, se desliza sobre el suelo. Parece un ciervo desollado y ensangrentado que camina hacia atrás, y sus ojos dejan tras de sí regueros de negro azabache, como si quisieran grabar el horror mismo sobre la tierra. Ordenas a los hombres que tomen las armas. | Mientras estudias el mapa a la luz de una antorcha, ves de pronto una forma negra que avanza a saltos en la oscuridad. Es un amasijo de extremidades que da volteretas sobre la tierra y se lanza hacia delante a una velocidad antinatural. Acecha a ras de suelo como una serpiente, y aun así oyes el gruñido ahogado de alguien que muere en sueños. Ordenas a los hombres que tomen las armas. | Una forma de un rojo oscuro acecha el borde de la patrulla de la compañía. Se agazapa entre la hierba alta y mira fijamente a la compañía. Al final, das un paso al frente, extiendes los brazos y cierras los ojos. De inmediato, %randombrother% grita.%SPEECH_ON%¡Señor, atrás! ¡Señor, por los dioses, que hay más!%SPEECH_OFF%Abres los ojos y asientes. Por fin han venido.}"
    }
    // context: legend_hunting_demon_alps_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_demonalp_dead.png[/img]{The monsters are slain. You take your sword and hack into one's neck. The blade cuts through with complete ease and the head lolls off into the grass. Its eyesockets are barren and concave. There's nothing inside, no flesh, no muscle. Whatever. You tell the men to get ready for a return march to %employer%. | The demons lay in the grass and though you know you saw them hurt, their flesh seems to have healed over and they seem more slain by your resilience than any weapon. You take your sword to saw a head off, only to find the blade slides right through the skin and the neckhole puckers closed. You stab the body a few times, twisting the blade to rend the flesh unmendable. Sinews slither briefly before coming to rest in the wound's hole. Not sure what to make of that, you shovel the head into a bag and tell the men ready a return to %employer%.}"
        es = "[img]gfx/ui/events/legend_demonalp_dead.png[/img]{Los monstruos han caído. Tomas tu espada y la hundes en el cuello de uno. La hoja lo atraviesa con total facilidad y la cabeza rueda por la hierba. Sus cuencas están vacías y hundidas. No hay nada dentro, ni carne ni músculo. Qué más da. Ordenas a los hombres que se preparen para la marcha de regreso con %employer%. | Los demonios yacen en la hierba y, aunque sabes que los viste heridos, su carne parece haberse cerrado, y diríase que los ha abatido más tu tenacidad que cualquier arma. Usas la espada para serrar una cabeza, solo para descubrir que la hoja atraviesa la piel sin más y el agujero del cuello se frunce hasta cerrarse. Apuñalas el cuerpo unas cuantas veces, retorciendo la hoja para desgarrar la carne sin remedio. Los tendones se retuercen un instante antes de asentarse en el agujero de la herida. Sin saber muy bien qué pensar de aquello, metes la cabeza en una bolsa y ordenas a los hombres que preparen el regreso con %employer%.}"
    }
    // en = "Payment awaits."
    // en base_es
    // context: legend_hunting_demon_alps_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_31.png[/img]{%employer% asks to see the demon's remains. You take it out of the bag. The flesh has deflated and you hold the head more like a scalp than a skull. %employer% reaches out to touch it and the demon skin twists away like fire made solid. He asks how they fought %SPEECH_ON% Like the brimstone of hell itself, I pray we need not see another so brutal %SPEECH_OFF%The man nods slowly.%SPEECH_ON% That is a prayer I can second. Well, I am a man of my word, my treasury is yours%SPEECH_OFF% | You dump the alp's head onto %employer%'s desk. It flops over the wood until its maw rests wide, its emptied eyesockets drooping sadly at the world above. %employer% takes a fire iron and fishes around the skull before hanging its shapelessness in the air.%SPEECH_ON%What an awful thing this is. I should let you know that many folks came to me just hours ago stating they'd visions of fields being bathed in a glorious light. Like they'd dreamt the renewal of the world whole. So I don't know if every last one of these monsters is gone, but it seems %townname%'s plight has been well taken care of. I'll see to it that you get your reward as promised.%SPEECH_OFF% | %employer% meets you in his room and laughs at the knapsack you've brought. He shakes his head as he pours a drink.%SPEECH_ON%You need not show me that foul thing's face, sellsword. It visited me just hours ago, while I was sitting right there writing notes, an intrusion that was a dream, a sight of its death as though its spirit had been severed from mine and I was forced to see it go. And in its leaving I saw you standing there, sword in hand, victorious..%SPEECH_OFF%You nod and ask if you looked good. He laughs.%SPEECH_ON%You looked a slayer of worlds, certainly a slayer of that creature's world and, I must fear, perhaps a bit of mine as well. Stolen, permanently. Well, no matter, I as a man whole or a man sundered, I've promised you a good pay and here it is.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_31.png[/img]{%employer% pide ver los restos del demonio. Los sacas de la bolsa. La carne se ha desinflado y sostienes la cabeza más como una cabellera arrancada que como un cráneo. %employer% alarga la mano para tocarla y la piel del demonio se retuerce y se aparta como fuego hecho sólido. Pregunta cómo pelearon. %SPEECH_ON% Como el azufre del mismísimo infierno. Ruego que no tengamos que ver otro tan brutal. %SPEECH_OFF%El hombre asiente despacio.%SPEECH_ON% Es una plegaria a la que me sumo. Bueno, soy un hombre de palabra: mi tesoro es tuyo.%SPEECH_OFF% | Dejas caer la cabeza del alp sobre el escritorio de %employer%. Rueda por la madera hasta que sus fauces quedan abiertas de par en par, con las cuencas vacías caídas con tristeza ante el mundo de arriba. %employer% toma un atizador, hurga en el cráneo y luego alza en el aire aquella cosa sin forma.%SPEECH_ON%Qué cosa más espantosa. Debes saber que hace apenas unas horas vino mucha gente a contarme que había tenido visiones de campos bañados en una luz gloriosa. Como si hubieran soñado la renovación del mundo entero. Así que no sé si hasta el último de estos monstruos ha desaparecido, pero parece que el mal que aquejaba a %townname% está bien resuelto. Me encargaré de que recibas tu recompensa, tal como prometí.%SPEECH_OFF% | %employer% te recibe en sus aposentos y se ríe de la mochila que has traído. Sacude la cabeza mientras se sirve una copa.%SPEECH_ON%No hace falta que me enseñes la cara de esa cosa inmunda, mercenario. Me visitó hace apenas unas horas, mientras estaba sentado justo ahí escribiendo notas: una intrusión que fue un sueño, una visión de su muerte, como si su espíritu se hubiera separado del mío y me viera obligado a verlo marchar. Y en su partida te vi a ti, allí de pie, espada en mano, victorioso...%SPEECH_OFF%Asientes y le preguntas si tenías buena pinta. Se ríe.%SPEECH_ON%Parecías un asesino de mundos; desde luego, el asesino del mundo de esa criatura y, me temo, quizá también de un poco del mío. Robado, para siempre. Bueno, no importa: sea yo un hombre entero o un hombre partido, te prometí una buena paga y aquí la tienes.%SPEECH_OFF%}"
    }
    // en = "Rid the town of unnatural nightmares"
    // en base_es
    // context: legend_hunting_demon_alps_contract.createScreens.m.Screens.push().Options.getResult.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation()
    {
        en = "Saviour of the lands"
        es = "Salvador de estas tierras"
    }
    // en = "[img]gfx/ui/events/event_33.png[/img]\x7bYou wager the men have earned themselves a good rest and take a break in %townname%. The men spend the nap in slumbers so deep they might as well be dead. Awaking, the men stretch and yawn. Not a one has a dream or nightmare to speak of, the snooze but a brief touch of oblivion, and a much needed one at that.\x7d"
    // en base_es
    // en = "I feel refreshed!"
    // en base_es
    // en = "Refreshed from having a great night's sleep"
    // en base_es
    // en = "enemy"
    // FILE: scripts\contracts\contracts\legend_hunting_greenwood_schrats_contract.nut
    // context: legend_hunting_greenwood_schrats_contract.create.m.Name
    {
        en = "The Heart of the Woods (Legendary)"
        es = "El corazón del bosque (Legendario)"
    }
    // context: legend_hunting_greenwood_schrats_contract.create.m.DescriptionTemplates
    {
        en = "They say that Schrats are the lost souls of the forest, yet this contract sounds like something more. Something far older, something far more terrible."
        es = "Dicen que los Schrats son las almas perdidas del bosque, pero este contrato suena a algo más. Algo mucho más antiguo, algo mucho más terrible."
    }
    // context: legend_hunting_greenwood_schrats_contract.create.m.DescriptionTemplates
    {
        en = "A malevolent presence lurks in the heart of the forest, its dark aura spreading like a poison through the trees and soil."
        es = "Una presencia malévola acecha en el corazón del bosque, y su aura oscura se extiende como un veneno por los árboles y la tierra."
    }
    // context: legend_hunting_greenwood_schrats_contract.create.m.DescriptionTemplates
    {
        en = "Some locals talk about the heart of the forest is if it were alive, or perhaps a deity to be worshiped."
        es = "Algunos lugareños hablan del corazón del bosque como si estuviera vivo, o quizá como de una deidad a la que adorar."
    }
    // en = "Hunt down what kills people in the woods around <home:str>"
    // en base_es
    // context: legend_hunting_greenwood_schrats_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_31.png[/img]{ %employer% greets you at the front door of his keep and invites you in. %SPEECH_ON%We're glad you could come trapper. When I received word there was a Schrat hunter in town I sent for you at once. Folks keep going missing in the woods and I've no recourse in getting them back. I've heard tales of trees on the move before, but this time is worse. We sent axemen in to take out the treemen before, but these ones just will not stay dead. They seem to glow with a life force, and each swing of our axes just makes these trees grow stronger. I understand you have fought them before, and I am sure your axes are sharp, but this contract is different. If you manage to return with your life, and without theirs, I will reward you handsomely for your efforts.%SPEECH_OFF% }"
        es = "[img]gfx/ui/events/event_31.png[/img]{ %employer% te recibe en la puerta principal de su fortaleza y te invita a pasar. %SPEECH_ON%Nos alegra que hayas podido venir, trampero. Cuando me llegó la noticia de que había un cazador de Schrats en el pueblo, mandé a buscarte de inmediato. La gente no deja de desaparecer en el bosque y no tengo manera de recuperarla. Ya había oído historias de árboles que se mueven, pero esta vez es peor. Ya mandamos antes a hacheros a acabar con los hombres árbol, pero estos no hay manera de que se queden muertos. Parecen brillar con una fuerza vital, y cada hachazo no hace más que fortalecer a estos árboles. Tengo entendido que ya te has enfrentado a ellos, y seguro que tus hachas están bien afiladas, pero este contrato es distinto. Si logras volver con vida, y sin la de ellos, te recompensaré generosamente por tus esfuerzos.%SPEECH_OFF% }"
    }
    // en = "\x7bInterested for sure. | Let's talk pay. | Let's talk crowns. | This is going to cost you. | A wild chase through the forest, then? Count me in. | The %companyname% can help, for the right price.\x7d"
    // en base_es
    // context: legend_hunting_greenwood_schrats_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{This doesn't sound like our kind of work. | This sounds too dangerous. | I don't think so. | I say no. We are mercenaries, not lumberjacks.}"
        es = "{Esto no parece trabajo para nosotros. | Esto suena demasiado peligroso. | No lo creo. | Digo que no. Somos mercenarios, no leñadores.}"
    }
    // context: legend_hunting_greenwood_schrats_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_128.png[/img]{As you trek through the woods, you begin to notice strange details. The plants here seem to be more vibrant and alive than in any forest you've seen. The forest floor is lush with clover and moss, a wild variety of flowers fill the air with their scent. Thick clouds of insects hang in the air, and everywhere you see animals running into the undergrowth. Something powerful has stirred the life force of the woods, and your men are very clearly intruders on the life filled wilderness. Knowing you are hunting trees, you treat each branch and root with suspicion, even the smallest sapling could turn against you at any moment. }"
        es = "[img]gfx/ui/events/event_128.png[/img]{Mientras avanzas por el bosque, empiezas a notar detalles extraños. Las plantas de aquí parecen más vibrantes y vivas que en cualquier bosque que hayas visto. El suelo está cubierto de un manto exuberante de trébol y musgo, y una variedad salvaje de flores llena el aire con su aroma. Densas nubes de insectos flotan en el aire, y por todas partes ves animales que se escabullen entre la maleza. Algo poderoso ha despertado la fuerza vital del bosque, y tus hombres son a todas luces intrusos en esta naturaleza rebosante de vida. Sabiendo que estás cazando árboles, miras cada rama y cada raíz con recelo: hasta el retoño más pequeño podría volverse contra ti en cualquier momento. }"
    }
    // en = "Watch where you step."
    // en base_es
    // context: legend_hunting_greenwood_schrats_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_heartwood.png[/img]{The undergrowth has grown thick and hard to walk through, a tangle of roots, vines and branches. Your men hack through the wood, sending shudders reverberating through the forest and birds squaking off into the air. Suddenly one of the branches rears back as you strike it in half. The leafy bough pulls away as a nearby trunk turns to face you, revealing a glowing face made from the gnarled burls of wood. The eyes seem to dance with a playful green fire and its other branches turn towards you, ready to strike. }"
        es = "[img]gfx/ui/events/legend_heartwood.png[/img]{La maleza se ha vuelto espesa y cuesta abrirse paso por ella: una maraña de raíces, enredaderas y ramas. Tus hombres se abren camino a hachazos, y los temblores reverberan por el bosque mientras los pájaros alzan el vuelo graznando. De repente, una de las ramas se echa hacia atrás cuando la partes por la mitad. La rama frondosa se retira mientras un tronco cercano se vuelve hacia ti y revela un rostro resplandeciente formado por los nudos retorcidos de la madera. Los ojos parecen danzar con un fuego verde juguetón, y sus otras ramas se vuelven hacia ti, listas para golpear. }"
    }
    // en = "Prepare for battle!"
    // en base_es
    // context: legend_hunting_greenwood_schrats_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_heartwood_ritual.png[/img]{You spot pairs of green eyes glowing in the distance. No doubt a sight of the schrats themselves, and so you order your men to clamber toward them quietly.\n\nCresting a hill you find the trunk of one tree is surrounded by a group of beautiful women. They have laid out offerings before the tree, taken off their clothes and they are chanting softly while dancing naked in the dappled light filtering through the canopy. Your arrival has not gone unnoticed as the schrat leans forward with a seemingly ancient crooning. The women at its root turn and hiss insults at you, schriveling into hags as they shout. You're not sure what to make of such arboreal allegiance, but those hags will die at the feet of %companyname% .}"
        es = "[img]gfx/ui/events/legend_heartwood_ritual.png[/img]{Distingues a lo lejos pares de ojos verdes que brillan. Sin duda se trata de los propios schrats, así que ordenas a tus hombres que avancen hacia ellos en silencio.\n\nAl coronar una colina, encuentras el tronco de un árbol rodeado por un grupo de mujeres hermosas. Han dispuesto ofrendas ante el árbol, se han quitado la ropa y cantan en voz baja mientras bailan desnudas bajo la luz moteada que se filtra entre las copas. Tu llegada no pasa desapercibida, pues el schrat se inclina hacia delante con un canturreo que parece antiquísimo. Las mujeres que están a sus raíces se dan la vuelta y te sisean insultos, y se marchitan hasta convertirse en brujas mientras gritan. No sabes muy bien qué pensar de semejante lealtad arbórea, pero esas brujas morirán a los pies de %companyname%.}"
    }
    // context: legend_hunting_greenwood_schrats_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_heartwood_dead.png[/img]{The schrats are slain, their arboreal remains now resembling little more than ordinary trees. You carve trophies and evidence for a return to %employer%. | You stare at a felled tree and then at a felled schrat. Between the two you see almost no difference, which makes you ponder about all those supposedly dead trees you've been hopping over your whole life. Not one to dwell on such matters, you order the company take trophies as proof of the battle and ready a return to %employer%. | The schrats are felled, each draped against the rest of the forest foliage like brawlers resting between rounds. You walk up beneath the roots of one and get a good look at it, but now it appears no different than any other tree around. You order the company to take what trophies they can to show %employer%.}"
        es = "[img]gfx/ui/events/legend_heartwood_dead.png[/img]{Los schrats han caído, y sus restos arbóreos ahora apenas se distinguen de árboles corrientes. Tallas trofeos y pruebas que llevarle a %employer%. | Miras un árbol caído y luego un schrat caído. Apenas ves diferencia entre ambos, lo que te hace pensar en todos esos árboles supuestamente muertos por encima de los que has ido saltando toda tu vida. Como no eres de los que le dan vueltas a esas cosas, ordenas a la compañía que recoja trofeos como prueba de la batalla y prepare el regreso con %employer%. | Los schrats han sido talados, y cada uno queda recostado contra el resto del follaje del bosque como púgiles que descansan entre asaltos. Te acercas bajo las raíces de uno y lo examinas bien, pero ahora no parece distinto de cualquier otro árbol de los alrededores. Ordenas a la compañía que recoja todos los trofeos que pueda para enseñárselos a %employer%.}"
    }
    // context: legend_hunting_greenwood_schrats_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_heartwood_dead.png[/img]{As you are departing the battlefield, %randombrother% remarks that the surrounding area looks rather ripe. You turn around to see that he is indeed correct: a beautiful crop of trees served host to the schrats, presumably chosen for good reason. And if the schrats took it for a good home, then it surely means the wood is very fine. You order the men to make use of this quality glade and chop as many trees down as time and energy permits. The harvested timber is very fine indeed.\n\n It begins to rain as you depart the impromptu lumbermill.}"
        es = "[img]gfx/ui/events/legend_heartwood_dead.png[/img]{Cuando estás abandonando el campo de batalla, %randombrother% comenta que la zona de alrededor parece bastante madura. Te das la vuelta y ves que tiene razón: una hermosa arboleda servía de hogar a los schrats, elegida seguramente por un buen motivo. Y si los schrats la tomaron por un buen hogar, sin duda significa que la madera es de primera. Ordenas a los hombres que aprovechen este claro de calidad y talen tantos árboles como permitan el tiempo y las fuerzas. La madera obtenida es, en efecto, de primera.\n\n Empieza a llover mientras te alejas del improvisado aserradero.}"
    }
    // context: legend_hunting_greenwood_schrats_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_heartwood_dead.png[/img]{Just as you are departing, a glint catches your eye. You turn around and come to one of the schrats' trunk. An axe is embedded in the wood. Moss has long since overgrown the handle, and yet the metal of the tool is without error, not a smidge of rust upon it. Scraping the moss away, you uncover wooden fingertips still at full grip. Tracing the fingers ends at the tree trunk where the wrist becomes a vein of wood. You follow that along to a wooden face with a twisted maw, like a face of brown wax melted by time alone. The frame of a helmet twists around the face and there's a chest plate cresting below like the reservoir of a deerchaser.\n\nYou shake your head and retrieve the axe, breaking it free and throwing the wooden fingers off its handle. The misshapen face blankly observes your theft, its stare preserved in the very annihilation from which it is eons removed. You do not dwell on the sight and return to the company with the axe.}"
        es = "[img]gfx/ui/events/legend_heartwood_dead.png[/img]{Justo cuando te dispones a marcharte, un destello te llama la atención. Te das la vuelta y te acercas al tronco de uno de los schrats. Hay un hacha clavada en la madera. El musgo cubre el mango desde hace mucho, y sin embargo el metal de la herramienta está impecable, sin una pizca de óxido. Al raspar el musgo, descubres unas yemas de dedos de madera que aún lo aferran con fuerza. Siguiendo los dedos llegas al tronco del árbol, donde la muñeca se convierte en una veta de madera. La sigues hasta un rostro de madera con una boca retorcida, como una cara de cera marrón derretida por el mero paso del tiempo. El armazón de un yelmo se retuerce alrededor de la cara, y debajo asoma una coraza que se asemeja a la de un cazador de ciervos.\n\nSacudes la cabeza y recuperas el hacha: la arrancas y quitas de su mango los dedos de madera. El rostro deforme observa sin expresión tu robo, con la mirada conservada en la misma aniquilación de la que lo separan eones. No te detienes en la visión y regresas con la compañía con el hacha.}"
    }
    // context: legend_hunting_greenwood_schrats_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_85.png[/img]{As you carry the still pulsating schrat head into town, a crowd begins to form around you. Children run up to touch the head, one reaches out to touch and a thorn grows out to meet their finger. The heartwood is not yet fully dead, and seems to regrow where you strike it, perhaps there is some way to make use of this endless regrowth.  Just then %employer% pushes their way through the crowd and cries out %SPEECH_ON% Huzzah! Our heroes have slain the wood spirits and avenged our fallen family. Bring them food and wine, tend their wounds, start the music, tonight we feast!%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_85.png[/img]{Mientras llevas al pueblo la cabeza del schrat, que aún palpita, empieza a formarse una multitud a tu alrededor. Los niños corren a tocar la cabeza; uno alarga la mano para tocarla y de ella brota una espina al encuentro de su dedo. El duramen aún no está del todo muerto y parece volver a crecer allí donde lo golpeas; quizá haya alguna manera de aprovechar este rebrote sin fin. Justo entonces, %employer% se abre paso entre la multitud y exclama %SPEECH_ON% ¡Hurra! Nuestros héroes han dado muerte a los espíritus del bosque y han vengado a nuestra familia caída. ¡Tráiganles comida y vino, curen sus heridas, que suene la música, que esta noche hay banquete!%SPEECH_OFF%}"
    }
    // en = "Rid the town of living trees"
    // en base_es
    // context: legend_hunting_greenwood_schrats_contract.createScreens.m.Screens.push().Options.getResult.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation()
    {
        en = "Killed the heart of the forest"
        es = "Acabó con el corazón del bosque"
    }
    // FILE: scripts\contracts\contracts\legend_hunting_mummies_contract.nut
    // context: legend_hunting_mummies_contract.create.m.Name
    {
        en = "The Ancient Dead"
        es = "Los muertos ancestrales"
    }
    // context: legend_hunting_mummies_contract.create.m.DescriptionTemplates
    {
        en = "The fleshed dead have been seen roaming the desert, their purpose long since lost to the sands of time."
        es = "Se ha visto a los muertos con carne vagando por el desierto, con un propósito perdido hace mucho en las arenas del tiempo."
    }
    // context: legend_hunting_mummies_contract.create.m.DescriptionTemplates
    {
        en = "Amongst the shifting sands, the embalmed dead wander aimlessly, their mummified forms driven by an insatiable thirst for the life they lost centuries ago."
        es = "Entre las arenas cambiantes, los muertos embalsamados vagan sin rumbo, con sus formas momificadas impulsadas por una sed insaciable de la vida que perdieron hace siglos."
    }
    // context: legend_hunting_mummies_contract.create.m.DescriptionTemplates
    {
        en = "In the desolate wastes of the desert, the embalmed dead rise from ancient tombs, their preserved forms shuffling endlessly beneath the scorching sun."
        es = "En los desolados páramos del desierto, los muertos embalsamados se alzan de tumbas antiguas, y sus formas conservadas arrastran los pies sin fin bajo el sol abrasador."
    }
    // context: legend_hunting_mummies_contract.create.m.DescriptionTemplates
    {
        en = "Beneath the burning sun, the embalmed dead roam the desert wastes, their empty eyes fixed on the horizon as they obey a long-forgotten command."
        es = "Bajo el sol ardiente, los muertos embalsamados recorren los páramos del desierto, con los ojos vacíos fijos en el horizonte mientras obedecen una orden olvidada hace mucho."
    }
    // context: legend_hunting_mummies_contract.create.m.DescriptionTemplates
    {
        en = "In the desolate expanse of the desert, the embalmed dead march in silent procession, their mummified forms a grim reminder of the ancient curses that lie buried beneath the sand."
        es = "En la desolada extensión del desierto, los muertos embalsamados marchan en silenciosa procesión; sus formas momificadas son un sombrío recordatorio de las antiguas maldiciones que yacen enterradas bajo la arena."
    }
    // context: legend_hunting_mummies_contract.create.m.DescriptionTemplates
    {
        en = "The desert holds secrets best left undisturbed, for the embalmed dead have recently risen from their ancient tombs to stalk the sands once more."
        es = "El desierto guarda secretos que es mejor no perturbar, pues los muertos embalsamados se han alzado hace poco de sus antiguas tumbas para volver a acechar las arenas."
    }
    // context: legend_hunting_mummies_contract.create.m.DescriptionTemplates
    {
        en = "Travelers in the desert face a grave threat: the embalmed dead, risen from their ancient crypts to haunt the dunes and prey upon the living with their cursed touch."
        es = "Quienes viajan por el desierto se enfrentan a una grave amenaza: los muertos embalsamados, alzados de sus antiguas criptas para rondar las dunas y cebarse en los vivos con su toque maldito."
    }
    // context: legend_hunting_mummies_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        // "Hunt down the dead that roam the desert around " + this.Contract.m.Home.getName()
        mode = "pattern"
        en = "Hunt down the dead that roam the desert around <home:str>"
        es = "Caza a los muertos que vagan por el desierto alrededor de <home>"
    }
    // context: legend_hunting_mummies_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_162.png[/img]{%employer% sits at a newly furnished table of gold and acacia, every facet is intricately hand carved and detailed, the corners are inlaid with gold and small jewels. On the surface however is more contradictory — a severed arm, roughly cut at the elbow, flops lifelessly on the ornate table.\n %employer% is surrounded by equally curious men who poke and prod at the limb like a child would poke at a dead dog with a stick. One of the servants taps the Vizier on the shoulder, where he promptly recomposes himself to seem as uninterested as possible in the diseased meat that is now emitting bile across his table.%SPEECH_ON%Now Crownling — I do have something quite special for you today. The fleshed dead have been seen in the desert, attacking my land and my servants. They are rarity around here, and one we feel should be dealt with immediately.%SPEECH_OFF%\n %employer% pyramids his fingers and leans back further into his chair, possibly to get as far away from the stench of the quickly festering arm. %employer% coughs and signals a servant to finish. The servant clears their throat and struggles the breathe %SPEECH_ON%On the authority of the...%SPEECH_OFF% He stops and coughs violently, taking a few steps away from the arm that is now dripping bile on the table while a guard carefully skewers it with his spear and takes it away at the full length of it.\n The servant recomposes himself and decides to skip to the important part. %SPEECH_ON%...you will be compensated with %reward% crowns.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_162.png[/img]{%employer% está sentado ante una mesa nueva de oro y acacia, con cada faceta tallada a mano con todo detalle y las esquinas incrustadas de oro y pequeñas joyas. Lo que hay encima, sin embargo, resulta más contradictorio: un brazo cercenado, cortado toscamente a la altura del codo, yace inerte sobre la mesa ornamentada.\n %employer% está rodeado de hombres igual de curiosos que pinchan y toquetean el miembro como un niño pincharía con un palo a un perro muerto. Uno de los sirvientes le da un toque en el hombro al visir, que se recompone al instante para parecer lo menos interesado posible en la carne enferma que ahora suelta bilis sobre su mesa.%SPEECH_ON%Bien, cuentacoronas, hoy tengo algo muy especial para ti. Se ha visto a los muertos con carne en el desierto, atacando mis tierras y a mis sirvientes. Por aquí son una rareza, y una de la que creemos que hay que ocuparse de inmediato.%SPEECH_OFF%\n %employer% junta las yemas de los dedos y se recuesta más en la silla, quizá para alejarse todo lo posible del hedor del brazo, que se pudre a ojos vista. %employer% tose y le indica a un sirviente que termine. El sirviente carraspea y le cuesta respirar. %SPEECH_ON%Por la autoridad del...%SPEECH_OFF% Se interrumpe con una tos violenta y se aparta unos pasos del brazo, que ya gotea bilis sobre la mesa, mientras un guardia lo ensarta con cuidado con su lanza y se lo lleva tan lejos de sí como da el asta.\n El sirviente se recompone y decide saltar a lo importante. %SPEECH_ON%...se te compensará con %reward% coronas.%SPEECH_OFF%}"
    }
    // context: legend_hunting_mummies_contract.createScreens.m.Screens.push().Options.Text
    {
        // corrige base: «va ha salir» y «va ha salirte» → «va a» (erratas); «precioa decuado» → «precio adecuado» (errata); «%companyname% podemos» → «puede», el inglés va en tercera persona.
        en = "{I'm interested, go on. | Hunting down an enemy like this doesn't come cheap. | This is going to cost you. | Hunting the dead in the desert. What is there not to like. | The %companyname% can help, for the right price.}"
        es = "{Estoy interesado, hablemos. | Cazar a un enemigo como este no va a salir barato. | Esto va a salirte caro. | ¿Cazar muertos en el desierto? ¿Cómo no va a gustarnos? | %companyname% puede ayudarte, por el precio adecuado.}"
    }
    // en = "\x7bThis doesn't sound like our kind of work. | I won't lead the men on a wild goose chase through the desert. | I don't think so. | I say no. The men prefer known enemies of flesh and blood.\x7d"
    // en base_es
    // context: legend_hunting_mummies_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_161.png[/img]{While tracking footprints across the sands you come upon another set of tracks, considerably more frantic and less purposeful than the ones you have followed thus far. The second set of tracks lead to a half dozen ancient grain silos constructed from mud brick and dry beams of wood.\n\n These structures have been here for some time and are clearly abandoned, signs of fire dot the foundations of where other buildings once stood. In the distance you hear a loud wailing — akin to a spirit or a dozen children crying.\n\n On the approach you notice a conscript covered in blood and gibbering incoherently, still wearing tattered armour and holding their spear as if they were about to fall from a high place. Suddenly noticing your presence the soldier jumps to his feet, hitting their head on the roof of the silo. They scream in pain and roll out of the doorway, bellowing to be left alone.\n\n Panic overtakes them and they thrust at you with their spear — you deftly dodge the clumsy thrust and push them. With a loud snap their spine and skull shatters on the soft sand — killing them near instantly.\n You are losing precious time and the sand is covering the more important set of tracks — you assemble a crude cairn for the body beneath the old silos and move on.\n\n As you leave, the mud brick monoliths stand silent, watching. Perhaps thankful for the company you have left them.}"
        es = "[img]gfx/ui/events/event_161.png[/img]{Mientras sigues unas huellas por la arena, das con otro rastro, mucho más frenético y menos decidido que el que has seguido hasta ahora. Este segundo rastro lleva a media docena de antiguos silos de grano construidos con adobe y vigas de madera seca.\n\n Estas construcciones llevan aquí bastante tiempo y están claramente abandonadas; hay señales de fuego salpicando los cimientos donde antes se alzaban otros edificios. A lo lejos oyes un fuerte lamento, como el de un espíritu o el de una docena de niños llorando.\n\n Al acercarte ves a un recluta cubierto de sangre que farfulla de forma incoherente, todavía con su armadura hecha jirones y aferrado a su lanza como si estuviera a punto de caer desde lo alto. Al advertir de pronto tu presencia, el soldado se pone en pie de un salto y se golpea la cabeza contra el techo del silo. Grita de dolor y sale rodando por la puerta, chillando que lo dejen en paz.\n\n El pánico se apodera de él y te lanza una estocada con la lanza; esquivas con destreza la torpe acometida y lo empujas. Con un fuerte chasquido, su columna y su cráneo se quiebran contra la arena blanda, y muere casi al instante.\n Estás perdiendo un tiempo precioso y la arena está cubriendo el rastro que de verdad importa: levantas un tosco túmulo de piedras para el cuerpo bajo los viejos silos y sigues adelante.\n\n Al marcharte, los monolitos de adobe se alzan en silencio, observando. Quizá agradecidos por la compañía que les has dejado.}"
    }
    // context: legend_hunting_mummies_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_153.png[/img]{After the long journey you finally arrive at the group of undead you have been tracking, curiously, the dead are covered in glistening gold and bronze. Swimming around in circles at the base of a dune the group has clearly become distracted by something nearby or have lost their intended target a few hours ago.\n\n An uneasy feeling builds in your stomach as one by one, the dead form up into a fighting line. Now motionless and attentive, the dead stand ready with their mantles, ear rings and adornments, a size too large, shifting loosely in the wind from their desiccated remains.\n\n A better decorated corpse lets out a mournful howl and the column of dried skin and gold begins to advance.}"
        es = "[img]gfx/ui/events/event_153.png[/img]{Tras el largo viaje, por fin alcanzas al grupo de no muertos que venías rastreando; curiosamente, los muertos van cubiertos de oro y bronce relucientes. A juzgar por cómo dan vueltas en círculos al pie de una duna, está claro que el grupo se ha distraído con algo cercano o ha perdido a su objetivo hace unas horas.\n\n Una sensación inquietante crece en tu estómago mientras, uno a uno, los muertos forman una línea de combate. Ahora inmóviles y atentos, los muertos aguardan listos con sus mantos, pendientes y adornos, una talla más grandes de la cuenta, meciéndose sueltos al viento sobre sus restos resecos.\n\n Un cadáver más engalanado suelta un aullido lastimero y la columna de piel reseca y oro empieza a avanzar.}"
    }
    // context: legend_hunting_mummies_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_160.png[/img]{As the last of the embalmed are slain their jewelry jingles and chimes as they fall into the soft sand. A nauseating feeling comes over you, as if you have not slept for months or had water for days, your skin feels thinner and your bones creak and pull away at one another. After a few moments the feeling passes and your strength returns.\n\n Your concern now shifts to the dozen or so corpses littering the battlefield. The Vizier wanted proof and you will provide it with more than a mere arm. You find the most resplendent embalmed slumped in a pile and take off the head with a few precise cuts, headdress and all.\n Strapping it to your belt you begin to make the long journey home with your new prize — but not before taking some of the jewelry for the trouble.}"
        es = "[img]gfx/ui/events/event_160.png[/img]{Cuando caen los últimos embalsamados, sus joyas tintinean y repican al desplomarse sobre la arena blanda. Te invade una sensación nauseabunda, como si llevaras meses sin dormir o días sin beber agua; sientes la piel más fina y los huesos te crujen y tiran unos de otros. Al cabo de unos instantes, la sensación pasa y recuperas las fuerzas.\n\n Ahora te preocupa la docena de cadáveres, más o menos, que cubren el campo de batalla. El visir quería pruebas y se las darás con algo más que un simple brazo. Encuentras al embalsamado más espléndido desplomado en un montón y le cortas la cabeza con unos cuantos tajos precisos, tocado incluido.\n Te la sujetas al cinturón y emprendes el largo viaje de vuelta con tu nuevo trofeo, aunque no sin llevarte antes algunas joyas por las molestias.}"
    }
    // context: legend_hunting_mummies_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_162.png[/img]{You stride into the Vizier's main chamber, dutifully placing the head on the table where the arm once sat. A servant in the far corner with a stained rag lets out a miserable sigh and exits the room. The Vizier inspects the head closely from their seat. %SPEECH_ON%It is done?%SPEECH_OFF% You nod in response.\n At another corner of the room, guards and servants briefly intermingle, swapping money and curses alike. %SPEECH_ON%I have not seen anything like this before crownling — but if the threat is dealt with then you may leave with your reward.%SPEECH_OFF% He motions you to leave and a servant hurriedly drops a pouch of crowns in your hands. A thought crosses your mind that the gold from the headdress was likely worth double than what you were paid.\n Meanwhile, a guard approaches the head and skewers it through the eye socket with their spear, carrying it off to the next room.\n As you begin to leave, you hear a loud curse and a dull thud of flesh on a hard floor, followed by girlish screams of nobles. You take the time to count your coins while eavesdropping on the dramatic events in the next room, then leave once you are satisfied with both.}"
        es = "[img]gfx/ui/events/event_162.png[/img]{Entras con paso firme en la cámara principal del visir y colocas obedientemente la cabeza sobre la mesa, donde antes estaba el brazo. Un sirviente con un trapo manchado, en el rincón más alejado, suelta un suspiro desdichado y sale de la sala. El visir examina la cabeza de cerca desde su asiento. %SPEECH_ON%¿Está hecho?%SPEECH_OFF% Asientes por respuesta.\n En otro rincón de la sala, guardias y sirvientes se mezclan un momento e intercambian dinero y maldiciones por igual. %SPEECH_ON%Nunca había visto nada parecido, cuentacoronas, pero si la amenaza está resuelta, puedes marcharte con tu recompensa.%SPEECH_OFF% Te indica con un gesto que te retires y un sirviente te deja caer a toda prisa una bolsa de coronas en las manos. Se te pasa por la cabeza que el oro del tocado seguramente valía el doble de lo que te han pagado.\n Mientras tanto, un guardia se acerca a la cabeza, la ensarta por la cuenca del ojo con su lanza y se la lleva a la sala contigua.\n Cuando empiezas a marcharte, oyes una sonora maldición y el golpe sordo de carne contra un suelo duro, seguidos de los chillidos de niña de los nobles. Te tomas tu tiempo para contar las monedas mientras escuchas a escondidas el drama de la sala contigua, y te marchas cuando ambas cosas te dejan satisfecho.}"
    }
    // context: legend_hunting_mummies_contract.createScreens.m.Screens.push().Options.getResult.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation()
    {
        en = "Rid the city of the dead"
        es = "Libró a la ciudad de los muertos"
    }
    // context: legend_hunting_mummies_contract.spawnEnemies.party.World.FactionManager.getFactionOfType(this.Const.FactionType.Zombies).spawnEntity()
    {
        en = "Embalmed"
        es = "Embalsamados"
    }
    // context: legend_hunting_mummies_contract.spawnEnemies.party.setDescription()
    {
        en = "Glints of gold and heavy steps serve as a warning to all."
        es = "Destellos de oro y pasos pesados sirven de advertencia a todos."
    }
    // FILE: scripts\contracts\contracts\legend_hunting_redback_webknechts_contract.nut
    // context: legend_hunting_redback_webknechts_contract.create.m.Name
    {
        en = "Hunting Redback Webknechts (Legendary)"
        es = "Caza a los Webknechts de lomo rojo (Legendario)"
    }
    // context: legend_hunting_redback_webknechts_contract.create.m.DescriptionTemplates
    {
        en = "The woods are poisoned. The way is blocked. Scuttling horrors chitter in the dark. There is something odd at work here."
        es = "Los bosques están envenenados. El camino está cortado. Horrores que corretean chasquean en la oscuridad. Aquí está pasando algo raro."
    }
    // context: legend_hunting_redback_webknechts_contract.create.m.DescriptionTemplates
    {
        en = "Bloated red bodies and gaping maws skitter through the darkness, hungry for blood."
        es = "Cuerpos rojos e hinchados y fauces abiertas se escabullen en la oscuridad, sedientos de sangre."
    }
    // context: legend_hunting_redback_webknechts_contract.create.m.DescriptionTemplates
    {
        en = "Monstrous forms of red chitin haunt the dark, driven by an insatiable hunger to constantly feed."
        es = "Formas monstruosas de quitina roja acechan en la oscuridad, impulsadas por un hambre insaciable que las obliga a alimentarse sin cesar."
    }
    // context: legend_hunting_redback_webknechts_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        // "Hunt down Redback Webknechts in the woods around " + this.Contract.m.Home.getName()
        mode = "pattern"
        en = "Hunt down Redback Webknechts in the woods around <home:str>"
        es = "Caza a los Webknechts de lomo rojo en los bosques alrededor de <home>"
    }
    // context: legend_hunting_redback_webknechts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_31.png[/img]{As you approach the keep of %employer% you pass through a courtyard filled with broken down carts and barking dogs pulling at their chains, a guard in a stained jerkin sits drinking on the stair, he nods you past. When you enter the keep itself you hear children yelling at each other, before a nasal woman's voice cuts through their chatter.%SPEECH_ON%Oi! you lot knock it off, we've got company%SPEECH_OFF% The children protest a little but calm down. A large man waves you over, he is sitting topless by a fireplace eating a large hunk of meat, that has spilled juices on his huge hairy belly %SPEECH_ON%You came then? I thought maybe you were as weak as the rest of them spider hunters. Well I guess you've heard then, we've got a nest of them big black blighters. They are drawn in by the midden, that pile of filth has bugs the size of my fist and the spiders love it. I told the guards to clean it out, but they must have been mistaken for bugs, because none came back. %SPEECH_OFF%  He wipes his mouth with a hairy arm and takes a huge swig from an ale cask before burping loudly.  %SPEECH_ON%These ain't ordinary spiders mind you, a single bite could fell a giant. I know it is a big job, and I'm prepared to pay you well for it. Interested? %SPEECH_OFF%  | You find %employer% behind the main keep, stretched out on his back under a catapult. You don't think he could have seen you from under there, but while still tinkering away he calls out. %SPEECH_ON%Ah, the spider hunter, just the one I wanted to see. We have a bit of a nasty problem.%SPEECH_OFF% He slides out from under the catapult and you see his uncovered chest is smeared with dirt, he pats the device affectionately. %SPEECH_ON%Not the kind of problem Bertha here can fix %SPEECH_OFF%. He pulls a robe over his shoulders and continues as he walks you back to the keep. %SPEECH_ON%We have had spiders in these parts for a long time, absolute bastards if they get a hold on you, but easy enough for the boys to scare off. Recently though we have been visited by spiders of a different kind. Giant black things with a huge gash of red upon their back. A single bite has enough poison enough to fell a knight. I hear you are the one for the job and I am prepared to pay handsomely. Are you interested? %SPEECH_OFF% }"
        es = "[img]gfx/ui/events/event_31.png[/img]{Al acercarte a la fortaleza de %employer% cruzas un patio lleno de carros destartalados y perros que ladran tirando de sus cadenas; un guardia con un jubón manchado bebe sentado en la escalera y te deja pasar con un gesto de la cabeza. Al entrar en la fortaleza oyes a unos niños gritándose, hasta que una voz nasal de mujer se impone a su alboroto.%SPEECH_ON%¡Eh! Ustedes, basta ya, que tenemos compañía.%SPEECH_OFF% Los niños protestan un poco, pero se calman. Un hombretón te hace señas para que te acerques; está sentado sin camisa junto a la chimenea, comiéndose un buen pedazo de carne cuyos jugos le han chorreado por la enorme barriga peluda. %SPEECH_ON%¿Así que has venido? Pensaba que a lo mejor eras tan blandengue como el resto de esos cazadores de arañas. Bueno, supongo que ya te habrás enterado: tenemos un nido de esos malditos bichos negros y grandes. Los atrae el estercolero; ese montón de porquería tiene bichos del tamaño de mi puño y a las arañas les encanta. Les dije a los guardias que lo limpiaran, pero debieron de confundirlos con bichos, porque no volvió ninguno. %SPEECH_OFF%  Se limpia la boca con un brazo peludo y le da un buen trago a un barril de cerveza antes de soltar un sonoro eructo.  %SPEECH_ON%Y ojo, que estas no son arañas corrientes: un solo mordisco podría tumbar a un gigante. Sé que es un trabajo gordo, y estoy dispuesto a pagarte bien por él. ¿Te interesa? %SPEECH_OFF%  | Encuentras a %employer% detrás de la torre del homenaje, tumbado boca arriba bajo una catapulta. No crees que haya podido verte desde ahí abajo, pero sin dejar de trastear te llama. %SPEECH_ON%Ah, el cazador de arañas, justo a quien quería ver. Tenemos un problemilla bastante feo.%SPEECH_OFF% Sale de debajo de la catapulta y ves que tiene el pecho descubierto embadurnado de tierra; le da unas palmaditas cariñosas al artefacto. %SPEECH_ON%No es de los problemas que pueda arreglar aquí Bertha. %SPEECH_OFF%. Se echa una túnica sobre los hombros y sigue hablando mientras te acompaña de vuelta a la fortaleza. %SPEECH_ON%Por estos lares hay arañas desde hace mucho; unas cabronas de cuidado si te agarran, pero los muchachos las espantan sin mucho problema. Últimamente, en cambio, nos visitan arañas de otra clase. Cosas negras gigantescas con un enorme tajo rojo en el lomo. Un solo mordisco lleva veneno de sobra para tumbar a un caballero. Me han dicho que eres quien necesito para el trabajo, y estoy dispuesto a pagar generosamente. ¿Te interesa? %SPEECH_OFF% }"
    }
    // en = "\x7bThis doesn't sound like our kind of work.\x7d"
    // en base_es
    // context: legend_hunting_redback_webknechts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_25.png[/img]{You stumble across a dead cow with its flesh sucked to its very bones, yet its hide does not carry any sign of being sundried. %randombrother% crouches and runs a finger among a number of puncture wounds, but recoils in pain.%SPEECH_ON%It burns! This is clearly the work of a webknecht, no doubt to it, but with poison that burns to the touch. I'd say they poisoned it and then fed upon its paralyzed body. And a fresh corpse means they're close...%SPEECH_OFF% | You find a webbed corpse leaning against a lone tree. You slash the filaments away. An old woman's body slips out and crumples to the ground. Its face is tight to the bone, a pallid skull with the eyeballs peeking from deep in the sockets. The tongue is equally receded and there's hardly a nose at all. %randombrother% spits and nods.%SPEECH_ON%Alright. We're close. Rather, they're close. If it's solace to you folks, the woman died prior to this here state of being. Redback Webknechts bring poison with their puncturing and no one would stand to survive it long.%SPEECH_OFF%Well that's good. Time for the men to find these monsters. }"
        es = "[img]gfx/ui/events/event_25.png[/img]{Tropiezas con una vaca muerta a la que le han chupado la carne hasta los mismos huesos, aunque su piel no muestra ninguna señal de haberse secado al sol. %randombrother% se agacha y pasa un dedo entre varias heridas punzantes, pero lo retira con un gesto de dolor.%SPEECH_ON%¡Quema! Esto es obra de un webknecht, sin duda, pero con un veneno que quema al tocarlo. Yo diría que la envenenaron y luego se alimentaron de su cuerpo paralizado. Y un cadáver fresco significa que están cerca...%SPEECH_OFF% | Encuentras un cadáver envuelto en telarañas, apoyado contra un árbol solitario. Cortas los filamentos a tajos. El cuerpo de una anciana se desliza fuera y se desploma en el suelo. Tiene la cara pegada al hueso, una calavera pálida con los globos oculares asomando desde el fondo de las cuencas. La lengua también se ha encogido y apenas le queda nariz. %randombrother% escupe y asiente.%SPEECH_ON%Bien. Estamos cerca. Mejor dicho, ellos están cerca. Si les sirve de consuelo, la mujer murió antes de quedar así. Los Webknechts de lomo rojo meten veneno con cada picadura y nadie aguantaría mucho con él.%SPEECH_OFF%Bueno, menos mal. Es hora de que los hombres encuentren a estos monstruos. }"
    }
    // context: legend_hunting_redback_webknechts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_redback.png[/img]{The nest of webknechts is a pit of earth wreathed in white. At its rim are thin filaments which list about at even the slightest suggestion of a breeze. Marching your company inward, the webbing begins to take a sort of civilized shape, as though you were walking in from wintery hinterland, the recency of its creation apparent in its tight trappings: deer, dogs, man-sized cocoons which show no sign of life, all bound snug in the hangars of white silos and planes like morsels lost upon a pale rug. A black shadow saunters up behind the veiled domicile, coming to the fore with its legs squatting defilade, its head crouched beyond them as though the foul cretin were gated by its own stride. A human hand sucks in and out from its mandibles like some macabre pacifier. You've come to the right place. | The webknecht nest is silent and the clatter of the company's arrival seems apocryphal, with the chink and clink of metals distinctly sharp in their trespass.\n\n You find a man hanging upside down from a tree, his whole body cocooned save his face which is stretched and pulled by the filaments. He asks you cut his eyelids free of the webbing which you oblige. His lids slowly close, the crust of the dry eyes crackling closed for the first time in possibly days. But then they snap open and the man screams. The cocoon bubbles at his waist and rips apart, a sputtering of tiny black spiders flooding out. The man's body jolts violently around as the swarm consumes him, his gargled screams rife with the skittering of spiderlings which fill his lungs and which he coughs out in dying fits. Horrified, you step back only to see a throng of much larger spiders emerging from around the trees! | The nest is an easy spot, a stretch of winterscape where there's no cold, the white webbing patchy and listing from every tree, every copse, every inch of the place. You march the company right in, weapons drawn, and there you come across the wrapped bodies, their centers blown open and blackened, a spawn of spiderlings sucking on the organs.\n\n  Staring up, you see red eyes flare between the branches of the surrounding trees, the whole arachnidian arboretum come alive, its wardens perched there amongst the brush with their squatted legs indistinguishable from the branches, the enemy hiding in plain sight. You damn near shit yourself when a supposed tree unfolds entirely, every wooden stalk but a spider leg, the arborous sleight descending on the company chittering and chamfering for a bite!}"
        es = "[img]gfx/ui/events/legend_redback.png[/img]{El nido de webknechts es un hoyo de tierra envuelto en blanco. En su borde hay finos filamentos que se mecen al menor indicio de brisa. A medida que haces avanzar a la compañía hacia dentro, las telarañas empiezan a adoptar una especie de forma civilizada, como si llegaras desde unas tierras invernales, y lo reciente de su creación se nota en lo apretado de sus presas: ciervos, perros, capullos del tamaño de un hombre que no muestran señal alguna de vida, todos bien sujetos en los hangares de silos y llanos blancos como bocados perdidos sobre una alfombra pálida. Una sombra negra avanza sin prisa tras la morada velada y sale a la luz con las patas agazapadas a cubierto, la cabeza encogida tras ellas como si el inmundo engendro estuviera enjaulado por su propia zancada. Una mano humana entra y sale de sus mandíbulas como un macabro chupete. Has venido al sitio indicado. | El nido de webknechts está en silencio, y el estrépito de la llegada de la compañía parece apócrifo, con el tintineo de los metales nítidamente agudo en su intrusión.\n\n Encuentras a un hombre colgado cabeza abajo de un árbol, con todo el cuerpo envuelto en un capullo salvo la cara, estirada y tensada por los filamentos. Te pide que le liberes los párpados de la telaraña, y accedes. Los párpados se le cierran despacio, y la costra de los ojos resecos cruje al cerrarse por primera vez quizá en días. Pero entonces se abren de golpe y el hombre grita. El capullo burbujea a la altura de su cintura y se desgarra, y un borbotón de diminutas arañas negras sale en tropel. El cuerpo del hombre se sacude con violencia mientras el enjambre lo devora; sus gritos ahogados rebosan del correteo de las crías de araña que le llenan los pulmones y que él tose en estertores agónicos. Presa del horror, retrocedes, ¡solo para ver una multitud de arañas mucho más grandes saliendo de entre los árboles! | El nido es fácil de localizar: una extensión de paisaje invernal donde no hace frío, con las telarañas blancas a parches y colgando de cada árbol, de cada bosquecillo, de cada palmo del lugar. Haces entrar a la compañía de lleno, con las armas desenvainadas, y allí te topas con los cuerpos envueltos, con el centro reventado y ennegrecido y una prole de crías de araña chupándoles los órganos.\n\n  Al alzar la vista, ves destellar ojos rojos entre las ramas de los árboles que te rodean; todo el arboreto arácnido cobra vida, con sus guardianes encaramados entre la maleza y las patas agazapadas, indistinguibles de las ramas: el enemigo escondido a plena vista. Casi te cagas encima cuando un supuesto árbol se despliega por completo y cada tallo leñoso resulta ser una pata de araña, ¡y el engaño arbóreo se abalanza sobre la compañía chasqueando y rechinando en busca de un bocado!}"
    }
    // context: legend_hunting_redback_webknechts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_redback_dead.png[/img]{The last of the redbacks is dealt with, its legs gating itself in as though to eternally clutch at the weapon which had slain it. You nod at the company's good work then order the whole place torched. Fires rapidly run the length of the webs, breaking bridges of filament apart and sending fiery doom to their connectors. The whole nest is consumed in the inferno and somewhere deep in its bedding you hear the shrill cry of spiderlings set alight. | You step close to the last of the redbacks and stare at its grisly maw. It carries a vicious set of mandibles for a sort of gum guard, the mouth itself a slit lined with razor sharp teeth pointed counter-current as to shred anything that tried to escape.\n\n You order the whole nest put to the torch. As the flames rise, there comes the cry of spiderlings somewhere in their warrens. | You ready a return to %employer%, but first have the nest torched entirely. The company stands before the flames listening to the shrill cries of spiderlings and at times laughing at the little mites scuttling around like tiny fireballs on legs. | The spiders defeated, you have the whole godsforsaken place burned and ready a return to %employer%. As the fires rise, tiny spiderlings come running out with their bodies aflame like fireflies in the night. A few sellswords take up an impromptu game of seeing who can squash the most, an affair which ends with a particularly ambitious spiderling almost setting a mercenary's pants alight.}"
        es = "[img]gfx/ui/events/legend_redback_dead.png[/img]{Te has encargado del último webknecht de lomo rojo; sus patas se cierran sobre él como si quisiera aferrar por toda la eternidad el arma que lo mató. Asientes ante el buen trabajo de la compañía y ordenas prender fuego a todo el lugar. Las llamas recorren a toda velocidad las telarañas, rompen los puentes de filamentos y llevan una perdición ardiente hasta sus uniones. Todo el nido se consume en el infierno de fuego y, en algún punto en lo hondo de su lecho, oyes el chillido agudo de las crías de araña al arder. | Te acercas al último webknecht de lomo rojo y contemplas sus espantosas fauces. Tiene un temible juego de mandíbulas a modo de protector de encías, y la boca en sí es una ranura bordeada de dientes afilados como cuchillas que apuntan a contracorriente para desgarrar cualquier cosa que intente escapar.\n\n Ordenas pasar todo el nido por el fuego. Mientras suben las llamas, llega el chillido de las crías de araña desde algún punto de sus madrigueras. | Preparas el regreso con %employer%, pero antes mandas quemar el nido por completo. La compañía se planta ante las llamas escuchando los chillidos agudos de las crías de araña y, a ratos, riéndose de los pequeños bichos que corretean como bolitas de fuego con patas. | Derrotadas las arañas, mandas quemar todo ese lugar dejado de la mano de los dioses y preparas el regreso con %employer%. Mientras suben las llamas, salen corriendo diminutas crías de araña con el cuerpo ardiendo, como luciérnagas en la noche. Unos cuantos mercenarios se ponen a jugar a ver quién aplasta más, un asunto que acaba con una cría especialmente ambiciosa a punto de prenderle fuego a los pantalones de un mercenario.}"
    }
    // context: legend_hunting_redback_webknechts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_redback_dead.png[/img]{With the webknechts dispatched you have the company briefly search the creatures' nest, though the mercenaries are ordered to never wander alone. You muck about as well, %randombrother% at your side. Together, you spot a tree that is remarkably untouched by the webs. As you circle around, you find a knight's corpse leaning against its trunk. His hand rests atop a broken sword's pommel, the other hand is missing altogether, nothing but sleeve at the wrist with the mutilated arm couched at his belly. The corpse rests in a nest of its own making, a thicket of what look like spoiled rhubarb stalks and decayed carapaces, the broken bodies caverned and smelling of poison. %randombrother% nods.%SPEECH_ON%That's a right shame. I'd wager he would have made a sound addition to the %companyname%, whoever he was.%SPEECH_OFF%Indeed, it has all the look of a great fighter's end. You've mind to bury him, but you've no time. You tell %randombrother% to fetch what he can from the corpse and to ready a return to %employer%.}"
        es = "[img]gfx/ui/events/legend_redback_dead.png[/img]{Despachados los webknechts, haces que la compañía registre brevemente el nido de las criaturas, aunque ordenas a los mercenarios que nunca se alejen solos. Tú también husmeas por ahí, con %randombrother% a tu lado. Entre los dos dan con un árbol extraordinariamente libre de telarañas. Al rodearlo, encuentras el cadáver de un caballero apoyado contra el tronco. Una mano descansa sobre el pomo de una espada rota; la otra ha desaparecido por completo, y no queda más que la manga en la muñeca, con el brazo mutilado recogido sobre el vientre. El cadáver reposa en un nido de su propia factura, una maraña de lo que parecen tallos de ruibarbo podridos y caparazones descompuestos, con los cuerpos destrozados ahuecados y oliendo a veneno. %randombrother% asiente.%SPEECH_ON%Qué pena, de verdad. Apuesto a que habría sido una buena incorporación para %companyname%, fuera quien fuera.%SPEECH_OFF%Desde luego, tiene todo el aspecto del final de un gran guerrero. Te gustaría enterrarlo, pero no hay tiempo. Le dices a %randombrother% que tome lo que pueda del cadáver y que prepare el regreso con %employer%.}"
    }
    // context: legend_hunting_redback_webknechts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_redback_dead.png[/img]{The battle over, you find a man dangling by webbing attached to his feet. Half of his body is bound in the filaments and more dangle from his hip like a shredded dress. Seems the spiders deserted him upon the %companyname%'s arrival. He smiles at the sight of you.%SPEECH_ON%Hey there. Mercenaries ain't ya? Yeah I see it. You've no mind being here lest it was coin that brought ya, and you fought like bastards that'd been bet on. Absolute savages.%SPEECH_OFF%You ask the man what you'll get for cutting him down. He turns his head up, his whole body then starting to swing about and at times twist him away from you entirely. He speaks, either to you or to whichever direction he's facing.%SPEECH_ON%Aye, good question! Well, you may not see it here and now, but I'm a sellsword m'self, and wouldn't you know that my company and its captain all been done stringed up and consumed whole by them spiders! Cut me down and I've nowhere else better to go then your company. That is, if you'd have me.%SPEECH_OFF%You have the man cut free and debate what to do before returning to %employer%.}"
        es = "[img]gfx/ui/events/legend_redback_dead.png[/img]{Terminada la batalla, encuentras a un hombre colgando de una telaraña atada a sus pies. Tiene medio cuerpo envuelto en filamentos, y le cuelgan más de la cadera como un vestido hecho jirones. Por lo visto, las arañas lo abandonaron al llegar %companyname%. Sonríe al verte.%SPEECH_ON%Ey, hola. Mercenarios, ¿no? Sí, se nota. No tendrían por qué estar aquí si no los hubiera traído el dinero, y pelearon como cabrones por los que alguien hubiera apostado. Unos salvajes de cuidado.%SPEECH_OFF%Le preguntas qué ganarás si lo bajas. Él levanta la cabeza, y todo su cuerpo empieza a balancearse y, a ratos, a girar hasta darte la espalda por completo. Habla, ya sea a ti o hacia donde esté mirando.%SPEECH_ON%¡Eso, buena pregunta! Bueno, puede que no lo veas aquí y ahora, pero yo también soy mercenario, ¿y a que no sabes qué? ¡A mi compañía y a su capitán los colgaron y se los zamparon enteritos esas arañas! Bájame y no tendré mejor sitio al que ir que tu compañía. Eso, si me aceptas.%SPEECH_OFF%Mandas que lo descuelguen y te pones a pensar qué hacer antes de volver con %employer%.}"
    }
    // context: legend_hunting_redback_webknechts_contract.createScreens.m.Screens.push().start.Contract.m.Dude.getBackground().m.RawDescription
    {
        // corrige base: falta «last» («el último sobreviviente»); «después de que lo rescataste» → «rescataras», «después de que» pide subjuntivo.
        en = "You found %name% dangling from a tree, the sellsword the last survivor of a mercenary band sent to kill redback webknechts. He joined the company after you rescued him."
        es = "Encontraste a %name% colgando de un árbol: el mercenario era el último sobreviviente de una banda de mercenarios enviada a matar webknechts de lomo rojo. Se unió a la compañía después de que lo rescataras."
    }
    // en = "Lost his previous company to webknechts"
    // en base_es
    // context: legend_hunting_redback_webknechts_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: «alrdedor» (errata) y el inglés dice «beside him», «a su lado»; «evidencia» → «prueba» (anglicismo); «parte de las posesiones» añade «parte», que el inglés no tiene, y «lo que quede de ella» no concuerda con «posesiones».
        en = "[img]gfx/ui/events/event_85.png[/img]{%employer% meets you at the town entrance and there is a crowd of folks beside him. He welcomes you warmly, stating he had a scout following you who saw the whole battle unfold. After he hands you your reward, the townsfolk come forward one by one, many of which are reluctant to stare a sellsword in the eyes, but they offer a few gifts as thanks for relieving them of the webknecht horrors. | You have to track down %employer%, ultimately finding the man in a stable livery with a peasant girl. He saws upward from the hay, startling the horses which whinny and stamp their feet. Half-dressed, the man states he already has your pay and forks it over. Eyeing you eyeing the girl, he then starts to grab whatever's in reach, including from the saddlebags of stabled mounts, and hands them over.%SPEECH_ON%The, uh, townsfolk also sought to pitch in. You know, as thanks.%SPEECH_OFF%Right. For further 'thanks' you ask if he'll give you whatever's in a nearby satchel. | %employer% welcomes you back with a great clap and rub of his hands, as though you'd just brought in a turkey and not the horrifying evidence of your victory. After paying you the agreed reward, you hear some surprising news. The mayor states that the estate of a lost townsman could not be properly divvied up and, as further thanks, you're free to take what's left of it.}"
        es = "[img]gfx/ui/events/event_85.png[/img]{%employer% te recibe en la entrada del pueblo y hay una multitud de personas a su lado. Te da una cálida bienvenida, afirmando que tenía un explorador siguiéndote que presenció toda la batalla. Después de entregarte tu recompensa, los habitantes del pueblo se acercan uno a uno, muchos de ellos reacios a mirar a un mercenario a los ojos, pero ofrecen algunos regalos como agradecimiento por liberarlos de los horrores de los webknechts. | Tienes que dar con %employer%, y acabas encontrándolo en la cuadra de un establo con una campesina. Se incorpora de golpe entre la paja y asusta a los caballos, que relinchan y patean el suelo. A medio vestir, el hombre dice que ya tiene tu pago y te lo suelta. Al ver que tú miras a la chica, empieza a agarrar todo lo que tiene a mano, incluido lo que hay en las alforjas de las monturas del establo, y te lo entrega.%SPEECH_ON%Los, eh, habitantes del pueblo también quisieron poner de su parte. Ya sabes, como agradecimiento.%SPEECH_OFF%Claro. Como 'agradecimiento' adicional, le preguntas si te dará lo que haya en una bolsa que hay cerca. | %employer% te recibe con un gran aplauso y frotándose las manos, como si acabaras de traer un pavo y no la aterradora prueba de tu victoria. Después de pagarte la recompensa acordada, escuchas una noticia sorprendente. El alcalde declara que los bienes de un habitante desaparecido no han podido repartirse adecuadamente y, como muestra de agradecimiento adicional, tienes libertad para tomar lo que quede de ellos.}"
    }
    // en = "Rid the town of webknechts"
    // en base_es
    // context: legend_hunting_redback_webknechts_contract.spawnEnemies.party.World.FactionManager.getFactionOfType(this.Const.FactionType.Beasts).spawnEntity()
    {
        en = "Redback Webknechts"
        es = "Webknechts de lomo rojo"
    }
    // context: legend_hunting_redback_webknechts_contract.spawnEnemies.party.setDescription()
    {
        // corrige base: «deslizándose» no recoge «skittering about», que es corretear de un lado a otro.
        en = "A swarm of redback webknechts skittering about."
        es = "Un enjambre de webknechts de lomo rojo correteando por todas partes."
    }
    // FILE: scripts\contracts\contracts\legend_hunting_rock_unholds_contract.nut
    // context: legend_hunting_rock_unholds_contract.create.m.Name
    {
        en = "Hunting a Mountain (Legendary)"
        es = "Caza a una montaña (Legendario)"
    }
    // context: legend_hunting_rock_unholds_contract.create.m.DescriptionTemplates
    {
        en = "Blundering mountains of hatred and rage are devastating the area. These are the largest Unholds you have ever seen."
        es = "Torpes montañas de odio y furia están arrasando la zona. Son los troles más grandes que has visto jamás."
    }
    // context: legend_hunting_rock_unholds_contract.create.m.DescriptionTemplates
    {
        en = "Colossal footsteps shake the earth. Buildings have been shattered, the very landscape torn apart by primal fury."
        es = "Pisadas colosales sacuden la tierra. Hay edificios hechos añicos y el propio paisaje ha quedado desgarrado por una furia primigenia."
    }
    // context: legend_hunting_rock_unholds_contract.create.m.DescriptionTemplates
    {
        en = "Rampaging unholds have left a trail of devastation for miles. You can hear their thunderous roars from here."
        es = "Unos troles desbocados han dejado un rastro de devastación de varias leguas. Desde aquí se oyen sus rugidos atronadores."
    }
    // context: legend_hunting_rock_unholds_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        // "Hunt down the Rock Unholds around " + this.Contract.m.Home.getName()
        mode = "pattern"
        en = "Hunt down the Rock Unholds around <town:str>"
        es = "Da caza a los troles de roca en los alrededores de <town>"
    }
    // context: legend_hunting_rock_unholds_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_31.png[/img]{When you enter %employer%'s keep he runs out to greet you, he looks wracked with fear. He has clearly run too fast for his fat lungs and has to catch his breath before burbling out a slew of words.%SPEECH_ON%Thank the gods you came! The mountains have come alive! I have seen it, boulders the size of a house stirring up from their slumber, standing tall like a man and then crushing a horse in a single blow.%SPEECH_OFF% He throws you a huge lump of bluish crystalline rock, %employer% continues on %SPEECH_ON%My best men chopped this off the giant, that stone you hold is its flesh. The beast is so armored that most weapons glance right off. It took four men with axes to carve that tiny chunk off, and as soon as they had finished, the rock grew right back. The beast barely noticed we were there, it crushed three men in a single blow. We fled, and we know not where it hides now. Search the surrounding lands, it is slow and huge, so it should not be hard to track. My tracker tells me you specialise in hunting unholds, so undoubtedly you already have poison with you to stop the creature regenerating. Even so, this beast may be impossible to kill, worse than a dozen unholds. If you do manage to kill a mountain, I will reward you like a king.%SPEECH_OFF% }"
        es = "[img]gfx/ui/events/event_31.png[/img]{Cuando entras en la fortaleza de %employer%, sale corriendo a recibirte, presa del miedo. Es evidente que ha corrido demasiado para sus gordos pulmones y tiene que recuperar el aliento antes de soltar a borbotones un torrente de palabras.%SPEECH_ON%¡Gracias a los dioses que has venido! ¡Las montañas han cobrado vida! Lo he visto con mis propios ojos: rocas del tamaño de una casa que despiertan de su letargo, se yerguen como un hombre y aplastan un caballo de un solo golpe.%SPEECH_OFF% Te lanza un enorme pedrusco de roca cristalina azulada y %employer% continúa %SPEECH_ON%Mis mejores hombres le arrancaron esto al gigante; esa piedra que sostienes es su carne. La bestia está tan acorazada que la mayoría de las armas rebotan sin más. Hicieron falta cuatro hombres con hachas para arrancarle ese trocito, y en cuanto terminaron, la roca volvió a crecer. La bestia apenas se dio cuenta de que estábamos allí y aplastó a tres hombres de un solo golpe. Huimos, y no sabemos dónde se esconde ahora. Busca por las tierras de los alrededores; es lenta y enorme, así que no debería ser difícil seguirle el rastro. Mi rastreador me dice que te especializas en cazar troles, así que sin duda ya llevas veneno para impedir que la criatura se regenere. Aun así, puede que sea imposible matar a esta bestia, peor que una docena de troles. Si de verdad logras matar a una montaña, te recompensaré como a un rey.%SPEECH_OFF% }"
    }
    // context: legend_hunting_rock_unholds_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{Fighting mountain giants won't come cheap. | The %companyname% can help for the right price. | Let's talk crowns.}"
        es = "{Luchar contra gigantes de montaña no te saldrá barato. | %companyname% puede ayudar por el precio justo. | Hablemos de coronas.}"
    }
    // context: legend_hunting_rock_unholds_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_71.png[/img]{%randombrother% returns from scouting, he has a harrowed look of a man who has passed by death. %SPEECH_ON%I climbed a hill to survey the landscape, couldn't see it in any direction. Then the earth shook something powerful, I was thrown off my feet and slid down the side of the hill, landing in a bush. When I looked back up, the hill was gone and it was walking away.%SPEECH_OFF%.}"
        es = "[img]gfx/ui/events/event_71.png[/img]{%randombrother% vuelve de explorar con la mirada angustiada de quien ha visto pasar la muerte de cerca. %SPEECH_ON%Subí a una colina para otear el terreno y no lo vi por ninguna parte. Entonces la tierra tembló con una fuerza tremenda, me tiró al suelo y resbalé ladera abajo hasta caer en un arbusto. Cuando volví a mirar arriba, la colina ya no estaba: se estaba alejando a pie.%SPEECH_OFF%.}"
    }
    // context: legend_hunting_rock_unholds_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "It can't have gotten far."
        es = "No puede haber ido muy lejos."
    }
    // context: legend_hunting_rock_unholds_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{The mountain unhold is bent over, it looks for all the world like the rubble of a collapsed castle. Large boulders piled together, with plants growing from between the joins. The rocks shudder and move, grinding together in a horrific low screech. The low pile turns to face you, then stands to its full height, towering above you. It is gnawing on half a cow, and as it sees you approach it burbles a chortle, spraying rancid ichor all over you.}"
        es = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{El trol de montaña está encorvado y parece en todo punto los escombros de un castillo derrumbado: grandes rocas amontonadas con plantas que brotan de las juntas. Las rocas se estremecen y se mueven, rechinando unas contra otras con un chirrido grave y espantoso. El montón bajo se vuelve hacia ti y luego se yergue en toda su altura, alzándose muy por encima de ti. Está royendo media vaca y, al verte acercarte, suelta una risotada gorgoteante y te rocía de arriba abajo con icor rancio.}"
    }
    // context: legend_hunting_rock_unholds_contract.createScreens.m.Screens.push().Text
    {
        // Text = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{As you put the men into formation, %shouter% goes running by you and right toward the unholds. He\'s hooting and hollering, his arms flailing like a sea cretin drawn up by the hook. The unholds pause and stare amongst one another. You\'re not sure whether this should be allowed to continue...}",
        mode = "pattern"
        en = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{As you put the men into formation, %shouter% goes running by you and right toward the unholds. He's hooting and hollering, his arms flailing like a sea cretin drawn up by the hook. The unholds pause and stare amongst one another. You're not sure whether this should be allowed to continue...}"
        es = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{Mientras pones a los hombres en formación, %shouter% pasa corriendo a tu lado directo hacia los troles. Va dando alaridos y berreando, agitando los brazos como un bicho marino sacado del agua con el anzuelo. Los troles se detienen y se miran entre sí. No sabes muy bien si deberías dejar que esto siga...}"
    }
    // en = "Attack them!"
    // en base_es
    // en = "%shouter% knows what he's doing."
    // en base_es
    // context: legend_hunting_rock_unholds_contract.createScreens.m.Screens.push().Text
    {
        // Text = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{Against your better judgment, you let %shouter% go. He doesn\'t stop for nothing, like he was chasing down a throng of beautiful women undressing just for him. Shockingly, the unholds take a step back. They start to retreat one by one until only a lone giant remains.\n\n%shouter% runs up to its feet like a yapping dog and lets forth some atavistic scream so hoarsely made that you wonder if every ancestor of the earth buried or otherwise had heard it. The unhold slings an arm before its face as though to shield it, then starts stepping back, further and further until it\'s gone! They\'re all gone!}",
        mode = "pattern"
        en = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{Against your better judgment, you let %shouter% go. He doesn't stop for nothing, like he was chasing down a throng of beautiful women undressing just for him. Shockingly, the unholds take a step back. They start to retreat one by one until only a lone giant remains.\n\n%shouter% runs up to its feet like a yapping dog and lets forth some atavistic scream so hoarsely made that you wonder if every ancestor of the earth buried or otherwise had heard it. The unhold slings an arm before its face as though to shield it, then starts stepping back, further and further until it's gone! They're all gone!}"
        es = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{En contra de tu buen juicio, dejas ir a %shouter%. No se detiene por nada, como si persiguiera a un tropel de mujeres hermosas que se desnudan solo para sus ojos. Para tu asombro, los troles dan un paso atrás. Empiezan a retirarse uno a uno hasta que solo queda un gigante solitario.\n\n%shouter% corre hasta sus pies como un perro ladrador y suelta un grito atávico tan ronco que te preguntas si lo habrán oído todos los antepasados de la tierra, enterrados o no. El trol se cruza un brazo delante de la cara como para protegerse y luego empieza a retroceder, más y más lejos, ¡hasta que desaparece! ¡Se han ido todos!}"
    }
    // en = "And don't come back!"
    // en base_es
    // en = "Managed to drive off unholds all by himself"
    // en base_es
    // context: legend_hunting_rock_unholds_contract.createScreens.m.Screens.push().Text
    {
        // Text = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{Against your better judgment, you let %shouter% go. He doesn\'t stop for nothing, like he was chasing down a throng of beautiful women undressing just for him. Shockingly, the unholds take a step back. They start to retreat one by one until only a lone giant remains.\n\n%shouter% runs up to its feet like a yapping dog and lets forth some atavistic scream so hoarsely made that you wonder if every ancestor of the earth buried or otherwise had heard it. The unhold slings an arm before its face and then throws it down and swats %shouter% away. The man goes cartwheeling through the air and his screams go with him like a rabbit stolen up by a hawk. His shouts somersault back to earth in an echo of dizzying whoops and he lands with a hardy thud. The giant jiggles with an earthen chuckle. It\'s amusement catches the attention of the departed unholds who all turn around and start to return.}",
        mode = "pattern"
        en = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{Against your better judgment, you let %shouter% go. He doesn't stop for nothing, like he was chasing down a throng of beautiful women undressing just for him. Shockingly, the unholds take a step back. They start to retreat one by one until only a lone giant remains.\n\n%shouter% runs up to its feet like a yapping dog and lets forth some atavistic scream so hoarsely made that you wonder if every ancestor of the earth buried or otherwise had heard it. The unhold slings an arm before its face and then throws it down and swats %shouter% away. The man goes cartwheeling through the air and his screams go with him like a rabbit stolen up by a hawk. His shouts somersault back to earth in an echo of dizzying whoops and he lands with a hardy thud. The giant jiggles with an earthen chuckle. It's amusement catches the attention of the departed unholds who all turn around and start to return.}"
        es = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{En contra de tu buen juicio, dejas ir a %shouter%. No se detiene por nada, como si persiguiera a un tropel de mujeres hermosas que se desnudan solo para sus ojos. Para tu asombro, los troles dan un paso atrás. Empiezan a retirarse uno a uno hasta que solo queda un gigante solitario.\n\n%shouter% corre hasta sus pies como un perro ladrador y suelta un grito atávico tan ronco que te preguntas si lo habrán oído todos los antepasados de la tierra, enterrados o no. El trol se cruza un brazo delante de la cara, luego lo baja de golpe y aparta a %shouter% de un manotazo. Sale volando por el aire entre volteretas, llevándose consigo sus gritos como un conejo arrebatado por un halcón. Sus chillidos vuelven a tierra dando tumbos en un eco de alaridos vertiginosos y aterriza con un golpe sordo y contundente. El gigante se sacude con una risa terrosa. Su regocijo llama la atención de los troles que se habían marchado, que se dan la vuelta y empiezan a regresar.}"
    }
    // en = "So much for that."
    // en base_es
    // context: legend_hunting_rock_unholds_contract.createScreens.m.Screens.push().start.List.push().text
    // en = "<this.Contract.m.Dude.getName()> suffers <injury1.getNameOnly()> and <injury2.getNameOnly()>"  // cubierto por el patrón "<name:str> suffers <injury1:str> and <injury2:str>"
    // en = "Failed to drive off unholds all by himself"
    // en base_es
    // context: legend_hunting_rock_unholds_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_113.png[/img]{The giant lays broken, rocks and shattered crystals strewn across the ground. You order the men to begin hacking apart the body, you have big plans for these remains.}"
        es = "[img]gfx/ui/events/event_113.png[/img]{El gigante yace destrozado, con rocas y cristales hechos añicos esparcidos por el suelo. Ordenas a los hombres que empiecen a despedazar el cuerpo: tienes grandes planes para estos restos.}"
    }
    // en = "Time to get paid."
    // en base_es
    // en = "[img]gfx/ui/events/event_113.png[/img]\x7bWith the giants slain, you get the men ready for a return to %employer%, but %randombrother% fetches your attention with a bit of quiver in his throat. You head on over to see him standing before one of the felled unholds. He points across its flesh which has been torn asunder in slices and hangs like the ears of a corn stalk. The damage is far beyond the ability of your own weaponry. The sellsword turns and looks past you with his eyes widening.%SPEECH_ON%What do you imagine did that?%SPEECH_OFF%Further along the skin are concave scars shaped like saucers with punctures rent right into the holes. You climb atop the unhold and crank your sword into one of these divots, wrenching free a tooth about the length of your forearm. Along its edges are barbs, teeth upon teeth it seems. The men see this and start muttering amongst themselves and you wished you'd never saw it at all for you've no sense to make of it.\x7d"
    // en base_es
    // en = "The wilds are dark and full of terrors."
    // en base_es
    // context: legend_hunting_rock_unholds_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_31.png[/img]{%employer% seems surprised when you return. %SPEECH_ON%If you have come back to ask for men to help, you are on your own. I already sent my best off to die, you will have to make do with what you have.%SPEECH_OFF%  You show him the remains of the giant and his eyes grow wide  %SPEECH_ON%How...  How did you?  Never mind, there will be songs written to tell the tale I am sure. For now let us feast, you have freed my lands of this horror and earned your reward.%SPEECH_OFF%  He gestures to his servants who cheer as one, then begin tending to your wounds, bringing over drinks, food, and a small chest full of crowns. }"
        es = "[img]gfx/ui/events/event_31.png[/img]{%employer% parece sorprendido cuando regresas. %SPEECH_ON%Si has vuelto a pedir hombres que te ayuden, tendrás que arreglártelas por tu cuenta. Ya mandé a morir a los mejores que tenía; tendrás que conformarte con lo que tienes.%SPEECH_OFF%  Le muestras los restos del gigante y se le abren los ojos como platos  %SPEECH_ON%¿Cómo...?  ¿Cómo lo has hecho?  No importa, seguro que se escribirán canciones para contarlo. Por ahora, celebremos un festín: has librado mis tierras de este horror y te has ganado tu recompensa.%SPEECH_OFF%  Hace una seña a sus sirvientes, que vitorean al unísono y luego empiezan a curarte las heridas y a traerte bebida, comida y un pequeño cofre lleno de coronas. }"
    }
    // context: legend_hunting_rock_unholds_contract.createScreens.m.Screens.push().Options.getResult.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation()
    {
        en = "Rid the town of rock unholds"
        es = "Libró al pueblo de troles de roca"
    }
    // en = "[img]gfx/ui/events/event_79.png[/img]\x7b%employer% drives his fingers up to the corners of his eye then fans them forward.%SPEECH_ON%Let me get this straight, one of your sellswords shouted the giants into a retreat?%SPEECH_OFF%You nod and tell him the direction they went which is, rather importantly, away from %townname%. The mayor leans back in his chair.%SPEECH_ON%Well. Alright then. I guess it ain't my problem now. Dead or gone, all the same I suppose.%SPEECH_OFF%He hands you a satchel, but holds his hand on it a moment.%SPEECH_ON%You know if you're lying and they come back I'll send every messenger bird I got to speak of your honor.%SPEECH_OFF%You stand up, draw your sword, and tell him they'll have his skull to rest in when they get there. The man nods and lets the coin go.%SPEECH_ON%No bother, sellsword, only business.%SPEECH_OFF%\x7d"
    // en base_es
    // en = "Rid the town of unholds"
    // en base_es
    // FILE: scripts\contracts\contracts\legend_hunting_skin_ghouls_contract.nut
    // context: legend_hunting_skin_ghouls_contract.create.m.Name
    {
        en = "Hunger Pangs (Legendary)"
        es = "Punzadas de hambre (Legendario)"
    }
    // context: legend_hunting_skin_ghouls_contract.create.m.DescriptionTemplates
    {
        en = "Corpse-eaters... always wretched, malevolent, yet predictable. However there is an intelligence being hinted in these disturbing reports that gives you pause."
        es = "Devoradores de cadáveres... siempre miserables, malévolos, pero predecibles. Sin embargo, estos inquietantes informes insinúan una inteligencia que te hace dudar."
    }
    // context: legend_hunting_skin_ghouls_contract.create.m.DescriptionTemplates
    {
        en = "Skin ghouls are abominations of nature, their pallid forms and insatiable hunger for flesh making them a terror to encounter."
        es = "Los necrófagos desollados son abominaciones de la naturaleza; sus formas pálidas y su hambre insaciable de carne hacen que toparse con ellos sea aterrador."
    }
    // context: legend_hunting_skin_ghouls_contract.create.m.DescriptionTemplates
    {
        en = "Skin ghouls are cursed beings, their rotting flesh and ravenous appetites make them a gruesome sight to behold."
        es = "Los necrófagos desollados son seres malditos; su carne putrefacta y su apetito voraz los convierten en un espectáculo espeluznante."
    }
    // context: legend_hunting_skin_ghouls_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        // "Hunt down skin ghouls around " + this.Contract.m.Home.getName()
        mode = "pattern"
        en = "Hunt down skin ghouls around <town:str>"
        es = "Da caza a los necrófagos desollados en los alrededores de <town>"
    }
    // context: legend_hunting_skin_ghouls_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_skin_ghoul.png[/img]{The exterior of %employer%'s grand manse near the centre of town looks as though it's seen better days, crusty old paint flaking off some of the walls and ancient sunbleached ivy having long since reclaimed some others. Approaching the front entrance, one of his household guard stops you to give you the once over, grinning toothlessly. %SPEECH_ON%Ohhh, yer %employer%'s latest meat for the thresher I take it, by the looks of ya. Eh? Heheh. Get ye on in, then. Might be ye'll have more luck than the last lot. Hyeheh.%SPEECH_OFF% He carries on chuckling to himself annoyingly as you head inside. On entering, it strikes you that the exterior of the huge house was likely left to rot intentionally – probably to distract from the immense wealth collected indoors, with everything from paintings to door handles gilded and polished, and every wall adorned with fine oak paneling and expensive ornaments. A bit garish for your taste. The housemaster orders a nervous little servant boy to take you to %employer%. You accompany the boy up three overly large flights of carpeted stairs to an engraved wooden door where he knocks once, tepidly, to no response. He knocks again, a little harder this time, and you hear %employer%'s muffled voice furiously bellow through the door, %SPEECH_ON%WHAT?%SPEECH_OFF% The door bursts open and %employer%, a corpulent red-faced man clothed in very fine linens of the extra-large variety, storms through the door and roars at the flinching servant boy. %SPEECH_ON%Boy, I am NOT to be interrupted at my work. IF I am to be interrupted, which I am NOT, the signal that the knock is of importance is to knock THRICE. Do you know what THRICE means? It means THREE. THREE knocks if the knock is one of importance. Do you understand?%SPEECH_OFF% The boy, looking on the verge of tears, mumbles %SPEECH_ON%Yessir, yes, yes sir, sorry sir,%SPEECH_OFF% and quickly scurries off. %employer% regards you with an ugly frown, sizing you up. His face softens a little when he notices the knock was, in fact, of importance. %SPEECH_ON%Ah ... the mercenaries I ordered. Mm. Very good.%SPEECH_OFF% He thumbs over his shoulder, gesturing you enter the room, a large and well-lit study filled with trophies and clutter. Every shelf and surface is covered in papers, notes, coins, quills and inks. %SPEECH_ON%There is … an issue. With employees of mine.%SPEECH_OFF% He clears his throat. %SPEECH_ON%Ex-employees, I should perhaps say, since they've been torn to a thousand ribbons and eaten, by what I am told is the most numerous and fearsome lot of devouring beasts these parts have seen in memory.%SPEECH_OFF% He opens his bureau and pulls out a roll of parchment. He unfurls it and presents it to you. It's a rather scary-looking sketch of a huge horned Nachzehrer, its maw open to bare its enormous jagged fangs. %SPEECH_ON%Know you this sight?%SPEECH_OFF% he asks, the parchment beginning to shake with anger in his fat fingers. You tell him you know it, more or less. %SPEECH_ON%Well, this monster and its foul friends are costing my … operation. Costing my operation very dearly. It cannot continue and must be dealt with. With extreme expedition. It is not a small matter and I am prepared to compensate extremely well the one who accepts this opportunity from me. Will it be you?%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/legend_skin_ghoul.png[/img]{El exterior de la gran mansión de %employer%, cerca del centro del pueblo, parece haber conocido tiempos mejores: la vieja pintura reseca se desconcha en algunas paredes y una antigua hiedra descolorida por el sol hace tiempo que se adueñó de otras. Al acercarte a la entrada principal, uno de sus guardias te detiene para echarte un buen vistazo, con una sonrisa desdentada. %SPEECH_ON%Ohhh, por la pinta que tienes, tú debes de ser la última carne de trilladora de %employer%, ¿eh? Jejeje. Pues pasa, pasa. A lo mejor tienes más suerte que los anteriores. Jijeje.%SPEECH_OFF% Sigue riéndose para sí de forma irritante mientras entras. Nada más entrar, te llama la atención que el exterior de la enorme casa seguramente se dejó pudrir a propósito, probablemente para disimular la inmensa riqueza acumulada dentro, donde todo, desde los cuadros hasta los pomos de las puertas, está dorado y pulido, y cada pared luce finos paneles de roble y adornos caros. Algo chabacano para tu gusto. El mayordomo ordena a un criadito nervioso que te lleve ante %employer%. Acompañas al chico por tres tramos desmesurados de escalera alfombrada hasta una puerta de madera tallada, a la que llama una vez, con timidez, sin obtener respuesta. Vuelve a llamar, esta vez algo más fuerte, y oyes la voz ahogada de %employer% bramar con furia a través de la puerta: %SPEECH_ON%¿¡QUÉ!?%SPEECH_OFF% La puerta se abre de golpe y %employer%, un hombre corpulento de cara colorada vestido con finísimos linos de talla extragrande, sale hecho una furia y le ruge al criadito, que se encoge. %SPEECH_ON%Chico, NO se me interrumpe cuando trabajo. SI se me ha de interrumpir, que NO es el caso, la señal de que la llamada es importante es llamar POR TRIPLICADO. ¿Sabes lo que significa POR TRIPLICADO? Significa TRES. TRES golpes si la llamada es importante. ¿Lo entiendes?%SPEECH_OFF% El chico, al borde de las lágrimas, murmura %SPEECH_ON%Sí, señor, sí, sí, señor, perdón, señor,%SPEECH_OFF% y se escabulle a toda prisa. %employer% te mira con un ceño desagradable, tomándote la medida. Su rostro se suaviza un poco al darse cuenta de que la llamada era, en efecto, importante. %SPEECH_ON%Ah... los mercenarios que encargué. Mm. Perfecto.%SPEECH_OFF% Señala por encima del hombro con el pulgar y te indica que entres en la estancia, un estudio amplio y bien iluminado lleno de trofeos y trastos. Cada estante y cada superficie están cubiertos de papeles, notas, monedas, plumas y tinteros. %SPEECH_ON%Hay… un problema. Con unos empleados míos.%SPEECH_OFF% Carraspea. %SPEECH_ON%Exempleados, quizá debería decir, ya que los han hecho mil jirones y se los ha comido, según me cuentan, la manada de bestias devoradoras más numerosa y temible que se recuerda por estos lares.%SPEECH_OFF% Abre su escritorio y saca un rollo de pergamino. Lo despliega y te lo enseña. Es un boceto bastante aterrador de un enorme Nachzehrer con cuernos, con las fauces abiertas para mostrar sus enormes colmillos dentados. %SPEECH_ON%¿Conoces esta imagen?%SPEECH_OFF%, pregunta, mientras el pergamino empieza a temblar de rabia entre sus dedos gordos. Le dices que sí, más o menos. %SPEECH_ON%Pues bien, este monstruo y sus inmundos compinches le están costando a mi… negocio. Le están costando muy caro a mi negocio. Esto no puede seguir y hay que ocuparse de ello. Con extrema premura. No es un asunto menor y estoy dispuesto a compensar extremadamente bien a quien me acepte esta oportunidad. ¿Serás tú?%SPEECH_OFF%}"
    }
    // context: legend_hunting_skin_ghouls_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{Accepting your 'opportunity' could cost my company dearly as well. What will you pay? | It appears you can afford it. Let's talk money. | About that 'compensation'...}"
        es = "{Aceptar tu 'oportunidad' también podría costarle caro a mi compañía. ¿Cuánto vas a pagar? | Parece que puedes permitírtelo. Hablemos de dinero. | En cuanto a esa 'compensación'...}"
    }
    // context: legend_hunting_skin_ghouls_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_25.png[/img]{You stumble across a dead farmer with its flesh ripped to pieces. %randombrother% crouches and runs and inspects the corpse. %SPEECH_ON%This is clearly the work of a skin ghoul. They're close...%SPEECH_OFF% | %randombrother% spits and nods.%SPEECH_ON%Alright. We're close. Rather, they're close. %SPEECH_OFF%Well that's good. Time for the men to find these monsters. }"
        es = "[img]gfx/ui/events/event_25.png[/img]{Te topas con un granjero muerto, con la carne hecha jirones. %randombrother% se agacha y examina el cadáver. %SPEECH_ON%Esto es obra de un necrófago desollado, sin duda. Están cerca...%SPEECH_OFF% | %randombrother% escupe y asiente.%SPEECH_ON%Bien. Estamos cerca. Mejor dicho, ellos están cerca. %SPEECH_OFF%Pues eso es bueno. Es hora de que los hombres encuentren a esos monstruos. }"
    }
    // context: legend_hunting_skin_ghouls_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_skin_ghoul.png[/img]{The horde of skin ghouls suddenly turn as one. They let out a screech unlike anything you've ever heard before. Claws raised before them, the began to swarm towards the company.}"
        es = "[img]gfx/ui/events/legend_skin_ghoul.png[/img]{La horda de necrófagos desollados se vuelve de pronto al unísono. Sueltan un chillido distinto de todo lo que has oído jamás. Con las garras en alto, empiezan a abalanzarse en tropel hacia la compañía.}"
    }
    // context: legend_hunting_skin_ghouls_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_skin_ghoul_dead.png[/img]{The last of the skin ghouls is dealt with. You nod at the company's good work then order the men to gather weapons and tend to the wounded, glad these beasts have been vanquished. }"
        es = "[img]gfx/ui/events/legend_skin_ghoul_dead.png[/img]{Acaban con el último de los necrófagos desollados. Asientes ante el buen trabajo de la compañía y luego ordenas a los hombres que recojan las armas y atiendan a los heridos, con el alivio de saber que esas bestias han caído. }"
    }
    // context: legend_hunting_skin_ghouls_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "alrdedor" es errata de "alrededor"; "un gran aplauso" por "a great clap" es una palmada, no un aplauso; "evidencia" calca "evidence" (prueba); "parte de las posesiones ... lo que quede de ella" no concordaba y el inglés habla de la herencia entera ("the estate"), así que pasa a "la herencia ... lo que queda de ella".
        en = "[img]gfx/ui/events/event_85.png[/img]{%employer% meets you at the town entrance and there's a crowd of folks beside him. He welcomes you warmly, stating he had a scout following you who saw the whole battle unfold. After he hands you your reward, the townsfolk come forward one by one, many of which are reluctant to stare a sellsword in the eyes, but they offer a few gifts as thanks for relieving them of the skin ghoul horrors. | You have to track down %employer%, ultimately finding the man in a stable livery with a peasant girl. He bolts upward from the hay, startling the horses which whinny and stamp their hooves. Half-dressed, the man states he already has your pay and forks it over. Eyeing you eyeing the girl, he then starts to grab whatever's in reach, including from the saddlebags of stabled mounts, and hands them over.%SPEECH_ON%The, uh, townsfolk also sought to pitch in. You know, as thanks.%SPEECH_OFF%Right. For further 'thanks' you ask if he'll give you whatever's in a nearby satchel. | %employer% welcomes you back with a great clap and rub of his hands, as though you'd just brought in a turkey and not the horrifying evidence of your victory. After paying you the agreed reward, you hear some surprising news. The mayor states that the estate of a lost townsman could not be properly divvied up and, as further thanks, you're free to take what's left of it.}"
        es = "[img]gfx/ui/events/event_85.png[/img]{%employer% te recibe en la entrada del pueblo y hay una multitud de personas a su alrededor. Te da una cálida bienvenida y te cuenta que tenía a un explorador siguiéndote que presenció toda la batalla. Después de entregarte tu recompensa, los habitantes del pueblo se acercan uno a uno, muchos de ellos reacios a mirar a un mercenario a los ojos, pero te ofrecen algunos regalos como agradecimiento por librarlos de los horrores de los necrófagos desollados. | Tienes que dar con %employer%, y acabas encontrándolo en la cuadra de un establo con una campesina. Se incorpora de un salto entre la paja y asusta a los caballos, que relinchan y patean el suelo con los cascos. A medio vestir, el hombre dice que ya tiene tu pago y te lo suelta. Al ver que tú miras a la chica, empieza a agarrar todo lo que tiene a mano, incluido lo que hay en las alforjas de las monturas del establo, y te lo entrega.%SPEECH_ON%Los, eh, habitantes del pueblo también quisieron poner de su parte. Ya sabes, como agradecimiento.%SPEECH_OFF%Claro. Como 'agradecimiento' adicional, le preguntas si te dará lo que haya en una bolsa que hay cerca. | %employer% te recibe con una gran palmada y frotándose las manos, como si acabaras de traer un pavo y no la aterradora prueba de tu victoria. Después de pagarte la recompensa acordada, escuchas una noticia sorprendente. El alcalde declara que la herencia de un vecino desaparecido no ha podido repartirse como es debido y que, como muestra de agradecimiento adicional, eres libre de llevarte lo que queda de ella.}"
    }
    // context: legend_hunting_skin_ghouls_contract.createScreens.m.Screens.push().Options.getResult.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation()
    {
        en = "Rid the town of skin ghouls"
        es = "Libró al pueblo de necrófagos desollados"
    }
    // context: legend_hunting_skin_ghouls_contract.spawnEnemies.party.setDescription()
    {
        en = "A horde of terrorizing skin ghouls."
        es = "Una horda de aterradores necrófagos desollados."
    }
    // FILE: scripts\contracts\contracts\legend_hunting_stollwurms_contract.nut
    // context: legend_hunting_stollwurms_contract.create.m.Name
    {
        en = "Hunting Stollwurms (Legendary)"
        es = "Caza a los Stollwurms (Legendario)"
    }
    // context: legend_hunting_stollwurms_contract.create.m.DescriptionTemplates
    {
        en = "You have to be either brave or foolish to fight a Lindwurm, the old saying goes. Looking at these especially monstrous specimens through your spyglass, you decide to add 'insane or desperate' to that list."
        es = "Hay que ser valiente o necio para enfrentarse a un Lindwurm, dice el viejo refrán. Al observar estos ejemplares especialmente monstruosos con tu catalejo, decides añadir 'demente o desesperado' a la lista."
    }
    // context: legend_hunting_stollwurms_contract.create.m.DescriptionTemplates
    {
        en = "Stollwurms scales are as hard as iron. Some tribes worship these apex predators as gods."
        es = "Las escamas de los stollwurms son duras como el hierro. Algunas tribus adoran como a dioses a estos superdepredadores."
    }
    // context: legend_hunting_stollwurms_contract.create.m.DescriptionTemplates
    {
        en = "Blessed are the maker stollwurms, whose passage cleanses the world. You don't believe that farkin' nonsense of course."
        es = "Benditos sean los stollwurms Hacedores, cuyo paso purifica el mundo. Tú, por supuesto, no te crees esas malditas tonterías."
    }
    // context: legend_hunting_stollwurms_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        // "Hunt down the Stollwurms around " + this.Contract.m.Home.getName()
        mode = "pattern"
        en = "Hunt down the Stollwurms around <town:str>"
        es = "Da caza a los stollwurms en los alrededores de <town>"
    }
    // context: legend_hunting_stollwurms_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_31.png[/img]{You enter the keep and are shown down to the cellar. While the room clearly once held food stores, they are reduced to rubbish now, smashed around the room. A huge hole has been smashed in one wall, and %employer% has his head pointed down the tunnel peering into the gloom. You see torchlight further down the tunnel, but a voice from the hole yells out. %SPEECH_ON%It's no use sire, the tunnel ends in a collapse.%SPEECH_OFF% %employer% turns back to the room and sees you waiting. %SPEECH_ON%Good, good. Glad to see you tracker. They tell me you have experience hunting wurms and as you can see, I have a wurm problem. A Stollwurm has been terrorising the area, raiding our supplies and taking cattle before disapearing as fast as it arrived. We have tried chasing it down the holes, laying traps and every other trick we can think of. This is no ordinary wurm, it is as quick as lightning and just as deadly. It has killed several of my men, and will require expert tracking to find. Are you up for the challenge?%SPEECH_OFF% }"
        es = "[img]gfx/ui/events/event_31.png[/img]{Entras en la fortaleza y te conducen hasta la bodega. Aunque está claro que la estancia guardó en su día provisiones, ahora no son más que desperdicios desparramados por todas partes. En una de las paredes hay un boquete enorme abierto a golpes, y %employer% asoma la cabeza por el túnel, escudriñando la penumbra. Ves la luz de una antorcha más adentro, pero una voz grita desde el agujero. %SPEECH_ON%Es inútil, mi señor, el túnel termina en un derrumbe.%SPEECH_OFF% %employer% se vuelve hacia la estancia y ve que lo esperas. %SPEECH_ON%Bien, bien. Me alegra verte, rastreador. Me dicen que tienes experiencia cazando wurms y, como ves, tengo un problema con un wurm. Un Stollwurm lleva tiempo aterrorizando la zona, saqueando nuestras provisiones y llevándose ganado antes de desaparecer tan rápido como llegó. Hemos intentado perseguirlo por los agujeros, tenderle trampas y cualquier otro truco que se nos ocurra. No es un wurm cualquiera: es rápido como el rayo e igual de letal. Ha matado a varios de mis hombres y hará falta un rastreador experto para encontrarlo. ¿Estás a la altura?%SPEECH_OFF% }"
    }
    // en = "\x7bThat's a mighty big task you're asking of us. | I expect to be well compensated to fight an enemy such as this. | I expect you to make me a rich man for this.\x7d"
    // en base_es
    // en = "\x7bSounds more like what you need are heroes and fools. | It's not worth the risk. | I don't think so.\x7d"
    // en base_es
    // context: legend_hunting_stollwurms_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_stollwurm_hole.png[/img]{%randombrother% points out a large burrow, big enough for three cows to walk abreast. The tunnel smells like fresh death and excrement, the stollwurm is no doubt close. | %randombrother% is poking at the edge of a hole. He turns to you with a grim look. %SPEECH_ON%Stollwurm took my great uncle. He was walking across a field and the ground opened up beneath him. The beast appeared directly below him, gobbled him up and left. I've had nightmares about them ever since. I do not like the size of these holes.%SPEECH_OFF% An offputting tale, when even the ground is not an ally. You direct the company to hold firm, those stollwurms cannot be far. | The tracks have the grass flattened in a snaking pattern with holes set to the sides. %randombrother% crouches beside the patterns.%SPEECH_ON%Either a plough with no dig or this be the critters we're lookin' for.%SPEECH_OFF%You nod. The stollwurm cannot be far.}"
        es = "[img]gfx/ui/events/legend_stollwurm_hole.png[/img]{%randombrother% señala una gran madriguera, lo bastante ancha para que pasen tres vacas una al lado de otra. El túnel huele a muerte reciente y a excrementos; sin duda, el stollwurm está cerca. | %randombrother% hurga en el borde de un agujero. Se vuelve hacia ti con expresión sombría. %SPEECH_ON%Un stollwurm se llevó a mi tío abuelo. Iba cruzando un campo y el suelo se abrió bajo sus pies. La bestia apareció justo debajo de él, se lo zampó y se fue. Desde entonces tengo pesadillas con ellos. No me gusta el tamaño de estos agujeros.%SPEECH_OFF% Una historia inquietante, cuando ni siquiera el suelo es tu aliado. Ordenas a la compañía que se mantenga firme: esos stollwurms no pueden andar lejos. | Las huellas han aplastado la hierba en un patrón serpenteante, con agujeros a los lados. %randombrother% se agacha junto a las marcas.%SPEECH_ON%O ha pasado un arado que no ara, o estos son los bichos que buscamos.%SPEECH_OFF%Asientes. El stollwurm no puede andar lejos.}"
    }
    // en = "Be on the lookout!"
    // en base_es
    // context: legend_hunting_stollwurms_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_stollwurm_hole_full.png[/img]{You are checking the map when %randombrother% calls out. Looking up, you see the stollwurms emerging from a hole in the ground, great sheets of dust streaming off their sides. Their bodies sway low to the ground as they whip their way toward the %companyname%. You draw out your sword and order the men into formation. | The company comes upon a cave lined with boulders at its front. But as you draw near, the rocks uncoil and flip mid-air and legs shoot out their bellies to plant the landings of what are clearly stollwurms. You step back as the beasts wriggle the dust off their backs and snap their maws with guttural croaking. They turn to you, eyes blinking, and begin to lazily come forward as though your mercenaries were but a minor inconvenience to dispatch. You order the company into formation. The monsters, perhaps sensing you are more of a threat, suddenly surge forward, powerfully hissing as their bodies sidewinder over the ground with surprising speed. | The %companyname% step toward a hill with bones crunching under every step. %randombrother% shushes the company and points to the hilltop. Stollwurms are curved about its crest as though to embroider the very earth. Seemingly sensing your stare, the beasts unfurl and come down the slope, some half twisting like children rolling down a hill. Their maws clap and snap, tongues licking the dust out of their eyes, altogether looking like sleepwalking critters more than murderous monsters. But the second their feet step upon the flat earth they seize up and bolt forward, their snaky shapes streaking across the boneyard, powdered bonemeal rooster tailing up in their wake. Drawing your sword, you urgently order the men to formation.}"
        es = "[img]gfx/ui/events/legend_stollwurm_hole_full.png[/img]{Estás consultando el mapa cuando %randombrother% da la voz de alarma. Al levantar la vista, ves a los stollwurms salir de un agujero en el suelo, con grandes cortinas de polvo cayéndoles por los costados. Sus cuerpos se mecen a ras de suelo mientras avanzan serpenteando como latigazos hacia %companyname%. Desenvainas la espada y ordenas a los hombres que formen. | La compañía da con una cueva con la entrada flanqueada por rocas. Pero al acercarte, las rocas se desenroscan y dan una vuelta en el aire, y de sus vientres brotan patas para amortiguar el aterrizaje de lo que, sin duda, son stollwurms. Retrocedes mientras las bestias se sacuden el polvo del lomo retorciéndose y chasquean las fauces con un croar gutural. Se vuelven hacia ti, parpadeando, y empiezan a avanzar con desgana, como si tus mercenarios no fueran más que una pequeña molestia de la que deshacerse. Ordenas a la compañía que forme. Los monstruos, quizá al intuir que la compañía es una amenaza mayor, se lanzan de pronto hacia delante con fuertes siseos mientras sus cuerpos reptan de lado por el suelo a una velocidad sorprendente. | Los hombres de %companyname% avanzan hacia una colina, y a cada paso crujen huesos bajo sus pies. %randombrother% manda callar a la compañía y señala la cima. Hay stollwurms enroscados en torno a la cresta, como si bordaran la propia tierra. Como si notaran tu mirada, las bestias se desenroscan y bajan por la ladera, algunas medio girando sobre sí mismas como niños que ruedan colina abajo. Sus fauces chocan y chasquean, y se lamen el polvo de los ojos con la lengua; en conjunto, parecen más bichos sonámbulos que monstruos asesinos. Pero en cuanto sus patas pisan terreno llano, se tensan y se lanzan hacia delante, con sus siluetas serpentinas cruzando como un rayo el osario y levantando a su paso un penacho de polvo de hueso. Desenvainas la espada y ordenas con urgencia a los hombres que formen.}"
    }
    // context: legend_hunting_stollwurms_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "son monstruos" por "they're killers" (son asesinos); "aspecto salvaje" por "haggard looks" (demacrado); "escamas de piel" por "skinsuit" (traje de piel, como en el texto de la extorsión); "una caja loca de sorpresas" cambiaba el sentido de "I'm actually a barrel of it" (loco a barriles); "un loco como yo" rebajaba "a crazy fark"; faltaba "giant"; "¿entendides?" es errata de "¿entendido?".
        en = "[img]gfx/ui/events/event_17.png[/img]{You find the stollwurms slithering about a dugout in the ground, but before you can go to battle a man interrupts you with a humanly hiss. He looks like he has not shaved in days, has a fat satchel yoked over both shoulders and a bandana bunches up his hair like potted sagebrush. Aside from his haggard looks there is not a weapon on him. You ask what he wants. He speaks hurriedly and in a hushed tone.%SPEECH_ON%You here to kill the stollwurms?%SPEECH_OFF%The nasty snakelike monsters are wriggling around in the distance, seemingly playing with one another like puppies or kittens would. You nod and tell him they're killers and you've been paid to slay them all. The man purses his lips.%SPEECH_ON% See that gleam in their coat? That's unique to them, and they are the last of their kind. These are rarified stollwurms, sir, and it'd be a horrid ruin upon the world itself for them to be made wholly nonexistent. How about I give you %bribe% crowns and, uh, you was paid by someone, right? So you take this, too.%SPEECH_OFF%He pulls a great, scratchy stollwurm skinsuit out of his satchel and offers to hand it over.%SPEECH_ON%Tell your employer you'd found and killed the stollwurms and show them this. They won't know the difference. And if you think about doublecrossing me here let me say this, I look a hint of crazy but I'm actually a barrel of it. And a crazy fark like myself wouldn't survive following these giant, wonderful, and beautiful stollwurms around if he didn't know a thing or two, got it?%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_17.png[/img]{Encuentras a los stollwurms deslizándose alrededor de un hoyo en el suelo, pero antes de que puedas entrar en batalla, un hombre te interrumpe con un siseo humano. Parece que no se ha afeitado en días, lleva una gran bolsa colgada sobre ambos hombros y una bandana le recoge el pelo como una mata de artemisa en maceta. Aparte de su aspecto demacrado, no lleva ninguna arma. Le preguntas qué quiere. Habla apresuradamente y en voz baja.%SPEECH_ON%¿Vienes a matar a los stollwurms?%SPEECH_OFF%Los desagradables monstruos parecidos a serpientes se retuercen a lo lejos, aparentemente jugando entre ellos como harían cachorros o gatitos. Asientes y le dices que son asesinos y que te han pagado para matarlos a todos. El hombre frunce los labios.%SPEECH_ON% ¿Ves ese brillo en su piel? Es algo único en ellos, y son los últimos de su especie. Estos son stollwurms raros, señor, y sería una horrible pérdida para el mundo que dejaran de existir por completo. ¿Qué tal si te doy %bribe% coronas y...? Eh, te ha pagado alguien, ¿verdad? Así que toma esto también.%SPEECH_OFF%Saca de su bolsa un enorme y áspero traje de piel de stollwurm y te lo ofrece.%SPEECH_ON%Dile a tu empleador que encontraste y mataste a los stollwurms y enséñale esto. No notará la diferencia. Y si estás pensando en traicionarme, déjame decirte una cosa: parezco un poco loco, pero en realidad lo estoy a barriles. Y un maldito chiflado como yo no sobreviviría siguiendo a estos gigantescos, maravillosos y hermosos stollwurms si no supiera un par de cosas, ¿entendido?%SPEECH_OFF%}"
    }
    // en = "Out of the way, fool. We have a beast to slay."
    // en base_es
    // en = "Very well. I accept your offer."
    // en base_es
    // context: legend_hunting_stollwurms_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "las escamas de piel de loco protector de Lindwurms engaña" era confuso, no concordaba y "skinsuit" es un traje de piel; "Tú, señor, en realidad tienes un noble corazón" añadía "en realidad" y perdía la jerga de "righteous", que acompaña al gesto de pulgar y meñique.
        en = "[img]gfx/ui/events/event_17.png[/img]{The way you see it the stollwurms here are not truly your problem, you were just paid to take care of them. And you could potentially get paid twice if the crazy stollwurm protector's skinsuit fools %employer%.\n\nYou take the deal. The fool thanks you and hugs you unexpectedly. He smells awful and his hair has become so matted and thick that tiny little bugs have bored out caves there and can be seen staring at you. A tiny skink scuttles between the stinky stalks and snatches one of the bugs. You throw the man back and wish him luck in whatever the hell he's doing. He puts out his thumb and pinky finger and wags the hand.%SPEECH_ON%You, sir, are righteous.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_17.png[/img]{Tal como lo ves, los stollwurms de aquí no son realmente tu problema; solo te pagaron para encargarte de ellos. Y podrías cobrar dos veces si el traje de piel del chiflado protector de los stollwurms engaña a %employer%.\n\nAceptas el trato. El chiflado te da las gracias y te abraza sin previo aviso. Huele horrible y tiene el pelo tan apelmazado y espeso que unos bichitos han excavado cuevas en él y se les ve mirándote. Un pequeño eslizón se escabulle entre los mechones apestosos y atrapa uno de los bichos. Apartas al hombre de un empujón y le deseas suerte en lo que demonios sea que esté haciendo. Extiende el pulgar y el meñique y agita la mano.%SPEECH_ON%Tú, señor, eres un tipo de ley.%SPEECH_OFF%}"
    }
    // en = "Righteous. Right."
    // en base_es
    // en = "You gain <v:val_tag> Crowns"
    // en base_es
    // context: legend_hunting_stollwurms_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_stollwurm.png[/img]{Dust clouds belch from a distant cave entrance. As you draw near, you can hear the hiss of the stollwurms and intermittent growling of something else entirely.%SPEECH_ON%Look, sir!%SPEECH_OFF%%randombrother% points to the rim of the cave dugout. There's a group of orcs tackling a stollwurm, one being slung around as it holds onto the tail, another is hand fighting its maw to not get bit. \n\nShaking your head, you draw out your sword and order the men into formation. Looks like this is going to be a proper barnstormer if there ever was one.}"
        es = "[img]gfx/ui/events/legend_stollwurm.png[/img]{De la entrada de una cueva lejana brotan nubes de polvo. Al acercarte, oyes el siseo de los stollwurms y, de vez en cuando, los gruñidos de algo muy distinto.%SPEECH_ON%¡Mira, señor!%SPEECH_OFF%%randombrother% señala el borde de la excavación de la cueva. Un grupo de orcos está forcejeando con un stollwurm: uno sale volteado por los aires mientras se aferra a la cola y otro le sujeta las fauces a manotazos para que no le muerda. \n\nSacudiendo la cabeza, desenvainas la espada y ordenas a los hombres que formen. Parece que esto va a ser una trifulca de las buenas como pocas.}"
    }
    // en = "I don't know if this is good or bad."
    // en base_es
    // context: legend_hunting_stollwurms_contract.createScreens.m.Screens.push().Options.getResult.p.CombatID
    // en = "Stollwurms"  // CombatID: identificador interno del combate, no se muestra
    // context: legend_hunting_stollwurms_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "traquetea haciendo que ... se balancee" cambiaba el sentido (la parte trasera se levanta y el ayudante sale despedido); "avanza rápidamente" daba por hecho lo que en inglés es una opción ("can rush forward").
        en = "[img]gfx/ui/events/event_41.png[/img]{You spot a merchant and his wagon trundling up the road. The rear of the wagon lifts upward and the caravan hand on the back is launched like a ragdoll. A streak of green slips behind the caravan and another goes to the side. The merchant turns and jumps into the wagon as stollwurms start their assault. These are no doubt the creatures you've been looking for. At your command, the %companyname% can rush forward before the caravan is destroyed.}"
        es = "[img]gfx/ui/events/event_41.png[/img]{Avistas a un mercader y su carreta avanzando con traqueteo por el camino. La parte trasera de la carreta se levanta de golpe y el ayudante de la caravana que iba detrás sale despedido como un muñeco de trapo. Una sombra verde se desliza por detrás de la caravana y otra se va hacia un costado. El mercader se gira y salta dentro de la carreta mientras los stollwurms inician su ataque. Sin duda, estas son las criaturas que has estado buscando. A tu orden, %companyname% puede lanzarse hacia delante antes de que la caravana quede destruida.}"
    }
    // en = "Attack!"
    // en base_es
    // context: legend_hunting_stollwurms_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "levanta la cabeza" por "holds a finger up" (levanta un dedo); "una un trozo de carbon" por "a quill pen" (una pluma), con errata; "besa tu mano" por "your ringless finger"; "extraño" por "stranger" (forastero); "Tienes a los hombres desollando" calcaba "You have the men skin".
        en = "[img]gfx/ui/events/event_41.png[/img]{The battle is over. You have the men skin a few of the stollwurms while you go and talk to the merchant. He bows in thanks and kisses your ringless finger.%SPEECH_ON%Thank you, sir, thank you! Ohhh, my wagon! My goods!%SPEECH_OFF%His eyes twist away to the remains of his caravan. He collapses, his knees in the debris, and shakes his head.%SPEECH_ON%I wish I had anything to pay you with, stranger, but it's all gone.%SPEECH_OFF%But then he holds a finger up. He jumps back to his feet and asks if you have a map. You show what you got, and he takes out a quill pen.%SPEECH_ON%Here, I know of a spot that is said to hold great treasure. I don't know if that's true or not, but the rumor's as good as gold if it is!%SPEECH_OFF%Yeah, if. You thank the merchant for his generosity anyway and wish him better luck on his journey ahead. As for the %companyname%, it needs to return to %employer% to get paid.}"
        es = "[img]gfx/ui/events/event_41.png[/img]{La batalla ha terminado. Pones a los hombres a desollar algunos stollwurms mientras vas a hablar con el mercader. Se inclina en señal de agradecimiento y te besa el dedo sin anillo.%SPEECH_ON%¡Gracias, señor, gracias! ¡Ohhh, mi carreta! ¡Mis mercancías!%SPEECH_OFF%Desvía la mirada hacia los restos de su caravana. Se derrumba, de rodillas entre los escombros, y sacude la cabeza.%SPEECH_ON%Ojalá tuviera algo con qué pagarte, forastero, pero lo he perdido todo.%SPEECH_OFF%Pero entonces levanta un dedo. Se pone de pie de un salto y te pregunta si tienes un mapa. Le enseñas el que tienes y saca una pluma.%SPEECH_ON%Mira, sé de un lugar que, según dicen, guarda un gran tesoro. No sé si es cierto o no, ¡pero si lo es, el rumor vale su peso en oro!%SPEECH_OFF%Ya, si lo es. Aun así, le agradeces al mercader su generosidad y le deseas mejor suerte en el resto de su viaje. En cuanto a %companyname%, tiene que volver con %employer% para cobrar.}"
    }
    // en = "We should pay a visit to that place one day."
    // en base_es
    // context: legend_hunting_stollwurms_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "Roto y aún más arruinado" perdía el juego de "broke" (sin blanca y partido en dos), que se recupera con "quebrado"; "bolsillos girados" por "pockets turned out" (vueltos del revés).
        en = "[img]gfx/ui/events/event_60.png[/img]{The battle is over. You have half your men go about skinning the stollwurms to show %employer% when you get back. The other half sift through the remains of the merchant's caravan. There is nothing of note to find, not even gold. Anything of value has been smashed to pieces in the fighting. The merchant himself has been torn in half and the legs sit a way away with their pockets turned out and empty, %randombrother% squatting beside the remains. He nods.%SPEECH_ON%Well, that's a sorry way to go. Broke and even more broke.%SPEECH_OFF%You nod back and then holler at the men to pack their things. It is time to return to your employer and collect your pay.}"
        es = "[img]gfx/ui/events/event_60.png[/img]{La batalla ha terminado. Pones a la mitad de tus hombres a desollar a los stollwurms para enseñárselos a %employer% cuando vuelvas. La otra mitad rebusca entre los restos de la caravana del mercader. No hay nada de interés, ni siquiera oro. Todo lo que tenía valor quedó hecho pedazos durante la lucha. Al propio mercader lo han partido en dos y sus piernas están algo apartadas, con los bolsillos vueltos del revés y vacíos. %randombrother%, en cuclillas junto a los restos, asiente.%SPEECH_ON%Bueno, qué manera más triste de irse. Quebrado y requetequebrado.%SPEECH_OFF%Asientes a tu vez y luego gritas a los hombres que recojan sus cosas. Es hora de volver con tu empleador y cobrar tu paga.}"
    }
    // en = "At least we put an end to those beasts."
    // en base_es
    // context: legend_hunting_stollwurms_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_130.png[/img]{Fighting the stollwurms was like taking a butterknife and jabbing it into a basket of vipers. They fought like something from another world, hissing and spewing and biting, but they were no match for the %companyname%'s resolve and skill. You have the men scalp and skin the creatures and ready them for a return to %employer% for a well earned payday. | The stollwurms lay in well earned ruin. Your company goes about poking the corpses at a distance, making sure the bastards are truly dead. A few gargle and flip over, but that's about the last of their living issuances. You order the overgrown lizards scalped and skinned. %employer% will be expecting proof, after all. | You crouch beside a stollwurm and take your hand over its skin. The way you figure, the scales are long and sharp enough to cut your fingers off if jammed in between the wedges. You then stand akimbo over the head and stare into its maw, getting a measure of its teeth with your hands and its gullet with the steel of your sword. %randombrother% comes to your side and asks what they're to do next. You unsheathe your sword from the stollwurm's throat, wipe it clean, and sheathe it proper. You order the men to skin a few of the beasts and ready a return to %employer%. | The battle over, you have the stollwurms skinned and dressed for anything of value. It is not long before the field stinks of the skinks, the overly large lizards being shorn of the scales that once protected them. Their sickly, glistening musculature bared for all to see, a nakedness and vulnerability is wrought upon the once and always monsters. %randombrother% snorts and runs a sleeve beneath his nose. He nods at his handiwork.%SPEECH_ON%Nothing more than a common creature, just a shade larger than it ought to be.%SPEECH_OFF%Damn right. You order the men to collect what they've got and ready a return to %employer%.}"
        es = "[img]gfx/ui/events/event_130.png[/img]{Luchar contra los stollwurms ha sido como clavar un cuchillo de untar en un cesto de víboras. Pelearon como algo de otro mundo, siseando, escupiendo y mordiendo, pero no fueron rivales para la determinación y la destreza de %companyname%. Mandas a los hombres escalpar y desollar a las criaturas y prepararlo todo para volver con %employer% y cobrar una paga bien merecida. | Los stollwurms yacen destrozados, y bien merecido lo tienen. Tu compañía se dedica a pinchar los cadáveres desde lejos para asegurarse de que esos cabrones están muertos de verdad. Algunos gorgotean y se dan la vuelta, pero esa es prácticamente su última señal de vida. Ordenas escalpar y desollar a esos lagartos crecidos de más. Al fin y al cabo, %employer% esperará pruebas. | Te agachas junto a un stollwurm y le pasas la mano por la piel. Según calculas, las escamas son lo bastante largas y afiladas como para cortarte los dedos si los metes entre las cuñas. Luego te plantas en jarras sobre la cabeza y escudriñas sus fauces, midiéndole los dientes con las manos y el gaznate con el acero de tu espada. %randombrother% se acerca y pregunta qué hacen ahora. Sacas la espada de la garganta del stollwurm, la limpias y la envainas como es debido. Ordenas a los hombres que desuellen a algunas de las bestias y se preparen para volver con %employer%. | Terminada la batalla, mandas desollar y destripar a los stollwurms en busca de cualquier cosa de valor. No tarda el campo en apestar a lagarto, mientras despojan a esos reptiles desmesurados de las escamas que antes los protegían. Con su musculatura enfermiza y reluciente a la vista de todos, una desnudez y una vulnerabilidad se ciernen sobre los que fueron y siempre serán monstruos. %randombrother% resopla y se pasa la manga por debajo de la nariz. Asiente ante su obra.%SPEECH_ON%Nada más que una criatura corriente, solo que un poco más grande de lo que debería.%SPEECH_OFF%Ya lo creo, maldita sea. Ordenas a los hombres que recojan lo que tengan y se preparen para volver con %employer%.}"
    }
    // en = "We did it."
    // en base_es
    // context: legend_hunting_stollwurms_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "monedas de oro" por "crowns" (coronas, dos veces); omitía "scaly, scraping" en la descripción de la piel; "los repugnantes lagartos" rebajaba "the lizard bastards"; "como prometi" es errata de "prometí"; "mis gallinas y si no los devuelve" no concordaba; "Se voltea" es regional (se gira).
        en = "[img]gfx/ui/events/event_77.png[/img]{You enter %employer%'s room dragging in some stollwurm flesh. He looks up from his desk, eyes the scales and long sleeve of reptilian skin, glances at you, then glances at his paymaster and gives a steady nod. The paymaster takes a satchel of crowns and hands them over. %employer% returns to his work, addressing you as he writes with a quill.%SPEECH_ON%Good work, sellsword. Reports of the bastards has died off in total, so I wager our money here has been put to good use. Leave the skin. I've a man who can fix up some mean boots with it.%SPEECH_OFF%Did the %companyname% just work to get this fool new boots? You shake your head and make your leave. | %employer% welcomes you and your booty, a long, scratchy, scaly, scraping piece of stollwurm skin. You heave it across the floor where it skitters like a stiff leather jacket. The mayor nods.%SPEECH_ON%Very, very well done, good sir! Most excellent. Your pay, as promised.%SPEECH_OFF%The man hands you a satchel heavy with well earned crowns. | %employer% is found warming himself beside a fire. He turns around in the seat to see the stollwurm flesh you have brought in with you. The mayor nods.%SPEECH_ON%Quite alright work, sellsword. I'm curious, do the lizard bastards grow their limbs back? I've heard tales of the reptilian sort carrying such tricks.%SPEECH_OFF%You shrug and state each creature was slain with as much scientific curiosity a good sword can muster. %employer% purses his lips.%SPEECH_ON%Ah. Right. Well your pay is in the corner there, as much as agreed upon.%SPEECH_OFF%He returns to the fire, cozying himself up in a blanket and sipping at the lip of a steamy mug. | %employer% found outside and surrounded by raucous peasants. You yell over the crowd and display the stollwurm skin which you've brought. The crowd quiets for a moment, whispers amongst its numbers, then returns to shouting. You purse your lips and elbow your way into the mob and demand the pay which you are owed. %employer% yells at the peons to spread out and let him breathe. While two guards stand close, he hands you a leather satchel.%SPEECH_ON%Good work, sellsword. If it ain't all there feel free to come back and kill me. I won't mind, not on this damned day.%SPEECH_OFF%As you take the satchel and leave, a peasant jabs his finger at the mayor.%SPEECH_ON%Tellin' ya, that damned bastard, my supposed 'neighborly neighbor', stole my birds and if he don't return them I'mma burn his whole farm to the farkin' ground!%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_77.png[/img]{Entras en la habitación de %employer% arrastrando un pedazo de carne de stollwurm. Levanta la mirada de su escritorio, observa las escamas y la larga manga de piel de reptil, te mira a ti y luego mira a su tesorero, asintiendo con firmeza. El tesorero toma una bolsa de coronas y te la entrega. %employer% vuelve a su trabajo y te habla mientras escribe con una pluma.%SPEECH_ON%Buen trabajo, mercenario. Los informes sobre esos desgraciados han cesado por completo, así que apuesto a que nuestro dinero ha sido bien empleado. Deja la piel. Tengo un hombre que puede hacer unas botas de primera con ella.%SPEECH_OFF%¿Acaso %companyname% acaba de trabajar para conseguirle botas nuevas a este necio? Sacudes la cabeza y te marchas. | %employer% te da la bienvenida junto con tu botín, un trozo largo, áspero, escamoso y rasposo de piel de stollwurm. Lo arrojas por el suelo, donde se desliza como una rígida chaqueta de cuero. El alcalde asiente.%SPEECH_ON%¡Muy, muy bien hecho, buen señor! Excelente. Aquí está tu pago, como prometí.%SPEECH_OFF%El hombre te entrega una bolsa cargada de coronas bien merecidas. | Encuentras a %employer% calentándose junto a una hoguera. Se gira en el asiento para ver la carne de stollwurm que has traído contigo. El alcalde asiente.%SPEECH_ON%Un trabajo bastante bueno, mercenario. Tengo curiosidad: ¿a esos cabrones de lagartos les vuelven a crecer las extremidades? He oído historias de reptiles capaces de esos trucos.%SPEECH_OFF%Te encoges de hombros y le dices que cada criatura fue abatida con toda la curiosidad científica que puede reunir una buena espada. %employer% frunce los labios.%SPEECH_ON%Ah. Claro. Bueno, tu pago está ahí en el rincón, todo lo acordado.%SPEECH_OFF%Vuelve junto al fuego, se arrebuja en una manta y sorbe del borde de una taza humeante. | Encuentras a %employer% fuera, rodeado de campesinos alborotados. Gritas por encima de la multitud y muestras la piel de stollwurm que has traído. La multitud se calla un momento, cuchichea entre sí y luego vuelve a gritar. Frunces los labios, te abres paso a codazos entre el gentío y exiges el pago que se te debe. %employer% les grita a los campesinos que se aparten y lo dejen respirar. Con dos guardias cerca, te entrega una bolsa de cuero.%SPEECH_ON%Buen trabajo, mercenario. Si no está todo, siéntete libre de volver y matarme. No me importará, no en este maldito día.%SPEECH_OFF%Mientras tomas la bolsa y te marchas, un campesino señala al alcalde con el dedo.%SPEECH_ON%¡Te lo digo, ese maldito desgraciado, mi supuesto 'vecino tan buen vecino', me robó las gallinas y si no me las devuelve le voy a quemar toda su maldita granja hasta los cimientos!%SPEECH_OFF%}"
    }
    // context: legend_hunting_stollwurms_contract.createScreens.m.Screens.push().Options.getResult.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation()
    {
        en = "Rid the town of stollwurms"
        es = "Libró al pueblo de stollwurms"
    }
    // context: legend_hunting_stollwurms_contract.createScreens.m.Screens.push().Options.getResult.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation()
    {
        en = "Hero of the land"
        es = "Héroe de estas tierras"
    }
    // context: legend_hunting_stollwurms_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "más vieja que el demonio" rebajaba "old as shite" y no concordaba con "traje"; "lagartos destrozando las tierras fronterizas" rebajaba "tearing the hinterlands a new arshole" (y "hinterlands" no son fronteras); "emboscarte" omitía "your arse"; "esta ciudad" por "this town" (pueblo).
        en = "[img]gfx/ui/events/event_43.png[/img]{You find %employer% in his room and it is full of guards. Not sure what is going on, you display the stollwurm's flesh to the mayor and demand your pay. His fingers clap together before fanning forward like a lumber saw.%SPEECH_ON%I don't think that will be happening, sellsword. I don't know where you got that goddam skinsuit you're carrying, and trust me I can tell it's old as shite and not some new flay, but I'm still getting reports of lizards tearing the hinterlands a new arshole so if you don't mind, please kindly leave this town before I sic a whole different predator upon ya.%SPEECH_OFF%Taking a deep breath, you eye the guards. There's too many to fight off. %employer% sighs.%SPEECH_ON%If it's your honor you're thinking to protect, don't. I already talked these folks down from ambushing your arse the second you were to walk through that door. I did that out of little respect I have left. Don't waste it, hm?%SPEECH_OFF%Fair enough. It is what it is and you've no one else to blame but yourself anyhow. You close the door and take your leave.}"
        es = "[img]gfx/ui/events/event_43.png[/img]{Encuentras a %employer% en su habitación, que está llena de guardias. Sin saber muy bien qué está pasando, le muestras la piel del stollwurm al alcalde y exiges tu pago. Junta los dedos de golpe y luego los abre en abanico como una sierra de leñador.%SPEECH_ON%No creo que eso vaya a pasar, mercenario. No sé de dónde sacaste ese maldito traje de piel que llevas, y créeme que sé distinguir que es más viejo que la mierda y no un desollado reciente, pero sigo recibiendo informes de lagartos que le están abriendo un culo nuevo a la comarca, así que, si no te importa, ten la amabilidad de largarte de este pueblo antes de que te suelte encima a un depredador muy distinto.%SPEECH_OFF%Respiras hondo y echas un vistazo a los guardias. Son demasiados para enfrentarte a ellos. %employer% suspira.%SPEECH_ON%Si estás pensando en defender tu honor, no lo hagas. Ya convencí a esta gente de no tenderte una emboscada en cuanto asomaras el culo por esa puerta. Lo hice por el poco respeto que me queda. No lo desperdicies, ¿eh?%SPEECH_OFF%Está bien. Es lo que hay y, de todos modos, no tienes a nadie a quien culpar salvo a ti. Cierras la puerta y te marchas.}"
    }
    // en = "Not entirely surprising."
    // en base_es
    // en = "Tried to swindle the town out of money"
    // en base_es
    // context: legend_hunting_stollwurms_contract.spawnEnemies.party.setDescription()
    {
        en = "A Stollwurm - a burrowing bipedal dragon resembling a giant snake."
        es = "Un Stollwurm: un dragón bípedo excavador que parece una serpiente gigante."
    }
    // en = "bribe"
    // FILE: scripts\contracts\contracts\legend_hunting_white_direwolf_contract.nut
    // context: legend_hunting_white_direwolf_contract.create.m.Name
    {
        en = "Hunting the white wolf (Legendary)"
        es = "Cazando al lobo blanco (Legendario)"
    }
    // context: legend_hunting_white_direwolf_contract.create.m.DescriptionTemplates
    {
        en = "Northern tribal folklore speaks of the White Wolves, beings of pure malice who will one day devour both men and gods alike."
        es = "El folclore de las tribus del norte habla de los Lobos Blancos, seres de pura malicia que algún día devorarán por igual a hombres y dioses."
    }
    // context: legend_hunting_white_direwolf_contract.create.m.DescriptionTemplates
    {
        en = "Many consider white wolves to be myth, a campfire tale of the supernatural to scare new travelers with."
        es = "Muchos consideran que los lobos blancos son un mito, un cuento sobrenatural de los que se cuentan junto al fuego para asustar a los viajeros novatos."
    }
    // context: legend_hunting_white_direwolf_contract.create.m.DescriptionTemplates
    {
        en = "In traditional folklore tales, white wolves are always supernatural beings who herald doom."
        es = "En los cuentos del folclore tradicional, los lobos blancos son siempre seres sobrenaturales que anuncian la perdición."
    }
    // context: legend_hunting_white_direwolf_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        // "Hunt down the White Wolf around " + this.Contract.m.Home.getName()
        mode = "pattern"
        en = "Hunt down the White Wolf around <town:str>"
        es = "Da caza al Lobo Blanco en los alrededores de <town>"
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_31.png[/img]{When you arrive at %employer%'s keep the sky is dark and the mood is ominous, you hear howling in the distance. The populace is on edge and everyone keeps looking over their shoulders for an unseen assailant.%SPEECH_ON%Thank the gods you came!%SPEECH_OFF% A booming voice echoes around the courtyard and a man in resplendent finery claps his hands together as he shuffles down the stairs towards you %SPEECH_ON%The wolves are at our door, without a word of a lie. They grow bolder by the day, just this morning one crept into the town and took off with a toddler. Her mother is distraught and the villagers are terrified, they demanded I do something. I have already sent half my men out, but only a handful have returned, each burdened with having seen their friends feasted upon.%SPEECH_OFF% %employer% quietens his voice, only now realising the whole town is listening in. %SPEECH_ON%I know you have fought wolves before sellsword, but these are different. They are led by the king of the wolves, the legendary white wolf himself. He is huge, vicious, and cunning beyond measure. Each week he gathers more wolf packs under his rule, driving them into a rabid fervor while orchestrating their campaign of terror. %SPEECH_OFF% %employer% looks around sheepishly, as if scared his words are about to manifest in flesh. %SPEECH_ON% A task like this can not be entered into lightly, others have tried and failed, the reward has grown large. If you should succeed, you will be rich my friend. Are you up to the deed?%SPEECH_OFF% }"
        es = "[img]gfx/ui/events/event_31.png[/img]{Cuando llegas a la fortaleza de %employer%, el cielo está oscuro y el ambiente es ominoso; oyes aullidos a lo lejos. La gente está con los nervios de punta y todos miran sin cesar por encima del hombro en busca de un agresor invisible.%SPEECH_ON%¡Gracias a los dioses que has venido!%SPEECH_OFF% Una voz atronadora resuena por el patio y un hombre con galas resplandecientes da una palmada mientras baja las escaleras hacia ti arrastrando los pies %SPEECH_ON%Los lobos están a nuestras puertas, y no miento. Cada día son más osados; esta misma mañana uno se coló en el pueblo y se llevó a una niña pequeña. Su madre está desconsolada y los aldeanos, aterrados, me exigieron que hiciera algo. Ya he enviado a la mitad de mis hombres, pero solo han vuelto unos pocos, y todos cargan con haber visto cómo devoraban a sus amigos.%SPEECH_OFF% %employer% baja la voz, dándose cuenta solo ahora de que todo el pueblo está escuchando. %SPEECH_ON%Sé que ya has luchado contra lobos, mercenario, pero estos son distintos. Los guía el rey de los lobos, el mismísimo y legendario lobo blanco. Es enorme, feroz y astuto sin medida. Cada semana reúne más manadas bajo su dominio, las arrastra a un fervor rabioso y dirige su campaña de terror. %SPEECH_OFF% %employer% mira a su alrededor con apuro, como si temiera que sus palabras fueran a hacerse carne. %SPEECH_ON% Una tarea así no puede tomarse a la ligera; otros lo han intentado y han fracasado, y la recompensa ha crecido mucho. Si lo logras, nadarás en oro, amigo mío. ¿Estás a la altura?%SPEECH_OFF% }"
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{Fighting the king of the wolves won't come cheap. | The %companyname% can help for the right price. | How many crowns are we talking about? | How large is the reward?}"
        es = "{Luchar contra el rey de los lobos no te saldrá barato. | %companyname% puede ayudar por el precio justo. | ¿De cuántas coronas estamos hablando? | ¿Cómo de grande es la recompensa?}"
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{This doesn't sound like our kind of work. | This won't be worth the risk. | I won't go off to die like the others}"
        es = "{Esto no parece nuestro tipo de trabajo. | No valdrá la pena correr el riesgo. | No pienso ir a morir como los demás}"
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_75.png[/img]{%randombrother% has been intently scanning for tracks, with an urgency you cannot place. At last he speaks %SPEECH_ON% My grandmother told me stories of the Wolf King when I was a child. She said he is half human from eating human brains, he walks on two legs, wears armor and even understand speech. It was meant to make me do my chores, but it only ever gave me nightmares. He can't be real, can he? %SPEECH_OFF%.}"
        es = "[img]gfx/ui/events/event_75.png[/img]{%randombrother% lleva un buen rato buscando huellas con atención, con una urgencia que no sabes explicarte. Por fin habla %SPEECH_ON% Mi abuela me contaba historias del Rey Lobo en mi infancia. Decía que es medio humano de tanto comer sesos humanos, que camina sobre dos patas, lleva armadura y hasta entiende lo que se habla. Era para que hiciera mis tareas, pero solo me daba pesadillas. No puede ser real, ¿verdad? %SPEECH_OFF%.}"
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "We are about to find out."
        es = "Estamos a punto de averiguarlo."
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_white_wolf.png[/img]{You stop in your tracks, the hairs on the back of your neck bristling. You feel something watching you and turn to see wolves emerging from the tree line at full charge. The Wolf King has found you. }"
        es = "[img]gfx/ui/events/legend_white_wolf.png[/img]{Te detienes en seco, con el vello de la nuca erizado. Sientes que algo te observa y te giras para ver a los lobos salir de la linde del bosque a la carga. El Rey Lobo te ha encontrado. }"
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().Text
    {
        // Text = "[img]gfx/ui/events/legend_white_wolf.png[/img]{Tracking quietly you come over a small hill and look down on a large group of wolves in a clearing. The wind is on your face, so they have not caught your sent. You crouch low and creep forward to get a better view. To your amazement you see two white wolves. Each is leading a pack, and they are arrayed on either side of the clearing, with the two leaders in the middle. It appears as if some kind of parlay is underway, played out in a complex series of movements, growls and sniffs. Their stances feel as if they may start fighting at any moment, but then after one last sniff they face up, and to your amazement they bow to each other. With that the show is over, and one of the packs turns and leaves.  No sooner has the second pack left, than you notice %shouter% walking down the hill in front of you calmly and deliberately, making no attempt to hide and looking straight at the White Wolf.  }",
        mode = "pattern"
        en = "[img]gfx/ui/events/legend_white_wolf.png[/img]{Tracking quietly you come over a small hill and look down on a large group of wolves in a clearing. The wind is on your face, so they have not caught your sent. You crouch low and creep forward to get a better view. To your amazement you see two white wolves. Each is leading a pack, and they are arrayed on either side of the clearing, with the two leaders in the middle. It appears as if some kind of parlay is underway, played out in a complex series of movements, growls and sniffs. Their stances feel as if they may start fighting at any moment, but then after one last sniff they face up, and to your amazement they bow to each other. With that the show is over, and one of the packs turns and leaves.  No sooner has the second pack left, than you notice %shouter% walking down the hill in front of you calmly and deliberately, making no attempt to hide and looking straight at the White Wolf.  }"
        es = "[img]gfx/ui/events/legend_white_wolf.png[/img]{Siguiendo el rastro en silencio, coronas una pequeña colina y ves abajo un gran grupo de lobos en un claro. Tienes el viento de cara, así que no han captado tu olor. Te agachas y avanzas con sigilo para ver mejor. Para tu asombro, ves dos lobos blancos. Cada uno encabeza una manada, desplegadas a ambos lados del claro, con los dos líderes en el centro. Parece que se está celebrando una especie de parlamento, que se desarrolla en una compleja serie de movimientos, gruñidos y olfateos. Por sus posturas, da la impresión de que podrían empezar a pelear en cualquier momento, pero tras un último olfateo se encaran y, para tu asombro, se inclinan el uno ante el otro. Con eso termina el espectáculo, y una de las manadas da media vuelta y se marcha.  En cuanto la segunda manada se ha ido, ves a %shouter% bajar la colina delante de ti con calma y determinación, sin intentar esconderse y mirando fijamente al Lobo Blanco.  }"
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().Options.Text
    {
        // Text = "%shouter% knows how to handle this.",
        mode = "pattern"
        en = "%shouter% knows how to handle this."
        es = "%shouter% sabe cómo manejar esto."
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().Text
    {
        // Text = "[img]gfx/ui/events/legend_white_wolf.png[/img]{Against your better judgment, you let it play out. %shouter% reaches the clearing and then bows down to the ground in front of the white wolf. Unbelievably the white wolf bows as well and the two of them begin growling and sniffing each other. %shouter% lets out a series of crooning hums, like a drawn out melodic growl that seems to entrance the wolves. %shouter% uses the moment of calm to do the most foolhardy thing you have ever seen. %shouter% drops trousers and pisses onto the head of the white wolf. In that moment the whole scene changes, the white wolf rolls onto its back and wimpers, and the rest of the pack turn and disapear into the woods.  }",
        mode = "pattern"
        en = "[img]gfx/ui/events/legend_white_wolf.png[/img]{Against your better judgment, you let it play out. %shouter% reaches the clearing and then bows down to the ground in front of the white wolf. Unbelievably the white wolf bows as well and the two of them begin growling and sniffing each other. %shouter% lets out a series of crooning hums, like a drawn out melodic growl that seems to entrance the wolves. %shouter% uses the moment of calm to do the most foolhardy thing you have ever seen. %shouter% drops trousers and pisses onto the head of the white wolf. In that moment the whole scene changes, the white wolf rolls onto its back and wimpers, and the rest of the pack turn and disapear into the woods.  }"
        es = "[img]gfx/ui/events/legend_white_wolf.png[/img]{En contra de tu buen juicio, dejas que la cosa siga su curso. %shouter% llega al claro y se inclina hasta el suelo ante el lobo blanco. Increíblemente, el lobo blanco también se inclina y los dos empiezan a gruñirse y a olfatearse. %shouter% suelta una serie de canturreos, como un gruñido melódico y prolongado que parece hechizar a los lobos. %shouter% aprovecha el momento de calma para hacer la mayor temeridad que has visto nunca. %shouter% se baja los pantalones y le mea en la cabeza al lobo blanco. En ese instante cambia toda la escena: el lobo blanco se tumba panza arriba gimoteando y el resto de la manada da media vuelta y desaparece en el bosque.  }"
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "We still need to catch the other wolf"
        es = "Aún tenemos que atrapar al otro lobo"
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().start.Contract.m.Dude.improveMood()
    {
        en = "Managed to tame a white wolf"
        es = "Se las ingenió para domesticar a un lobo blanco"
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().Text
    {
        // Text = "[img]gfx/ui/events/legend_white_wolf.png[/img]{Against your better judgment, you let it play out. %shouter% reaches the edge of the clearing and begins to make some bizarre crooning noises like an injured dog. The white wolf tilts it\'s head for a moment quizically, before letting out a howl and charging towards %shouter%. The wolf grabs %shouter% in its jaws, shakes them viciously before throwing shouter back towards the wolves. If that weren\'t bad enough, just then you notice the other wolf pack returning, it looks like you\'ll be fighting two wolf kings. }",
        mode = "pattern"
        en = "[img]gfx/ui/events/legend_white_wolf.png[/img]{Against your better judgment, you let it play out. %shouter% reaches the edge of the clearing and begins to make some bizarre crooning noises like an injured dog. The white wolf tilts it's head for a moment quizically, before letting out a howl and charging towards %shouter%. The wolf grabs %shouter% in its jaws, shakes them viciously before throwing shouter back towards the wolves. If that weren't bad enough, just then you notice the other wolf pack returning, it looks like you'll be fighting two wolf kings. }"
        es = "[img]gfx/ui/events/legend_white_wolf.png[/img]{En contra de tu buen juicio, dejas que la cosa siga su curso. %shouter% llega al borde del claro y empieza a emitir unos extraños canturreos, como de perro herido. El lobo blanco ladea la cabeza un momento con curiosidad, antes de soltar un aullido y lanzarse a la carga contra %shouter%. El lobo atrapa a %shouter% entre las fauces, le propina unas sacudidas feroces y luego arroja a su presa de vuelta hacia los lobos. Por si fuera poco, justo entonces ves que la otra manada regresa: parece que vas a tener que luchar contra dos reyes lobo. }"
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().start.Contract.m.Dude.worsenMood()
    {
        en = "Failed to sing to the wolves"
        es = "No logró cantarles a los lobos"
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_white_wolf_dead.png[/img]{The white wolf lays mangled, upon a pile of wolf carcasses. You begin skinning the body, that head will make a lovely hat.}"
        es = "[img]gfx/ui/events/legend_white_wolf_dead.png[/img]{El lobo blanco yace destrozado sobre un montón de cadáveres de lobo. Empiezas a desollar el cuerpo: esa cabeza dará para un sombrero precioso.}"
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_white_wolf_dead.png[/img]{With the beasts slain, you take a moment to rest. One of your mercenaries asks you: %SPEECH_ON%So if you just killed the king of the wolves, does that make you the new king?%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/legend_white_wolf_dead.png[/img]{Con las bestias abatidas, te tomas un momento para descansar. Uno de tus mercenarios te pregunta: %SPEECH_ON%Entonces, si acabas de matar al rey de los lobos, ¿eso te convierte en el nuevo rey?%SPEECH_OFF%}"
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "If only it worked that way"
        es = "Ojalá funcionara así"
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_31.png[/img]{%employer% seems surprised when you return. %SPEECH_ON%Could it be? Have you slain the White Wolf? %SPEECH_OFF%  You show him the bloody wolf pelt and he stares in disbelief.  %SPEECH_ON% The reign of terror is over! This demands a celebration! Tonight, for the first time in many moons, we shall drink and be merry! %SPEECH_OFF%  He gestures to his servants who cheer as one, then begin tending to your wounds, bringing over drinks, food, and a small chest full of crowns. }"
        es = "[img]gfx/ui/events/event_31.png[/img]{%employer% parece sorprendido cuando regresas. %SPEECH_ON%¿Será posible? ¿Has matado al Lobo Blanco? %SPEECH_OFF%  Le muestras la piel ensangrentada del lobo y se te queda mirando sin dar crédito.  %SPEECH_ON% ¡El reinado del terror ha terminado! ¡Esto hay que celebrarlo! ¡Esta noche, por primera vez en muchas lunas, beberemos y nos divertiremos! %SPEECH_OFF%  Hace una seña a sus sirvientes, que vitorean al unísono y luego empiezan a curarte las heridas y a traerte bebida, comida y un pequeño cofre lleno de coronas. }"
    }
    // context: legend_hunting_white_direwolf_contract.createScreens.m.Screens.push().Options.getResult.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation()
    {
        en = "Rid the town of the white wolf"
        es = "Libró al pueblo del lobo blanco"
    }
    // context: legend_hunting_white_direwolf_contract.spawnEnemies.party.World.FactionManager.getFactionOfType(this.Const.FactionType.Beasts).spawnEntity()
    {
        en = "White Wolf Pack"
        es = "Manada del Lobo Blanco"
    }
    // context: legend_hunting_white_direwolf_contract.spawnEnemies.party.setDescription()
    {
        en = "The wolf pack of the legendary White Wolf."
        es = "La manada del legendario Lobo Blanco."
    }
    // FILE: scripts\contracts\contracts\legend_preemptive_beasts_contract.nut
    // context: legend_preemptive_beasts_contract.create.m.Name
    {
        en = "Taking Action"
        es = "Pasar a la acción"
    }
    // context: legend_preemptive_beasts_contract.create.m.DescriptionTemplates
    {
        en = "Fell beasts have been spotted roaming the hills. The frightened locals are demanding action before attacks occur."
        es = "Se han avistado bestias terribles merodeando por las colinas. Los lugareños, asustados, exigen que se actúe antes de que ataquen."
    }
    // context: legend_preemptive_beasts_contract.create.m.DescriptionTemplates
    {
        en = "Amidst the rolling hills, fell beasts lurk in the darkness, their eyes glowing like embers in the night."
        es = "Entre las colinas ondulantes, bestias terribles acechan en la oscuridad, con los ojos brillando como brasas en la noche."
    }
    // context: legend_preemptive_beasts_contract.create.m.DescriptionTemplates
    {
        en = "The hills are alive with the haunting cries of fell beasts, their sinister forms weaving through the moonlight."
        es = "Las colinas resuenan con los gritos inquietantes de bestias terribles, cuyas siluetas siniestras serpentean bajo la luz de la luna."
    }
    // context: legend_preemptive_beasts_contract.create.m.DescriptionTemplates
    {
        en = "Fear grips the hearts of villagers as fell beasts are sighted circling ominously on the mist-covered hills."
        es = "El miedo atenaza el corazón de los aldeanos desde que se avistaron bestias terribles rondando de forma ominosa por las colinas cubiertas de niebla."
    }
    // context: legend_preemptive_beasts_contract.create.m.DescriptionTemplates
    {
        en = "Track and exterminate the deadly beasts allegedly prowling the local hills and valleys."
        es = "Rastrea y extermina a las bestias mortíferas que, según dicen, merodean por las colinas y los valles de la zona."
    }
    // context: legend_preemptive_beasts_contract.create.m.DescriptionTemplates
    {
        en = "'Big as an 'orse! Wit sharp teef! Five eyez! Sp'licky as a jabber!' - The peasant reports are nonsense, but something is clearly out there."
        es = "'¡Grande como un cabayo! ¡Con dientes afilaos! ¡Cinco ojoz! ¡Pinchúo como un cardo!' - Los relatos de los campesinos no tienen ni pies ni cabeza, pero está claro que ahí afuera hay algo."
    }
    // context: legend_preemptive_beasts_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        // "Hunt down the beasts spotted near " + this.Contract.m.Home.getName()
        mode = "pattern"
        en = "Hunt down the beasts spotted near <town:str>"
        es = "Caza a las bestias avistadas cerca de <town>"
    }
    // context: legend_preemptive_beasts_contract.createStates.m.States.push().update.Contract.setScreen()
    // en = "Poachers1"
    // identificador de pantalla
    // en = "Humans"
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_43.png[/img]{%employer% greets you with a worried expression on %their_employer% face.%SPEECH_ON%I'm glad you're here, sellsword. We've been receiving reports of dangerous beasts appearing around the outskirts of our town.%SPEECH_OFF%You look around you, noticing the townsfolk going about their business completely oblivious to the precarious situation their lives are in.%SPEECH_ON%Thankfully, nothing terrible has happened... yet. With your help, we can make sure that it stays that way.%SPEECH_OFF% | %SPEECH_ON%Oi, sellsword! Come, quickly!%SPEECH_OFF%%employer% beckons to you, %their_employer% voice in hushed and hurried tones. You note the urgency in %their_employer% tone as you follow %them_employer% around an isolated corner. %They_employer% looks around agitatedly, as if to ensure you are alone. Preparing for the worst, you reach for your weapon - a move which immediately alarms %them_employer%.%SPEECH_ON%Stop! What are you doing?%SPEECH_OFF%You reply that you'd ask the same of them.%SPEECH_ON%I needed to speak with you in private. Now put that thing away before one of us gets hurt!%SPEECH_OFF%You raise an eyebrow as you rest your hand on the hilt of your weapon, wondering almost out loud just who exactly would be hurt. %employer% barely notices.%SPEECH_ON%Dangerous beasts have been spotted outside of town. Most folks in this town are blissfully unaware of it so far, and I would like to keep it that way. I want you to hunt these beasts down before they cause any trouble.%SPEECH_OFF% | You are greeted by %employer%, who cuts to the chase.%SPEECH_ON%A few days ago, some children claimed they heard strange sounds while they were playing near the edge of town. I had my guards investigate, and they came back saying they found monstrous tracks in the vicinity.%SPEECH_OFF%You turn to look at the guards. One of them is lazily leaning into a makeshift polearm in a manner that makes you fear for the safety of their right eye. Another is staring in awe at %randombrother%, dreamily confessing their desire to become a hero like %them_randombrother% someday. You refocus your attention on %employer%.%SPEECH_ON%Frankly, I wouldn't trust even my dog's life to any of my guards. I want you to head out and kill these beasts before they cause any trouble for us, you hear?%SPEECH_OFF%Before %they_employer% could finish %their_employer% sentence, the guard who was resting against their polearm fell asleep standing, tipping over and stabbing the other guard who was fawning over %randombrother% in their left buttock. The %companyname% will never be left wanting for work in this town, it seems.}"
        es = "[img]gfx/ui/events/event_43.png[/img]{%employer% te recibe con el rostro preocupado.%SPEECH_ON%Me alegra que estés aquí, mercenario. Nos llegan noticias de bestias peligrosas que aparecen en las afueras del pueblo.%SPEECH_OFF%Miras a tu alrededor y ves a los vecinos ocupados en sus asuntos, completamente ajenos a lo precaria que es su situación.%SPEECH_ON%Por suerte, no ha pasado nada terrible... aún. Con tu ayuda, podemos asegurarnos de que siga así.%SPEECH_OFF% | %SPEECH_ON%¡Eh, mercenario! ¡Ven, rápido!%SPEECH_OFF%%employer% te hace señas y te habla en voz baja y apresurada. Notas la urgencia en su tono mientras %lo_employer% sigues hasta una esquina apartada. Mira a su alrededor con nerviosismo, como para asegurarse de que están solos. Preparándote para lo peor, llevas la mano al arma, un gesto que %lo_employer% alarma al instante.%SPEECH_ON%¡Alto! ¿Qué haces?%SPEECH_OFF%Le respondes que eso mismo podrías preguntarle tú.%SPEECH_ON%Necesitaba hablar contigo en privado. ¡Ahora guarda eso antes de que alguien salga herido!%SPEECH_OFF%Arqueas una ceja y apoyas la mano en la empuñadura del arma, preguntándote casi en voz alta quién saldría herido exactamente. %employer% apenas se da cuenta.%SPEECH_ON%Se han avistado bestias peligrosas fuera del pueblo. Por suerte, casi nadie aquí lo sabe todavía, y me gustaría que siguiera así. Quiero que des caza a esas bestias antes de que causen problemas.%SPEECH_OFF% | Te recibe %employer%, que va directo al grano.%SPEECH_ON%Hace unos días, unos niños dijeron haber oído ruidos extraños mientras jugaban cerca de las afueras del pueblo. Mandé a mis guardias a investigar y volvieron diciendo que habían encontrado huellas monstruosas por los alrededores.%SPEECH_OFF%Te vuelves para mirar a los guardias. Uno se apoya con desgana en un arma de asta improvisada, de una forma que te hace temer por su ojo derecho. Otro mira con embeleso a %randombrother% y confiesa, con aire soñador, que algún día quiere llegar a ser una leyenda como %el_randombrother%. Vuelves a centrar tu atención en %employer%.%SPEECH_ON%Francamente, no le confiaría a ninguno de mis guardias ni la vida de mi perro. Quiero que salgas y mates a esas bestias antes de que nos den problemas, ¿me oyes?%SPEECH_OFF%Antes de que termine la frase, el guardia que se apoyaba en el arma de asta se queda dormido de pie, se cae y le clava el arma en la nalga izquierda al que miraba con embeleso a %randombrother%. Por lo visto, a la %companyname% nunca le faltará trabajo en este pueblo.}"
    }
    // en = "\x7bWhat's this worth to you? | What is %townname% prepared to pay? | Let's talk pay.\x7d"
    // en base_es
    // en = "\x7bThis doesn't sound like our kind of work. | I wish you luck, but we'll not be part of this.\x7d"
    // en base_es
    // en = "[img]gfx/ui/events/event_07.png[/img]\x7bThese aren't beasts at all, but men in wolf's clothing! Having seen the 'true' face of this evil, the men are quite relieved that your enemy is one they know all too well. | As you close in on the monsters, you realize that the foul creatures are not beasts at all, but humans in disguise! You know not why they played such a game of dress-up, but they're drawing weapons. As far as you're concerned, beast or man, they all die the same. | You stumble upon a man removing a wolf head off his shoulders. He glances at you, the disguise still in hand, then quickly puts it back on. You draw your sword.%SPEECH_ON%It's a little late to be playing pretend.%SPEECH_OFF%The slash of your weapon knocks the man's mask off and he stumbles backward. Before you can run him through, he takes off, sprinting toward a collection of similarly skulking fellow. They draw their weapons at the very sight of you. Whatever reason these idiots were playing dress up, it doesn't matter now. | You come across a dead beast with a few arrows stuck in its back. The damage does not seem lethal... and when you tip your sword across the creature's mane, the head tips right off, revealing a human beneath.%SPEECH_ON%Didja do that?%SPEECH_OFF%A voice breaks in from ahead. There stand a few men removing their disguises: that of the beasts you were after. The one in the lead raises his voice.%SPEECH_ON%Kill them! Kill them all!%SPEECH_OFF%Nope, these are still beasts, just of a softer sort.\x7d"
    // en base_es
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_126.png[/img]{%randombrother% calls out to the party, calling everyone to a halt.%SPEECH_ON%Tracks! I've found some strange-looking tracks!%SPEECH_OFF%The %companyname% gather around %them_randombrother% and attempt to identify the tracks. | You come across some tracks around the outskirts of %townname%. Thankfully, it seems the beasts have not struck yet. You take a closer look and try to make out what the tracks are. | As you scan your surroundings for signs of the beasts, you notice some tracks not too far off. You approach the tracks to take a closer look.}"
        es = "[img]gfx/ui/events/event_126.png[/img]{%randombrother% da una voz y hace que todos se detengan.%SPEECH_ON%¡Huellas! ¡He encontrado unas huellas muy raras!%SPEECH_OFF%La %companyname% se reúne a su alrededor e intenta identificar las huellas. | Encuentras unas huellas en las afueras de %townname%. Por suerte, parece que las bestias aún no han atacado. Te acercas para examinarlas e intentar averiguar de qué son. | Mientras buscas a tu alrededor señales de las bestias, ves unas huellas no muy lejos. Te acercas a ellas para mirarlas mejor.}"
    }
    // context: legend_preemptive_beasts_contract.onPrepareVariables.beasts
    // (Direwolves ya tiene par en el base: «Lobos huargo».)
    {
        en = "Ghouls"
        es = "Necrófagos"
    }
    // context: legend_preemptive_beasts_contract.onPrepareVariables.beasts
    {
        en = "Spiders"
        es = "Arañas"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{Be on your guard. It could be anything. | We'll find out what these beasts are soon enough. | Whatever these beasts are, they will meet their end soon.}"
        es = "{Estén en guardia. Podría ser cualquier cosa. | Pronto sabremos qué clase de bestias son. | Sean lo que sean, pronto les llegará su fin.}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start.Options.push().Text
    {
        // Text = "(Poacher) " + poacher.getName() + " can help us.",
        mode = "pattern"
        en = "(Poacher) <name:str> can help us."
        es = "(Cazador furtivo) <name> puede ayudarnos."
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start.Options.push().Text
    {
        // Text = "(Expert Hunter) " + expert.getName() + " has something to say.",
        mode = "pattern"
        en = "(Expert Hunter) <name:str> has something to say."
        es = "(Cazador experto) <name> tiene algo que decir."
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_126.png[/img]{%poacher% steps forward and takes a quick glance at the tracks.%SPEECH_ON%Aye, these must surely be the %beasts% that I saw the other day. Looking at these tracks, they must have headed to the %direction% of here.%SPEECH_OFF% | You turn to find %poacher%, who coincidentally just returned from a brief scouting trip. %They_poacher% hunches over the tracks, a wave of recognition immediately washing over %their_poacher% face.%SPEECH_ON%%beasts%! These are definitely the ones I just spotted as well. I saw them to the %direction% of here. If we hurry, perhaps we can catch them before they cause any harm.%SPEECH_OFF% | %SPEECH_ON%It's %beasts%, I'm sure of it.%SPEECH_OFF%Before you are able to take a closer look to confirm what %they_poacher% said, %poacher% is already walking off towards the %direction%. You quickly order the %companyname% to move out.}"
        es = "[img]gfx/ui/events/event_126.png[/img]{%poacher% da un paso al frente y echa un vistazo rápido a las huellas.%SPEECH_ON%Sí, seguro que son %beasts%, las mismas bestias que vi el otro día. Por estas huellas, han tenido que irse hacia el %direction%.%SPEECH_OFF% | Te das la vuelta y ves a %poacher%, que casualmente acaba de volver de una breve exploración. Se agacha sobre las huellas y en su cara se dibuja enseguida una expresión de reconocimiento.%SPEECH_ON%¡%beasts%! Sin duda son las mismas bestias que acabo de ver. Las vi al %direction% de aquí. Si nos damos prisa, quizá les demos alcance antes de que hagan daño.%SPEECH_OFF% | %SPEECH_ON%Son %beasts%, no me cabe duda.%SPEECH_OFF%Antes de que puedas acercarte a confirmar lo que ha dicho, %poacher% ya se aleja hacia el %direction%. Ordenas rápidamente a la %companyname% que se ponga en marcha.}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{Let's get moving then. | Be careful, %beasts% are dangerous. | We're not paid by the hour. Get moving! | These %beasts% are in for a nasty surprise.}"
        es = "{Pongámonos en marcha, entonces. | Cuidado: con %beasts% no se juega. | No nos pagan por horas. ¡En marcha! | A %beasts% les espera una sorpresa muy desagradable.}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_126.png[/img]{%experthunter% springs forward, and before you can stop %them_experthunter%, %they_experthunter% is already on all fours examining the tracks.%SPEECH_ON%Hmmm...%SPEECH_OFF%Wait a minute, is %they_experthunter% licking a piece of dirt from the tracks?%SPEECH_ON%Ah, yes. These must be %beasts% indeed.%SPEECH_OFF%Before you are able to ask %them_experthunter% how %they_experthunter% knows, %they_experthunter% gets up and points to the %direction%.%SPEECH_ON%They went that way. If we hurry, we can catch them before they hurt anyone.%SPEECH_OFF% | %experthunter% taps you on the shoulder from behind.%SPEECH_ON%It's %beasts%, boss. I saw them while I was scouting ahead.%SPEECH_OFF%You are about to ask when did %they_experthunter% even leave in the first place, but %they_experthunter% interrupts you.%SPEECH_ON%There's no time to waste. We should head towards the %direction% immediately if we want to make sure they don't cause any trouble.%SPEECH_OFF% | %SPEECH_ON%Those are definitely the tracks of %beasts% if I have ever seen them.%SPEECH_OFF%%experthunter% saunters over to your side and appears to be measuring the tracks with a stick. %They_experthunter% sniffs the air uncomfortably loudly.%SPEECH_ON%We should head %direction%. They can't be far now.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_126.png[/img]{%experthunter% se adelanta de un salto y, antes de que puedas detener%lo_experthunter%, ya está a cuatro patas examinando las huellas.%SPEECH_ON%Mmm...%SPEECH_OFF%Un momento, ¿está lamiendo un poco de tierra de las huellas?%SPEECH_ON%Ah, sí. Tienen que ser %beasts%, sin duda.%SPEECH_OFF%Antes de que puedas preguntarle cómo lo sabe, se levanta y señala hacia el %direction%.%SPEECH_ON%Se fueron por ahí. Si nos damos prisa, podemos darles alcance antes de que hagan daño a nadie.%SPEECH_OFF% | %experthunter% te da unos golpecitos en el hombro por detrás.%SPEECH_ON%Son %beasts%, jefe. Me topé con esas bestias mientras exploraba más adelante.%SPEECH_OFF%Estás a punto de preguntarle cuándo se había ido siquiera, pero te interrumpe.%SPEECH_ON%No hay tiempo que perder. Deberíamos ir hacia el %direction% de inmediato si queremos asegurarnos de que no causen problemas.%SPEECH_OFF% | %SPEECH_ON%Si alguna vez he visto huellas de %beasts%, son estas.%SPEECH_OFF%%experthunter% se acerca a tu lado con andar tranquilo y parece estar midiendo las huellas con un palo. Olfatea el aire tan fuerte que resulta incómodo.%SPEECH_ON%Deberíamos ir hacia el %direction%. Ya no pueden estar lejos.%SPEECH_OFF%}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{Let's go. | Good job. | Keep your eyes peeled.}"
        es = "{Vamos. | Buen trabajo. | Mantengan los ojos abiertos.}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start.Contract.m.ExpertHunter.improveMood()
    {
        en = "Experienced the thrill of the hunt"
        es = "Sintió la emoción de la caza"
    }
    // en = "[img]gfx/ui/events/event_56.png[/img]\x7bThe beasts slain, you order the men to take their pelts as evidence. Your employer, %employer%, should be most happy to see them. | Having killed the foul creatures, you begin skinning and scalping them. Gruesome creatures require gruesome evidence. Your employer, %employer%, might not believe your work here otherwise. | With the battle over, you have the men start collecting pelts to take back to %employer%, your employer. | Your employer, %employer%, might not believe what happened here without evidence. You order the men to begin taking pelts, trophies, scalps, whatever might show off your victory here.\x7d"
    // en base_es
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_22.png[/img]{Your mercenaries take the fools' disguises lest your employer, %employer%, not believe your doings here. | Your employer might not believe what was going on here. You order everyone to collect the disguises. %randombrother%, stripping a mask off one of the slain, starts to wonder.%SPEECH_ON%So they dressed themselves up as the sort of thing to attract us, and now they're all dead. I hope they didn't think it a game.%SPEECH_OFF%%randombrother2% cleans %their_randombrother2% blade in the folds of one of the disguises.%SPEECH_ON%Well, if it were a game, I sure enjoyed playing it.%SPEECH_OFF% | %randombrother% nods at the slain.%SPEECH_ON%It's mighty likely that %employer% wouldn't believe a group of brigands were dressing up as beasts.%SPEECH_OFF%Agreeing, you order everyone to begin collecting the masks and disguises as evidence. | You'll need evidence to show your employer, %employer%. These weren't the beasts you were looking for, but they do carry a lot of disguises that your employer would probably be most interested in seeing. One of your mercenaries wonders aloud.%SPEECH_ON%So what were they playing dress up for?%SPEECH_OFF%%randombrother2% folds some of the disguises over %their_randombrother2% arm as he goes about collecting them.%SPEECH_ON%Suicide by ceremony? Their dance and fun got our attention, after all.%SPEECH_OFF%%They_randombrother2% picks up one of the disguises only for the head of the dead to get slinged up with it. The sellsword laughs as %they_randombrother2% kicks the dead man's head out.}"
        es = "[img]gfx/ui/events/event_22.png[/img]{Tus mercenarios se llevan los disfraces de esos idiotas, no sea que %employer%, quien te contrató, no se crea lo que ha pasado aquí. | Puede que quien te contrató no se crea lo que ha pasado aquí. Ordenas a todos que recojan los disfraces. %randombrother%, mientras le arranca la máscara a uno de los muertos, se pone a cavilar.%SPEECH_ON%Así que se disfrazaron de lo que fuera que nos atrajera, y ahora están todos muertos. Espero que no se lo tomaran como un juego.%SPEECH_OFF%%randombrother2% limpia su hoja en los pliegues de uno de los disfraces.%SPEECH_ON%Bueno, si era un juego, a mí sí que me ha gustado jugarlo.%SPEECH_OFF% | %randombrother% señala a los muertos con la cabeza.%SPEECH_ON%Es muy probable que %employer% no se crea que unos bandidos se disfrazaban de bestias.%SPEECH_OFF%Le das la razón y ordenas a todos que empiecen a recoger las máscaras y los disfraces como prueba. | Necesitarás pruebas para enseñarle a tu empleador, %employer%. Estas no eran las bestias que buscabas, pero llevan un montón de disfraces que seguramente a tu empleador le interesará mucho ver. Uno de tus mercenarios se pregunta en voz alta:%SPEECH_ON%¿Y para qué jugaban a disfrazarse?%SPEECH_OFF%%randombrother2% va doblando algunos de los disfraces sobre el brazo mientras los recoge.%SPEECH_ON%¿Suicidio ceremonial? Al fin y al cabo, sus bailes y su jolgorio nos llamaron la atención.%SPEECH_OFF%Levanta uno de los disfraces y, con él, sale colgando la cabeza del muerto. Suelta una carcajada mientras se la quita de una patada.}"
    }
    // en = "[img]gfx/ui/events/event_123.png[/img]\x7bYou order your men to scour the field and collect as many parts as they can of the spiders. A few make the mistake of touching the hairs on the webknechts' legs, leaving them scratching quickly forming rashes. | The spiders litter the field like they would the corner of an attic. In death, they look like giant gloves stiffly clasped together. You have the men wrench the legs apart to harvest evidence of the bestial remains. | The mercenaries scour the field, hacking and sawing at the spiders' stiff remains to take back to %employer%. Even in death, the webknechts are ghastly, looking only a moment away from flinching back to life and wrapping themselves around the nearest breathing animal. Their horrifying features and surreal size does not stop some sellswords from dancing around, clicking their tongues and hissing, and all around preying upon the phobias of those less inclined to go near the damned things.\x7d"
    // en base_es
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Text
    {
        // corrige base: "Sus largas garras" traduce mal "limp claws": son garras inertes, no largas.
        // corrige base: "se merece el alivio de librarse de tales horrores" omite "you have given them": el respiro se lo ha dado el mercenario.
        // corrige base: "los tengo esperando afuera" no concuerda con "pruebas"/"bestias": "las tengo".
        // corrige base: "el concejal que probablemente te cruzaste" pierde la preposición: "un concejal con el que seguramente te cruzaste".
        // corrige base: "Debería saberlo, ¡este es mi trabajo!" no traduce "I should know, I am one!" (él también es gente común): "¡Bien lo sé yo, que soy uno de ellos!".
        // corrige base: "El vino esta bueno." no traduce "It's alright." y le falta la tilde a "está": "No está mal.".
        // corrige base: "están eternamente agradecidos" / "Muy agradecidos" no concuerdan con "personas": "agradecidas"; "Pesas las coronas" por "Sopesas" (weigh en la mano).
        // corrige base: "Suelta lo que has traído" cambia el sujeto: "You drop" es "Sueltas"; "de la terrible bestia" añade lo que el inglés no dice ("of beastly origin").
        // corrige base: "noticias de tus... batallas con las bestias" omite "of your doings" y cambia "monsters": "noticias de lo que has hecho... de tus batallas con los monstruos".
        // corrige base: "la gente de %townname%, aunque te teman, están bendecidos" no concuerda con "la gente": "aunque te tema, se siente bendecida".
        // corrige base: "Haces un encogimiento de hombros y lo lanzas" es un calco y no concuerda con "la piel": "Te encoges de hombros y la lanzas"; "coge" por "toma" (español neutro); "sentado en su mesa" por "a su mesa".
        // corrige base: "No, no lo hace." calca "No, it does not.": "No."; y sobra el espacio en "%SPEECH_OFF% %employer%".
        en = "[img]gfx/ui/events/event_04.png[/img]{You return to %employer% and lay one of the pelts clear across %their_employer% desk. Its limp claws rap against the side of the oak. The %person_employer% lifts one, then lets it fall again.%SPEECH_ON%I see you've found those beasts we were looking for.%SPEECH_OFF%You tell %them_employer% of the battle. %They_employer% seems most pleased, taking a small wooden chest out from %their_employer% bookshelf and handing it over.%SPEECH_ON%%reward_completion% crowns, as agreed upon. The people of %townname% deserve the reprieve you have given them from such horrors.%SPEECH_OFF% | When you step in %employer%'s room he recoils almost instantly.%SPEECH_ON%What in the hells of the gods is in your hand, sellsword?%SPEECH_OFF%You hold up the nape of a pelt. Black blood ropes out from the neck and splatters the floor.%SPEECH_ON%One of the beasts you were looking for. If you need evidence of the rest, I got those waiting outside...%SPEECH_OFF%The man holds his hand up, staying you.%SPEECH_ON%One is sufficient for my belief. Very good work, sellsword. Your pay will be with %randomname%, a councilman you probably passed in the halls. He's got the ugly mug on him and he'll be carrying the %reward_completion% crowns, as promised.%SPEECH_OFF%The man takes another look at the beast then slowly shakes his head.%SPEECH_ON%May the dead and their survivors find peace in the passing of those foul creatures.%SPEECH_OFF% | %employer% welcomes your return with a goblet of wine.%SPEECH_ON%Drink up, beast-slayer.%SPEECH_OFF%You're curious as to how he already knows of your success. He waves off your curiosity.%SPEECH_ON%I've many eyes and ears in this land - not spies, of course, but the common folk has a big mouth. I should know, I am one! You did well on this one, sellsword, so have a sip. It's mighty fine wine.%SPEECH_OFF%It's alright. The reward of %reward_completion% crowns you walk out with is far better, though. %employer% stops you.%SPEECH_ON%Just so you know, mercenary, those beasts killed some good men and women out there. Those people might be scared of you, being the sellsword that you are, but they are eternally grateful all the same.%SPEECH_OFF%You weigh the crowns. Quite grateful, yes... | %employer% takes a few steps back.%SPEECH_ON%Ah, uh, I see you've killed the beasts. That's a mighty fine pelt you got there.%SPEECH_OFF%You drop what you've brought: a thick, heavy mane of beastly origin collapsing into a pile of fur and flesh. The man, almost too scared to get close, tosses you a satchel.%SPEECH_ON%%reward_completion% crowns, as agreed upon. I will go to the people and tell them of your success. Finally, we can be at peace.%SPEECH_OFF% | %employer%'s sitting at his table, legs up over a corner. His eyes are staring at the ceiling, the corners of his face pinched with withered folds. He looks at you.%SPEECH_ON%Welcome back. I've been getting word of your doings... of your battles with the monsters.%SPEECH_OFF%You nod, looking around for your reward. The man shows you the door.%SPEECH_ON%%randomname%, a fellow councilman of %townname%, has your payment outside. %reward_completion% crowns as agreed upon. And the people of %townname%, fear you though they may, are blessed all the same by your arrival here. Thank you, mercenary.%SPEECH_OFF% | %employer%'s feeding one of his dogs when you return. The mutt drops its bone to sniff at what you've brought. The man points at the pelt.%SPEECH_ON%What kind of foul thing is that?%SPEECH_OFF%You shrug and toss it onto his table. The dog pokes its nose at one of the claws, growls, then begins to lick it. %employer% smiles briefly, but then goes to his bookshelf, picking up a wooden chest and handing it to you.%SPEECH_ON%%reward_completion% crowns, was it? You should know that you've brought peace to the people of %townname%.%SPEECH_OFF%You nod.%SPEECH_ON%Does their happiness also come in crowns?%SPEECH_OFF%%employer% frowns at your greedy humor.%SPEECH_ON%No, it does not. Have a good day, mercenary.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_04.png[/img]{Regresas ante %employer% y extiendes una de las pieles sobre su escritorio. Sus garras inertes golpean el costado del roble. %Art_employer% %hombre_employer% levanta una de ellas y luego la deja caer de nuevo.%SPEECH_ON%Veo que has encontrado esas bestias que buscábamos.%SPEECH_OFF%Le cuentas cómo fue la batalla. Parece muy satisfech%o_employer%; saca un pequeño cofre de madera de su estantería y te lo entrega.%SPEECH_ON%%reward_completion% coronas, como acordamos. El pueblo de %townname% se merecía el respiro que le has dado frente a tales horrores.%SPEECH_OFF% | Cuando entras en la habitación de %employer%, retrocede casi al instante.%SPEECH_ON%¿Qué diablos tienes en la mano, mercenario?%SPEECH_OFF%Sostienes una de las pieles por la nuca. La sangre negra chorrea del cuello y salpica el suelo.%SPEECH_ON%Una de las bestias que buscabas. Si necesitas pruebas del resto, las tengo esperando afuera...%SPEECH_OFF%%Art_employer% %hombre_employer% levanta la mano, deteniéndote.%SPEECH_ON%Con una me basta para creerte. Muy buen trabajo, mercenario. Tu pago lo tiene %randomname%, un concejal con el que seguramente te cruzaste en los pasillos. Es el de la cara fea, y llevará las %reward_completion% coronas, como se te prometió.%SPEECH_OFF%%Art_employer% %hombre_employer% vuelve a mirar el pellejo de la bestia y luego sacude lentamente la cabeza.%SPEECH_ON%Que los muertos y sus supervivientes encuentren paz con la desaparición de esas criaturas repugnantes.%SPEECH_OFF% | %employer% te da la bienvenida con una copa de vino.%SPEECH_ON%Bebe, cazador de bestias.%SPEECH_OFF%Te preguntas cómo es que ya sabe de tu éxito. Desecha tu curiosidad con un gesto de la mano.%SPEECH_ON%Tengo muchos ojos y oídos en estas tierras; no espías, por supuesto, pero la gente común habla mucho. ¡Bien lo sé yo, que soy parte de ella! Lo hiciste bien en este caso, mercenario, así que toma un sorbo. Es un vino muy bueno.%SPEECH_OFF%No está mal. Aunque el premio de %reward_completion% coronas con el que sales es mucho mejor. %employer% te detiene.%SPEECH_ON%Solo para que lo sepas, mercenario, esas bestias mataron a buenos hombres y mujeres allá afuera. Esas personas pueden tener miedo de ti, siendo el mercenario que eres, pero están eternamente agradecidas de todos modos.%SPEECH_OFF%Sopesas las coronas. Muy agradecidas, sí... | %employer% da unos pasos hacia atrás.%SPEECH_ON%Ah, eh, veo que has matado a las bestias. Menuda piel traes ahí.%SPEECH_OFF%Sueltas lo que has traído: una melena gruesa y pesada de origen bestial que se desploma en un montón de pelo y carne. %Art_employer% %hombre_employer%, casi demasiado asustad%o_employer% para acercarse, te arroja una bolsita.%SPEECH_ON%%reward_completion% coronas, como acordamos. Iré con la gente y les contaré tu éxito. Por fin podremos estar en paz.%SPEECH_OFF% | %employer% está sentad%o_employer% a su mesa, con las piernas encima de una esquina. Sus ojos están fijos en el techo, los rincones de su rostro surcados de arrugas profundas. Te mira.%SPEECH_ON%Bienvenido de vuelta. Me han llegado noticias de lo que has hecho... de tus batallas con los monstruos.%SPEECH_OFF%Asientes y buscas tu recompensa con la mirada. %Art_employer% %hombre_employer% te señala la puerta.%SPEECH_ON%%randomname%, un compañero concejal de %townname%, tiene tu pago afuera. %reward_completion% coronas, como acordamos. Y la gente de %townname%, aunque te tema, se siente bendecida por tu llegada. Gracias, mercenario.%SPEECH_OFF% | %employer% está alimentando a uno de sus perros cuando regresas. El chucho suelta el hueso para olfatear lo que has traído. %Art_employer% %hombre_employer% señala la piel.%SPEECH_ON%¿Qué clase de cosa repugnante es esa?%SPEECH_OFF%Te encoges de hombros y la lanzas sobre su mesa. El perro acerca el hocico a una de las garras, gruñe y luego empieza a lamerla. %employer% sonríe brevemente, pero luego va a su estantería, toma un cofre de madera y te lo entrega.%SPEECH_ON%%reward_completion% coronas, ¿no? Deberías saber que has traído la paz al pueblo de %townname%.%SPEECH_OFF%Asientes.%SPEECH_ON%¿Y su felicidad también se paga en coronas?%SPEECH_OFF%%employer% frunce el ceño ante tu humor codicioso.%SPEECH_ON%No. Que tengas un buen día, mercenario.%SPEECH_OFF%}"
    }
    // en = "Rid the town of direwolves"
    // en base_es
    // en = "Beast, men... what matters is the crowns."
    // en base_es
    // en = "Rid the town of brigands masquerading as direwolves"
    // en base_es
    // en = "Rid the town of nachzehrers"
    // en base_es
    // en = "At %townname%"
    // en base_es
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_10.png[/img]{As you leave, a pair of poachers approach. They claim to have spotted the beasts recently, and offer to join your hunt in exchange for a share of %cut% crowns paid in advance.}"
        es = "[img]gfx/ui/events/event_10.png[/img]{Al salir, se te acercan un par de cazadores furtivos. Dicen haber visto a las bestias hace poco y se ofrecen a unirse a tu cacería a cambio de una parte de %cut% coronas, pagada por adelantado.}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Options.getResult
    // en = "Poachers2"  // identificador de la pantalla de destino; no se muestra
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "Leave it to the professionals."
        es = "Esto es cosa de profesionales."
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start.Options.push().Text
    {
        en = "%peddler% has a business proposal"
        es = "%peddler% tiene una propuesta de negocio"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start.Options.push().getResult
    // en = "Peddler1"  // identificador de la pantalla de destino; no se muestra
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_10.png[/img]{The poachers grin as you hand over the crowns. They join your party}"
        es = "[img]gfx/ui/events/event_10.png[/img]{Los cazadores furtivos sonríen de oreja a oreja cuando les entregas las coronas. Se unen a tu grupo}"
    }
    // en = "This better be worth it."
    // en base_es
    // en = "You lose <v:val_tag> Crowns"
    // en base_es
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start.List.push().text.::Const.LegendMod.Language.arrayToText()
    {
        // text = ::Const.LegendMod.Language.arrayToText(poachers, "and", ::Const.UI.Color.getHighlightDarkBackgroundValue()) + " temporarily join your party",
        mode = "pattern"
        en = "<names:str> temporarily join your party"
        es = "<names> se unen temporalmente a tu grupo"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Title
    {
        en = "A business proposal"
        es = "Una propuesta de negocio"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_92.png[/img]{%peddler% clears %their_peddler% throat as %they_peddler% steps forward in front of the poachers.%SPEECH_ON%Excuse me? This is a once-in-a-lifetime opportunity to experience the adventurous life of a mercenary! Surely YOU should be paying US for this opportunity?%SPEECH_OFF% | %peddler% leaps forward like a starving dog unable to contain itself. Gesticulating wildly, %they_peddler% launches into an impossibly rehearsed spiel on how this is an incredibly rare opportunity to embark on a \"Mercenary Experience\" for a jaw-droppingly low price of %cut% crowns. | Practically quivering with excitement, %peddler% plants %their_peddler% face uncomfortably close to one of the poachers' own, spittle flying all over their face as %they_peddler% touts an \"all-inclusive package deal\" to experience mercenary work, the likes of which are hitherto unheard of in all the land.\n\nIt appears %peddler% has gone farking mad and is attempting to convince the poachers that they should be paying YOU instead.}"
        es = "[img]gfx/ui/events/event_92.png[/img]{%peddler% carraspea y se planta delante de los cazadores furtivos.%SPEECH_ON%¿Perdón? ¡Esta es una oportunidad única en la vida de conocer la aventurera vida de un mercenario! ¿No deberían ser USTEDES quienes NOS pagaran por esta oportunidad?%SPEECH_OFF% | %peddler% se abalanza hacia delante como un perro hambriento incapaz de contenerse. Gesticulando como si le fuera la vida en ello, se lanza a soltar una perorata ensayada hasta lo imposible sobre lo increíblemente rara que es esta oportunidad de embarcarse en una \"Experiencia Mercenaria\" por el precio de risa de %cut% coronas. | Casi temblando de emoción, %peddler% pega la cara a la de uno de los cazadores furtivos, a una distancia incómoda, rociándolo de saliva mientras le vende un \"paquete con todo incluido\" para vivir el oficio mercenario, algo jamás visto en todas estas tierras.\n\nPor lo visto, %peddler% ha perdido la jodida cabeza y está intentando convencer a los cazadores furtivos de que deberían ser ellos quienes TE pagaran a TI.}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{How about it? | Deal?}"
        es = "{¿Qué les parece? | ¿Trato hecho?}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Options.getResult
    // en = "Peddler2"  // identificador de la pantalla de destino; no se muestra
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Options.getResult
    // en = "Peddler3"  // identificador de la pantalla de destino; no se muestra
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start
    {
        en = "{Say what you want about %peddler%, but %they_peddler% somehow managed to pull it off. You quickly pick the coins off the outstretched palms of the very confused-looking poachers before they change their minds. | As the befuddled-looking poachers hand over their precious crowns, you wonder why %peddler% even needed to turn to a life of mercenary work. | To the astonishment of everyone except %peddler%, the poachers hand over a bag of crowns and eagerly fall in line with the %companyname%.}"
        es = "{Di lo que quieras de %peddler%, pero de algún modo se ha salido con la suya. Recoges rápidamente las monedas de las palmas extendidas de los cazadores furtivos, que parecen muy confundidos, antes de que cambien de opinión. | Mientras los desconcertados cazadores furtivos te entregan sus preciadas coronas, te preguntas qué necesidad tenía %peddler% de meterse a mercenari%o_peddler%. | Para asombro de todos menos de %peddler%, los cazadores furtivos entregan una bolsa de coronas y se suman con entusiasmo a las filas de la %companyname%.}"
    }
    // en = "You gain <v:val_tag> Crowns"
    // en base_es
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start.Contract.m.Peddler.improveMood()
    {
        en = "Bamboozled some poachers"
        es = "Engatusó a unos cazadores furtivos"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start.Options.Text
    {
        en = "{Welcome to the experience of a lifetime. | I'm beginning to question who the real danger is...}"
        es = "{Bienvenidos a la experiencia de su vida. | Empiezo a preguntarme quién es el verdadero peligro...}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start
    {
        en = "{The poachers look to each other as they consider %peddler%'s offer. Out of the corner of your eye you see %peddler% licking %their_peddler% lips in anticipation. They eventually come to a decision.%SPEECH_ON%Fine, we will pay you, but only after the contract is completed, so you better make sure we make it back safely!%SPEECH_OFF%}"
        es = "{Los cazadores furtivos se miran entre sí mientras sopesan la oferta de %peddler%. Por el rabillo del ojo ves a %peddler% relamerse de expectación. Al final toman una decisión.%SPEECH_ON%Está bien, les pagaremos, pero solo cuando el contrato esté cumplido, ¡así que más les vale asegurarse de que volvamos sanos y salvos!%SPEECH_OFF%}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start.Options.Text
    {
        en = "{No promises. | Watch your step.}"
        es = "{No prometo nada. | Miren dónde pisan.}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start
    {
        en = "{You rub your temples as the poachers end up haggling with %peddler%. After an eternity and no shortage of groans from various members of the company, %peddler% walks back over cheerfully and announces that they have arrived at a suitable compromise - the poachers will join your hunt for free.\n\nYou turn to the poachers and are met with faces of sheer exhaustion and weariness.}"
        es = "{Te masajeas las sienes mientras los cazadores furtivos acaban regateando con %peddler%. Tras una eternidad y no pocos gruñidos de varios miembros de la compañía, %peddler% vuelve muy alegre y anuncia que han llegado a un acuerdo razonable: los cazadores furtivos se unirán a la cacería gratis.\n\nTe vuelves hacia los cazadores furtivos y te encuentras con caras de puro agotamiento y hastío.}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start.Options.Text
    {
        en = "{How did we end up here? | I'm beginning to question who the real danger is... | Remember, you approached us first.}"
        es = "{¿Cómo hemos llegado a esto? | Empiezo a preguntarme quién es el verdadero peligro... | Recuerden que fueron ustedes los que se nos acercaron.}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start.List.push().text.::Const.LegendMod.Language.arrayToText()
    {
        // text = ::Const.LegendMod.Language.arrayToText(poachers, "and", ::Const.UI.Color.getHighlightDarkBackgroundValue()) + " temporarily " + ::Const.LegendMod.Language.pluralize(poachers.len(), "joins", "join") + " your party",
        mode = "pattern"
        en = "<names:str> temporarily <verb:str> your party"
        es = "<names> se une temporalmente a tu grupo"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_10.png[/img]{Despite the best efforts of %peddler%, the poachers shake their heads and insist on being paid %cut% crowns for their services. | Remarkably, the poachers were able to resist the onslaught of words and gestures from %peddler%.%SPEECH_ON%You'll have to pay us %cut% crowns if you want us to risk our lives like that%SPEECH_OFF%You realize they're not talking about the beasts.}"
        es = "[img]gfx/ui/events/event_10.png[/img]{Pese a todos los esfuerzos de %peddler%, los cazadores furtivos niegan con la cabeza e insisten en cobrar %cut% coronas por sus servicios. | Sorprendentemente, los cazadores furtivos resisten la avalancha de palabras y aspavientos de %peddler%.%SPEECH_ON%Tendrás que pagarnos %cut% coronas si quieres que arriesguemos así la vida%SPEECH_OFF%Te das cuenta de que no se refieren a las bestias.}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "Very well."
        es = "Muy bien."
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "Forget it."
        es = "Ni hablar."
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_10.png[/img]{The poachers give you a slight nod before returning to their homes.}"
        es = "[img]gfx/ui/events/event_10.png[/img]{Los cazadores furtivos te saludan con un leve gesto de cabeza antes de volver a sus casas.}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "Pleasure working with you."
        es = "Un placer trabajar con ustedes."
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start.Text
    {
        en = "[img]gfx/ui/events/event_10.png[/img]{The poachers excitedly recount to each other the adventure they'd had, happily handing over a bag of crowns to you before parting ways.}"
        es = "[img]gfx/ui/events/event_10.png[/img]{Los cazadores furtivos se cuentan unos a otros, entusiasmados, la aventura que han vivido, y te entregan alegremente una bolsa de coronas antes de despedirse.}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start
    {
        en = "{%SPEECH_ON%We'll be sure to let the town know of the good work you've done.%SPEECH_OFF%}"
        es = "{%SPEECH_ON%Nos aseguraremos de que todo el pueblo sepa del buen trabajo que has hecho.%SPEECH_OFF%}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start.List.push().text.::Const.LegendMod.Language.arrayToText()
    {
        // text = ::Const.LegendMod.Language.arrayToText(poachers, "and", ...) + pluralize(poachers.len(), " leaves", " leave") + " your party"
        // Un par por cada forma del verbo. Con varios cazadores, el "and" que pone arrayToText queda en ingles.
        mode = "pattern"
        en = "<names:str> leaves your party"
        es = "<names> abandona tu grupo"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start.List.push().text
    {
        mode = "pattern"
        en = "<names:str> leave your party"
        es = "<names> abandonan tu grupo"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_10.png[/img]{Not all of the poachers who joined your hunt made it back alive, and as you part ways, you wonder if there was more you could've done.}"
        es = "[img]gfx/ui/events/event_10.png[/img]{No todos los cazadores furtivos que se unieron a tu cacería han vuelto con vida, y al despedirte de ellos te preguntas si podrías haber hecho algo más.}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "Mercenary work is dangerous."
        es = "El oficio de mercenario es peligroso."
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start.Text.format()
    {
        // this.Text = "[img]gfx/ui/events/event_10.png[/img]{" + format("The remaining %s %s over their share of the payment promised for the \"once-in-a-lifetime\" experience. For some, the experience did live up to its name.",::Const.LegendMod.Language.pluralize(poachers.len(),"poacher", "poachers"),::Const.LegendMod.Language.pluralize(poachers.len(),"hands", "hand")) + "}";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_10.png[/img]{The remaining <noun:word> <verb:word> over their share of the payment promised for the \"once-in-a-lifetime\" experience. For some, the experience did live up to its name.}"
        es = "[img]gfx/ui/events/event_10.png[/img]{Lo que queda de los cazadores furtivos te entrega su parte del pago prometido por la experiencia \"única en la vida\". Para algunos, la experiencia sí que hizo honor a su nombre.}"
    }
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().Text
    {
        en = "{[img]gfx/ui/events/event_10.png[/img]The townsfolk notice the conspicuous absence of the poachers who left with you. You feel the judgement of their stares.\n\nYou count yourself lucky to endure merely the stares of the living rather than the dead, which might have been the case had you not been successful. | [img]gfx/ui/events/event_20.png[/img]The townsfolk barely notice your return - far too engrossed in their own business. Hopefully they do not notice that the poachers have not returned either. | [img]gfx/ui/events/event_20.png[/img]You turn to bid farewell to the poachers who joined you, completely forgetting the gruesome end they met in battle. You remind yourself that you should quit while you're ahead... someday.'}"
        es = "{[img]gfx/ui/events/event_10.png[/img]Los vecinos notan la llamativa ausencia de los cazadores furtivos que se fueron contigo. Sientes el juicio en sus miradas.\n\nTe consideras afortunado de soportar solo las miradas de los vivos y no las de los muertos, que es lo que te habría tocado si hubieras fracasado. | [img]gfx/ui/events/event_20.png[/img]Los vecinos apenas reparan en tu regreso, demasiado absortos en sus propios asuntos. Con suerte, tampoco notarán que los cazadores furtivos no han vuelto. | [img]gfx/ui/events/event_20.png[/img]Te vuelves para despedirte de los cazadores furtivos que se unieron a ti, olvidando por completo el espantoso final que encontraron en la batalla. Te recuerdas que deberías retirarte mientras vas ganando... algún día.}"
    }
    // en = "Whoops."
    // en base_es
    // context: legend_preemptive_beasts_contract.onPrepareVariables._vars.push()
    // en = "cut"  // nombre de la variable %cut%; no se muestra
    // en = "peddler"
    // context: legend_preemptive_beasts_contract.onPrepareVariables._vars.push()
    // en = "experthunter"  // nombre de la variable %experthunter%; no se muestra
    // FILE: scripts\contracts\contracts\legend_spider_abductions_contract.nut
    // context: legend_spider_abductions_contract.create.m.Name
    {
        en = "Horror In The Woods"
        es = "Horror en el bosque"
    }
    // context: legend_spider_abductions_contract.create.m.DescriptionTemplates
    {
        en = "Few things elicit such horror as the Webknechts, especially when they grow large enough to start abducting fully-grown townsfolk."
        es = "Pocas cosas provocan tanto horror como los Webknechts, sobre todo cuando crecen lo bastante como para empezar a raptar a vecinos adultos."
    }
    // context: legend_spider_abductions_contract.create.m.DescriptionTemplates
    {
        en = "Spider abductions is yet another nightmare come to life, with local reports of hapless victims ensnared in webs being dragged away into the darkness."
        es = "Los raptos de arañas son otra pesadilla hecha realidad: los lugareños hablan de desdichadas víctimas atrapadas en telarañas y arrastradas a la oscuridad."
    }
    // context: legend_spider_abductions_contract.create.m.DescriptionTemplates
    {
        en = "Disturbing reports of people being seized in the night by eight-legged horrors are the talk of the town."
        es = "En el pueblo no se habla de otra cosa que de los inquietantes relatos de gente atrapada de noche por horrores de ocho patas."
    }
    // context: legend_spider_abductions_contract.create.m.DescriptionTemplates
    {
        en = "For those who tread the forest paths, the threat of being ensnared in sticky silk and spirited away by arachnid fiends fills their waking hours with dread."
        es = "Para quienes recorren las sendas del bosque, la amenaza de quedar atrapados en seda pegajosa y ser arrebatados por demonios arácnidos llena de pavor sus horas de vigilia."
    }
    // context: legend_spider_abductions_contract.create.m.DescriptionTemplates
    {
        en = "Spider abduction is a grim fate that befalls those who wander too far from safety, their screams drowned out by the cacophony of chirping crickets and rustling leaves as they are dragged away."
        es = "El rapto a manos de arañas es un destino funesto que aguarda a quienes se alejan demasiado de un lugar seguro; sus gritos, mientras se los llevan a rastras, quedan ahogados por la cacofonía de los grillos y el susurro de las hojas."
    }
    // context: legend_spider_abductions_contract.create.m.DescriptionTemplates
    {
        en = "Those taken by the webspinners into the trees never return, for the forest holds secrets darker than night."
        es = "Quienes se llevan las tejedoras de telarañas entre los árboles nunca regresan, pues el bosque guarda secretos más oscuros que la noche."
    }
    // context: legend_spider_abductions_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        // "Find the Webknecht Nest where the abducted townsfolk from " + this.Contract.m.Home.getName() + " were taken to"
        mode = "pattern"
        en = "Find the Webknecht Nest where the abducted townsfolk from <town:str> were taken to"
        es = "Encuentra el Nido de Webknechts adonde se llevaron a los vecinos raptados de <town>"
    }
    // context: legend_spider_abductions_contract.createStates.m.States.push().update.Contract.setScreen()
    // en = "Nest1"
    // identificador de pantalla
    // context: legend_spider_abductions_contract.createStates.m.States.push().onDestinationAttacked.onPlayerDeployment.villager.setName()
    {
        en = "Abducted Villager"
        es = "Víctima raptada"
    }
    // context: legend_spider_abductions_contract.createStates.m.States.push().onDestinationAttacked.onPlayerDeployment.wc.::MSU.Class.WeightedContainer()
    // en = "Egg"  // clave del WeightedContainer que decide qué se genera en el despliegue; no se muestra
    // context: legend_spider_abductions_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        // "Return with the rescued townsfolk to " + this.Contract.m.Home.getName()
        mode = "pattern"
        en = "Return with the rescued townsfolk to <town:str>"
        es = "Vuelve a <town> con los vecinos rescatados"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_62.png[/img]{You enter to find %employer% slumped down in %their_employer% chair as if the world were crushing down on %them_employer%. A small spider no bigger than half a crown begins to climb up their cup, only to be detected and sent flying, along with the cup, across the room. The cup bounces off a wall, spilling it's contents across the floor as the spider escapes, dazed yet unharmed, from the flood of wine now escaping from the vessel. %employer% locks %their_employer% gaze with yours, refusing to move any other part of %their_employer% body except %their_employer% eyes. You ask about the contract, and are met with a hand wave followed by a grunt. A steward quickly steps in, with rehearsed practice and precision. %SPEECH_ON%You must forgive %them_employer%, times have been tough with these nightmares scurrying about. I will keep this short for you - there is a nest somewhere nearby. Find it. Destroy it. Then bring anyone there back here ALIVE.%SPEECH_OFF% The steward made a special effort to draw attention to that last part, clearly after making the mistake of not doing so with a previous band of mercenaries... | A steward ushers you into a fine study, where %employer% sits in an ornate chair facing a crackling fireplace. %They_employer% doesn't seem to notice your arrival, apparently preoccupied with staring vacantly into the flames. You hesitate, unsure whether to approach or not. The steward realises your predicament and pointedly clears his throat. %SPEECH_ON%Ahem! The uhm, sellsword you asked for my Lord?%SPEECH_OFF% %employer% jolts out of %their_employer% reverie and rises to %their_employer% feet. As %they_employer% approaches, you recognise an emotion on %their_employer% face you see far too often with the people you deal with, grief. %SPEECH_ON%A sellsword captain? Yes, yes of course. You are here to deal with the problem. Six... just six days ago sellsword, my precious Imelda was out practice riding her pony when she was taken by the web creatures. We... we never found her and apparently there have been others. Many, many others recently...%SPEECH_OFF% %Their_employer% voice cracks, and %they_employer% suddenly grabs the front of your shirt. You reflexively reach for your absent sword, which a guard took from you before the meeting. %employer% seems not to notice. %SPEECH_ON%I knew! I knew they were a problem, sellsword! I ignored it... ignored it for far too long, so many other pressing problems you see. Now... this is my punishment.%SPEECH_OFF% A shadow passes over %their_employer% face and %they_employer% releases %their_employer% grip on you. This is just as well as you were thinking of going for the hidden dagger in your boot. %They_employer% turns away, idly running a hand through %their_employer% hair to master %their_employer% emotions. When %they_employer% faces you once again %their_employer% eyes and intent are firm. %SPEECH_ON%Find their nest. Burn it. Burn the whole forest for all I care if that's what it takes. Return any survivors you find and you will be handsomely rewarded.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_62.png[/img]{Al entrar, encuentras a %employer% desplomad%o_employer% en su silla, como si el peso del mundo %lo_employer% aplastara. Una arañita no más grande que media corona empieza a trepar por su copa, pero la descubren y sale volando, junto con la copa, hasta el otro lado de la habitación. La copa rebota contra una pared y derrama su contenido por el suelo, mientras la araña escapa, aturdida pero ilesa, de la riada de vino que sale del recipiente. %employer% te clava la mirada, negándose a mover cualquier parte del cuerpo que no sean los ojos. Le preguntas por el contrato y, por toda respuesta, recibes un gesto de la mano seguido de un gruñido. Un mayordomo interviene enseguida, con la soltura y la precisión de quien lo tiene ensayado. %SPEECH_ON%Tienes que disculpar%lo_employer%; han sido tiempos difíciles con estas pesadillas correteando por ahí. Seré breve: hay un nido en algún lugar cerca de aquí. Encuéntralo. Destrúyelo. Y luego trae aquí VIVO a todo el que encuentres allí.%SPEECH_OFF% El mayordomo pone especial empeño en recalcar esa última parte; está claro que cometió el error de no hacerlo con una banda de mercenarios anterior... | Un mayordomo te hace pasar a un elegante estudio, donde %employer% está sentad%o_employer% en un sillón ornamentado frente a una chimenea crepitante. No parece notar tu llegada; por lo visto, está absort%o_employer% mirando las llamas con la vista perdida. Dudas, sin saber si acercarte o no. El mayordomo se da cuenta de tu apuro y carraspea con intención. %SPEECH_ON%¡Ejem! El, eh... ¿el mercenario que pidió, mi señor?%SPEECH_OFF% %employer% sale de golpe de su ensimismamiento y se pone en pie. Mientras se acerca, reconoces en su rostro una emoción que ves con demasiada frecuencia en la gente con la que tratas: el duelo. %SPEECH_ON%¿Un capitán mercenario? Sí, sí, claro. Estás aquí para ocuparte del problema. Hace seis... solo seis días, mercenario, mi querida Imelda había salido a practicar con su poni cuando se la llevaron esas criaturas de las telarañas. Nosotros... nunca la encontramos y, por lo visto, ha habido otros. Muchos, muchísimos otros últimamente...%SPEECH_OFF% Se le quiebra la voz y, de repente, te agarra por la pechera de la camisa. Por reflejo, llevas la mano a tu espada ausente, que un guardia te quitó antes de la reunión. %employer% no parece darse cuenta. %SPEECH_ON%¡Lo sabía! ¡Sabía que eran un problema, mercenario! Lo ignoré... lo ignoré durante demasiado tiempo, tenía tantos otros problemas urgentes, ¿entiendes? Y ahora... este es mi castigo.%SPEECH_OFF% Una sombra cruza su rostro y te suelta. Mejor así, porque ya estabas pensando en echar mano de la daga que llevas oculta en la bota. Se da la vuelta y se pasa distraídamente una mano por el pelo para dominar sus emociones. Cuando vuelve a mirarte, su mirada y su determinación son firmes. %SPEECH_ON%Encuentra su nido. Quémalo. Quema el bosque entero si hace falta, me da igual. Trae de vuelta a los supervivientes que encuentres y serás generosamente recompensado.%SPEECH_OFF%}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{Attacking a Webknecht nest is dangerous. This better pay well. | How much are their lives worth to you? | We will rescue them if the pay is right.}"
        es = "{Atacar un nido de Webknechts es peligroso. Más vale que la paga sea buena. | ¿Cuánto valen sus vidas para ti? | Los rescataremos si la paga es justa.}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{This isn't worth it. | This sounds far too dangerous.}"
        es = "{No vale la pena. | Esto suena demasiado peligroso.}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Title
    {
        en = "At the Webknecht Nest..."
        es = "En el Nido de Webknechts..."
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_110.png[/img]{You are drawn to the muffled screams and sobbing prayers of those trapped within the shimmering field of webs. The sticky blanket covering the area is occasionally broken by clusters of eggs and wrapped animals struggling all the same. You pause for a moment, assessing the scene. Aside from the captives, the area seems to be clear of anything with more than four legs.\n\n Now could be your chance...}"
        es = "[img]gfx/ui/events/event_110.png[/img]{Te atraen los gritos ahogados y las plegarias entre sollozos de quienes están atrapados en el reluciente campo de telarañas. El manto pegajoso que cubre la zona se ve interrumpido aquí y allá por racimos de huevos y por animales envueltos que forcejean igual que ellos. Te detienes un momento para evaluar la escena. Aparte de los cautivos, la zona parece libre de cualquier cosa con más de cuatro patas.\n\n Esta podría ser tu oportunidad...}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{Rush in!}"
        es = "{¡A la carga!}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Options.getResult
    // en = "Nest2"  // identificador de la pantalla de destino; no se muestra
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{We'll come back later.}"
        es = "{Volveremos más tarde.}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_110.png[/img]{You give the signal and %companyname% start to grimly advance towards the trapped victims, wading through webs and eggs along the way, some getting caught in the webs themselves and jumping over the larger clusters of eggs.\n\n The whole nest reverberates like a silent lyre string. At first this is just your movement, but then something further away pulls a different chord. Once, twice then thrice the smaller, faster notes are plucked. With mounting dread you feel the notes being played from a different direction and quickly draw your weapon. They are all around you now, in silent communion with one another as an excited, frantic song is played.\n\n They know you are here.}"
        es = "[img]gfx/ui/events/event_110.png[/img]{Das la señal y la %companyname% empieza a avanzar con gravedad hacia las víctimas atrapadas, abriéndose paso entre telarañas y huevos; algunos se quedan enredados en las telas y otros saltan por encima de los racimos de huevos más grandes.\n\n Todo el nido vibra como la cuerda muda de una lira. Al principio es solo tu propio movimiento, pero luego algo más lejos pulsa un acorde distinto. Una, dos y hasta tres veces se pulsan notas más breves y rápidas. Con un pavor creciente, sientes que las notas llegan desde otra dirección y desenvainas el arma a toda prisa. Ahora están a tu alrededor, en silenciosa comunión entre ellas, mientras suena una canción exaltada y frenética.\n\n Saben que estás aquí.}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{Defend the townsfolk! | To arms! | Prepare for battle!}"
        es = "{¡Defiendan a los vecinos! | ¡A las armas! | ¡Prepárense para la batalla!}"
    }
    // en = "Retreat"
    // en base_es
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Text
    {
        en = "{%companyname% abandons the townsfolk to their doom.}"
        es = "{La %companyname% abandona a los vecinos a su perdición.}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{Better them than us.}"
        es = "{Mejor ellos que nosotros.}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_123.png[/img]{As the last of the skittering nightmares falls silent, a firm calmness takes over the battlefield. The torn web covering the ground gently breaks apart and drifts to the wind, as if succumbing to its wounds just as its spinners did. A mixture of blood and venom pools under each of the sticky corpses as carrion birds gather nearby, patiently awaiting your departure.\n\n You order the %companyname% to clear out any eggs remaining in the nest and prepare to escort the survivors back to %townname%}"
        es = "[img]gfx/ui/events/event_123.png[/img]{Cuando la última de esas pesadillas correteantes queda en silencio, una calma firme se adueña del campo de batalla. La telaraña desgarrada que cubre el suelo se deshace suavemente y se la lleva el viento, como si sucumbiera a sus heridas igual que sus tejedoras. Bajo cada uno de los cadáveres pegajosos se forma un charco de sangre y veneno, mientras las aves carroñeras se congregan cerca, esperando pacientes a que te marches.\n\n Ordenas a la %companyname% que destruya los huevos que queden en el nido y se prepare para escoltar a los supervivientes de vuelta a %townname%}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{Let's get these poor souls back to safety. | We've seen enough here.}"
        es = "{Llevemos a estas pobres almas a un lugar seguro. | Ya hemos visto bastante.}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Title
    {
        en = "Upon your return..."
        es = "A tu regreso..."
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_43.png[/img]{The townsfolk of %townname% offer their gratitude, but %employer% barely registers your presence. %They_employer% paces the length of %their_employer% chambers, dictating a response to some fresh crisis to a scribe, who dutifully jots it all down on a lengthy roll of parchment. The steward quietly pulls you aside and presses a heavy purse into your hands, with no unnecessary words exchanged.\n\n Today's threat may be dealt with, but tomorrow will yield another. But that's just as well - without monsters to kill there'd be no coin to earn.}"
        es = "[img]gfx/ui/events/event_43.png[/img]{Los vecinos de %townname% te muestran su gratitud, pero %employer% apenas repara en tu presencia. Recorre de punta a punta sus aposentos dictándole a un escriba la respuesta a alguna nueva crisis, y el escriba lo anota todo con diligencia en un largo rollo de pergamino. El mayordomo te lleva aparte en silencio y te pone en las manos una bolsa pesada, sin cruzar una palabra de más.\n\n Puede que la amenaza de hoy esté resuelta, pero mañana traerá otra. Y mejor así: sin monstruos que matar, no habría monedas que ganar.}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{All in a day's work. | I hope to never see a spider again for the rest of my life.}"
        es = "{Gajes del oficio. | Espero no volver a ver una araña en lo que me queda de vida.}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Options.getResult.::World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation()
    {
        en = "Rescued townsfolk from Webknechts"
        es = "Rescató a vecinos de manos de los Webknechts"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().start.List.push().text.format()
    {
        // text = format("You rescued %s out of %s Abducted Townsfolk", ::Const.UI.getColorized(survivorCount, survivorCount == 0 ? ::Const.UI.Color.NegativeEventValue : ::Const.UI.Color.PositiveEventValue), ::Const.UI.getColorized(this.Flags.get("NumAbductees"), ::Const.UI.Color.PositiveEventValue))
        mode = "pattern"
        en = "You rescued <saved:str> out of <total:str> Abducted Townsfolk"
        es = "Rescataste a <saved> de <total> vecinos raptados"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().start.List.push().text.format()
    // en = "You rescued <::Const.UI.getColorized(survivorCount, ::Const.UI.Color.PositiveEventValue)> out of <::Const.UI.getColorized(this.Flags.get(NumAbductees), ::Const.UI.Color.PositiveEventValue)> Abducted Townsfolk"  // cubierto por el patrón "You rescued <saved:str> out of <total:str> Abducted Townsfolk"
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().start
    {
        en = "{\n\nAs you leave the employer's chambers, the townsfolk you rescued gather around.%SPEECH_ON%They saved all of us! We thought we were all done for, but they kept us safe.\"\n\n\"And not a single one of us was left behind either!\"\n\n\"All shall hear of the %companyname%!\"\n\n\"Hear, hear!%SPEECH_OFF%}"
        es = "{\n\nAl salir de los aposentos de tu empleador, los vecinos que rescataste se congregan a tu alrededor.%SPEECH_ON%¡Nos salvaron a todos! Creíamos que estábamos perdidos, pero nos mantuvieron a salvo.\"\n\n\"¡Y no dejaron atrás ni a uno solo de nosotros!\"\n\n\"¡Todos oirán hablar de la %companyname%!\"\n\n\"¡Eso, eso!%SPEECH_OFF%}"
    }
    // context: legend_spider_abductions_contract.createScreens.Failure1.start
    {
        // @composicion: this.Text += (texto de Failure1 + desenlace).
        // La suma llega entera a Rosetta; los trozos de abajo no llegan nunca solos.
        en = "[img]gfx/ui/events/event_43.png[/img]{%employer% greets you upon your return to %townname%. The hopeful look on %their_employer% face quickly turns concern when %they_employer% notices the lack of rescued townsfolk among the %companyname%.%SPEECH_ON%Where are the people who were abducted? You brought them back with you, yes?%SPEECH_OFF%%randombrother% shifts %their_randombrother% weight comfortably, notably avoiding all eye contact with %employer%.\n\nAs you begin to explain what happened, %employer% cuts you off with a wave of %their_employer% hand.%SPEECH_ON%We hired you to bring those poor folks back. Surely it is not too much to ask for you to have brought at least one person back safely?%SPEECH_OFF%}\n\n{%employer% lets out a sigh.%SPEECH_ON%Fine, I shall pay half of the agreed payment for at least having destroyed the nest.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_43.png[/img]{%employer% te recibe a tu regreso a %townname%. La esperanza de su rostro se torna enseguida preocupación al notar que no hay vecinos rescatados entre los miembros de la %companyname%.%SPEECH_ON%¿Dónde está la gente que raptaron? La has traído contigo, ¿verdad?%SPEECH_OFF%%randombrother% cambia el peso de un pie a otro y evita a toda costa cruzar la mirada con %employer%.\n\nCuando empiezas a explicar lo sucedido, %employer% te interrumpe con un gesto de la mano.%SPEECH_ON%Te contratamos para traer de vuelta a esa pobre gente. ¿Tanto es pedir que hubieras traído sana y salva al menos a una persona?%SPEECH_OFF%}\n\n{%employer% suelta un suspiro.%SPEECH_ON%Está bien, pagaré la mitad de lo acordado, al menos por haber destruido el nido.%SPEECH_OFF%}"
    }
    // context: legend_spider_abductions_contract.createScreens.Failure1.start
    {
        // @composicion: this.Text += (texto de Failure1 + desenlace).
        // La suma llega entera a Rosetta; los trozos de abajo no llegan nunca solos.
        en = "[img]gfx/ui/events/event_43.png[/img]{%employer% greets you upon your return to %townname%. The hopeful look on %their_employer% face quickly turns concern when %they_employer% notices the lack of rescued townsfolk among the %companyname%.%SPEECH_ON%Where are the people who were abducted? You brought them back with you, yes?%SPEECH_OFF%%randombrother% shifts %their_randombrother% weight comfortably, notably avoiding all eye contact with %employer%.\n\nAs you begin to explain what happened, %employer% cuts you off with a wave of %their_employer% hand.%SPEECH_ON%We hired you to bring those poor folks back. Surely it is not too much to ask for you to have brought at least one person back safely?%SPEECH_OFF%}\n\n{After a brief moment of consideration, %employer% hands you a paltry sum of crowns.%SPEECH_ON%I don't think you deserve this at all, but having risked your lives for this, perhaps you should get something for the trouble%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_43.png[/img]{%employer% te recibe a tu regreso a %townname%. La esperanza de su rostro se torna enseguida preocupación al notar que no hay vecinos rescatados entre los miembros de la %companyname%.%SPEECH_ON%¿Dónde está la gente que raptaron? La has traído contigo, ¿verdad?%SPEECH_OFF%%randombrother% cambia el peso de un pie a otro y evita a toda costa cruzar la mirada con %employer%.\n\nCuando empiezas a explicar lo sucedido, %employer% te interrumpe con un gesto de la mano.%SPEECH_ON%Te contratamos para traer de vuelta a esa pobre gente. ¿Tanto es pedir que hubieras traído sana y salva al menos a una persona?%SPEECH_OFF%}\n\n{Tras pensarlo un momento, %employer% te entrega una suma miserable de coronas.%SPEECH_ON%No creo que se lo merezcan en absoluto, pero, ya que han arriesgado la vida por esto, quizá deberían recibir algo por las molestias%SPEECH_OFF%}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_43.png[/img]{%employer% greets you upon your return to %townname%. The hopeful look on %their_employer% face quickly turns concern when %they_employer% notices the lack of rescued townsfolk among the %companyname%.%SPEECH_ON%Where are the people who were abducted? You brought them back with you, yes?%SPEECH_OFF%%randombrother% shifts %their_randombrother% weight comfortably, notably avoiding all eye contact with %employer%.\n\nAs you begin to explain what happened, %employer% cuts you off with a wave of %their_employer% hand.%SPEECH_ON%We hired you to bring those poor folks back. Surely it is not too much to ask for you to have brought at least one person back safely?%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_43.png[/img]{%employer% te recibe a tu regreso a %townname%. La esperanza de su rostro se torna enseguida preocupación al notar que no hay vecinos rescatados entre los miembros de la %companyname%.%SPEECH_ON%¿Dónde está la gente que raptaron? La has traído contigo, ¿verdad?%SPEECH_OFF%%randombrother% cambia el peso de un pie a otro y evita a toda costa cruzar la mirada con %employer%.\n\nCuando empiezas a explicar lo sucedido, %employer% te interrumpe con un gesto de la mano.%SPEECH_ON%Te contratamos para traer de vuelta a esa pobre gente. ¿Tanto es pedir que hubieras traído sana y salva al menos a una persona?%SPEECH_OFF%}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{Next time you try clearing out a Webknecht nest yourself. | It's a dangerous world. | At least we made it back alive ourselves.}"
        es = "{La próxima vez, ve tú a limpiar un nido de Webknechts. | El mundo es peligroso. | Al menos nosotros volvimos con vida.}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().start
    {
        en = "\n\n{%employer% lets out a sigh.%SPEECH_ON%Fine, I shall pay half of the agreed payment for at least having destroyed the nest.%SPEECH_OFF%}"
        es = "\n\n{%employer% suelta un suspiro.%SPEECH_ON%Está bien, pagaré la mitad de lo acordado, al menos por haber destruido el nido.%SPEECH_OFF%}"
    }
    // context: legend_spider_abductions_contract.createScreens.m.Screens.push().start
    {
        en = "\n\n{After a brief moment of consideration, %employer% hands you a paltry sum of crowns.%SPEECH_ON%I don't think you deserve this at all, but having risked your lives for this, perhaps you should get something for the trouble%SPEECH_OFF%}"
        es = "\n\n{Tras pensarlo un momento, %employer% te entrega una suma miserable de coronas.%SPEECH_ON%No creo que se lo merezcan en absoluto, pero, ya que han arriesgado la vida por esto, quizá deberían recibir algo por las molestias%SPEECH_OFF%}"
    }
