    // FILE: scripts\items\legend_armor\armor_upgrades\legend_pauldron_heavy_upgrade.nut
    // context: legend_pauldron_heavy_upgrade.create.m.Name
    {
        en = "Heavy Pauldrons"
        es = "Espaldares pesados"
    }
    // context: legend_pauldron_heavy_upgrade.create.m.Description
    {
        en = "Extremely heavy segments of iron plate, but excellent for protecting shoulders and arms. Worn over armor, they can help deflect incoming blows."
        es = "Segmentos de placa de hierro extremadamente pesados, pero excelentes para proteger hombros y brazos. Llevados sobre la armadura, ayudan a desviar los golpes."
    }
    // context: legend_pauldron_heavy_upgrade.create.m.ArmorDescription
    {
        en = "Includes a set of heavy pauldrons."
        es = "Incluye un juego de hombreras pesadas."
    }
    // FILE: scripts\items\legend_armor\armor_upgrades\legend_pauldron_named_upgrade.nut
    // context: legend_pauldron_named_upgrade.create.m.Description
    {
        en = "Sturdy segments of worked iron, beautifully decorated and excellent for protecting shoulders and arms. Worn over armor, they can help deflect incoming blows."
        es = "Robustos segmentos de hierro trabajado, bellamente decorados y excelentes para proteger hombros y brazos. Llevados sobre la armadura, ayudan a desviar los golpes."
    }
    // context: legend_pauldron_named_upgrade.create.m.ArmorDescription
    {
        en = "Includes a set of sturdy decorated pauldrons."
        es = "Incluye un juego de robustas hombreras decoradas."
