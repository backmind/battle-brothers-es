        mode = "pattern"
        en = "This item is inscribed with a rune sigil, even though it shouldn't have been: please report this bug. Variant = <variant:int>"
        es = "Este objeto tiene inscrito un sigilo rúnico, aunque no debería tenerlo: por favor, informa de este error. Variante = <variant>"
    }
    // context: item.o.updateRuneSigilToken.m.Name
    {
        en = "Unknown Rune Sigil: Error"
        es = "Sello rúnico desconocido: Error"
    }
    // context: item.o.updateRuneSigilToken.m.Description
    {
        en = "An inscribed rock that cannot be attached to a character's equipment."
        es = "Una piedra inscrita que no se puede acoplar al equipo de un personaje."
    }
    // context: item.o.updateRuneSigil.m.Name.find()
    // en = "<this.m.Name.find((Runed))==null>"  // expresión de código, no es texto
    // context: item.o.updateRuneSigil.m.Name
    {
        // this.m.Name =  this.m.Name + "[color=" + this.Const.UI.Color.RuneColor + "] (Runed)[/color]";
        mode = "pattern"
        en = "<name:str>[color=<color:str>] (Runed)[/color]"
        es = "<name:t>[color=<color>] (con runas)[/color]"
    }
    // FILE: mod_legends\hooks\items\legend_helmets\helm\legend_helmet_skin_helm.nut
    // context: legend_helmet_skin_helm.o.getTooltip.result.push().text
    {
        // corrige base: "Puntos" por "puntos" (mayúscula indebida) y falta el punto final que lleva el inglés.
        en = "Regenerates itself by [color=%positive%]90[/color] points of durability each turn."
        es = "Regenera [color=%positive%]90[/color] puntos de su propia durabilidad por turno."
    }
    // FILE: mod_legends\hooks\items\loot\golden_chalice_item.nut
    // context: golden_chalice_item.o.create.m.Description
    {
        en = "A drinking cup made from glinting gold. Should be worth a lot if you can find a buyer."
        es = "Un vaso para beber hecho de oro reluciente. Debería valer mucho si puedes encontrar un comprador."
    }
    // FILE: mod_legends\hooks\items\loot\webbed_valuables_item.nut
    // context: webbed_valuables_item.o.create.m.Description
    {
        en = "Within the thick webs of webknechts sometimes valuables that once belonged to their unfortunate victims can be discovered - if one is brave enough to search through the sticky deathtraps."
        es = "Dentro de las espesas redes de los webknechts a veces se pueden descubrir objetos de valor que alguna vez pertenecieron a sus desafortunadas víctimas, si uno es lo suficientemente valiente como para buscar a través de las pegajosas trampas mortales."
    }
    // FILE: mod_legends\hooks\items\misc\kraken_horn_plate_item.nut
    // en = "Taken from the head of the legendary kraken, this large and hard horn plate is a trophy few in this world can claim."
    // en base_es
    // FILE: mod_legends\hooks\items\misc\miracle_drug_item.nut
    // context: miracle_drug_item.create.m.Description
    {
        // @composicion: this.m.Description += ... (descripción del juego base + la de Legends).
        // La suma llega entera a Rosetta; los trozos de abajo no llegan nunca solos.
        en = "A powerful remedy against many common illnesses and diseases, to reduce inflammation, and to support the body's natural healing.\n\nCharacters treated with this drug will recover faster from injuries, just like if they've been treated at a temple.\n\nIritable and Headache will be treated instantly allowing the character to read again."
        es = "Un poderoso remedio contra muchas enfermedades y dolencias comunes, para reducir la inflamación y apoyar la curación natural del cuerpo.\n\nLos personajes tratados con este medicamento se recuperarán más rápido de las lesiones, como si hubieran sido tratados en un templo.\n\nIrritable y Dolor de cabeza se tratarán al instante, lo que permitirá al personaje volver a leer."
    }
    // context: miracle_drug_item.o.create
    {
        en = "\n\nIritable and Headache will be treated instantly allowing the character to read again."
        es = "\n\nIrritable y Dolor de cabeza se tratarán al instante, lo que permitirá al personaje volver a leer."
    }
    // FILE: mod_legends\hooks\items\shields\beasts\schrat_shield.nut
    // context: schrat_shield.o.create.m.Description
    {
        en = "The hardened bark from a schrat"
        es = "La corteza endurecida de un schrat"
    }
    // FILE: mod_legends\hooks\items\shields\buckler_shield.nut
    // context: buckler_shield.create.m.Description
    {
        // @composicion: this.m.Description += ... (descripción del juego base + la de Legends).
        // La suma llega entera a Rosetta; los trozos de abajo no llegan nunca solos.
        en = "A small but sturdy shield gripped in the fist. Offers poor protection against ranged attacks but can be useful in deflecting blows in melee. Gains defense depending on how many enemies are within 1 tile."
        es = "Un escudo pequeño pero resistente agarrado en el puño. Ofrece poca protección contra ataques a distancia, pero puede ser útil para desviar golpes cuerpo a cuerpo. Gana defensa según cuántos enemigos haya a 1 casilla."
    }
    // context: buckler_shield.o.create
    {
        en = " Gains defense depending on how many enemies are within 1 tile."
        es = " Gana defensa según cuántos enemigos haya a 1 casilla."
    }
    // FILE: mod_legends\hooks\items\shields\shield.nut
    // context: shield.o.getTooltip.result.push().text
    {
        // text = "Reduces any ranged damage taken by [color=%negative%]-" + 2 * this.m.RangedDefense + "%[/color]"
        mode = "pattern"
        en = "Reduces any ranged damage taken by [color=%negative%]-<v:int>%[/color]"
        es = "Reduce todo el daño a distancia recibido en [color=%negative%]-<v>%[/color]"
    }
    // context: shield.o.getTooltip.result.push().text
    {
        en = "When scrapped, rune will be refunded"
        es = "Al desguazarlo, se recupera la runa"
    }
    // FILE: mod_legends\hooks\items\special\fountain_of_youth_item.nut
    // context: fountain_of_youth_item.o.getTooltip.result.push().text
    {
        en = "Will remove all temporary, permanent and prosthetic injuries, as well as the Old, Addicted, Exhausted and Hangover traits and status effects."
        es = "Eliminará todas las lesiones temporales, permanentes y protésicas, así como los rasgos y efectos de estado de Viejo, Adicto, Exhausto y Resaca."
    }
    // FILE: mod_legends\hooks\items\special\golden_goose_item.nut
    // context: golden_goose_item.o.getTooltip.result[index].text
    {
        en = "Generates [color=%positive%]50[/color] crowns daily."
        es = "Genera [color=%positive%]50[/color] coronas al día."
    }
    // FILE: mod_legends\hooks\items\stash_container.nut
    // context: stash_container.o.upgrade.sourceItem.SuperName.find()
    // en = "<sourceItem.SuperName.find(upgrade)!=null||sourceItem[sourceItem.SuperName].SuperName.find(upgrade)!=null&&targetItem.SuperName.find(upgrade)==null>"  // expresión de código, no es texto
    // FILE: mod_legends\hooks\items\supplies\beer_item.nut
    // context: beer_item.o.create.m.Description
    {
        en = "Provisions. This fermented hop or barley drink is more durable and safer to drink than plain water.  Can either be consumed as provisions or drunk in battle"
        es = "Provisiones. Esta bebida fermentada de lúpulo o cebada es más duradera y segura de beber que el agua corriente.  Puede consumirse como provisión o beberse en combate"
    }
    // FILE: mod_legends\hooks\items\supplies\cured_rations_item.nut
    // context: cured_rations_item.o.create.m.Description
    {
        en = "Provisions. These rations consist of assorted, well cured meats and vegetables that are sealed in small boxes. The ideal provision to take with you on long journeys and expeditions. Can be eaten in battle to provide up to 5 healing and fatigue recovery over ten turns, based on the amount remaining. Will be used as provisions if left in the company stash."
        es = "Provisiones. Estas raciones consisten en carnes y verduras variadas y bien curadas, selladas en pequeñas cajas. La provisión ideal para llevar en viajes largos y expediciones. Se pueden comer en combate para obtener hasta 5 de curación y recuperación de fatiga a lo largo de diez turnos, según la cantidad restante. Se usarán como provisiones si se dejan en el inventario de la compañía."
    }
    // FILE: mod_legends\hooks\items\supplies\cured_venison_item.nut
    // context: cured_venison_item.o.create.m.Description
    {
        en = "Provisions. A cured chunk of venison preserved by salt. Fine food for a travelling sellsword. Can be eaten in battle to provide healing and fatigue recovery over ten turns. Will be used as provisions if left in the company stash"
        es = "Provisiones. Un trozo de venado curado, conservado en sal. Buena comida para un mercenario en camino. Se puede comer en combate para obtener curación y recuperación de fatiga a lo largo de diez turnos. Se usará como provisión si se deja en el inventario de la compañía"
    }
    // FILE: mod_legends\hooks\items\supplies\dates_item.nut
    // context: dates_item.o.create.m.Name
    {
        en = "Dried Dates"
        es = "Dátiles secos"
    }
    // context: dates_item.o.create.m.Description
    {
        en = "Provisions. Dried dates are common in the south. These sweet, dried fruits are high energy and well preserved. They are dried to preserve them longer. Can be eaten in battle to provide up to 2 healing and fatigue recovery over ten turns, based on the amount remaining. Will be used as provisions if left in the company stash."
        es = "Provisiones. Los dátiles secos son comunes en el sur. Estas frutas dulces y secas son muy energéticas y se conservan bien. Se secan para que duren más. Se pueden comer en combate para obtener hasta 2 de curación y recuperación de fatiga a lo largo de diez turnos, según la cantidad restante. Se usarán como provisiones si se dejan en el inventario de la compañía."
    }
    // FILE: mod_legends\hooks\items\supplies\dried_fish_item.nut
    // context: dried_fish_item.o.create.m.Description
    {
        en = "Provisions. Fish is a common and filling food in coastal regions. It is dried to preserve it. Can be eaten in battle to provide up to 2 healing and fatigue recovery over ten turns, based on the amount remaining. Will be used as provisions if left in the company stash."
        es = "Provisiones. El pescado es un alimento común y saciante en las regiones costeras. Se seca para conservarlo. Se puede comer en combate para obtener hasta 2 de curación y recuperación de fatiga a lo largo de diez turnos, según la cantidad restante. Se usará como provisión si se deja en el inventario de la compañía."
    }
    // FILE: mod_legends\hooks\items\supplies\dried_fruits_item.nut
    // context: dried_fruits_item.o.create.m.Description
    {
        en = "Provisions. Fruits from orchards are both tasty and nutritious. They are dried to preserve them longer. Can be eaten in battle to provide up to 3 healing and fatigue recovery over ten turns, based on the amount remaining. Will be used as provisions if left in the company stash."
        es = "Provisiones. La fruta de los huertos es sabrosa y nutritiva. Se seca para que dure más. Se puede comer en combate para obtener hasta 3 de curación y recuperación de fatiga a lo largo de diez turnos, según la cantidad restante. Se usará como provisión si se deja en el inventario de la compañía."
    }
    // FILE: mod_legends\hooks\items\supplies\dried_lamb_item.nut
    // context: dried_lamb_item.o.create.m.Description
    {
        en = "Provisions. Dried Lamb is a speciality and a highy sought-after food in the south. A real treat for any hungry mercenary. Can be eaten in battle to provide up to 3 healing and fatigue recovery over ten turns, based on the amount remaining. Will be used as provisions if left in the company stash."
        es = "Provisiones. El Cordero seco es una especialidad y un alimento muy codiciado en el sur. Todo un manjar para cualquier mercenario hambriento. Se puede comer en combate para obtener hasta 3 de curación y recuperación de fatiga a lo largo de diez turnos, según la cantidad restante. Se usará como provisión si se deja en el inventario de la compañía."
    }
    // FILE: mod_legends\hooks\items\supplies\fermented_unhold_heart_item.nut
    // en = "Provisions. Once a delicacy for barbarian kings of the north who wished to embolden their virility, fermented unhold heart tastes distinctively awful."
    // en base_es
    // FILE: mod_legends\hooks\items\supplies\ground_grains_item.nut
    // context: ground_grains_item.o.create.m.Description
    {
        en = "Provisions. Various kinds of grounded grain that will be cooked up with water or milk for a daily meal. It is satiating but tasteless. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Diversos tipos de grano molido que se cuecen con agua o leche para la comida diaria. Sacia, pero no sabe a nada. Se puede comer en combate para obtener hasta 1 de curación y recuperación de fatiga a lo largo de diez turnos, según la cantidad restante. Se irá usando como provisión si se deja en el inventario de la compañía."
    }
    // FILE: mod_legends\hooks\items\supplies\mead_item.nut
    // context: mead_item.o.create.m.Description
    {
        en = "Provisions. An alcoholic beverage made from honey. Both durable and tasty. Can be drunk in battle to grant +9% resolve, melee and ranged skill. At the expense of -36% initiative and -18% melee defense and ranged defense, the effect lasts for three turns. Will be used as provisions while travelling if left in the company stash."
        es = "Provisiones. Una bebida alcohólica hecha con miel. Duradera y sabrosa. Se puede beber en combate para obtener +9% de Resolución, Habilidad cuerpo a cuerpo y Habilidad a distancia, a costa de -36% de Iniciativa y -18% de Defensa cuerpo a cuerpo y Defensa a distancia; el efecto dura tres turnos. Se usará como provisión durante los viajes si se deja en el inventario de la compañía."
    }
    // FILE: mod_legends\hooks\items\supplies\pickled_mushrooms_item.nut
    // en = "Provisions. Swampy regions offer little food, but pickled mushrooms are a favoured provision for travelers in these areas."
    // en base_es
    // FILE: mod_legends\hooks\items\supplies\preserved_mead_item.nut
    // context: preserved_mead_item.o.create.m.Description
    {
        en = "Provisions. This ashen liquid has small sparkles of silver swirrling about. The taste is off, but it hardly ever spoils. Can be drunk in battle to grant +9% resolve, melee and ranged skill in exchange for -36% initiative, and -18% melee defense and ranged defense. The effect lasts for three turns."
        es = "Provisiones. En este líquido ceniciento se arremolinan pequeños destellos plateados. El sabor es raro, pero casi nunca se echa a perder. Se puede beber en combate para obtener +9% de Resolución, Habilidad cuerpo a cuerpo y Habilidad a distancia a cambio de -36% de Iniciativa y -18% de Defensa cuerpo a cuerpo y Defensa a distancia. El efecto dura tres turnos."
    }
    // FILE: mod_legends\hooks\items\supplies\rice_item.nut
    // context: rice_item.o.create.m.Description
    {
        en = "Provisions. Rice is cheap and readily available in the south. Spiced up with various herbs it becomes a tasty dish. Can be eaten in battle to provide up to 2 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. El arroz es barato y abunda en el sur. Sazonado con diversas hierbas se convierte en un plato sabroso. Se puede comer en combate para obtener hasta 2 de curación y recuperación de fatiga a lo largo de diez turnos, según la cantidad restante. Se irá usando como provisión si se deja en el inventario de la compañía."
    }
    // FILE: mod_legends\hooks\items\supplies\roots_and_berries_item.nut
    // context: roots_and_berries_item.o.create.m.Name
    {
        en = "Dried Roots and Berries"
        es = "Raíces y bayas secas"
    }
    // context: roots_and_berries_item.o.create.m.Description
    {
        en = "Provisions. Dried roots and berries are not the most exciting of rations but easy to come by and durable. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Las raíces y bayas secas no son las raciones más emocionantes, pero son fáciles de conseguir y duraderas. Se pueden comer en combate para obtener hasta 1 de curación y recuperación de fatiga a lo largo de diez turnos, según la cantidad restante. Se irán usando como provisiones si se dejan en el inventario de la compañía."
    }
    // FILE: mod_legends\hooks\items\supplies\smoked_ham_item.nut
    // context: smoked_ham_item.o.create.m.Description
    {
        en = "Provisions. There are many ways to preserve food. This piece of ham has been treated in a smoking hut. Can be eaten in battle to provide up to 3 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Hay muchas formas de conservar la comida. Este trozo de jamón se ha curado en un ahumadero. Se puede comer en combate para obtener hasta 3 de curación y recuperación de fatiga a lo largo de diez turnos, según la cantidad restante. Se irá usando como provisión si se deja en el inventario de la compañía."
    }
    // FILE: mod_legends\hooks\items\supplies\strange_meat_item.nut
    // en = "Provisions. Meat of indefinable origin. Eating this may seem risky, but is preferable to starving."
    // en base_es
    // FILE: mod_legends\hooks\items\supplies\wine_item.nut
    // context: wine_item.o.create.m.Description
    {
        en = "Provisions. Wine made from squashed and fermented grapes. Both elaborate to produce and expensive to buy. Can be drunk in battle to gain +6% resolve, melee and ranged skill, at the expense of -12% initiative, melee and ranged defense. Will be used as provisions if left in the company stash"
        es = "Provisiones. Vino hecho de uvas prensadas y fermentadas. Costoso de elaborar y caro de comprar. Se puede beber en combate para obtener +6% de Resolución, Habilidad cuerpo a cuerpo y Habilidad a distancia, a costa de -12% de Iniciativa, Defensa cuerpo a cuerpo y Defensa a distancia. Se usará como provisión si se deja en el inventario de la compañía"
    }
    // FILE: mod_legends\hooks\items\tools\acid_flask_item.nut
    // context: acid_flask_item.o.create.m.Description
    {
        en = "A flask filled with the concentrate of a Lindwurm's acidic blood. It is highly corrosive to many materials and burns through armor quickly. Can be thrown at short ranges. If the company has Alchemy Tools, this item is refilled after each battle, consuming 30 ammunition per use."
        es = "Un frasco lleno del concentrado de la sangre ácida de un Lindwurm. Es altamente corrosivo para muchos materiales y quema rápidamente la armadura. Se puede lanzar a distancias cortas. Si la compañía tiene Herramientas de alquimia, este objeto se rellena después de cada batalla, consumiendo 30 de munición por uso."
    }
    // en = "Worn in Offhand"
    // en base_es
    // context: acid_flask_item.o.getTooltip.result.extend().text
    {
        // text = "Range of [color=%positive%]" + this.m.RangeMax + "[/color] tiles"
        mode = "pattern"
        en = "Range of [color=%positive%]<v:int>[/color] tiles"
        es = "Alcance de [color=%positive%]<v>[/color] casillas"
    }
    // context: acid_flask_item.o.getTooltip.result.extend().text
    {
        en = "Reduces the target's armor by [color=%damage%]20%[/color] each turn for 3 turns"
        es = "Reduce la armadura del objetivo en un [color=%damage%]20%[/color] cada turno durante 3 turnos"
    }
    // context: acid_flask_item.o.getTooltip.result.extend().text
    {
        en = "Has a [color=%damage%]33%[/color] chance to hit bystanders at the same or lower height level as well"
        es = "Tiene además un [color=%damage%]33%[/color] de probabilidad de alcanzar a quienes estén cerca a la misma altura o más abajo"
    }
    // context: acid_flask_item.o.getTooltip.result.push().text
    {
        en = "Cannot be refilled after battle, because this company has no Alchemy Tools"
        es = "No se puede rellenar tras la batalla porque esta compañía no tiene Herramientas de alquimia"
    }
    // en = "Acid Flask"
    // en base_es
    // context: acid_flask_item.o.setAmmo.m.Name
    {
        en = "Acid Flask (Used)"
        es = "Frasco de ácido (usado)"
    }
    // context: acid_flask_item.o.setAmmo.m.Description
    {
        en = "A spent and shattered flask. If the company has \"Alchemy Tools\", this item is refilled after each battle, consuming 30 ammunition per use."
        es = "Un frasco vacío y hecho añicos. Si la compañía tiene \"Herramientas de alquimia\", este objeto se rellena después de cada batalla, consumiendo 30 de munición por uso."
    }
    // FILE: mod_legends\hooks\items\tools\daze_bomb_item.nut
    // context: daze_bomb_item.o.create.m.Description
    {
        en = "A throwable pot filled with mysterious powders that react violently on impact to create a bright flash and loud bang. Will daze anyone close by. If the company has Alchemy Tools, this item is refilled after each battle, consuming 30 ammunition per use."
        es = "Una vasija arrojadiza llena de polvos misteriosos que reaccionan violentamente al impacto y provocan un destello brillante y un fuerte estruendo. Atontará a cualquiera que esté cerca. Si la compañía tiene Herramientas de alquimia, este objeto se rellena después de cada batalla, consumiendo 30 de munición por uso."
    }
    // context: daze_bomb_item.o.getTooltip.result.extend().text
    {
        // corrige base: "Provocará a <v> objetivos" por "Provocará a hasta <v> objetivos": falta el "up to" del inglés, es un máximo.
        en = "Will give up to [color=%damage%]7[/color] targets the Dazed status effect for 2 turns"
        es = "Provocará a hasta [color=%damage%]7[/color] objetivos el efecto de estado 'Atontado' durante 2 turnos"
    }
    // en = "Flash Pot"
    // en base_es
    // context: daze_bomb_item.o.setAmmo.m.Name
    {
        en = "Flash Pot (Used)"
        es = "Bomba destellante (usada)"
    }
    // context: daze_bomb_item.o.setAmmo.m.Description
    {
        en = "A spent and shattered pot. If the company has \"Alchemy Tools\", this item is refilled after each battle, consuming 30 ammunition per use."
        es = "Una vasija vacía y hecha añicos. Si la compañía tiene \"Herramientas de alquimia\", este objeto se rellena después de cada batalla, consumiendo 30 de munición por uso."
    }
    // FILE: mod_legends\hooks\items\tools\fire_bomb_item.nut
    // context: fire_bomb_item.o.create.m.Description
    {
        en = "A pot filled with highly flammable liquid that will set an area ablaze with fire when thrown. If the company has Alchemy Tools, this item is refilled after each battle, consuming 30 ammunition per use."
        es = "Una vasija llena de un líquido muy inflamable que prende fuego a una zona al lanzarla. Si la compañía tiene Herramientas de alquimia, este objeto se rellena después de cada batalla, consumiendo 30 de munición por uso."
    }
    // context: fire_bomb_item.o.getTooltip.result.extend().text
    {
        en = "Will set [color=%damage%]7[/color] tiles ablaze with burning fire for 2 rounds"
        es = "Prenderá fuego a [color=%damage%]7[/color] casillas durante 2 rondas"
    }
    // context: fire_bomb_item.o.setAmmo.m.Name
    {
        en = "Fire Pot (Used)"
        es = "Frasco de fuego (usado)"
    }
    // FILE: mod_legends\hooks\items\tools\holy_water_item.nut
    // context: holy_water_item.o.create.m.Description
    {
        en = "A flask filled with water blessed by a man of the gods. Can be thrown at short ranges. If the company has Alchemy Tools, this item is refilled after each battle, consuming 30 ammunition per use."
        es = "Un frasco lleno de agua bendecida por un hombre de los dioses. Se puede lanzar a distancias cortas. Si la compañía tiene Herramientas de alquimia, este objeto se rellena después de cada batalla, consumiendo 30 de munición por uso."
    }
    // context: holy_water_item.o.getTooltip.result.extend().text
    {
        en = "Damage of [color=%damage%]20[/color] for [color=%damage%]3[/color] turns to any undead target hit"
        es = "Inflige [color=%damage%]20[/color] de daño durante [color=%damage%]3[/color] turnos a cualquier no muerto alcanzado"
    }
    // context: holy_water_item.o.getTooltip.result.extend().text
    {
        en = "[color=%damage%]100%[/color] of damage ignores armor"
        es = "El [color=%damage%]100%[/color] del daño ignora la armadura"
    }
    // context: holy_water_item.o.getTooltip.result.extend().text
    {
        // text = "Will remove [color=%status%]Battle Forged[/color] from Wichts"
        mode = "pattern"
        en = "Will remove [color=%status%]Battle Forged[/color] from Wichts"
        es = "Eliminará [color=%status%]Forjado en batalla[/color] de los Wichts"
    }
    // context: holy_water_item.o.setAmmo.m.Name
    {
        en = "Holy Water"
