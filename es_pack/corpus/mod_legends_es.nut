        es = "Este cofre contiene objetos de contrabando. Puedes abrirlo, pero puede que a quien te contrató no le haga ninguna gracia."
    }
    // FILE: scripts\items\misc\legend_stollwurm_blood_item.nut
    // context: legend_stollwurm_blood_item.create.m.Name
    {
        en = "Stollwurm Blood"
        es = "Sangre de Stollwurm"
    }
    // context: legend_stollwurm_blood_item.create.m.Description
    {
        en = "The corroding blood of a Stollwurm that eats away at metal in no time. Luckily it can be safely transported in glass vials."
        es = "La sangre corrosiva de un Stollwurm que devora el metal en un instante. Por suerte, se puede transportar de forma segura en viales de vidrio."
    }
    // FILE: scripts\items\misc\legend_stollwurm_scales_item.nut
    // context: legend_stollwurm_scales_item.create.m.Description
    {
        en = "The shimmering green scales of a stollwurm are among the most reputable trophies a beast hunter can bring home from his adventures."
        es = "Las brillantes escamas verdes de un Stollwurm se encuentran entre los trofeos más reputados que un cazador de bestias puede llevarse a casa después de sus aventuras."
    }
    // FILE: scripts\items\misc\legend_trait_skill_book_item.nut
    // context: legend_trait_skill_book_item.::inherit().m.BookName
    {
        en = "Astrology and Tarot Readings:"
        es = "Lecturas de astrología y tarot:"
    }
    // context: legend_trait_skill_book_item.::inherit().create.m.Name
    {
        en = "Traits for the gullible"
        es = "Rasgos para crédulos"
    }
    // context: legend_trait_skill_book_item.::inherit().create.m.Description
    {
        en = "A gathering of absolutely correct occult readings that give insight into developing new traits. Will teach the relevant [color=%negative%]Trait[/color] perk group to the character that uses it. Can only read one skill book per brother so choose wisely. You can still read Ancient Scrolls if permitted."
        es = "Una recopilación de lecturas ocultistas absolutamente certeras que dan pistas sobre cómo desarrollar nuevos rasgos. Enseñará el grupo de ventajas de [color=%negative%]Rasgo[/color] correspondiente al personaje que lo use. Solo se puede leer un libro de habilidades por hermano, así que elige bien. Aún puedes leer Pergaminos antiguos si se permite."
    }
