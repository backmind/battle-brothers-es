    // en = "<actor:str_tag> is charmed"
    // en base_es
    // FILE: mod_legends\hooks\skills\actives\chop.nut
    // context: chop.o.setItem.m.Name
    {
        en = "Hack"
        es = "Hachazo"
    }
    // context: chop.o.setItem.m.Description
    {
        en = "A powerful hacking attack that bears full force on any target."
        es = "Un potente ataque de tajo que descarga toda su fuerza sobre cualquier objetivo."
    }
    // context: chop.o.setItem.m.KilledString
    {
        en = "Hacked up"
        es = "Despedazado"
    }
    // FILE: mod_legends\hooks\skills\actives\cleave.nut
    // context: cleave.o.setItem.m.Description
    {
        en = "A sweeping cleave that can be used from behind the frontline and can inflict bleeding wounds if there is no armor absorbing the blow and if the target is able to bleed at all."
        es = "Un tajo amplio que puede usarse desde detrás de la primera línea y que puede infligir heridas sangrantes si ninguna armadura absorbe el golpe y si el objetivo puede sangrar."
    }
    // en = "Cleaved"
    // en base_es
    // context: cleave.o.getTooltip.ret.push().text
    {
        // text = "Inflicts additional stacking [color=%damage%]" + dmg + "[/color] bleeding damage per turn, for 2 turns"
        // corrige base: «Inflige <bleeddamage> daño» por «Inflige <bleeddamage> de daño»: falta la preposición tras la cifra
        mode = "pattern"
        en = "Inflicts additional stacking [color=%damage%]<dmg:int>[/color] bleeding damage per turn, for 2 turns"
        es = "Inflige [color=%damage%]<dmg>[/color] de daño de sangrado acumulable adicional por turno, durante [color=%damage%]2[/color] turnos"
    }
    // FILE: mod_legends\hooks\skills\actives\coat_with_poison_skill.nut
    // context: coat_with_poison_skill.o.create.m.Description
    {
        en = "Coat your weapons and arrowtips with poison. Can not be used while engaged in melee. Costs 0 Action Points during the first round of combat."
        es = "Recubre tus armas y puntas de flecha con veneno. No se puede utilizar mientras se está en combate cuerpo a cuerpo. Cuesta [color=#135213]0[/color] Puntos de acción durante la primera ronda de combate."
    }
    // FILE: mod_legends\hooks\skills\actives\crush_armor.nut
    // context: crush_armor.o.create.m.Description
    {
        // corrige base: «al usuario» confunde a quien ataca con quien lleva la armadura; «wearer» es «quien la lleva puesta»
        en = "Using the weapon to batter, deform, rip and otherwise render the target's armor unusable with great effect. Although the impact will be felt through the thickest of armor, it won't greatly injure the wearer."
        es = "Usar el arma para golpear, deformar, rasgar o inutilizar la armadura del objetivo con gran efecto. Aunque el impacto se sentirá a través de la armadura más gruesa, no herirá gravemente a quien la lleve puesta."
    }
    // context: crush_armor.o.getTooltip.tooltip.push().text
    {
        // text = "Inflicts [color=%damage%]" + damage_armor_min + "[/color] - [color=%damage%]" + damage_armor_max + "[/color] damage to armor"
        mode = "pattern"
        en = "Inflicts [color=%damage%]<min:int>[/color] - [color=%damage%]<max:int>[/color] damage to armor"
        es = "Inflige [color=%damage%]<min>[/color] - [color=%damage%]<max>[/color] de daño a la armadura"
    }
    // context: crush_armor.o.getTooltip.tooltip.push().text
    {
        // text = "Always inflicts at least [color=%damage%]" + p.DamageMinimum + "[/color] damage to hitpoints, regardless of armor"
        mode = "pattern"
        en = "Always inflicts at least [color=%damage%]<v:int>[/color] damage to hitpoints, regardless of armor"
        es = "Siempre inflige al menos [color=%damage%]<v>[/color] de daño a los puntos de vida, sin importar la armadura"
    }
    // FILE: mod_legends\hooks\skills\actives\deathblow_skill.nut
    // context: deathblow_skill.o.getTooltip.tooltip.push().text
    {
        en = "Inflicts [color=%damage%]50%[/color] more damage against and ignores additional [color=%damage%]33%[/color] armor of targets that have the Baffled, Dazed, Stunned, Sleeping, Rooted, Distracted, Webbed, Trapped in Net, Staggered, Shellshocked, Tackled, Debilitated or Grappled status effects."
        es = "Inflige un [color=%damage%]50%[/color] más de daño e ignora un [color=%damage%]33%[/color] adicional de la armadura de los objetivos que tengan los efectos de estado Desconcertado, Atontado, Aturdido, Durmiendo, Enraizado, Distraído, Enredado en telarañas, Atrapado en una red, Tambaleante, Conmocionado, Derribado, Debilitado o Agarrado."
    }
    // context: deathblow_skill.o.getTooltip.tooltip.push().text
    {
        en = "Inflicts [color=%damage%]33%[/color] more damage against and ignores additional [color=%damage%]20%[/color] armor of targets that have the Baffled, Dazed, Stunned, Sleeping, Rooted, Distracted, Webbed, Trapped in Net, Staggered, Shellshocked, Tackled, Debilitated or Grappled status effects."
        es = "Inflige un [color=%damage%]33%[/color] más de daño e ignora un [color=%damage%]20%[/color] adicional de la armadura de los objetivos que tengan los efectos de estado Desconcertado, Atontado, Aturdido, Durmiendo, Enraizado, Distraído, Enredado en telarañas, Atrapado en una red, Tambaleante, Conmocionado, Derribado, Debilitado o Agarrado."
    }
    // FILE: mod_legends\hooks\skills\actives\debilitate.nut
    // context: debilitate.o.getDescription
    {
        en = "Prepare your next attack to debilitate a target for one turn, reducing their ability to inflict damage by [color=%negative%]-25%[/color] and increasing the damage they take by [color=%positive%]-15%[/color]. Missing the target will waste the effect."
        es = "Prepara tu siguiente ataque para debilitar a un objetivo durante un turno, reduciendo su capacidad de infligir daño en un [color=%positive%]-25%[/color] y aumentando el daño que recibe en un [color=%positive%]-15%[/color]. Fallar el ataque desperdiciará el efecto."
    }
    // FILE: mod_legends\hooks\skills\actives\decapitate.nut
    // context: decapitate.o.setItem.m.Description
    {
        // corrige base: las comillas de 'puede' son un énfasis que el inglés no tiene ("if at all possible")
        en = "A devastating blow that can be used from behind the frontline, aimed to decapitate the target on the spot. Does more damage to hitpoints, the more the target is already wounded. Killing the target will always decapitate it, if at all possible."
        es = "Un golpe devastador que puede usarse desde detrás de la primera línea, destinado a decapitar al objetivo en el acto. Hace más daño a los Puntos de vida cuanto más herido esté el objetivo. Matar al objetivo siempre lo decapitará, si es que es posible."
    }
    // context: decapitate.o.getTooltip.ret.insert().text
    {
