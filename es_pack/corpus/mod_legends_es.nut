    }
    // context: legend_field_treats_skill.getTooltip.ret.push().text
    {
        en = "Spend [color=%negative%]-20[/color] food to raise moral state of adjacent ally from wavering to steady."
        es = "Gasta [color=%negative%]-20[/color] de comida para elevar la moral de un aliado adyacente de vacilante a firme."
