    }
    // context: legend_hold_the_line.getTooltip.tooltip.extend().text
    {
        en = "Gain [color=%positive%]+10[/color] Ranged Defense"
        es = "Gana [color=%positive%]+10[/color] de Defensa a distancia"
    }
    // context: legend_hold_the_line.getTooltip.tooltip.extend().text
    {
        en = "Receive only [color=%positive%]90%[/color] of any damage"
        es = "Recibe solo el [color=%positive%]90%[/color] de cualquier daño"
    }
    // FILE: scripts\skills\actives\legend_holyflame_skill.nut
    // context: legend_holyflame_skill.create.m.Description
    {
        // this.m.Description = "Bless an area and apply hallowed ground over a 1-tile radius for " + ::Const.UI.getColorized("2", ::Const.UI.Color.PositiveValue) + " turns. The holy shall be sanctified when entering, the damned shall be consecrated.";
        mode = "pattern"
        en = "Bless an area and apply hallowed ground over a 1-tile radius for <turns:val_tag> turns. The holy shall be sanctified when entering, the damned shall be consecrated."
        es = "Bendice un área y convierte en suelo sagrado un radio de [color=#135213]1[/color] casilla durante <turns> turnos. Los santos quedarán santificados al entrar; los condenados, consagrados."
    }
    // context: legend_holyflame_skill.getTooltip.ret.extend().text
    {
        en = "Allies gain the Sanctified effect, becoming immune to injuries, bleeding, poison, and morale checks when taking damage"
        es = "Los aliados obtienen el efecto Santificado y se vuelven inmunes a las heridas, el sangrado, el veneno y las comprobaciones de moral al recibir daño"
    }
    // context: legend_holyflame_skill.getTooltip.ret.extend().text
    {
        en = "Undead and Cultists gain the Consecrated effect, dealing damage to them each turn and removing their immunity to injuries, bleeding, and being poisoned"
        es = "Los no muertos y los Cultistas obtienen el efecto Consagrado, que les inflige daño cada turno y elimina su inmunidad a las heridas, al sangrado y al envenenamiento"
    }
    // context: legend_holyflame_skill.getTooltip.ret.extend().text
    {
        en = "Undead are unable to resurrect in the area while the flame is active"
        es = "Los no muertos no pueden resucitar en el área mientras la llama esté activa"
    }
    // context: legend_holyflame_skill.onUse.p.Tooltip
    {
        en = "This is hallowed ground.\n\nAllies gain the Sanctified effect, becoming immune to injuries, bleeding, poison, and morale checks when taking damage.\n\nUndead and Cultists gain the Consecrated effect, dealing damage to them each turn and removing any immunity to injuries, bleeding, and being poisoned.\n\nAdditionally, Undead are unable to resurrect in the area while the flame is active."
        es = "Esto es suelo sagrado.\n\nLos aliados obtienen el efecto Santificado y se vuelven inmunes a las heridas, el sangrado, el veneno y las comprobaciones de moral al recibir daño.\n\nLos no muertos y los Cultistas obtienen el efecto Consagrado, que les inflige daño cada turno y elimina cualquier inmunidad a las heridas, al sangrado y al envenenamiento.\n\nAdemás, los no muertos no pueden resucitar en el área mientras la llama esté activa."
    }
    // FILE: scripts\skills\actives\legend_horrific_scream.nut
    // context: legend_horrific_scream.create.m.Description
    {
        en = "Blare out a piercing, unworldly sound that is more than likely to distress anyone unfortunate enough to hear it within 4 tiles. Uses ranged skill."
        es = "Emite un sonido penetrante y sobrenatural que muy probablemente angustiará a cualquiera que tenga la desgracia de oírlo en un radio de [color=#135213]4[/color] casillas. Usa la Habilidad a distancia."
    }
    // en = "<actor:str_tag> uses Horrific Scream"
    // en base_es
    // FILE: scripts\skills\actives\legend_horrify_old_skill.nut
    // context: legend_horrify_old_skill.create.m.Description
    {
        en = "Blare out a piercing, unworldly sound that is more than likely to distress anyone unfortunate enough to hear it."
        es = "Emite un sonido penetrante y sobrenatural que muy probablemente angustiará a cualquiera que tenga la desgracia de oírlo."
    }
    // context: legend_horrify_old_skill.getTooltip.ret.push().text
    // en = "Inflicts [color=%damage%]<this.Const.Combat.FatigueReceivedPerHit*4>[/color] extra fatigue"  // cubierto por el patrón "Inflicts [color=%damage%]<fatigue:int>[/color] extra fatigue"
    // context: legend_horrify_old_skill.getTooltip.ret.push().text
    {
        en = "Has a [color=%positive%]100%[/color] chance to horrify on a hit"
        es = "Tiene un [color=%positive%]100%[/color] de probabilidad de horrorizar al impactar"
    }
    // context: legend_horrify_old_skill.onUse.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(_user) + " struck a blow that leaves " + this.Const.UI.getColorizedEntityName(target) + " horrified");
        mode = "pattern"
        en = "<user:str> struck a blow that leaves <target:str> horrified"
        es = "<user> asestó un golpe que deja a <target> presa del horror"
    }
    // FILE: scripts\skills\actives\legend_horse_charge_skill.nut
    // context: legend_horse_charge_skill.create.m.Description
    {
        en = "Push your mount forward with speed, ending in an impact that stuns an enemy."
        es = "Lanza a tu montura hacia delante a toda velocidad y remata con un impacto que aturde a un enemigo."
    }
    // FILE: scripts\skills\actives\legend_horse_kick_skill.nut
    // context: legend_horse_kick_skill.create.m.Description
    {
        en = "The main attack of a horse, more for defense than attack. Maximum damage is the average of your hitpoints and initiative minus 90."
        es = "El ataque principal de un caballo, más defensivo que ofensivo. El daño máximo es la media de tus Puntos de vida y tu Iniciativa menos 90."
    }
    // FILE: scripts\skills\actives\legend_horse_pirouette_skill.nut
    // context: legend_horse_pirouette_skill.create.m.Description
    {
        en = "Learning to turn quickly allows the rapid changes in direction required to leave a Zone of Control without triggering free attacks."
        es = "Aprender a girar con rapidez permite los bruscos cambios de dirección necesarios para abandonar una Zona de Control sin provocar ataques gratuitos."
    }
    // context: legend_horse_pirouette_skill.getTooltip.ret.push().text
    {
        en = "[color=%negative%]Can only be used when in an opponent's Zone of Control[/color]"
        es = "[color=%negative%]Solo se puede usar dentro de la Zona de Control de un oponente[/color]"
    }
    // FILE: scripts\skills\actives\legend_incoming_skill.nut
    // context: legend_incoming_skill.create.m.Description
    {
        en = "This mercenary has received clear instructions to keep their head down, and is coordinating accordingly."
        es = "Ha recibido instrucciones claras de mantener la cabeza agachada y se coordina en consecuencia."
    }
    // context: legend_incoming_skill.getTooltip.text
    {
        en = "[color=%positive%]+5[/color] ranged skill to all allies within [color=%positive%]4[/color] tiles for one turn"
        es = "[color=%positive%]+5[/color] de Habilidad a distancia para todos los aliados en un radio de [color=%positive%]4[/color] casillas durante un turno"
    }
    // context: legend_incoming_skill.getTooltip.text
    {
        en = "[color=%positive%]+5[/color] resolve to all allies within [color=%positive%]4[/color] tiles for one turn"
        es = "[color=%positive%]+5[/color] de Resolución para todos los aliados en un radio de [color=%positive%]4[/color] casillas durante un turno"
    }
    // context: legend_incoming_skill.getTooltip.text
    {
        en = "[color=%positive%]+10[/color] ranged defence to all allies within [color=%positive%]4[/color] tiles for one turn"
        es = "[color=%positive%]+10[/color] de Defensa a distancia para todos los aliados en un radio de [color=%positive%]4[/color] casillas durante un turno"
    }
    // FILE: scripts\skills\actives\legend_inspire_skill.nut
    // context: legend_inspire_skill.create.m.Description
    {
        en = "You can do it! Inspire an ally to go to their limit and beyond, granting them additional Action Points. Targets can only be inspired once per turn."
        es = "¡Tú puedes! Inspira a un aliado para que llegue a su límite y lo supere, otorgándole Puntos de acción adicionales. Cada objetivo solo puede ser inspirado una vez por turno."
    }
    // context: legend_inspire_skill.getTooltip.ret.text
    {
        en = "Grants the target 4 additional Action Points for their next turn."
        es = "Otorga al objetivo [color=#135213]4[/color] Puntos de acción adicionales en su siguiente turno."
    }
    // FILE: scripts\skills\actives\legend_intensely_charm_skill.nut
    // context: legend_intensely_charm_skill.onDelayedEffect.Time.scheduleEvent().Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(target) + " cannot be charmed");
        mode = "pattern"
        en = "<target:str> cannot be charmed"
        es = "No se puede hechizar a <target>"
    }
    // context: legend_intensely_charm_skill.onDelayedEffect.Time.scheduleEvent().Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(target) + " is intensely charmed");
        mode = "pattern"
        en = "<target:str> is intensely charmed"
        es = "<target> cae bajo un hechizo intenso"
    }
    // FILE: scripts\skills\actives\legend_into_the_fray_skill.nut
    // context: legend_into_the_fray_skill.create.m.Description
    {
        en = "Charge at an enemy up to 2 tiles away, attacking them in the process."
        es = "Carga contra un enemigo situado a hasta [color=#135213]2[/color] casillas de distancia y lo ataca de paso."
    }
    // en = "Moves the user next to the target, ignoring Zone of Control"
    // en base_es
    // en = "<open:tag>Can not be used while rooted<close:tag>"
    // en base_es
    // FILE: scripts\skills\actives\legend_kick_skill.nut
    // context: legend_kick_skill.create.m.Description
    {
        en = "Kick a target to break their balance. The blow will inflict additional fatigue, stagger the target, and has a chance to inflict daze as well. Shieldwall, Spearwall, Return Favor, and Riposte will be canceled for a target that is successfully hit."
        es = "Patea a un objetivo para hacerle perder el equilibrio. El golpe inflige Fatiga adicional, deja al objetivo Tambaleante y además puede dejarlo Atontado. Muro de escudos, Muro de lanzas, Devolver el favor y Contraataque se cancelan en un objetivo alcanzado con éxito."
    }
    // context: legend_kick_skill.getTooltip.ret.extend().text
    {
        en = "Has a [color=%positive%]%_dazeChance%[/color] chance to daze on a hit"
        es = "Tiene un [color=%positive%]%_dazeChance%[/color] de probabilidad de atontar al impactar"
    }
    // context: legend_kick_skill.getTooltip.ret.extend().text
    {
        en = "Inflicts [color=%damage%]%_fatigueDamage%[/color] fatigue on hit"
        es = "Inflige [color=%damage%]%_fatigueDamage%[/color] de Fatiga al impactar"
    }
    // en = "<actor:str_tag> struck a blow that leaves <victim:str_tag> dazed"
    // en base_es
    // FILE: scripts\skills\actives\legend_launch_acid_flask_skill.nut
    // context: legend_launch_acid_flask_skill.create.m.Description
    {
        en = "Launch a flask of acid, with your slingstaff, towards a target, where it will shatter and spray its contents. The acid will slowly corrode away any armor of those hit - friend and foe alike."
        es = "Lanza con tu fustíbalo un frasco de ácido hacia un objetivo, donde se hará añicos y esparcirá su contenido. El ácido corroerá lentamente la armadura de los alcanzados, sean amigos o enemigos."
    }
    // context: legend_launch_acid_flask_skill.getTooltip.ret.push().text
    {
        en = "Reduces the target's armor by [color=%damage%]20%[/color] each turn for 3 turns."
        es = "Reduce la armadura del objetivo un [color=%damage%]20%[/color] cada turno por [color=%damage%]3[/color] turnos."
    }
    // context: legend_launch_acid_flask_skill.getTooltip.ret.push().text
    {
        en = "Has a [color=%damage%]33%[/color] chance to hit bystanders at the same or lower height level as well."
        es = "Tiene además un [color=%damage%]33%[/color] de probabilidad de alcanzar a quienes estén cerca a la misma altura o por debajo."
    }
    // context: legend_launch_acid_flask_skill.getTooltip.ret.push().text
    {
        en = "[color=%negative%]No ammo left in backpack[/color]"
        es = "[color=%negative%]No queda munición en la mochila[/color]"
    }
    // FILE: scripts\skills\actives\legend_launch_daze_bomb_skill.nut
    // context: legend_launch_daze_bomb_skill.create.m.Description
    {
        en = "Launch a pot, with your slingstaff, filled with mysterious powders that react violently on impact to create a bright flash and loud bang, and will daze anyone close by - friend and foe alike"
        es = "Lanza con tu fustíbalo una vasija llena de polvos misteriosos que reaccionan violentamente al impactar, creando un destello cegador y un fuerte estallido que atontará a cualquiera que esté cerca, sea amigo o enemigo"
    }
    // context: legend_launch_daze_bomb_skill.getTooltip.ret.push().text
    {
        // corrige base: falta «hasta» ("up to"); «Provoca a» → «Provoca en»
        en = "Give up to [color=%damage%]7[/color] targets the Dazed status effect for 2 turns"
        es = "Provoca en hasta [color=%damage%]7[/color] objetivos el efecto de estado 'Atontado' por [color=%damage%]2[/color] turnos"
    }
    // FILE: scripts\skills\actives\legend_launch_fire_bomb_skill.nut
    // context: legend_launch_fire_bomb_skill.create.m.Description
    {
        en = "Ignite and launch, using your slingstaff, a pot filled with highly flammable liquids towards a target, where it will shatter and set the area ablaze. Anyone ending their turn inside the burning area will catch fire and take damage - friend and foe alike."
        es = "Prende y lanza con tu fustíbalo una vasija llena de líquidos muy inflamables hacia un objetivo, donde se hará añicos y hará arder la zona. Cualquiera que termine su turno dentro de la zona en llamas se prenderá fuego y recibirá daño, sea amigo o enemigo."
    }
    // context: legend_launch_fire_bomb_skill.getTooltip.ret.extend().text
    {
        // corrige base: «arder en llamas ... con fuego» es redundante; se dice «Prende fuego a un área de»
        en = "Set an area of [color=%damage%]7[/color] tiles ablaze with fire for 2 rounds. Water and snow can not burn."
        es = "Prende fuego a un área de [color=%damage%]7[/color] casillas por [color=%damage%]2[/color] turnos. El agua y la nieve no pueden arder."
    }
    // en = "Burns away existing tile effects like Smoke or Miasma"
    // en base_es
    // context: legend_launch_fire_bomb_skill.getTooltip.ret.extend().text
    {
        en = "This damage shown only occurs when an enemy ends turn inside of the area, it does not affect the enemy when thrown"
        es = "El daño mostrado solo se aplica cuando un enemigo termina su turno dentro del área; no afecta al enemigo en el momento del lanzamiento"
    }
    // FILE: scripts\skills\actives\legend_launch_holy_water_skill.nut
    // context: legend_launch_holy_water_skill.create.m.Description
    {
        en = "Launch a flask of blessed water, with your slingstaff, towards a target, where it will shatter and spray its contents. The blessed water will burn the undead, but will not affect other targets."
        es = "Lanza con tu fustíbalo un frasco de agua bendita hacia un objetivo, donde se hará añicos y esparcirá su contenido. El agua bendita quemará a los no muertos, pero no afectará a otros objetivos."
    }
    // context: legend_launch_holy_water_skill.getTooltip.ret.extend().text
    {
        en = "Inflicts [color=%damage%]20[/color] damage to hitpoints for [color=%damage%]3[/color] turns, all of which ignores armor"
        es = "Inflige [color=%damage%]20[/color] de daño a los Puntos de vida durante [color=%damage%]3[/color] turnos, que ignora por completo la armadura"
    }
    // en = "Only affects undead targets"
    // en base_es
    // FILE: scripts\skills\actives\legend_launch_smoke_bomb_skill.nut
    // context: legend_launch_smoke_bomb_skill.create.m.Description
    {
        en = "Ignite and launch, using your slingstaff, a pot filled with substances that upon impact will quickly create a dense cloud."
        es = "Prende y lanza con tu fustíbalo una vasija llena de sustancias que, al impactar, crearán rápidamente una densa nube."
    }
    // context: legend_launch_smoke_bomb_skill.getTooltip.ret.extend().text
    {
        en = "Increases Ranged Defense by [color=%positive%]+100%[/color], but lowers Ranged Skill by [color=%negative%]-50%[/color] for anyone inside"
        es = "Aumenta la Defensa a distancia en un [color=%positive%]+100%[/color], pero reduce la Habilidad a distancia en un [color=%negative%]-50%[/color] a cualquiera que esté dentro"
    }
    // en = "Extinguishes existing tile effects like Fire or Miasma"
    // en base_es
    // FILE: scripts\skills\actives\legend_leap_skill.nut
    // context: legend_leap_skill.create.m.Description
    {
        en = "Learning to jump extended distances allows escape from usually impossible situations. Fatigue cost is 15 plus the weight of your armor. Range can be increased with the Backflip perk, and by taking Staff Mastery and wielding a staff."
        es = "Aprender a saltar grandes distancias permite escapar de situaciones normalmente imposibles. El coste de Fatiga es [color=#8f1e1e]15[/color] más el peso de tu armadura. El alcance puede aumentarse con la ventaja Voltereta atrás, y aprendiendo Dominio del Bastón mágico y empuñando un bastón."
    }
    // context: legend_leap_skill.getTooltip.ret.push().text
    {
        en = "Leap range increased by 1 tile while wielding a staff and having staff mastery"
        es = "El alcance de Salto aumenta en [color=#135213]1[/color] casilla al empuñar un bastón y tener Dominio del Bastón mágico"
    }
    // FILE: scripts\skills\actives\legend_levitate_person_skill.nut
    // context: legend_levitate_person_skill.create.m.Description
    {
        en = "Levitate someone off the ground, granting them the ability to move freely across all terrain."
        es = "Haz levitar a alguien sobre el suelo, lo que le permite moverse libremente por cualquier terreno."
    }
    // context: legend_levitate_person_skill.create.m.KilledString
    {
        en = "Levitated"
        es = "Levitado"
    }
    // context: legend_levitate_person_skill.getTooltip.ret.push().text
    {
        en = "Levitate someone off the ground, granting them the ability to move across all terrain freely"
        es = "Haz levitar a alguien sobre el suelo, lo que le permite moverse por cualquier terreno con libertad"
    }
    // context: legend_levitate_person_skill.onUse.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(_user) + " levitated " + this.Const.UI.getColorizedEntityName(target) + " leaving them free to move");
        mode = "pattern"
        en = "<user:str_tag> levitated <target:str_tag> leaving them free to move"
        es = "<user> hizo levitar a <target>, que ahora puede moverse libremente"
    }
    // FILE: scripts\skills\actives\legend_line_them_up_skill.nut
    // context: legend_line_them_up_skill.create.m.Description
    {
        en = "Limit the recoil and shoot in a straight line with your handgonne."
        es = "Contén el retroceso y dispara en línea recta con tu cañón de mano."
    }
    // context: legend_line_them_up_skill.getTooltip.tooltip.push().text
    {
        // text = "Can hit up to [color=%positive%]" + targets + "[/color] targets in a straight line"
        mode = "pattern"
        en = "Can hit up to [color=%positive%]<targets:int>[/color] targets in a straight line"
        es = "Puede alcanzar hasta [color=%positive%]<targets>[/color] objetivos en línea recta"
    }
    // FILE: scripts\skills\actives\legend_magic_burning_hands.nut
    // context: legend_magic_burning_hands.create.m.Description
    {
        en = "Unleash a cone of blistering heat from your palms."
        es = "Desata desde tus palmas un cono de calor abrasador."
    }
    // context: legend_magic_burning_hands.create.m.KilledString
    {
        en = "Burned"
        es = "Quemado"
    }
    // context: legend_magic_burning_hands.getTooltip.ret.push().text
    {
        // text = "Inflicts [color=%damage%]" + damages[0] + "[/color] - [color=%damage%]" + damages[1] + "[/color] damage, up to [color=%damage%]" + damages[4] + "[/color] damage can ignore armor"
        mode = "pattern"
        en = "Inflicts [color=%damage%]<min:int>[/color] - [color=%damage%]<max:int>[/color] damage, up to [color=%damage%]<ignore:int>[/color] damage can ignore armor"
        es = "Inflige [color=%damage%]<min>[/color] - [color=%damage%]<max>[/color] de daño, del que hasta [color=%damage%]<ignore>[/color] puede ignorar la armadura"
    }
    // context: legend_magic_burning_hands.getTooltip.ret.push().text
    // en = "Inflicts [color=%damage%]<damages[2]>[/color] - [color=%damage%]<damages[3]>[/color] armor damage"  // cubierto por el patrón "Inflicts [color=%damage%]<min:int>[/color] - [color=%damage%]<max:int>[/color] armor damage"
    // context: legend_magic_burning_hands.getTooltip.ret.extend().text
    {
        en = "Hits a cone of range 3, or up to 9 tiles in total. Usable in melee"
        es = "Alcanza un cono de alcance [color=#135213]3[/color], es decir, hasta [color=#135213]9[/color] casillas en total. Se puede usar cuerpo a cuerpo"
    }
    // context: legend_magic_burning_hands.getTooltip.ret.push().text
    {
        en = "Accuracy based on ranged skill, damage based on current resolve. Requires a magic staff"
        es = "Precisión basada en la Habilidad a distancia y daño basado en la Resolución actual. Requiere un bastón mágico"
    }
    // FILE: scripts\skills\actives\legend_magic_chain_lightning_skill.nut
    // context: legend_magic_chain_lightning_skill.create.m.Description
    {
        en = "Fire a bolt of lightning at an enemy that can arc to two adjacent enemies."
        es = "Lanza contra un enemigo un rayo que puede saltar a dos enemigos adyacentes."
    }
    // context: legend_magic_chain_lightning_skill.create.m.KilledString
    {
        en = "Zapped"
        es = "Electrocutado"
    }
    // context: legend_magic_chain_lightning_skill.getTooltip.ret.push().text
    {
        // text = "Has [color=%positive%] " + this.m.AdditionalAccuracy + "% [/color] chance to hit."
        mode = "pattern"
        en = "Has [color=%positive%] <acc:int>% [/color] chance to hit."
        es = "Tiene un [color=%positive%] <acc>% [/color] de probabilidad de impactar."
    }
    // context: legend_magic_chain_lightning_skill.getTooltip.ret.extend().text
    {
        // text = "Has a range of [color=%positive%]" + this.m.MaxRange + "[/color] tiles on even ground, more if shooting downhill. Can hit up to three targets, doing less damage to each additional target beyond the first."
        mode = "pattern"
        en = "Has a range of [color=%positive%]<range:int>[/color] tiles on even ground, more if shooting downhill. Can hit up to three targets, doing less damage to each additional target beyond the first."
        es = "Tiene un alcance de [color=%positive%]<range>[/color] casillas en terreno llano, más si se dispara cuesta abajo. Puede alcanzar hasta tres objetivos y hace menos daño a cada objetivo adicional después del primero."
    }
    // context: legend_magic_chain_lightning_skill.getTooltip.ret.push().text
    {
        en = "Accuracy based on ranged skill, damage based on resolve. Requires a magic staff"
        es = "Precisión basada en la Habilidad a distancia y daño basado en la Resolución. Requiere un bastón mágico"
    }
    // FILE: scripts\skills\actives\legend_magic_circle_of_protection_skill.nut
    // context: legend_magic_circle_of_protection_skill.create.m.Description
    {
        en = "A magic circle that protects all allies within when cast. Leaving the circle breaks the protection."
        es = "Un círculo mágico que protege a todos los aliados que estén dentro al lanzarlo. Salir del círculo rompe la protección."
    }
    // context: legend_magic_circle_of_protection_skill.create.m.KilledString
    {
        en = "Magic Circled"
        es = "Encerrado en un círculo mágico"
    }
    // context: legend_magic_circle_of_protection_skill.getTooltip.ret.push().text
    {
        // text = "All allies currently within range [color=%positive%]" + this.m.Range + "[/color] gain [color=%positive%]" + this.getDefBonus() + "[/color] melee/ranged defense and [color=%positive%]" + this.getResolveBonus() + "[/color] resolve for 2 turns or until they leave the circle."
        mode = "pattern"
