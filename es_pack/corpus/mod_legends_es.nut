        es = ""
    }
    // FILE: scripts\items\weapons\legendary\legend_ram_hammer.nut
    // context: legend_ram_hammer.create.m.Name
    {
        en = "The Ram's Head"
        es = ""
    }
    // context: legend_ram_hammer.create.m.Description
    {
        en = "A massive ancient hammer with two ram heads making up both faces of the weapon. It is deceptively heavy and somehow increases in weight between each swing."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_flamberge.nut
    // context: legend_named_flamberge.create.m.Description
    {
        en = "This greatsword shows great craftmanship. It is of great length and strength, holding a great balance in the hands."
        es = ""
    }
    // context: legend_named_flamberge.getTooltip.result.push().text
    {
        en = "Inflicts additional stacking [color=%damage%]2[/color] bleeding damage per turn, for 2 turns"
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_gladius.nut
    // context: legend_named_gladius.create.m.Description
    {
        en = "A straight blade of ancient origin. The grip and pommel are ornate and most likely from a nobleman."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_glaive.nut
    // context: legend_named_glaive.create.m.Description
    {
        en = "A masterfully crafted glaive that feels surprisingly light, yet sturdy."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_goblin_axe_2h.nut
    // context: legend_named_goblin_axe_2h.create.m.Name
    {
        en = "Manfeller"
        es = ""
    }
    // context: legend_named_goblin_axe_2h.create.m.Description
    {
        en = "As some of the goblins grew to nearly human size, they took the time to recreate their greenskin cousin's huge axe, but with a well crafted slim edge. Suited for human hands, it can easily cut a man in two ."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_goblin_crossbow.nut
    // context: legend_named_goblin_crossbow.create.m.Description
    {
        en = "A large and heavy crossbow with menacing spikes in front. It's a mystery how goblins could improve upon a miniature ballista, but here we are. It shoots stakes with enough force to knock back a target hit. Very effective against vampires."
        es = ""
    }
    // en = "Crossbow, Two-Handed"
    // en base_es
    // FILE: scripts\items\weapons\named\legend_named_goblin_gruesome_falchion.nut
    // context: legend_named_goblin_gruesome_falchion.create.m.Description
    {
        en = "Fashioned from sharpened black rock, this wavy blade and can cause gruesome injuries. Even if it's crafted by goblins, the crafstmanship is amazing."
        es = ""
    }
    // en = "Sword, One-Handed"
    // en base_es
    // FILE: scripts\items\weapons\named\legend_named_goblin_notched_blade.nut
    // context: legend_named_goblin_notched_blade.create.m.Description
    {
        en = "The goblins crafted this curved sax into a wavy pattern, making the blade particularly good for slitting throats and puncturing weak spots."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_goblin_staff.nut
    // context: legend_named_goblin_staff.create.m.Name
    {
        en = "Adorned Gnarly Staff"
        es = ""
    }
    // context: legend_named_goblin_staff.create.m.Description
    {
        en = "A gnarly staff carved from old and hard wood, decorated with a menacing skull, feathers and small bones. The runes on the head are intricate and tell a story that only the goblins can read."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_great_khopesh.nut
    // en = "A massive cleaver that can cut through flesh and armor alike. This piece is in good condition despite its old age."
    // en base_es
    // FILE: scripts\items\weapons\named\legend_named_heavy_javelin.nut
    // context: legend_named_heavy_javelin.create.m.Description
    {
        en = "A jagged harpoon, that flies true despite it's weight and size. Harder to throw and hit with, but more impactful."
        es = ""
    }
    // en = "<bowyer:str>'s <name:str>"
    // en base_es
    // FILE: scripts\items\weapons\named\legend_named_heavy_southern_mace.nut
    // context: legend_named_heavy_southern_mace.create.m.Description
    {
        en = "A heavy winged mace from the south. The smith who forged this weapon certainly knew what he was doing."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_heavy_throwing_axe.nut
    // context: legend_named_heavy_throwing_axe.create.m.Description
    {
        en = "While you wouldn't use these for juggling, the craftsmanship is astounding for heavy barbarian axes. Difficult to throw and hit with, but deadly."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_horn_decorated_mace.nut
    // context: legend_named_horn_decorated_mace.create.m.Description
    {
        en = "A huge club decorated with skulls and horns, woven in patterns that betray strange meaning. For the average mercenary you just need to know that a blow will leave a person reeling and struggling for breath."
        es = ""
    }
    // en = "Mace, Two-Handed"
    // en base_es
    // FILE: scripts\items\weapons\named\legend_named_infantry_axe.nut
    // context: legend_named_infantry_axe.create.m.Description
    {
        en = "A long, exceptionally well crafted two-handed axe used by footmen in the noble wars"
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_longsword.nut
    // context: legend_named_longsword.create.m.Description
    {
        en = "This longsword is a marvel to look at. The long blade is rigid and sturdy, but trades nothing in balance. Lends itself well to a diverse array of fighting moves."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_lute.nut
    // context: legend_named_lute.create.m.Description
    {
        en = "A beautiful lute with a ornate body and strong neck. The artisan who made this instrument certainly knew what they were doing."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_military_goedendag.nut
    // context: legend_named_military_goedendag.create.m.Description
    {
        en = "An ornate military grade metal-reinforced club with a spike at the top. Can be used to thrust at the enemy, or pummel them into submission."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_military_warscythe.nut
    // context: legend_named_military_warscythe.create.m.Description
    {
        en = "A heavy cleaver blade on top of a long shaft, used to deliver deep sweeping strikes over some distance. It might be confused for a simple and crude from weapon a layman, but the artisan who crafted this knew how to balance it perfectly."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_nomad_sling.nut
    // context: legend_named_nomad_sling.create.m.Description
    {
        en = "A reinforced sling on a metal staff of the highest craftsmanship. It features a bigger pouch for heavier rocks, but trades off precision for damage and range. With rocks being everywhere it will never run out of ammunition."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_northern_sling.nut
    // context: legend_named_northern_sling.create.m.Description
    {
        en = "An exquisite slingstaff for true marksmen. It features a bigger pouch for heavier rocks, but trades off precision for damage and range. With rocks being everywhere it will never run out of ammunition."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_orc_axe_2h.nut
    // context: legend_named_orc_axe_2h.create.m.Name
    {
        en = "Unhold Splitter"
        es = ""
    }
    // context: legend_named_orc_axe_2h.create.m.Description
    {
        en = "A huge and sturdy double headed battleaxe too heavy to be used effectively by the average human."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_orc_flail_2h.nut
    // context: legend_named_orc_flail_2h.create.m.Name
    {
        en = "Brutal Chain"
        es = ""
    }
    // context: legend_named_orc_flail_2h.create.m.Description
    {
        en = "A massive iron chain with a heavy piece at the end. Too heavy to be used effectively by the average human."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_parrying_dagger.nut
    // context: legend_named_parrying_dagger.create.m.Description
    {
        en = "An exquisite offhand dagger for actively parrying an opponent.\n\n When parried or if an opponent misses you, their defences will be lowered.\n\n The 'Split Shield' skill only does 20% damage against this dagger"
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_ranged_flail.nut
    // context: legend_named_ranged_flail.create.m.Description
    {
        en = "A metal weight attached with a short chain to a long pole, the War Flail is a brutal weapon. Deadly enough to fell most men with a good hit to the head, and useful to strike over or around shield cover."
        es = ""
    }
    // context: legend_named_ranged_flail.getTooltip.result.push().text
    {
        en = "Applies [color=%positive%]Daze[/color] to Targets Hit"
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_royal_lance.nut
    // context: legend_named_royal_lance.create.m.Description
    {
        en = "This Spear is especially well-crafted, withstanding the tests of time, and its blade would be worthy of even a noble. Used for thrusting over some distance and keeping the enemy at bay."
        es = ""
    }
    // en = "<bowyer:str>'s <name:str>"
    // en base_es
    // en = "<bowyer:str>'s <name:str>"
    // en base_es
    // FILE: scripts\items\weapons\named\legend_named_rusty_greatsword.nut
    // context: legend_named_rusty_greatsword.create.m.Description
    {
        en = "This massive and exceptionally well-crafted warblade is built like a cleaver, but has a surprisingly light blade that allows wielding it like a sword."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_rusty_serrated_axe.nut
    // context: legend_named_rusty_serrated_axe.create.m.Description
    {
        en = "The rust on this axe could fool you that the blade is dull, but just checking its edge almost cost you your thumb. The serrated teeth can cause horrific wounds, while the axe itself is uniquely suited to decapitations."
        es = ""
    }
    // context: legend_named_rusty_serrated_axe.getTooltip.result.push().text
    {
        en = "Has a [color=%negative%]33%[/color] lower threshold to inflict injuries"
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_rusty_warcleaver.nut
    // context: legend_named_rusty_warcleaver.create.m.Description
    {
        en = "An uncommonly curved blade shape for the warriors of the north, this savage warcleaver is heavy and sturdy. The strange material can decapitate, as well as it can destroy shields."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_sling.nut
    // context: legend_named_sling.create.m.Description
    {
        en = "This sling is reinforced and features a high quality leather pouch. Used to pelt your enemies with rocks. With stones abundant everywhere, it will never run out of ammunition."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_staff_vala.nut
    // context: legend_named_staff_vala.create.m.Description
    {
        en = "A gnarled staff no more, the twisted roots reformed into a beautiful pattern that only the Vala can create."
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_swordstaff.nut
    // context: legend_named_swordstaff.create.m.Description
    {
        en = "This Swordstaff is especially well-crafted, and its blade would be worthy of even a noble"
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_warhammer.nut
    // context: legend_named_warhammer.create.m.Description
    {
        en = "An ornate iron mastercrafted warhammer that easily destroys armor and breaks bones. "
        es = ""
    }
    // FILE: scripts\items\weapons\named\legend_named_zweihander.nut
    // context: legend_named_zweihander.create.m.Description
    {
        en = "This zweihander is a true masterpiece, with a blade that is both flexible and easy to swing, but also delivers devastating blows to whoever is unlucky enough to get in range."
        es = ""
    }
    // FILE: scripts\preload.nut
    // en = "<scriptsConfigPath>global"
    // en = "<scriptsConfigPath>ui"
    // en = "<scriptsConfigPath>strings"
    // FILE: scripts\retinue\followers\arena_follower.nut
    // context: arena_follower.create.m.Name
    {
        en = "Gladiator's Tools"
        es = ""
    }
    // context: arena_follower.create.m.Description
    {
        en = "Winning fights in the arena can be tough, however with these tools one can entertain the croud for many more hours."
        es = ""
    }
    // context: arena_follower.create.m.Effects
    {
        en = "Increase winnings from the arena by 25%"
        es = ""
    }
    // context: arena_follower.create.m.Effects
    {
        en = "Fight up to 3 arena matches per day"
        es = ""
    }
    // context: arena_follower.create.addRequirement()
    {
        en = "Triumph in 5 arena fights "
        es = ""
    }
    // FILE: scripts\scenarios\tactical\legend_scenario_basilisks.nut
    // en = "ScenarioDefendTheHill::generate()"
    // FILE: scripts\scenarios\tactical\legend_scenario_wall_battle.nut
    // en = "ScenarioEarlyGame::generate()"
    // FILE: scripts\scenarios\world\legend_random_3_scenario.nut
    // context: legend_random_3_scenario.create.m.Name
    {
        en = "Random Trio"
        es = ""
    }
    // context: legend_random_3_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_80.png[/img][/p][p]Having fled a raid, three fellows decide to forge out a new path.\n\n[color=#bcad8c]Random Backgrounds:[/color] The backgrounds are different each time you start.\n[color=#bcad8c]Random equipment:[/color] The equipment you begin with is different each time.\n[color=#bcad8c]Random perks:[/color] The abilities of your mercenaries will be different each time.[/p]"
        es = ""
    }
    // FILE: scripts\scenarios\world\legend_random_party_scenario.nut
    // context: legend_random_party_scenario.create.m.Name
    {
        en = "Random Party"
        es = ""
    }
    // context: legend_random_party_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_80.png[/img][/p][p]A wild new adventure each time, 1-6 party members randomly chosen from all backgrounds.\n\n[color=#bcad8c]Random Backgrounds:[/color] The backgrounds are different each time you start.\n[color=#bcad8c]Random equipment:[/color] The equipment you begin with is different each time.\n[color=#bcad8c]Random perks:[/color] The abilities of your mercenaries will be different each time.\n[color=#bcad8c]Random supplies:[/color] Randomly get 3 times less to 3 times more money, tools, meds and ammo.[/p]"
        es = ""
    }
    // FILE: scripts\scenarios\world\legend_random_solo_scenario.nut
    // context: legend_random_solo_scenario.create.m.Name
    {
        en = "Random Solo"
        es = ""
    }
    // context: legend_random_solo_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_35.png[/img][/p][p]Striking out on your own, who knows what the world has in store?\n\n[color=#bcad8c]Random Backgrounds:[/color] Your background will be different each time you start.\n[color=#bcad8c]Random Equipment:[/color] The equipment you begin with is different each time.\n[color=#bcad8c]Avatar:[/color] If you die, it is game over.[/p]"
        es = ""
    }
    // FILE: scripts\scenarios\world\legend_risen_legion_scenario.nut
    // context: legend_risen_legion_scenario.create.m.Name
    {
        en = "Risen Legion"
        es = ""
    }
    // context: legend_risen_legion_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_73.png[/img][/p]An ancient legion risen from the dead with orders to reclaim the world.\n\n[color=#bcad8c]Dreaded:[/color] All towns will begin and stay hostile to you.\n[color=#bcad8c]Fighting Legion:[/color] Higher than average marching speed across difficult terrain, begin with 8 fighters and field up to 25.\n[color=#bcad8c]Dead Walking:[/color] You cannot hire in towns, but you may find recruits by patrolling near Mass graves, Sunken Castles and The Monolith. Ancient dead are allied to you.\n"
        es = ""
    }
    // context: legend_risen_legion_scenario.onSpawnPlayer.n.addPlayerRelation()
    {
        en = "For the empire!"
        es = ""
    }
    // FILE: scripts\scenarios\world\legends_assassin_scenario.nut
    // context: legends_assassin_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_51.png[/img][/p][p] An assassin down on their luck with limited supplies. \n\n[color=#bcad8c]Dirty Deeds:[/color] You will grant the Backstabber perk to anyone who joins you. \n[color=#bcad8c]Underworld:[/color] You have a small chance of finding other Assassins for hire. Outlaws are 50% cheaper to hire and maintain, all other backgrounds are the same cost.\n[color=#bcad8c]Avatar:[/color] Begin alone. If you die, it is game over.[/p]"
        es = ""
    }
    // context: legends_assassin_scenario.onHiredByScenario._bro.worsenMood()
    {
        en = "Is uncomfortable with joining an assassin"
        es = ""
    }
    // context: legends_assassin_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "Is excited at becoming part of outlaw company"
        es = ""
    }
    // FILE: scripts\scenarios\world\legends_beggar_scenario.nut
    // context: legends_beggar_scenario.create.m.Name
    {
        en = "Original Beggar Challenge"
        es = ""
    }
    // context: legends_beggar_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_70.png[/img][/p][p]A lowly unskilled beggar, you witnessed something in an alley and now a noble house wants you dead. This is a challenge run with a very weak starting character. \n\n[color=#bcad8c]Knows Too Much:[/color] All noble houses hate you.\n[color=#bcad8c]Begin alone Avatar[/color]: If the beggar dies, the campaign ends.\n[color=#bcad8c]Dirty Peasant[/color]: You can only hire lowerborn backgrounds.[/p]"
        es = ""
    }
    // context: legends_beggar_scenario.onSpawnAssets.bro.worsenMood()
    {
        en = "Saw something awful"
        es = ""
    }
    // context: legends_beggar_scenario.onSpawnPlayer.f.addPlayerRelation()
    {
        en = "You know too much"
        es = ""
    }
    // context: legends_beggar_scenario.onHiredByScenario._bro.worsenMood()
    {
        en = "Fell sick after joining you"
        es = ""
    }
    // FILE: scripts\scenarios\world\legends_berserker_scenario.nut
    // context: legends_berserker_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_139.png[/img][/p][p]You are a barbarian berserker, driven by an unbound rage. Watching your family be slaughtered drove you into a self-destructive frenzy of violence and revenge.\n\n[color=#bcad8c]Berserker Madness:[/color] Unlock powerful abilities that allow you to fight naked and bare-handed.\n[color=#bcad8c]Infectious Rage:[/color] Only the insane, violent or desperate will join you. You will grant the Berserk perk to anyone who joins you in battle. You have a tiny chance of finding other berserkers for hire.\n[color=#bcad8c]Avatar:[/color] Begin alone. If you die, it is game over.[/p]"
        es = ""
    }
    // context: legends_berserker_scenario.onSpawnPlayer.houses[i].Faction.addPlayerRelation()
    {
        en = "You are considered a barbarian"
        es = ""
    }
    // context: legends_berserker_scenario.onHiredByScenario._bro.worsenMood()
    {
        en = "Disturbed by your wild and erratic nature"
        es = ""
    }
    // context: legends_berserker_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "Excited by your lust for battle"
        es = ""
    }
    // context: legends_berserker_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "Learned a new skill"
        es = ""
    }
    // FILE: scripts\scenarios\world\legends_crusader_scenario.nut
    // context: legends_crusader_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_35.png[/img][/p][p]Sent on a holy quest to rid the world of undead, you walk a righteous path. \n\n[color=#bcad8c]Pure of Heart:[/color] You cannot recruit outlaw backgrounds, while pious recruits and squires cost less.\n[color=#bcad8c]Strict Sermons:[/color] You will grant the Fortified Mind perk to any pious background that joins you. Find Pilgrims to aid you on your journey.\n[color=#bcad8c]Avatar:[/color] If your crusader dies, the campaign ends.[/p]"
        es = ""
    }
    // context: legends_crusader_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "Joined a righteous cause"
        es = ""
    }
    // context: legends_crusader_scenario.onHiredByScenario._bro.worsenMood()
    {
        en = "Dislikes your sermons"
        es = ""
    }
    // FILE: scripts\scenarios\world\legends_custom_scenario.nut
    // context: legends_custom_scenario.create.m.Name
    {
        en = "Build your own "
        es = ""
    }
    // context: legends_custom_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_80.png[/img][/p]Build and customize your company roster (Your very own pick and choose adventure!)"
        es = ""
    }
