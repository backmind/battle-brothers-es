    // FILE: scripts\skills\backgrounds\legend_shieldmaiden_background.nut
    // context: legend_shieldmaiden_background.create.m.Name
    {
        // El extractor lo dejó solo como ID de pantalla de dos eventos; Rosetta no toca esos ID.
        en = "Shieldmaiden"
        es = "Doncella escudera"
    }
    // context: legend_shieldmaiden_background.create.m.BackgroundDescription
    {
        en = "Shieldmaidens are fierce female warriors from the northern settlements."
        es = "Las doncellas escuderas son feroces guerreras de los asentamientos del norte."
    }
    // context: legend_shieldmaiden_background.create.m.GoodEnding
    {
        en = "The shieldmaiden, %name% stayed with %companyname% a little longer after your departure, netting herself a small horde of crowns. Nobody truly knew what happened to her next, but she was last seen hiring other women as fighters not far from where you picked her up so long ago."
        es = "La doncella escudera %name% se quedó en %companyname% un poco más tras tu marcha y reunió un pequeño tesoro en coronas. Nadie supo nunca a ciencia cierta qué fue de ella después, pero la vieron por última vez contratando a otras mujeres como guerreras, no lejos de donde la reclutaste hace tanto tiempo."
    }
    // context: legend_shieldmaiden_background.create.m.BadEnding
    {
        en = "As %companyname% declined in strength, %name% was one of the first to take charge. Her defensive nature led to inaction and ended up with most of the company being whittled down by goblin arrows in a swamp, many with their shields still clutched in their hands under the never-ending rain of projectiles."
        es = "A medida que %companyname% perdía fuerza, %name% fue de las primeras en tomar el mando. Su carácter defensivo la llevó a la inacción, y la mayor parte de la compañía acabó diezmada por las flechas de los goblins en un pantano; muchos murieron con los escudos aún aferrados en las manos bajo la incesante lluvia de proyectiles."
    }
    // context: legend_shieldmaiden_background.create.m.Titles
    {
        en = "the Shieldmaiden"
        es = "la Doncella Escudera"
    }
    // context: legend_shieldmaiden_background.create.m.Titles
    {
        en = "the White Death"
        es = "la Muerte Blanca"
    }
    // context: legend_shieldmaiden_background.create.m.Titles
    {
        en = "the Wall"
        es = "la Muralla"
    }
    // context: legend_shieldmaiden_background.create.m.Titles
    {
        en = "the Ironside"
        es = "Costado de Hierro"
    }
    // context: legend_shieldmaiden_background.onBuildDescription
    {
        en = "{%name% was born to a family with a long history of female warriors. | %name% hails from the distant north, where ideas about the fairer sex tend to be far rougher. | %name% claims to have once been the personal protector of a great jarl, but was exiled from her home for reasons that she seems hesitant to speak of. | %name% caught your eye by flexing her scarred bicep, and she claims that every cut is another man killed. | %name% talks of distant climes and frozen lands that, from her description, you can hardly imagine man could be cursed to walk. | You met %name% in a local tavern, drinking enough to kill most men and challenging anyone who passed to a fight. | %name% has the farthest thing you can imagine from a pretty face, but she makes up for that with a spear and shield that have both clearly seen their share of war.} {Despite whatever hangups many have about women warriors, %name% speaks of a thousand battles you've never heard of yet sound plenty dangerous to you, and she bears enough scars to confirm their veracity. | She proudly displays an old shield that seems more crack than wood, and claims that it was gifted to her from a great warrior that she had killed herself. | When a local bruiser challenged her he decided to spend the first moments of the fight gloating to his friends, only to receive a swift punch leading to a broken jaw. | She doesn't say much, but those few words she does say speak thousands about the strange places she's seen and the stranger things she's killed there.} {%name% spits on the ground as she sees a merchant claiming to be selling the hides of Unhold, and says she's killed baby ones at twice the size. | You have no idea how many of her stories are fabricated, but %name% seems to know how to swing a sword well enough. | When one of your men made a pass on her it took two others to drag her off of the nearly unconscious mercenary. | When you ask her to demonstrate her skill, she grabs one of your men and pulls him to the ground in a headlock before you can stop her. She's brave, at least. | You're not sure if the woman's entirely all there, but she seems like she knows a shieldwall well enough. | You met her in the tavern after a brawl. It was a bad one, but %name% was the only one—besides you—left standing. | You can tell by the look in her eyes that this woman has seen her fair share of war.}"
        es = "{%name% nació en una familia con una larga tradición de mujeres guerreras. | %name% procede del lejano norte, donde las ideas sobre el bello sexo suelen ser mucho más rudas. | %name% asegura haber sido en otro tiempo la guardaespaldas personal de un gran jarl, pero la desterraron de su hogar por motivos de los que parece reacia a hablar. | %name% te llamó la atención flexionando su bíceps lleno de cicatrices, y asegura que cada corte es otro hombre muerto. | %name% habla de climas lejanos y tierras heladas que, por cómo las describe, cuesta imaginar que haya hombre condenado a pisarlas. | Conociste a %name% en una taberna del lugar, bebiendo lo bastante como para matar a casi cualquier hombre y retando a pelear a todo el que pasaba. | La cara de %name% es lo más alejado de una cara bonita que puedas imaginar, pero lo compensa con una lanza y un escudo que, a todas luces, han visto su buena ración de guerra.} {Pese a los reparos que muchos tienen con las mujeres guerreras, %name% habla de mil batallas de las que nunca has oído hablar pero que te parecen de lo más peligrosas, y tiene cicatrices de sobra para confirmar que son ciertas. | Luce con orgullo un viejo escudo que parece más grieta que madera, y asegura que se lo regaló un gran guerrero al que ella misma había matado. | Cuando un matón del lugar la desafió, decidió pasar los primeros instantes de la pelea fanfarroneando ante sus amigos, y se llevó un puñetazo rápido que le rompió la mandíbula. | No habla mucho, pero las pocas palabras que dice cuentan mil cosas de los extraños lugares que ha visto y de las cosas aún más extrañas que ha matado allí.} {%name% escupe al suelo al ver a un mercader que asegura vender pieles de Trol, y dice que ella ha matado crías del doble de tamaño. | No tienes ni idea de cuántas de sus historias son inventadas, pero %name% parece saber blandir una espada bastante bien. | Cuando uno de tus hombres se le insinuó, hicieron falta otros dos para quitársela de encima al mercenario, que estaba casi inconsciente. | Cuando le pides que demuestre su destreza, agarra a uno de tus hombres y lo tira al suelo con una llave al cuello antes de que puedas detenerla. Valiente sí que es. | No estás seguro de que a esta mujer no le falte un tornillo, pero parece conocer bien el muro de escudos. | La conociste en la taberna tras una reyerta. Fue de las gordas, pero %name% fue la única, aparte de ti, que quedó en pie. | Por su mirada se nota que esta mujer ha visto guerra de sobra.}"
    }
    // FILE: scripts\skills\backgrounds\legend_spiritualist_background.nut
    // context: legend_spiritualist_background.create.m.Name
