    // en = "<::MSU.isKindOf(a, , , player)&&!::MSU.isNull(a.getBackground())&&a.getBackground().isBackgroundType(this.Const.BackgroundType.Cultist)||a.getBackground().isBackgroundType(this.Const.BackgroundType.ConvertedCultist)>"  // código: condición con isKindOf, no se muestra
    // FILE: mod_legends\hooks\skills\actives\web_skill.nut
    // context: web_skill.o.create.m.Description
    {
        en = "Send a web of silk out to ensnare an opponent, rooting them in place halving their damage, defenses and initiative. Does no damage."
        es = "Lanza una red de seda para atrapar a un oponente, inmovilizándolo en el sitio y reduciendo a la mitad su daño, sus defensas y su iniciativa. No causa daño."
    }
    // context: web_skill.o.getTooltip.tooltip.extend().text
    {
        // text = "Has " + this.m.Cooldown + " turns left."
        mode = "pattern"
        en = "Has <turns:int> turns left."
        es = "Quedan <turns> turnos."
    }
    // FILE: mod_legends\hooks\skills\actives\werewolf_bite.nut
    // context: werewolf_bite.o.create.m.Description
    {
        en = "Tear an enemy assunder with your teeth"
        es = "Despedaza a un enemigo con tus dientes"
    }
    // FILE: mod_legends\hooks\skills\actives\zombie_bite.nut
    // context: zombie_bite.o.create.m.Name
    {
        en = "Wiederganger Bite"
        es = "Mordida de Wiederganger"
    }
    // context: zombie_bite.o.create.m.Description
    {
        en = "A vicious bite with a 15% increased chance to hit the head. Infects on legendary difficulty. Will revive humanoid enemies as allied Wiedergangers if dealt as a killing blow."
        es = "Un mordisco feroz con un [color=#135213]15%[/color] más de probabilidad de golpear en la cabeza. Infecta en la dificultad legendaria. Si da el golpe mortal, revive a los enemigos humanoides como Wiedergangers aliados."
    }
    // context: zombie_bite.o.onTargetKilled.isKindOf()
    // en = "<!this.isKindOf(_targetEntity, , , player)&&!this.isKindOf(_targetEntity, , , human)>"  // código: condición con isKindOf, no se muestra
    // FILE: mod_legends\hooks\skills\backgrounds\adventurous_noble_background.nut
    // en = "Adventurous Noble"
    // en base_es
    // en = "Adventurous Nobles tend to have high resolve and melee skills, but often neglect ranged defense."
    // en base_es
    // context: adventurous_noble_background.o.create.m.GoodEnding
    {
        en = "Adventurousness never leaves the soul of a %person% like %name%. {Instead of returning to %their% noble family, %they% left the %companyname% and headed east in search of rare beasts. Word has it %they% returned to town with the head of what looked like a giant lizard, but you don't believe such fantastical tripe. | %They% departed the %companyname% and ventured west, sailing across the oceans to unseen lands. There's no telling where %they% is these days, but you've little doubt that %they%'ll be coming back with stories to tell. | %They% retired from the %companyname% and, instead of returning to %their% noble family, headed south. Word has it %they% fought in a great noble civil war, killed an orc warlord, climbed the highest mountain in the land, and is currently writing an epic about %their% travels. | The %noble% left the %companyname% and, preferring the life of adventure to noble boredom, %they% headed north. Word has it that %they%'s currently marching a troop of explorers to the furthest reaches of the world.}"
        es = "El espíritu aventurero nunca abandona el alma de %un% %hombre% como %name%. {En lugar de volver con su familia noble, dejó %companyname% y se dirigió al este en busca de bestias raras. Se dice que regresó a la ciudad con la cabeza de lo que parecía un lagarto gigante, pero no te crees semejantes patrañas. | Partió de %companyname% y se aventuró hacia el oeste, surcando los océanos hacia tierras ignotas. No hay forma de saber dónde anda estos días, pero no te cabe duda de que volverá con historias que contar. | Se retiró de %companyname% y, en lugar de volver con su familia noble, se dirigió al sur. Se dice que luchó en una gran guerra civil entre nobles, mató a un señor de la guerra orco, escaló la montaña más alta del país y ahora está escribiendo una epopeya sobre sus viajes. | %Art% noble dejó %companyname% y, prefiriendo la vida de aventuras al tedio de la nobleza, se dirigió al norte. Se dice que ahora guía a una tropa de exploradores hacia los confines del mundo.}"
    }
    // context: adventurous_noble_background.o.create.m.BadEnding
    {
        en = "%name% departed the %companyname% and continued %their% adventuring elsewhere. {%They% headed east, hoping to discover the source of the greenskins, but the %noble% has not been heard from since. | %They% headed north into the snowy wastes. Word has it %they% was seen a week ago, marching south this time, looking rather pale and shuffling moreso than walking. | %They% headed south into brutal marshlands. Word has it that a mysterious flame appeared in the fog and %they% walked toward it. The men who saw this said %they% disappeared into the mist and never returned. | %They% headed west and sailed the open sea. Despite having no experience at sea, %they% saw fit to make %themselves% captain of the boat. They say pieces of %their% ship and dead sailors kept washing ashore for weeks.}"
        es = "%name% dejó %companyname% y continuó sus aventuras en otra parte. {Se dirigió al este con la esperanza de descubrir el origen de los pieles verdes, pero no se ha vuelto a saber nada %del% noble desde entonces. | Se dirigió al norte, a los páramos nevados. Se dice que %lo% vieron hace una semana, marchando esta vez hacia el sur, bastante pálid%o% y arrastrando los pies más que caminando. | Se dirigió al sur, hacia unas marismas brutales. Se dice que una llama misteriosa apareció en la niebla y caminó hacia ella. Los hombres que lo vieron dijeron que desapareció en la bruma y nunca regresó. | Se dirigió al oeste y se hizo a la mar abierta. Pese a no tener ninguna experiencia en el mar, tuvo a bien ponerse al mando del barco. Dicen que restos de su barco y marineros muertos siguieron llegando a la orilla durante semanas.}"
    }
    // context: adventurous_noble_background.o.setGender.m.Name
    {
        en = "Adventurous Lady"
        es = "Dama aventurera"
    }
    // context: adventurous_noble_background.o.setGender.m.BackgroundDescription
    {
        en = "Adventurous Ladies tend to have high resolve and ranged skills, but often neglect melee defense."
        es = "Las damas aventureras suelen tener mucha Resolución y buena Habilidad a distancia, pero a menudo descuidan la Defensa cuerpo a cuerpo."
    }
    // context: adventurous_noble_background.o.onBuildDescription
    {
        en = "{A minor noble | As the third in the line of succession | A young and brash %noble% | A skilled swords%person%}, %name%'s life at court {had grown stale for %them% | was not exciting enough for %them% with endless studying of court etiquette and family lineage | felt like wasting the best time of %their% life | was not half as exciting to %them% as the tales of adventures, battles, fearsome beasts to vanquish and fair maidens to conquer}. {Wearing the family crest proudly | At the encouragement of %their% brother | To the frustration of %their% mother | Finally making a decision to change things}, %name% rode out to {prove %themselves% | make a name for themselves | earn glory on the battlefield | test %their% skills in battle} and {live life to its fullest as %they% imagined it from behind the castle walls | see all the wonders and exotic places of the world | earn %their% place in the world | be knighted for %their% valor | become famous and loved in all the known world | become infamous and feared in all the known world}."
        es = "{Como noble menor | Como tercer%o% en la línea de sucesión | Como %un% noble joven e impetuos%o% | Como %un% hábil esgrimista}, a %name% la vida en la corte {se le había vuelto insulsa | no le resultaba lo bastante emocionante, con el interminable estudio de la etiqueta cortesana y del linaje familiar | le parecía un desperdicio de los mejores años de su vida | no le resultaba ni la mitad de emocionante que los relatos de aventuras, batallas, bestias temibles que vencer y bellas doncellas que conquistar}. {Luciendo con orgullo el blasón familiar | Animad%o% por su hermano | Para frustración de su madre | Decidid%o% por fin a cambiar las cosas}, %name% partió a caballo para {demostrar su valía | hacerse un nombre | ganar gloria en el campo de batalla | poner a prueba sus habilidades en combate} y {vivir la vida al máximo, tal como la había imaginado tras los muros del castillo | ver todas las maravillas y lugares exóticos del mundo | ganarse su lugar en el mundo | ser nombrad%o% caballero por su valor | volverse famos%o% y querid%o% en todo el mundo conocido | volverse infame y temid%o% en todo el mundo conocido}."
    }
    // FILE: mod_legends\hooks\skills\backgrounds\anatomist_background.nut
    // en = "Part scientist and part surgeon, Anatomists are unaccustomed to battle but well served by steady hands."
    // en base_es
    // en = "Out of all the men you came to know in the %companyname%, it was %name% the anatomist who is perhaps the most difficult to forget. An unending stream of letters only helps ensure you never will. You skim over his latest, one-sided correspondence: \x22Captain! I've managed to...\x22 skimming, skimming, \x22...the greatest invention! The most...\x22 skimming, skimming. \x22I'm going to be famous! My brain will be studied for its weight is surely...\x22 Nothing new, it seems, though you are glad he's still in good health, albeit perhaps more so in body than mind."
    // en base_es
    // en = "Having fled the %companyname%, %name% the anatomist continued his studies elsewhere. He was admonished by his peers for venturing out in such an uncouth manner and found himself suffering in intellectual mediocrity. Some years later, he made a small contribution to the study of beetles after which he promptly threw himself off a seaside cliff, donating his brain to the rocks and his body to the ocean."
    // en base_es
    // en = "the Crow"
    // en base_es
    // en = "the Mortician"
    // en base_es
    // en = "the Undertaker"
    // en base_es
    // en = "the Grim"
    // en base_es
    // en = "the Anatomist"
    // en base_es
    // en = "the Tainted"
    // en base_es
    // context: anatomist_background.o.setGender.m.GoodEnding
    {
        en = "Out of all the women you came to know in the %companyname%, it was %name% the anatomist who is perhaps the most difficult to forget. An unending stream of letters only helps ensure you never will. You skim over her latest, one-sided correspondence: \"Captain! I've managed to...\" skimming, skimming, \"...the greatest invention! The most...\" skimming, skimming. \"I'm going to be famous! My brain will be studied for its weight is surely...\" Nothing new, it seems, though you are glad she's still in good health, albeit perhaps more so in body than mind."
        es = "De todas las mujeres que llegaste a conocer en %companyname%, quizás %name% la anatomista sea la más difícil de olvidar. Un interminable flujo de cartas solo asegura que nunca la olvidarás. Hojeas su última correspondencia unidireccional: '¡Capitán! He logrado...' hojeando, hojeando, '...¡la mayor invención! Lo más...' hojeando, hojeando. '¡Voy a ser famosa! Mi cerebro será estudiado por su peso seguramente...'. Parece que no hay nada nuevo, aunque te alegras de que todavía esté en buena salud, quizás más en cuerpo que en mente."
    }
    // context: anatomist_background.o.setGender.m.BadEnding
    {
        en = "Having fled the %companyname%, %name% the anatomist continued her studies elsewhere. She was admonished by her peers for venturing out in such an uncouth manner and found herself suffering in intellectual mediocrity. Some years later, she made a small contribution to the study of beetles after which she promptly threw herself off a seaside cliff, donating her brain to the rocks and her body to the ocean."
        es = "Tras huir de %companyname%, %name% la anatomista continuó sus estudios en otra parte. Sus colegas la reprendieron por aventurarse de una manera tan poco refinada y acabó languideciendo en la mediocridad intelectual. Algunos años después, hizo una pequeña contribución al estudio de los escarabajos, tras lo cual se arrojó sin más desde un acantilado junto al mar, donando su cerebro a las rocas y su cuerpo al océano."
    }
    // context: anatomist_background.o.getTooltip.ret.push().text
    {
        en = "[color=%positive%]+15%[/color] Experience Gain"
        es = "[color=%positive%]+15%[/color] de experiencia ganada"
    }
    // context: anatomist_background.o.onBuildDescription
    {
        en = "{%name% is a sharp woman with a complexion wrecked by constant and virulent testing. You hope that her methodologies may be better applied to her enemies rather than her own self. | Rumors about %name% suggest she tried to figure out how to fly. Not by machine, rather, but by growing wings. How exactly she intended to do that, or what became of her experiments, is unknown. Yet, here she is, rather shrewdly grounded and looking over her shoulders. | Like many anatomists, %name% went out on her own into the world. Of course, also like many, she was quickly chewed up by the hungriness of those to whom science means nothing. For now, she will fight alongside sellswords, if only to buy herself extra time to truly get to her studies. | %name% is cynical to the world, upset that some of her peers could see to their education in full, while she must earn coin just to support her studies. May her anger present itself on the battlefield. | One would expect a woman like %name% to appear after a battle, not actually participate in it. The fact such an intelligent, albeit bizarre figure would still need a sellsword's earnings has you wondering if your own prospects of getting anywhere in this world are even worse than you realized. | One cannot overstate %name%'s intellect. She is a wicked smart woman, the sort who can make you question why the gods bothered to give you a mind of your own if it is to be so dwarfed. But, in sellsword matters, she would be just another fighter. Hopefully her martial skills are as sharp as her wits. | You can never know for certain if it were hard times which forced %name% into sellswording, or if she's merely pursuing scientific inquiries by another, far crueler path. That she spends evenings dissecting wagon-crushed dogs and wingless butterflies makes you ponder a lot of things about the curious lass. | Curiosity, not coin, brought %name% to sellswording. She has a keen interest in discovering the creatures of the world, and what they look like on the inside. So long as she makes said insides visible, you could care less what else she does with them.}"
        es = "{%name% es una mujer perspicaz, con la tez arruinada por pruebas constantes y virulentas. Esperas que sus métodos se apliquen mejor a sus enemigos que a sí misma. | Según los rumores, %name% intentó averiguar cómo volar. No con una máquina, sino haciéndose crecer alas. Se desconoce cómo pretendía hacerlo exactamente, o qué fue de sus experimentos. Y, sin embargo, aquí está, con los pies astutamente en la tierra y mirando por encima del hombro. | Como muchos anatomistas, %name% salió por su cuenta al mundo. Por supuesto, también como muchos, pronto se la tragó la voracidad de aquellos para quienes la ciencia no significa nada. Por ahora luchará junto a mercenarios, aunque solo sea para ganar algo de tiempo y dedicarse de verdad a sus estudios. | %name% mira el mundo con cinismo, molesta porque algunos de sus colegas pudieron completar su formación mientras que ella tiene que ganar monedas solo para costear sus estudios. Ojalá su ira se haga presente en el campo de batalla. | Uno esperaría que una mujer como %name% apareciera después de una batalla, no que participara en ella. Que una figura tan inteligente, aunque estrafalaria, siga necesitando la paga de un mercenario te hace preguntarte si tus propias perspectivas de llegar a algo en este mundo son aún peores de lo que creías. | Es imposible exagerar el intelecto de %name%. Es una mujer endiabladamente lista, de las que te hacen preguntarte por qué los dioses se molestaron en darte una mente propia si iba a quedar tan empequeñecida. Pero, en asuntos de mercenarios, sería una luchadora más. Ojalá sus habilidades marciales sean tan afiladas como su ingenio. | Nunca puedes saber con certeza si fueron los tiempos difíciles los que empujaron a %name% a hacerse mercenaria, o si simplemente persigue sus investigaciones científicas por otro camino, mucho más cruel. Que pase las tardes diseccionando perros aplastados por carretas y mariposas sin alas te hace reflexionar sobre muchas cosas de esta curiosa muchacha. | Fue la curiosidad, no el dinero, lo que llevó a %name% a hacerse mercenaria. Tiene un vivo interés por descubrir las criaturas del mundo y cómo son por dentro. Mientras deje dichas entrañas a la vista, te da igual lo que haga después con ellas.}"
    }
    // en = "\x7b%name% is a sharp man with a complexion wrecked by constant and virulent testing. You hope that his methodologies may be better applied to his enemies rather than his own self. | Rumors about %name% suggest he tried to figure out how to fly. Not by machine, rather, but by growing wings. How exactly he intended to do that, or what became of his experiments, is unknown. Yet, here he is, rather shrewdly grounded and looking over his shoulders. | Like many anatomists, %name% went out on his own into the world. Of course, also like many, he was quickly chewed up by the hungriness of those to whom science means nothing. For now, he will fight alongside sellswords, if only to buy himself extra time to truly get to his studies. | %name% is cynical to the world, upset that some of his peers could see to their education in full, while he must earn coin just to support his studies. May his anger present itself on the battlefield. | One would expect a man like %name% to appear after a battle, not actually participate in it. The fact such an intelligent, albeit bizarre figure would still need a sellsword's earnings has you wondering if your own prospects of getting anywhere in this world are even worse than you realized. | One cannot overstate %name%'s intellect. He is a wicked smart man, the sort who can make you question why the gods bothered to give you a mind of your own if it is to be so dwarfed. But, in sellsword matters, he would be just another fighter. Hopefully his martial skills are as sharp as his wits. | You can never know for certain if it were hard times which forced %name% into sellswording, or if he's merely pursuing scientific inquiries by another, far crueler path. That he spends evenings dissecting wagon-crushed dogs and wingless butterflies makes you ponder a lot of things about the curious fellow. | Curiosity, not coin, brought %name% to sellswording. He has a keen interest in discovering the creatures of the world, and what they look like on the inside. So long as he makes said insides visible, you could care less what else he does with them.\x7d"
    // en base_es
    // FILE: mod_legends\hooks\skills\backgrounds\apprentice_background.nut
    // en = "Apprentices tend to be eager for knowledge and learn faster than others."
    // en base_es
    // context: apprentice_background.o.create.m.GoodEnding
    {
        // corrige base: "fue el aprendiz más rápido" no traduce "the quickest learner"; es "quien más rápido aprendía"
        en = "Perhaps one of the sharpest men you've ever met, %name% the apprentice was the quickest learner in the %companyname%. With plenty of crowns stored, %they% retired from fighting to take %their% talents to the business world. Last you heard %they% was doing very well for %themselves% across multiple trades. If you ever have a child, this is the %person% you'll send them to for apprenticeship."
        es = "Quizás una de las mentes más agudas que hayas conocido, %name% %art% aprendiz era quien más rápido aprendía en %companyname%. Con muchas coronas guardadas, se retiró de la lucha para llevar sus talentos al mundo de los negocios. Lo último que supiste es que le estaba yendo muy bien en múltiples oficios. Si alguna vez tienes un hijo, es a %el% a quien lo enviarás como aprendiz."
    }
    // context: apprentice_background.o.create.m.BadEnding
    {
        en = "%name% the apprentice was, by far, the quickest learner in the %companyname%. Little surprise then that %they% was also one of the quickest to recognize its inevitable downfall and leave while %they% still could. Had %they% been born in a different time %they% would have gone on to do great things. Instead, many wars, invasions, and plagues spreading across the land ultimately ensured %name% and many other talented men went to total waste."
        es = "%name% %art% aprendiz era, con diferencia, quien más rápido aprendía en %companyname%. No es de extrañar, pues, que también fuera de los primeros en ver su inevitable caída y marcharse mientras aún podía. De haber nacido en otra época, habría llegado a hacer grandes cosas. En cambio, las muchas guerras, invasiones y plagas que se extendieron por la tierra acabaron por echar a perder a %name% y a tantos otros talentos."
    }
    // en = "the Learner"
    // en base_es
    // en = "Quickmind"
    // en base_es
    // en = "the Apprentice"
    // en base_es
    // en = "the Understudy"
    // en base_es
    // en = "Goodhand"
    // en base_es
    // en = "the Student"
    // en base_es
    // en = "the Young"
    // en base_es
    // en = "the Kid"
    // en base_es
    // en = "the Bright"
    // en base_es
    // context: apprentice_background.o.onBuildDescription
    {
        // corrige base: "Entonces" y "Y no es ningún secreto" van en minúscula, porque siguen a una coma de la variante anterior
        // corrige base: "pasantía" es léxico regional; "apprenticeship" es "un puesto de aprendiz"
        // corrige base: "tejido submarino" pierde el chiste de "underwater basket-weaving"; es "cestería submarina"
        // corrige base: "Instigado" tiene matiz negativo que "Urged" no tiene; es "Animado"
        en = "{One enters the world always looking to be the best they can be, | Mastery of an art is prestigious, | Everybody looks up to the best,} {but no one gets there in an instant. | so what better way to be the best than to learn underneath one? | and it's no secret most look toward the masters for help.} {%name% thought the same, taking the role of an apprentice in %townname%. | Believing this to be true, %name% took up an apprenticeship in %townname%. | When %randomtown%'s college asked for apprentices, %name% was the first to sign up. | Urged by %their% parents to better %their% craft, %name% looked to start %their% career as an apprentice. | Not to be outdone by %their% overachieving brother, %name% began looking for an apprenticeship.} {Unfortunately, %their% master was poorly chosen: an insane carpenter with a penchant for chopping the neckline instead of the treeline. Fleeing the impending doom by association, %name% has ended up in the company of sellswords. | Learning all %they% could, %name% built the greatest work of art possibly ever seen in the field of underwater basket-weaving. %Their% master, though, was a jealous one. Not to be outdone by a pupil, they burned the project to ash and eye-watering fumes. It was clear to %name%: %they% could learn fast, but perhaps there were better masters to study beneath. | %They% had soaked up all there was to learn: masonry, carpentry, blacksmithing, lovemaking. Now %they% turns %their% eyes on the martial arts. While %they% isn't exactly a warrior yet, %name% is a fast learner.}"
        es = "{Uno entra en el mundo siempre buscando ser lo mejor que puede ser, | La maestría en un arte es prestigiosa, | Todos admiran a los mejores,} {pero nadie llega allí de inmediato. | así que, ¿qué mejor manera de ser el mejor que aprender bajo la tutela de uno? | y no es ningún secreto que la mayoría busca la ayuda de los maestros.} {%name% pensó lo mismo y asumió el papel de aprendiz en %townname%. | Convencid%o% de ello, %name% entró como aprendiz en %townname%. | Cuando la universidad de %randomtown% pidió aprendices, %name% fue %art% primer%o% en inscribirse. | Animad%o% por sus padres a mejorar en su oficio, %name% quiso empezar su carrera como aprendiz. | No dispuest%o% a quedarse por detrás de su brillante hermano, %name% empezó a buscar un puesto de aprendiz.} {Por desgracia, eligió mal a su maestro: un carpintero demente con predilección por cortar cuellos en lugar de árboles. Huyendo de la perdición que le esperaba por asociación, %name% ha terminado en compañía de mercenarios. | Aprendiendo todo lo que pudo, %name% construyó posiblemente la mayor obra de arte jamás vista en el campo de la cestería submarina. Sin embargo, su maestro era envidioso. No dispuesto a ser superado por un pupilo, quemó el proyecto hasta reducirlo a cenizas y humos que hacían llorar los ojos. Para %name% estaba claro: podía aprender rápido, pero quizá hubiera mejores maestros con los que estudiar. | Había absorbido todo lo que había que aprender: albañilería, carpintería, herrería, hacer el amor. Ahora dirige su atención a las artes marciales. Aunque todavía no es exactamente %un% guerrer%o%, %name% aprende rápido.}"
    }
    // FILE: mod_legends\hooks\skills\backgrounds\assassin_background.nut
    // context: assassin_background.o.create.m.BackgroundDescription
    {
        en = "The same as any other mercenary, a skilled assassin can be hired for a good sum of crowns."
        es = "Como cualquier otro mercenario, un asesino hábil puede contratarse por una buena suma de coronas."
    }
    // context: assassin_background.o.create.m.GoodEnding
    {
        // corrige base: "incluso meses" y "muy bien" son añadidos que el inglés no tiene
        en = "%name% joined the company in place of the bastard nobleman %they% had come to kill. So strange was this agreement that you kept your eye on the assassin for many days. But all %they% did was fight for the %companyname%, and fight well. Last you heard, the assassin departed the company and has not been seen or heard from since. You checked in on the bastard nobleman himself to see if perhaps the assassin had finished the job, but the man was alive and well. A peculiar run in, in the end."
        es = "%name% se unió a la compañía en lugar del noble bastardo al que había venido a matar. Este acuerdo fue tan extraño que vigilaste de cerca %al% asesin%o% durante muchos días. Pero lo único que hizo fue luchar por %companyname%, y luchar bien. Lo último que supiste fue que %art% asesin%o% abandonó la compañía y no se ha vuelto a ver ni saber nada de %el% desde entonces. Fuiste a ver al propio noble bastardo para comprobar si tal vez %art% asesin%o% había terminado el trabajo, pero el hombre estaba vivo y coleando. Un encuentro peculiar, al fin y al cabo."
    }
    // context: assassin_background.o.create.m.BadEnding
    {
        // corrige base: "incluso meses" es un añadido que el inglés no tiene; "mantuviste tu ojo sobre" es un calco de "kept your eye on"
        en = "%name% joined the company in place of the bastard nobleman %they% had come to kill. So strange was this agreement that you kept your eye on the assassin for many days. But all %they% did was fight for the %companyname%, and fight well. Last you heard, the assassin departed the company not long after your hurried retirement. You decided to check in on %their% target the bastard nobleman only to find out that %they% had been slain by an unseen assassin. It appears %name% finished the job in the end."
        es = "%name% se unió a la compañía en lugar del noble bastardo al que había venido a matar. Este acuerdo fue tan extraño que vigilaste de cerca %al% asesin%o% durante muchos días. Pero lo único que hizo fue luchar por %companyname%, y luchar bien. Lo último que supiste fue que %art% asesin%o% dejó la compañía poco después de tu apresurado retiro. Decidiste ir a ver a su objetivo, el noble bastardo, solo para descubrir que lo había matado un asesino al que nadie vio. Parece que %name% terminó el trabajo, al fin y al cabo."
    }
    // en = "the Assassin"
    // en base_es
    // context: assassin_background.o.create.m.Titles
    {
        en = "the Silent"
        es = "el Silencioso"
    }
    // context: assassin_background.o.create.m.Titles
    {
        en = "the Rogue"
        es = "el Pícaro"
    }
    // context: assassin_background.o.create.m.Titles
    {
        en = "the Sly"
        es = "el Taimado"
    }
    // context: assassin_background.o.getTooltip.ret.push().text
    {
        en = "[color=%positive%]+10%[/color] Chance To Hit Head"
        es = "[color=%positive%]+10%[/color] de probabilidad de golpear en la cabeza"
    }
    // context: assassin_background.o.onBuildDescription
    {
        en = "{%name% likes %their% hoods and loose robes, as %they% walks you can make out a barely audible jingle under %their% coat. | %name% occasionally ducks into alleyways, bushes and dark doorways to exchange items with another figure in a flurry of hands as a predator would stash a fresh kill.} {Although shockingly average, %they% is much quieter than the other recruits you have had the displeasure of meeting. | %name% naturally gravitates to dark corners as rats would to grain and insists that %they% is very famous in certain circles, however %they% quickly changes the subject when you ask %them% for details.} {%They% is often lost in the maddening throng of the towns and hamlets dotted around the countryside - never have you met such an average looking mercenary who also doesn't hesitate to slit the throat of the nearest man if it would so benefit %them%, even if %they% does grumble when travelling during daylight.}"
        es = "{A %name% le gustan las capuchas y las túnicas holgadas; cuando camina, se distingue un tintineo apenas audible bajo su abrigo. | De vez en cuando, %name% se mete en callejones, matorrales y portales oscuros para intercambiar objetos con otra figura en un revuelo de manos, igual que un depredador escondería una presa recién cazada.} {Aunque de una normalidad pasmosa, es mucho más silencios%o% que los demás reclutas que has tenido el disgusto de conocer. | %name% gravita de forma natural hacia los rincones oscuros, como las ratas hacia el grano, e insiste en que es muy famos%o% en ciertos círculos, aunque cambia enseguida de tema cuando le pides detalles.} {A menudo se pierde entre el gentío enloquecedor de los pueblos y aldeas que salpican la campiña; nunca has conocido a %un% mercenari%o% de aspecto tan corriente que, además, no dude en rajarle el cuello al primero que tenga cerca si eso le beneficia, aunque sí refunfuña cuando viaja de día.}"
    }
    // FILE: mod_legends\hooks\skills\backgrounds\assassin_southern_background.nut
    // context: assassin_southern_background.o.create.m.Name
    {
        en = "Hashassin"
        es = "Hashassin"
    }
    // en = "An assassin has to be quick on his feet and skilled with the use of weapons."
    // en base_es
    // en = "%name% the assassin departed the %companyname% with a large chest of gold and traveled far away. From what rumors you've heard, he built a castle in the mountains east of the southern kingdoms. You're not sure if it's true, but there's been a steady increase in dead viziers and lords alike as of late."
    // en base_es
    // en = "%name% disappeared not long after your retirement from the %companyname%. The assassin presumably does not want to be found and there's no telling where he is. In moments of honesty, you tell others you wished you never hired him at all. You just can't shake the terror that it is you he is stalking and hunting, and you spend many nights with one eye open, looking for the man in black with the crooked dagger."
    // en base_es
    // en = "the Shadow"
    // en base_es
    // en = "the Insidious"
    // en base_es
    // en = "the Backstabber"
    // en base_es
    // en = "the Unseen"
    // en base_es
    // en = "the Murderer"
    // en base_es
    // en = "the Dagger"
    // en base_es
    // en = "the Elusive"
    // en base_es
    // context: assassin_southern_background.o.setGender.m.GoodEnding
    {
        en = "%name% the assassin departed the %companyname% with a large chest of gold and traveled far away. From what rumors you've heard, she built a castle in the mountains east of the southern kingdoms. You're not sure if it's true, but there's been a steady increase in dead viziers and lords alike as of late."
        es = "%name% la asesina se alejó de %companyname% con un gran cofre de oro y viajó lejos. Según los rumores que has escuchado, construyó un castillo en las montañas al este de los reinos del sur. No estás seguro de si es cierto, pero ha habido un aumento constante en la cantidad de visires y señores muertos últimamente."
    }
    // context: assassin_southern_background.o.setGender.m.BadEnding
    {
        en = "%name% disappeared not long after your retirement from the %companyname%. The assassin presumably does not want to be found and there's no telling where she is. In moments of honesty, you tell others you wished you never hired her at all. You just can't shake the terror that it is you she is stalking and hunting, and you spend many nights with one eye open, looking for the woman in black with the crooked dagger."
        es = "%name% desapareció poco después de tu retiro de %companyname%. La asesina presumiblemente no quiere ser encontrada y no hay forma de saber dónde está. En momentos de honestidad, les dices a los demás que desearías no haberla contratado nunca. Simplemente no puedes quitarte de encima el terror de que es a ti a quien acecha y caza, y pasas muchas noches con un ojo abierto, buscando a la mujer de negro con la daga torcida."
    }
    // context: assassin_southern_background.o.onBuildDescription
    {
        en = "{You wouldn't think it at first, but %name% is like any other woman. Ordinary. Just an ordinary woman. | %name% looks almost like the mold of every woman you've ever met put together. She has a face you'd never remember. | %name% has a gentle smile and demeanor. She talks to all others as equals, weighing the opinions of wealthy and poor seemingly to measure herself between them. | %name% offers nothing with which to garner a second look. She is wholly simple, and wholly a woman meant to be a part of this world.} {Of course, this is by design. She is an assassin sent by a guild of trained killers. A scroll she carries suggests, without threat, that you take her under your employ. | This unassuming existence is a trained face for a woman who is, in actuality, a trained assassin carrying a one-of-a-kind Qatal dagger from her guild. | A bland face has a murderous past, though, for the woman carries a Qatal dagger given only to the best killers of one of the South's guild of assassins. | But the 'familiar stranger' face is a put on, intended to hide the fact that she is a woman from a guild of assassins sent out for reasons you may never know.} {%name% could be standing right next to you, yet feel as though she's disappeared into a crowd of two. | Despite knowing you've never met the woman until now, you can't help but feel you've seen %name% somewhere before. | You naturally feel at ease around %name%, which almost feels like a setup in and of itself, so in turn you force yourself to stay alert around her instead.}"
        es = "{A primera vista, no pensarías que %name% se diferencia de cualquier otra mujer. Corriente. Solo una mujer común. | %name% parece casi el molde de todas las mujeres que alguna vez has conocido juntas. Tiene un rostro que nunca recordarías. | %name% tiene una sonrisa y unos modales amables. Habla con todos como a iguales, sopesando las opiniones de ricos y pobres, aparentemente para medirse entre ellos. | %name% no ofrece nada que merezca una segunda mirada. Es completamente sencilla y completamente una mujer hecha para formar parte de este mundo.} {Por supuesto, esto es intencional. Es una asesina enviada por un gremio de asesinos entrenados. Un pergamino que lleva sugiere, sin amenazas, que la tomes a tu servicio. | Esta existencia poco llamativa es una fachada ensayada de una mujer que, en realidad, es una asesina entrenada que lleva una daga Qatal única de su gremio. | Sin embargo, ese rostro anodino esconde un pasado homicida, ya que la mujer lleva una daga Qatal otorgada solo a los mejores asesinos de uno de los gremios de asesinos del sur. | Pero ese rostro de 'desconocida familiar' es una fachada, destinada a ocultar el hecho de que es una mujer de un gremio de asesinos enviada por razones que es posible que nunca sepas.} {%name% podría estar de pie justo a tu lado y, aun así, parecer que se ha desvanecido en una multitud de dos. | Aunque sabes que nunca habías visto a esta mujer hasta ahora, no puedes evitar sentir que has visto a %name% en algún lugar antes. | Te sientes cómodo de forma natural con %name%, lo que casi parece una trampa en sí mismo, así que te obligas a mantenerte alerta con ella.}"
    }
    // context: assassin_southern_background.o.onBuildDescription
    {
        // corrige base: "desaparecido en la multitud" pierde "a crowd of two"; es "una multitud de dos"
        // corrige base: "a su alrededor en su lugar" calca "instead"; basta "con él"
        // corrige base: «Ordinario» por «Corriente»: en América «ordinario» significa también «vulgar», y «ordinary» aquí es «del montón»
        en = "{You wouldn't think it at first, but %name% like any other man. Ordinary. Just an ordinary man. | %name% looks almost like the mold of every man you've ever met put together. He has a face you'd never remember. | %name% has a gentle smile and demeanor. He talks to all others as equals, weighing the opinions of wealthy and poor seemingly to measure himself between them. | %name% offers nothing with which to garner a second look. He is wholly simple, and wholly a man meant to be a part of this world.} {Of course, this is by design. He is an assassin sent by a guild of trained killers. A scroll he carries suggests, without threat, that you take him under your employ. | This unassuming existence is a trained face for a man who is, in actuality, a trained assassin carrying a one-of-a-kind Qatal dagger from his guild. | A bland face has a murderous past, though, for the man carries a Qatal dagger given only to the best killers of one of the South's guild of assassins. | But the 'familiar stranger' face is a put on, intended to hide the fact that he is a man from a guild of assassins sent out for reasons you may never know.} {%name% could be standing right next to you, yet feel as though he's disappeared into a crowd of two. | Despite knowing you've never met the man until now, you can't help but feel you've seen %name% somewhere before. | You naturally feel at ease around %name%, which almost feels like a setup in and of itself, so in turn you force yourself to stay alert around him instead.}"
        es = "{A primera vista, no pensarías que %name% se diferencia de cualquier otro hombre. Corriente. Solo un hombre común. | %name% parece casi el molde de todos los hombres que alguna vez has conocido juntos. Tiene un rostro que nunca recordarías. | %name% tiene una sonrisa y unos modales amables. Habla con todos como a iguales, sopesando las opiniones de ricos y pobres, aparentemente para medirse entre ellos. | %name% no ofrece nada que merezca una segunda mirada. Es completamente sencillo y completamente un hombre hecho para formar parte de este mundo.} {Por supuesto, esto es intencional. Es un asesino enviado por un gremio de asesinos entrenados. Un pergamino que lleva sugiere, sin amenazas, que lo tomes a tu servicio. | Esta existencia poco llamativa es una fachada ensayada de un hombre que, en realidad, es un asesino entrenado que lleva una daga Qatal única de su gremio. | Sin embargo, ese rostro anodino esconde un pasado homicida, ya que el hombre lleva una daga Qatal otorgada solo a los mejores asesinos de uno de los gremios de asesinos del sur. | Pero ese rostro de 'desconocido familiar' es una fachada, destinada a ocultar el hecho de que es un hombre de un gremio de asesinos enviado por razones que es posible que nunca sepas.} {%name% podría estar de pie justo a tu lado y, aun así, parecer que se ha desvanecido en una multitud de dos. | Aunque sabes que nunca habías visto a este hombre hasta ahora, no puedes evitar sentir que has visto a %name% en algún lugar antes. | Te sientes cómodo de forma natural con %name%, lo que casi parece una trampa en sí mismo, así que te obligas a mantenerte alerta con él.}"
    }
    // FILE: mod_legends\hooks\skills\backgrounds\barbarian_background.nut
    // context: barbarian_background.o.create.m.GoodEnding
    {
        // corrige base: la 1.0 añade «y unificó», que el inglés no tiene (solo dice 'conquered').
        en = "%name% the barbarian took all the coin %they% earned with the company and ventured north. With %their% money, %they% gathered a band of warriors and conquered so many tribes that, last you heard, %they% had been ordained 'king of the north'."
        es = "%name%, %art% bárbar%o%, tomó todo el oro que ganó con la compañía y se aventuró hacia el norte. Con su dinero, reunió a un grupo de guerreros y conquistó tantas tribus que, según lo último que supiste, había sido coronad%o% como 'el rey en el Norte'."
    }
    // context: barbarian_background.o.create.m.BadEnding
    {
        en = "With things the way they were, %name% departed. Last you heard %they% was traveling north. Penniless with little to %their% name but an axe, and not looking anything like the natives or speaking their tongue, you figure the barbarian did not get far. Based upon what you've seen happen to %their% ilk, %they're% either been killed already or captured as a slave."
        es = "Tal como estaban las cosas, %name% se marchó. Lo último que oíste fue que viajaba hacia el norte. Sin un centavo, con poco más que un hacha a su nombre, sin parecerse en nada a los nativos ni hablar su idioma, supones que %art% bárbar%o% no llegó lejos. Por lo que has visto que les pasa a los de su calaña, o ya %lo% han matado o %lo% han capturado como esclav%o%."
    }
    // context: barbarian_background.o.onBuildDescription
    {
        en = "{%name% survived the battle between yourself and %their% own tribe of warriors. %They% offered %themselves% to your company or to your sword. Impressed by %their% bravery, you chose to take %them% in. A foreign brute, %they% hardly speaks your native tongue and %they% is not well liked by the rest of the company. But if anything can bond two people it is fighting beside one another, killing when it counts, and drinking the night away at the tavern.}"
        es = "{%name% sobrevivió a la batalla entre tú y su propia tribu de guerreros. Se ofreció a tu compañía o a tu espada. Te impresionó su valentía y decidiste acoger%lo%. Es %un% brut%o% extranjer%o% que apenas habla tu lengua y no le cae muy bien al resto de la compañía. Pero si hay algo que une a dos personas es luchar codo con codo, matar cuando importa y pasarse la noche bebiendo en la taberna.}"
    }
    // FILE: mod_legends\hooks\skills\backgrounds\bastard_background.nut
    // en = "Bastard"
    // en base_es
    // context: bastard_background.o.create.m.BackgroundDescription
    {
        en = "Bastards often have profited from some training in melee fighting and know the weaknesses of noble armies."
        es = "Los bastardos a menudo reciben algún entrenamiento en lucha cuerpo a cuerpo y conocen las debilidades de los ejércitos nobles."
    }
    // en = "\x7b%name%, the bastard son of a familially inconsiderate nobleman, departed the %companyname% to try to carve out his own family lineage. The last you heard, he'd managed to acquire himself a good plot of land and a modest stone castle rests on it. While successful, he still harbors resentment for his family. | A bastard son of a nobleman, %name% couldn't help but always have that lingering feeling he just didn't belong in this world. But the %companyname% gave him a brotherhood to call family. As far as you know, he still fights with the company to this day.\x7d"
    // en base_es
    // en = "Bastards like %name% usually don't get far in this world. They're too hated in the highborn world in which they live, and hated by the lowborn because they don't understand the politics that would make a bastard more common to them than any nobleman. Not long after you left the company, you got wind of %name%'s passing. Apparently, a young and cruel lord took over his noble house and saw the bastard as a threat to his throne. Despite the bastard wanting nothing to do with that life anymore, it managed to catch up with him anyway. He was assassinated in a tavern bed, his throat cut as he slept."
    // en base_es
    // en = "\x7b%name% was born during a fiery military campaign far away from his father's home. | %name%'s mother hailed from a pub in %randomtown%. Which is strange, because his father is a married royal in %townname%. | With a wife cursed by a witch, %name%'s father gave himself to another woman to 'continue' the bloodline. | With the king away so long, %name%'s queen of a mother could hardly resist the temptations of a local servant. | %name% was born nine months after raiders pillaged his parents' castle.\x7d \x7bThe life of a bastard was not an easy one: the man was constantly hounded by jealous half-brothers. | Like some kind of royal leper, the bastard was kept far away from the public eye. | Thankfully, for much of his life %name% knew not that he was a bastard child. | A controversy at birth, %name% was only spared abandonment by the omens of a local oracle. | Being a royal bastard gave the man a good life, so long as he kept his head low, and his unwanted status even lower. | Hatred by both strangers and family steeled the bastard for the eventual difficulties outside his royal upbringing.\x7d \x7bAngered by his role in life, %name% did attempt a coup to take the throne. It did not go far. He is now banished from every court in the land. | When a half-brother pelted him with stones, %name% felt little remorse running the sibling through with a sword. He blamed it on a servant, but quickly left his royal housing thereafter. | %name%'s father tried to pass him off as legitimate, but when a royal marriage fell through the ensuing scandal of impropriety proved too much. The bastard now roams the land, free of the shackles of controversy. | Being the oldest son in line made %name% a target for his younger, legitimate brothers. It was an easy choice to leave that life of politics and backstabbing. | Found in bed with a half-sister, the scandals in %name%'s life grew far too heavy to stay in the royal courts. | Tired of the trivialities of royal processions, %name% only wishes to join a group of men that care not for bloodlines and legitimacy. | When an assassin poisoned his father's wine, %name% was quickly blamed for the murder. Escaping an angry mob was only the beginning of an exciting, new life. | While he came to love him dearly, %name%'s father knew the royal court was not safe. He sent the man away to forge a life on his own terms.\x7d"
    // en base_es
    // FILE: mod_legends\hooks\skills\backgrounds\beast_hunter_background.nut
    // en = "Beast Slayers are used to expertly hunt monstrous beasts at all ranges."
    // en base_es
    // en = "%name% retired from the company and bought the deed to an abandoned castle. There he commands a troop of fellow beast slayers who journey the land protecting it from monsters. Last you spoke to him he had a raven-haired lady friend who did not take kindly to your presence, nor the presence of anyone else for that matter. You're sure he's happy."
    // en base_es
    // en = "After leaving the %companyname%, %name% retired from beast slaying altogether and last you heard he fathered an albino daughter. Unfortunately, rumors spread quickly about the girl having supernatural powers and her mother was executed by fire. The father and child were never caught nor seen again."
    // en base_es
    // en = "the Beasthunter"
    // en base_es
    // en = "Woodstalker"
    // en base_es
    // en = "the Beastslayer"
    // en base_es
    // en = "the Trophyhunter"
    // en base_es
    // context: beast_hunter_background.o.setGender.m.GoodEnding
    {
        // corrige base: la 1.0 añade una variante entera (la de la 'plata' contra seres sobrenaturales) que el inglés no tiene, y trae las erratas «las escritura» e «insvestigando».
        en = "%name% retired from the company and bought the deed to an abandoned castle. There she commands a troop of fellow beast slayers who journey the land protecting it from monsters. Last you spoke to her she had a raven-haired lady friend who did not take kindly to your presence, nor the presence of anyone else for that matter. You're sure she's happy."
        es = "%name% se retiró de la compañía y compró la escritura de un castillo abandonado. Allí comanda una tropa de compañeros cazadores de bestias que recorren la tierra protegiéndola de los monstruos. La última vez que hablaste con ella, tenía una amiga de cabello negro azabache que no vio con buenos ojos tu presencia, ni la de nadie más, para ser sinceros. Estás seguro de que es feliz."
    }
    // context: beast_hunter_background.o.setGender.m.BadEnding
    {
        en = "After leaving the %companyname%, %name% retired from beast slaying altogether and last you heard she was mother of an albino daughter. Unfortunately, rumors spread quickly about the girl having supernatural powers and her father was executed by fire. The mother and child were never caught nor seen again."
        es = "Tras dejar %companyname%, %name% abandonó por completo la caza de bestias y lo último que supiste es que era madre de una hija albina. Por desgracia, enseguida corrieron rumores de que la niña tenía poderes sobrenaturales, y a su padre lo quemaron en la hoguera. A la madre y a la hija nunca las atraparon, ni se las volvió a ver."
    }
    // context: beast_hunter_background.o.onBuildDescription
    {
        en = "{{%name%'s past is hardly an extravagant one. | %name% has been traveling these parts for some time, but not always in her current vocation. | Despite her grisly job, %name% did not come from an extraordinary life. | A long list of defeated beasts and the pelts to prove it misleads one as to %name%'s background.} {The beast slayer was once a mere hunter, armed with both bow and wisdom. However, upon discovering a monstrous direwolf in one of his traps she acquired a taste for hunting more dangerous foes. | When her village kept getting attacked by webknechts, the woman took to learning all she could about hunting beasts. And then doing just that to much success. | It's said she was a village's miller until alps haunted the town whole. Never much of a sleeper herself, she spent nights learning about the monsters until she bettered them. | She served as prey finder for a local lord. But when a hunt went awry and into the jaws of an unhold, the woman turned to studying beasts and how to slay them. | A mere lumberjack, the beast slayer came into true being when all her peers were slaughtered at the hands of a schrat, a living tree. She avenged her friends and vowed to learn all she could of monsters. | A former nun, the woman turned to studying beasts and swords alike after nachzehrers ravaged her monastery.} {Times are changing, though, and not even this skilled monstrum hunter can go it alone. She seeks to join a company and kill as many beasts as she can. | The days are uncharacteristically short and the moon blooms bright every night. This slayer feels a change in the air, and if she's going to fight what's coming she'll need more than just herself to do it. | While not fond of company, the beast slayer wants to kill as many creatures as she can, and she'll need the help of some fine comrades to do just that. | In a world becoming more dangerous and desperate, the beast slayer seeks coin and company both. | A professional journeywoman such as this woman could be of great use to a mercenary company and you've little doubt she'll be diligent in her death dealing. | Unfortunately, the woman took an apprentice under her wings only for the kid to be slaughtered by a direwolf. The broken beast slayer now seeks sturdier company.}}"
        es = "{{El pasado de %name% no tiene nada de extravagante. | %name% lleva algún tiempo viajando por estos lugares, pero no siempre en su ocupación actual. | A pesar de su trabajo macabro, %name% no proviene de una vida extraordinaria. | Una larga lista de bestias derrotadas y las pieles para demostrarlo pueden llevar a engaño acerca del trasfondo de %name%.} {La cazadora de bestias no era más que una simple cazadora, armada con arco y sabiduría. Sin embargo, al descubrir un monstruoso lobo huargo en una de sus trampas, le tomó el gusto a cazar enemigos más peligrosos. | Como su aldea sufría ataques constantes de los webknechts, la mujer se dedicó a aprender todo lo que pudo sobre la caza de bestias. Y luego a cazarlas con mucho éxito. | Se dice que era la molinera de una aldea hasta que los alps asediaron el pueblo entero. Como nunca había dormido mucho, pasaba las noches estudiando a los monstruos hasta que los superó. | Sirvió como rastreadora de presas para un señor local. Pero cuando una cacería salió mal y acabó en las fauces de un trol, la mujer se dedicó a estudiar a las bestias y cómo matarlas. | Antes era una simple leñadora, pero la cazadora de bestias se convirtió en lo que es cuando todos sus compañeros fueron masacrados a manos de un schrat, un árbol viviente. Vengó a sus amigos y juró aprender todo lo que pudiera sobre los monstruos. | Antes fue monja, pero se dedicó a estudiar tanto a las bestias como a las espadas después de que los nachzehrers arrasaran su monasterio.} {Sin embargo, los tiempos están cambiando y ni siquiera esta hábil cazadora de monstruos puede arreglárselas sola. Busca unirse a una compañía y matar tantas bestias como pueda. | Los días son inusualmente cortos y la luna florece radiante cada noche. Esta cazadora siente un cambio en el aire, y si va a luchar contra lo que viene, no le bastará consigo misma. | Aunque no le agrada la compañía, la cazadora de bestias quiere matar tantas criaturas como pueda y necesitará la ayuda de algunos buenos camaradas para lograrlo. | En un mundo cada vez más peligroso y desesperado, la cazadora de bestias busca monedas y compañía por igual. | Una profesional del oficio como esta mujer podría ser de gran utilidad para una compañía de mercenarios, y apenas dudas de que será diligente repartiendo muerte. | Por desgracia, la mujer tomó a un aprendiz bajo su protección solo para que un lobo huargo lo despedazara. Destrozada, la cazadora de bestias busca ahora una compañía más robusta.}}"
    }
    // context: beast_hunter_background.o.onBuildDescription
    {
        // corrige base: «la luna brilla brillantemente» es una redundancia (el inglés dice 'the moon blooms bright'); 'journeyman' no es «viajero» sino un profesional del oficio.
        en = "{{%name%'s past is hardly an extravagant one. | %name% has been traveling these parts for some time, but not always in his current vocation. | Despite his grisly job, %name% did not come from an extraordinary life. | A long list of defeated beasts and the pelts to prove it misleads one as to %name%'s background.} {The beast slayer was once a mere hunter, armed with both bow and wisdom. However, upon discovering a monstrous direwolf in one of his traps he acquired a taste for hunting more dangerous foes. | When his village kept getting attacked by webknechts, the man took to learning all he could about hunting beasts. And then doing just that to much success. | It's said he was a village's miller until alps haunted the town whole. Never much of a sleeper himself, he spent nights learning about the monsters until he bettered them. | He served as prey finder for a local lord. But when a hunt went awry and into the jaws of an unhold, the man turned to studying beasts and how to slay them. | A mere lumberjack, the beast slayer came into true being when all his peers were slaughtered at the hands of a schrat, a living tree. He avenged his friends and vowed to learn all he could of monsters. | A former monk, the man turned to studying beasts and swords alike after nachzehrers ravaged his monastery.} {Times are changing, though, and not even this skilled monstrum hunter can go it alone. He seeks to join a company and kill as many beasts as he can. | The days are uncharacteristically short and the moon blooms bright every night. This slayer feels a change in the air, and if he's going to fight what's coming he'll need more than just himself to do it. | While not fond of company, the beast slayer wants to kill as many creatures as he can, and he'll need the help of some fine comrades to do just that. | In a world becoming more dangerous and desperate, the beast slayer seeks coin and company both. | A professional journeyman such as this man could be of great use to a mercenary company and you've little doubt he'll be diligent in his death dealing. | Unfortunately, the man took an apprentice under his wings only for the kid to be slaughtered by a direwolf. The broken beast slayer now seeks sturdier company.}}"
        es = "{{El pasado de %name% difícilmente es extravagante. | %name% ha estado viajando por estos lugares durante algún tiempo, pero no siempre en su ocupación actual. | A pesar de su trabajo macabro, %name% no proviene de una vida extraordinaria. | Una larga lista de bestias derrotadas y las pieles para demostrarlo pueden llevar a engaño acerca del trasfondo de %name%.} {El cazador de bestias solía ser simplemente un cazador, armado con arco y sabiduría. Sin embargo, al descubrir un monstruoso lobo huargo en una de sus trampas, adquirió un gusto por cazar enemigos más peligrosos. | Cuando su aldea seguía siendo atacada por los webknechts, el hombre se dedicó a aprender todo lo que pudo sobre la caza de bestias. Y luego lo hizo con mucho éxito. | Se dice que era molinero de una aldea hasta que los alps asediaron por completo el pueblo. Aunque nunca fue un gran dormilón, pasaba las noches aprendiendo sobre los monstruos hasta que los superó. | Sirvió como rastreador de presas para un señor local. Pero cuando una cacería salió mal y cayó en las fauces de un trol, el hombre se dedicó a estudiar a las bestias y cómo matarlas. | Antes era simplemente un leñador, pero el cazador de bestias se convirtió en lo que es cuando todos sus compañeros fueron masacrados a manos de un schrat, un árbol viviente. Vengó a sus amigos y juró aprender todo lo que pudiera sobre los monstruos. | Antes fue monje, pero se dedicó a estudiar tanto a las bestias como a las espadas después de que los nachzehrers arrasaran su monasterio.} {Sin embargo, los tiempos están cambiando y ni siquiera este hábil cazador de monstruos puede enfrentarlo solo. Busca unirse a una compañía y matar tantas bestias como pueda. | Los días son inusualmente cortos y la luna florece radiante cada noche. Este cazador siente un cambio en el aire, y si va a luchar contra lo que viene, no le bastará consigo mismo. | Aunque no le agrada la compañía, el cazador de bestias quiere matar tantas criaturas como pueda y necesitará la ayuda de algunos buenos camaradas para lograrlo. | En un mundo que se vuelve más peligroso y desesperado, el cazador de bestias busca monedas y compañía por igual. | Un profesional del oficio como este hombre podría ser de gran utilidad para una compañía de mercenarios y tienes pocas dudas de que será diligente en su trabajo de muerte. | Desafortunadamente, tomó un aprendiz bajo su protección solo para que el joven fuera asesinado por un lobo huargo. Destrozado, el cazador de bestias busca ahora una compañía más robusta.}}"
    }
    // FILE: mod_legends\hooks\skills\backgrounds\beggar_background.nut
    // en = "Beggar"
    // en base_es
    // en = "Beggars aren't the most determined persons, and living on the street tends to be detrimental to their health."
    // en base_es
    // en = "Having enough of all the fighting, %name% the once-beggar retired from the %companyname%. You know the man made a pretty crown in his time with the mercenary company, yet the other day you saw him out begging again. You asked if he'd wasted all his money and he laughed. He said he'd purchased land and was doing just fine. Then he held out his little tin and asked for a crown. You gave him two."
    // en base_es
    // en = "The fighting life is a rough one, and %name% the once-beggar saw fit to retire from it before it became a deadly one. Unfortunately, he went back to beggaring. Word has it that a nobleman cleaned a city of riff-raff and sent them marching north despite it being winter. Cold and hungry, %name% died on the side of a road, a tin cup frozen to his finger."
    // en base_es
    // en = "the Dirty"
    // en base_es
    // en = "the Poor"
    // en base_es
    // en = "the Ragged"
    // en base_es
    // en = "the Sick"
    // en base_es
    // en = "the Liar"
    // en base_es
    // en = "the Idle"
    // en base_es
    // en = "the Sloth"
    // en base_es
    // en = "the Useless"
    // en base_es
    // en = "the Weasel"
    // en base_es
    // en = "the Skunk"
    // en base_es
    // en = "the Sluggard"
    // en base_es
    // en = "the Homeless"
    // en base_es
    // context: beggar_background.o.setGender.m.Name
    {
        en = "Widow"
        es = "Viuda"
    }
    // context: beggar_background.o.setGender.m.BackgroundDescription
    {
        en = "Widows who can't find another husband have few choices, mercenary work is a last resort of the hopeless."
        es = "Las viudas que no encuentran otro marido tienen pocas opciones; el trabajo de mercenario es el último recurso de quienes ya no tienen esperanza."
    }
    // context: beggar_background.o.setGender.m.GoodEnding
    {
        // corrige base: la 1.0 omite que lo viste mendigando otra vez (el sentido del chiste), calca 'made a pretty crown' como «hizo una bonita corona» (es ganar un buen dinero) y añade «Sonreíste», «vieja» y «'solo una corona'», que el inglés no tiene.
        en = "Having enough of all the fighting, %name% the once-beggar retired from the %companyname%. You know the woman made a pretty crown in her time with the mercenary company, yet the other day you saw her out begging again. You asked if she'd wasted all his money and he laughed. He said she'd purchased land and was doing just fine. Then she held out her little tin and asked for a crown. You gave her two."
        es = "Harta de tanta pelea, %name%, la antigua mendiga, se retiró de %companyname%. Sabes que la mujer ganó un buen puñado de coronas en su tiempo con la compañía de mercenarios, y aun así el otro día la viste mendigando de nuevo. Le preguntaste si había despilfarrado todo su dinero y se rio. Dijo que había comprado tierras y que le iba de maravilla. Luego te tendió su latita y te pidió una corona. Le diste dos."
    }
    // context: beggar_background.o.setGender.m.BadEnding
    {
        // corrige base: «Frío y hambriento» dice que era de carácter frío; 'Cold' es que estaba aterido, muerto de frío.
        en = "The fighting life is a rough one, and %name% the once-beggar saw fit to retire from it before it became a deadly one. Unfortunately, she went back to begging. Word has it that a nobleman cleaned a city of riff-raff and sent them marching north despite it being winter. Cold and hungry, %name% died on the side of a road, a tin cup frozen to her finger."
        es = "La vida de lucha es dura, y %name%, la antigua mendiga, consideró oportuno retirarse de ella antes de que se volviera mortal. Por desgracia, volvió a mendigar. Se dice que un noble limpió una ciudad de gentuza y la mandó marchar hacia el norte pese a ser invierno. Aterida y hambrienta, %name% murió a un lado del camino, con una taza de hojalata congelada en el dedo."
    }
    // context: beggar_background.o.getTooltip.ret.push().text
    {
        en = "[color=%positive%]50% less likely[/color] to be targeted by an enemy."
        es = "[color=%positive%]Un 50% menos de probabilidades[/color] de ser blanco de un enemigo."
    }
    // context: beggar_background.o.onBuildDescription
    {
        en = "{After losing her husband to a fire | After her husband's gambling addiction got the better of him | Her husband was framed for a crime he didn't commit, and having to pay the constable everything to keep herself out of the dungeons | A refugee and widow after her village was burned to the ground | Banished from her home after a violent struggle with her husband | A woman with few talents and no husband | After being released alone from a lord's dungeon where she spent countless years chained to a wall | After giving all her worldly possessions to an obscure cult that took her husband and promised salvation of her eternal soul | Married to a very intelligent man until a brigand knocked him over the head}, {%name% found herself on the streets, | %name% was forced onto the streets,} {having to beg for bread | depending on the goodwill of others | being beaten and resigned to her fate | spending what little coin she had to drink the days away | digging into the trash of others and scurrying away from lawmen | avoiding ruffians and thugs while she begged for crowns}. {While she seems earnest in becoming a mercenary, there is little doubt that all her time on the street, and her former marriage, have robbed %name% of her best years. | Years have passed and took a toll on her health by now. | Once a woman like %name% has spent a few days on the streets, much less a few years, even the very dangerous job of being a sellsword seems like the greenest of pastures. | Only the gods know what %name% has done to survive, but she is a frail woman standing before you now. | At the sight of you she rises with open arms to embrace you, claiming to know you well from years past and many a shared adventure, although your name escapes her at the moment.}"
        es = "{Tras perder a su marido en un incendio | Después de que la adicción al juego de su marido pudiera con él | Después de que acusaran falsamente a su marido de un crimen que no cometió y de tener que pagarle todo al alguacil para no acabar en las mazmorras | Refugiada y viuda después de que redujeran su aldea a cenizas | Desterrada de su hogar tras una pelea violenta con su marido | Mujer de pocos talentos y sin marido | Tras salir sola de la mazmorra de un señor, donde pasó incontables años encadenada a una pared | Tras entregar todos sus bienes terrenales a un oscuro culto que se llevó a su marido y le prometió la salvación de su alma eterna | Casada con un hombre muy inteligente hasta que un bandido le dio un golpe en la cabeza}, {%name% se vio en la calle, | %name% se vio obligada a vivir en la calle,} {teniendo que mendigar pan | dependiendo de la buena voluntad de los demás | recibiendo palizas y resignada a su destino | gastando las pocas monedas que tenía en pasarse los días bebiendo | hurgando en la basura ajena y escabulléndose de los agentes de la ley | esquivando a rufianes y matones mientras mendigaba coronas}. {Aunque parece decidida a hacerse mercenaria, no cabe duda de que todo su tiempo en la calle, y su antiguo matrimonio, le han robado a %name% sus mejores años. | Los años han ido pasando y a estas alturas ya han hecho mella en su salud. | Cuando una mujer como %name% ha pasado unos días en la calle, ya no digamos unos años, hasta el peligrosísimo oficio de mercenario parece el más verde de los prados. | Solo los dioses saben lo que %name% ha hecho para sobrevivir, pero ahora tienes delante a una mujer frágil. | Al verte, se levanta con los brazos abiertos para abrazarte, asegurando que te conoce bien de años atrás y de muchas aventuras compartidas, aunque en este momento no recuerda tu nombre.}"
    }
    // en = "\x7bAfter losing everything to a fire | After his gambling addiction got the better of him | Framed for a crime he didn't commit, and having to pay the constable everything to keep himself out of the dungeons | A refugee after his village was burned to the ground | Banished from his home after a violent struggle with his brother | A man with few talents and no ambition | After being released from a lord's dungeon where he spent countless years chained to a wall | After giving all his worldly possessions to an obscure cult promising salvation of his eternal soul | A very intelligent man until a brigand knocked him over the head\x7d, \x7b%name% found himself on the streets, | %name% was forced onto the streets,\x7d \x7bhaving to beg for bread | depending on the goodwill of others | being beaten and resigned to his fate | spending what little coin he had to drink the days away | digging into the trash of others and scurrying away from lawmen | avoiding ruffians and thugs while he begged for crowns\x7d. \x7bWhile he seems earnest in becoming a mercenary, there is little doubt that all his time on the street have robbed %name% of his best years. | Years have passed and took a toll on his health by now. | Once a man like %name% has spent a few days on the streets, much less a few years, even the very dangerous job of being a sellsword seems like the greenest of pastures. | Only the gods know what %name% has done to survive, but he is a frail man standing before you now. | At the sight of you he rises with open arms to embrace you, claiming to know you well from years past and many a shared adventure, although your name escapes him at the moment.\x7d"
    // en base_es
    // FILE: mod_legends\hooks\skills\backgrounds\beggar_southern_background.nut
    // context: beggar_southern_background.o.onBuildDescription
    {
        en = "{After losing her husband to a fire | After her husband's gambling addiction got the better of him | Her husband was framed for a crime he didn't commit, and having to pay the constable everything to keep herself out of the dungeons | A refugee and widow after her village was burned to the ground | Banished from her home after a violent struggle with her husband | A woman with few talents and no husband | After being released alone from a dungeon where she spent countless years chained to a wall | After giving all her worldly possessions to an obscure cult that took her husband and promised salvation of her eternal soul | Married to a very intelligent man until a brigand knocked him over the head}, {%name% found herself on the streets, | %name% was forced onto the streets,} {having to beg for bread | depending on the goodwill of others | being beaten and resigned to her fate | spending what little coin she had to drink the days away | digging into the trash of others and scurrying away from lawmen | avoiding ruffians and thugs while she begged for crowns}. {While she seems earnest in becoming a mercenary, there is little doubt that all her time on the street, and her former marriage, have robbed %name% of her best years. | Years have passed and took a toll on her health by now. | Once a woman like %name% has spent a few days on the streets, much less a few years, even the very dangerous job of being a sellsword seems like the greenest of pastures. | Only the gods know what %name% has done to survive, but she is a frail woman standing before you now. | At the sight of you she rises with open arms to embrace you, claiming to know you well from years past and many a shared adventure, although your name escapes her at the moment.}"
        es = "{Tras perder a su marido en un incendio | Después de que la adicción al juego de su marido pudiera con él | Después de que acusaran falsamente a su marido de un crimen que no cometió y de tener que pagarle todo al alguacil para no acabar en las mazmorras | Refugiada y viuda después de que redujeran su aldea a cenizas | Desterrada de su hogar tras una pelea violenta con su marido | Mujer de pocos talentos y sin marido | Tras salir sola de una mazmorra donde pasó incontables años encadenada a una pared | Tras entregar todos sus bienes terrenales a un oscuro culto que se llevó a su marido y le prometió la salvación de su alma eterna | Casada con un hombre muy inteligente hasta que un bandido le dio un golpe en la cabeza}, {%name% se vio en la calle, | %name% se vio obligada a vivir en la calle,} {teniendo que mendigar pan | dependiendo de la buena voluntad de los demás | recibiendo palizas y resignada a su destino | gastando las pocas monedas que tenía en pasarse los días bebiendo | hurgando en la basura ajena y escabulléndose de los agentes de la ley | esquivando a rufianes y matones mientras mendigaba coronas}. {Aunque parece decidida a hacerse mercenaria, no cabe duda de que todo su tiempo en la calle, y su antiguo matrimonio, le han robado a %name% sus mejores años. | Los años han ido pasando y a estas alturas ya han hecho mella en su salud. | Cuando una mujer como %name% ha pasado unos días en la calle, ya no digamos unos años, hasta el peligrosísimo oficio de mercenario parece el más verde de los prados. | Solo los dioses saben lo que %name% ha hecho para sobrevivir, pero ahora tienes delante a una mujer frágil. | Al verte, se levanta con los brazos abiertos para abrazarte, asegurando que te conoce bien de años atrás y de muchas aventuras compartidas, aunque en este momento no recuerda tu nombre.}"
    }
    // en = "\x7bAfter losing everything to a fire | After his gambling addiction got the better of him | Framed for a crime he didn't commit, and having to pay the constable everything to keep himself out of the dungeons | A refugee after his village was burned to the ground | Banished from his home after a violent struggle with his brother | A man with few talents and no ambition | After being released from a dungeon where he spent countless years chained to a wall | After giving all his worldly possessions to an obscure cult promising salvation of his eternal soul | A very intelligent man until a brigand knocked him over the head\x7d, \x7b%name% found himself on the streets, | %name% was forced onto the streets,\x7d \x7bhaving to beg for bread | depending on the goodwill of others | being beaten and resigned to his fate | spending what little coin he had to drink the days away | digging into the trash of others and scurrying away from lawmen | avoiding ruffians and thugs while he begged for crowns\x7d. \x7bWhile he seems earnest in becoming a mercenary, there is little doubt that all his time on the street have robbed %name% of his best years. | Years have passed and took a toll on his health by now. | Once a man like %name% has spent a few days on the streets, much less a few years, even the very dangerous job of being a sellsword seems like the greenest of pastures. | Only the gods know what %name% has done to survive, but he is a frail man standing before you now. | At the sight of you he rises with open arms to embrace you, claiming to know you well from years past and many a shared adventure, although your name escapes him at the moment.\x7d"
    // en base_es
    // FILE: mod_legends\hooks\skills\backgrounds\belly_dancer_background.nut
    // en = "Belly Dancer"
    // en base_es
    // context: belly_dancer_background.o.create.m.GoodEnding
    {
        en = "%name% the southern belly dancer left the company in good time. While their... particularities made her an excellent soldier, it was not her life's passion. To entertain, through rhythmic, confusingly erotic motions, that is what she wanted. The last you heard, they were in the court of a Vizier serving not only as an entertainer, but, thanks to time with the %companyname%, also as an adviser on martial matters."
        es = "%name%, la bailarina del vientre sureña, dejó la compañía a tiempo. Si bien sus... particularidades la convirtieron en una excelente soldado, no era la pasión de su vida. Entretener mediante movimientos rítmicos y desconcertantemente eróticos: eso era lo que quería. Lo último que supiste es que estaba en la corte de un visir, donde servía no solo como artista, sino también, gracias a su tiempo con %companyname%, como consejera en asuntos marciales."
    }
    // context: belly_dancer_background.o.create.m.BadEnding
    {
        en = "As the company failed to achieve the success you had hoped for, many departed its ranks. The southern belly dancer joined them. Unfortunately, %name% sought to ply her trade in the north, thinking she might be able to spread culture there. The indigenous population was quick to accuse her of 'unregulated body sorcery' and burn %name% at the stake."
        es = "Como la compañía no logró el éxito que esperabas, muchos abandonaron sus filas. La bailarina del vientre sureña se fue con ellos. Por desgracia, %name% intentó ejercer su oficio en el norte, creyendo que podría llevar allí algo de cultura. Los lugareños no tardaron en acusarla de 'brujería corporal no regulada' y en quemar a %name% en la hoguera."
    }
    // en = "the Belly Dancer"
    // en base_es
    // FILE: mod_legends\hooks\skills\backgrounds\bowyer_background.nut
    // en = "Bowyer"
    // en base_es
    // en = "Bowyers tend to have some knowledge about how to use the ranged weaponry they used to craft."
    // en base_es
    // en = "While at a jousting tournament, a young boy was using an oddly shaped, yet perfectly crafted bow. His aiming hand was shaky, yet the arrows did not wobble upon being loosed. After he won the competition, you inquired about where the boy had gotten such an incredible bow. He stated that a bowyer by the name of %name% had crafted it. Apparently, he's known for making the finest bows in all the land!"
    // en base_es
    // en = "After you left the %companyname%, you sent a letter inquiring about the status of %name% the bowyer. You got word that he had discovered a way to craft the finest bow possible and, instead of giving this secret to the company, he departed to start his own business. He did not get far: whatever he had learned about his trade died with him on a muddy road out \x7bnorth | south | west | east\x7d of here, his body ironically skewered with what is said to have been a dozen arrows."
    // en base_es
    // en = "the Bowyer"
    // en base_es
    // en = "the Fletcher"
    // en base_es
    // en = "the Arrowmaker"
    // en base_es
    // en = "Fletcher"
    // en base_es
    // context: bowyer_background.o.setGender.m.BackgroundDescription
    {
        en = "Fletchers have a good understanding of how bows and crossbows work, even if they do lack practical experience."
        es = "Las flecheras entienden bien cómo funcionan los arcos y las ballestas, aunque les falte experiencia práctica."
    }
    // context: bowyer_background.o.setGender.m.GoodEnding
    {
        // corrige base: la 1.0 trata al jugador de «usted» («usted preguntó»), cuando el corpus lo tutea, y traduce 'Apparently' abriendo oración por «Aparentemente» (va «Al parecer»).
        en = "While at a jousting tournament, a young girl was using an oddly shaped, yet perfectly crafted bow. Her aiming hand was shaky, yet the arrows did not wobble upon being loosed. After she won the competition, you inquired about where the girl had gotten such an incredible bow. She stated that a bowyer by the name of %name% had given it to her. Apparently, she's known for making the finest bows in all the land!"
        es = "Durante un torneo de justas, una muchacha usaba un arco de forma extraña, pero perfectamente elaborado. Le temblaba la mano al apuntar, pero las flechas no se tambaleaban al soltarlas. Cuando ganó la competición, le preguntaste de dónde había sacado un arco tan increíble. Dijo que se lo había regalado una fabricante de arcos llamada %name%. ¡Al parecer, es conocida por hacer los mejores arcos de todo el continente!"
    }
    // context: bowyer_background.o.setGender.m.BadEnding
    {
        en = "After you left the %companyname%, you sent a letter inquiring about the status of %name% the fletcher. You got word that she had discovered a way to craft the finest arrow possible and, instead of giving this secret to the company, she departed to start his own business. She did not get far: whatever she had learned about her trade died with her on a muddy road out {north | south | west | east} of here, her body ironically skewered with what is said to have been a dozen arrows."
        es = "Después de dejar %companyname%, enviaste una carta para preguntar por %name%, la flechera. Te enteraste de que había descubierto la manera de fabricar la mejor flecha posible y, en lugar de compartir el secreto con la compañía, se marchó para montar su propio negocio. No llegó muy lejos: todo lo que había aprendido de su oficio murió con ella en un camino embarrado al {norte | sur | oeste | este} de aquí, con el cuerpo irónicamente ensartado por lo que, según dicen, fue una docena de flechas."
    }
    // context: bowyer_background.o.onBuildDescription
    {
        en = "{With calloused hands and an eye for thin strings, | Born to a blacksmith, it's definitely somewhat curious that | Picking up her trade from a long lineage of strong-sighted forefathers,} %name% is a fletcher and bowyer. {Plying her trade for royalty, her career came to an end when a bowstring snapped, cutting off the finger of a promising heir. | Unfortunately, war destroyed the forests from which she used to draw the finest wood. | Sadly, she sold arrows to a young boy which led to a horrible, arrow-related accident. After much debate, she was no longer wanted in town. | But after so many years of making weapons for others, she began to wonder what else there was to life besides wood and string.} {Now, %name% seeks a different path. If she can't sell arrows, maybe she can use them. | Now %name% rests in the company of the very men she used to supply. | With her interest in bowmaking gone, can the former bowyer shoot arrows as well as she makes them?}"
        es = "{Con las manos encallecidas y buen ojo para las cuerdas finas, | Hija de un herrero, resulta cuando menos curioso el hecho de que | Tras heredar el oficio de un largo linaje de antepasados de vista aguda,} %name% es flechera y fabricante de arcos. {Trabajaba para la realeza, pero su carrera terminó cuando una cuerda de arco se rompió y le cortó un dedo a un heredero prometedor. | Por desgracia, la guerra arrasó los bosques de los que solía sacar la mejor madera. | Tristemente, vendió flechas a un niño, lo que acabó en un horrible accidente relacionado con flechas. Tras mucho debate, ya no la querían en el pueblo. | Pero tras tantos años fabricando armas para otros, empezó a preguntarse qué más había en la vida además de la madera y la cuerda.} {Ahora, %name% busca un camino diferente. Si no puede vender flechas, quizá pueda usarlas. | Ahora %name% descansa en compañía de los mismos hombres a los que solía abastecer. | Ahora que ha perdido el interés por hacer arcos, ¿sabrá la antigua fabricante disparar flechas tan bien como las hace?}"
    }
    // en = "\x7bWith calloused hands and an eye for thin strings, | Born to a blacksmith, it's definitely somewhat curious that | Picking up his trade from a long lineage of strong-sighted forefathers,\x7d %name% is a fletcher and bowyer. \x7bPlying his trade for royalty, his career came to an end when a bowstring snapped, cutting off the finger of a promising heir. | Unfortunately, war destroyed the forests from which he used to draw the finest wood. | Sadly, he sold a bow to a young boy which led to a horrible, arrow-related accident. After much debate, he was no longer wanted in town. | But after so many years of making weapons for others, he began to wonder what else there was to life besides wood and string.\x7d \x7bNow, %name% seeks a different path. If he can't sell bows, maybe he can use them. | Now %name% rests in the company of the very men he used to supply. | With his interest in bowmaking gone, can the former bowyer shoot arrows as well as he makes them?\x7d"
    // en base_es
    // FILE: mod_legends\hooks\skills\backgrounds\brawler_background.nut
    // en = "Brawlers are unmatched in unarmed combat, and physical exercise tends to leave them in good shape."
    // en base_es
    // en = "A brawler like %name% is dangerous with just his fists, and proved himself similarly savage with weapons. Before you left the %companyname%, you talked to the fighter about whether or not he'd stay in the band. He said he had no desire to return to prizefighting, shook your hand, and thanked you for giving him the opportunity. Last you heard, the company chose him for a one-on-one, winner take all fight to settle compensation differences with a competing mercenary band. He won in the first round."
    // en base_es
    // en = "%name% the brawler left the company when it became clear it would soon dissolve and probably end up killing everyone who stayed onboard. He returned to prizefighting, grinding out the following years in brutal, weekly bouts. As he got older, his chin disappeared, as did his speed and power. He was left jobbing, intentionally taking falls and losing badly when he didn't. Eventually, no one would give him a fight. A nobleman offered him a large sum to wrestle a bear and the desperate %name% took him up on it. When the 'fight' was over, the brawler lay dead, mangled beyond recognition, being dragged around the mud by a ferocious beast as drunken highborn cheered and clapped."
    // en base_es
    // en = "\x7bBurly and with churchbells for fists, %name% has spent much of the past year sharpening his boxing skills on the grindstone that is his fellow man. | With a face contorted to the shapes of others' knuckles, it's not hard to realize that %name% is a career fighter. | %name% loves the drink as much as he does a good fight, a potent combination. | A hard upbringing by his father and brothers honed %name% into being a temperamental fighter. | Bullies in %name%'s spriteful youth forged him into a man that prefers to seek out a fight rather than wait for it to come to him.  | %name% only ever had one real talent: using his fists to bloody the noses of other men and not going down no matter what. | Growing up, %name% wrestled bulls on the family farm. Unfortunately for men, he found time to venture into the cities.\x7d \x7bFor the past year he has been employed by a local lord, paraded around to fistfight the champions of royalty. | A lover of the bar brawl, the man has apparently been banned from too many taverns to count. | Gaining notoriety as a fighter in %randomtown% meant he had to fight every single proud, boasting, and drunk man who came his way. | Although he became an undefeated prizefighter, he was hardly earning enough to get by. | Fiery in spirit, he's always willing to take up fisticuffs. Local fighting rings say he's got a mean left hook.\x7d \x7bHearing of greater fights to be had, %name% has put down his mitts to take up the more lucrative vocation of being a sellsword. | Only one person has bested %name%: his wife. After she chided him for being an embarrassment with no ambition, he decided to take up the more 'prestigious' field of mercenary work. | Years of martial combat practically destroyed his memory. Some think he mistook a mercenary camp as an item on his shopping list. | Very low on crowns and barely able to open his broken hands to hug his own son much less throw a punch, %name% seeks a new career. | After years of hardship, the promise of regular pay for mercenary work is a tempting offer for him, even though he has little idea of actual warfare. | This man could murder a rock and injure a stone - a good addition to any outfit.\x7d"
    // en base_es
    // context: brawler_background.o.getTooltip.ret.push().text
    {
        en = "[color=%positive%]5%[/color] bonus damage to [color=#400080]Hand to Hand[/color] and [color=#400080]Choke[/color]"
        es = "[color=%positive%]5%[/color] de daño adicional con [color=#400080]Puñetazo[/color] y [color=#400080]Estrangular[/color]"
    }
    // FILE: mod_legends\hooks\skills\backgrounds\butcher_background.nut
    // en = "Butchers are used to bloodshed."
    // en base_es
    // en = "Mercenary work is a bloody business, which is probably why a butcher like %name% felt right at home in it. While an outstanding fighter, you hear that he still has problems with the war dogs in the party and has been repeatedly caught trying to slaughter them. Eventually, if not desperately, the company gave the man an adorable puppy to raise as his own. From what you know of, the little runt's glowy doe eyes converted the dog hater into a lover. Now he goes into an insatiable bloodlust whenever a wardog is harmed and his little mongrel grew up to be the fiercest beast in the company!"
    // en base_es
    // en = "%name% the butcher eventually left the declining company. He joined up with another outfit, but was caught slaughtering one of their war dogs. Apparently, he had been feeding the mercenaries dogmeat from all their mongrels that had gone 'missing'. They did not take this news kindly, stripped the butcher, and fed him to the beasts."
    // en base_es
    // en = "the Butcher"
    // en base_es
    // en = "the Cleaver"
    // en base_es
    // en = "the Red"
    // en base_es
    // en = "Redmeat"
    // en base_es
    // en = "Bloodeye"
    // en base_es
    // context: butcher_background.o.setGender.m.Name
    {
        en = "Fishmonger"
        es = "Pescadero"
    }
    // context: butcher_background.o.setGender.m.BackgroundDescription
    {
        en = "Fishmongers are used to spilled guts."
        es = "Las pescaderas están acostumbradas a las tripas desparramadas."
    }
    // context: butcher_background.o.setGender.m.GoodEnding
    {
        // corrige base: la 1.0 añade al final la frase «Serían buenos amigos con el adiestrador de perro.», que el inglés no tiene.
        en = "Mercenary work is a bloody business, which is probably why a fishmonger like %name% felt right at home in it. While an outstanding fighter, you hear that she still has problems with the war dogs in the party and has been repeatedly caught trying to slaughter them. Eventually, if not desperately, the company gave the woman an adorable puppy to raise as her own. From what you know of, the little runt's glowy doe eyes converted the dog hater into a lover. Now she goes into an insatiable bloodlust whenever a wardog is harmed and her little mongrel grew up to be the fiercest beast in the company!"
        es = "El trabajo de mercenario es un negocio sangriento, y seguramente por eso una pescadera como %name% se sintió como en casa en él. Aunque es una luchadora excepcional, te cuentan que todavía tiene problemas con los perros de guerra del grupo y que la han sorprendido varias veces intentando matarlos. Al final, por no decir a la desesperada, la compañía le dio a la mujer un cachorro adorable para que lo criara como suyo. Por lo que sabes, los ojitos brillantes de cervatillo del pequeñajo convirtieron a la que odiaba a los perros en una amante de ellos. ¡Ahora la invade una sed de sangre insaciable cada vez que hieren a un perro de guerra, y su pequeño mestizo ha crecido hasta convertirse en la bestia más feroz de la compañía!"
    }
    // context: butcher_background.o.setGender.m.BadEnding
    {
        en = "%name% the fishmonger eventually left the declining company. She joined up with another outfit, but was caught slaughtering one of their war dogs. Apparently, she had been feeding the mercenaries dogmeat from all their mongrels that had gone 'missing'. They did not take this news kindly, stripped the butcher, and fed her to the beasts."
        es = "%name%, la pescadera, acabó dejando la compañía en decadencia. Se unió a otra banda, pero la sorprendieron matando a uno de sus perros de guerra. Por lo visto, había estado dando de comer a los mercenarios la carne de todos los chuchos que habían 'desaparecido'. No se lo tomaron nada bien: desnudaron a la carnicera y se la echaron a las bestias."
    }
    // context: butcher_background.o.onBuildDescription
    {
        en = "{After her father's death, %name% took over the family butcher shop in %randomtown%. | Growing up poor, %name% quickly learned to kill and strip animals, eventually founding a butcher's shop. | With droughts ruining the farmlands, %name%'s butcher shop took off in %randomtown%. | Always a strange girl, %name% took to butchering not only for profit, but for pleasure. | Grinning ear to ear, %name% never looked so happy as when her shop opened and she got her first order of live pigs in stock. | As a butcher, %name% has spent years squishing guts out of dead rabbits and lopping heads off sometimes-dead fish.} {But rumors of animal torture eventually drove the cleaver-swinger from her business. | Given the terrible rumors of dark arts already going around, it wasn't long until people began questioning the source of her meats and drove her out of business. | But killing animals, for one reason or another, didn't quite excite her anymore. She sought something new. | After a human finger was found in one of her deer wrappings, the woman was driven from his business. | Some say she most enjoyed butchering for soldiers during the orc invasions and wishes to return to that experience once more. | Unfortunately, the war drove through her shop, leaving behind a number of carcasses she wouldn't dare butcher. | Living in a city under siege, she provided meat for the hungry. When it was found out where that meat came from, she was handed over to the besiegers who, unwittingly, let her live. | The woman's friendliness with poachers caught up with her, ultimately leaving her on the road with a retinue of the local lords's men on her tail. | Butchering a tiny fish became a scandal when it turned out to be a nobleman's pet. She fled to save her own scales.} {Something about blood and guts sits just right with %name%. In that case, welcome to the battlefield. | %name% looks at everything as a potential meat sale with breathing, moving packaging. | Many are disturbed by %name%'s mere presence and all-too-wide eyes. | %name% is known to bite her tongue and savor the blood. | %name%'s ears perk whenever a pig squeals. The same thing happens when a man screams. Interesting. | %name%'s a butcher, but apparently has little interest in actually feeding the outfit.}"
        es = "{Tras la muerte de su padre, %name% se hizo cargo de la carnicería familiar en %randomtown%. | Criada en la pobreza, %name% aprendió pronto a matar y despellejar animales, y con el tiempo abrió una carnicería. | Con las sequías arruinando los campos de cultivo, la carnicería de %name% despegó en %randomtown%. | Rara desde niña, %name% se aficionó a descuartizar no solo por dinero, sino por placer. | Con una sonrisa de oreja a oreja, %name% nunca pareció tan feliz como cuando abrió su tienda y recibió su primer pedido de cerdos vivos. | Como carnicera, %name% se ha pasado años estrujando las tripas de conejos muertos y cortando la cabeza a peces a veces muertos.} {Pero los rumores de que torturaba animales acabaron por apartar de su negocio a la de la cuchilla. | Con los terribles rumores sobre artes oscuras que ya circulaban, la gente no tardó en preguntarse de dónde salía su carne y la dejó sin negocio. | Pero matar animales, por una razón u otra, ya no la entusiasmaba. Buscaba algo nuevo. | Después de que apareciera un dedo humano en uno de sus paquetes de venado, echaron a la mujer de su negocio. | Algunos dicen que lo que más disfrutó fue descuartizar para los soldados durante las invasiones orcas y que desea volver a vivirlo. | Por desgracia, la guerra pasó por su tienda y dejó tras de sí unos cuantos cadáveres que no se atrevería a despiezar. | Vivía en una ciudad asediada y daba carne a los hambrientos. Cuando se descubrió de dónde salía esa carne, la entregaron a los sitiadores, que, sin saberlo, la dejaron vivir. | Su amistad con los cazadores furtivos le pasó factura y acabó en los caminos, con un séquito de hombres del señor local pisándole los talones. | Descuartizar un pececillo se convirtió en un escándalo cuando resultó ser la mascota de un noble. Huyó para salvar sus propias escamas.} {Hay algo en la sangre y las tripas que a %name% le sienta de maravilla. En ese caso, bienvenida al campo de batalla. | %name% ve en todo una posible venta de carne con un envoltorio que respira y se mueve. | A muchos les perturba la mera presencia de %name% y sus ojos demasiado abiertos. | Se sabe que %name% se muerde la lengua y saborea la sangre. | A %name% se le aguzan los oídos cada vez que chilla un cerdo. Lo mismo pasa cuando grita un hombre. Interesante. | %name% es carnicera, pero por lo visto tiene poco interés en dar de comer a la banda.}"
    }
    // en = "\x7bAfter his father's death, %name% took over the family butcher shop in %randomtown%. | Growing up poor, %name% quickly learned to kill and strip animals, eventually founding a butcher's shop. | With droughts ruining the farmlands, %name%'s butcher shop took off in %randomtown%. | Always a strange boy, %name% took to butchering not only for profit, but for pleasure. | Grinning ear to ear, %name% never looked so happy as when his shop opened and he got his first order of live pigs in stock. | As a butcher, %name% has spent years squishing guts out of dead rabbits and lopping heads off sometimes-dead fish.\x7d \x7bBut rumors of animal torture eventually drove the cleaver-swinger from his business. | Given the terrible rumors of dark arts already going around, it wasn't long until people began questioning the source of his meats and drove him out of business. | But killing animals, for one reason or another, didn't quite excite him anymore. He sought something new. | After a human finger was found in one of his deer wrappings, the man was driven from his business. | Some say he most enjoyed butchering for soldiers during the orc invasions and wishes to return to that experience once more. | Unfortunately, the war drove through his shop, leaving behind a number of carcasses he wouldn't dare butcher. | Living in a city under siege, he provided meat for the hungry. When it was found out where that meat came from, he was handed over to the besiegers who, unwittingly, let him live. | The man's friendliness with poachers caught up with him, ultimately leaving him on the road with a retinue of the local lords's men on his tail. | Butchering a tiny pig became a scandal when it turned out to be a nobleman's pet. He fled to save his own bacon.\x7d \x7bSomething about blood and guts sits just right with %name%. In that case, welcome to the battlefield. | %name% looks at everything as a potential meat sale with breathing, moving packaging. | Many are disturbed by %name%'s mere presence and all-too-wide eyes. | %name% is known to bite his tongue and savor the blood. | %name%'s ears perk whenever a pig squeals. The same thing happens when a man screams. Interesting. | %name%'s a butcher, but apparently has little interest in actually feeding the outfit.\x7d"
    // en base_es
    // FILE: mod_legends\hooks\skills\backgrounds\butcher_southern_background.nut
    // en = "\x7bAfter his father's death, %name% took over the family butcher shop in %randomtown%. | Growing up poor, %name% quickly learned to kill and strip animals, eventually founding a butcher's shop. | With droughts ruining the farmlands, %name%'s butcher shop took off in %randomcitystate%. | Always a strange boy, %name% took to butchering not only for profit, but for pleasure. | Grinning ear to ear, %name% never looked so happy as when his shop opened and he got his first order of live pigs in stock. | As a butcher, %name% has spent years squishing guts out of dead rabbits and lopping heads off sometimes-dead fish.\x7d \x7bBut rumors of animal torture eventually drove the cleaver-swinger from his business. | Given the terrible rumors of dark arts already going around, it wasn't long until people began questioning the source of his meats and drove him out of business. | But killing animals, for one reason or another, didn't quite excite him anymore. He sought something new. | After a human finger was found in one of his deer wrappings, the man was driven from his business. | Some say he most enjoyed butchering for the viziers' men during one of their campaigns against the desert tribes and wishes to return to that experience once more. | Unfortunately, the war drove through his shop, leaving behind a number of carcasses he wouldn't dare butcher. | Butchering a tiny pig became a scandal when it turned out to be a nobleman's pet. He fled to save his own bacon.\x7d \x7bSomething about blood and guts sits just right with %name%. In that case, welcome to the battlefield. | %name% looks at everything as a potential meat sale with breathing, moving packaging. | Many are disturbed by %name%'s mere presence and all-too-wide eyes. | %name% is known to bite his tongue and savor the blood. | %name%'s ears perk whenever a pig squeals. The same thing happens when a man screams. Interesting. | %name%'s a butcher, but apparently has little interest in actually feeding the outfit.\x7d"
    // en base_es
    // FILE: mod_legends\hooks\skills\backgrounds\caravan_hand_background.nut
    // en = "Caravan Hand"
    // en base_es
    // en = "Caravan hands are used to long and exhausting travels."
    // en base_es
    // en = "%name% the once-caravan hand retired from fighting. He used his mercenary money to start a trade-guarding business that specializes in transporting goods through dangerous lands."
    // en base_es
    // en = "%name% the caravan hand retired back into guarding trade wagons. He died when defending against an ambush by brigands. They took his shirt and left his body in a ditch."
    // en base_es
    // context: caravan_hand_background.o.onBuildDescription
    {
        // corrige base: «casi un verdugo» no es 'nary a whip away from being a slave driver' (a un látigo de ser capataz de esclavos); errata «un emboscada»; 'a fellow caravan' es otra caravana, no «un compañero de caravana»; calcos «corría por su vida», «parece ser un ajuste natural» y «podría usar más hombres como él» ('could use' es que le vendrían bien).
        en = "{Always the adventurous type, %name% was easily drawn to the life of a caravan hand. | Orphaned by war and pestilence, %name% grew up under the wings of a traveling merchant. | A caravan hand's life is tough, but %name% could hardly stand staying in one place for too long. | Though the work is dangerous, being a caravan hand allowed %name% to see the world. | When his family and obligations were destroyed by fire, %name% saw no reason not to join a passing caravan. | Hardy and resolute, %name% was the first chosen by a merchant to protect his stock as a caravan hand. | Running away from home, it didn't take long for %name% to join and eventually work for a caravan.} {But the trader he worked for turned out to be abusive, nary a whip away from being a slave driver. After an intense argument with the woman, %name% thought it better to leave before he did something awful. | One day, goods went missing and the hand was blamed for it, promptly ending his time with the caravan. | But a caravan needs protection for a reason, and an ambush by brigands proved why. %name% barely made it out alive. | Years on the road went without a hitch until a new caravan master refused to pay %name%. With just one hand the caravanner punched his boss and grabbed his wages. He used both legs to run, though. | Caravans are frequently tense places to be. One fateful evening, in a dispute over gambling debts, he stove in the head of another traveler. Fearing retribution, %name% was gone before morning. | Sadly, with the expanding war the caravan's profits were marginal. %name% was let go as the merchants retired their wagons. | After seeing the foul work of beasts on a fellow caravan, it didn't take long for %name% to figure out his wages didn't quite meet the level of threats around him. | But war deprived the caravan of stock and soon its driver took to selling slaves. Appalled, %name% freed as many as he could before leaving for good. | Sadly, his caravan began to sell human chattel. While the profits were enormous, it garnered the attention of a local militia - and their pitchforks. One ambush later and %name% was running for his life.} {Now uncertain of what to do, he seeks any opportunity that might come by. | A man like %name% is no stranger to danger, making him a good fit for any mercenary group. | With his caravan days behind him, working as a sellsword was just another avenue for adventure and profit. | In %name%'s mind, being a mercenary is a lot like being a caravanner. Just better paid. | Well versed to traveling, %name% seems like a natural fit to the tasks already befit for a mercenary. | Years of road travel have molded %name% into quite the durable figure. Any group of mercenaries could use more men like him.}"
        es = "{Siempre del tipo aventurero, %name% se sintió fácilmente atraído por la vida de guardia de caravana. | Huérfano por la guerra y la peste, %name% creció bajo la protección de un mercader ambulante. | La vida de un guardia de caravana es dura, pero a %name% le costaba quedarse en un solo lugar durante mucho tiempo. | Aunque el trabajo es peligroso, ser guardia de caravana permitió a %name% ver el mundo. | Cuando su familia y sus obligaciones quedaron destruidas por el fuego, %name% no vio motivo para no unirse a una caravana que pasaba. | Fuerte y resuelto, %name% fue el primer elegido por un mercader para proteger su carga como guardia de caravana. | Tras huir de casa, %name% no tardó en unirse a una caravana y acabar trabajando para ella.} {Pero la comerciante para la que trabajaba resultó ser abusiva, a un látigo de ser una capataz de esclavos. Después de una intensa discusión con la mujer, %name% pensó que era mejor irse antes de hacer algo terrible. | Un día desaparecieron mercancías y se culpó al guardia, lo que puso fin de inmediato a su tiempo con la caravana. | Pero una caravana necesita protección por algo, y una emboscada de bandidos demostró por qué. %name% apenas salió con vida. | Pasó años en los caminos sin contratiempos hasta que un nuevo jefe de caravana se negó a pagarle a %name%. Con una sola mano, el guardia golpeó a su jefe y se llevó su paga. Eso sí, para correr usó las dos piernas. | Las caravanas suelen ser lugares tensos. Una noche fatídica, en una disputa por deudas de juego, le aplastó la cabeza a otro viajero. Temiendo represalias, %name% se fue antes del amanecer. | Lamentablemente, con la guerra extendiéndose, las ganancias de la caravana eran mínimas. %name% fue despedido cuando los mercaderes retiraron sus carros. | Después de ver la obra atroz de unas bestias sobre otra caravana, %name% no tardó en darse cuenta de que su paga no estaba a la altura de las amenazas que lo rodeaban. | Pero la guerra dejó a la caravana sin mercancía y pronto su conductor se puso a vender esclavos. Horrorizado, %name% liberó a tantos como pudo antes de irse para siempre. | Lamentablemente, su caravana comenzó a vender esclavos humanos. Si bien las ganancias eran enormes, atrajo la atención de una milicia local, y de sus horcas. Una emboscada más tarde, %name% corría para salvar la vida.} {Ahora, sin saber qué hacer, busca cualquier oportunidad que pueda surgir. | Un hombre como %name% no es ajeno al peligro, lo que lo convierte en un buen candidato para cualquier grupo de mercenarios. | Con sus días de caravana atrás, trabajar como mercenario era simplemente otro camino hacia la aventura y el beneficio. | En la mente de %name%, ser mercenario es muy parecido a ser guardia de caravana. Solo que mejor pagado. | Bien versado en viajar, %name% parece encajar de forma natural en las tareas propias de un mercenario. | Años de viajes por los caminos han hecho de %name% una figura bastante resistente. A cualquier grupo de mercenarios le vendrían bien más hombres como él.}"
    }
    // FILE: mod_legends\hooks\skills\backgrounds\caravan_hand_southern_background.nut
    // context: caravan_hand_southern_background.o.setGender.m.GoodEnding
    {
        en = "%name% the once-caravan hand retired from fighting. She used her mercenary money to start a trade-guarding business that specializes in transporting goods through dangerous lands."
        es = "%name%, la que alguna vez fue guardia de caravanas, se retiró de la lucha. Usó su dinero de mercenaria para montar un negocio de escolta comercial especializado en transportar mercancías a través de tierras peligrosas."
    }
    // context: caravan_hand_southern_background.o.setGender.m.BadEnding
    {
        en = "%name% the caravan hand retired back into guarding trade wagons. She died when defending against an ambush by brigands. They took her clothes and left her body in a ditch."
        es = "%name%, la guardia de caravanas, volvió a proteger carros comerciales. Murió defendiéndose de una emboscada de bandidos. Le quitaron la ropa y dejaron su cuerpo en una zanja."
    }
    // context: caravan_hand_southern_background.o.onBuildDescription
    {
        en = "{Always the adventurous type, %name% was easily drawn to the life of a caravan hand. | Orphaned by war and pestilence, %name% grew up under the wings of a traveling merchant. | A caravan hand's life is tough, but %name% could hardly stand staying in one place for too long. | Though the work is dangerous, being a caravan hand allowed %name% to see the world. | When her family and obligations were destroyed by fire, %name% saw no reason not to join a passing caravan. | Hardy and resolute, %name% was the first chosen by a merchant to protect his stock as a caravan hand. | Running away from home, it didn't long for %name% to join and eventually work for a caravan.} {But the trader she worked for turned out to be abusive, nary a whip away from being a slave driver. After an intense argument with the woman, %name% thought it better to leave before she did something awful. | One day, goods went missing and the hand was blamed for it, promptly ending her time with the caravan. | But a caravan needs protection for a reason, and an ambush by desert raiders proved why. %name% barely made it out alive. | Years on the road went without a hitch until a new caravan master refused to pay %name%. With just one hand the caravanner punched her boss and grabbed her wages. She used both legs to run, though. | Caravans are frequently tense places to be. One fateful evening, in a dispute over gambling debts, she stove in the head of another traveler. Fearing retribution, %name% was gone before morning. | Sadly, with the expanding war the caravan's profits were marginal. %name% was let go as the merchants retired their wagons. | After seeing the foul work of beasts on a fellow caravan, it didn't take long for %name% to figure out her wages didn't quite meet the level of threats around her. | But war deprived the caravan of stock and soon its driver took to selling slaves. Appalled, %name% freed as many as she could before leaving for good. | Sadly, her caravan began to sell human chattel. While the profits were enormous, it garnered the attention of a local militia - and their pitchforks. One ambush later and %name% was running for her life.} {Now uncertain of what to do, she seeks any opportunity that might come by. | A woman like %name% is no stranger to danger, making her a good fit for any mercenary group. | With her caravan days behind her, working as a sellsword was just another avenue for adventure and profit. | In %name%'s mind, being a mercenary is a lot like being a caravanner. Just better paid. | Well versed to traveling, %name% seems like a natural fit to the tasks already befit for a mercenary. | Years of road travel have molded %name% into quite the durable figure. Any group of mercenaries could use more women like her.}"
        es = "{Siempre del tipo aventurero, %name% se sintió fácilmente atraída por la vida de guardia de caravana. | Huérfana por la guerra y la peste, %name% creció bajo la protección de un mercader ambulante. | La vida de una guardia de caravana es dura, pero a %name% le costaba quedarse en un solo lugar durante mucho tiempo. | Aunque el trabajo es peligroso, ser guardia de caravana permitió a %name% ver el mundo. | Cuando su familia y sus obligaciones quedaron destruidas por el fuego, %name% no vio motivo para no unirse a una caravana que pasaba. | Fuerte y resuelta, %name% fue la primera elegida por un mercader para proteger su carga como guardia de caravana. | Tras huir de casa, %name% no tardó en unirse a una caravana y acabar trabajando para ella.} {Pero la comerciante para la que trabajaba resultó ser abusiva, a un látigo de ser una capataz de esclavos. Después de una intensa discusión con la mujer, %name% pensó que era mejor irse antes de hacer algo terrible. | Un día desaparecieron mercancías y culparon a la guardia, lo que puso fin de inmediato a su tiempo con la caravana. | Pero una caravana necesita protección por algo, y una emboscada de saqueadores del desierto demostró por qué. %name% apenas salió con vida. | Pasó años en los caminos sin contratiempos hasta que un nuevo jefe de caravana se negó a pagarle a %name%. Con una sola mano, la guardia golpeó a su jefe y se llevó su paga. Eso sí, para correr usó las dos piernas. | Las caravanas suelen ser lugares tensos. Una noche fatídica, en una disputa por deudas de juego, le aplastó la cabeza a otro viajero. Temiendo represalias, %name% se fue antes del amanecer. | Lamentablemente, con la guerra extendiéndose, las ganancias de la caravana eran mínimas. %name% fue despedida cuando los mercaderes retiraron sus carros. | Después de ver la obra atroz de unas bestias sobre otra caravana, %name% no tardó en darse cuenta de que su paga no estaba a la altura de las amenazas que la rodeaban. | Pero la guerra dejó a la caravana sin mercancía y pronto su conductor se puso a vender esclavos. Horrorizada, %name% liberó a tantos como pudo antes de irse para siempre. | Lamentablemente, su caravana comenzó a vender esclavos humanos. Si bien las ganancias eran enormes, atrajo la atención de una milicia local, y de sus horcas. Una emboscada más tarde, %name% corría para salvar la vida.} {Ahora, sin saber qué hacer, busca cualquier oportunidad que pueda surgir. | Una mujer como %name% no es ajena al peligro, lo que la convierte en una buena candidata para cualquier grupo de mercenarios. | Con sus días de caravana atrás, trabajar como mercenaria era simplemente otro camino hacia la aventura y el beneficio. | En la mente de %name%, ser mercenaria es muy parecido a ser guardia de caravana. Solo que mejor pagado. | Bien versada en viajar, %name% parece encajar de forma natural en las tareas propias de un mercenario. | Años de viajes por los caminos han hecho de %name% una figura bastante resistente. A cualquier grupo de mercenarios le vendrían bien más mujeres como ella.}"
    }
    // en = "\x7bAlways the adventurous type, %name% was easily drawn to the life of a caravan hand. | Orphaned by war and pestilence, %name% grew up under the wings of a traveling merchant. | A caravan hand's life is tough, but %name% could hardly stand staying in one place for too long. | Though the work is dangerous, being a caravan hand allowed %name% to see the world. | When his family and obligations were destroyed by fire, %name% saw no reason not to join a passing caravan. | Hardy and resolute, %name% was the first chosen by a merchant to protect his stock as a caravan hand. | Running away from home, it didn't long for %name% to join and eventually work for a caravan.\x7d \x7bBut the trader he worked for turned out to be abusive, nary a whip away from being a slave driver. After an intense argument with the woman, %name% thought it better to leave before he did something awful. | One day, goods went missing and the hand was blamed for it, promptly ending his time with the caravan. | But a caravan needs protection for a reason, and an ambush by desert raiders proved why. %name% barely made it out alive. | Years on the road went without a hitch until a new caravan master refused to pay %name%. With just one hand the caravanner punched his boss and grabbed his wages. He used both legs to run, though. | Caravans are frequently tense places to be. One fateful evening, in a dispute over gambling debts, he stove in the head of another traveler. Fearing retribution, %name% was gone before morning. | Sadly, with the expanding war the caravan's profits were marginal. %name% was let go as the merchants retired their wagons. | After seeing the foul work of beasts on a fellow caravan, it didn't take long for %name% to figure out his wages didn't quite meet the level of threats around him. | But war deprived the caravan of stock and soon its driver took to selling slaves. Appalled, %name% freed as many as he could before leaving for good. | Sadly, his caravan began to sell human chattel. While the profits were enormous, it garnered the attention of a local militia - and their pitchforks. One ambush later and %name% was running for his life.\x7d \x7bNow uncertain of what to do, he seeks any opportunity that might come by. | A man like %name% is no stranger to danger, making him a good fit for any mercenary group. | With his caravan days behind him, working as a sellsword was just another avenue for adventure and profit. | In %name%'s mind, being a mercenary is a lot like being a caravanner. Just better paid. | Well versed to traveling, %name% seems like a natural fit to the tasks already befit for a mercenary. | Years of road travel have molded %name% into quite the durable figure. Any group of mercenaries could use more men like him.\x7d"
