    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]You tell %inventor% that the %companyname% has no resources to spare for such things at this time. The inventor lowers his head and lets out a sigh.%SPEECH_ON%I understand. Perhaps later, then. I'll be around.%SPEECH_OFF%"
        es = ""
