        es = "Tiene un alcance de [color=%positive%]<range>[/color] casillas en terreno llano"
    }
    // context: legend_firefield_skill.getTooltip.ret.extend().text
    {
        en = "Inflicts an additional [color=%damage%]15[/color] - [color=%damage%]30[/color] damage per turn for three turns across six tiles. Burns allies. Requires a staff"
        es = "Inflige [color=%damage%]15[/color] - [color=%damage%]30[/color] de daño adicional por turno durante tres turnos en seis casillas. Quema a los aliados. Requiere un bastón"
    }
    // en = "Fire rages here, melting armor and flesh alike"
    // en base_es
    // FILE: scripts\skills\actives\legend_flagellate_skill.nut
    // context: legend_flagellate_skill.create.m.Description
    {
        en = "Lash out to apply three stacks of bleeding damage at once. Quite ineffective against armor."
        es = "Azota con furia para aplicar de una vez tres acumulaciones de daño por sangrado. Bastante ineficaz contra la armadura."
    }
    // context: legend_flagellate_skill.create.m.KilledString
    {
        en = "Flaggelated to death"
        es = "Flagelado hasta la muerte"
