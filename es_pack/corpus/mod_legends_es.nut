    // context: perk_legend_ambidextrous.getTooltip.ret.push().text
    {
        en = "[color=%positive%]+5[/color] Melee Skill"
        es = "[color=%positive%]+5[/color] de Habilidad cuerpo a cuerpo"
    }
    // FILE: scripts\skills\perks\perk_legend_anchor.nut
    // context: perk_legend_anchor.getDescription
    {
        en = "Hold your ground!"
        es = "¡Mantén la posición!"
    }
    // context: perk_legend_anchor.getTooltip.text
