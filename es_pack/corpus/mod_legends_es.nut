    // FILE: scripts\skills\actives\legend_deathtouch_skill.nut
    // context: legend_deathtouch_skill.create.m.Description
    {
        en = "Your fingers turn ghostly and pass through steel and flesh, tearing at the soul of your victim. Uses Melee Skill to hit."
        es = "Tus dedos se vuelven espectrales y atraviesan acero y carne, desgarrando el alma de tu víctima. Usa la Habilidad cuerpo a cuerpo para acertar."
    }
