    // en = "End the active character's turn and have the next character in line act."
    // en base_es
    // en = "Wait Turn (Spacebar, End)"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        // text = "Pause the active character\'s turn and move them to the end of the queue. Waiting this turn will also have you act later (as though you only had" + (this.Const.Combat.InitiativeAfterWaitMult * 100).tointeger() + " % of your initiative) next turn."
        mode = "pattern"
        en = "Pause the active character's turn and move them to the end of the queue. Waiting this turn will also have you act later (as though you only had<pct:int> % of your initiative) next turn."
        es = "Pausa el turno del personaje activo y lo mueve al final de la cola. Esperar este turno también hará que actúes más tarde el próximo turno (como si solo tuvieras el <pct> % de tu Iniciativa)."
    }
    // en = "End Round (R)"
    // en base_es
    // en = "End the current round and have all your men skip their turn until the next round starts."
    // en base_es
    // en = "Open Inventory (I, C)"
    // en base_es
    // en = "Open the character screen and inventory for the active Battle Brother."
    // en base_es
    // en = "Leave"
    // en base_es
    // en = "Leave tactical combat and return to the world map."
    // en base_es
    // en = "Leveled Up"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.result.text
    {
        // corrige base: "perk" es «ventaja», no «habilidad» («habilidad» es "skill").
        en = "This character just leveled up! Find them in your roster, accessible on the worldmap, to raise their attributes and select a perk."
        es = "¡Este personaje acaba de subir de nivel! Encuéntralo en tu lista, accesible en el mapa mundial, para mejorar sus atributos y seleccionar una ventaja."
    }
    // en = "Light Wounds"
    // en base_es
    // en = "Light bruises, flesh wounds, loss of blood and similar that caused this character to lose hitpoints without impairing their abilities."
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.result.push().text
    {
        // text = "Will heal in [color=%negative%]" + entity.getDaysWounded() + "[/color] days"
        mode = "pattern"
        en = "Will heal in [color=%negative%]<days:int>[/color] days"
        es = "Se curará en [color=%negative%]<days>[/color] días"
    }
    // en = "Kills"
    // en base_es
    // en = "The number of kills this character had during the battle."
    // en base_es
    // en = "Experience Gained"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "The number of experience points gained during the battle from fighting and killing opponents. Gaining enough experience points will allow this mercenary to level up, increase attributes and gain new perks."
        es = "La cantidad de puntos de experiencia obtenidos durante la batalla al luchar y matar oponentes. Obtener suficientes puntos de experiencia le permitirá a este mercenario subir de nivel, aumentar atributos y obtener nuevas ventajas."
    }
    // en = "Damage Dealt"
    // en base_es
    // en = "The damage dealt by this character during battle, against hitpoints and against armor."
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.result.push().text
    {
        // text = "Dealt [color=%positive%]" + combatStats.DamageDealtHitpoints + "[/color] damage to hitpoints"
        mode = "pattern"
        en = "Dealt [color=%positive%]<dmg:int>[/color] damage to hitpoints"
        es = "Infligió [color=%positive%]<dmg>[/color] de daño a los puntos de vida"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.result.push().text
    {
        // text = "Dealt [color=%positive%]" + combatStats.DamageDealtArmor + "[/color] damage to armor"
        mode = "pattern"
        en = "Dealt [color=%positive%]<dmg:int>[/color] damage to armor"
        es = "Infligió [color=%positive%]<dmg>[/color] de daño a la armadura"
    }
    // en = "Damage Received"
    // en base_es
    // en = "The damage received by this character, split into damage to hitpoints and damage to armor. The value is after any possible damage reduction."
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.result.push().text
    {
        // text = "Received [color=%negative%]" + combatStats.DamageReceivedHitpoints + "[/color] hitpoint damage"
        mode = "pattern"
        en = "Received [color=%negative%]<dmg:int>[/color] hitpoint damage"
        es = "Recibió [color=%negative%]<dmg>[/color] de daño a los puntos de vida"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.result.push().text
    {
        // text = "Received [color=%negative%]" + combatStats.DamageReceivedArmor + "[/color] armor damage"
        mode = "pattern"
        en = "Received [color=%negative%]<dmg:int>[/color] armor damage"
        es = "Recibió [color=%negative%]<dmg>[/color] de daño a la armadura"
    }
    // en = "Loot all Items"
    // en base_es
    // en = "Loot all items found until the stash is full."
    // en base_es
    // en = "Change Name & Title"
    // en base_es
    // en = "Click here to change the character's name and title."
    // en base_es
    // en = "Experience"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        // corrige base: "perk" es «ventaja», no «habilidad pasiva o activa», y "perk points" es «puntos de ventaja», no «puntos de habilidad»; además, «aún puede» debe concordar con «los personajes» («aún pueden»).
        en = "Characters gain experience as they or their allies slay enemies in battles. If a character has accumulated sufficient experience, they'll level up and be able to increase attributes and pick a perk that grants a unique bonus.\n\nBeyond the 12th character level, avatars gain a perk every two levels, and normal characters gain a perk every four levels."
        es = "Los personajes ganan experiencia a medida que ellos o sus aliados matan enemigos en batallas. Si un personaje ha acumulado suficiente experiencia, subirá de nivel y podrá aumentar atributos y elegir una ventaja que otorga una bonificación única.\n\nPasado el nivel 12, los avatares obtienen una ventaja cada dos niveles y los personajes normales, una cada cuatro niveles."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        // corrige base: "perks" es «ventajas», no «habilidades pasivas o activas», y "perk points" es «puntos de ventaja», no «puntos de habilidad».
        en = "The character's level measures experience in battle. Characters rise in levels as they gain experience and are able to increase their attributes and gain perks that make them better at the mercenary profession.\n\nBeyond the 12th character level, avatars gain a perk every two levels, and normal characters gain a perk every four levels."
        es = "El nivel del personaje mide la experiencia en batalla. Los personajes suben de nivel a medida que ganan experiencia y pueden aumentar sus atributos y obtener ventajas que los hacen mejores en la profesión de mercenario.\n\nPasado el nivel 12, los avatares obtienen una ventaja cada dos niveles y los personajes normales, una cada cuatro niveles."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.result.text
    {
        // corrige base: "perk" es «ventaja», no «habilidad» («habilidad» es "skill").
        en = "This character has leveled up. Increase their attributes and select a perk!"
        es = "Este personaje ha subido de nivel. ¡Aumenta sus atributos y selecciona una ventaja!"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.title
    {
        en = "Reserves/Fighting Status"
        es = "Reserva o línea de batalla"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "This character is currently in the fighting line. Click to toggle character into reserves status. (Hotkey 'S', 'A' and 'D' to cycle bros)"
        es = "Este personaje está en la línea de batalla. Haz clic para pasarlo a la reserva. (Teclas 'S', 'A' y 'D' para pasar de un hermano a otro)"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "This character is currently in reserves. Click to toggle character into the fighting line. While in reserves, character will eat and drink more supplies, and only participate in combat if company is under attack. (Hotkey 'S', 'A' and 'D' to cycle bros)"
        es = "Este personaje está en la reserva. Haz clic para pasarlo a la línea de batalla. Mientras esté en la reserva, el personaje consumirá más provisiones y solo participará en combate si atacan a la compañía. (Teclas 'S', 'A' y 'D' para pasar de un hermano a otro)"
    }
