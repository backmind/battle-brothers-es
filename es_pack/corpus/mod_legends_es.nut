        en = "An Alchemist is knowledgeable in crafting all kinds of mysterious contraptions and concoctions from exotic ingredients when given access to taxidermist equipment, and uses less material to do so."
        es = "Un Alquimista sabe fabricar todo tipo de artilugios y brebajes misteriosos con ingredientes exóticos si tiene acceso al equipo de un taxidermista, y gasta menos material al hacerlo."
    }
    // en = "Has a 25% chance of not consuming any crafting component used by you"
