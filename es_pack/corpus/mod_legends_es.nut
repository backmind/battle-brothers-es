        en = "The Horde's hoard"
        es = ""
    }
    // context: ::Const.FactionArchetypes.extend().Description
    {
        en = "The house of %noblehousename% subtly manipulates events for the greater good. From their home in %factionfortressname%, they strategise to bring wellbeing to the common man. In a brutal world they are a faint glimmer of a better world."
        es = ""
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Plan for the future"
