        es = "[color=%positive%]+3[/color] de Resolución"
    }
    // context: legend_armor_chain_and_mail_upgrade.updateTooltip._tooltip.push().text
    {
        en = "Doubles enemy desire to attack you in battle"
        es = "Duplica el deseo de los enemigos de atacarte en combate"
