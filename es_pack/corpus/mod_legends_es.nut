        en = "This character is keen to guard the horde of gold the company has accumulated — and intends to protect it with their life."
        es = "Este personaje está ansioso por custodiar el montón de oro que ha acumulado la compañía, y piensa protegerlo con su vida."
    }
    // context: perk_legend_barter_greed.getTooltip.text
