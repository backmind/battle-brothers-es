    // en = "The arena offers an opportunity to earn gold and fame in fights that are to the death, and in front of crowds that cheer for the most gruesome manner in which lives are dispatched."
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.push().text
    {
        // text = "There are " + ttinfo[0] + " / " + ttinfo[1] + " fights available today."
        mode = "pattern"
        en = "There are <cur:int> / <max:int> fights available today."
        es = "Hay <cur> / <max> combates disponibles hoy."
    }
    // en = "No more matches take place here today. Come back tomorrow!"
    // en base_es
    // en = "You cannot fight in the arena while contracted to do other work"
    // en base_es
    // en = "You need at least 5 empty inventory slots to fight in the ongoing tournament"
    // en base_es
    // en = "You need at least 3 empty inventory slots to fight in the arena"
    // en base_es
    // en = "Harbor"
    // en base_es
    // en = "A harbor that serves both foreign trading ships and local fishermen. You'll likely be able to book passage by sea to other parts of the continent here."
    // en base_es
    // en = "You cannot use the harbor while contracted to escort a caravan"
    // en base_es
    // en = "Marketplace"
    // en base_es
    // en = "A lively market offering all sorts of goods common in the region. New wares will be on offer every few days, and when trading caravans reach this settlement."
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Stables"
        es = "Establos"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "A sturdy and spacious wooden building that will sell you donkeys and seems to care for horses for the local nobility."
        es = "Un edificio de madera robusto y espacioso donde te venden burros y que parece encargarse de los caballos de la nobleza local."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Black Market"
        es = "Mercado negro"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "A shady setup populated with shadier individuals - deals for luxuries, 'loaned' items and curiosities can be made here, for a price."
        es = "Un sitio turbio frecuentado por individuos aún más turbios: aquí se pueden cerrar tratos por lujos, objetos 'prestados' y curiosidades, a cambio de un precio."
    }
    // en = "Weaponsmith"
    // en base_es
    // en = "A weapon smith's workshop displaying all kinds of well crafted weapons. Damaged equipment can also be repaired here for a price."
    // en base_es
    // en = "Armorer"
    // en base_es
    // en = "This armorer's workshop is the right place to look for well-made and durable protection. Damaged equipment can also be repaired here for a price."
    // en base_es
    // en = "Leave this screen and return to the previous one."
    // en base_es
    // en = "Hire Recruit"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Hire the selected recruit and have them join your roster."
        es = "Contrata a la persona seleccionada y haz que se una a tu lista."
    }
    // en = "Try Out Recruit"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Give the selected recruit a proper tryout to reveal their hidden character traits, if any."
        es = "Somete a la persona seleccionada a una prueba adecuada para revelar sus rasgos ocultos, si los hay."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Dismiss Recruit"
        es = "Descartar recluta"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Selected recruit doesn't make the cut, give'em the boot."
        es = "La persona seleccionada no da la talla: dale la patada."
    }
    // en = "Unknown Character Traits"
    // en base_es
    // en = "This character may have unknown traits. You can pay for a tryout to reveal these."
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
