    // FILE: scripts\crafting\legend_rune.nut
    // context: legend_rune.getRuneSigilTooltip
    {
        en = "This item is inscribed with a rune sigil, even though it shouldn't have been: please report this bug."
        es = ""
    }
    // FILE: scripts\crafting\legend_warlock_blueprint.nut
    // context: legend_warlock_blueprint.getTooltipForSkill.text
    {
        en = "Background: Necromancer"
        es = ""
