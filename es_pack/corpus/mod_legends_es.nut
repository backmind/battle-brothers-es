    // en = "<actor:str> gains <v:val_tag> Melee Defense"
    // en base_es
    // en = "<student:str> suffers light wounds"
    // en base_es
    // en = "<bro:str> suffers <injury:str>"
    // en base_es
    // context: legend_barbarian_vs_shieldmaiden.create.m.Screens.push().start.Text
    {
        // this.Text = this.Text + " %barbarian% rushes at %shieldmaiden% who tries to react by blocking the blow with her shield but the Barbarian easily circumvents her defence and knocks her to the ground, before stopping a strike an inch from her head.%SPEECH_ON%See I told you! Best defence is a good offence%SPEECH_OFF%";
        mode = "pattern"
        en = "<text:str> %barbarian% rushes at %shieldmaiden% who tries to react by blocking the blow with her shield but the Barbarian easily circumvents her defence and knocks her to the ground, before stopping a strike an inch from her head.%SPEECH_ON%See I told you! Best defence is a good offence%SPEECH_OFF%"
        es = "<text> %barbarian% carga contra %shieldmaiden%, que intenta reaccionar bloqueando el golpe con el escudo, pero %barbarian% sortea su defensa con facilidad y la derriba, deteniendo un golpe a un dedo de su cabeza.%SPEECH_ON%¡Ves, te lo dije! La mejor defensa es un buen ataque%SPEECH_OFF%"
    }
    // context: legend_barbarian_vs_shieldmaiden.create.m.Screens.push().start._event.m.Shieldmaiden.worsenMood()
    // en = "Overpowered by <_event.m.Barbarian.getName()>"  // cubierto por el patrón "Overpowered by <name:str>"
    // en = "<actor:str> gains <v:val_tag> Melee Skill"
    // en base_es
    // en = "<student:str> suffers light wounds"
    // en base_es
    // en = "<bro:str> suffers <injury:str>"
    // en base_es
    // FILE: scripts\events\events\legends\legend_blacksmith_craft_armor.nut
    // context: legend_blacksmith_craft_armor.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_01.png[/img]While walking around the town shopping you notice %blacksmith% looks like he has his mind on something else.%SPEECH_ON%What's the matter %blacksmith%?%SPEECH_OFF%%SPEECH_ON%Sir I don't know how to say this but you see we have this tradition in a craft smith community where we compete in the art of craft to prove who is worthy of a name \"King of Craftsmen\" and are proud to hold that title!%SPEECH_OFF% Is he talking about that legendary contest where smiths from all over the world gather and they craft the best items that are worthy to withstand blows of a behemoth?%SPEECH_ON%What is it that you need from me?%SPEECH_OFF%%SPEECH_ON% I need 10,000 to enter the contest to buy the metal and other supplies.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_01.png[/img]Mientras recorres el pueblo de compras, notas que %blacksmith% parece tener la cabeza en otra parte.%SPEECH_ON%¿Qué pasa, %blacksmith%?%SPEECH_OFF%%SPEECH_ON%Señor, no sé cómo decir esto, pero mira: en la comunidad de los herreros tenemos la tradición de competir en el arte del oficio para demostrar quién es digno del título de \"Rey de los Artesanos\", ¡y nos enorgullece ostentarlo!%SPEECH_OFF% ¿Estará hablando de ese legendario concurso en el que herreros de todo el mundo se reúnen y forjan las mejores piezas, dignas de resistir los golpes de un behemot?%SPEECH_ON%¿Qué es lo que necesitas de mí?%SPEECH_OFF%%SPEECH_ON% Necesito 10.000 para inscribirme en el concurso y comprar el metal y demás suministros.%SPEECH_OFF%"
    }
    // context: legend_blacksmith_craft_armor.create.m.Screens.push().Options.Text
    {
        en = "Here it is"
        es = "Aquí tienes"
    }
    // context: legend_blacksmith_craft_armor.create.m.Screens.push().Options.Text
    {
        en = "We can't spare money on this"
        es = "No podemos gastar dinero en esto"
    }
    // context: legend_blacksmith_craft_armor.create.m.Screens.push().start.Options.push().Text
    {
        en = "Use the Iron we have in stash instead"
        es = "Usa mejor el hierro que tenemos en el almacén"
    }
    // context: legend_blacksmith_craft_armor.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_31.png[/img]You give him the money and %blacksmith% in no time gets up and sets off to seek the best metal and begin working. As he finishes his work, he tells a story of a blacksmith who was called by a king. The king had summoned all of the guild masters. Calling them to the throne one at a time, he questioned each, then sent them to the opposite side of the hall from those who had not yet been questioned. The first craftsman that he spoke with was a carpenter. The king asked what he made. %SPEECH_ON% I make all things of wood. Houses, wagons, wheels, looms and so on. %SPEECH_OFF% The king asked where he got his tools, and the carpenter answered that he got them from the blacksmith. The second craftsman was a weaver. The king asked the weaver where he got his tools, the weaver said that he got them from the blacksmith. The third craftsman was a potter. When the king questioned him, he admitted that he too got his tools from the blacksmith. Finally, the king called the %blacksmith% to the throne. When he asked the blacksmith where he got His tools, the %blacksmith% answered %SPEECH_ON%I made them myself, for no one else could make tools for the working of iron.%SPEECH_OFF% The king announced that he had made his decision. Since the blacksmith was the only craftsman who did not have to obtain his tools from someone else but made them for himself, that henceforth and forever more, the Blacksmith would be known as the King of Craftsmen"
        es = "[img]gfx/ui/events/event_31.png[/img]Le das el dinero y %blacksmith% se pone en marcha en un abrir y cerrar de ojos para buscar el mejor metal y empezar a trabajar. Al terminar su trabajo, cuenta la historia de un herrero al que mandó llamar un rey. El rey había convocado a todos los maestros de los gremios. Los llamaba al trono de uno en uno, interrogaba a cada uno y luego lo enviaba al otro lado de la sala, lejos de los que aún no habían sido interrogados. El primer artesano con el que habló fue un carpintero. El rey le preguntó qué hacía. %SPEECH_ON% Hago toda clase de cosas de madera. Casas, carros, ruedas, telares y demás. %SPEECH_OFF% El rey le preguntó de dónde sacaba sus herramientas, y el carpintero respondió que se las daba el herrero. El segundo artesano fue un tejedor. El rey le preguntó de dónde sacaba sus herramientas, y el tejedor dijo que se las daba el herrero. El tercer artesano fue un alfarero. Cuando el rey lo interrogó, admitió que también él sacaba sus herramientas del herrero. Por último, el rey llamó a %blacksmith% al trono. Cuando le preguntó de dónde sacaba sus herramientas, %blacksmith% respondió %SPEECH_ON%Me las hice yo, porque nadie más podría hacer herramientas para trabajar el hierro.%SPEECH_OFF% El rey anunció que había tomado su decisión. Como la herrería era el único oficio que no tenía que conseguir sus herramientas de otro, sino que las fabricaba para sí, desde ese día y para siempre el Herrero sería conocido como el Rey de los Artesanos"
    }
    // en = "You spend <v:str_tag> Crowns"
    // en base_es
    // context: legend_blacksmith_craft_armor.create.m.Screens.push().start.item.m.Upgrades[this.Const.Items.ArmorUpgrades.Plate].m.Name
    {
        // item.m.Upgrades[this.Const.Items.ArmorUpgrades.Plate].m.Name = _event.m.Blacksmith.getNameOnly() + "\'s Golden Lamellar Armor";
        mode = "pattern"
        en = "<name:str>'s Golden Lamellar Armor"
        es = "Armadura de laminar dorado de <name>"
    }
    // context: legend_blacksmith_craft_armor.create.m.Screens.push().start.List.push().::Legends.EventList.changeMood()
    {
        // corrige base: «Creo» debe ser «Creó» (pretérito, falta la tilde).
        en = "Created a masterwork Armor"
        es = "Creó una armadura maestra"
    }
    // context: legend_blacksmith_craft_armor.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_31.png[/img]You give him the money and %blacksmith% in no time gets up and sets off to seek the best metal and begin working. As he finishes, he wipes the soot from his brown and sits down, defeated. You look at the freshly forged armor - a sturdy and functional suit, yet lacking the masterwork sheen"
        es = "[img]gfx/ui/events/event_31.png[/img]Le das el dinero y %blacksmith% se pone en marcha en un abrir y cerrar de ojos para buscar el mejor metal y empezar a trabajar. Al terminar, se limpia el hollín de la frente y se sienta con aire de derrota. Miras la armadura recién forjada: un conjunto sólido y funcional, pero sin el brillo de una obra maestra"
    }
    // context: legend_blacksmith_craft_armor.create.m.Screens.push().Options.Text
    {
        en = "Failure..."
        es = "Fracaso..."
    }
    // context: legend_blacksmith_craft_armor.create.m.Screens.push().start.item.m.Name
    {
        // item.m.Name = _event.m.Blacksmith.getNameOnly() + "\'s Failed Masterpiece";
        mode = "pattern"
        en = "<name:str>'s Failed Masterpiece"
        es = "Obra maestra fallida de <name>"
    }
    // en = "You spend <v:str_tag> Crowns"
    // en base_es
    // FILE: scripts\events\events\legends\legend_blacksmith_crafts_crusadersword.nut
    // context: legend_blacksmith_crafts_crusadersword.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]%blacksmith% thumbs their tools in an idle manner, they pick up the iron ingots in the company stash and weigh them with their eyes. You can already tell that there is much more at work here than it seems, at it is only when %Blacksmith% notices you standing there that they put their plan into motion. %SPEECH_ON%I've been ponderin' this for some time capt'n, I see you lot running around in yer' fancy cloaks killin' all them strange folk comin' from the ground and it got me thinkin'. Me da' used to serve the order way back when — he showed me 'is sword a few times and I think, with your 'elp I could make it work. All I need is your eyes and this 'ere iron.%SPEECH_OFF% You make sustained eye contact with %Blacksmith% %SPEECH_ON%Okay, maybe a few crowns as well.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_05.png[/img]%blacksmith% manosea sus herramientas distraídamente, toma los lingotes de hierro del almacén de la compañía y los sopesa con la mirada. Ya te das cuenta de que aquí se trama más de lo que parece, y solo cuando %Blacksmith% advierte tu presencia pone su plan en marcha. %SPEECH_ON%Llevo un tiempo dándole vueltas a esto, capi. Los veo a ustedes corriendo por ahí con sus capas elegantes, matando a toda esa gente rara que sale de la tierra, y me puse a pensar. Mi viejo sirvió a la orden hace muchísimo; me enseñó su espada unas cuantas veces y creo que, con tu ayuda, podría hacerla funcionar. Solo necesito tus ojos y este hierro de aquí.%SPEECH_OFF% Le sostienes la mirada a %Blacksmith% sin pestañear %SPEECH_ON%Bueno, puede que también unas cuantas coronas.%SPEECH_OFF%"
    }
    // context: legend_blacksmith_crafts_crusadersword.create.m.Screens.push().Options.Text
    {
        en = "You can have 2000 crowns, I'll tell you what to do — just swing."
        es = "Te doy 2000 coronas y yo te digo qué hacer: tú solo golpea."
    }
    // en = "We don't have time for this."
    // en base_es
    // context: legend_blacksmith_crafts_crusadersword.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]{The blacksmith hammers the metal with the accuracy of a loom — twisting the metal this way and that while you point and mutter from behind. The hammering is ceaseless until the blade is committed back to the forge, at which point %Blacksmith% takes the lul to get up, stretch and talk with the others.\n\n A few more turns on the anvil and a successful quench later, %Blacksmith% fits and finishes the blade, proud of the masterpiece that has been lost for generations.}"
        es = "[img]gfx/ui/events/event_05.png[/img]{%Blacksmith% martillea el metal con la precisión de un telar: lo retuerce de un lado a otro mientras tú señalas y murmuras por detrás. Los martillazos no cesan hasta que la hoja vuelve a la fragua, momento en que %Blacksmith% aprovecha la pausa para levantarse, estirarse y charlar con los demás.\n\n Unas cuantas vueltas más en el yunque y un templado logrado después, %Blacksmith% monta y remata la hoja, con el orgullo de quien recupera una obra maestra perdida durante generaciones.}"
    }
    // context: legend_blacksmith_crafts_crusadersword.create.m.Screens.push().Options.Text
    {
        en = "It will kill."
        es = "Matará."
    }
    // en = "You spend <v:str_tag> Crowns"
    // en base_es
    // context: legend_blacksmith_crafts_crusadersword.create.m.Screens.push().start.List.push().::Legends.EventList.changeMood()
    {
        en = "Created a legendary sword"
        es = "Creó una espada legendaria"
    }
    // context: legend_blacksmith_crafts_crusadersword.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]You tell the Blacksmith that that sword is better off lost. They begin to object, but eventually fall silent."
        es = "[img]gfx/ui/events/event_05.png[/img]Le dices que más vale que esa espada siga perdida. Empieza a protestar, pero al final guarda silencio."
    }
    // context: legend_blacksmith_crafts_crusadersword.create.m.Screens.push().Options.Text
    {
        en = "The past doesn't matter anymore."
        es = "El pasado ya no importa."
    }
    // en = "Was denied a request"
    // en base_es
    // FILE: scripts\events\events\legends\legend_blacksmith_fix_equipment.nut
    // context: legend_blacksmith_fix_equipment.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_82.png[/img]While setting up for a camp %blacksmith% takes you aside, the staunch musclebound man looking unusually concerned.%SPEECH_ON%Sir, this equipment of ours is in really bad shape! It's a disgrace to be seen fighting in this. It is high time we bring it back to working condition!%SPEECH_OFF% The brute of a man rolls up his sleeves and swings around his hammer, seemingly eager to spend a whole night working his anvil."
        es = "[img]gfx/ui/events/event_82.png[/img]Mientras montan el campamento, %blacksmith% te lleva aparte, con una preocupación poco habitual en alguien tan robusto y musculoso.%SPEECH_ON%Señor, ¡este equipo nuestro está en muy mal estado! Es una vergüenza que nos vean luchar con esto. ¡Ya es hora de devolverlo a condiciones de uso!%SPEECH_OFF% Se remanga, hace girar el martillo con sus brazos de bestia y parece estar deseando pasarse la noche entera trabajando en el yunque."
    }
    // context: legend_blacksmith_fix_equipment.create.m.Screens.push().Options.Text
    {
        en = "Do what you think is best..."
        es = "Haz lo que creas mejor..."
    }
    // context: legend_blacksmith_fix_equipment.create.m.Screens.push().Options.Text
    {
        en = "I need you fighting fit, sleep instead!."
        es = "¡Te necesito en forma para luchar, mejor duerme!"
    }
    // context: legend_blacksmith_fix_equipment.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_82.png[/img]{%blacksmith% spends a whole night in his workshop working his anvil. He pulls steel together and works his magic on his own, mending the weapons back into excellent condition. After the work is done he walks out, wiping a huge torrent of sweat from his brow. %SPEECH_ON%It is done, as best as I can do in these conditions.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_82.png[/img]{%blacksmith% se pasa la noche entera en su taller trabajando en el yunque. Junta el acero y obra su magia sin ayuda de nadie, devolviendo las armas a un estado excelente. Cuando termina, sale enjugándose un torrente de sudor de la frente. %SPEECH_ON%Ya está, lo mejor que he podido en estas condiciones.%SPEECH_OFF%}"
    }
    // en = "Nice work!"
    // en base_es
    // context: legend_blacksmith_fix_equipment.create.m.Screens.push().start.List.push().::Legends.EventList.changeMood()
    {
        en = "Stayed up all night working"
        es = "Pasó toda la noche trabajando"
    }
    // context: legend_blacksmith_fix_equipment.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_13.png[/img]{While you leave %blacksmith% to start working on the equipment, you hear a crack and a loud scream. You rush to the smithy to see what happen only to find the blacksmith bleeding from a fresh impact wound. It seems too long off the tools has left him rusty. }"
        es = "[img]gfx/ui/events/event_13.png[/img]{Mientras dejas que %blacksmith% empiece a trabajar en el equipo, oyes un crujido y un fuerte grito. Corres a la herrería a ver qué ha pasado y encuentras a %blacksmith% sangrando por una herida de impacto reciente. Parece que pasar demasiado tiempo sin tocar las herramientas le ha hecho perder la mano. }"
    }
    // context: legend_blacksmith_fix_equipment.create.m.Screens.push().Options.Text
    {
        en = "Get him Patched up!"
        es = "¡Que le venden esa herida!"
    }
    // context: legend_blacksmith_fix_equipment.create.m.Screens.push().start.List.push().::Legends.EventList.changeMood()
    {
        en = "Accidentally injured himself"
        es = "Se hirió por accidente"
    }
    // en = "<bro:str> suffers <injury:str>"
    // en base_es
    // en = "<student:str> suffers light wounds"
    // en base_es
    // FILE: scripts\events\events\legends\legend_blacksmith_reforges_orc_cleaver_event.nut
    // context: legend_blacksmith_reforges_orc_cleaver_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]While at a short rest, %blacksmith% is ideally amusing %themselves_blacksmith% by digging through the company stash — reorganising various items to be in better order. Eventually %they_blacksmith% come across a worn orc cleaver that has seen better days. %blacksmith% notices you and brings the weapon to your attention. %SPEECH_ON%If I were two foot taller and about half as smart I'd say this is almost a decent weapon.%SPEECH_OFF% The blacksmith carefully turns the blade in %their_blacksmith% hands, inspecting every angle as an artist would a painting. %SPEECH_ON%There's a warp running along the blade and the spine 'as a crack in it, you've got a really bad amount of edge damage around the tip here as well. On top of that — it is far too heavy to swing and I can barely hold it in one hand. If I swung this thing too hard I'd likely go with it...%SPEECH_OFF% %blacksmith% scratches %their_blacksmith% chin and gently puts the blade back in the cart. %SPEECH_ON%I don't know what its made of, but I can have a try at just reforging the whole thing if you give me a thousand crowns to cover my materials and I can start right now — but the blade may already be too far gone...%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_05.png[/img]Durante un breve descanso, %blacksmith% se entretiene hurgando en el almacén de la compañía: reorganiza varios objetos para tenerlos mejor ordenados. Al final da con una cuchilla orca desgastada que ha conocido tiempos mejores. %blacksmith% repara en ti y te enseña el arma. %SPEECH_ON%Si midiera dos pies más y fuera la mitad de list%o_blacksmith%, diría que esto es casi un arma decente.%SPEECH_OFF% %Art_blacksmith% herrer%o_blacksmith% gira la hoja con cuidado entre las manos, examinando cada ángulo como un artista examinaría un cuadro. %SPEECH_ON%Tiene una torcedura a lo largo de la hoja y el lomo está rajado, y aquí, cerca de la punta, el filo está muy mellado. Encima, pesa demasiado para blandirla y apenas puedo sostenerla con una mano. Si la blandiera con demasiada fuerza, seguramente saldría volando con ella...%SPEECH_OFF% %blacksmith% se rasca la barbilla y vuelve a dejar con cuidado la hoja en el carro. %SPEECH_ON%No sé de qué está hecha, pero puedo intentar reforjarla entera si me das mil coronas para cubrir los materiales, y puedo empezar ahora mismo, aunque puede que la hoja ya no tenga remedio...%SPEECH_OFF%"
    }
    // context: legend_blacksmith_reforges_orc_cleaver_event.create.m.Screens.push().Options.Text
    {
        en = "It is worth the risk."
        es = "Vale la pena arriesgarse."
    }
    // context: legend_blacksmith_reforges_orc_cleaver_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]%blacksmith% warms up the blade and hammers on it for some time — quickly twisting it this way and that as the blade cycles between hot and cold. %They_blacksmith% fights with the crude weapon until it begins to take a more sleek and finer form, losing some of the bloated mass of metal from both sides.\n %They_blacksmith% takes it to the grindstone and slowly resharpen all the edges from haft to tip, lastly dressing the handle in something more comfortable for human hands.\n\n While not an artistic masterpiece, you can't deny that improvements have been made to the performance of the weapon overall."
        es = "[img]gfx/ui/events/event_05.png[/img]%blacksmith% calienta la hoja y la martillea durante un buen rato: la retuerce rápidamente de un lado a otro mientras pasa del calor al frío. Lucha con el arma tosca hasta que empieza a adoptar una forma más esbelta y fina, y pierde parte de la hinchada masa de metal por ambos lados.\n Luego la lleva a la piedra de afilar y vuelve a afilar despacio todos los filos, del mango a la punta, y por último forra la empuñadura con algo más cómodo para manos humanas.\n\n Aunque no es una obra maestra del arte, no puedes negar que el rendimiento del arma ha mejorado en general."
    }
    // context: legend_blacksmith_reforges_orc_cleaver_event.create.m.Screens.push().Options.Text
    {
        en = "Much better!"
        es = "¡Mucho mejor!"
    }
    // en = "You spend <v:str_tag> Crowns"
    // en base_es
    // en = "You lose <item:str>"
    // en base_es
    // en = "You gain <item:str>"
    // en base_es
    // context: legend_blacksmith_reforges_orc_cleaver_event.create.m.Screens.push().start.List.push().::Legends.EventList.changeMood()
    {
        en = "Reforged a primitive weapon"
        es = "Reforjó un arma primitiva"
    }
    // context: legend_blacksmith_reforges_orc_cleaver_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]%blacksmith% warms up the blade and hammers on it for some time — quickly twisting it this way and that as the blade cycles between hot and cold. %They_blacksmith% fight with the crude weapon until it begins to take a more sleek and finer form, %blacksmith% begins to curse under %their_blacksmith% breath as %they_blacksmith% puts the weapon back into %their_blacksmith% forge to reheat it. This happens again several times more as %they_blacksmith% fights with the metal more and more.\n\n After the fourth attempt, the blade eventually cracks and snaps in two under the weight of %their_blacksmith% hammer. %blacksmith% gracefully accepts this by whispering insults at the blade before tossing it into the undergrowth with an almighty force."
        es = "[img]gfx/ui/events/event_05.png[/img]%blacksmith% calienta la hoja y la martillea durante un buen rato: la retuerce rápidamente de un lado a otro mientras pasa del calor al frío. Lucha con el arma tosca hasta que empieza a adoptar una forma más esbelta y fina, pero entonces %blacksmith% empieza a maldecir entre dientes mientras vuelve a meter el arma en la fragua para recalentarla. Esto se repite varias veces más, y la lucha con el metal es cada vez más dura.\n\n Al cuarto intento, la hoja acaba agrietándose y partiéndose en dos bajo el peso de su martillo. %blacksmith% lo acepta con elegancia, susurrándole insultos a la hoja antes de arrojarla a la maleza con una fuerza descomunal."
    }
    // context: legend_blacksmith_reforges_orc_cleaver_event.create.m.Screens.push().Options.Text
    {
        en = "Shame."
        es = "Lástima."
    }
    // context: legend_blacksmith_reforges_orc_cleaver_event.create.m.Screens.push().start.List.push().::Legends.EventList.changeMood()
    {
        en = "Failed to reforge a weapon"
        es = "No logró reforjar un arma"
    }
    // FILE: scripts\events\events\legends\legend_butcher_vs_donkey.nut
    // context: legend_butcher_vs_donkey.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_06.png[/img]You come around the tents to find %butcher% looming around %donkey%, the donkey is busy grazing and pays no heed to the human nearby. %butcher% seems to have not noticed you and begins edging towards %donkey%. From your vantage point you can make out a large blade hidden begind the butcher's back, and you hear a muttering. %SPEECH_ON%That's right, nothing to see here. Keep feeding those juicy little rump cuts and ribs. You may have plenty of food, but the rest of us could use a roast!%SPEECH_OFF% As the butcher leans closer, the donkey notices something awry and kicks out towards the butcher before running off to safety behind you."
        es = "[img]gfx/ui/events/event_06.png[/img]Rodeas las tiendas y encuentras a %butcher% rondando a %donkey%; el burro está ocupado pastando y no presta atención al humano que tiene cerca. %butcher% no parece haberte visto y empieza a acercarse poco a poco a %donkey%. Desde donde estás distingues una gran hoja escondida a la espalda de %butcher%, y oyes un murmullo. %SPEECH_ON%Eso es, aquí no hay nada que ver. Tú sigue engordando esos jugosos cuartos traseros y esas costillitas. Tú tendrás comida de sobra, ¡pero al resto nos vendría bien un asado!%SPEECH_OFF% Cuando %butcher% se inclina más cerca, el burro nota que algo raro pasa, le suelta una coz y sale corriendo a ponerse a salvo detrás de ti."
    }
    // en = "I need to get the men something to eat."
    // en base_es
    // en = "<bro:str> suffers <injury:str>"
    // en base_es
    // en = "<student:str> suffers light wounds"
    // en base_es
    // context: legend_butcher_vs_donkey.create.m.Screens.push().start.List.push().::Legends.EventList.changeMood()
    {
        // this.List.push(::Legends.EventList.changeMood(_event.m.Butcher, -0.5, "Kicked by the " + _event.m.Donkey.getName()));
        mode = "pattern"
        en = "Kicked by the <name:str>"
        es = "Recibió una coz de <name>"
    }
    // context: legend_butcher_vs_donkey.create.m.Screens.push().start.List.push().::Legends.EventList.changeMood()
    {
        en = "Frighten for his death"
        es = "Temió por su vida"
    }
    // context: legend_butcher_vs_donkey.onPrepareVariables._vars.push()
    // en = "donkey"  // clave de variable de onPrepareVariables, no se muestra
    // FILE: scripts\events\events\legends\legend_cabal_puppet_event.nut
    // context: legend_cabal_puppet_event.create.m.Title
    {
        en = "Jumping the fence"
        es = "Saltar la cerca"
    }
    // context: legend_cabal_puppet_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_29.png[/img]As you walk along the road, {you can't help but notice a shifting figure moving out of the corner of your eye. | a small shape darting in and out of your vision. | a lumbering mass traipsing through the field.} On closer inspection it seems a member of the undead has lost their way - just as a sheep jumps the paddock and wanderers aimlessly before being stolen or killed.\n\n It is hard to say where this one came from, perhaps a {nearby battlefield | mass grave | far off place | raided farmstead | shallow ditch | shallow grave}. Either way, they would make a good addition to %companyname% to bolster your horde."
        es = "[img]gfx/ui/events/event_29.png[/img]Mientras avanzas por el camino, {no puedes evitar fijarte en una figura que se mueve por el rabillo del ojo. | ves una pequeña silueta que entra y sale de tu campo de visión. | divisas una masa pesada que avanza a trompicones por el campo.} Al mirar más de cerca, parece que un no muerto se ha extraviado, igual que una oveja que salta el cercado y vaga sin rumbo hasta que la roban o la matan.\n\n Es difícil saber de dónde ha salido, quizá de {un campo de batalla cercano | una fosa común | algún lugar lejano | una granja saqueada | una zanja poco profunda | una tumba poco profunda}. Sea como sea, sería una buena incorporación para %companyname% y reforzaría tu horda."
    }
    // context: legend_cabal_puppet_event.create.m.Screens.push().Options.Text
    {
        en = "I shall call you... %joiner%!"
        es = "Te llamaré... ¡%joiner%!"
    }
    // context: legend_cabal_puppet_event.create.m.Screens.push().Options.Text
    {
        en = "Leave it to wander."
        es = "Que siga vagando."
    }
    // en = "joiner"
    // FILE: scripts\events\events\legends\legend_cannibal_corrupts_butcher.nut
    // context: legend_cannibal_corrupts_butcher.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_cannibal_corrupts_butcher.png[/img]As it turns out, a butcher of men and a butcher of animals aren't that different. Since %cannibal% and %butcher% have been acquainted, the two have become fast friends. Perhaps too friendly even... \n You're interrupted in your ruminating by %butcher% %themselves_butcher%.%SPEECH_ON% Dinner's ready, Captain. Got a new recipe.%SPEECH_OFF% Handing you a bowl, the butcher strides off towards %cannibal%. You feel a sudden lack of appetite."
        es = "[img]gfx/ui/events/legend_cannibal_corrupts_butcher.png[/img]Resulta que un carnicero de hombres y un carnicero de animales no son tan distintos. Desde que %cannibal% y %butcher% se conocen, han hecho muy buenas migas. Quizá demasiado, incluso... \n %butcher% en persona interrumpe tus cavilaciones.%SPEECH_ON% La cena está lista, capitán. Tengo una receta nueva.%SPEECH_OFF% Tras darte un cuenco, %art_butcher% carnicer%o_butcher% se aleja hacia %cannibal%. De repente se te quita el apetito."
    }
    // context: legend_cannibal_corrupts_butcher.create.m.Screens.push().Options.Text
    {
        en = "Just in case."
        es = "Por si acaso."
    }
    // context: legend_cannibal_corrupts_butcher.create.m.Screens.push().start.::Legends.Traits.grant().List.push().text
    {
        // text = _event.m.Butcher.m.Name + " now enjoys forbidden meat"
        mode = "pattern"
        en = "<name:str> now enjoys forbidden meat"
        es = "<name> ahora disfruta de la carne prohibida"
    }
    // context: legend_cannibal_corrupts_butcher.create.m.Screens.push().start.List.push().::Legends.EventList.changeMood()
    {
        en = "Spread the joys of cannibalism"
        es = "Difundió las alegrías del canibalismo"
    }
    // context: legend_cannibal_corrupts_butcher.create.m.Screens.push().start.List.push().::Legends.EventList.changeMood()
    {
        en = "Started appreciating forbidden meat"
        es = "Empezó a apreciar la carne prohibida"
    }
    // context: legend_cannibal_corrupts_butcher.onPrepareVariables._vars.push()
    // en = "cannibal"  // clave de variable de onPrepareVariables, no se muestra
    // FILE: scripts\events\events\legends\legend_cannibal_eats_part_of_brother.nut
    // context: legend_cannibal_eats_part_of_brother.create.m.Title
    {
        en = "At night..."
        es = "De noche..."
    }
    // context: legend_cannibal_eats_part_of_brother.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_cannibal_eats_part_of_brother.png[/img]%cannibal% eats part of %dinner%."
        es = "[img]gfx/ui/events/legend_cannibal_eats_part_of_brother.png[/img]%cannibal% se come una parte de %dinner%."
    }
    // context: legend_cannibal_eats_part_of_brother.create.m.Screens.push().Options.Text
    {
        en = "Gross!"
        es = "¡Qué asco!"
    }
    // en = "<bro:str> suffers <injury:str>"
    // en base_es
    // context: legend_cannibal_eats_part_of_brother.create.m.Screens.push().start.List.push().::Legends.EventList.changeMood()
    {
        en = "Enjoyed a good meal"
        es = "Disfrutó de una buena comida"
    }
    // context: legend_cannibal_eats_part_of_brother.create.m.Screens.push().start.List.push().::Legends.EventList.changeMood()
    {
        // this.List.push(::Legends.EventList.changeMood(_event.m.Dinner, -4.0, "Got partially eaten by " + _event.m.Cannibal.m.Name));
        mode = "pattern"
        en = "Got partially eaten by <name:str>"
        es = "<name> le comió una parte del cuerpo"
    }
    // context: legend_cannibal_eats_part_of_brother.onPrepareVariables._vars.push()
    // en = "dinner"  // clave de variable de onPrepareVariables, no se muestra
    // FILE: scripts\events\events\legends\legend_cannibal_recruitment.nut
    // context: legend_cannibal_recruitment.create.m.Title
    {
        en = "Strange Times"
        es = "Tiempos extraños"
    }
    // context: legend_cannibal_recruitment.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_cannibal_recruitment.png[/img]You halt and turn your nose skyward, a thread of flavour is drifting on the wind — it is not grain or fruit, but instead something more sickly sweet. Following the trail like a hungry pig leads to a ramshackle camp — inhabited by a lonely figure basked in the light of a campfire.\n\n A vast array of utensils are laid out in the same manner as a torturer places his instruments before beginning their work. The figure shuffles slightly, exchanging a ladle for a spoon.\n A branch crunches and the figure twitches somewhat, but does not rise or jump as you would expect.\n\n Their grisly voice rings out towards your hide. %SPEECH_ON%Ther's enough fer all of yer's %SPEECH_OFF% The figure starts stirring the pot gently with their finger. You emerge into the dim dancing light of the open fire, the smell is stronger now, but there's something else in the air that was not there before.\n\n With a hand on your weapon and approaching slowly, you enter the innermost ring of the fire. The fire no longer dances, instead it mopes and tumbles slowly on the stranger's face — who is still fixated on the stew mere inches from the tip of their rankling nose. They motion for you to sit down, irritated by you towering over them.\n It's best to sit.\n The stranger, now half illuminated by the tired flame, moves from their spot to fix eyes with you. They stare and wait, as if they were mentally dissecting you.\n The thickness of the air starts to become noticeable this close to the ground. You wonder if this is what death feels like. The stranger hangs a crooked grin. %SPEECH_ON%Yer want somethin' 'ta eat?\n\nOr are ya lookin' fer a real artist like merself?%SPEECH_OFF% With a smile the grin becomes uncomfortably wide."
        es = "[img]gfx/ui/events/legend_cannibal_recruitment.png[/img]Te detienes y alzas la nariz al cielo: un hilo de sabor flota en el viento: no es grano ni fruta, sino algo de un dulzor más empalagoso. Seguir el rastro como un cerdo hambriento te lleva a un campamento destartalado, habitado por una figura solitaria bañada por la luz de una hoguera.\n\n Hay un amplio surtido de utensilios dispuestos del mismo modo en que un torturador coloca sus instrumentos antes de ponerse manos a la obra. La figura se remueve un poco y cambia un cucharón por una cuchara.\n Una rama cruje y la figura se crispa ligeramente, pero no se levanta ni da un respingo, como cabría esperar.\n\n Su voz espeluznante resuena hacia tu escondite. %SPEECH_ON%Hay de sobra pa' tos ustedes %SPEECH_OFF% La figura empieza a remover la olla suavemente con el dedo. Sales a la tenue luz danzante de la hoguera; el olor es más fuerte ahora, pero hay algo más en el aire que antes no estaba.\n\n Con la mano en el arma y acercándote despacio, entras en el círculo más cercano al fuego. Las llamas ya no danzan; languidecen y ruedan lentamente sobre el rostro de la figura, que sigue con la vista clavada en el guiso, a apenas unos centímetros de la punta de su nariz enconada. Te indica con un gesto que te sientes; le molesta que te alces sobre su cabeza.\n Mejor sentarse.\n La figura, ahora medio iluminada por la llama cansada, se mueve de su sitio para clavarte la mirada. Te mira fijamente y espera, como si te estuviera diseccionando mentalmente.\n Tan cerca del suelo, lo denso del aire empieza a notarse. Te preguntas si esto es lo que se siente al morir. La figura esboza una sonrisa torcida. %SPEECH_ON%¿Quieres algo pa' comer?\n\n¿O andas buscando un verdadero artista como yo?%SPEECH_OFF% Al sonreír, la mueca se vuelve incómodamente ancha."
    }
    // context: legend_cannibal_recruitment.create.m.Screens.push().Options.Text
    {
        en = "We'd rather not take you in."
        es = "Preferimos no acogerte."
    }
    // FILE: scripts\events\events\legends\legend_civilwar_noble_event.nut
    // context: legend_civilwar_noble_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_35.png[/img]A well outfited man approaches with a self confident swagger in his step. You put a hand to your sword and order him to announce his intentions, all the while keeping your eyes peeled for an ambush. The stranger takes a step forward and you can see his well manicured facial hair.%SPEECH_ON%I am %crusader%, fear not peasant, I am here to help. The noble houses are at war again, and while they bicker and plot the towns are not safe. %SPEECH_OFF%You take your hand off your sword and ask him of the nobles. He nods and speaks.%SPEECH_ON%I am related to most of the houses, I know a thing or two about these feuds. %SPEECH_OFF% The man gestures to your weapons.%SPEECH_ON%Enough to know the safest place is with good blades by your side.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_35.png[/img]Se acerca una figura bien equipada, con un andar lleno de aplomo. Llevas la mano a la espada y le ordenas que declare sus intenciones, sin dejar de vigilar por si hay una emboscada. La figura da un paso adelante y ves su vello facial bien cuidado.%SPEECH_ON%Soy %crusader%. No temas, campesino, estoy aquí para ayudar. Las casas nobles vuelven a estar en guerra, y mientras discuten y conspiran, las ciudades no están a salvo. %SPEECH_OFF%Apartas la mano de la espada y le preguntas por los nobles. Asiente y habla.%SPEECH_ON%Tengo parentesco con la mayoría de las casas; sé un par de cosas de estas disputas. %SPEECH_OFF% Señala tus armas con un gesto.%SPEECH_ON%Lo bastante para saber que el lugar más seguro es junto a buenas espadas.%SPEECH_OFF%"
    }
    // en = "You might as well join us."
    // en base_es
    // en = "No, thanks, we're good."
    // en base_es
    // FILE: scripts\events\events\legends\legend_clothing_merchant_event.nut
    // context: legend_clothing_merchant_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_158.png[/img]{A merchant comes into view, but this one seems to travel alone with various boxes and baggage gently josttling in the back of her cart. The wagon rocks back and fourth along the road like an uneasy animal finding it's feet, while two donkeys — one much more worse for wear than the other, pull the cart along.\n The woman is dressed in a mix of southern and northern silks, leather, mail and other parts that are stitched togeather to make something very memorable.%SPEECH_ON%Crownlings, Mercenaries, yes? You look like one or the other but I'd rather know which i'm talkin' to before I tell you what I have — one has more of an urge for robbery than the other. I'll let you guess which.%SPEECH_OFF%Before you can muster a reply, she stands on the wagon seat — the whole contrapion rocks and wakes gently as the merchant finds her footing.%SPEECH_ON%I carry some of the finest cloths, silks and rare items you might find. As you can tell from what I wear — the best parts are not for sale. However, there is much more that could be yours. Tell me, are you of the gambling sort?%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_158.png[/img]{Aparece una mercader, pero esta parece viajar sola, con varias cajas y bultos traqueteando suavemente en la parte de atrás de su carro. El carromato se bambolea de un lado a otro por el camino como un animal inquieto que busca el equilibrio, mientras dos burros (uno mucho más maltrecho que el otro) tiran del carro.\n La mujer viste una mezcla de sedas sureñas y norteñas, cuero, malla y otras piezas cosidas entre sí que forman algo muy memorable.%SPEECH_ON%Cuentacoronas, mercenarios, ¿sí? Tienen pinta de lo uno o de lo otro, pero prefiero saber con quién hablo antes de contarles lo que tengo: unos tienen más ganas de robar que otros. Les dejo adivinar cuáles.%SPEECH_OFF%Antes de que puedas responder, se pone de pie en el pescante, y todo el artilugio se balancea suavemente mientras la mercader busca el equilibrio.%SPEECH_ON%Llevo algunas de las mejores telas, sedas y rarezas que puedan encontrar. Como ven por lo que llevo puesto, lo mejor no está a la venta. Sin embargo, hay mucho más que podría ser suyo. Dime, ¿eres de los que apuestan?%SPEECH_OFF%}"
    }
    // context: legend_clothing_merchant_event.create.m.Screens.push().Options.Text
    {
        en = "Maybe, what's the stake?"
        es = "Puede, ¿qué hay en juego?"
    }
    // context: legend_clothing_merchant_event.create.m.Screens.push().Options.Text
    {
        en = "Not interested, thanks."
        es = "No me interesa, gracias."
    }
    // context: legend_clothing_merchant_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_60.png[/img]{She grins.%SPEECH_ON%Well, you really have nothing to lose. In the back here I have a fine selection of items that I can give you for a very low price, all you have to do is pay up one-hundred-and-twenty-five crowns and I will pull a random item from a box without looking — whatever the result, you will always get something! %SPEECH_OFF%She scratches her chin, quite pleased with her performance thus far. Down below her the more sickly donkey hacks and coughs as if it were turning inside out.%SPEECH_ON%Don't mind him. He is almost as old as I am now. I found him grazing in a battlefield of all places.%SPEECH_OFF%She shoots the mule a piercing stare, which quickly cows the animal into silence.%SPEECH_ON%So, what will it be?%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_60.png[/img]{Sonríe de oreja a oreja.%SPEECH_ON%Bueno, la verdad es que no tienes nada que perder. Aquí atrás tengo una buena selección de objetos que puedo darte a un precio muy bajo: solo tienes que pagar ciento veinticinco coronas y sacaré un objeto al azar de una caja sin mirar. Salga lo que salga, ¡siempre te llevarás algo! %SPEECH_OFF%Se rasca la barbilla, muy satisfecha con su actuación hasta el momento. Debajo de ella, el burro más enfermizo resopla y tose como si se estuviera dando la vuelta del revés.%SPEECH_ON%No le hagas caso. Ya es casi tan viejo como yo. Lo encontré pastando en un campo de batalla, nada menos.%SPEECH_OFF%Le lanza a la mula una mirada penetrante que hace callar al animal enseguida.%SPEECH_ON%Entonces, ¿qué va a ser?%SPEECH_OFF%}"
    }
    // context: legend_clothing_merchant_event.create.m.Screens.push().Options.Text
    {
        en = "125 crowns? I'll take that gamble."
        es = "¿125 coronas? Acepto la apuesta."
    }
    // context: legend_clothing_merchant_event.create.m.Screens.push().Options.Text
    {
        en = "I'll take the mule instead, lets say for 3000 crowns?"
        es = "Mejor me quedo con la mula, ¿digamos por 3000 coronas?"
    }
    // context: legend_clothing_merchant_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_98.png[/img]{You toss a bag of crowns to the merchant, who carefully counts each one as you count her with your eyes. She smiles down to you and gives you the change. After you make an exchange of coin and goods, she gets back up on her cart and brushes under her chin%SPEECH_ON%Be seeing you, friend.%SPEECH_OFF%The mules begin to lead the cart away, gently swaing along the path until they are out of sight. You have a feeling you may meet again.}"
        es = "[img]gfx/ui/events/event_98.png[/img]{Le lanzas una bolsa de coronas a la mercader, que cuenta cada una con cuidado mientras tú la examinas a ella con la mirada. Te sonríe desde arriba y te da el cambio. Tras intercambiar monedas y mercancía, vuelve a subirse al carro y se roza la barbilla%SPEECH_ON%Nos vemos, amigo.%SPEECH_OFF%Las mulas empiezan a llevarse el carro, meciéndose suavemente por el camino hasta perderse de vista. Tienes la sensación de que volverán a verse.}"
    }
    // context: legend_clothing_merchant_event.create.m.Screens.push().Options.Text
    {
        en = "We've got places to be."
        es = "Tenemos cosas que hacer."
    }
    // en = "You spend <v:str_tag> Crowns"
    // en base_es
    // en = "You spend <v:str_tag> Crowns"
    // en base_es
    // context: legend_clothing_merchant_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_98.png[/img]{The merchant shrugs and gently sits back on the wagon.%SPEECH_ON%You'll be back.%SPEECH_OFF%She encourages the donkeys to move, and the sick donkey protests a little more before moving off.}"
        es = "[img]gfx/ui/events/event_98.png[/img]{La mercader se encoge de hombros y vuelve a sentarse con calma en el carromato.%SPEECH_ON%Volverás.%SPEECH_OFF%Arrea a los burros, y el burro enfermo protesta un poco más antes de echar a andar.}"
    }
    // en = "Maybe next time."
    // en base_es
    // context: legend_clothing_merchant_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_158.png[/img]{You nod and the merchant nods back, continuing on their journey.}"
        es = "[img]gfx/ui/events/event_158.png[/img]{Asientes y la mercader te devuelve el gesto antes de seguir su camino.}"
    }
    // context: legend_clothing_merchant_event.create.m.Screens.push().Options.Text
    {
        en = "I wish I had that much free time..."
        es = "Ojalá yo tuviera tanto tiempo libre..."
    }
    // FILE: scripts\events\events\legends\legend_enter_wizard_tower_event.nut
    // context: legend_enter_wizard_tower_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_125.png[/img]{The tower is the tallest structure you have ever seen. %observer% walks up and halts at the very sight.%SPEECH_ON%By the old gods, is that tower touching the sky? %SPEECH_OFF%You sigh and tell the company to stay here while you and the very observant sellsword go take a look.}"
        es = "[img]gfx/ui/events/event_125.png[/img]{La torre es la estructura más alta que has visto jamás. %observer% se acerca y se detiene en seco al verla.%SPEECH_ON%Por los viejos dioses, ¿esa torre está tocando el cielo?%SPEECH_OFF%Suspiras y le dices a la compañía que se quede aquí mientras vas a echar un vistazo con tu vigía de ojo de lince.}"
    }
    // en = "Let's see what secrets are inside."
    // en base_es
    // en = "It's not worth investigating now."
    // en base_es
    // context: legend_enter_wizard_tower_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_125.png[/img]{As you approach the tower door you hear a voice call out as if far away. Looking up you see a person waving from the tallest room in the tower. They yell and gesture that they will be with you in a moment. Barely an instant later the door opens, and the same person is standing before you in long flowing robes and a floopy hat.  %SPEECH_ON% Ah a visitor, not often we get visitors these days. %SPEECH_OFF%  As he speaks a younger person in the same robes pokes their head throug the door behind him. %SPEECH_ON% You must have a reason for coming all this way. %SPEECH_OFF%  he continues %SPEECH_ON% Perhaps you're here to buy an apprentice? %SPEECH_OFF%  The young apprentice looks shocked and blurts out %SPEECH_ON% Buy? You're not selling me, are you master? %SPEECH_OFF% The old man looks dismissive and rebuffs %SPEECH_ON% Buy? Why I meant Hire! Every apprentice must go out on a workplace trial in the real world to become a journeyman. Yes, yes it's decided then. Now all that is needed is to negotiate the wage %SPEECH_OFF%  The apprentice looks scared and confused but the old man continues. %SPEECH_ON% If you give me 20,000 crowns I will let you keep the kid, but no refunds.%SPEECH_OFF% The apprentice meekly asks %SPEECH_ON%  Shouldn't the wage be a daily stipend to the journeyman doing the work? %SPEECH_OFF%  The old man dimisses the suggestion with a wave %SPEECH_ON% Of course not! This is the fee to cover your training. How else am I meant to buy another apprentice? Hopefully one who complains less. So do we have a deal? Remember, no returns. %SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_125.png[/img]{Al acercarte a la puerta de la torre oyes una voz que llama, como si viniera de muy lejos. Al alzar la vista ves a alguien que saluda con la mano desde la estancia más alta de la torre. Te grita y te hace gestos de que enseguida estará contigo. Apenas un instante después se abre la puerta y la misma persona está ante ti, con una larga túnica ondulante y un sombrero flojo y caído.%SPEECH_ON%Ah, una visita. No solemos recibir visitas últimamente.%SPEECH_OFF%Mientras habla, una persona más joven con la misma túnica asoma la cabeza por la puerta, detrás de él.%SPEECH_ON%Algún motivo tendrás para venir hasta aquí.%SPEECH_OFF%continúa.%SPEECH_ON%¿Quizá vienes a comprar un aprendiz?%SPEECH_OFF%Su joven aprendiz se queda de piedra y suelta:%SPEECH_ON%¿Comprar? No me vas a vender, ¿verdad, maestro?%SPEECH_OFF%El anciano hace un gesto de desdén y replica:%SPEECH_ON%¿Comprar? ¡Quería decir contratar! Todo aprendiz debe salir a hacer unas prácticas en el mundo real para convertirse en oficial. Sí, sí, decidido entonces. Ahora solo falta negociar el salario.%SPEECH_OFF%Su aprendiz tiene cara de miedo y de no entender nada, pero el anciano continúa.%SPEECH_ON%Si me das 20.000 coronas, te dejo quedarte con la criatura, pero no hay reembolsos.%SPEECH_OFF%Su aprendiz pregunta con timidez:%SPEECH_ON%¿El salario no debería ser un estipendio diario para quien hace el trabajo?%SPEECH_OFF%El anciano descarta la idea con un gesto de la mano.%SPEECH_ON%¡Claro que no! Esto es la tarifa que cubre tu formación. ¿Cómo voy a comprar si no otro aprendiz? Uno que se queje menos, a ser posible. Entonces, ¿trato hecho? Recuerda: no se admiten devoluciones.%SPEECH_OFF%}"
    }
    // context: legend_enter_wizard_tower_event.create.m.Screens.push().Options.Text
    {
        en = "Accept the kid."
        es = "Me quedo con la criatura."
    }
    // context: legend_enter_wizard_tower_event.create.m.Screens.push().Options.Text
    {
        en = "We don't buy children"
        es = "No compramos niños"
    }
    // context: legend_enter_wizard_tower_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_125.png[/img]{%observer% suggests maybe you are really rescuing the kid, who cowers as you take them under your arm. }"
        es = "[img]gfx/ui/events/event_125.png[/img]{%observer% sugiere que quizá, en realidad, estás rescatando a la criatura, que se encoge de miedo cuando le pasas el brazo por encima. }"
    }
    // context: legend_enter_wizard_tower_event.create.m.Screens.push().Options.Text
    {
        en = "Is this what a wizard looks like?"
        es = "¿Así es un mago?"
    }
    // context: legend_enter_wizard_tower_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_125.png[/img]{%observer% heads back to the company with the apprentice, who is squinting and looking about as if they haven't been outside the tower in a long time. You wonder if the mercenary life is any better. }"
        es = "[img]gfx/ui/events/event_125.png[/img]{%observer% vuelve con la compañía y con la nueva incorporación, que entorna los ojos y mira a todas partes como si llevara mucho tiempo sin salir de la torre. Te preguntas si la vida de mercenario será mejor. }"
    }
    // context: legend_enter_wizard_tower_event.create.m.Screens.push().Options.Text
    {
        en = "The journeyman begins"
        es = "Comienzan las prácticas"
    }
    // context: legend_enter_wizard_tower_event.create.m.Screens.push().start._event.m.Dude.setTitle()
    {
        en = "the apprentice"
        es = "el aprendiz"
    }
    // context: legend_enter_wizard_tower_event.create.m.Screens.push().start._event.m.Dude.getBackground().m.RawDescription
    {
        en = "%name% was 'hired' by you from an old man in a tall tower"
        es = "«Contrataste» a %name% a un anciano que vivía en una torre altísima"
    }
    // en = "observer"
    // FILE: scripts\events\events\legends\legend_falconflies_event.nut
    // context: legend_falconflies_event.create.m.Screens.push().Text
    {
        en = "%townImage%While in %townname%, you take the time to provision and make ready for the next part of your journey. %falconhandler% starts to wrestle with their birdcage, trying to keep it under control as the angry avian is desperate to get out. %They_falconhandler% mounts %their_falconhandler% bodyweight onto the cage and instead ends up having %their_falconhandler% fingers clipped and clawed by the animal inside for the effort. %SPEECH_ON%I think she wants out 'fer a bit.%SPEECH_OFF% The bird begins to calm down a little and chirps like a songbird in agreement — as if it knew exactly what was going on."
        es = "%townImage%Durante tu estancia en %townname%, aprovechas para abastecerte y prepararte para la siguiente etapa del viaje. %falconhandler% empieza a forcejear con su jaula, intentando mantenerla bajo control mientras el ave, furiosa, se desespera por salir. Carga todo su peso sobre la jaula y lo único que consigue a cambio es que el animal le pique y le arañe los dedos. %SPEECH_ON%Creo que quiere salir un ratito.%SPEECH_OFF% El ave empieza a calmarse un poco y trina como un pájaro cantor, dándole la razón, como si supiera perfectamente lo que pasa."
    }
    // context: legend_falconflies_event.create.m.Screens.push().Options.Text
    {
        en = "Alright, let her out for a bit."
        es = "Está bien, déjala salir un rato."
    }
    // context: legend_falconflies_event.create.m.Screens.push().Options.Text
    {
        en = "Get the bird under control and let's get going."
        es = "Controla a ese pájaro y pongámonos en marcha."
    }
    // context: legend_falconflies_event.create.m.Screens.push().Text
    {
        en = "%townImage%%falconhandler% sets down the cage on a nearby bench, much to the curiosity of the onlookers. %falconhandler% lays down the rest of %their_falconhandler% gear and begins to unbolt the cage, much to the delight of the prisoner inside who is now trying to help lift the bolt with its beak. %falconhandler% pinches the bolt between %their_falconhandler% fingers and turns back to you. %SPEECH_ON%Look, if I pull this door open, she might not be comin' back. I ain't learnt to fly yet so unless you can we'd be missin' a bird. %SPEECH_OFF%The bird jostles in agreement. Or protest? You don't speak bird."
        es = "%townImage%%falconhandler% deja la jaula en un banco cercano, ante la curiosidad de los mirones. %falconhandler% suelta el resto de su equipo y empieza a descorrer el cerrojo de la jaula, para deleite de la prisionera, que ya intenta ayudar a levantarlo con el pico. %falconhandler% pellizca el cerrojo entre los dedos y se vuelve hacia ti. %SPEECH_ON%Mira, si abro esta puerta, a lo mejor no vuelve. Yo todavía no sé volar, así que, a menos que tú sepas, nos quedaríamos sin pájaro.%SPEECH_OFF%El ave se revuelve dándole la razón. ¿O protestando? Tú no hablas pájaro."
    }
    // context: legend_falconflies_event.create.m.Screens.push().Options.Text
    {
        en = "I'm sure. Let her out."
        es = "Lo tengo claro. Déjala salir."
    }
    // context: legend_falconflies_event.create.m.Screens.push().Options.Text
    {
        en = "I've changed my mind. Keep her inside."
        es = "He cambiado de idea. Déjala dentro."
    }
    // context: legend_falconflies_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_20.png[/img]The falcon launches itself out of the cage at a blistering speed, barely clearing the head of an onlooker. It perches at the very apex of a large townhouse and eyes you in contempt before unfurling their wings for all to see.\n The falcon spies a target in the distance and pushes off from the rooftop in a manner both graceful and forceful.\n\n A few moments turn into minutes.\n Then the minutes into something much longer as you are waiting for something else to happen. %falconhandler% scratches %their_falconhandler% chin and picks up the empty cage, which a lone merchant is already eying up to make an offer on. %SPEECH_ON%Uh...capt'n?%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_20.png[/img]El halcón sale disparado de la jaula a una velocidad vertiginosa y pasa rozando la cabeza de un mirón. Se posa en lo más alto de una gran casa señorial y te mira con desprecio antes de desplegar las alas para que todos las vean.\n El halcón divisa un objetivo a lo lejos y se impulsa desde el tejado con tanta gracia como fuerza.\n\n Unos instantes se convierten en minutos.\n Luego los minutos se convierten en algo mucho más largo, mientras esperas a que pase algo más. %falconhandler% se rasca la barbilla y recoge la jaula vacía, a la que un mercader solitario ya le ha echado el ojo para hacer una oferta. %SPEECH_ON%Eh... ¿capi?%SPEECH_OFF%"
    }
    // context: legend_falconflies_event.create.m.Screens.push().Options.Text
    {
        en = "Off she goes!"
        es = "¡Allá va!"
    }
    // context: legend_falconflies_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_64.png[/img]Maybe we should wait a little longer?"
        es = "[img]gfx/ui/events/event_64.png[/img]¿Quizá deberíamos esperar un poco más?"
    }
    // context: legend_falconflies_event.create.m.Screens.push().Options.Text
    {
        en = "Any minute now..."
        es = "En cualquier momento..."
    }
    // context: legend_falconflies_event.create.m.Screens.push().start.List.push().text
    {
        // text = _event.m.Falcon.getName() + " flies away."
        mode = "pattern"
        en = "<name:str> flies away."
        es = "<name> se aleja volando."
    }
    // context: legend_falconflies_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_20.png[/img]The winged terror comes back into view after circling the sky for a moment or two, just before tucking in its wings and falling into a controlled dive. The avian arrow swoops into an open window — where a cacophony of screams, falling pans, overturned furniture and more screaming of both bird and man alike can be heard.\n\n The falcon quickly egresses from the window as a tattered and bleeding man screams for help from the balcony. The bird beats a hasty retreat into the cage, which %falconhandler% is holding aloft %their_falconhandler% head with the cage door wide open. The bird nestles down on their perch and closes the cage door itself with a bloody beak.\n It is at this point that you both notice a small bag tightly gripped in one claw, which she is now playfully ripping at as if disembowelling a mouse. Between the claws and beak you can make out faint glimmers of gold."
        es = "[img]gfx/ui/events/event_20.png[/img]El terror alado vuelve a aparecer tras dar un par de vueltas por el cielo, justo antes de plegar las alas y lanzarse en un picado controlado. La flecha emplumada se cuela por una ventana abierta, desde donde se oye una cacofonía de gritos, sartenes que caen, muebles volcados y más chillidos, tanto de ave como de hombre.\n\n El halcón sale enseguida por la ventana mientras un hombre, maltrecho y sangrando, pide auxilio a gritos desde el balcón. El ave se bate en rápida retirada hacia la jaula, que %falconhandler% sostiene por encima de la cabeza con la puerta abierta de par en par. El ave se acomoda en su percha y cierra ella misma la puerta de la jaula con el pico ensangrentado.\n Es entonces cuando reparas en una bolsita que lleva bien agarrada en una garra y que ahora desgarra juguetona, como si destripara un ratón. Entre las garras y el pico distingues leves destellos de oro."
    }
    // context: legend_falconflies_event.create.m.Screens.push().Options.Text
    {
        en = "Never a doubt in my mind!"
        es = "¡Nunca lo dudé!"
    }
    // context: legend_falconflies_event.create.m.Screens.push().start.List.push().text
    // en = "You gained [color=<this.Const.UI.Color.PositiveEventValue>]<money>[/color] Crowns"  // cubierto por el patrón "You gained [color=<color:str>]<money:int>[/color] Crowns"
    // context: legend_falconflies_event.onPrepareVariables._vars.push()
    // en = "falconhandler"  // nombre de variable del evento, no se muestra
    // context: legend_falconflies_event.onPrepareVariables._vars.push()
    // en = "falcon"  // nombre de variable del evento, no se muestra
    // FILE: scripts\events\events\legends\legend_fear_nobles_event.nut
    // context: legend_fear_nobles_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_26.png[/img]{You find %brother% arguing with several other companions at camp. From what you gather the group observed a noble dueling tournament in the last town.%SPEECH_ON%I'm telling ye, 'ee moved way too fast! That speed 'aint normal! What the fark am I gonna do if I face that in a fight? Bleed all over his pretty armor and hope 'ee slips in it? I mean, the big 'uns with the plate and the 'ammers is one thing, but those lunging fops... fark me.%SPEECH_OFF%No amount of cajoling or improbable war stories from the rest of the company seems able to break %brother% out of this defeatist mood.}"
        es = "[img]gfx/ui/events/event_26.png[/img]{Encuentras a %brother% discutiendo con varios compañeros en el campamento. Por lo que deduces, el grupo asistió a un torneo de duelos de nobles en el último pueblo.%SPEECH_ON%¡Te lo digo yo, ese se movía demasiado rápido! ¡Esa velocidad no es normal! ¿Qué mierda voy a hacer si me toca uno así en una pelea? ¿Desangrarme sobre su bonita armadura y esperar a que se resbale? O sea, los grandotes con placas y martillos son una cosa, pero esos petimetres que te tiran estocadas... a la mierda.%SPEECH_OFF%Ni los halagos ni las inverosímiles batallitas del resto de la compañía logran sacar a %brother% de ese humor derrotista.}"
    }
    // context: legend_fear_nobles_event.create.m.Screens.push().Options.Text
    {
        en = "They are still just men, underneath the finery."
        es = "Bajo tanto lujo, no dejan de ser hombres."
    }
    // context: legend_fear_nobles_event.create.m.Screens.push().start.::Legends.Traits.grant().List.push().text
    {
        // text = _event.m.Casualty.getName() + " now fears the nobility."
        mode = "pattern"
        en = "<name:str> now fears the nobility."
        es = "<name> ahora teme a la nobleza."
    }
    // FILE: scripts\events\events\legends\legend_greenskins_town_razed_event.nut
    // context: legend_greenskins_town_razed_event.create.m.Screens.push().Text
    {
        // corrige base: la 1.0 quita la exclamación de la primera variante («...por los pieles verdes.»); el inglés la tiene
        // corrige base: «cuando todo esté dicho y hecho» es calco de «when it's all said and done»; pasa a «cuando todo acabe»
        // corrige base: «un noble mensajero» dice que el mensajero es noble; «noble messenger» es un mensajero de los nobles
        // corrige base: «solo para encontrarla invadida» es calco de «only to find»; pasa a «y me la encontré invadida»
        // corrige base: «Se fue. Completamente desaparecida.» es calco y suena raro; pasa a «Ya no existe. Ha desaparecido por completo.»
        en = "[img]gfx/ui/events/event_94.png[/img]{Somber news on the road. Refugees and traders are reporting that %city% has been razed to the ground by the greenskins! If this keeps up, there shan't be a land to call home when it's all said and done. | You find a noble messenger watering his horse beside the path. He states that the greenskins have annihilated the human armies around %city% and razed the town itself! | You come across a cartographer and a trader with an empty cart. They're updating a map and there's something curious about it: the mapmaker is redrawing %city% on the paper. When you ask why, he raises an eyebrow.%SPEECH_ON%Oh, you haven't heard? %city%'s been razed to the ground. Greenskins overran the defenses and killed everyone they got their hands on.%SPEECH_OFF% | You come across a trader on the path. His cart is emptied and missing some draught animals. There's blood on his face and clothes. You ask the man for his story. He straightens up.%SPEECH_ON%My story? No, it ain't my story. I was on my way to %city% only to find it overrun by greenskins. I barely escaped with my life. The town itself is done for. If that's the way you was headed, don't bother. It's gone. Completely gone.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_94.png[/img]{Sombrías noticias en el camino. ¡Refugiados y comerciantes informan de que los pieles verdes han arrasado %city% hasta los cimientos! Si esto continúa, no quedará tierra a la que llamar hogar cuando todo acabe. | Encuentras a un mensajero de los nobles dando de beber a su caballo junto al camino. Afirma que los pieles verdes han aniquilado a los ejércitos humanos alrededor de %city% ¡y arrasado la ciudad misma! | Te topas con un cartógrafo y un comerciante con un carro vacío. Están actualizando un mapa y hay algo curioso en él: el cartógrafo está redibujando %city% en el papel. Cuando preguntas por qué, levanta una ceja.%SPEECH_ON%Oh, ¿no te has enterado? %city% ha sido arrasada hasta los cimientos. Los pieles verdes superaron las defensas y mataron a todos los que atraparon.%SPEECH_OFF% | Te encuentras con un comerciante en el camino. Su carro está vacío y faltan algunos animales de tiro. Hay sangre en su rostro y ropa. Le pides al hombre su historia. Se endereza.%SPEECH_ON%¿Mi historia? No, no es mi historia. Iba camino a %city% y me la encontré invadida por los pieles verdes. A duras penas escapé con vida. La ciudad en sí está perdida. Si es hacia allá donde te dirigías, no te molestes. Ya no existe. Ha desaparecido por completo.%SPEECH_OFF%}"
    }
    // en = "Are we losing this war?"
    // en base_es
    // en = "city"
    // FILE: scripts\events\events\legends\legend_hate_beasts_event.nut
    // context: legend_hate_beasts_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_26.png[/img]Beast corpses litter the ground — their ichor tainting the soil black. With a scowl you realise your clothes and sword are amess as the company survivors around you are busy making certain the beasts are truly dead, that is except for %brother%, who is still frantically swinging their weapon about in lethal arcs.%SPEECH_ON%YOU 'AINT EATING ME YOU FARKS!%SPEECH_OFF%You call out to them, trying to tell them the battle is over, but the wild look in their eyes tells you they did not hear, or perhaps chose not to...%SPEECH_ON%YOU DISGUSTING! FILTHY! ABNORMAL! FARKIN! FREAKS!%SPEECH_OFF%The Company scrambles out of the way of the whirlwind that is %brother%, lest they lose limbs. You gamely follow behind them and were just considering a tackle, when they abruptly turn to start hacking up a particularly monstrous sized beast corpse. Gobbets of flesh rain everywhere, including over you and your up-until-now unsoiled hat. Just farkin' great. Swearing viciously, you turn and leave, telling your grinning sergeant to let %brother% work it out of their system.}"
        es = "[img]gfx/ui/events/event_26.png[/img]Los cadáveres de bestias cubren el suelo y su icor tiñe la tierra de negro. Con el ceño fruncido, te das cuenta de que tu ropa y tu espada son un desastre, mientras a tu alrededor los supervivientes de la compañía se afanan en asegurarse de que las bestias estén bien muertas; todos menos %brother%, que sigue agitando frenéticamente su arma en arcos letales.%SPEECH_ON%¡A MÍ NO ME VAN A COMER, HIJOS DE PUTA!%SPEECH_OFF%Le gritas, intentando decirle que la batalla ha terminado, pero la mirada salvaje de sus ojos te dice que no te ha oído, o que quizá ha preferido no hacerlo...%SPEECH_ON%¡ASQUEROSOS! ¡INMUNDOS! ¡ANORMALES! ¡PUTOS! ¡ENGENDROS!%SPEECH_OFF%La compañía se aparta a toda prisa del torbellino que es %brother%, para no perder ningún miembro. Vas detrás con arrojo y estabas planteándote hacerle un placaje cuando, de repente, se da la vuelta y se pone a despedazar el cadáver de una bestia de un tamaño particularmente monstruoso. Llueven pedazos de carne por todas partes, también sobre ti y sobre tu sombrero, hasta ahora impoluto. Estupendo, de puta madre. Soltando juramentos feroces, te das la vuelta y te vas, y le dices a tu sargento, que sonríe de oreja a oreja, que deje que %brother% se desahogue.}"
    }
    // context: legend_hate_beasts_event.create.m.Screens.push().Options.Text
    {
        en = "A little hatred can be a powerful thing."
        es = "Un poco de odio puede ser muy poderoso."
    }
    // context: legend_hate_beasts_event.create.m.Screens.push().start.::Legends.Traits.grant().List.push().text
    {
        // text = _event.m.Casualty.getName() + " now hates beasts"
        mode = "pattern"
        en = "<name:str> now hates beasts"
        es = "<name> ahora odia a las bestias"
    }
    // FILE: scripts\events\events\legends\legend_hate_nobles_event.nut
    // context: legend_hate_nobles_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_26.png[/img]{Gods, that was a hard fought battle. Bodies lay all around you, some not fully dead yet groaning in agony. Those in the company still standing get to the  grim task of sending those souls on their way and looting the fallen. As your vision returns to normal and the thundering in your ears recede, you clap eyes on %brother%, who is screaming into the pale face of what was a particularly fair young nobleman, whose blonde locks are now matted with blood.%SPEECH_ON%YOU THINK YOU ARE BETTER THEN ME YOU NOBLE FARK?!%SPEECH_OFF%They shake the shoulders of the nobleman, the golden head lolling about. The lad is quite clearly dead.%SPEECH_ON%I 'AINT NOTHIN! I 'AINT TRASH! I FARKIN SHOWED YOU DIDN''T I?!%SPEECH_OFF%They punch the corpse in the face, dropping it to the ground, then howling more expletives, pick it up and punch it again. And again. The obscene racket is starting to give you a headache. Sighing, you stride over and lay %brother% out with the flat of your sword. They curl up whimpering, their energy finally spent. You sheathe your sword and idly wonder what vicious barb the noble lad could have spoken to goad such a reaction.}"
        es = "[img]gfx/ui/events/event_26.png[/img]{Dioses, qué batalla tan reñida. Hay cuerpos por todas partes a tu alrededor, algunos aún no del todo muertos, gimiendo de agonía. Los de la compañía que siguen en pie se ponen con la sombría tarea de despachar a esas almas y saquear a los caídos. Cuando la vista se te aclara y el estruendo de tus oídos remite, reparas en %brother%, que le grita a la cara pálida de quien fuera un joven noble especialmente bien parecido, de rizos rubios ahora apelmazados de sangre.%SPEECH_ON%¡¿TE CREES MEJOR QUE YO, NOBLE DE MIERDA?!%SPEECH_OFF%Sacude al noble por los hombros y la cabeza dorada se bambolea de un lado a otro. El muchacho está muerto, a todas luces.%SPEECH_ON%¡NO SOY POCA COSA! ¡NO SOY BASURA! ¡TE LO HE DEMOSTRADO, ¿A QUE SÍ, JODER?!%SPEECH_OFF%Le da un puñetazo en la cara al cadáver, que cae al suelo; luego, aullando más improperios, lo levanta y vuelve a golpearlo. Y otra vez. Ese escándalo obsceno empieza a darte dolor de cabeza. Con un suspiro, te acercas a grandes zancadas y tumbas a %brother% de un golpe con la parte plana de la espada. Se hace un ovillo, gimoteando, sin fuerzas ya. Envainas la espada y te preguntas distraídamente qué pulla venenosa pudo soltar el joven noble para provocar semejante reacción.}"
    }
    // context: legend_hate_nobles_event.create.m.Screens.push().Options.Text
    {
        en = "At least they are motivated."
        es = "Al menos hay motivación."
    }
    // context: legend_hate_nobles_event.create.m.Screens.push().start.::Legends.Traits.grant().List.push().text
    {
        // text = _event.m.Casualty.getName() + " now hates the nobility."
        mode = "pattern"
        en = "<name:str> now hates the nobility."
        es = "<name> ahora odia a la nobleza."
    }
    // FILE: scripts\events\events\legends\legend_houndmaster_tames_white_wolf_event.nut
    // context: legend_houndmaster_tames_white_wolf_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_143.png[/img]While traversing the snowy wastelands of the realm's north, %houndmaster% the houndmaster has come to befriend a creature that's been trailing beside the company's march: a wolf. The houndmaster frequently remained in the rearguard, crouched low, hands at his side, locking eyes with the lone wolf for minutes on end. But today  %houndmaster% decided to go one step further. The houndmaster makes attempt to tame wild beast… "
        es = "[img]gfx/ui/events/event_143.png[/img]Mientras la compañía atraviesa los páramos nevados del norte del reino, %houndmaster%, que se encarga de los perros, ha trabado amistad con una criatura que lleva un tiempo siguiendo su marcha: un lobo. A menudo se quedaba en la retaguardia, en cuclillas y con las manos a los costados, sosteniéndole la mirada al lobo solitario durante minutos enteros. Pero hoy %houndmaster% ha decidido ir un paso más allá e intentar domar a la bestia salvaje… "
    }
    // context: legend_houndmaster_tames_white_wolf_event.create.m.Screens.push().Options.Text
    {
        en = "Now or never."
        es = "Ahora o nunca."
    }
    // context: legend_houndmaster_tames_white_wolf_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_white_wolf.png[/img]Using a bit of leftover meat, %houndmaster%  plied the beast right into the middle of the camp. Now he squats at its side, dwarfed by its prominent, muscled withers, its pointed and attentive ears, and a lapping maw lined with mankilling canines.\n\n The rest of the men stand behind their weapons. One yells at the houndmaster to stop all of this. Another says the wolf can smell fear. Yet another throws a rock at it. The wolf winces, but doesn't react. Laughing, the houndmaster makes a 'tssst!' noise and points. The wolf launches forward, picking up the stone and bringing it back to the man. %houndmaster%  rubs the beast's mane.%SPEECH_ON%See, easily trained, just any dog. Only bigger, faster, and stronger. Smarter, too.%SPEECH_OFF%Its eyes meet yours. The wolf lays low, almost like a man bowing. %houndmaster% laughs again.%SPEECH_ON%See? It already knows who is alpha of this pack.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/legend_white_wolf.png[/img]Con un poco de carne sobrante, %houndmaster% ha atraído a la bestia hasta el mismo centro del campamento. Ahora está en cuclillas a su lado, a la sombra de su cruz prominente y musculosa, sus orejas puntiagudas y atentas y unas fauces babeantes erizadas de colmillos capaces de matar a un hombre.\n\n El resto de los hombres se parapetan tras sus armas. Uno le grita que pare con todo esto. Otro dice que el lobo huele el miedo. Otro más le tira una piedra. El lobo se encoge, pero no reacciona. Entre risas, suelta un «¡tssst!» y señala. El lobo sale disparado, recoge la piedra y se la trae de vuelta. %houndmaster% le frota la melena a la bestia.%SPEECH_ON%¿Ves? Se adiestra fácil, como cualquier perro. Solo que más grande, más rápido y más fuerte. Y más listo, también.%SPEECH_OFF%Sus ojos se cruzan con los tuyos. El lobo se agacha, casi como un hombre que hace una reverencia. %houndmaster% vuelve a reírse.%SPEECH_ON%¿Ves? Ya sabe quién manda en esta manada.%SPEECH_OFF%"
    }
    // en = "A noble beast."
    // en base_es
    // context: legend_houndmaster_tames_white_wolf_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_white_wolf.png[/img]The magnificent white beast doesn't take the bait. Runs away and most likely %houndmaster%  wont see it again."
        es = "[img]gfx/ui/events/legend_white_wolf.png[/img]La magnífica bestia blanca no muerde el anzuelo. Huye, y lo más probable es que %houndmaster% no vuelva a verla."
    }
    // context: legend_houndmaster_tames_white_wolf_event.create.m.Screens.push().Options.Text
    {
        en = "Damn beast."
        es = "Maldita bestia."
    }
    // context: legend_houndmaster_tames_white_wolf_event.create.m.Screens.push().start.List.push().::Legends.EventList.changeMood()
    {
        en = "Failed to tame the white wolf"
        es = "No consiguió domar al lobo blanco"
    }
    // FILE: scripts\events\events\legends\legend_inventor_prosthetic_ear.nut
    // context: legend_inventor_prosthetic_ear.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% bumps your side and points to %nofoot%'s ear. %SPEECH_ON% It's left a nasty scar, but I reckon I could make life a little easier for them — all I need is a little scratch and some supplies from the stash...%SPEECH_OFF%"
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% te da un codazo y señala la oreja de %nofoot%. %SPEECH_ON%Le ha quedado una cicatriz fea, pero creo que podría hacerle la vida un poco más fácil; solo necesito unas monedillas y algunos suministros de la reserva...%SPEECH_OFF%"
    }
    // context: legend_inventor_prosthetic_ear.create.m.Screens.push().Options.Text
    {
        en = "Alright. Here's 350 crowns — and take 5 tools from the cart."
        es = "Está bien. Aquí tienes 350 coronas, y toma 5 herramientas del carro."
    }
    // context: legend_inventor_prosthetic_ear.create.m.Screens.push().Options.Text
    {
        en = "We can't spare resources on this right now."
        es = "Ahora mismo no podemos gastar recursos en esto."
    }
    // context: legend_inventor_prosthetic_ear.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% attaches an artificial ear to %nofoot%'s head. It droops slightly but %inventor% rushes in to catch it before it falls completely. You lock your gaze from the ear to %nofoot% directly.\n\n %SPEECH_ON%Any better?%SPEECH_OFF% %nofoot% looks in your direction.\n\n %SPEECH_ON%WHAT?%SPEECH_OFF%"
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% le coloca una oreja artificial a %nofoot% en la cabeza. Se descuelga un poco, pero %inventor% se apresura a sujetarla antes de que se caiga del todo. Apartas la vista de la oreja y miras directamente a %nofoot%.\n\n %SPEECH_ON%¿Mejor?%SPEECH_OFF% %nofoot% mira hacia ti.\n\n %SPEECH_ON%¿QUÉ?%SPEECH_OFF%"
    }
    // context: legend_inventor_prosthetic_ear.create.m.Screens.push().Options.Text
    {
        en = "Let's try it out!"
        es = "¡Probémosla!"
    }
    // en = "You spend <v:str_tag> Crowns"
    // en base_es
    // context: legend_inventor_prosthetic_ear.create.m.Screens.push().start.List.push().text
    {
        // text = "You spend [color=" + this.Const.UI.Color.NegativeEventValue + "]5[/color] Tools and Supplies"
        mode = "pattern"
        en = "You spend [color=<color:str>]5[/color] Tools and Supplies"
        es = "Gastas [color=<color>]5[/color] Herramientas y suministros"
    }
    // context: legend_inventor_prosthetic_ear.create.m.Screens.push().start.trait.::Legends.Traits.grant().List.push().text
    {
        // text = _event.m.Nofoot.m.Name + " receives a " + _trait.m.Name
        mode = "pattern"
        en = "<name:str> receives a <trait:str>"
        es = "<name> recibe <trait:t>"
    }
    // en = "<actor:str> no longer has a <name:str>"
    // en base_es
    // context: legend_inventor_prosthetic_ear.create.m.Screens.push().start._event.m.Inventor.improveMood()
    {
        // _event.m.Inventor.improveMood(2.0, "Created a " + trait.m.Name + " for " + _event.m.Nofoot.m.Name);
        mode = "pattern"
        en = "Created a <trait:str> for <name:str>"
        es = "Creó <trait:t> para <name>"
    }
    // context: legend_inventor_prosthetic_ear.create.m.Screens.push().start._event.m.Nofoot.improveMood()
    {
        // _event.m.Nofoot.improveMood(2.0, "Received a " + trait.m.Name + " from " + _event.m.Inventor.m.Name);
        mode = "pattern"
        en = "Received a <trait:str> from <name:str>"
        es = "Recibió <trait:t> de manos de <name>"
    }
    // context: legend_inventor_prosthetic_ear.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]You tell %inventor% that the %companyname% has no resources to spare for such things at this time. But you have no doubt they'll ask again later."
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]Le dices a %inventor% que %companyname% no tiene recursos de sobra para esas cosas ahora mismo. Pero no te cabe duda de que volverá a pedirlo más adelante."
    }
    // context: legend_inventor_prosthetic_ear.create.m.Screens.push().Options.Text
    {
        en = "Perhaps another time."
        es = "Quizá en otra ocasión."
    }
    // context: legend_inventor_prosthetic_ear.onPrepareVariables._vars.push()
    // en = "nofoot"  // nombre de variable del evento, no se muestra
    // FILE: scripts\events\events\legends\legend_inventor_prosthetic_eye.nut
    // context: legend_inventor_prosthetic_eye.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]As you plant your behind on the ground to get some rest, you notice %inventor% darting back and forth between the company, inspecting their eyes. Before long they come running up to you as well.\n%SPEECH_ON%Captain! May I have a look at your eyes?%SPEECH_OFF%Not actually waiting for you to reply, they hastily shift up close to you, grabbing your head and inspecting your eyes from every possible angle.\n%SPEECH_ON%Yes, yes... Yes! I think I've figured out how to do it...%SPEECH_OFF%You're just about to ask him what on earth they're talking about.\n%SPEECH_ON%Do what, you might wonder. Well, you see, %noeye% over there has been feeling down ever since the incident and I haven't been able to stop thinking about his situation. I think I can help him!%SPEECH_OFF%They smile broadly while staring intently at you.\n%SPEECH_ON%I just need a few tools and some coin to make what I need — but this could be dangerous...%SPEECH_OFF%"
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]Mientras plantas el trasero en el suelo para descansar un poco, ves a %inventor% yendo y viniendo entre los miembros de la compañía, examinándoles los ojos. Al poco rato viene corriendo también hacia ti.\n%SPEECH_ON%¡Capitán! ¿Me dejas ver tus ojos?%SPEECH_OFF%Sin esperar siquiera a que respondas, se te acerca a toda prisa, te agarra la cabeza y te examina los ojos desde todos los ángulos posibles.\n%SPEECH_ON%Sí, sí... ¡Sí! Creo que ya sé cómo hacerlo...%SPEECH_OFF%Estás a punto de preguntarle de qué demonios habla.\n%SPEECH_ON%¿Hacer qué?, te preguntarás. Pues verás, %noeye%, ahí donde está, anda con el ánimo por los suelos desde el incidente, y no he podido dejar de pensar en su situación. ¡Creo que puedo echarle una mano!%SPEECH_OFF%Sonríe de oreja a oreja mientras te mira fijamente.\n%SPEECH_ON%Solo necesito unas cuantas herramientas y algo de dinero para fabricar lo que necesito... pero esto podría ser peligroso...%SPEECH_OFF%"
    }
    // context: legend_inventor_prosthetic_eye.create.m.Screens.push().Options.Text
    {
        en = "Sounds good. Here's 600 crowns for the expenses. Take 5 tools from the cart."
        es = "Me parece bien. Aquí tienes 600 coronas para los gastos. Toma 5 herramientas del carro."
    }
    // context: legend_inventor_prosthetic_eye.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]As you plant your behind on the ground to get some rest, you notice %inventor% darting back and forth between the company, inspecting their eyes. Before long they come running up to you as well.%SPEECH_ON%Captain! May I have a look at your eyes?%SPEECH_OFF%Not actually waiting for you to reply, they hastily shift up close to you, grabbing your head and checks your eyes from every possible angle.%SPEECH_ON%Yes, yes. Yes! I think I've figured out how to do it.%SPEECH_OFF%You're just about to ask him what on earth he's talking about when he continues.%SPEECH_ON%Do what, you might wonder. Well, you see, %noeye% over there has been feeling down ever since the incident and I haven't been able to stop thinking about his situation. I think I can help him!%SPEECH_OFF%He smiles broadly while staring intently at you.%SPEECH_ON%For some mere coin I can procure what items I need.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]Mientras plantas el trasero en el suelo para descansar un poco, ves a %inventor% yendo y viniendo entre los miembros de la compañía, examinándoles los ojos. Al poco rato viene corriendo también hacia ti.%SPEECH_ON%¡Capitán! ¿Me dejas ver tus ojos?%SPEECH_OFF%Sin esperar siquiera a que respondas, se te acerca a toda prisa, te agarra la cabeza y te examina los ojos desde todos los ángulos posibles.%SPEECH_ON%Sí, sí. ¡Sí! Creo que ya sé cómo hacerlo.%SPEECH_OFF%Estás a punto de preguntarle de qué demonios habla cuando continúa.%SPEECH_ON%¿Hacer qué?, te preguntarás. Pues verás, %noeye%, ahí donde está, anda con el ánimo por los suelos desde el incidente, y no he podido dejar de pensar en su situación. ¡Creo que puedo echarle una mano!%SPEECH_OFF%Sonríe de oreja a oreja mientras te mira fijamente.%SPEECH_ON%Por unas pocas monedas puedo conseguir lo que necesito.%SPEECH_OFF%"
    }
    // context: legend_inventor_prosthetic_eye.create.m.Screens.push().Options.Text
    {
        en = "Sounds good. Here's 600 crowns for the expenses."
        es = "Me parece bien. Aquí tienes 600 coronas para los gastos."
    }
    // context: legend_inventor_prosthetic_eye.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% runs off and starts working on.. whatever it is, so you lean back and let the resting begin. An hour or so passes by before %inventor% comes back, dragging %noeye% behind him.%SPEECH_ON%It's completed, captain. Watch.%SPEECH_OFF%The enthusiastic inventor faces %noeye%, tells him to lift his head up and then proceeds to stick something into his eye.%SPEECH_ON%Look at him! It fits perfectly. This new eye of his will surely bring his confidence back in no time!%SPEECH_OFF%Before you can say anything, %inventor% has already lept away and continued on some other project, %noeye% still standing in front of you looking very confused."
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% sale corriendo y se pone a trabajar en... lo que sea eso, así que te recuestas y te dispones a descansar. Pasa una hora o así antes de que %inventor% vuelva arrastrando a %noeye% tras de sí.%SPEECH_ON%Ya está terminado, capitán. Mira.%SPEECH_OFF%Con todo su entusiasmo, se planta frente a %noeye%, le dice que levante la cabeza y a continuación le mete algo en el ojo.%SPEECH_ON%¡Fíjate! Encaja a la perfección. ¡Con este ojo nuevo recuperará la confianza en un abrir y cerrar de ojos!%SPEECH_OFF%Antes de que puedas decir nada, %inventor% ya se ha marchado de un salto a seguir con algún otro proyecto, y %noeye% sigue delante de ti con cara de no entender nada."
    }
    // context: legend_inventor_prosthetic_eye.create.m.Screens.push().Options.Text
    {
        en = "You look.. good?"
        es = "Tienes... ¿buen aspecto?"
    }
    // en = "You spend <v:str_tag> Crowns"
    // en base_es
    // context: legend_inventor_prosthetic_eye.create.m.Screens.push().start.trait.::Legends.Traits.grant().List.push().text
    // en = "<_event.m.Noeye.m.Name> receives a <_trait.m.Name>"  // cubierto por el patrón "<name:str> receives a <trait:str>"
    // en = "<actor:str> no longer has a <name:str>"
    // en base_es
    // context: legend_inventor_prosthetic_eye.create.m.Screens.push().start._event.m.Inventor.improveMood()
    // en = "Created a <trait.m.Name> for <_event.m.Noeye.m.Name>"  // cubierto por el patrón "Created a <trait:str> for <name:str>"
    // context: legend_inventor_prosthetic_eye.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% runs off and starts working on.. whatever it is, so you lean back and let the resting begin. An hour or so passes by before %inventor% comes back, dragging %noeye% behind him.%SPEECH_ON%It's completed, captain. Watch.%SPEECH_OFF%The enthusiastic inventor faces %noeye%, tells him to lift his head up and then proceeds to stick something into his eye.%SPEECH_ON%Look at him! It fits perfectly. This new eye of his will sure--%SPEECH_OFF%He gets interrupted by %noeye% who screams out in pain as he falls to the ground, bleeding heavily from his eye.%SPEECH_ON%Oh.. I.. seem to have miscalculated. No worries, I'm sure he'll be fine!%SPEECH_OFF%The inventor slinks away out of sight as %noeye% goes silent, drifting into unconsciousness."
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% sale corriendo y se pone a trabajar en... lo que sea eso, así que te recuestas y te dispones a descansar. Pasa una hora o así antes de que %inventor% vuelva arrastrando a %noeye% tras de sí.%SPEECH_ON%Ya está terminado, capitán. Mira.%SPEECH_OFF%Con todo su entusiasmo, se planta frente a %noeye%, le dice que levante la cabeza y a continuación le mete algo en el ojo.%SPEECH_ON%¡Fíjate! Encaja a la perfección. Con este ojo nuevo seguro que--%SPEECH_OFF%Le interrumpe %noeye%, que grita de dolor al desplomarse en el suelo, sangrando en abundancia por el ojo.%SPEECH_ON%Oh... Parece que... he calculado mal. No te preocupes, ¡seguro que se pondrá bien!%SPEECH_OFF%Con disimulo, se escabulle de tu vista mientras %noeye% enmudece y pierde el conocimiento."
    }
    // context: legend_inventor_prosthetic_eye.create.m.Screens.push().Options.Text
    {
        en = "What have you done?!"
        es = "¡¿Qué has hecho?!"
    }
    // en = "<bro:str> suffers <injury:str>"
    // en base_es
    // context: legend_inventor_prosthetic_eye.create.m.Screens.push().start._event.m.Inventor.worsenMood()
    {
        // _event.m.Inventor.worsenMood(this.Const.MoodChange.PermanentInjury, "Caused " + brain_damage_yum.m.Name + " in " + _event.m.Noeye.m.Name);
        mode = "pattern"
        en = "Caused <injury:str> in <name:str>"
        es = "Causó <injury:t> a <name>"
    }
    // context: legend_inventor_prosthetic_eye.create.m.Screens.push().start._event.m.Noeye.worsenMood()
    {
        // _event.m.Noeye.worsenMood(this.Const.MoodChange.PermanentInjury, "Suffered " + brain_damage_yum.m.Name + " because of " + _event.m.Inventor.m.Name);
        mode = "pattern"
        en = "Suffered <injury:str> because of <name:str>"
        es = "Sufrió <injury:t> por culpa de <name>"
    }
    // context: legend_inventor_prosthetic_eye.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]You tell %inventor% that the %companyname% has no resources to spare for such things at this time. The inventor tilts his head at an odd angle and shrugs before he takes off."
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]Le dices a %inventor% que %companyname% no tiene recursos de sobra para esas cosas ahora mismo. Ladea la cabeza en un ángulo extraño y se encoge de hombros antes de marcharse."
    }
    // context: legend_inventor_prosthetic_eye.create.m.Screens.push().Options.Text
    {
        en = "Maybe later?"
        es = "¿Quizá más tarde?"
    }
    // context: legend_inventor_prosthetic_eye.onPrepareVariables._vars.push()
    // en = "noeye"  // nombre de variable del evento, no se muestra
    // FILE: scripts\events\events\legends\legend_inventor_prosthetic_finger.nut
    // context: legend_inventor_prosthetic_finger.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% offers to fix %nofoot%'s finger. He asks for coin to cover the cost, and requires the use of company tools."
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% se ofrece a arreglarle el dedo a %nofoot%. Pide dinero para cubrir los costes y necesita usar herramientas de la compañía."
    }
    // context: legend_inventor_prosthetic_finger.create.m.Screens.push().Options.Text
    {
        en = "Alright. Here's 225 crowns. Take 5 tools from the cart."
        es = "Está bien. Aquí tienes 225 coronas. Toma 5 herramientas del carro."
    }
    // context: legend_inventor_prosthetic_finger.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% attaches an artificial finger to %nofoot%'s hand. It squeaks a little, but it's better than nothing...right?"
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% le coloca un dedo artificial a %nofoot% en la mano. Chirría un poco, pero es mejor que nada... ¿verdad?"
    }
    // en = "You spend <v:str_tag> Crowns"
    // en base_es
    // context: legend_inventor_prosthetic_finger.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]You tell %inventor% that the %companyname% has no resources to spare for such things at this time."
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]Le dices a %inventor% que %companyname% no tiene recursos de sobra para esas cosas ahora mismo."
    }
    // FILE: scripts\events\events\legends\legend_inventor_prosthetic_foot.nut
    // context: legend_inventor_prosthetic_foot.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% offers to fix %nofoot%'s foot. He asks for coin to cover the cost, and requires the use of company tools."
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% se ofrece a arreglarle el pie a %nofoot%. Pide dinero para cubrir los costes y necesita usar herramientas de la compañía."
    }
    // context: legend_inventor_prosthetic_foot.create.m.Screens.push().Options.Text
    {
        en = "Alright. Here's 1000 crowns. Make sure to take 10 tools from the camp."
        es = "Está bien. Aquí tienes 1000 coronas. No olvides tomar 10 herramientas del campamento."
    }
    // context: legend_inventor_prosthetic_foot.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% amputates %nofoot%'s foot and attaches an artificial one. This might be an upgrade, it's hard to say at this point."
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% le amputa el pie a %nofoot% y le coloca uno artificial. Quizá salga ganando; a estas alturas es difícil saberlo."
    }
    // context: legend_inventor_prosthetic_foot.create.m.Screens.push().start.List.push().text
    {
        // text = "You spend [color=" + this.Const.UI.Color.NegativeEventValue + "]10[/color] Tools and Supplies"
        mode = "pattern"
        en = "You spend [color=<color:str>]10[/color] Tools and Supplies"
        es = "Gastas [color=<color>]10[/color] Herramientas y suministros"
    }
    // FILE: scripts\events\events\legends\legend_inventor_prosthetic_forearm.nut
    // context: legend_inventor_prosthetic_forearm.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% offers to fix %nofoot%'s arm. He asks for coin to cover the cost, and requires the use of company tools."
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% se ofrece a arreglarle el brazo a %nofoot%. Pide dinero para cubrir los costes y necesita usar herramientas de la compañía."
    }
    // context: legend_inventor_prosthetic_forearm.create.m.Screens.push().Options.Text
    {
        en = "Alright. Here's 2000 crowns. Take 20 tools from around the camp."
        es = "Está bien. Aquí tienes 2000 coronas. Reúne 20 herramientas por el campamento."
    }
    // context: legend_inventor_prosthetic_forearm.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% amputates %nofoot%'s forearm and attaches an artificial one. %nofoot% cheerfully slaps %inventor%'s face as they make finishing touches."
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]%inventor% le amputa el antebrazo a %nofoot% y le coloca uno artificial. %nofoot% le da una alegre bofetada a %inventor% mientras le da los últimos retoques."
    }
    // context: legend_inventor_prosthetic_forearm.create.m.Screens.push().start.List.push().text
    {
        // text = "You spend [color=" + this.Const.UI.Color.NegativeEventValue + "]20[/color] Tools and Supplies"
        mode = "pattern"
        en = "You spend [color=<color:str>]20[/color] Tools and Supplies"
        es = "Gastas [color=<color>]20[/color] Herramientas y suministros"
    }
    // FILE: scripts\events\events\legends\legend_inventor_prosthetic_hand.nut
    // context: legend_inventor_prosthetic_hand.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]As you take in the scenery you find %inventor% sitting by a tree, seemingly deep in thought, startling him as you approach.%SPEECH_ON%Oh, hey there, captain! I didn't see you there.%SPEECH_OFF%He stands up and enthusiastically steps up to you.%SPEECH_ON%You know.. I've been thinking of ways to help %nohand% with his problem, and I think I might have come up with a solution.%SPEECH_OFF%He scratches his head nervously as he continues..%SPEECH_ON%I.. will need some coin in order to cover the material cost for this little experiment, however, and any leftover tools that we can spare.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]Mientras contemplas el paisaje, encuentras a %inventor% al pie de un árbol, con la mente en otra parte, y le das un susto al acercarte.%SPEECH_ON%¡Ah, hola, capitán! No te había visto.%SPEECH_OFF%Se levanta y se te acerca con entusiasmo.%SPEECH_ON%Verás... He estado pensando en cómo ayudar a %nohand% con su problema, y creo que se me ha ocurrido una solución.%SPEECH_OFF%Se rasca la cabeza con nerviosismo mientras continúa...%SPEECH_ON%Eso sí... necesitaré algo de dinero para cubrir el coste de los materiales de este pequeño experimento, y las herramientas que nos sobren.%SPEECH_OFF%"
    }
    // context: legend_inventor_prosthetic_hand.create.m.Screens.push().Options.Text
    {
        en = "Here's 1750 crowns. Take 15 tools from the tents. Show me what you can do."
        es = "Aquí tienes 1750 coronas. Toma 15 herramientas de las tiendas. Demuéstrame lo que sabes hacer."
    }
    // context: legend_inventor_prosthetic_hand.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]You hand him some coin and he takes his leave. You stroll around the camp for some time and then, from out of nowhere, %inventor% appears before you, holding something behind his back.%SPEECH_ON%It's finished! Are you ready?%SPEECH_OFF% With eyes the size of saucers, he spins around and then hands you what looks like.. a hand?%SPEECH_ON%It's a new hand! I'm sure this will be of great help to %nohand%.%SPEECH_OFF%He bows to you and scurries off. Well, I guess we'll find out."
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]Le das unas monedas y se despide. Paseas un rato por el campamento y entonces, de la nada, %inventor% aparece ante ti escondiendo algo a la espalda.%SPEECH_ON%¡Ya está! ¿Te lo enseño?%SPEECH_OFF% Con los ojos como platos, da media vuelta y te entrega lo que parece... ¿una mano?%SPEECH_ON%¡Es una mano nueva! Seguro que le será de gran ayuda a %nohand%.%SPEECH_OFF%Te hace una reverencia y se va a toda prisa. Bueno, supongo que ya se verá."
    }
    // en = "You spend <v:str_tag> Crowns"
    // en base_es
    // context: legend_inventor_prosthetic_hand.create.m.Screens.push().start.List.push().text
    {
