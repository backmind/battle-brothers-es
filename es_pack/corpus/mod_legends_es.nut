    // FILE: scripts\skills\actives\legend_wooden_stake_stab_skill.nut
    // context: legend_wooden_stake_stab_skill.create.m.Description
    {
        en = "A quick and fast stab with the wooden shaft. Very effective against vampires."
        es = "Una puñalada rápida y veloz con la estaca de madera. Muy eficaz contra los vampiros."
