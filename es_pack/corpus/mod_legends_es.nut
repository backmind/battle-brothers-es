        en = "Lute Bash"
        es = "Golpe de laúd"
    }
    // context: bash.o.setItem.m.Description
    {
        en = "A brute force attack with a string instrument"
        es = "Un ataque de fuerza bruta con un instrumento de cuerda"
    }
    // context: bash.o.setItem.m.KilledString
