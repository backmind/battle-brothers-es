    // FILE: scripts\items\helmets\named\legend_frogmouth_helm_decorated.nut
    // context: legend_frogmouth_helm_decorated.create.m.Name
    {
        en = "Decorated Frogmouth Helm"
        es = "Yelmo de boca de rana decorado"
    }
    // context: legend_frogmouth_helm_decorated.create.m.Description
    {
        en = "A decorated closed metal helm with a breathing hole in the shape of a frog mouth. Great in the way of protection but hard to breathe in and limiting the field of view."
        es = "Un yelmo de metal cerrado y decorado, con un orificio para respirar en forma de boca de rana. Excelente en términos de protección, pero es difícil respirar en él y limita el campo de visión."
    }
    // context: legend_frogmouth_helm_decorated.create.m.NameList
