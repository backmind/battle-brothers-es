    {
        en = "{We need to be paid more for this.}"
        es = ""
    }
    // context: ::Const.Contracts.NegotiationMoneyAndItems.start.Options.push().Text
    {
        en = "{Forget it, this isn't worth it. | What a waste of time. }"
