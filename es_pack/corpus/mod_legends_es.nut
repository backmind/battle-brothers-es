    }
    // context: legend_mountain_helmet_named.create.m.Description
    {
        en = "A helmet crafted from the skin and skull of a mighty rock unhold, the beast may be dead, but it continues to mend itself even after death"
        es = "Un casco elaborado con la piel y el cráneo de un poderoso trol de roca; puede que la bestia esté muerta, pero sigue regenerándose incluso después de muerta"
    }
    // context: legend_mountain_helmet_named.getTooltip.result.push().text
