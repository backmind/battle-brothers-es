        en = "[color=%positive%]10%[/color] chance to call lightning on each unit within [color=%positive%]4[/color] tiles"
        es = "[color=%positive%]10%[/color] de probabilidad de invocar un rayo sobre cada unidad a [color=%positive%]4[/color] casillas o menos"
    }
    // FILE: scripts\skills\actives\legend_cascade_skill.nut
    // context: legend_cascade_skill.create.m.Description
    {
        en = "Let loose a cascade of three striking shots on your opponent."
        es = "Suelta una cascada de tres disparos certeros sobre tu oponente."
    }
    // context: legend_cascade_skill.create.m.KilledString
    {
        en = "Pin cushioned"
        es = "Acribillado"
