        // corrige base: «golpes separados por un tercio» se lee como 'separados por un tercio'; mejor «tres golpes independientes, cada uno con un tercio del daño del arma»
        en = "Will make three separate strikes for one half of the weapon's damage each"
        es = "Realizará tres golpes independientes, cada uno con la mitad del daño del arma"
    }
    // context: legend_cascade_skill.getTooltip.ret.extend().text
    {
        en = "Increases damage by [color=%negative%]+10%[/color] of the Initiative difference between you and the target"
        es = "Aumenta el daño en un [color=%positive%]+10%[/color] de la diferencia de Iniciativa entre tú y el objetivo"
