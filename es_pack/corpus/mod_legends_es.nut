        es = "<user> ha contrarrestado a <target> durante un turno"
    }
    // FILE: scripts\skills\actives\legend_enraged_hyena_bite_skill.nut
    // context: legend_enraged_hyena_bite_skill.create.m.Description
    {
        en = "A vicious leaping bite usable up to two tiles between the hyena and its prey. The hyena leaps into the gap to bite; on a hit it instantly retreats to its original position while dragging the victim, locking them adjacent and immobilized until the hyena is struck in melee."
        es = "Un feroz mordisco con salto que puede usarse con hasta dos casillas de separación entre la hiena y su presa. La hiena salta al hueco para morder; si acierta, retrocede al instante a su posición original arrastrando a la víctima, que queda pegada a ella e inmovilizada hasta que alguien golpee a la hiena cuerpo a cuerpo."
    }
    // context: legend_enraged_hyena_bite_skill.create.m.KilledString
    {
        en = "Mauled to death"
        es = "Despedazado"
    }
    // context: legend_enraged_hyena_bite_skill.getTooltip.tooltip.push().text
