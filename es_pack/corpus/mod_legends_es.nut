    // FILE: mod_legends\!!config\character_sprites.nut
    // en = "armor"
    // en = "helmet"
    // en = "body"
    // en base_es
    // en = "surcoat"
    // en = "shaft"
    // en = "head"
    // en base_es
    // en = "injury"
