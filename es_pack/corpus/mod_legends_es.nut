        en = "An exceptional creation, this prosthetic hand has articulated joints which can be manipulated to hold objects and even give the finger in a pinch."
        es = ""
    }
    // context: legend_prosthetic_hand_item.getTooltip.result.extend().text
    {
        en = "User will no longer be blocked from using shields, two-handed weapons, throwing nets and from double gripping one-handed weapons"
        es = ""
    }
    // context: legend_prosthetic_hand_item.getTooltip.result.extend().text
    {
        en = "[color=%negative%]-10%[/color] Melee Defense when using a shield"
        es = ""
    }
    // context: legend_prosthetic_hand_item.getTooltip.result.extend().text
    {
        en = "[color=%negative%]-10%[/color] Ranged Defense when using a shield"
        es = ""
    }
    // context: legend_prosthetic_hand_item.getTooltip.result.extend().text
    {
        en = "[color=%negative%]-10%[/color] Melee Skill when NOT using a shield"
        es = ""
    }
    // context: legend_prosthetic_hand_item.getTooltip.result.extend().text
    {
        en = "[color=%negative%]-10%[/color] Ranged Skill when NOT using a shield"
        es = ""
    }
    // context: legend_prosthetic_hand_item.getTooltip.result.extend().text
    {
        en = "Can only be used if this character has a missing hand"
        es = ""
    }
