    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "Brigands have stolen the %s from his lordship. He wants it back.",
        mode = "pattern"
        en = "Brigands have stolen the [color=<c1:str>]<s1:str>[/color] from his lordship. He wants it back."
        es = "Unos bandidos le han robado [color=<c1>]<s1:t>[/color] a su señoría. Exige su devolución."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "Some dastards have stolen the famed %s!",
        mode = "pattern"
        en = "Some dastards have stolen the famed [color=<c1:str>]<s1:str>[/color]!"
        es = "¡Unos canallas han robado [color=<c1>]<s1:t>[/color], una pieza de gran fama!"
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "Follow the tracks, return the stolen %s.",
        mode = "pattern"
        en = "Follow the tracks, return the stolen [color=<c1:str>]<s1:str>[/color]."
        es = "Sigue el rastro y devuelve el objeto robado: [color=<c1>]<s1:t>[/color]."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "Thieves have made off with the %s!",
        mode = "pattern"
        en = "Thieves have made off with the [color=<c1:str>]<s1:str>[/color]!"
        es = "¡Unos ladrones se han llevado [color=<c1>]<s1:t>[/color]!"
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        en = "Devious fraudsters have stolen quite the item from a local lord."
        es = "Unos taimados estafadores le han robado a un señor local un objeto de lo más valioso."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "Some thieves have stolen the %s from a noble lord, who is frankly astonished at their audacity.",
        mode = "pattern"
        en = "Some thieves have stolen the [color=<c1:str>]<s1:str>[/color] from a noble lord, who is frankly astonished at their audacity."
        es = "Unos ladrones le han robado [color=<c1>]<s1:t>[/color] a un noble señor, francamente asombrado por su audacia."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "A local lord woke up to find his %s display case was emptier than a bard\'s promise.",
        mode = "pattern"
        en = "A local lord woke up to find his [color=<c1:str>]<s1:str>[/color] display case was emptier than a bard's promise."
        es = "Un señor local se ha despertado y ha descubierto que la vitrina de su [color=<c1>]<s1:t>[/color] estaba más vacía que la promesa de un bardo."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "A local lord discovered his cherished %s has vanished after hosting a banquet.",
        mode = "pattern"
        en = "A local lord discovered his cherished [color=<c1:str>]<s1:str>[/color] has vanished after hosting a banquet."
        es = "Tras ofrecer un banquete, un señor local ha descubierto que ha desaparecido una de sus posesiones más queridas: [color=<c1>]<s1:t>[/color]."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "A noble lord is flabbergasted to find his cherished %s missing. He wants it found.",
        mode = "pattern"
        en = "A noble lord is flabbergasted to find his cherished [color=<c1:str>]<s1:str>[/color] missing. He wants it found."
        es = "Un noble señor se ha quedado de piedra al ver que falta [color=<c1>]<s1:t>[/color], una de sus posesiones más queridas. Quiere que la encuentren."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "His wife\'s cherished %s has been stolen. This nobleman needs you to track it down or he\'ll never hear the end of it.",
        mode = "pattern"
        en = "His wife's cherished [color=<c1:str>]<s1:str>[/color] has been stolen. This nobleman needs you to track it down or he'll never hear the end of it."
        es = "Han robado [color=<c1>]<s1:t>[/color], la posesión más querida de la esposa de este noble. Necesita que des con ella o tendrá que oír reproches el resto de su vida."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "Enterprising thieves have made off with the %s, seeking to make a fortune.",
        mode = "pattern"
        en = "Enterprising thieves have made off with the [color=<c1:str>]<s1:str>[/color], seeking to make a fortune."
        es = "Unos ladrones emprendedores se han llevado [color=<c1>]<s1:t>[/color] con la esperanza de hacer fortuna."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        en = "Some scoundrels have pulled off quite the daring heist of his lordships private quarters."
        es = "Unos sinvergüenzas han dado un golpe de lo más audaz en los aposentos privados de su señoría."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        en = "A most urgent matter concerning his lordships private collection has arisen..."
        es = "Ha surgido un asunto de lo más urgente relacionado con los tesoros privados de su señoría..."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "The prized %s has been stolen from his lordship by moonlight. Track down the thief for a reward.",
        mode = "pattern"
        en = "The prized [color=<c1:str>]<s1:str>[/color] has been stolen from his lordship by moonlight. Track down the thief for a reward."
        es = "A la luz de la luna le han robado a su señoría [color=<c1>]<s1:t>[/color], una de sus piezas más preciadas. Da con el ladrón y obtendrás una recompensa."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "The %s has been stolen from under the nose of this lordship. Venture forth to reclaim it.",
        mode = "pattern"
        en = "The [color=<c1:str>]<s1:str>[/color] has been stolen from under the nose of this lordship. Venture forth to reclaim it."
        es = "Han robado [color=<c1>]<s1:t>[/color] en las mismísimas narices de su señoría. Sal en busca de lo robado."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "A noble lord has what he terms a \'fetch\' quest for you to retrieve his missing %s.",
        mode = "pattern"
        en = "A noble lord has what he terms a 'fetch' quest for you to retrieve his missing [color=<c1:str>]<s1:str>[/color]."
        es = "Un noble señor tiene para ti lo que él llama una misión de 'tráeme esto': recuperar [color=<c1>]<s1:t>[/color], que ha desaparecido."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "Find the thieves, kill them if you want, just bring back the %s.",
        mode = "pattern"
        en = "Find the thieves, kill them if you want, just bring back the [color=<c1:str>]<s1:str>[/color]."
        es = "Encuentra a los ladrones, mátalos si quieres, pero trae de vuelta [color=<c1>]<s1:t>[/color]."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "Reclaim the stolen %s before it falls into the wrong hands.",
        mode = "pattern"
        en = "Reclaim the stolen [color=<c1:str>]<s1:str>[/color] before it falls into the wrong hands."
        es = "Recupera lo robado, [color=<c1>]<s1:t>[/color], antes de que caiga en malas manos."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        en = "Hunt down some thieves to claim the reward and gratitude of the local ruler."
        es = "Da caza a unos ladrones para ganarte la recompensa y la gratitud del gobernante local."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "Recover the stolen %s for his lordship and you may earn his gratitude.",
        mode = "pattern"
        en = "Recover the stolen [color=<c1:str>]<s1:str>[/color] for his lordship and you may earn his gratitude."
        es = "Recupera lo que le robaron a su señoría, [color=<c1>]<s1:t>[/color], y quizá te ganes su gratitud."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        en = "Track down some local thieves and kill them all to set an example to others."
        es = "Da con unos ladrones de la zona y mátalos a todos para que sirva de escarmiento a otros."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        en = "Stealing from nobility is a crime punishable by death. Today you are the appointed executioner."
        es = "Robar a la nobleza es un crimen que se castiga con la muerte. Hoy tú eres el verdugo designado."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        en = "Given his dreadful reputation, you are amazed anyone had the stones to steal from his lordship in the first place."
        es = "Dada su terrible reputación, te asombra que alguien haya tenido los huevos de robarle a su señoría."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        en = "In the name of our lordship, pursue the thieves and reclaim what is rightfully his."
        es = "En nombre de nuestro señor, persigue a los ladrones y recupera lo que le pertenece por derecho."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "His lordship\'s honor is at stake! Hunt down the thieves and return the stolen %s swiftly.",
        mode = "pattern"
        en = "His lordship's honor is at stake! Hunt down the thieves and return the stolen [color=<c1:str>]<s1:str>[/color] swiftly."
        es = "¡El honor de su señoría está en juego! Da caza a los ladrones y devuelve lo robado, [color=<c1>]<s1:t>[/color], sin demora."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "Pursue the thieves and recover the stolen %s with utmost haste. Their lives matter not.",
        mode = "pattern"
        en = "Pursue the thieves and recover the stolen [color=<c1:str>]<s1:str>[/color] with utmost haste. Their lives matter not."
        es = "Persigue a los ladrones y recupera lo robado, [color=<c1>]<s1:t>[/color], con la máxima urgencia. Sus vidas no importan."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "Pursue the footpads and bring back the missing %s directly to his lordship. No-one else.",
        mode = "pattern"
        en = "Pursue the footpads and bring back the missing [color=<c1:str>]<s1:str>[/color] directly to his lordship. No-one else."
        es = "Persigue a los salteadores y entrégale [color=<c1>]<s1:t>[/color] directamente a su señoría. A nadie más."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "Track down the thieves and ensure the stolen %s is returned to its rightful owner.",
        mode = "pattern"
        en = "Track down the thieves and ensure the stolen [color=<c1:str>]<s1:str>[/color] is returned to its rightful owner."
        es = "Da con los ladrones y asegúrate de que lo robado, [color=<c1>]<s1:t>[/color], vuelva a manos de su legítimo dueño."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "Seek out the knaves and restore the stolen %s to the noble lord\'s estate.",
        mode = "pattern"
        en = "Seek out the knaves and restore the stolen [color=<c1:str>]<s1:str>[/color] to the noble lord's estate."
        es = "Busca a los bribones y devuelve lo robado, [color=<c1>]<s1:t>[/color], a la hacienda del noble señor."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        en = "In service to the local ruler, recover a stolen artifact and kill the thieves responsible."
        es = "Al servicio del gobernante local, recupera un artefacto robado y mata a los ladrones responsables."
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "The %s has been stolen from his lordships chambers!",
        mode = "pattern"
        en = "The [color=<c1:str>]<s1:str>[/color] has been stolen from his lordships chambers!"
        es = "¡Han robado [color=<c1>]<s1:t>[/color] de los aposentos de su señoría!"
    }
    // context: return_item_contract.o.create.m.DescriptionTemplates
    {
        // "The local ruler has taken the theft of his %s rather badly. Find and kill everyone involved.",
        mode = "pattern"
        en = "The local ruler has taken the theft of his [color=<c1:str>]<s1:str>[/color] rather badly. Find and kill everyone involved."
        es = "El gobernante local se ha tomado bastante mal el robo de su [color=<c1>]<s1:t>[/color]. Encuentra y mata a todos los implicados."
    }
    // context: return_item_contract.o.createScreens.s.Text
    {
        // corrige base: "un despreciable robo" por "an audacious act of thievery"; pasa a "un robo de una audacia inaudita".
        // corrige base: la segunda variante añadía "encima de su escritorio" y "Finalmente", que el inglés no tiene, y perdía "smart" ("mercenario listo").
        // corrige base: errata "devuelveme" por "devuélveme".
        // corrige base: "agonizando en el barro" por "dead in the mud"; pasa a "muertos en el barro".
        en = "[img]gfx/ui/events/event_20.png[/img]{%employer% restlessly walks back and forth while explaining what troubles %them_employer%.%SPEECH_ON%There has been an audacious act of thievery! The despicable brigands stole my %itemLower% which is of immeasurable value to me. I implore you to hunt down those thieves and return that item to me.%SPEECH_OFF%%They_employer% lowers %their_employer% voice to an insisting tone.%SPEECH_ON%Not only will you get paid handsomely, but you would also set the worried minds of the good people of %townname% to rest!%SPEECH_OFF% | %employer%'s reading one of many scrolls. %They_employer% angrily tosses it onto a pile of others.%SPEECH_ON%The people of %townname% are rightfully furious. Do you know a brigand, possibly in league with other vagabonds, managed to steal my %itemLower% from us? That artifact is of immeasurable value to me! And... to the people, of course.%SPEECH_OFF%You shrug.%SPEECH_ON%And you want me to get it back for you?%SPEECH_OFF%The %person_employer% points a finger.%SPEECH_ON%Precisely, smart sellsword! That is exactly what I want you to do. Follow the footprints of thievery and return to me the item which I... the town, rightfully owns!%SPEECH_OFF% | %employer%'s turning an apple in hand. %They_employer% seems frustrated with it, almost as if %they_employer% wishes it were something else like a valuable trinket or perhaps just a tastier fruit.%SPEECH_ON%Have you ever lost something you loved?%SPEECH_OFF%You shrug and answer.%SPEECH_ON%There was this girl...%SPEECH_OFF%The %person_employer% shakes %their_employer% head.%SPEECH_ON%No, not some woman. More important. Because I have! Thieves stole my %itemLower%. How they managed to do get beyond my guards is, well, beyond me. But I know if I set you on them I'll be having what is rightfully mine back where it belongs. Isn't that right? Or have I been mislead as to the quality of your services?%SPEECH_OFF% | A dog is snoring at the feet of %employer%. %They_employer% leans forward to gently pet the hound behind its ears.%SPEECH_ON%I hear you have a nose for finding people, sellsword. For... solving problems.%SPEECH_OFF%You nod. It is true, after all.%SPEECH_ON%Good... good... I have a task for you. A simple one. Something of great value to me has been stolen, my %itemLower%. I need you to track down those who stole it, kill them, obviously, and then bring back the item.%SPEECH_OFF% | A bird is perched on %employer%'s window. The %person_employer%, seated, points at it.%SPEECH_ON%I wonder if that's how they got in. The brigands, I mean. I think they must've snuck through a window and then right back out. That's how they got away with my %itemLower%.%SPEECH_OFF%The %person_employer% slowly rises and stalks across the room. %They_employer% crouches, about ready to pounce on the bird, but the creature scatters before the %person_employer% can so much as flinch.%SPEECH_ON%Damn.%SPEECH_OFF%%They_employer% returns to %their_employer% seat, wiping %their_employer% hands as if %they_employer%'d worked up a sweat during %their_employer% attempted avian ambush.%SPEECH_ON%My task is simple, sellsword. Bring my property back to me. Kill the brigands, too, if you wouldn't mind.%SPEECH_OFF% | Dust covers %employer%'s table, but there is a spot oddly cleaner than the rest. %They_employer% gestures to it.%SPEECH_ON%That's where my %itemLower% used to sit. If you couldn't tell, it's gone.%SPEECH_OFF%You nod. It does appear to be missing.%SPEECH_ON%The thieves who took it should be easy to track down. They're good thinkers in the night, those brigands, but they make mistakes aplenty during the day. Footprints, crowns ill-spent... you should be able to track them down with ease.%SPEECH_OFF%%They_employer% looks at you with a stern eye.%SPEECH_ON%Do you understand, mercenary? I want you to get my property back. I want it placed right where it belongs. And... I want those thieves dead in the mud.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_20.png[/img]{%employer% camina inquiet%o_employer% de un lado a otro mientras explica lo que le preocupa.%SPEECH_ON%¡Se ha cometido un robo de una audacia inaudita! Esos despreciables bandidos han robado mi %itemLower%, que tiene un valor incalculable para mí. Te ruego que persigas a esos ladrones y me devuelvas ese objeto.%SPEECH_OFF%Baja la voz y adopta un tono insistente.%SPEECH_ON%¡No solo se te pagará generosamente, sino que también tranquilizarás a la buena gente de %townname%!%SPEECH_OFF% | %employer% está leyendo uno de tantos pergaminos. Lo arroja con rabia sobre un montón de otros.%SPEECH_ON%Los habitantes de %townname% están furiosos, y con razón. ¿Sabes que un bandido, posiblemente compinchado con otros vagabundos, logró robarnos mi %itemLower%? ¡Ese artefacto tiene un valor incalculable para mí! Y... para la gente, por supuesto.%SPEECH_OFF%Te encoges de hombros.%SPEECH_ON%¿Y quieres que lo recupere por ti?%SPEECH_OFF%Te señala con el dedo.%SPEECH_ON%¡Exacto, mercenario listo! Eso es precisamente lo que quiero que hagas. ¡Sigue las huellas de los ladrones y devuélveme el objeto que yo... que el pueblo posee legítimamente!%SPEECH_OFF% | %employer% le da vueltas a una manzana en la mano. Parece frustrad%o_employer% con ella, casi como si deseara que fuera otra cosa, como una baratija valiosa o quizá simplemente una fruta más sabrosa.%SPEECH_ON%¿Alguna vez has perdido algo que amabas?%SPEECH_OFF%Te encoges de hombros y respondes.%SPEECH_ON%Hubo una chica...%SPEECH_OFF%Niega con la cabeza.%SPEECH_ON%No, no me refiero a una mujer. Algo más importante. ¡Porque yo sí! Unos ladrones se llevaron mi %itemLower%. Cómo lograron burlar a mis guardias es, bueno, un misterio para mí. Pero sé que si te mando tras ellos, tendré de vuelta lo que legítimamente me pertenece. ¿No es así? ¿O me han engañado sobre la calidad de tus servicios?%SPEECH_OFF% | Un perro duerme roncando a los pies de %employer%. Se inclina hacia adelante para acariciar suavemente al can detrás de las orejas.%SPEECH_ON%He oído decir que tienes buen olfato para encontrar personas, mercenario. Para... resolver problemas.%SPEECH_OFF%Asientes. Es cierto, después de todo.%SPEECH_ON%Bien... bien... Tengo una tarea para ti. Una tarea sencilla. Me han robado algo de gran valor para mí, mi %itemLower%. Necesito que encuentres a los que lo robaron, los mates, obviamente, y luego me traigas de vuelta el objeto.%SPEECH_OFF% | Hay un pájaro posado en la ventana de %employer%. Sentad%o_employer%, lo señala.%SPEECH_ON%Me pregunto si fue así como entraron. Los bandidos, quiero decir. Creo que debieron de colarse por una ventana y salir de nuevo por ella. Así fue como se llevaron mi %itemLower%.%SPEECH_OFF%Se levanta despacio y cruza la habitación al acecho. Se agacha, a punto de abalanzarse sobre el pájaro, pero el animal sale volando antes de que pueda siquiera pestañear.%SPEECH_ON%Maldición.%SPEECH_OFF%Regresa a su asiento, sacudiéndose las manos como si hubiera sudado durante su intento de emboscada aviar.%SPEECH_ON%Mi tarea es simple, mercenario. Tráeme de vuelta mi propiedad. Y mata también a los bandidos, si no te importa.%SPEECH_OFF% | El polvo cubre la mesa de %employer%, pero hay un lugar extrañamente más limpio que el resto. Lo señala con un gesto.%SPEECH_ON%Ahí es donde solía estar mi %itemLower%. Por si no te habías dado cuenta, ha desaparecido.%SPEECH_OFF%Asientes. Sí que parece que falta.%SPEECH_ON%Los ladrones que se lo llevaron deberían ser fáciles de rastrear. Esos bandidos piensan bien de noche, pero cometen errores a montones durante el día. Huellas, coronas mal gastadas... deberías poder dar con ellos sin problema.%SPEECH_OFF%Te mira con severidad.%SPEECH_ON%¿Lo entiendes, mercenario? Quiero que recuperes mi propiedad. Quiero que vuelva a estar justo donde le corresponde. Y... quiero a esos ladrones muertos en el barro.%SPEECH_OFF%}"
    }
    // en = "I know a good deal when I see one. Hand over the crowns."
    // en base_es
    // en = "NeverTrustAMercenary"
    // context: return_item_contract.o.createScreens.s.Options.Text
    {
        en = "We're paid %reward_completion% to return it, and that's what we'll do."
        es = "Nos pagan %reward_completion% por devolverlo, y eso es lo que haremos."
    }
    // context: return_item_contract.o.createScreens.s.Text
    {
        // corrige base: "anchas mangas" por "long sleeves" (largas), y "a él también", que el inglés no tiene.
        en = "[img]gfx/ui/events/event_76.png[/img]{You clean the blood off your sword and then go to retrieve the item. As you bend over to pick it up, you spot a man watching you in the distance. He comes forth, his two hands totemed together with long sleeves.%SPEECH_ON%I see you've killed my benefactor's men.%SPEECH_OFF%Sheathing your sword, you nod at the man. He continues.%SPEECH_ON%My benefactor paid good money for that artifact. It appears those he paid are no longer owed, so maybe I can speak to you directly. I will give you %bribe% crowns for the item.%SPEECH_OFF%That... is a good amount of money. %employer%, however, will not be happy if you decide to accept... | After the battle, a man emerges from a tree line, clapping his hands together.%SPEECH_ON%I paid those men a great deal of crowns, but it appears I should have paid you. And now that all these skeevy brigands are dead, I can!%SPEECH_OFF%You tell the man to get to the point before you run him through with a sword. He gestures toward the artifact.%SPEECH_ON%I'll pay you %bribe% crowns (originally %reward_completion% crowns) for the item. It was what was originally owed to these thieves, plus a little more. What do you say?%SPEECH_OFF%%employer% won't take kindly to your betrayal, but that is a good bit of money... | The battle over, you pick up the %itemLower% and look it over. Was this really worth the lives of so many people?%SPEECH_ON%I know what you're thinking, sellsword.%SPEECH_OFF%The voice breaks in. You draw your sword and aim it at a stranger who has seemingly appeared from nowhere.%SPEECH_ON%You're thinking, what if someone paid good money to steal that there artifact? What if that someone would pay me a good deal of money? Perhaps... more than the man who paid you to retrieve it in the first place.%SPEECH_OFF%You lower your weapon and nod.%SPEECH_ON%An interesting thought.%SPEECH_OFF%The man smiles.%SPEECH_ON%%bribe% crowns (originally %reward_completion% crowns). That's how much I'll give you for it. That was the thieves' share plus extra. A more than fair deal. Of course, your employer will be most unhappy, but... well, that's not my choice to make.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_76.png[/img]{Limpias la sangre de tu espada y te acercas a recuperar el objeto. Mientras te inclinas para recogerlo, ves a un hombre que te observa a lo lejos. Se acerca, con las manos unidas dentro de sus largas mangas.%SPEECH_ON%Veo que has matado a los hombres de mi benefactor.%SPEECH_OFF%Mientras envainas la espada, le haces un gesto con la cabeza. Él continúa.%SPEECH_ON%Mi benefactor pagó una buena suma por ese artefacto. Parece que a quienes pagó ya no se les debe nada, así que tal vez pueda tratar directamente contigo. Te daré %bribe% coronas por el objeto.%SPEECH_OFF%Eso... es una buena suma de dinero. Sin embargo, a %employer% no le hará ninguna gracia que aceptes... | Después de la batalla, un hombre sale de entre los árboles dando palmadas.%SPEECH_ON%Pagué a esos hombres un montón de coronas, pero parece que debería haberte pagado a ti. ¡Y ahora que todos estos bandidos rastreros están muertos, puedo hacerlo!%SPEECH_OFF%Le dices que vaya al grano antes de que lo atravieses con la espada. Señala el artefacto.%SPEECH_ON%Te pagaré %bribe% coronas (la recompensa original era de %reward_completion% coronas) por el objeto. Es lo que se les debía en un principio a estos ladrones, y algo más. ¿Qué me dices?%SPEECH_OFF%A %employer% no le sentará nada bien tu traición, pero es una buena suma de dinero... | Terminada la batalla, recoges %itemLower% y lo examinas. ¿De verdad valía esto la vida de tanta gente?%SPEECH_ON%Sé lo que estás pensando, mercenario.%SPEECH_OFF%La voz te interrumpe. Desenvainas la espada y apuntas a un extraño que parece haber aparecido de la nada.%SPEECH_ON%Estás pensando: ¿y si alguien pagó una buena suma por robar ese artefacto? ¿Y si ese alguien me pagara a mí una buena cantidad de dinero? Quizá... más de lo que te pagó quien te encargó recuperarlo.%SPEECH_OFF%Bajas el arma y asientes.%SPEECH_ON%Una idea interesante.%SPEECH_OFF%El hombre sonríe.%SPEECH_ON%%bribe% coronas (la recompensa original era de %reward_completion% coronas). Eso es lo que te daré por ello. Esa era la parte de los ladrones, y algo más. Un trato más que justo. Por supuesto, a quien te contrató no le hará ninguna gracia, pero... bueno, esa decisión no me corresponde a mí.%SPEECH_OFF%}"
    }
    // context: return_item_contract.o.createScreens.s.Text
    {
        // corrige base: la primera variante añadía "entre los cadáveres" y "con facilidad" (son de la cuarta) y perdía "from the wasted clutches of your enemies".
        en = "[img]gfx/ui/events/event_22.png[/img]{The battle over, you retrieve the %itemLower% from the wasted clutches of your enemies and prepare to return to %employer%. %They_employer% will surely be happy to see of your success! | Those who stole the %itemLower% are dead, and thankfully you were able to find the item itself. %employer% will be most pleased with your work here. | Well, you found those responsible for stealing the %itemLower% and put them to the sword. Now you just need to put the %itemLower% back into %employer%'s hands and get your reward! | The battle is done and the %itemLower% was easy to find amongst the corpses of your enemies. You should probably return it to %employer% for your just reward!}"
        es = "[img]gfx/ui/events/event_22.png[/img]{Terminada la batalla, recuperas %itemLower% de las garras sin vida de tus enemigos y te preparas para volver con %employer%. ¡Seguro que estará content%o_employer% de ver tu éxito! | Quienes robaron %itemLower% han muerto y, por suerte, has podido encontrar el objeto en sí. %employer% estará muy complacid%o_employer% con tu trabajo. | Bien, encontraste a los responsables del robo de %itemLower% y los pasaste por la espada. ¡Ahora solo necesitas devolver %itemLower% a manos de %employer% y cobrar tu recompensa! | La batalla ha terminado y %itemLower% fue fácil de encontrar entre los cadáveres de tus enemigos. ¡Probablemente deberías devolverlo a %employer% para recibir tu merecida recompensa!}"
    }
    // context: return_item_contract.o.createScreens.s.Text
    {
        // corrige base: "¡Estaremos siempre en deuda contigo!" rompía el eco con "Nuestra... gratitud" ("You have our gratitude!"), y "Ejem..." es un añadido que el inglés no tiene.
        // corrige base: erratas de concordancia: "Lo lanza" (la bolsa) y "una bolsa lleno".
        // corrige base: "¿me traes la noticia de tu éxito?" perdía el juego "sellsword, will you sell me word"; pasa a "¿me vendes la noticia de tu éxito?".
        en = "[img]gfx/ui/events/event_04.png[/img]{%employer% takes the %itemLower% from you, hugging it close as though %they_employer%'d retrieved a lost child. %Their_employer% eyes get a little teary just looking at %their_employer% artifact.%SPEECH_ON%Thank you, sellsword. This means a lot to me... I mean, uh, the town. You have our gratitude!%SPEECH_OFF%%They_employer% pauses as you stare at %them_employer%. %Their_employer% eyes bounce to a corner of the room.%SPEECH_ON%Our... gratitude, sellsword...%SPEECH_OFF%A large wooden chest is opened by a guard. You count the crowns and go. | When you return to %employer%, %they_employer% is playing with a bird in a cage.%SPEECH_ON%Ah, the sellsword returns... and?%SPEECH_OFF%You hold up the artifact and then set it on %their_employer% desk. %They_employer% takes it, turns it, nods, then puts it away.%SPEECH_ON%Excellent. And for your troubles...%SPEECH_OFF%%They_employer% waves %their_employer% hand to a wooden chest filled with crowns. | %employer%'s resting %their_employer% legs on two dogs, each one passed out atop the other.%SPEECH_ON%These beasts could rip my throat out, yet... look at them. How does that happen? I didn't even train them. Someone else did. I'm a stranger to them yet there they are.%SPEECH_OFF%You place the artifact on the %person_employer%'s table and slide it across. %They_employer% leans forward, takes it, then places it under %their_employer% desk. When %their_employer% hand returns, %they're_employer% got a satchel in hand. %They_employer% tosses it over.%SPEECH_ON%As promised. Good work, sellsword.%SPEECH_OFF% | When you enter %employer%'s room, there are a host of guards surrounding %them_employer%. For a second, you think you've stumbled upon a coup, but the men clear out, leaving behind dice and cards. %employer% waves you in.%SPEECH_ON%Come, come. I just lost a good deal of crowns, sellsword. Perhaps you've brought something to help ease my pains...?%SPEECH_OFF%You take out the %itemLower% and hold it in your hand. Rather gingerly, the %person_employer% takes it.%SPEECH_ON%Good... very good... your pay, of course, is here.%SPEECH_OFF%%They_employer% hands over a satchel of crowns before turning around in %their_employer% chair. %They_employer% seems too consumed by the artifact to say anything else. | %employer% grins as you enter.%SPEECH_ON%Sellsword, sellsword, will you sell me word of your success?%SPEECH_OFF%You take out the artifact and place it on %their_employer% table.%SPEECH_ON%Sure.%SPEECH_OFF%The %person_employer% jolts forward in his chair and takes the item away. %They_employer% turns back to you, calming %themselves_employer% returning %their_employer% composure.%SPEECH_ON%Good. You did good. Very good. %reward_completion% crowns, as promised.%SPEECH_OFF%%They_employer% hands over a sack of coins.}"
        es = "[img]gfx/ui/events/event_04.png[/img]{%employer% toma %itemLower% de tus manos y lo abraza como si hubiera recuperado a un niño perdido. Los ojos se le humedecen un poco solo de mirar su artefacto.%SPEECH_ON%Gracias, mercenario. Esto significa mucho para mí... quiero decir, eh, para el pueblo. ¡Tienes nuestra gratitud!%SPEECH_OFF%Hace una pausa mientras %lo_employer% miras fijamente. Desvía la mirada hacia un rincón de la habitación.%SPEECH_ON%Nuestra... gratitud, mercenario...%SPEECH_OFF%Un guardia abre un gran cofre de madera. Cuentas las coronas y te marchas. | Cuando vuelves con %employer%, está jugando con un pájaro enjaulado.%SPEECH_ON%Ah, el mercenario ha vuelto... ¿y bien?%SPEECH_OFF%Levantas el artefacto y luego lo dejas sobre su escritorio. Lo toma, le da vueltas, asiente y luego lo guarda.%SPEECH_ON%Excelente. Y por las molestias...%SPEECH_OFF%Señala con la mano un cofre de madera lleno de coronas. | %employer% descansa las piernas sobre dos perros, dormidos uno encima del otro.%SPEECH_ON%Estas bestias podrían arrancarme la garganta y, sin embargo... míralas. ¿Cómo puede ser? Ni siquiera las entrené yo. Lo hizo otro. Para ellas soy %un_employer% desconocid%o_employer% y, aun así, ahí están.%SPEECH_OFF%Dejas el artefacto sobre su mesa y lo deslizas hacia %el_employer%. Se inclina hacia delante, lo toma y lo guarda debajo de su escritorio. Cuando vuelve a sacar la mano, sostiene una bolsa. Te la lanza.%SPEECH_ON%Lo prometido. Buen trabajo, mercenario.%SPEECH_OFF% | Cuando entras en la habitación de %employer%, hay un grupo de guardias rodeándo%lo_employer%. Por un segundo crees haber dado con un golpe de estado, pero los hombres se retiran y dejan atrás dados y cartas. %employer% te hace un gesto para que pases.%SPEECH_ON%Ven, ven. Acabo de perder un buen montón de coronas, mercenario. ¿Quizás has traído algo que alivie mis penas...?%SPEECH_OFF%Sacas %itemLower% y lo sostienes en la mano. Con bastante delicadeza, %employer% lo toma.%SPEECH_ON%Bien... muy bien... tu pago, por supuesto, está aquí.%SPEECH_OFF%Te entrega una bolsa llena de coronas antes de girarse en su silla. Parece demasiado absort%o_employer% en el artefacto como para decir nada más. | %employer% sonríe al verte entrar.%SPEECH_ON%Mercenario, mercenario, ¿me vendes la noticia de tu éxito?%SPEECH_OFF%Sacas el artefacto y lo dejas sobre su mesa.%SPEECH_ON%Claro.%SPEECH_OFF%Se echa bruscamente hacia delante en la silla y se lleva el objeto. Luego se vuelve hacia ti, calmándose y recuperando la compostura.%SPEECH_ON%Bien. Lo has hecho bien. Perfecto. %reward_completion% coronas, como te prometí.%SPEECH_OFF%Te entrega un saco de monedas.}"
    }
    // en = "[img]gfx/ui/events/event_75.png[/img]\x7bYou lower yourself to the earth, letting some dirt filter through your fingers. But it is only dirt - there are no footprints that have crossed its path. In fact, you haven't seen any footprints in a good while. %randombrother% joins you, crouching low and shrugging.%SPEECH_ON%Sir, I think we lost 'em.%SPEECH_OFF%You nod. %employer% won't be happy about this, but it is what it is. | You've been following the trail of the stolen %itemLower% for a good while now, but the leads have dried up. The commoners you pass know nothing, and the earth shows no footprints with which to track. For all intents and purposes, the %itemLower% is gone. %employer% will not be pleased. | A footprint left long enough is soon stepped on by another. And another. And another. You spent so long catching up to the thieves who stole the %itemLower% that the circuitry of the world, ever busy, has covered their tracks. You've no hope of finding them now and %employer% will be most displeased. | The tracks of the %itemLower%'s thieves have gone dry. The last set of footprints you followed took you to a homestead, and they didn't look like the thieving sort, nor did they know of any such fellows. %employer% won't be happy about the loss of his goods, but there's little you can do here now.\x7d"
    // en base_es
    // FILE: mod_legends\hooks\contracts\contracts\roaming_beasts_contract.nut
    // context: roaming_beasts_contract.o.create.m.Name
    {
        en = "Tooth and Tail"
        es = "Diente y cola"
    }
    // context: roaming_beasts_contract.o.create.m.DescriptionTemplates
    {
        // "Fell beasts have been preying on the citizens of %s. Folk are afraid to leave their homes.",
        mode = "pattern"
        en = "Fell beasts have been preying on the citizens of [color=<c1:str>]<s1:str>[/color]. Folk are afraid to leave their homes."
        es = "Unas bestias terribles se están cebando con los habitantes de [color=<c1>]<s1>[/color]. La gente tiene miedo de salir de casa."
    }
    // context: roaming_beasts_contract.o.create.m.DescriptionTemplates
    {
        // "Roaming beasts prowl the outskirts of %s, attacking travelers and livestock.",
        mode = "pattern"
        en = "Roaming beasts prowl the outskirts of [color=<c1:str>]<s1:str>[/color], attacking travelers and livestock."
        es = "Hay bestias errantes merodeando por las afueras de [color=<c1>]<s1>[/color] que atacan a viajeros y ganado."
    }
    // context: roaming_beasts_contract.o.create.m.DescriptionTemplates
    {
        // "Outlandish tales are being told of fell creatures attacking folk around %s.",
        mode = "pattern"
        en = "Outlandish tales are being told of fell creatures attacking folk around [color=<c1:str>]<s1:str>[/color]."
        es = "Corren historias extrañas sobre criaturas terribles que atacan a la gente en los alrededores de [color=<c1>]<s1>[/color]."
    }
    // context: roaming_beasts_contract.o.create.m.DescriptionTemplates
    {
        // "Rumor is that weird beastlings have been devouring livestock and even people around %s.",
        mode = "pattern"
        en = "Rumor is that weird beastlings have been devouring livestock and even people around [color=<c1:str>]<s1:str>[/color]."
        es = "Se rumorea que unas extrañas bestezuelas han estado devorando ganado e incluso personas en los alrededores de [color=<c1>]<s1>[/color]."
    }
    // context: roaming_beasts_contract.o.create.m.DescriptionTemplates
    {
        // "The gnawed bones of deceased travelers are starting to pile up around %s.",
        mode = "pattern"
        en = "The gnawed bones of deceased travelers are starting to pile up around [color=<c1:str>]<s1:str>[/color]."
        es = "Los huesos roídos de viajeros muertos empiezan a amontonarse en los alrededores de [color=<c1>]<s1>[/color]."
    }
    // context: roaming_beasts_contract.o.create.m.DescriptionTemplates
    {
        en = "A cursed pack of fell beasts appear to have developed a taste for human flesh."
        es = "Una manada maldita de bestias terribles parece haberle tomado el gusto a la carne humana."
    }
    // context: roaming_beasts_contract.o.create.m.DescriptionTemplates
    {
        // "%s seeks mercenaries and beastmasters to confront the wild threats in its lands.",
        mode = "pattern"
        en = "[color=<c1:str>]<s1:str>[/color] seeks mercenaries and beastmasters to confront the wild threats in its lands."
        es = "[color=<c1>]<s1>[/color] busca mercenarios y domadores de bestias para hacer frente a las amenazas salvajes de sus tierras."
    }
    // context: roaming_beasts_contract.o.create.m.DescriptionTemplates
    {
        en = "Some kind of unnatural beasts have been haunting the local countryside."
        es = "Unas bestias antinaturales de algún tipo han estado acechando la campiña de la zona."
    }
    // context: roaming_beasts_contract.o.create.m.DescriptionTemplates
    {
        // "Ferocious beasts have reportedly been attacking folk on the road to %s.",
        mode = "pattern"
        en = "Ferocious beasts have reportedly been attacking folk on the road to [color=<c1:str>]<s1:str>[/color]."
        es = "Según cuentan, unas bestias feroces han estado atacando a la gente en el camino a [color=<c1>]<s1>[/color]."
    }
    // context: roaming_beasts_contract.o.create.m.DescriptionTemplates
    {
        en = "Being devoured by a pack of savage beasts was not high on your list of things to do today."
        es = "Que te devorara una manada de bestias salvajes no ocupaba un lugar destacado en tu lista de cosas por hacer hoy."
    }
    // en = "A pack of ferocious direwolves on the hunt for prey."
    // en base_es
    // en = "Nachzehrers"
    // en base_es
    // en = "A flock of scavenging nachzehrers."
    // en base_es
    // en = "Webknechts"
    // en base_es
    // en = "A swarm of webknechts skittering about."
    // en base_es
    // context: roaming_beasts_contract.o.createStates.s.update.Contract.setScreen()
    // en = "Success5"
    // identificador de pantalla
    // context: roaming_beasts_contract.o.createScreens.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «Please, sirs» y «nice to see ya, sirs» van en plural; la 1.0 ponía «señor» y «verte».
        // corrige base: «thrusting his hips at you» quedaba rebajado en «te muestra sus caderas».
        // corrige base: «rip off her clothes and wobble her shapes» se rebajaba a «se ponga a bailar también como una loca».
        // corrige base: «look the part of a hired hand»: la 1.0 añadía «competente», que el inglés no tiene.
        // corrige base: «tipping his hat up out of his eyes» es echarse el sombrero hacia atrás, no «protegiendo sus ojos con su sombrero».
        // corrige base: «Can't say I have, no» no es «No puedo decirte, no».
        // corrige base: la 1.0 omitía «got taken» (se los llevaron).
        // corrige base: «Barnacled up in the trees» no es «cubiertos de líquenes».
        // corrige base: «He pauses» estaba como «Pausa»; es «Hace una pausa».
        // corrige base: «Not naturally, but the kid sure likes his mud»: la 1.0 perdía que el castaño del pelo es barro.
        // corrige base: la 1.0 omitía «I think he's mine» y rebajaba «Well shite» a «maldición».
        en = "[img]gfx/ui/events/event_60.png[/img]{You stumble across a corpse in the grass. Ordinarily, the dead aren't that much of a surprise, there are people everywhere so it's only a matter of time until you see a body here and there. Except this one has huge gash marks down the back and its organs missing.\n\n%helpfulbrother% walks up.%SPEECH_ON%The organs are gone cause of wolves, or maybe even rabbits. What, you ain't ever heard of a really hungry rabbit?%SPEECH_OFF%%They_helpful% spits and chews on a fingernail.%SPEECH_ON%Anyhow, the markings, that ain't the work of no rabbit or hound or whatever. That's something... bigger... more dangerous.%SPEECH_OFF%You thank the %person_helpful% for his astute observations and tell him to rejoin the ranks. | A peasant comes up to you with his clothes in shredded rags about him. With fair modesty, he's got his hands covering his groin.%SPEECH_ON%Please, sirs, come take a look at this... horror.%SPEECH_OFF%When you question what he's talking about, he throws his hands up, thrusting his hips at you. He turns afoot like a puppet spun about and takes off running, hooting and hollering. A woman walks up to you in the wake of the man's madness. She's got her hands against her bosom.%SPEECH_ON%He's gone mad on account of his brother being torn apart by the beasts.%SPEECH_OFF%You turn to her, half-expecting the lady to rip off her clothes and wobble her shapes in whatever direction she pleases. Instead, she simply stares at you.%SPEECH_ON%I know %townname% has hired some men to take care of these beasts and you certainly look the part of a hired hand. Please, sir, protect us from these evils... and the evils that they spread...%SPEECH_OFF% | You come across an eviscerated cow with half of it cast atop a fenceline and the other half scattered a good distance across the grass, about as far apart as its entrails would allow. An attachment of gore if there ever was one.\n\nA farmer approaches, tipping his hat up out of his eyes.%SPEECH_ON%Beasts done that. I didn't see them, if you was wondering, but I did hear this goatfark of a fiasco before you. Hearing it was good enough for me to stay low and out of sight. Please, if you are here to find those creatures, do so quickly because I can't afford to lose anymore livestock like this.%SPEECH_OFF% | A peasant hacking firewood straightens up before you.%SPEECH_ON%By the gods it is nice to see ya, sirs. I thought I heard word of some sellswords stomping about looking for the beasts terrorizing these parts.%SPEECH_OFF%You ask if he's seen anything that might help. He pitches his hands over the pommel of his axe.%SPEECH_ON%Can't say I have, no. But I've heard some things. I know a man and woman not far from here got taken. Well, they disappeared together. Word has it they dead in the woods now. Barnacled up in the trees, hanging loosely by the gut, ya know? Or, wait, maybe they just gone off on their feetsies to shack up together! Hell... hell! That gal hated her father and the kid was just a nobody with a flair of good looks and a charming tongue. Yeah, that makes sense.%SPEECH_OFF%He pauses and then glances at you.%SPEECH_ON%Anyhow, I'm certain those monsters are afoot. Keep an eye out, sellsword.%SPEECH_OFF% | A woman runs out of her hut to stop you. Almost out of breath, she asks if you've seen a boy. You shake your head no. She puts her hand out.%SPEECH_ON%He's about yeigh big. Mop of brown hair. Not naturally, but the kid sure likes his mud. When he smiles his teeth are like the stars, bright and scattered.%SPEECH_OFF%You shake your head no a second time.%SPEECH_ON%He can throw a good rock. Throws it far. I told him to not show his strength when the lord's men were 'round, lest they take him into the army.%SPEECH_OFF%She huffs, blowing a loose strand of hair out of her eyes.%SPEECH_ON%Well shite, anyway, if you see him, let me know. I think he's mine. Also, beware the dark. Beasts be bushwhacking folks around here.%SPEECH_OFF%Before you can say anything, the woman picks up her long clothes and trundles back to her hut. | You come across a man kneeling over a thoroughly destroyed dog. You take a knee next to him.%SPEECH_ON%Did the beasts do this?%SPEECH_OFF%He shakes his head no.%SPEECH_ON%Hell, I did this. Finally. Damned thing ain't gonna keep me up anymore.%SPEECH_OFF%Just then, a hut across the way opens up and a man sprints out of it screaming.%SPEECH_ON%Is that my damned dog you sonuvabitch?%SPEECH_OFF%The dogkiller quickly stands up.%SPEECH_ON%The beasts! They visited again last night!%SPEECH_OFF%You quietly leave the dispute where the dog lies.}"
        es = "[img]gfx/ui/events/event_60.png[/img]{Te encuentras con un cadáver en la hierba. Normalmente, los muertos no son una gran sorpresa: hay gente por todas partes, así que tarde o temprano verás algún cuerpo por aquí o por allá. Pero este tiene grandes tajos a lo largo de la espalda y le faltan los órganos.\n\n%helpfulbrother% se acerca.%SPEECH_ON%Los órganos se los llevaron los lobos, o tal vez incluso los conejos. ¿Qué? ¿Nunca has oído hablar de un conejo muy hambriento?%SPEECH_OFF%Escupe y se muerde una uña.%SPEECH_ON%De todos modos, esas marcas no son obra de ningún conejo ni perro ni lo que sea. Es algo... más grande... más peligroso.%SPEECH_OFF%Agradeces %al_helpful% %hombre_helpful% sus perspicaces observaciones y le dices que vuelva a las filas. | Un campesino se te acerca con la ropa hecha jirones. Con bastante pudor, se cubre la entrepierna con las manos.%SPEECH_ON%Por favor, señores, vengan a ver este... horror.%SPEECH_OFF%Cuando le preguntas de qué habla, levanta las manos de golpe y adelanta las caderas hacia ti. Gira sobre sí mismo como una marioneta y sale corriendo entre aullidos y gritos. Una mujer se te acerca tras el arrebato de locura del hombre. Tiene las manos apretadas contra el pecho.%SPEECH_ON%Se ha vuelto loco porque las bestias despedazaron a su hermano.%SPEECH_OFF%Te vuelves hacia ella, medio esperando que la dama se arranque la ropa y menee sus formas en la dirección que le plazca. En lugar de eso, se limita a mirarte fijamente.%SPEECH_ON%Sé que %townname% ha contratado a algunos hombres para ocuparse de estas bestias, y desde luego tienes pinta de mercenario. Por favor, señor, protégenos de estos males... y de los males que propagan...%SPEECH_OFF% | Te encuentras con una vaca destripada, con una mitad echada sobre una valla y la otra esparcida a buena distancia por la hierba, tan lejos como sus entrañas lo permitían. Un espectáculo horroroso como pocos.\n\nUn granjero se acerca y se echa el sombrero hacia atrás para despejarse los ojos.%SPEECH_ON%Eso lo hicieron las bestias. No las vi, por si te lo preguntas, pero sí oí este maldito desastre antes que tú. Con oírlo me bastó para agacharme y no dejarme ver. Por favor, si estás aquí para encontrar a esas criaturas, hazlo rápido, porque no puedo permitirme perder más ganado así.%SPEECH_OFF% | Un campesino que está partiendo leña se endereza ante ti.%SPEECH_ON%Por los dioses, qué alegría verlos, señores. Me pareció oír que unos mercenarios andaban por ahí buscando a las bestias que aterrorizan estas tierras.%SPEECH_OFF%Le preguntas si ha visto algo que pueda ayudar. Apoya las manos sobre el pomo del hacha.%SPEECH_ON%No puedo decir que sí, no. Pero he oído cosas. Sé que a un hombre y una mujer de no muy lejos de aquí se los llevaron. Bueno, desaparecieron juntos. Dicen que ahora están muertos en el bosque. Pegados a los árboles como lapas, colgando de las tripas, ¿sabes? O, espera, ¡a lo mejor solo se largaron por su propio pie a vivir juntos! ¡Demonios... demonios! Esa chica odiaba a su padre y el chico no era más que un don nadie con buena planta y mucha labia. Sí, eso tiene sentido.%SPEECH_OFF%Hace una pausa y luego te mira.%SPEECH_ON%En cualquier caso, estoy seguro de que esos monstruos andan sueltos. Mantén los ojos abiertos, mercenario.%SPEECH_OFF% | Una mujer sale corriendo de su cabaña para detenerte. Casi sin aliento, te pregunta si has visto a un niño. Niegas con la cabeza. Extiende la mano.%SPEECH_ON%Es más o menos así de alto. Una mata de pelo castaño. No de nacimiento, pero al chico sí que le gusta el barro. Cuando sonríe, sus dientes son como las estrellas, brillantes y dispersos.%SPEECH_OFF%Niegas con la cabeza por segunda vez.%SPEECH_ON%Lanza bien las piedras. Las tira lejos. Le dije que no mostrara su fuerza cuando anduvieran por aquí los hombres del señor, no vaya a ser que se lo lleven al ejército.%SPEECH_OFF%Resopla y se aparta de los ojos un mechón suelto.%SPEECH_ON%Bueno, mierda, en fin, si lo ves, avísame. Creo que es mío. Además, ten cuidado con la oscuridad. Las bestias andan emboscando a la gente por aquí.%SPEECH_OFF%Antes de que puedas decir nada, la mujer se recoge la larga falda y vuelve a trompicones a su cabaña. | Te encuentras con un hombre arrodillado junto a un perro completamente destrozado. Te arrodillas a su lado.%SPEECH_ON%¿Esto lo hicieron las bestias?%SPEECH_OFF%Niega con la cabeza.%SPEECH_ON%Diablos, lo hice yo. Por fin. El maldito bicho ya no me va a quitar el sueño.%SPEECH_OFF%En ese momento, se abre la puerta de una cabaña de enfrente y un hombre sale corriendo y gritando.%SPEECH_ON%¡¿Ese es mi maldito perro, hijo de puta?!%SPEECH_OFF%El matador de perros se pone en pie de un salto.%SPEECH_ON%¡Las bestias! ¡Volvieron anoche!%SPEECH_OFF%Te alejas en silencio y dejas la disputa donde yace el perro.}"
    }
    // en = "On your return..."
    // en base_es
    // context: roaming_beasts_contract.o.createScreens.m.Screens.push().Text
    {
        // corrige base: «I can't quite put my finger on it, and I'm not sure I should» quedaba en «No estoy seguro de que deba decir esto en voz alta»; se perdía la primera mitad.
        // corrige base: «take it away» se refiere a la cabeza; la 1.0 ponía «llévatelo» en masculino.
        en = "[img]gfx/ui/events/event_04.png[/img]{You find %employer% resting on %their_employer% laurels. %They_employer% stands and pulls %their_employer% pants up, a servant quickly retrieving a bucket from whence %they_employer% was sitting. The poor servant quickly rushes out of the room. %employer% points at the rat head dangling from your hand.%SPEECH_ON%That is absolutely disgusting. %randomname%, give the %companyname% their pay. %reward% crowns, was it?%SPEECH_OFF% | You place the rat head onto %employer%'s desk. For some reason, fluids still issue from its neck, dribbling down the side of the oak and no doubt staining it. The %person_employer% leans back, tenting %their_employer% fingers on %their_employer% belly.%SPEECH_ON%Man sized rats? And what else, ghosts?%SPEECH_OFF%The %person_employer% snickers to %themselves_employer%.%SPEECH_ON%Nothing is too difficult for you, sellsword. Best not mention this to anyone. %SPEECH_OFF%%They_employer% snaps %their_employer% fingers and a servant comes up, handing you a satchel of %reward% crowns. | Between the battle and walking to %employer%'s place, the maw of the Rat became filled with flies, its tongue replaced by a formless, throbbing black ball that's more buzz than bite. %employer% takes one look at it and puts a cloth to %their_employer% mouth.%SPEECH_ON%Yes, I get it, take it away, please. Make sure no one else sees it%SPEECH_OFF%%They_employer% waves one of his guards over and you are handed a satchel of %reward% crowns. | A steely eyed %employer% leans forward to get a good look at the Rat head you've brought in.%SPEECH_ON%That is quite the sight, mercenary. I wish you'd never brought it though.%SPEECH_OFF%%They_employer% leans back.%SPEECH_ON%Leave it on my desk, I'll make sure it disapears.%SPEECH_OFF%%They_employer% snaps his fingers and a servant comes to give you %reward% crowns. | You bring the Rat head to %employer% who stares at it for a long time.%SPEECH_ON%That reminds me of someone. I can't quite put my finger on it, and I'm not sure I should. We must keep this secret from escaping. Excuse me, sellsword, I borrow your time without paying for it. Servant, give the %companyname% their money!%SPEECH_OFF%You are rewarded as promised. | %employer% takes the Rat head and holds it up. A few mewling cats seemingly appear out of nowhere, circling beneath it like buzzards would overhead. %They_employer% throws it into the fire nearby and the cats wail, seemingly crying at the loss of a meal.%SPEECH_ON%Good work, sellsword. %reward% crowns, as promised. Let's keep this between us%SPEECH_OFF% | You put a Rat head on %employer%'s table. %They_employer% looks up from a dinner plate, glances at the head, then at you.%SPEECH_ON%I was eating, sellsword.%SPEECH_OFF%The silverware clatters as the disgusted %person_employer% shoves the plate aside. A servant whisks the food away for destruction. %employer% takes a satchel out and puts it on the table.%SPEECH_ON% I'll make that heresy disapear, %reward_completion% crowns as was promised.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_04.png[/img]{Encuentras a %employer% haciendo sus necesidades. Se levanta y se sube los pantalones mientras un sirviente retira a toda prisa un cubo de donde estaba sentad%o_employer%. El pobre sirviente sale corriendo de la habitación. %employer% señala la cabeza de rata que cuelga de tu mano.%SPEECH_ON%Esto es absolutamente repugnante. %randomname%, dale su paga a %companyname%. ¿Eran %reward% coronas?%SPEECH_OFF% | Colocas la cabeza de rata sobre el escritorio de %employer%. Por alguna razón, aún le salen fluidos del cuello, que gotean por el costado del roble y sin duda lo manchan. %Art_employer% %hombre_employer% se recuesta y junta las yemas de los dedos sobre el vientre.%SPEECH_ON%¿Ratas del tamaño de un hombre? ¿Y qué más, fantasmas?%SPEECH_OFF%%Art_employer% %hombre_employer% se ríe para sí.%SPEECH_ON%Nada es demasiado difícil para ti, mercenario. Mejor no se lo cuentes a nadie. %SPEECH_OFF%Chasquea los dedos y un sirviente se acerca y te entrega una bolsa con %reward% coronas. | Entre la batalla y el camino hasta la casa de %employer%, las fauces de la rata se han llenado de moscas, y su lengua ha quedado sustituida por una bola negra, amorfa y palpitante, más zumbido que mordisco. %employer% le echa un vistazo y se tapa la boca con un paño.%SPEECH_ON%Sí, ya lo entiendo, llévatela, por favor. Asegúrate de que nadie más la vea.%SPEECH_OFF%Llama con un gesto a uno de sus guardias y te entregan una bolsa con %reward% coronas. | %employer%, con mirada acerada, se inclina hacia delante para examinar bien la cabeza de rata que has traído.%SPEECH_ON%Menudo espectáculo, mercenario. Aunque ojalá no la hubieras traído nunca.%SPEECH_OFF%Se echa hacia atrás.%SPEECH_ON%Déjala en mi escritorio, ya me encargaré de que desaparezca.%SPEECH_OFF%Chasquea los dedos y un sirviente se acerca a darte %reward% coronas. | Le llevas la cabeza de rata a %employer%, que se queda mirándola un buen rato.%SPEECH_ON%Me recuerda a alguien. No sabría decir a quién, y no estoy segur%o_employer% de querer saberlo. No debemos dejar que este secreto salga de aquí. Disculpa, mercenario, te estoy robando tiempo sin pagarte por él. ¡Sirviente, dale su dinero a %companyname%!%SPEECH_OFF%Recibes la recompensa prometida. | %employer% toma la cabeza de rata y la levanta. Unos cuantos gatos maullando aparecen como de la nada y dan vueltas debajo de ella como lo harían los buitres en lo alto. La arroja al fuego cercano y los gatos aúllan, como si lloraran la pérdida de una comida.%SPEECH_ON%Buen trabajo, mercenario. %reward% coronas, como prometí. Que esto quede entre nosotros.%SPEECH_OFF% | Pones una cabeza de rata sobre la mesa de %employer%. Levanta la vista del plato de la cena, mira la cabeza y luego a ti.%SPEECH_ON%Estaba comiendo, mercenario.%SPEECH_OFF%Los cubiertos tintinean cuando %art_employer% %hombre_employer%, asquead%o_employer%, aparta el plato. Un sirviente se lleva la comida para destruirla. %employer% saca una bolsa y la deja sobre la mesa.%SPEECH_ON% Haré desaparecer esa herejía. %reward_completion% coronas, como se prometió.%SPEECH_OFF%}"
    }
    // en = "A successful hunt."
    // en base_es
    // context: roaming_beasts_contract.o.createScreens.m.Screens.push().Options.getResult.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation()
    {
        en = "Rid the town of infection"
        es = "Libró al pueblo de la infección"
    }
    // en = "You gain <v:val_tag> Crowns"
    // en base_es
    // context: roaming_beasts_contract.o.createScreens.s.Text
    {
        // corrige base: «how silent and eerie the whole settlement was when you first arrived»: la 1.0 decía «está... desde que llegaste».
        // corrige base: «There's crowns in here»: la 1.0 ponía «monedas»; son coronas.
        // corrige base: «hunt these monsters down»: la 1.0 cambiaba «monstruos» por «bestias».
        // corrige base: «find and destroy them» se refiere a criaturas y bestias; la 1.0 ponía «encontrarlos y destruirlos».
        // corrige base: «they're being taken» no es «están siendo cazadas».
        // corrige base: «a better walk-about of this world» es haber recorrido más mundo, no «una mejor experiencia».
        // corrige base: «sentandose» sin tilde y un espacio de más tras %SPEECH_OFF% que el inglés no tiene.
        en = "[img]gfx/ui/events/event_43.png[/img]{While you wait for %employer% to explain what %they_employer% needs your services for, you contemplate on how silent and eerie the whole settlement was when you first arrived. %employer% raises %their_employer% voice %SPEECH_ON%This place is cursed by the gods and haunted by unearthly beasts! They come in the night with glowing red eyes and take lives at their whim. Most of our cattle is dead and I fear that once there are no more, we are next to be torn apart. The other day we sent our strongest lads out to find and kill the beasts but we haven't heard of them since.%SPEECH_OFF%%They_employer% sighs deeply.%SPEECH_ON%Follow the tracks %direction% and hunt down and kill those creatures so that we can live in peace again! We are not wealthy, but all chipped in to pay for your services.%SPEECH_OFF% | %employer%'s looking out %their_employer% window when you find %them_employer%. There's a goblet in %their_employer% hand - and there's nothing but silence outside. %They_employer% turns to you, almost somber.%SPEECH_ON%When you came here, did you realize how quiet it was?%SPEECH_OFF%You remark that you did, but you're a sellsword who looks the part. It's just what you are accustomed to. %employer% nods and takes a drink.%SPEECH_ON%Ah, of course. Unfortunately, it isn't that people are afraid of you. Not this time. We have had people being attacked these past weeks. Beasts of some sort are on the loose, we know not what they are, but only who they take. We've pleaded with our lord, of course, but he has done nothing to help us...%SPEECH_OFF%%Their_employer% next drink is a long one. When %they_employer% finishes, %they_employer% turns to you, empty cup in hand.%SPEECH_ON%Would you go hunt these monsters down? Please, sellsword, help us.%SPEECH_OFF% | %employer%'s listening to the talk of a few peasants when you find %them_employer%. When they see you, they quickly depart, leaving the man with a satchel in hand. %They_employer% holds it up.%SPEECH_ON%There's crowns in here. Crowns that those people are giving me to give someone, anyone, to help us. People are disappearing, sellsword, and when they are found they're... not just dead, but... mangled. Mutilated. Everyone is too scared to go anywhere.%SPEECH_OFF%%They_employer% stares into the sack, then looks to you.%SPEECH_ON%I do hope you are interested in this task.%SPEECH_OFF% | You find %employer% reading a scroll. %They_employer% throws the paper at you and asks you to read off the names. The handwriting is difficult, but not moreso than the names themselves. You stop and apologize, stating you are not from these parts. The man nods and takes the scroll back.%SPEECH_ON%Tis alright, sellsword. If you were wondering, those were the names of men, women, and children who have passed in the last week.%SPEECH_OFF%Last week? There were a lot of names on that list. The %person_employer%, seeming to read you, nods somberly.%SPEECH_ON%Aye, we are in a bad way. So many lives lost. We believe this to be the work of foul creatures, beasts beyond our ability to reason. Obviously, we'd like you to go find and destroy them. Would you be interested in such a task, mercenary?%SPEECH_OFF% | %employer%'s got a few dogs at %their_employer% feet, all tuckered out with their tongues lolling.%SPEECH_ON%They've spent the past few days hunting for missing folks. Folks that are seemingly disappearing to the gods know where.%SPEECH_OFF%%They_employer% leans down and pets one of the hounds, scratching it behind the ear. Usually, a dog would respond to that, but the poor thing barely even responds.%SPEECH_ON%The folks don't know what I know, though, which is that people ain't just disappearing... they're being taken. Horrible beasts are afoot, sellsword, and I need you to go after them. Hell, maybe you'll even find someone or two of the townsfolk, though I doubt it.%SPEECH_OFF%One of the mutts lets out a long, tired wheeze almost as if on cue. | %employer%'s got a satchel with a scroll attached, but the name written on the paper is not yours. %They_employer% weighs it carefully, the lumps of coin curving about %their_employer% fingers, their chink and chanks muted. %They_employer% turns to you.%SPEECH_ON%You recognize that name?%SPEECH_OFF%You shake your head. The %person_employer% continues.%SPEECH_ON%A week ago we sent the famed %randomnoble% %direction% of here to go hunt down some foul beasts that have been terrorizing the town and surrounding farmsteads for weeks. Do you know why this satchel has remained in my ownership?%SPEECH_OFF%You shrug and answer.%SPEECH_ON%Because he hasn't returned?%SPEECH_OFF%%employer% nods and sets the satchel down. %They_employer% sits on the edge of his table.%SPEECH_ON%Correct. Because he has not returned. Now, why do you think that is? I think it's because he's dead, but let's not be so negative. I think it's because the beasts out there require more. I think they require someone like you, sellsword. Would you be willing to help us now that this nobleman has failed?%SPEECH_OFF% | %employer% takes a book from his shelf. When %they_employer% sets it on his table, dust or maybe even ash plume outward. %They_employer% opens it up, thumbing slowly from page to page.%SPEECH_ON%Do you believe in monsters, sellsword? I'm asking honestly, as I believe you've had a better walk-about of this world than I.%SPEECH_OFF%You nod and speak.%SPEECH_ON%More than just a belief, yes.%SPEECH_OFF%The man thumbs another page. %They_employer% looks up at you.%SPEECH_ON%Well, we believe monsters have come to %townname%. We believe that's why people are going missing. Understand where this is going? I need you to find these 'make believe' creatures and kill them like any other. Are you interested?%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_43.png[/img]{Mientras esperas a que %employer% te explique para qué necesita tus servicios, piensas en lo silencioso y siniestro que estaba todo el asentamiento cuando llegaste. %employer% alza la voz.%SPEECH_ON%¡Este lugar está maldito por los dioses y lo acechan bestias sobrenaturales! Vienen de noche, con ojos rojos y brillantes, y se cobran vidas a su antojo. La mayor parte de nuestro ganado ha muerto y temo que, cuando ya no quede, seremos los siguientes en ser despedazados. Hace unos días enviamos a nuestros mozos más fuertes a buscar y matar a las bestias, pero no hemos vuelto a saber de ellos.%SPEECH_OFF%Suspira profundamente.%SPEECH_ON%¡Sigue las huellas hacia el %direction%, da caza a esas criaturas y mátalas para que podamos volver a vivir en paz! No somos ricos, pero todos hemos puesto algo para pagar tus servicios.%SPEECH_OFF% | %employer% está mirando por la ventana cuando %lo_employer% encuentras. Tiene una copa en la mano, y fuera no hay más que silencio. Se vuelve hacia ti, casi sombrí%o_employer%.%SPEECH_ON%Cuando llegaste, ¿te diste cuenta de lo tranquilo que estaba todo?%SPEECH_OFF%Comentas que sí, pero que eres un mercenario y tienes pinta de serlo; es a lo que estás acostumbrado. %employer% asiente y da un trago.%SPEECH_ON%Ah, claro. Por desgracia, no es que la gente te tenga miedo. Esta vez no. Estas últimas semanas han atacado a varias personas. Hay bestias de algún tipo sueltas; no sabemos qué son, solo a quiénes se llevan. Hemos suplicado a nuestro señor, por supuesto, pero no ha hecho nada por ayudarnos...%SPEECH_OFF%El siguiente trago es largo. Cuando termina, se vuelve hacia ti con la copa vacía en la mano.%SPEECH_ON%¿Irías a dar caza a esos monstruos? Por favor, mercenario, ayúdanos.%SPEECH_OFF% | %employer% está escuchando lo que cuentan unos campesinos cuando %lo_employer% encuentras. Al verte, se marchan a toda prisa y dejan %al_employer% %hombre_employer% con una bolsa en la mano. La levanta.%SPEECH_ON%Aquí dentro hay coronas. Coronas que esa gente me da para que se las dé a alguien, a quien sea, que nos ayude. La gente está desapareciendo, mercenario, y cuando los encuentran... no solo están muertos, sino... destrozados. Mutilados. Todos tienen demasiado miedo para ir a ninguna parte.%SPEECH_OFF%Mira dentro del saco y luego te mira a ti.%SPEECH_ON%Espero de veras que te interese este trabajo.%SPEECH_OFF% | Encuentras a %employer% leyendo un pergamino. Te lanza el papel y te pide que leas los nombres en voz alta. La letra es difícil, pero no tanto como los propios nombres. Te detienes y te disculpas, diciendo que no eres de estas tierras. %Art_employer% %hombre_employer% asiente y recupera el pergamino.%SPEECH_ON%No pasa nada, mercenario. Por si te lo preguntabas, eran los nombres de hombres, mujeres y niños que han fallecido en la última semana.%SPEECH_OFF%¿En la última semana? En esa lista había muchísimos nombres. %Art_employer% %hombre_employer%, como si te leyera el pensamiento, asiente con solemnidad.%SPEECH_ON%Sí, estamos pasando por un mal momento. Tantas vidas perdidas. Creemos que es obra de criaturas inmundas, bestias que escapan a nuestra comprensión. Como es lógico, queremos que vayas a encontrarlas y destruirlas. ¿Te interesaría un trabajo así, mercenario?%SPEECH_OFF% | %employer% tiene unos cuantos perros a sus pies, todos agotados y con la lengua fuera.%SPEECH_ON%Se han pasado los últimos días buscando a gente desaparecida. Gente que aparentemente desaparece solo los dioses saben adónde.%SPEECH_OFF%Se agacha y acaricia a uno de los perros, rascándole detrás de la oreja. Normalmente un perro respondería a eso, pero el pobre animal apenas reacciona.%SPEECH_ON%Pero la gente no sabe lo que sé yo, y es que no es que la gente desaparezca sin más... es que se la llevan. Andan sueltas unas bestias horribles, mercenario, y necesito que vayas tras ellas. Demonios, puede que incluso encuentres a uno o dos vecinos del pueblo, aunque lo dudo.%SPEECH_OFF%Uno de los chuchos suelta un resoplido largo y cansado, casi como si le hubieran dado la entrada. | %employer% tiene una bolsa con un pergamino atado, pero el nombre escrito en el papel no es el tuyo. La sopesa con cuidado; los bultos de las monedas se amoldan a sus dedos y su tintineo suena apagado. Se vuelve hacia ti.%SPEECH_ON%¿Reconoces ese nombre?%SPEECH_OFF%Niegas con la cabeza. %Art_employer% %hombre_employer% continúa.%SPEECH_ON%Hace una semana enviamos al famoso %randomnoble% al %direction% de aquí para que diera caza a unas bestias inmundas que llevan semanas aterrorizando el pueblo y las granjas de los alrededores. ¿Sabes por qué esta bolsa sigue en mi poder?%SPEECH_OFF%Te encoges de hombros y respondes.%SPEECH_ON%¿Porque no ha vuelto?%SPEECH_OFF%%employer% asiente y deja la bolsa. Se sienta en el borde de su mesa.%SPEECH_ON%Correcto. Porque no ha vuelto. Y ahora, ¿por qué crees que será? Yo creo que es porque está muerto, pero no seamos tan negativos. Creo que es porque las bestias de ahí fuera requieren algo más. Creo que requieren a alguien como tú, mercenario. ¿Estarías dispuesto a ayudarnos ahora que ese noble ha fracasado?%SPEECH_OFF% | %employer% saca un libro de su estantería. Cuando lo deja sobre la mesa, se levanta una nube de polvo, o quizá incluso de ceniza. Lo abre y pasa despacio las páginas con el pulgar.%SPEECH_ON%¿Crees en los monstruos, mercenario? Te lo pregunto en serio, porque creo que has recorrido este mundo bastante más que yo.%SPEECH_OFF%Asientes y respondes.%SPEECH_ON%Más que creer en ellos, sí.%SPEECH_OFF%%Art_employer% %hombre_employer% pasa otra página. Levanta la vista hacia ti.%SPEECH_ON%Pues bien, creemos que los monstruos han llegado a %townname%. Creemos que por eso está desapareciendo la gente. ¿Entiendes adónde quiero llegar? Necesito que encuentres a esas criaturas 'imaginarias' y las mates como a cualquier otra. ¿Te interesa?%SPEECH_OFF%}"
    }
    // context: roaming_beasts_contract.o.createScreens.s.Text
    {
        en = "[img]gfx/ui/events/event_131.png[/img]{The fight over, you walk to a dead infected peasant and take a knee. A pool of poison is still dripping from the peasant's teeth. Instead of admiring the dental failures at hand, you instead take out a knife and saw its head off, ripping through a very tough outer layer of skin before, surprisingly, easily cutting through the muscles and tendons. You raise the head up and order the %companyname% follow suit. %employer% will be expecting some proof, after all. | The peasants's dead body looks more rat than man as it lays flat and unmoving. Flies are already coupling inside its mouth, sowing life on the frothy remains of death. You order %randombrother% to take its head, for %employer% will be expecting proof. | Dead peasants are scattered about. You take a knee beside one and look at its mouth. Whatever was in its lungs is still issuing forth, a wheeze burping out. Putting a cloth to your nose, you use the other hand to chop away at its neck with a blade, cutting off the head and holding it up. You order a few brothers to follow suit for %employer% will be expecting proof. | A dead infected peasant is an interesting specimen to behold. You can't help but wonder where it falls on the natural spectrum. Half rat and half man, these things are the thing of child's nightmares. You order the %companyname% to start collecting the heads of the foul things for %employer% will surely be wanting proof.}"
        es = "[img]gfx/ui/events/event_131.png[/img]{Terminada la pelea, te acercas a un campesino infectado muerto y pones una rodilla en tierra. Todavía le gotea veneno de los dientes, que forma un charco. En lugar de admirar los desastres dentales que tienes delante, sacas un cuchillo y le sierras la cabeza: desgarras una capa exterior de piel muy dura antes de, para tu sorpresa, atravesar sin esfuerzo músculos y tendones. Alzas la cabeza y ordenas a %companyname% que haga lo mismo. Al fin y al cabo, %employer% esperará alguna prueba. | El cadáver del campesino, tendido e inmóvil, parece más rata que hombre. Las moscas ya se aparean dentro de su boca, sembrando vida en los restos espumosos de la muerte. Ordenas a %randombrother% que le corte la cabeza, porque %employer% esperará pruebas. | Hay campesinos muertos esparcidos por todas partes. Te arrodillas junto a uno y le miras la boca. Lo que fuera que tuviera en los pulmones todavía le sale en un resuello que brota como un eructo. Tapándote la nariz con un paño, usas la otra mano para tajarle el cuello con una hoja hasta cortarle la cabeza, y la alzas. Ordenas a unos cuantos hermanos que hagan lo mismo, porque %employer% esperará pruebas. | Un campesino infectado muerto es un espécimen curioso de contemplar. No puedes evitar preguntarte qué lugar ocupará en el orden natural. Mitad rata y mitad hombre, estas cosas son materia de pesadillas infantiles. Ordenas a %companyname% que empiece a recoger las cabezas de esos seres inmundos, porque seguro que %employer% querrá pruebas.}"
    }
    // en = "[img]gfx/ui/events/event_131.png[/img]\x7bThe fight over, you walk to a dead Nachzehrer and take a knee. Were it not for a gate of ill-shapen teeth, you could easily fit your head into the beast's oversized maw. Instead of admiring the dental failures at hand, you instead take out a knife and saw its head off, ripping through a very tough outer layer of skin before, surprisingly, easily cutting through the muscles and tendons. You raise the head up and order the %companyname% follow suit. %employer% will be expecting some proof, after all. | The Nachzehrers's dead body looks more rock than beast as it lays flat and unmoving. Flies are already coupling inside its mouth, sowing life on the frothy remains of death. You order %randombrother% to take its head, for %employer% will be expecting proof. | Dead Nachzehrers are scattered about. You take a knee beside one and look at its mouth. Whatever was in its lungs is still issuing forth, a wheeze burping out. Putting a cloth to your nose, you use the other hand to chop away at its neck with a blade, cutting off the head and holding it up. You order a few brothers to follow suit for %employer% will be expecting proof. | A dead Nachzehrer is an interesting specimen to behold. You can't help but wonder where it falls on the natural spectrum. Shaped like crude men, muscled like some beastly thing, and its head is gnarled with features born out of a wildman's nightmares. You order the %companyname% to start collecting the heads of the foul things for %employer% will surely be wanting proof.\x7d"
    // en base_es
    // context: roaming_beasts_contract.o.createScreens.s.Text
    {
        // corrige base: «I can believe it, though» estaba invertido como «me parecen bastante increíbles».
        // corrige base: «Wolves in... wolf clothing?» juega con «lobo con piel de cordero»; «ropa de lobo» perdía el guiño.
        // corrige base: «cheesy joke» es un chiste malo, no «una broma de mal gusto».
        // corrige base: concordancias «las coronas te esperan» por «tu pago te espera» y «Les diré a la gente» por «Le diré».
        // corrige base: «como si no debería» por «como si no debiera», y «oir» sin tilde.
        // corrige base: «get the man back on track» es reconducirlo, no «que se enfoque en otra cosa».
        // corrige base: calcos «Seguramente entiendes tratar de encontrar humor» y «podría necesitar un respiro», y «te agradecemos» sin «lo».
        en = "[img]gfx/ui/events/event_04.png[/img]{%employer% welcomes your return.%SPEECH_ON%I've already heard the, I suppose, splendid news. I can believe it, though. A bunch of brigands playing dress up. Wolves in... wolf clothing?%SPEECH_OFF%%They_employer% grins at you, expecting a laugh at his cheesy joke. You shrug. %They_employer% shrugs, too.%SPEECH_ON%Ah, well. Your payment, %reward_completion% crowns, is waiting for you outside. I will tell the people of %townname% that the monsters they fear are but men.%SPEECH_OFF% | You return with the costumes of the foolish brigands. %employer% tilts the disguises left to right.%SPEECH_ON%Interesting. They're very well done. I'd almost say the brigands were clever here.%SPEECH_OFF%%They_employer% picks up one of the masks and looks just about ready to try it on, then pauses as though %they_employer% shouldn't do this with an audience. %They_employer% puts it back down and smiles at you.%SPEECH_ON%Well, anyway, sellsword... good work. You'll have %reward_completion% crowns waiting for you outside with one of %townname%'s councilmen. %They_employer%'ll be looking out for you. Now, the people of %townname% can bury our dead and finally be at peace.%SPEECH_OFF% | %employer% reels in laughter at your reveal.%SPEECH_ON%Men? It was only men?%SPEECH_OFF%You nod, but try and get the man back on track.%SPEECH_ON%They killed a lot of peasants and they were still a dangerous lot.%SPEECH_OFF%Your employer nods.%SPEECH_ON%Of course, of course! I didn't mean to belittle anything or anyone. Don't dare assume things of me, sellsword, those are my friends and neighbors dying out there! Anyway, you did what I asked of you and for that I am very grateful.%SPEECH_OFF%%They_employer% hands over a satchel of crowns. You count %reward_completion% inside before making your leave. The %person_employer% hollers out to you.%SPEECH_ON%Surely you understand trying to find humor in this horrible world, right? Because it is I who went to the funerals of all those slain. I will not go into the grave with a frown on my face, no matter how hard this damned place tries to force it on me.%SPEECH_OFF% | You show %employer% the evidence of the mischievous brigands. %They_employer% picks through the lumps of disguises, rubbing crusty blood off his fingers.%SPEECH_ON%That is the blood of men alright. Are you sure that they weren't just having fun playing pretend and the real monsters are still out there?%SPEECH_OFF%You purse your lips and explain that they attacked you with very not-pretend weapons. %employer% nods, seemingly understanding, though a little suspicious.%SPEECH_ON%Well, I suppose I could just wait and see if the monsters return. If they do, well, a man betrayed makes for a mighty fine monster in and of itself, wouldn't you agree?%SPEECH_OFF%You just tell the man to pay you and wait and see if he should be so untrusting. %They_employer% nods, giving you %reward_completion% crowns and seeing you off.%SPEECH_ON%I truly do hope you are telling the truth, mercenary. %townname% could use a reprieve from the horrors that is constantly lashing out from this damned world.%SPEECH_OFF% | %employer% runs a finger along the edge of a disguise.%SPEECH_ON%The fur is soft to the touch. Very real...%SPEECH_OFF%%They_employer% looks up at you.%SPEECH_ON%I have to wonder if they killed the original monsters, and then... decided to wear their pelts? Why, though? Do you think they were cursed?%SPEECH_OFF%You shrug and answer.%SPEECH_ON%All I can say is that they had the guise of monsters, and the cruelty of them as well. They attacked us and paid for it. Have any of your locals spotted any creatures in awhile?%SPEECH_OFF%The man brings out a satchel of %reward_completion% crowns and slides it over to you.%SPEECH_ON%No, they haven't. In fact, they're starting to venture out again. I don't mean down the roads, but leaving the safety of their front doors is a big step for many! You've definitely brought us peace, sellsword, and for that we thank you.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_04.png[/img]{%employer% te da la bienvenida a tu regreso.%SPEECH_ON%Ya me han llegado las, supongo, espléndidas noticias. Aunque me lo creo. Un puñado de bandidos jugando a disfrazarse. ¿Lobos con... piel de lobo?%SPEECH_OFF%Te sonríe, esperando que te rías de su chiste malo. Te encoges de hombros. También se encoge de hombros.%SPEECH_ON%Ah, bueno. Tu pago, %reward_completion% coronas, te espera fuera. Le diré a la gente de %townname% que los monstruos a los que temen no son más que hombres.%SPEECH_OFF% | Vuelves con los disfraces de esos bandidos estúpidos. %employer% inclina los disfraces a un lado y a otro.%SPEECH_ON%Interesante. Están muy bien hechos. Casi diría que esta vez los bandidos fueron listos.%SPEECH_OFF%Toma una de las máscaras y parece a punto de probársela, pero se detiene como si no debiera hacerlo delante de público. La vuelve a dejar y te sonríe.%SPEECH_ON%Bueno, en fin, mercenario... buen trabajo. Tendrás %reward_completion% coronas esperándote fuera con uno de los concejales de %townname%. Estará pendiente de ti. Ahora la gente de %townname% podrá enterrar a nuestros muertos y por fin estar en paz.%SPEECH_OFF% | %employer% se desternilla de risa ante tu revelación.%SPEECH_ON%¿Hombres? ¿Eran solo hombres?%SPEECH_OFF%Asientes, pero intentas reconducir la conversación.%SPEECH_ON%Mataron a muchos campesinos y aun así eran un grupo peligroso.%SPEECH_OFF%%employer% asiente.%SPEECH_ON%¡Claro, claro! No pretendía menospreciar nada ni a nadie. No te atrevas a suponer cosas de mí, mercenario, ¡son mis amigos y vecinos los que están muriendo ahí fuera! En fin, hiciste lo que te pedí y te estoy muy agradecid%o_employer%.%SPEECH_OFF%Te entrega una bolsa de coronas. Cuentas %reward_completion% dentro antes de marcharte. %Art_employer% %hombre_employer% te grita mientras te alejas.%SPEECH_ON%Entiendes que uno intente buscarle la gracia a este mundo horrible, ¿verdad? Porque fui yo quien asistió a los funerales de todos los caídos. No pienso bajar a la tumba con el ceño fruncido, por mucho que este maldito lugar se empeñe en ello.%SPEECH_OFF% | Le muestras a %employer% las pruebas de esos bandidos bromistas. Rebusca entre el montón de disfraces y se frota los dedos para quitarse la sangre reseca.%SPEECH_ON%Esto es sangre de hombre, sin duda. ¿Seguro que no estaban simplemente divirtiéndose con sus disfraces y que los verdaderos monstruos siguen ahí fuera?%SPEECH_OFF%Frunces los labios y le explicas que te atacaron con armas que no eran de mentira en absoluto. %employer% asiente, aparentemente comprendiendo, aunque algo suspicaz.%SPEECH_ON%Bueno, supongo que puedo esperar a ver si los monstruos vuelven. Y si vuelven, en fin, un hombre traicionado ya es de por sí un monstruo bastante temible, ¿no te parece?%SPEECH_OFF%Te limitas a decirle que te pague y que espere a ver si tiene motivos para ser tan desconfiad%o_employer%. Asiente, te da %reward_completion% coronas y te despide.%SPEECH_ON%Espero sinceramente que digas la verdad, mercenario. A %townname% no le vendría mal un respiro de los horrores con que este maldito mundo no deja de azotarnos.%SPEECH_OFF% | %employer% pasa un dedo por el borde de un disfraz.%SPEECH_ON%La piel es suave al tacto. Muy real...%SPEECH_OFF%Levanta la vista hacia ti.%SPEECH_ON%Me pregunto si mataron a los monstruos de verdad y luego... decidieron ponerse sus pieles. Pero ¿por qué? ¿Crees que estaban malditos?%SPEECH_OFF%Te encoges de hombros y respondes.%SPEECH_ON%Lo único que puedo decir es que tenían la apariencia de monstruos, y también su crueldad. Nos atacaron y lo pagaron. ¿Alguno de tus vecinos ha visto alguna criatura últimamente?%SPEECH_OFF%%Art_employer% %hombre_employer% saca una bolsa con %reward_completion% coronas y te la desliza.%SPEECH_ON%No, ninguno. De hecho, empiezan a aventurarse fuera otra vez. No me refiero a salir a los caminos, ¡pero para muchos dejar la seguridad de su puerta es un gran paso! Sin duda nos has traído la paz, mercenario, y te lo agradecemos.%SPEECH_OFF%}"
    }
    // context: roaming_beasts_contract.o.createScreens.s.Text
    {
        // corrige base: «Nothing is too difficult for you»: la 1.0 añadía «parece».
        // corrige base: «take it away», «brought it to me», «Leave it», «with it» se refieren a la cabeza; la 1.0 los ponía en masculino.
        // corrige base: «The little gits are getting too used to fineries methinks» es acostumbrarse a los lujos, no «se están confiando», y la 1.0 repetía «me parece».
        // corrige base: «I can't quite put my finger on it, and I'm not sure I should» quedaba en «No estoy seguro de que deba decir esto en voz alta».
        en = "[img]gfx/ui/events/event_04.png[/img]{You find %employer% resting on %their_employer% laurels. %They_employer% stands and pulls %their_employer% pants up, a servant quickly retrieving a bucket from whence %they_employer% was sitting. The poor servant quickly rushes out of the room. %employer% points at the Nachzehrer head dangling from your hand.%SPEECH_ON%That is absolutely disgusting. %randomname%, give the %companyname% their pay. %reward% crowns, was it?%SPEECH_OFF% | You place the Nachzehrer head onto %employer%'s desk. For some reason, fluids still issue from its neck, dribbling down the side of the oak and no doubt staining it. The %person_employer% leans back, tenting %their_employer% fingers on %their_employer% belly.%SPEECH_ON%Nachzehrers? And what else, ghosts?%SPEECH_OFF%The %person_employer% snickers to %themselves_employer%.%SPEECH_ON%Nothing is too difficult for you, sellsword.%SPEECH_OFF%%They_employer% snaps %their_employer% fingers and a servant comes up, handing you a satchel of %reward% crowns. | Between the battle and walking to %employer%'s place, the maw of the Nachzehrer became filled with flies, its tongue replaced by a formless, throbbing black ball that's more buzz than bite. %employer% takes one look at it and puts a cloth to %their_employer% mouth.%SPEECH_ON%Yes, I get it, take it away, please.%SPEECH_OFF%%They_employer% waves one of %their_employer% guards over and you are handed a satchel of %reward% crowns. | A steely eyed %employer% leans forward to get a good look at the Nachzehrer head you've brought in.%SPEECH_ON%That is quite the sight, mercenary. I'm happy you have brought it to me.%SPEECH_OFF%%They_employer% leans back.%SPEECH_ON%Leave it on my desk. Maybe I can scare the children with it. The little gits are getting too used to fineries methinks.%SPEECH_OFF%%They_employer% snaps his fingers and a servant comes to give you %reward% crowns. | You bring the Nachzehrer head to %employer% who stares at it for a long time.%SPEECH_ON%That reminds me of someone. I can't quite put my finger on it, and I'm not sure I should. Excuse me, sellsword, I borrow your time without paying for it. Servant, give the %companyname% their money!%SPEECH_OFF%You are rewarded as promised. | %employer% takes the Nachzehrer head and holds it up. A few mewling cats seemingly appear out of nowhere, circling beneath it like buzzards would overhead. %They_employer% throws it out the window and the felines go running.%SPEECH_ON%Good work, sellsword. %reward% crowns, as promised.%SPEECH_OFF% | You put a Nachzehrer head on %employer%'s table. %They_employer% looks up from a dinner plate, glances at the head, then at you.%SPEECH_ON%I was eating, sellsword.%SPEECH_OFF%The silverware clatters as the disgusted %person_employer% shoves the plate aside. A servant whisks the food away, probably to try and eat it himself. %employer% takes a satchel out and puts it on the table.%SPEECH_ON%%reward_completion% crowns as was promised.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_04.png[/img]{Encuentras a %employer% haciendo sus necesidades. Se levanta y se sube los pantalones mientras un sirviente retira a toda prisa un cubo de donde estaba sentad%o_employer%. El pobre sirviente sale corriendo de la habitación. %employer% señala la cabeza del Nachzehrer que cuelga de tu mano.%SPEECH_ON%Esto es absolutamente repugnante. %randomname%, dale su paga a %companyname%. ¿Eran %reward% coronas?%SPEECH_OFF% | Colocas la cabeza del Nachzehrer sobre el escritorio de %employer%. Por alguna razón, aún le salen fluidos del cuello, que gotean por el costado del roble y sin duda lo manchan. %Art_employer% %hombre_employer% se recuesta y junta las yemas de los dedos sobre el vientre.%SPEECH_ON%¿Nachzehrers? ¿Y qué más, fantasmas?%SPEECH_OFF%%Art_employer% %hombre_employer% se ríe para sí.%SPEECH_ON%Nada es demasiado difícil para ti, mercenario.%SPEECH_OFF%Chasquea los dedos y un sirviente se acerca y te entrega una bolsa con %reward% coronas. | Entre la batalla y el camino hasta la casa de %employer%, las fauces del Nachzehrer se han llenado de moscas, y su lengua ha quedado sustituida por una bola negra, amorfa y palpitante, más zumbido que mordisco. %employer% le echa un vistazo y se tapa la boca con un paño.%SPEECH_ON%Sí, ya lo entiendo, llévatela, por favor.%SPEECH_OFF%Llama con un gesto a uno de sus guardias y te entregan una bolsa con %reward% coronas. | %employer%, con mirada acerada, se inclina hacia delante para examinar bien la cabeza del Nachzehrer que has traído.%SPEECH_ON%Menudo espectáculo, mercenario. Me alegra que me la hayas traído.%SPEECH_OFF%Se echa hacia atrás.%SPEECH_ON%Déjala en mi escritorio. A lo mejor puedo asustar a los niños con ella. Me parece que los mocosos se están acostumbrando demasiado a los lujos.%SPEECH_OFF%Chasquea los dedos y un sirviente se acerca a darte %reward% coronas. | Le llevas la cabeza del Nachzehrer a %employer%, que se queda mirándola un buen rato.%SPEECH_ON%Me recuerda a alguien. No sabría decir a quién, y no estoy segur%o_employer% de querer saberlo. Disculpa, mercenario, te estoy robando tiempo sin pagarte por él. ¡Sirviente, dale su dinero a %companyname%!%SPEECH_OFF%Recibes la recompensa prometida. | %employer% toma la cabeza del Nachzehrer y la levanta. Unos cuantos gatos maullando aparecen como de la nada y dan vueltas debajo de ella como lo harían los buitres en lo alto. La arroja por la ventana y los felinos salen corriendo tras ella.%SPEECH_ON%Buen trabajo, mercenario. %reward% coronas, como prometí.%SPEECH_OFF% | Pones una cabeza de Nachzehrer sobre la mesa de %employer%. Levanta la vista del plato de la cena, mira la cabeza y luego a ti.%SPEECH_ON%Estaba comiendo, mercenario.%SPEECH_OFF%Los cubiertos tintinean cuando %art_employer% %hombre_employer%, asquead%o_employer%, aparta el plato. Un sirviente se lleva la comida a toda prisa, probablemente para intentar comérsela él mismo. %employer% saca una bolsa y la deja sobre la mesa.%SPEECH_ON%%reward_completion% coronas, como se prometió.%SPEECH_OFF%}"
    }
    // context: roaming_beasts_contract.o.createScreens.s.Text
    {
        // corrige base: «jumps to his feet» es ponerse en pie de un salto, no «se pone rápido en guardia».
        // corrige base: «butterknife» es un cuchillo de untar, no «cuchillo corto»; «loaf» es hogaza, no «lonja».
        // corrige base: «carcass» es cadáver; «carcasa» es falso amigo.
        // corrige base: «sets his quill pen down» no es «deja su pluma en el tintero», que en castellano es dejar algo sin decir.
        // corrige base: «hosting a party» es dar o celebrar una fiesta, no «conduciendo».
        // corrige base: «librero» por estantería es regional; y «Ojalá y los dioses antiguos» por «los viejos dioses», como en el resto del texto.
        en = "[img]gfx/ui/events/event_04.png[/img]{You enter %employer%'s office carrying the dead spider on your back. The %person_employer% screams and %their_employer% chair squalls as it flings back across the floor. %They_employer% jumps to %their_employer% feet and draws a butterknife off %their_employer% desk. You throw the dead webknecht from your shoulder and it clatters on its back. The townsman slowly comes forward. %They_employer% sheathes the butterknife in a loaf of bread and shakes %their_employer% head.%SPEECH_ON%By the old gods, you nearly gave me a heart attack.%SPEECH_OFF%Nodding, you tell the %person_employer% it required more than a big boot to squash these beasts. %They_employer% nods back.%SPEECH_ON%Of course, sellsword, of course! Your payment of %reward_completion% crowns is right there in the corner. And, please, take that ungodly thing with you when you leave.%SPEECH_OFF% | Cats hiss and flee the second you step into %employer%'s room. A few dogs, always the sort for a mystery, run about your legs and sniff the spider carcass, their noses crinkling and pulling away but always coming back for more. The townsman is writing notes and %they_employer% can hardly believe %their_employer% eyes. %They_employer% sets %their_employer% quill pen down.%SPEECH_ON%Is that a giant spider?%SPEECH_OFF%You nod. %They_employer% smiles and picks %their_employer% quill pen back up.%SPEECH_ON%Perhaps I should have suggested you bring a very big shoe. Your payment of %reward_completion% crowns is there in the satchel. Go on, take it. It's all there. And you can leave the corpse. I'd like to get a closer look at the creature.%SPEECH_OFF% | %employer% is hosting a birthday party when you enter %their_employer% room with a giant dead spider and fling the corpse across the floor. Its bristly hairs hiss as they scratch across the stone and its eight legs scuttle upside down like some furniture of horror and it strays sideways and pops off the corner of a bookshelf and flips onto its toes and prongs there as though ready to pounce. Chaos breaks out as everyone screams and runs out the door or bails from the nearest open window, a litter of colorful confetti playfully twirling in their wake. The townsman stands alone amongst the emptied space and purses %their_employer% lips.%SPEECH_ON%Truly, sellsword, was that necessary?%SPEECH_OFF%You nod and tell %them_employer% that hiring you was necessary and that paying you will still be very necessary. The %person_employer% shakes %their_employer% head and gestures with a fake donkey tail to the corner of the room.%SPEECH_ON%Your satchel's over there with %reward_completion% crowns, as agreed upon. Now get that awful thing out of here and tell those fine folks the reveries need not be over.%SPEECH_OFF% | You don't think you can fit the spider corpse into %employer%'s room, so instead you slap it against %their_employer% window from the outside. You hear a horrified scream and the clatter of falling furniture. A moment later the adjacent window is thrown open. The townsman leans out.%SPEECH_ON%Oh very rich, sellsword, very rich! May the old gods serve you a thousand years of idle time for that one!%SPEECH_OFF%Nodding, you ask about your pay. %They_employer% begrudgingly tosses you a satchel.%SPEECH_ON%%reward_completion% crowns is in there. Now take that awful thing and go!%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_04.png[/img]{Entras en el despacho de %employer% cargando la araña muerta a la espalda. %Art_employer% %hombre_employer% grita y su silla chirría al salir despedida hacia atrás por el suelo. Se pone en pie de un salto y agarra un cuchillo de untar de su escritorio. Te quitas la webknecht muerta del hombro y la arrojas; cae de espaldas con estrépito. %Art_employer% aldean%o_employer% se acerca despacio. Envaina el cuchillo de untar en una hogaza de pan y niega con la cabeza.%SPEECH_ON%Por los viejos dioses, casi me provocas un infarto.%SPEECH_OFF%Asintiendo, le dices %al_employer% %hombre_employer% que hizo falta algo más que una bota grande para aplastar a esas bestias. Asiente a su vez.%SPEECH_ON%¡Claro, mercenario, claro! Tu pago de %reward_completion% coronas está ahí mismo, en el rincón. Y, por favor, llévate esa abominación cuando te vayas.%SPEECH_OFF% | Los gatos bufan y huyen en cuanto pones un pie en la habitación de %employer%. Unos cuantos perros, siempre atraídos por un misterio, corretean entre tus piernas y olfatean el cadáver de la araña; arrugan el hocico y se apartan, pero siempre vuelven por más. %Art_employer% aldean%o_employer% está escribiendo unas notas y apenas puede creer lo que ven sus ojos. Deja la pluma.%SPEECH_ON%¿Eso es una araña gigante?%SPEECH_OFF%Asientes. Sonríe y vuelve a tomar la pluma.%SPEECH_ON%Quizá debí sugerirte que trajeras un zapato muy grande. Tu pago de %reward_completion% coronas está ahí, en la bolsa. Vamos, tómalo. Está todo. Y puedes dejar el cadáver. Me gustaría ver a la criatura más de cerca.%SPEECH_OFF% | %employer% está celebrando una fiesta de cumpleaños cuando entras en su habitación con una araña gigante muerta y lanzas el cadáver por el suelo. Sus pelos hirsutos sisean al arañar la piedra, y sus ocho patas se agitan panza arriba como un mueble salido de una pesadilla; se desvía de lado, rebota en la esquina de una estantería, se da la vuelta sobre las puntas de las patas y se queda ahí clavada como si fuera a abalanzarse. Se desata el caos: todos gritan y salen corriendo por la puerta o se lanzan por la ventana abierta más cercana, dejando a su paso un reguero de confeti de colores que revolotea juguetón. %Art_employer% aldean%o_employer% se queda sol%o_employer% en el espacio recién vaciado y frunce los labios.%SPEECH_ON%De verdad, mercenario, ¿era necesario?%SPEECH_OFF%Asientes y le dices que contratarte era necesario y que pagarte va a seguir siendo muy necesario. %Art_employer% %hombre_employer% niega con la cabeza y señala el rincón de la habitación con una cola de burro falsa.%SPEECH_ON%Tu bolsa está ahí, con %reward_completion% coronas, como acordamos. Ahora saca esa cosa espantosa de aquí y diles a esa buena gente que la fiesta no tiene por qué terminar.%SPEECH_OFF% | No crees que el cadáver de la araña quepa en la habitación de %employer%, así que lo estampas contra su ventana desde fuera. Oyes un grito de horror y el estrépito de muebles cayendo. Un momento después se abre de golpe la ventana de al lado. %Art_employer% aldean%o_employer% se asoma.%SPEECH_ON%¡Ah, qué gracioso, mercenario, qué gracioso! ¡Que los viejos dioses te castiguen con mil años de ociosidad por esta!%SPEECH_OFF%Asintiendo, preguntas por tu paga. A regañadientes, te lanza una bolsa.%SPEECH_ON%Ahí dentro hay %reward_completion% coronas. ¡Ahora llévate esa cosa espantosa y lárgate!%SPEECH_OFF%}"
    }
    // en = "helpfulbrother"
    // en = "bro1"
    // context: roaming_beasts_contract.o.onPrepareVariables._vars.push()
    // en = "bro2"  // nombre de variable de texto (%bro2%), no se muestra
    // en = "direction"
    // FILE: mod_legends\hooks\contracts\contracts\roaming_beasts_desert_contract.nut
    // context: roaming_beasts_desert_contract.o.create.m.Name
    {
        en = "Desert Fangs"
        es = "Colmillos del desierto"
    }
    // context: roaming_beasts_desert_contract.o.create.m.DescriptionTemplates
    {
        en = "Amid the burning sands, the gnawed bones of deceased travelers are starting to pile up."
        es = "Entre las arenas abrasadoras, los huesos roídos de viajeros muertos empiezan a amontonarse."
    }
    // context: roaming_beasts_desert_contract.o.create.m.DescriptionTemplates
    {
        en = "The harsh desert trade routes are being made even more treacherous by hungry desert beasts."
        es = "Unas bestias hambrientas del desierto hacen aún más traicioneras las duras rutas comerciales que lo atraviesan."
    }
    // context: roaming_beasts_desert_contract.o.create.m.DescriptionTemplates
    {
        en = "Reports of a new pack of roaming desert predators have left travelers on edge."
        es = "Las noticias de una nueva manada de depredadores errantes del desierto tienen a los viajeros con los nervios de punta."
    }
    // context: roaming_beasts_desert_contract.o.create.m.DescriptionTemplates
    {
        en = "Being devoured by ferocious desert beasts was not high on your list of things to do today."
        es = "Que te devoraran unas feroces bestias del desierto no ocupaba un lugar destacado en tu lista de cosas por hacer hoy."
    }
    // context: roaming_beasts_desert_contract.o.create.m.DescriptionTemplates
    {
        en = "Rumor is that a pack of fierce predators have been ambushing caravans in the desert."
        es = "Se rumorea que una manada de feroces depredadores ha estado emboscando caravanas en el desierto."
    }
    // context: roaming_beasts_desert_contract.o.create.m.DescriptionTemplates
    {
        en = "A fierce pack of sand beasts appear to have developed quite a taste for human flesh."
        es = "Una feroz manada de bestias de las arenas parece haberle tomado bastante gusto a la carne humana."
    }
    // context: roaming_beasts_desert_contract.o.create.m.DescriptionTemplates
    {
        en = "The Viziers seek crownling warriors to expend on quelling the sand beast threat."
        es = "Los visires buscan guerreros cuentacoronas a los que sacrificar para sofocar la amenaza de las bestias de las arenas."
    }
    // context: roaming_beasts_desert_contract.o.create.m.DescriptionTemplates
    {
        en = "Some kind of unnatural beasts have been haunting the shifting sands."
        es = "Unas bestias antinaturales de algún tipo han estado acechando las dunas cambiantes."
    }
    // context: roaming_beasts_desert_contract.o.createScreens.s.Text
    {
        // corrige base: el mismo evento en la 1.0 traducía «Crownling» como «Cazador de Fortuna» (es «cuentacoronas»), escribía «nachzerers», omitía «only» en «The only other sound» y ponía «Ojea» por «stares».
        en = "[img]gfx/ui/events/event_162.png[/img]{%employer% welcomes you into his throne room. It is filled to the brim with what looks like very important people, yet you are brought in anyway. Pausing briefly because you're not sure if the crowd can take it, you shrug and then spill out the nachzehrers' remains. The froth of blood and guts and heads puddles across the floor, but not a peep comes from the onlookers.\n\nAll you can hear is the soft steps of the Vizier walking over. He stares at the remains, hands clasped before him like some scientist, then he snaps his fingers and a horde of servants come over and clean up the mess. One man with a quill pen and papers makes notations. When all is said and done the Vizier returns to this throne and sits in silence. The only other sound you hear is the chinky-chank of a treasure chest being dragged over. All %reward% crowns are handed to you as promised, then you are quietly urged to leave the room.\n\n Looking back, you see the crowd return their attention to the Vizier who starts into prayers. | A man stops you outside %employer%'s room. He has with him a few scrawny men with quill pens and ledgers. They descend upon your collection of nachzehrers and make attributions accordingly to their papers. Each one finishes and tears the page away and hands it to the first man who compares his notes. Satisfied, he hands you a purse of %reward% crowns.%SPEECH_ON%May your road be ever gilded, Crownling.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_162.png[/img]{%employer% te recibe en su sala del trono. Está llena a rebosar de lo que parece gente muy importante, pero te hacen pasar de todos modos. Te detienes un momento porque no sabes si el público lo aguantará, pero te encoges de hombros y vuelcas los restos de los nachzehrers. La espuma de sangre, tripas y cabezas se encharca por el suelo, pero los presentes no dicen ni pío.\n\nSolo oyes los pasos suaves del Visir, que se acerca. Contempla los restos con las manos juntas por delante, como si fuera un científico, y luego chasquea los dedos y una horda de sirvientes acude a limpiar el estropicio. Un hombre con pluma y papeles toma notas. Cuando todo ha terminado, el Visir vuelve a su trono y se sienta en silencio. Lo único que se oye aparte de eso es el tintineo de un cofre del tesoro que alguien arrastra. Te entregan las %reward% coronas, todas, tal como se prometió, y luego te invitan discretamente a abandonar la sala.\n\n Al mirar atrás, ves que la multitud vuelve a centrar su atención en el Visir, que se pone a rezar. | Un hombre te detiene a la puerta de la habitación de %employer%. Lo acompañan unos cuantos hombres escuálidos con plumas y libros de cuentas. Se lanzan sobre tu colección de nachzehrers y van anotando en sus papeles lo que corresponde. Cuando cada uno termina, arranca la hoja y se la entrega al primer hombre, que compara sus notas. Satisfecho, te da una bolsa con %reward% coronas.%SPEECH_ON%Que tu camino sea siempre dorado, cuentacoronas.%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\contracts\contracts\root_out_undead_contract.nut
    // context: root_out_undead_contract.o.create.m.Name
    {
        en = "Purge the Undead"
        es = "Purga a los no muertos"
    }
    // context: root_out_undead_contract.o.create.m.DescriptionTemplates
    {
        en = "The fiends must be driven back, lest the dead consume us all."
        es = "Hay que hacer retroceder a esos engendros, o los muertos nos consumirán a todos."
    }
    // context: root_out_undead_contract.o.create.m.DescriptionTemplates
    {
        en = "Even reanimated bones can fall, even the dead can die again."
        es = "Hasta los huesos reanimados pueden caer; hasta los muertos pueden volver a morir."
    }
    // context: root_out_undead_contract.o.create.m.DescriptionTemplates
    {
        en = "Driving out the unholy corruption is an endless battle, but one that must be fought."
        es = "Expulsar la corrupción impía es una batalla sin fin, pero hay que librarla."
    }
    // context: root_out_undead_contract.o.create.m.DescriptionTemplates
    {
        en = "Death cannot be escaped. But with the right actions, it can be postponed."
        es = "De la muerte no se escapa. Pero, actuando como es debido, se puede aplazar."
    }
    // FILE: mod_legends\hooks\contracts\contracts\siege_fortification_contract.nut
    // context: siege_fortification_contract.o.create.m.Name
    {
        en = "Laying Siege"
        es = "Poner sitio"
    }
    // context: siege_fortification_contract.o.create.m.DescriptionTemplates
    {
        // "Sieges often lead to violent, unpredictable outcomes. %s are seeking hardened sellswords to provide a steadying hand should things turn to ratshit.",
        mode = "pattern"
        en = "Sieges often lead to violent, unpredictable outcomes. [color=<c1:str>]<s1:str>[/color] are seeking hardened sellswords to provide a steadying hand should things turn to ratshit."
        es = "Los asedios suelen acabar de forma violenta e impredecible. [color=<c1>]<s1>[/color] busca mercenarios curtidos que pongan mano firme por si todo se va a la mierda."
    }
    // context: siege_fortification_contract.o.create.m.DescriptionTemplates
    {
        // "Finishing a siege is always a dicey business. %s wants some hardened mercenaries to tip the odds.",
        mode = "pattern"
        en = "Finishing a siege is always a dicey business. [color=<c1:str>]<s1:str>[/color] wants some hardened mercenaries to tip the odds."
        es = "Rematar un asedio siempre es un asunto arriesgado. [color=<c1>]<s1>[/color] quiere unos cuantos mercenarios curtidos que inclinen la balanza."
    }
    // context: siege_fortification_contract.o.create.m.DescriptionTemplates
    {
        en = "Dying with an arrow in your gut from attacking a fortified position is not exactly high in your list of priorities."
        es = "Morir con una flecha en las tripas por atacar una posición fortificada no ocupa precisamente un lugar destacado en tu lista de prioridades."
    }
    // context: siege_fortification_contract.o.create.m.DescriptionTemplates
    {
        // "Siege actions nearly always turn to ratshit in your experience. Probably why %s wants you down there.",
        mode = "pattern"
        en = "Siege actions nearly always turn to ratshit in your experience. Probably why [color=<c1:str>]<s1:str>[/color] wants you down there."
        es = "Según tu experiencia, los asedios casi siempre se van a la mierda. Seguramente por eso [color=<c1>]<s1>[/color] te quiere allí."
    }
    // context: siege_fortification_contract.o.start.m.Name.buildText()
    {
        en = "Siege %objective%"
        es = "Asedia %objective%"
    }
    // context: siege_fortification_contract.o.createScreens.s.Text
    {
        en = "Enough death for one day. (Increase Moral Reputation)"
        es = "Basta de muerte por hoy. (Aumenta la reputación moral)"
    }
    // context: siege_fortification_contract.o.createScreens.s.Text
    {
        en = "On to more important things... (Decrease Moral Reputation)"
        es = "A cosas más importantes... (Disminuye la reputación moral)"
    }
    // en = "You gain <v:val_tag> Crowns"
    // en base_es
    // context: siege_fortification_contract.o.createScreens.s.start.List.push().text
    {
        en = "The company's moral reputation decreases slightly"
        es = "La reputación moral de la compañía disminuye ligeramente"
    }
    // FILE: mod_legends\hooks\contracts\contracts\slave_uprising_contract.nut
    // en = "Slave Uprising"
    // en base_es
    // context: slave_uprising_contract.o.create.m.DescriptionTemplates
    {
        en = "Some of the indebted slaves have uprisen, casting off their shackles! The Viziers desire a swift and cruel response."
        es = "¡Algunos de los esclavos endeudados se han sublevado y se han librado de sus grilletes! Los visires desean una respuesta rápida y cruel."
    }
    // context: slave_uprising_contract.o.create.m.DescriptionTemplates
    {
        en = "The rebel slaves are weak and malnourished, there will be no glory in this action."
        es = "Los esclavos rebeldes están débiles y desnutridos; no habrá gloria alguna en esta acción."
    }
    // context: slave_uprising_contract.o.create.m.DescriptionTemplates
    {
        en = "After years of cruelty, some of the slaves are rebelling. Help crush this uprising before it spreads."
        es = "Tras años de crueldad, algunos esclavos se están rebelando. Ayuda a aplastar la revuelta antes de que se extienda."
    }
    // context: slave_uprising_contract.o.create.m.DescriptionTemplates
    {
        en = "The desert skies darken with the smoke of rebellion. Restore law and order with brutal sellsword efficiency."
        es = "Los cielos del desierto se oscurecen con el humo de la rebelión. Restablece la ley y el orden con la brutal eficacia de un mercenario."
    }
    // context: slave_uprising_contract.o.create.m.DescriptionTemplates
    {
        en = "Some of the indebted have cast off their chains in defiance. Ensure the revolution is short-lived."
        es = "Algunos endeudados se han quitado las cadenas en señal de desafío. Asegúrate de que la revolución dure poco."
    }
    // context: slave_uprising_contract.o.create.m.DescriptionTemplates
    {
        en = "The Viziers desire you to make an example of some striking workers. A very violent example."
        es = "Los visires quieren que des un escarmiento a unos trabajadores en huelga. Un escarmiento muy violento."
    }
    // context: slave_uprising_contract.o.createStates.s.end.bro.worsenMood()
    {
        en = "You took a contract to put down a slave uprising"
        es = "Aceptaste un contrato para sofocar una revuelta de esclavos"
    }
    // context: slave_uprising_contract.o.createScreens.s.Text
    {
        en = "[img]gfx/ui/events/event_71.png[/img]{The slaves at %location% see you coming and you hope the presence of your weapons will help deter them from continuing whatever freedom seeking they've undertaken. Shockingly, they do not lay down their arms but merely come together to stand against you. They are a crude lot, an arrangement of those whom enforced labor and recruitment has put the number on. | You find the indebted and they stare back with a very clear understanding of why you are there. The arrangement of participants, yourself armed to the teeth, coming by way of town, the indebted, armed with whatever they scavenged, far from their chains. They are a motley, sad assembly, but you know well that whatever they lack in weaponry they more than make up for in desire. A taste of freedom is nothing if not a sharpening effect. | As described, the indebted have taken over the %location% and armed themselves with whatever they could find. Upon seeing you, they hurry to some notion of formation, but they lack training, discipline, food, and much else. What they have, though, is no desire to return to whence they came which can be as sharp and dangerous a steel as any.}"
        es = "[img]gfx/ui/events/event_71.png[/img]{Los esclavos de %location% te ven llegar, y esperas que la sola vista de tus armas los disuada de seguir con esa búsqueda de libertad en la que se han embarcado. Para tu asombro, no deponen las armas, sino que se agrupan para plantarte cara. Son una pandilla tosca, un surtido de aquellos a quienes los trabajos forzados y las levas han marcado con un número. | Encuentras a los endeudados y te devuelven la mirada sabiendo muy bien por qué estás allí. Así están dispuestos los participantes: tú, armado hasta los dientes, llegado desde la ciudad; los endeudados, armados con lo que hayan podido rapiñar, lejos de sus cadenas. Son una reunión variopinta y triste, pero sabes bien que lo que les falta en armas les sobra en ganas. Nada afila tanto como probar la libertad. | Tal como te contaron, los endeudados se han hecho con %location% y se han armado con lo que han encontrado. Al verte, se apresuran a adoptar algo parecido a una formación, pero les falta instrucción, disciplina, comida y mucho más. Lo que sí tienen es la firme voluntad de no volver al lugar de donde vinieron, y eso puede ser un acero tan afilado y peligroso como cualquiera.}"
    }
