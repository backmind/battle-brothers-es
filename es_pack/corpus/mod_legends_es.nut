        es = "Tiene un [color=%negative%]<chance>%[/color] de probabilidad de desaparecer al comienzo de cada nuevo día"
    }
    // FILE: mod_legends\hooks\skills\effects\berserker_rage_effect.nut
    // context: berserker_rage_effect.o.getDescription
    {
        en = "The scent of blood and carnage drives this character into a primal frenzy. The rage demands constant slaughter to maintain. Every blow sustained, strike delivered, and life claimed fuels the growing bloodlust, drastically enhancing combat prowess."
        es = "El olor de la sangre y la carnicería sume a este personaje en un frenesí primario. Para mantenerse, la furia exige una matanza constante. Cada golpe recibido, cada golpe asestado y cada vida segada alimentan la creciente sed de sangre, lo que mejora drásticamente su destreza en combate."
    }
    // FILE: mod_legends\hooks\skills\effects\charmed_effect.nut
    // context: charmed_effect.o.getDescription
