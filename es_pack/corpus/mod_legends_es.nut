    }
    // en = "<actor:str_tag> heals for <hp:int> points"
    // en base_es
    // FILE: scripts\items\legend_armor\armor_upgrades\legend_additional_padding_upgrade.nut
    // en = "Additional Fur Padding"
    // en base_es
    // context: legend_additional_padding_upgrade.create.m.Description
    {
        en = "An additional set of padding crafted from thick furs. Worn atop armor to make the wearer more resilient against piercing attacks."
        es = "Un juego adicional de acolchado confeccionado con pieles gruesas. Se lleva sobre la armadura y hace a su portador más resistente a los ataques perforantes."
    }
    // context: legend_additional_padding_upgrade.create.m.ArmorDescription
