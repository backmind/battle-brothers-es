    // FILE: scripts\skills\actives\legend_wind_up_skill.nut
    // context: legend_wind_up_skill.create.m.Description
    {
        en = "Evaluate your enemy, preparing your next attack to push them back."
        es = "Evalúa a tu enemigo y prepara tu próximo ataque para hacerlo retroceder."
    }
    // context: legend_wind_up_skill.getTooltip.ret.push().text
    {
        en = "This character is already wound up."
        es = "Este personaje ya ha tomado impulso."
    }
    // context: legend_wind_up_skill.getTooltip.ret.push().text
    {
        en = "The next attack will push the enemy back and baffle them if it connects, otherwise the effect is wasted."
        es = "El próximo ataque hará retroceder al enemigo y lo desconcertará si impacta; de lo contrario, el efecto se pierde."
