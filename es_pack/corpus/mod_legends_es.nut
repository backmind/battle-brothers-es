    // context: legend_large_armor_piercing_bolts.create.m.Description
    {
        en = "A large quiver of bolts with thin piercing tips, designed for piercing armor, but doing less damage to flesh. Is automatically refilled after each battle if you have enough global ammunition. Grants 20% more armor piercing damage, but 10% less damage"
        es = "Un carcaj grande de virotes con finas puntas perforantes, diseñados para atravesar armaduras, pero que hacen menos daño a la carne. Se recarga automáticamente después de cada batalla si tienes suficiente munición en reserva. Otorga un 20% más de daño que ignora la armadura, pero un 10% menos de daño"
    }
    // FILE: scripts\items\ammo\legend_large_broad_head_arrows.nut
    // context: legend_large_broad_head_arrows.create.m.Name
