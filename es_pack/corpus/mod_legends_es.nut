        es = "Incluye una máscara de calavera elaborada con magia oscura."
    }
    // context: legend_named_warlock_skull.getTooltip.result.push().text
    {
        en = "Gain [color=%positive%]+10[/color] bonus to resolve in morale checks for every hit you took in the battle"
        es = "Obtienes [color=%positive%]+10[/color] de Resolución en las pruebas de moral por cada golpe recibido en la batalla"
    }
    // FILE: scripts\items\legend_helmets\runes\legend_rune_bravery.nut
    // context: legend_rune_bravery.create.m.Description
    {
        en = "An inscribed rock that can be attached to a character's helmet to increase the wearer's bravery."
        es = "Una piedra grabada que se puede fijar al casco de un personaje para aumentar la valentía de quien lo lleva."
    }
    // context: legend_rune_bravery.create.m.ArmorDescription
    {
        en = "Includes a bravery rune."
        es = "Incluye una runa de valentía."
    }
    // FILE: scripts\items\legend_helmets\runes\legend_rune_clarity.nut
    // context: legend_rune_clarity.create.m.Description
    {
        en = "An inscribed rock that can be attached to a character's helmet to increase the wearer's clarity."
        es = "Una piedra grabada que se puede fijar al casco de un personaje para aumentar la claridad de quien lo lleva."
    }
    // context: legend_rune_clarity.create.m.ArmorDescription
    {
        en = "Includes a clarity rune."
        es = "Incluye una runa de claridad."
    }
    // FILE: scripts\items\legend_helmets\runes\legend_rune_luck.nut
    // context: legend_rune_luck.create.m.Description
    {
        en = "An inscribed rock that can be attached to a character's helmet to increase the wearer's luck."
        es = "Una piedra grabada que se puede fijar al casco de un personaje para aumentar la suerte de quien lo lleva."
    }
    // context: legend_rune_luck.create.m.ArmorDescription
    {
        en = "Includes a luck rune."
