    // FILE: scripts\skills\actives\legend_evasion_skill.nut
    // context: legend_evasion_skill.create.m.Description
    {
        en = "%name% will move safely through any Zone of Control without incurring any free attacks and the first attack done against you will be automatically evaded. Can only be used if your total armor weight is 30 or less."
        es = "%name% se moverá con seguridad por cualquier zona de control sin provocar ataques gratuitos, y esquivará automáticamente el primer ataque que reciba. Solo se puede usar si el peso total de tu armadura es de 30 o menos."
