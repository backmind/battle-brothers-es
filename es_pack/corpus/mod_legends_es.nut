    // context: ::Legends.updatePerkGroupTooltips.strArray[strArray.len()-1]
    // en = "color=#0b0084]From the <mid + ap>"  // fragmento intermedio que el código vuelve a unir a la descripción (perk_tooltips.nut:52); nunca llega solo a la interfaz
    // context: ::Legends.updatePerkGroupTooltips.strArray[0].find()
    // en = "<strArray[0].find(color=)!=null>"  // condición de código: busca la clave interna "color=" con find(), no se muestra
    // FILE: mod_legends\compat.nut
    // context: text.::format()
    {
        // local text = ::format("%s(%s)<br>is NOT compatible and will crash your game.", name, mod.ID);
        mode = "pattern"
        en = "<name:str>(<id:str>)<br:str>is NOT compatible and will crash your game."
        es = "<name>(<id>)<br>NO es compatible y hará que el juego falle."
    }
    // context: 
    {
        // text += "<br>However, your version is newer than one we confirmed not working, it might work, but there's no guarantee."
        en = "<br>However, your version is newer than one we confirmed not working, it might work, but there's no guarantee."
        es = "<br>Sin embargo, tu versión es más reciente que la que confirmamos que no funciona; puede que funcione, pero no hay garantía."
    }
    // context: text.::format()
    {
        // local text = ::format("%s<br>is NOT compatible and will crash your game.", name);
        // DUDA: mismo problema del «<br>» literal en un patrón (la fusión rechaza la conversión). Propuesta de es: «<name><br>NO es compatible y hará que el juego falle.»
        mode = "pattern"
        en = "<name><br>is NOT compatible and will crash your game."
        es = ""
    }
    // context: text.::format()
    {
        // local text = ::format("%s(%s)<br>is compatible but might cause weird issues, use at your own risk.", name, mod.ID);
        mode = "pattern"
        en = "<name:str>(<id:str>)<br:str>is compatible but might cause weird issues, use at your own risk."
        es = "<name>(<id>)<br>es compatible, pero puede causar problemas extraños; úsalo bajo tu propio riesgo."
    }
    // context: text.::format()
    {
        // local text = ::format("%s(%s)<br>is NOT compatible, but has patch %s", name, mod.ID, mod.Patch);
        mode = "pattern"
        en = "<name:str>(<id:str>)<br:str>is NOT compatible, but has patch <patch:str>"
        es = "<name>(<id>)<br>NO es compatible, pero tiene el parche <patch>"
    }
    // context: text.::format()
    {
        // local text = ::format("%s(%s)<br>is NOT compatible, but has different version(s) that might work, check ", name, mod.ID);
        // DUDA: mismo problema del «<br>» literal en un patrón (la fusión rechaza la conversión). Propuesta de es: «<name>(<id>)<br>NO es compatible, pero tiene otras versiones que podrían funcionar; consulta »
        mode = "pattern"
        en = "<name>(<mod.ID>)<br>is NOT compatible, but has different version(s) that might work, check "
        es = ""
    }
    // context: ::Legends.Mod.Debug.addPopupMessage().::format()
    {
        // ::Legends.Mod.Debug.addPopupMessage(::format("%s is integrated into Legends, please remove it.", mod), ::MSU.Popup.State.Full);
        mode = "pattern"
        en = "<mod:str> is integrated into Legends, please remove it."
        es = "<mod> está integrado en Legends; quítalo, por favor."
    }
    // FILE: mod_legends\compat_defs.nut
