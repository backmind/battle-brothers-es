    // FILE: scripts\entity\world\camp\buildings\workshop_building.nut
    // context: workshop_building.create.m.Slot
    // en = "scrap"  // identificador interno del hueco del campamento (se usa para componer la ruta de la imagen), no se muestra
    // context: workshop_building.create.m.Name
    {
        en = "Salvage Tent"
        es = "Tienda de recuperación"
    }
    // context: workshop_building.create.m.Description
    {
        en = "Turn scrap into useable parts"
        es = "Convierte la chatarra en piezas aprovechables"
    }
    // context: workshop_building.getDescription
    {
        // @composicion: desc += ... (8 trozos).
        // La suma llega entera a Rosetta; los trozos de abajo no llegan nunca solos.
        en = "Repairing equipment takes tools. Break down and reuse equipment in your stash to create tools to repair other gear. Once an item reaches zero durability, it will be consumed and destroyed. Every 30 durability equals a tool. \n\nThe more people assigned to the tent, the quicker items will be salvaged. People with salvage skills increase the speed further.\n\nThe salvage tent can be upgraded by purchasing a salvage cart from a settlement merchant. An upgraded tent has a 15% increase in salvage speed and every 10 durability equals a tool.\n\nHolding Alt and right clicking on an item in your inventory can send it to your repair or salvage queues"
        es = "Reparar el equipo requiere herramientas. Desmonta y reaprovecha el equipo de tu almacén para crear herramientas con las que reparar otro equipo. Cuando un objeto llega a cero de durabilidad, se consume y se destruye. Cada 30 de durabilidad equivalen a una herramienta. \n\nCuantas más personas se asignen a la tienda, más rápido se desguazarán los objetos. Las personas con habilidades de desguace aumentan aún más la velocidad.\n\nLa tienda de desguace puede mejorarse comprando un carro de desguace a un mercader de algún asentamiento. Una tienda mejorada aumenta un 15% la velocidad de desguace y cada 10 de durabilidad equivalen a una herramienta.\n\nSi mantienes pulsado Alt y haces clic derecho sobre un objeto de tu inventario, puedes enviarlo a la cola de reparación o a la de desguace"
    }
    // context: workshop_building.getDescription.desc
    {
        // desc = desc + "Repairing equipment takes tools. Break down and reuse equipment in your stash to create tools to repair other gear. ";
        mode = "pattern"
        en = "<desc:str>Repairing equipment takes tools. Break down and reuse equipment in your stash to create tools to repair other gear. "
        es = "<desc>Reparar el equipo requiere herramientas. Desmonta y reaprovecha el equipo de tu almacén para crear herramientas con las que reparar otro equipo. "
    }
    // context: workshop_building.getDescription.desc
    {
        // desc = desc + "Once an item reaches zero durability, it will be consumed and destroyed. Every 30 durability equals a tool. ";
        mode = "pattern"
        en = "<desc:str>Once an item reaches zero durability, it will be consumed and destroyed. Every 30 durability equals a tool. "
        es = "<desc>Cuando un objeto llega a cero de durabilidad, se consume y se destruye. Cada 30 de durabilidad equivalen a una herramienta. "
    }
    // context: workshop_building.getDescription.desc
    {
        // desc = desc + "The more people assigned to the tent, the quicker items will be salvaged. People with salvage skills increase the speed further.";
        mode = "pattern"
        en = "<desc:str>The more people assigned to the tent, the quicker items will be salvaged. People with salvage skills increase the speed further."
        es = "<desc>Cuantas más personas se asignen a la tienda, más rápido se desguazarán los objetos. Las personas con habilidades de desguace aumentan aún más la velocidad."
    }
    // context: workshop_building.getDescription.desc
    {
        // desc = desc + "The salvage tent can be upgraded by purchasing a salvage cart from a settlement merchant. An upgraded tent has a 15% increase in salvage speed and every 10 durability equals a tool.";
        mode = "pattern"
        en = "<desc:str>The salvage tent can be upgraded by purchasing a salvage cart from a settlement merchant. An upgraded tent has a 15% increase in salvage speed and every 10 durability equals a tool."
        es = "<desc>La tienda de desguace puede mejorarse comprando un carro de desguace a un mercader de algún asentamiento. Una tienda mejorada aumenta un 15% la velocidad de desguace y cada 10 de durabilidad equivalen a una herramienta."
    }
    // context: workshop_building.getDescription.desc
    {
        // desc = desc + "Holding Alt and right clicking on an item in your inventory can send it to your repair or salvage queues";
        mode = "pattern"
        en = "<desc:str>Holding Alt and right clicking on an item in your inventory can send it to your repair or salvage queues"
        es = "<desc>Si mantienes pulsado Alt y haces clic derecho sobre un objeto de tu inventario, puedes enviarlo a la cola de reparación o a la de desguace"
    }
    // context: workshop_building.getModifierToolip.ret.text
    {
        // text = "There are [color=%positive%]" + nonNullEntries + "[/color] items in the salvage queue."
        mode = "pattern"
        en = "There are [color=%positive%]<count:int>[/color] items in the salvage queue."
        es = "Hay [color=%positive%]<count>[/color] objetos en la cola de desguace."
    }
    // context: workshop_building.getModifierToolip.ret.text
    {
        // text = "It will take [color=%positive%]" + this.getRequiredTime() + "[/color] hours to salvage all items in the queue."
        mode = "pattern"
        en = "It will take [color=%positive%]<hours:str>[/color] hours to salvage all items in the queue."
        es = "Desguazar todos los objetos de la cola llevará [color=%positive%]<hours>[/color] horas."
    }
    // context: workshop_building.getModifierToolip.ret.text
    {
        // text = "Total salvage modifier is [color=%positive%]" + mod.Craft + "[/color] units per hour."
        mode = "pattern"
        en = "Total salvage modifier is [color=%positive%]<mod:str>[/color] units per hour."
        es = "El modificador total de desguace es de [color=%positive%]<mod>[/color] unidades por hora."
    }
    // context: workshop_building.getResults.text
    {
        // text = "You created [color=" + this.Const.UI.Color.PositiveEventValue + "]" + this.Math.floor(this.m.ToolsCreated) + "[/color] units of tools and salvaged [color=" + this.Const.UI.Color.NegativeEventValue + "]" + this.m.ItemsDestroyed + "[/color] pieces of equipment."
        mode = "pattern"
        en = "You created [color=<color1:str>]<tools:int>[/color] units of tools and salvaged [color=<color2:str>]<items:int>[/color] pieces of equipment."
        es = "Has creado [color=<color1>]<tools>[/color] unidades de herramientas y has desguazado [color=<color2>]<items>[/color] piezas de equipo."
    }
    // context: workshop_building.getUpdateText
    {
        en = "No salvage queued"
        es = "Nada en la cola de desguace"
    }
    // context: workshop_building.getUpdateText
    {
        en = "Salvaged ... 100%"
        es = "Desguazado ... 100%"
    }
    // context: workshop_building.getUpdateText.text
    {
        // local text = "Salvaged ... " + percent + "%";
        mode = "pattern"
        en = "Salvaged ... <percent:str>%"
        es = "Desguazado ... <percent>%"
    }
    // context: workshop_building.getUpdateText
    {
        // return text + " (At max tools!)";
        mode = "pattern"
        en = "<text:str> (At max tools!)"
        es = "<text:t> (¡Herramientas al máximo!)"
    }
