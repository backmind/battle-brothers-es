        es = "\nEste objeto posee el poder del sello rúnico de Poder:\n[color=%positive%]+%bonus1%%[/color] de daño infligido en los ataques con esta arma.\n[color=%positive%]+%bonus2%[/color] de daño máximo en los ataques con esta arma.\n	"
