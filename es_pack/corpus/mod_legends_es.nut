        es = "\nEste objeto posee el poder del sello rúnico de Suerte:\n[color=%positive%]+3%[/color] a [color=%positive%]+%max1%%[/color] de probabilidad de que cualquier atacante necesite dos tiradas de ataque con éxito para acertar.\n	"
