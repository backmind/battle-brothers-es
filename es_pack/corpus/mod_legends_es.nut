    // FILE: scripts\entity\world\camp\buildings\fletcher_building.nut
    // context: fletcher_building.create.m.Slot
    // en = "fletch"  // identificador interno de la casilla del edificio en el campamento, no se muestra
    // context: fletcher_building.create.m.Description
    {
        en = "Make some ammo"
        es = "Fabrica munición"
    }
    // context: fletcher_building.getDescription
    {
        // @composicion: desc += ... (6 trozos).
        // La suma llega entera a Rosetta; los trozos de abajo no llegan nunca solos.
        en = "Arrows, bolts, little rocks (and Big Rocks!). The ammunition of war. Keep the company stocks full between battles by assigning some members of the company to the task of making ammo. Ammunition fabrication only occurs while encamped. The more people assigned, the more ammo crafted. \n\nThe Fletching tent can be upgraded by purchasing a crafting cart from a settlement merchant. An upgraded tent has a 15% increase in production speed. Additionally, there's a chance that ammunition of the disposable throwing kind will be crafted."
        es = "Flechas, virotes, piedrecitas (¡y Piedras Grandes!). La munición de la guerra. Mantén llenas las reservas de la compañía entre batallas asignando a algunos de sus miembros a la tarea de fabricar munición. La munición solo se fabrica mientras se está acampado. Cuantas más personas asignadas, más munición se fabrica. \n\nLa tienda de flechería puede mejorarse comprando un carro de fabricación a un mercader de algún asentamiento. Una tienda mejorada produce un 15% más rápido. Además, existe la posibilidad de fabricar munición arrojadiza desechable."
    }
    // context: fletcher_building.getDescription
    {
        en = "Arrows, bolts, little rocks (and Big Rocks!). The ammunition of war. "
        es = "Flechas, virotes, piedrecitas (¡y Piedras Grandes!). La munición de la guerra. "
    }
    // context: fletcher_building.getDescription
    {
        en = "Keep the company stocks full between battles by assigning some members of the company to the task of making ammo. "
        es = "Mantén llenas las reservas de la compañía entre batallas asignando a algunos de sus miembros a la tarea de fabricar munición. "
    }
    // context: fletcher_building.getDescription
    {
        en = "Ammunition fabrication only occurs while encamped. The more people assigned, the more ammo crafted. "
        es = "La munición solo se fabrica mientras se está acampado. Cuantas más personas asignadas, más munición se fabrica. "
    }
    // context: fletcher_building.getDescription
    {
        en = "The Fletching tent can be upgraded by purchasing a crafting cart from a settlement merchant. An upgraded tent has a 15% increase in production speed. "
        es = "La tienda de flechería puede mejorarse comprando un carro de fabricación a un mercader de algún asentamiento. Una tienda mejorada produce un 15% más rápido. "
    }
    // context: fletcher_building.getDescription
    {
        en = "Additionally, there's a chance that ammunition of the disposable throwing kind will be crafted."
        es = "Además, existe la posibilidad de fabricar munición arrojadiza desechable."
    }
    // context: fletcher_building.getModifierToolip.ret.text
    {
        // text = "Produces [color=%positive%]" + mod.Craft / 2.0 + "[/color] units of ammo per hour."
        mode = "pattern"
        en = "Produces [color=%positive%]<rate:str>[/color] units of ammo per hour."
        es = "Produce [color=%positive%]<rate>[/color] unidades de munición por hora."
    }
    // context: fletcher_building.getModifierToolip.ret.push().text
    // en = "[color=%positive%]<bro[0]/2.0>[/color] units/hour <bro[1]> (<bro[2]>)"  // cubierto por el patrón "[color=%positive%]<rate:str>[/color] units/hour <name:str> (<bg:str>)"
    // context: fletcher_building.getResults.res.push().text
