    // context: healer_building.getResults.res.push().text
    {
        // text = "You used [color=" + this.Const.UI.Color.NegativeEventValue + "]" + this.Math.floor(this.m.MedsUsed) + "[/color] units of medicine and treated [color=" + this.Const.UI.Color.PositiveEventValue + "]" + this.m.InjuriesTreated + "[/color] injuries."
        mode = "pattern"
        en = "You used [color=<neg:str>]<meds:int>[/color] units of medicine and treated [color=<pos:str>]<treated:int>[/color] injuries."
        es = "Has usado [color=<neg>]<meds>[/color] unidades de medicina y tratado [color=<pos>]<treated>[/color] heridas."
    }
    // context: healer_building.getResults.res.push().text
    {
        // text = b.getName() + " healed [color=" + this.Const.UI.Color.PositiveEventValue + "]" + this.Math.floor(b.getCampHealing()) + "[/color] points."
        mode = "pattern"
        en = "<name:str> healed [color=<pos:str>]<points:int>[/color] points."
