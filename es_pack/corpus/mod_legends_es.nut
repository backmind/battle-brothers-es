    // FILE: scripts\skills\perks\perk_legend_ambidextrous.nut
    // context: perk_legend_ambidextrous.getTooltip.ret.text
    {
        en = "Fluid"
        es = "Fluido"
    }
    // context: perk_legend_ambidextrous.getTooltip.ret.text
    {
        en = "Fluid like water!\n\nThis character will follow up main hand attacks with an attack from their off hand, if possible."
        es = "¡Fluido como el agua!\n\nSi es posible, este personaje encadenará un ataque con la mano secundaria a cada ataque con la mano principal."
    }
    // context: perk_legend_ambidextrous.getTooltip.ret.push().text
