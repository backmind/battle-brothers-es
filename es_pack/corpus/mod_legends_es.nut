        // Un solo grupo cuyo nombre no traduce el :t.
        en = "Activating this Perk will grant the following Perk Group:\n[color=#0b0084]Sword[/color]"
        es = "Activar esta ventaja otorgará el siguiente grupo de ventajas:\n[color=#0b0084]Espada[/color]"
    }
    // context: perk_legend_adaptive.getUnactivatedPerkTooltipHints
    {
