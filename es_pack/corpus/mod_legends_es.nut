    // en = "dirt"
    // FILE: mod_legends\!!config\contract_template__flavors_items.nut
    // context: ::Legends.ContractTemplate.Items.FlavorCampHuman.AcceptButton
    {
        en = "{ I accept your offer. }"
        es = "{ Acepto la oferta. }"
    }
    // context: ::Legends.ContractTemplate.Items.FlavorCampHuman.MoreButton
    {
        en = "{ We need to be paid more for this. | We need more loot if we're to do it. }"
        es = "{ Necesitamos que nos paguen más por esto. | Si vamos a hacerlo, necesitamos más botín. }"
    }
    // context: ::Legends.ContractTemplate.Items.FlavorCampHuman.SomethingElseButton
    {
        en = "{ I don't like it, how about something else? }"
        es = "{ No me gusta, ¿qué tal otra cosa? }"
    }
    // context: ::Legends.ContractTemplate.Items.FlavorCampHuman.DeclineButton
    {
        en = "{ Forget it, this isn't worth it. | What a waste of time. }"
        es = "{ Olvídalo, esto no vale la pena. | Qué pérdida de tiempo. }"
    }
    // context: ::Legends.ContractTemplate.Items.FlavorCampHuman.FailedButton
    {
        en = "{ We won't risk our lives for such meager pay... }"
        es = "{ No vamos a arriesgar la vida por una paga tan miserable... }"
    }
    // context: ::Legends.ContractTemplate.Items.FlavorCampHuman.IsNegotiatingText
    {
        en = "[img]gfx/ui/events/event_04.png[/img]{%They_employer% nods.%SPEECH_ON%Yes. Good. I was thinking about payment for your task earlier. | %They_employer% straightens up.%SPEECH_ON%So, payment. | %They_employer% smiles.%SPEECH_ON%This will make you rich, my friend. | %They_employer% takes a deep breath.%SPEECH_ON%Very well, this is what I'm prepared to offer you. | %They_employer% puts %their_employer% hand on your shoulder, smiling reaffirmingly.%SPEECH_ON%I think I know an adequate compensation for your services. | %They_employer% gesticulates with %their_employer% hands, pointing at %their_employer% fingers as if counting something, but it means nothing to you.%SPEECH_ON%Judging from experience, this is good payment for the task. | %They_employer% nods. %SPEECH_ON%You look able, so I am willing to pay quite a bit. | %They_employer% opens the palm of %their_employer% hands.%SPEECH_ON%I'm tight on crowns, so before you ask, this is all I have right now. | %SPEECH_ON%Rest assured that what I'm offering you now is a fine prize for your work.} "
        es = "[img]gfx/ui/events/event_04.png[/img]{Asiente.%SPEECH_ON%Sí. Bien. Hace un rato estaba pensando en el pago por tu tarea. | Se endereza.%SPEECH_ON%Entonces, el pago. | Sonríe.%SPEECH_ON%Esto te hará rico, amigo mío. | Respira profundamente.%SPEECH_ON%Muy bien, esto es lo que puedo ofrecerte. | Te pone la mano en el hombro con una sonrisa tranquilizadora.%SPEECH_ON%Creo que sé cuál es una compensación adecuada por tus servicios. | Gesticula con las manos y se señala los dedos como si contara algo, pero a ti no te dice nada.%SPEECH_ON%Por experiencia, esta es una buena paga por la tarea. | Asiente. %SPEECH_ON%Pareces capaz, así que estoy dispuest%o_employer% a pagar bastante. | Abre las palmas de las manos.%SPEECH_ON%No me sobran las coronas, así que, antes de que lo preguntes, esto es todo lo que tengo ahora mismo. | %SPEECH_ON%Ten la certeza de que lo que te ofrezco ahora es una buena recompensa por tu trabajo.} "
    }
    // context: ::Legends.ContractTemplate.Items.FlavorCampHuman.FinalOfferText
    {
        // corrige base: "Te cuento cómo te pagan" no traduce "I tell you how you're getting paid", que significa que quien decide el pago es él; queda "Aquí quien decide cómo se te paga soy yo".
        en = "[img]gfx/ui/events/event_04.png[/img]{%SPEECH_START%I refuse to pay any more for this.  | %SPEECH_START%Be reasonable.  | %SPEECH_START%No, no, no.  | %SPEECH_START%Who do you think you are? I tell you how you're getting paid.  | %They_employer% just looks at you sternly and shakes %their_employer% head.%SPEECH_ON% | %SPEECH_START%No, you are already getting more than you're worth.  | %SPEECH_START%No. Do not push me too far!  | %SPEECH_START%I don't think you quite understand how this works. We need to come to terms if you want to be paid for this. My offer still stands. }"
        es = "[img]gfx/ui/events/event_04.png[/img]{%SPEECH_START%Me niego a pagar más por esto.  | %SPEECH_START%Sé razonable.  | %SPEECH_START%No, no, no.  | %SPEECH_START%¿Quién te crees que eres? Aquí quien decide cómo se te paga soy yo.  | Simplemente te mira con severidad y niega con la cabeza.%SPEECH_ON% | %SPEECH_START%No, ya estás obteniendo más de lo que vales.  | %SPEECH_START%No. ¡No me presiones demasiado!  | %SPEECH_START%No creo que entiendas muy bien cómo funciona esto. Necesitamos llegar a un acuerdo si quieres que te pague por esto. Mi oferta sigue en pie. }"
    }
    // context: ::Legends.ContractTemplate.Items.FlavorCampHuman.GiveMoreText
    {
        // corrige base: "¿Esto es entonces?" es un calco que no se entiende; "This is it then?" es "¿Así que esto es todo?". También se recolocan los espacios de las dos primeras barras para igualarlos al inglés.
        en = "[img]gfx/ui/events/event_04.png[/img]{%SPEECH_START%This is it then?  | %They_employer% takes a deep breath.%SPEECH_ON% | %They_employer% sighs.%SPEECH_ON% | %SPEECH_START%Fair enough.  | %SPEECH_START%Fine, fine.  | %SPEECH_START%If it must be. | %SPEECH_START%Fine. How about this?  | %SPEECH_START%Sure, sure, I understand.  | %SPEECH_START%Reasonable.  | %SPEECH_START%Interesting. I think this would be more appropiate then.  | %SPEECH_START%Would you take this instead?  | %SPEECH_START%Let me make the following offer.  | %SPEECH_ON%Fair. Would you accept this instead?  | %SPEECH_START%Very well. Given your demands I offer you this.  | %SPEECH_START%Let's get this over with quickly. Here is my new offer.  | %SPEECH_START%We're all friends here, aren't we? Let's see... }"
        es = "[img]gfx/ui/events/event_04.png[/img]{%SPEECH_START%¿Así que esto es todo?  | Respira profundamente.%SPEECH_ON% | Suspira.%SPEECH_ON% | %SPEECH_START%Es justo.  | %SPEECH_START%Bien, bien.  | %SPEECH_START%Si es necesario. | %SPEECH_START%Bien. ¿Qué tal esto?  | %SPEECH_START%Claro, claro, lo entiendo.  | %SPEECH_START%Razonable.  | %SPEECH_START%Interesante. Creo que esto sería más apropiado entonces.  | %SPEECH_START%¿Aceptarías esto en su lugar?  | %SPEECH_START%Permíteme hacerte la siguiente oferta.  | %SPEECH_ON%Aceptable. ¿Aceptarías esto en su lugar?  | %SPEECH_START%Muy bien. Ante tus exigencias te ofrezco esto.  | %SPEECH_START%Terminemos con esto rápidamente. Aquí está mi nueva oferta.  | %SPEECH_START%Todos somos amigos aquí, ¿no? Vamos a ver... }"
    }
    // context: ::Legends.ContractTemplate.Items.FlavorCampHuman.DeclineText
    {
        // corrige base: "the only ones" va en plural (la compañía), no "Actúas como si fueras el único".
        // corrige base: "in the first place" es "desde un principio", no "En primer lugar".
        // corrige base: "I can only be pushed so far" es que todo tiene un límite, no "solo puedo dejarme llevar hasta cierto punto".
        // corrige base: "I'll take my leave" es "Me retiro" (se va él), no "Largo".
        // corrige base: "until you learned some reason" es "hasta que hayas entrado en razón", no "sin algún motivo".
        en = "[img]gfx/ui/events/event_74.png[/img]{%SPEECH_START%You act as if you were the only ones to hold a sword for coin. I think I'll look elsewhere for the men I need. Good day.%SPEECH_OFF% | %SPEECH_START%My patience has limits, too, and I think I'm wasting my time here.%SPEECH_OFF% | %SPEECH_START%I've had enough of this! I'm sure I'll find someone else to do the job!%SPEECH_OFF% | %SPEECH_START%Do not insult my intelligence! Forget about this contract. We're done.%SPEECH_OFF% | %Their_employer% face turns red with anger.%SPEECH_ON%Get out of here, I'm not in the habit of making deals with greedy devils!%SPEECH_OFF% | %They_employer% sighs. %SPEECH_ON%Just... forget it. I shouldn't have trusted you in the first place. Leave me so I can look for other, more sensible men.%SPEECH_OFF% | %SPEECH_START%I really thought we had a good relationship here. But know that I can only be pushed so far. I don't think this is working out. I'll take my leave.%SPEECH_OFF% | %SPEECH_ON%This has been an utter waste of time for me. Don't bother coming back until you learned some reason.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_74.png[/img]{%SPEECH_START%Actúan como si fueran los únicos que empuñan una espada a cambio de monedas. Creo que buscaré en otra parte a los hombres que necesito. Buen día.%SPEECH_OFF% | %SPEECH_START%Mi paciencia también tiene límites y creo que estoy perdiendo el tiempo aquí.%SPEECH_OFF% | %SPEECH_START%¡Ya tuve suficiente de esto! ¡Seguro que encontraré a alguien más que haga el trabajo!%SPEECH_OFF% | %SPEECH_START%¡No insultes mi inteligencia! Olvídate de este contrato. Hemos terminado.%SPEECH_OFF% | Su cara se pone roja de ira.%SPEECH_ON%¡Fuera de aquí, no tengo la costumbre de hacer tratos con demonios codiciosos!%SPEECH_OFF% | Suspira. %SPEECH_ON%Solo... olvídalo. Nunca debí confiar en ti. Déjame, que tengo que buscar otros hombres más sensatos.%SPEECH_OFF% | %SPEECH_START%Realmente pensé que teníamos una buena relación aquí. Pero debes saber que todo tiene un límite. No creo que esto esté funcionando. Me retiro.%SPEECH_OFF% | %SPEECH_ON%Esto ha sido una total pérdida de tiempo para mí. No te molestes en volver hasta que hayas entrado en razón.%SPEECH_OFF%}"
    }
    // context: ::Legends.ContractTemplate.Items.FlavorCampHuman.SingleOfferAppendix
    {
        en = "{You'll get | You are to receive | You'll be paid with | It's} this item from my private collection when the contract is done.%SPEECH_OFF%"
        es = "{Obtendrás | Vas a recibir | Se te pagará con | Es} este objeto de mi colección privada cuando se finalice el contrato.%SPEECH_OFF%"
    }
    // context: ::Legends.ContractTemplate.Items.FlavorCampHuman.MultipleOfferAppendix
    {
        en = "{You'll get | You are to receive | You'll be paid | It's} this pile of %reward_item_count% items when the contract is done.%SPEECH_OFF%"
        es = "{Obtendrás | Vas a recibir | Se te pagará con | Es} este montón de %reward_item_count% objetos cuando se finalice el contrato.%SPEECH_OFF%"
    }
    // context: ::Legends.ContractTemplate.Items.FlavorCampHuman.NoOfferAppendix
    {
        en = "{You'll be paid nothing. Is that what you want?%SPEECH_OFF%}"
        es = "{No se te pagará nada. ¿Es eso lo que quieres?%SPEECH_OFF%}"
    }
    // context: ::Legends.ContractTemplate.Items.FlavorCampHuman.combinado
    {
        // contract_template_items.nut concatena la entrada y el apéndice; este par es la suma de los dos.
        en = "[img]gfx/ui/events/event_04.png[/img]{%They_employer% nods.%SPEECH_ON%Yes. Good. I was thinking about payment for your task earlier. | %They_employer% straightens up.%SPEECH_ON%So, payment. | %They_employer% smiles.%SPEECH_ON%This will make you rich, my friend. | %They_employer% takes a deep breath.%SPEECH_ON%Very well, this is what I'm prepared to offer you. | %They_employer% puts %their_employer% hand on your shoulder, smiling reaffirmingly.%SPEECH_ON%I think I know an adequate compensation for your services. | %They_employer% gesticulates with %their_employer% hands, pointing at %their_employer% fingers as if counting something, but it means nothing to you.%SPEECH_ON%Judging from experience, this is good payment for the task. | %They_employer% nods. %SPEECH_ON%You look able, so I am willing to pay quite a bit. | %They_employer% opens the palm of %their_employer% hands.%SPEECH_ON%I'm tight on crowns, so before you ask, this is all I have right now. | %SPEECH_ON%Rest assured that what I'm offering you now is a fine prize for your work.} {You'll get | You are to receive | You'll be paid with | It's} this item from my private collection when the contract is done.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_04.png[/img]{Asiente.%SPEECH_ON%Sí. Bien. Hace un rato estaba pensando en el pago por tu tarea. | Se endereza.%SPEECH_ON%Entonces, el pago. | Sonríe.%SPEECH_ON%Esto te hará rico, amigo mío. | Respira profundamente.%SPEECH_ON%Muy bien, esto es lo que puedo ofrecerte. | Te pone la mano en el hombro con una sonrisa tranquilizadora.%SPEECH_ON%Creo que sé cuál es una compensación adecuada por tus servicios. | Gesticula con las manos y se señala los dedos como si contara algo, pero a ti no te dice nada.%SPEECH_ON%Por experiencia, esta es una buena paga por la tarea. | Asiente. %SPEECH_ON%Pareces capaz, así que estoy dispuest%o_employer% a pagar bastante. | Abre las palmas de las manos.%SPEECH_ON%No me sobran las coronas, así que, antes de que lo preguntes, esto es todo lo que tengo ahora mismo. | %SPEECH_ON%Ten la certeza de que lo que te ofrezco ahora es una buena recompensa por tu trabajo.} {Obtendrás | Vas a recibir | Se te pagará con | Es} este objeto de mi colección privada cuando se finalice el contrato.%SPEECH_OFF%"
    }
    // context: ::Legends.ContractTemplate.Items.FlavorCampHuman.combinado
