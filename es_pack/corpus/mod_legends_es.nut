    // context: legend_harvest_skill.create.m.Description
    {
        // corrige base: «para golpea» es una errata; debe ser «que golpea» (el inglés dice "an arc that hits")
        en = "Swinging the weapon in an arc that hits two adjacent tiles in counter-clockwise order. Be careful around your own men unless you want to relieve your payroll!"
        es = "Balancea el arma en un arco que golpea dos casillas adyacentes en el sentido contrario a las agujas del reloj. ¡Ten cuidado con tus propios hombres a menos que quieras aliviar tu nómina!"
    }
    // context: legend_harvest_skill.getTooltip.ret.push().text
    {
        en = "Inflicts [color=%damage%]20%[/color] more damage against bleeding enemies"
        es = "Inflige un [color=%damage%]20%[/color] más de daño contra enemigos que sangran"
    }
    // FILE: scripts\skills\actives\legend_harvest_tree_skill.nut
    // context: legend_harvest_tree_skill.create.m.Description
