    // FILE: scripts\skills\legend_favoured_enemy_skill.nut
    // context: legend_favoured_enemy_skill.getTooltip.resp.text
    {
        // text = "" + stats.HitChance + "% / " + "25%",
        mode = "pattern"
        en = "<hit:int>% / 25%"
        es = "<hit>% / 25%"
    }
    // context: legend_favoured_enemy_skill.getTooltip.resp.text
    {
        // text = "[color=%positive%]+" + stats.HitChance + "%[/color] Melee Skill due to being a favored enemy"
        mode = "pattern"
        en = "[color=%positive%]+<hit:int>%[/color] Melee Skill due to being a favored enemy"
        es = "[color=%positive%]+<hit>%[/color] de Habilidad cuerpo a cuerpo por ser un enemigo predilecto"
    }
    // context: legend_favoured_enemy_skill.getTooltip.resp.text
    {
        // text = "[color=%positive%]+" + stats.HitChance + "%[/color] Ranged Skill due to being a favored enemy"
        mode = "pattern"
        en = "[color=%positive%]+<hit:int>%[/color] Ranged Skill due to being a favored enemy"
        es = "[color=%positive%]+<hit>%[/color] de Habilidad a distancia por ser un enemigo predilecto"
    }
    // context: legend_favoured_enemy_skill.getTooltip.resp.text
    {
        // text = "[color=%positive%]+" + stats.HitChance + "%[/color] Max Damage due to being a favored enemy"
        mode = "pattern"
        en = "[color=%positive%]+<hit:int>%[/color] Max Damage due to being a favored enemy"
        es = "[color=%positive%]+<hit>%[/color] de daño máximo por ser un enemigo predilecto"
    }
    // context: legend_favoured_enemy_skill.getTooltip.resp.push().text
    {
        // text = "[color=%positive%]+" + this.Math.floor((this.m.BraveryMult - 1.0) * 100.0) + "%[/color] Resolve due to being a favored enemy"
        mode = "pattern"
        en = "[color=%positive%]+<bonus:int>%[/color] Resolve due to being a favored enemy"
        es = "[color=%positive%]+<bonus>%[/color] de Resolución por ser un enemigo predilecto"
    }
    // context: legend_favoured_enemy_skill.getTooltip.resp.push().text
    {
        // text = ::Const.UI.getColorized(stats.Kills,::Const.UI.Color.getHighlightLightBackgroundValue()) + " favored enemy kills"
        mode = "pattern"
        en = "<kills:str> favored enemy kills"
        es = "<kills> enemigos predilectos abatidos"
    }
    // context: legend_favoured_enemy_skill.getUnactivatedPerkTooltipHints.killsText.format()
    {
        // killsText = format("This character has already made %s favored enemy kills", ::Const.UI.getColorized(stats.Kills,::Const.UI.Color.getHighlightLightBackgroundValue()));
        mode = "pattern"
        en = "This character has already made <kills:str> favored enemy kills"
        es = "Este personaje ya ha abatido a <kills> enemigos predilectos"
    }
    // context: legend_favoured_enemy_skill.getUnactivatedPerkTooltipHints.killsText.format()
    {
        // killsText = format("This character has not made any favored enemy kills yet");
        en = "This character has not made any favored enemy kills yet"
        es = "Este personaje aún no ha abatido a ningún enemigo predilecto"
    }
    // context: legend_favoured_enemy_skill.getUnactivatedPerkTooltipHints.ret.text.format()
    {
        // text = format("Activating this perk will grant a %s bonus to the relevant stats", ::Const.UI.getColorized("+" + stats.HitChance + "%", ::Const.UI.Color.PositiveValue))
        mode = "pattern"
        en = "Activating this perk will grant a <bonus:str> bonus to the relevant stats"
        es = "Activar esta ventaja otorgará una bonificación de <bonus> a los atributos correspondientes"
    }
    // context: legend_favoured_enemy_skill.onGetHitFactors._tooltip.push().text.format()
    {
        // text = format("[color=%s]%s%%[/color] Favoured Enemy (also grants [color=%s]+%s%%[/color] max damage)", PositiveValue, HitChance, PositiveValue, HitChance)
        // format() convierte "%%" en "%". Con val, que ya lleva signo y %, la clave de la regla es Favoured y no un % suelto.
        mode = "pattern"
        en = "[color=<c1:str>]<hit:val>[/color] Favoured Enemy (also grants [color=<c2:str>]<dmg:val>[/color] max damage)"
        es = "[color=<c1>]<hit>[/color] Enemigo predilecto (además otorga [color=<c2>]<dmg>[/color] de daño máximo)"
    }
    // FILE: scripts\skills\perks\perk_legend_adaptive.nut
    // context: perk_legend_adaptive.getUnactivatedPerkTooltipHints.descText
    {
        en = "Activating this Perk will grant the following Perk Group:\n"
        es = "Activar esta ventaja otorgará el siguiente grupo de ventajas:\n"
    }
    // context: perk_legend_adaptive.getUnactivatedPerkTooltipHints.descText
    {
        en = "Activating this Perk will randomly grant one of the following Perk Groups:\n"
        es = "Activar esta ventaja otorgará al azar uno de los siguientes grupos de ventajas:\n"
    }
    // context: perk_legend_adaptive.getUnactivatedPerkTooltipHints
    {
        // text = descText + possibleTreesText; los trozos nunca llegan solos. El color va como tag (ver updatePerkGroupTooltips).
        mode = "pattern"
        en = "Activating this Perk will grant the following Perk Group:\n<c:tag><g:str>[/color]"
        es = "Activar esta ventaja otorgará el siguiente grupo de ventajas:\n<c><g:t>[/color]"
    }
    // context: perk_legend_adaptive.getUnactivatedPerkTooltipHints
    {
        // 2 grupos.
        mode = "pattern"
        en = "Activating this Perk will randomly grant one of the following Perk Groups:\n<c:tag><g1:str>, or <g2:str>[/color]"
        es = "Activar esta ventaja otorgará al azar uno de los siguientes grupos de ventajas:\n<c><g1:t> o <g2:t>[/color]"
    }
    // context: perk_legend_adaptive.getUnactivatedPerkTooltipHints
    {
        // 3 grupos. Con 2 o más grupos la línea la rehace el enganche de perk_legend_adaptive (legends.nut), que también cubre las listas de rasgos de 4 o más; estas reglas quedan de respaldo.
        mode = "pattern"
        en = "Activating this Perk will randomly grant one of the following Perk Groups:\n<c:tag><g1:str>, <g2:str>, or <g3:str>[/color]"
        es = "Activar esta ventaja otorgará al azar uno de los siguientes grupos de ventajas:\n<c><g1:t>, <g2:t> o <g3:t>[/color]"
    }
    // context: perk_legend_adaptive.getUnactivatedPerkTooltipHints
