        en = "Have at least one of the following backgrounds: Herbalist, Taxidermist, Druid, Alchemist"
        es = "Tener al menos uno de los siguientes trasfondos: Herbolario, Taxidermista, Druida, Alquimista"
    }
    // FILE: mod_legends\hooks\retinue\followers\blacksmith_follower.nut
    // context: blacksmith_follower.o.create.m.Name
    {
        en = "Blacksmith's Tools"
        es = "Herramientas del herrero"
    }
    // context: blacksmith_follower.o.create.m.Description
    {
        en = "Mercenaries are good at getting arms and armor destroyed, but not at maintaining them. Promoting someone to the Blacksmith role and buying them the needed equipment will take care of this tedious task quickly and efficiently, and can mend even equipment otherwise thought lost."
        es = "Los mercenarios son buenos destruyendo armas y armaduras, pero no manteniéndolas. Si asciendes a alguien al puesto de Herrero y le compras el equipo necesario, esta tediosa tarea se hará de forma rápida y eficiente, e incluso se podrán reparar equipos que de otro modo se considerarían perdidos."
    }
    // context: blacksmith_follower.o.create.m.Effects
    {
        en = "Repairs all armor, helmets, weapons and shields worn by your men even if they're broken or lost because your man died"
        es = "Repara todas las armaduras, cascos, armas y escudos que lleven tus hombres, aunque estén rotos o se hayan perdido porque su portador murió"
    }
    // context: blacksmith_follower.o.create.m.Effects
    {
        en = "Increases repair speed by 33%"
        es = "Aumenta la velocidad de reparación en 33%"
    }
    // context: blacksmith_follower.o.create.addSkillRequirement()
    {
        en = "Have a mercenary who has taken the Field Repairs perk. Guaranteed on Blacksmiths, Ironmongers, and Crusaders"
        es = "Tener un mercenario que haya elegido la ventaja Reparaciones de campaña. Garantizado en Herreros, Ferreteros y Cruzados"
    }
    // FILE: mod_legends\hooks\retinue\followers\bounty_hunter_follower.nut
    // context: bounty_hunter_follower.o.create.m.Name
    {
        en = "Bounty Board"
        es = "Tablón de recompensas"
    }
    // context: bounty_hunter_follower.o.create.m.Description
    {
        en = "A well maintained bounty board can keep everyone up to date on which heads they should be taking after a battle."
        es = "Un tablón de recompensas bien cuidado mantiene a todos al tanto de qué cabezas deben cobrarse tras una batalla."
    }
