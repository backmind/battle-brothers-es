    // FILE: scripts\skills\perks\perk_legend_blend_in.nut
    // context: perk_legend_blend_in.getDescription
    {
        en = "Hold yourself in a way that makes you seem more trouble than its worth, lean into trees, place objects between you and an enemy, and hide behind allies."
        es = "Compórtate de forma que parezcas más problema de lo que vales: apóyate en los árboles, pon objetos entre tú y el enemigo y escóndete detrás de tus aliados."
    }
    // context: perk_legend_blend_in.getTooltip.tooltip.text
    {
        en = "[color=%positive%]+3[/color] Melee Defense."
        es = "[color=%positive%]+3[/color] de Defensa cuerpo a cuerpo."
    }
    // context: perk_legend_blend_in.getTooltip.tooltip.text
    {
        en = "[color=%positive%]+5[/color] Ranged Defense."
        es = "[color=%positive%]+5[/color] de Defensa a distancia."
    }
    // context: perk_legend_blend_in.getTooltip.tooltip.text
    {
        en = "Makes enemies less likely to attack you instead of an ally."
        es = "Hace menos probable que los enemigos te ataquen a ti en lugar de a un aliado."
