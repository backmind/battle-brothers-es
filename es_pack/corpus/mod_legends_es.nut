        es = "Da a los cocineros más tiempo para preparar mejor comida.\n\nDuplica la probabilidad de obtener alimentos mejorados, pero aumenta el tiempo de recolección y de caza en torno a un <pct>"
    }
    // context: ::Legends.getEncounterUIData.::Legends.Mod.Tooltips.setTooltips().CampingHuntingMode.Brew.::MSU.Class.BasicTooltip().format()
    {
