        // text = "Gaining an additional [color=%positive%]" + this.m.BasicsStacks * 5 + "[/color] melee defense."
        mode = "pattern"
        en = "Gaining an additional [color=%positive%]<bonus:int>[/color] melee defense."
        es = "Obtiene [color=%positive%]<bonus>[/color] de Defensa cuerpo a cuerpo adicional."
    }
    // context: perk_legend_back_to_basics.getTooltip.tooltip.push().text
    {
        en = "If this character take damage, they have a chance to rally. The chance is equal to half their resolve."
        es = "Si este personaje recibe daño, tiene una probabilidad de recobrar la moral. La probabilidad es igual a la mitad de su Resolución."
    }
    // FILE: scripts\skills\perks\perk_legend_backswing.nut
    // context: perk_legend_backswing.getDescription
    {
        en = "Use your built up inertia to wreak havoc on the next swing."
        es = "Aprovecha la inercia acumulada para causar estragos en el siguiente golpe."
    }
    // FILE: scripts\skills\perks\perk_legend_balance.nut
    // context: perk_legend_balance.create.m.Description
    {
        en = "%name% gains increased Melee and Ranged defense by balancing %their% armor weight."
        es = "%name% obtiene más Defensa cuerpo a cuerpo y a distancia al equilibrar el peso de su armadura."
    }
    // context: perk_legend_balance.getTooltip.text
    // en = "[color=%positive%]+<this.Math.max(0, this.m.BonusMax-bonus)>[/color] Ranged Defense"  // cubierto por el patrón "[color=%positive%]+<bonus:int>[/color] Ranged Defense"
    // FILE: scripts\skills\perks\perk_legend_barrage.nut
