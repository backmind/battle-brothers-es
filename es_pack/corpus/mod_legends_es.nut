    // en base_es
    // FILE: mod_legends\hooks\entity\world\settlements\situations\abducted_children_situation.nut
    // context: abducted_children_situation.o.create.m.Description
    {
        en = "Children have been disappearing from this settlement. Distrust and fear rule the streets and are slowly poisoning the community. The Witch Hunters have come to investigate."
        es = "Los niños han ido desapareciendo de este asentamiento. La desconfianza y el miedo dominan las calles y poco a poco están envenenando a la comunidad. Los Cazadores de brujas han venido a investigar."
    }
    // context: abducted_children_situation.o.create.m.Rumors.push()
    {
        // this.m.Rumors.push("You didn\'t hear this from me, but a bunch of pompous-looking Witch Hunters stopped by on their way to %settlement% a few days ago. One of them was yammering on about the punishment due for those who consort with witches!");
        mode = "pattern"
        en = "You didn't hear this from me, but a bunch of pompous-looking Witch Hunters stopped by on their way to %settlement% a few days ago. One of them was yammering on about the punishment due for those who consort with witches!"
        es = "Esto no lo has oído de mí, pero hace unos días pasó por aquí un grupo de Cazadores de brujas con aires de importancia, de camino a %settlement%. ¡Uno de ellos no paraba de parlotear sobre el castigo que merecen quienes tratan con brujas!"
    }
    // FILE: mod_legends\hooks\entity\world\settlements\situations\ambushed_trade_routes_situation.nut
    // context: ambushed_trade_routes_situation.o.create.m.Description
    {
        en = "The roads leading here are unsafe of late, and many a caravan has been ambushed and plundered. With little successful trade, the selection of goods is lower and the prices higher. Former traders and caravan hands may be looking for new jobs. Upon resolution this will refresh the hiring roster in town."
        es = "Los caminos que llevan hasta aquí son inseguros últimamente, y muchas caravanas han sido emboscadas y saqueadas. Con tan poco comercio que llegue a buen puerto, hay menos variedad de mercancías y los precios son más altos. Puede que antiguos comerciantes y caravaneros busquen un nuevo trabajo. Cuando se resuelva, se renovarán los reclutas disponibles en la ciudad."
    }
    // FILE: mod_legends\hooks\entity\world\settlements\situations\disappearing_villagers_situation.nut
    // context: disappearing_villagers_situation.o.create.m.Description
    {
        en = "Villagers have been disappearing from this town, putting everyone on edge. Fewer locals are to be found on the streets, the belongings of the disappeared have somehow appeared in the markets. Enterprising Ratcatchers and Beast Slayers have also turned up, offering to hunt down the beasts plaguing the settlement in exchange for coin."
        es = "Han estado desapareciendo aldeanos de esta ciudad, y todo el mundo anda con los nervios de punta. Se ven menos lugareños por las calles, y las pertenencias de los desaparecidos han aparecido, quién sabe cómo, en los mercados. También se han presentado Cazadores de ratas y Cazadores de bestias con espíritu emprendedor, que se ofrecen a dar caza por dinero a las bestias que asolan el asentamiento."
    }
    // context: disappearing_villagers_situation.o.create.m.Rumors.push()
    {
        // this.m.Rumors.push("If ye are of the beast hunting sort, there\'s been talk of crowns to be made at %settlement% on account of the beast attacks there. Why, many a ratcatcher or so-called beast slayer has stopped by here on their way there. Fools, all of them!");
        mode = "pattern"
        en = "If ye are of the beast hunting sort, there's been talk of crowns to be made at %settlement% on account of the beast attacks there. Why, many a ratcatcher or so-called beast slayer has stopped by here on their way there. Fools, all of them!"
        es = "Si eres de los que cazan bestias, se habla de que hay coronas que ganar en %settlement% por los ataques de bestias de allí. Vaya, si por aquí han pasado montones de cazarratas y supuestos cazadores de bestias de camino hacia allá. ¡Necios, todos ellos!"
    }
    // FILE: mod_legends\hooks\entity\world\settlements\situations\greenskins_situation.nut
    // context: greenskins_situation.o.create.m.Description
    {
        en = "Greenskins are terrorizing the surrounding lands, and many lives have been lost as orcs or goblins continue to raid outlying farms and raze caravans. Supplies are beginning to run low and people become desperate. Deserters fleeing the carnage are seeking refuge, while mercenaries claiming to be able to protect the locals are seeking coin."
        es = "Los pieles verdes están aterrorizando las tierras circundantes y se han perdido muchas vidas mientras los orcos o goblins continúan atacando granjas periféricas y arrasando caravanas. Los suministros están empezando a escasear y la gente se desespera. Desertores que huyen de la matanza buscan refugio, mientras que mercenarios que aseguran poder proteger a los lugareños buscan dinero."
    }
    // context: greenskins_situation.o.create.m.Rumors.push()
    {
        // this.m.Rumors.push("I just don\'t understand it. We had bunch of poor sods come by from %settlement% muttering that no noble house can promise them enough fortunes to fight a greenskin army ever again. Even so, a bunch of sheep-headed fools calling themselves sellswords said they were heading in that direction precisely for the coin.");
        mode = "pattern"
        en = "I just don't understand it. We had bunch of poor sods come by from %settlement% muttering that no noble house can promise them enough fortunes to fight a greenskin army ever again. Even so, a bunch of sheep-headed fools calling themselves sellswords said they were heading in that direction precisely for the coin."
        es = "Es que no lo entiendo. Pasaron por aquí unos cuantos pobres diablos de %settlement% murmurando que ninguna casa noble podría prometerles fortuna suficiente para volver a luchar contra un ejército de pieles verdes. Aun así, una panda de idiotas con sesera de borrego que se hacían llamar mercenarios dijeron que iban hacia allí precisamente por el dinero."
    }
    // FILE: mod_legends\hooks\entity\world\settlements\situations\seasonal_fair_situation.nut
    // context: seasonal_fair_situation.o.create.m.Rumors.push()
    {
        // this.m.Rumors.push("Big fairs like the one over in %settlement% atract the worst kinds of people, minstrels and troubadours.");
        mode = "pattern"
        en = "Big fairs like the one over in %settlement% atract the worst kinds of people, minstrels and troubadours."
        es = "Las grandes ferias como la de %settlement% atraen a la peor clase de gente: juglares y trovadores."
    }
    // FILE: mod_legends\hooks\entity\world\settlements\situations\terrified_villagers_situation.nut
    // context: terrified_villagers_situation.o.create.m.Description
    {
        en = "The villagers here are terrified of unknown horrors. Fewer potential recruits are to be found on the streets, and people deal less favourably with strangers. Those formerly in the business of graves are rightfully seeking new employment. Upon resolution this will refresh the hiring roster in town."
        es = "Los aldeanos de aquí viven aterrados por horrores desconocidos. Se ven menos posibles reclutas por las calles, y la gente trata peor a los forasteros. Quienes antes se dedicaban al negocio de las tumbas buscan, con razón, un nuevo empleo. Cuando se resuelva, se renovarán los reclutas disponibles en la ciudad."
    }
    // context: terrified_villagers_situation.o.create.m.Rumors.push()
    {
        // this.m.Rumors.push("Aye, it\'s a bad time to be in the gravedigging or graverobbing business, I tell ye. Especially if you are in %settlement%!");
        mode = "pattern"
        en = "Aye, it's a bad time to be in the gravedigging or graverobbing business, I tell ye. Especially if you are in %settlement%!"
        es = "Sí, te lo digo yo: es mal momento para dedicarse a cavar tumbas o a saquearlas. ¡Sobre todo si estás en %settlement%!"
    }
    // FILE: mod_legends\hooks\entity\world\settlements\situations\terrifying_nightmares_situation.nut
    // context: terrifying_nightmares_situation.o.create.m.Description
    {
        en = "The people of this settlement are terrorized by nightmares. Many prefer to stay awake all night just to be safe. The local townsfolk have called in Witch Hunters and Beast Slayers alike, desperately hoping for either group to put an end to their terrors. Upon resolution this will refresh the hiring roster in town."
        es = "La gente de este asentamiento vive aterrorizada por las pesadillas. Muchos prefieren pasar la noche en vela por si acaso. Los lugareños han llamado tanto a Cazadores de brujas como a Cazadores de bestias, con la desesperada esperanza de que alguno de los dos grupos ponga fin a sus terrores. Cuando se resuelva, se renovarán los reclutas disponibles en la ciudad."
    }
    // context: terrifying_nightmares_situation.o.create.m.Rumors.push()
    {
        // this.m.Rumors.push("A Witch Hunter and a Beast Hunter walked in yesterday - No! This isn\'t a joke! Anyway the two were arguing over how best to kill a monster that haunts your dreams. I would avoid %settlement% if I were you.");
        mode = "pattern"
        en = "A Witch Hunter and a Beast Hunter walked in yesterday - No! This isn't a joke! Anyway the two were arguing over how best to kill a monster that haunts your dreams. I would avoid %settlement% if I were you."
        es = "Ayer entraron aquí un Cazador de brujas y un Cazador de bestias... ¡No! ¡Que no es un chiste! El caso es que los dos discutían sobre la mejor manera de matar a un monstruo que te acecha en sueños. Yo que tú evitaría %settlement%."
    }
    // FILE: mod_legends\hooks\entity\world\settlements\situations\unhold_attacks_situation.nut
    // context: unhold_attacks_situation.o.create.m.Description
    {
        en = "Large Unholds have been seen and heard in the area. The townsfolk are scared of leaving the vicinity of the settlement. Beast Slayers and Sellswords have shown up offering to slay these giants in exchange for coin."
        es = "Se han visto y oído troles corpulentos por la zona. Los habitantes tienen miedo de alejarse de los alrededores del asentamiento. Han aparecido Cazadores de bestias y mercenarios que se ofrecen a matar a esos gigantes a cambio de dinero."
    }
    // context: unhold_attacks_situation.o.create.m.Rumors.push()
    {
        // this.m.Rumors.push("Only a fool would go seeking after the unholds that attacked %settlement% recently. You couldn\'t pay me enough to do it, that\'s for sure!");
        mode = "pattern"
        en = "Only a fool would go seeking after the unholds that attacked %settlement% recently. You couldn't pay me enough to do it, that's for sure!"
        es = "Solo un necio iría a buscar a los troles que atacaron %settlement% hace poco. ¡No lo haría ni por todo el oro del mundo, eso seguro!"
    }
    // FILE: mod_legends\hooks\entity\world\world_entity.nut
    // en = "An "
    // en base_es
    // en = "A "
    // en base_es
    // context: world_entity.o.getTroopComposition.entities.push().text.removeFromBeginningOfText()
    // en = "<start + this.removeFromBeginningOfText(The , this.Const.Strings.EntityName[i])>"  // no es texto: solo concatena expresiones de código (cantidad y nombre de entidad sin «The »); el nombre se traduce en su propio par
    // context: world_entity.o.getTroopComposition y world_state.o.showCombatDialog
    {
        // Con el ajuste ExactEngageNumbers, la tropa sale como cifra + plural
        // ("2 Ancient Auxiliaries"); el par del plural está en base_es.
        mode = "pattern"
        en = "<n:int> <troops:str>"
        es = "<n> <troops:t>"
    }
    {
        // "Indebted" es igual en singular y en plural, y su par del base es el
        // singular: la regla de arriba daba "9 Endeudado".
        mode = "pattern"
        en = "<n:int> Indebted"
        es = "<n> Endeudados"
    }
    // FILE: mod_legends\hooks\events\event.nut
    // en = "OOC"
    // en = "randomnoblehouse"
    // en = "randomcitystate"
    // context: event.o.addPronounVars._vars.extend()
    // en = "they<_suffix>"  // nombre de variable de evento (%they_X%), no se muestra
    // context: event.o.addPronounVars._vars.extend()
    // en = "them<_suffix>"  // nombre de variable de evento (%them_X%), no se muestra
    // context: event.o.addPronounVars._vars.extend()
    // en = "their<_suffix>"  // nombre de variable de evento (%their_X%), no se muestra
    // context: event.o.addPronounVars._vars.extend()
    // en = "theirs<_suffix>"  // nombre de variable de evento (%theirs_X%), no se muestra
    // context: event.o.addPronounVars._vars.extend()
    // en = "themselves<_suffix>"  // nombre de variable de evento (%themselves_X%), no se muestra
    // context: event.o.addPronounVars._vars.extend()
    // en = "They<_suffix>"  // nombre de variable de evento (%They_X%), no se muestra
    // context: event.o.addPronounVars._vars.extend()
    // en = "Them<_suffix>"  // nombre de variable de evento (%Them_X%), no se muestra
    // context: event.o.addPronounVars._vars.extend()
    // en = "Their<_suffix>"  // nombre de variable de evento (%Their_X%), no se muestra
    // context: event.o.addPronounVars._vars.extend()
    // en = "Theirs<_suffix>"  // nombre de variable de evento (%Theirs_X%), no se muestra
    // context: event.o.addPronounVars._vars.extend()
    // en = "Themselves<_suffix>"  // nombre de variable de evento (%Themselves_X%), no se muestra
    // FILE: mod_legends\hooks\events\event_manager.nut
    // en = "no event???"
    // en base_es
    // FILE: mod_legends\hooks\events\events\adopt_wardog_event.nut
    // en = "E"
    // en = "Battle Brother"
    // en base_es
    // en = "You gain <item:str>"
    // en base_es
    // en = "F"
    // context: adopt_wardog_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «cachorro» por «chucho»: mutt es un perro callejero, no un cachorro; y «le dé de comer algo de comida» (redundante) por «le dé algo de comer»
        en = "[img]gfx/ui/events/event_37.png[/img]A rugged dog such as he would make for a great mascot. The little mutt could definitely boost morale. You order %bro% to feed it some food in the hopes that it'll tag along. %They_bro% goes out with a scrap of leftovers and crouches down.%SPEECH_ON%Good dog.%SPEECH_OFF%The mongrel sniffs the food, then chomps down on it - and the mercenary's hand along with it. The brother jumps back, nestling %their_bro% arm into %their_bro% chest as though %they_bro% might lose it otherwise. The dog, on the other hand, swallows the scrap and then runs off."
        es = "[img]gfx/ui/events/event_37.png[/img]Un perro tan resistente como ese sería una gran mascota. El pequeño chucho sin duda podría elevar la moral. Ordenas a %bro% que le dé algo de comer con la esperanza de que se una a ustedes. Sale con un trozo de sobras y se agacha.%SPEECH_ON%Buen chico.%SPEECH_OFF%El callejero huele la comida y luego la devora, y con ella la mano de %bro%. Retrocede de un salto, apretándose el brazo contra el pecho como si de otro modo pudiera perderlo. El perro, en cambio, se traga el trozo y se va corriendo."
    }
    // en = "G"
    // context: adopt_wardog_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_27.png[/img]You ask %houndmaster% the houndmaster if %they_houndmaster% can try and 'woo' this dog. %They_houndmaster% nods and steps toward it. The wild mongrel's ears go from pinned to pointed. Crouched, the houndmaster slowly edges %their_houndmaster% way toward the beast. %They_houndmaster% keeps %their_houndmaster% hand out with a piece of meat in the palm. Hunger overcomes heedfulness and the dog sniffs its way ever closer to the houndmaster's hand. The dog tongues it out of %their_houndmaster% palm and chows down. The dog trainer feeds him another bite. %They_houndmaster% scruffs him up and finds the sweet spot behind his ears. Looking back, %houndmaster% nods.%SPEECH_ON%Aye, it's an agreeable beast and will be easily trained.%SPEECH_OFF%That's great. You ask if it can fight. The houndmaster purses %their_houndmaster% lips.%SPEECH_ON%A dog is akin to a man. If it can breathe, it can fight.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_27.png[/img]Le preguntas a %houndmaster% si puede intentar «ganarse» a este perro. Asiente y da un paso hacia él. Las orejas del chucho salvaje pasan de gachas a tiesas. Agachad%o_houndmaster%, %houndmaster% se va acercando poco a poco a la bestia, con la mano extendida y un trozo de carne en la palma. El hambre vence a la cautela, y el perro se acerca cada vez más a la mano, olfateando. Se lo quita de la palma con la lengua y lo engulle. %houndmaster% le da otro bocado, le revuelve el pelo y le encuentra el punto justo detrás de las orejas. Al volverse, asiente.%SPEECH_ON%Sí, es un animal dócil y será fácil de adiestrar.%SPEECH_OFF%Estupendo. Preguntas si sabe pelear. %houndmaster% frunce los labios.%SPEECH_ON%Un perro es como un hombre. Si puede respirar, puede pelear.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\aging_swordmaster_event.nut
    // en = "A"
    // context: aging_swordmaster_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // _screen.Text = "[img]gfx/ui/events/event_17.png[/img]You find %swordmaster% struggling to set %themselves_swordmaster% down on a tree stump. As %they_swordmaster% gingerly lowers, you see %their_swordmaster% legs quaking as though they can barely bend at all. %They_swordmaster% lets out a long sigh after %they_swordmaster% takes %their_swordmaster% seat. %Their_swordmaster% sword is beside %them_swordmaster%. It is younger than the hands that own it, a replacement of a replacement of a replacement. %They_swordmaster% shows no fondness for it, but when %they_swordmaster% touches it you sense there is a reflection in the very idea of a sword, of how a %person_swordmaster% lengthens %themselves_swordmaster% with it, and how %they_swordmaster% shortens others by its very blade. You turn to leave, hoping to give the swordmaster time to %themselves_swordmaster%, but %they_swordmaster% notices your departure and calls out.%SPEECH_ON%Hey there, captain. Didn\'t mean for you to see that.%SPEECH_OFF%";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_17.png[/img]You find %swordmaster% struggling to set %themselves_swordmaster% down on a tree stump. As %they_swordmaster% gingerly lowers, you see %their_swordmaster% legs quaking as though they can barely bend at all. %They_swordmaster% lets out a long sigh after %they_swordmaster% takes %their_swordmaster% seat. %Their_swordmaster% sword is beside %them_swordmaster%. It is younger than the hands that own it, a replacement of a replacement of a replacement. %They_swordmaster% shows no fondness for it, but when %they_swordmaster% touches it you sense there is a reflection in the very idea of a sword, of how a %person_swordmaster% lengthens %themselves_swordmaster% with it, and how %they_swordmaster% shortens others by its very blade. You turn to leave, hoping to give the swordmaster time to %themselves_swordmaster%, but %they_swordmaster% notices your departure and calls out.%SPEECH_ON%Hey there, captain. Didn't mean for you to see that.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_17.png[/img]Encuentras a %swordmaster% esforzándose por sentarse en un tocón. Mientras baja con cuidado, ves que le tiemblan las piernas como si apenas pudieran doblarse. Suelta un largo suspiro después de tomar asiento. Tiene la espada a su lado. Es más joven que las manos que la empuñan, el sustituto del sustituto de un sustituto. No muestra ningún cariño por ella, pero cuando la toca intuyes que hay una reflexión en la idea misma de una espada, en cómo una persona se alarga con ella y en cómo acorta a los demás con su propia hoja. Te das la vuelta para irte, con la esperanza de dejar%lo_swordmaster% un rato a solas, pero se da cuenta de que te marchas y te llama.%SPEECH_ON%Hola, capitán. No pretendía que vieras eso.%SPEECH_OFF%"
    }
    // en = "B"
    // context: aging_swordmaster_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_17.png[/img]%They_swordmaster% leans back, rubbing one of %their_swordmaster% knees with a calloused hand. A bit of wind throws %their_swordmaster% tufts of greyed hair around.%SPEECH_ON%Old. That's how I'm doing. And I don't mean my age. By the years, I've been old for a while now. I mean I'm old in the bones. I suppose I get by on reputation a lot more than skills these days.%SPEECH_OFF%You immediately disagree, telling %them_swordmaster% that %they're_swordmaster% one of the deadliest %people_swordmaster% you've ever met.%SPEECH_ON%Save the niceties for the others, captain. My vision's going. You probably don't want to hear that, but it is. My lead foot doesn't step like it used to. The knee clicks, seizes up. One day that is going to cost me. My off-hand has no feeling.%SPEECH_OFF%The swordmaster clenches and unclenches his free-hand."
        es = "[img]gfx/ui/events/event_17.png[/img]Se echa hacia atrás y se frota una rodilla con la mano encallecida. Una ráfaga de viento le revuelve los mechones de pelo canoso.%SPEECH_ON%Viej%o_swordmaster%. Así estoy. Y no me refiero a la edad. Contando los años, hace tiempo que soy viej%o_swordmaster%. Quiero decir que estoy viej%o_swordmaster% hasta los huesos. Supongo que hoy en día vivo mucho más de la fama que de la habilidad.%SPEECH_OFF%Le llevas la contraria al instante y le dices que es una de las personas más letales que has conocido.%SPEECH_ON%Guárdate las lindezas para los demás, capitán. Estoy perdiendo la vista. Seguramente no quieras oírlo, pero así es. El pie adelantado ya no pisa como antes. La rodilla cruje y se agarrota. Un día eso me va a costar caro. La mano mala ya no siente nada.%SPEECH_OFF%%Art_swordmaster% maestr%o_swordmaster% espadachín aprieta y abre la mano libre."
    }
    // en = "C"
    // context: aging_swordmaster_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «el lamentable césped ennegrecido» por «la muy desgraciada y siniestra»: sod aquí es «desgraciado» (insulto dirigido a la muerte), no «césped»
        // corrige base: «Me olvido si hay» por «Me olvido de si hay» (olvidarse rige «de»)
        en = "[img]gfx/ui/events/event_17.png[/img]%SPEECH_ON%Nothing. I suppose the nerves are dying. And sometimes I forget things. I don't mean where I left my boots, either. I forget if there is someone standing behind me or not. My sense of my surroundings, my real blade, has been dulled. For all my speed and instinct it was time that has crept upon me, slow and steady, with no heat nor cold to give it away, it simply was and is and will be. I always thought I'd be bested by another swordsman. Someone of talent. But I suppose I was too good for that.%SPEECH_OFF%The swordmaster grins playfully. You ask if %they_swordmaster% fears a death with no honor.%SPEECH_ON%I realized a long time ago that, when you become someone of my reputation, any route to death is going to be a disappointing one. They'll write it in the books how someone below my stature slew the great swordmaster. It's hogwash. If you want the truth I'll tell ya. I fear what I know is coming. That my body will betray me in the last moments. With time at its side, my body is what is going to kill me. The knee will lock, the grip will loosen, the shoulder will weaken. I don't fear death. I was too good for death, so death'll have to wait. My body is going to kill me first, then death can have what's left, the sorry blackened sod. The writers and historians? Piss on 'em. If I wanted eternal glory I would've fought an army by myself.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_17.png[/img]%SPEECH_ON%Nada. Supongo que los nervios se están muriendo. Y a veces se me olvidan cosas. Y tampoco me refiero a dónde dejé las botas. Me olvido de si hay alguien detrás de mí o no. Mi sentido de lo que me rodea, mi verdadera espada, se ha embotado. Con toda mi velocidad y mi instinto, fue el tiempo el que se me echó encima, lento y constante, sin calor ni frío que lo delatara; simplemente fue, es y será. Siempre pensé que me vencería otro espadachín. Alguien con talento. Pero supongo que era demasiado buen%o_swordmaster% para eso.%SPEECH_OFF%%Art_swordmaster% maestr%o_swordmaster% espadachín sonríe con picardía. Le preguntas si teme una muerte sin honor.%SPEECH_ON%Hace mucho tiempo me di cuenta de que, cuando te conviertes en alguien de mi reputación, cualquier camino hacia la muerte va a ser decepcionante. Escribirán en los libros cómo alguien por debajo de mi talla mató %al_swordmaster% gran maestr%o_swordmaster% espadachín. Son paparruchas. Si quieres la verdad, te la digo. Temo lo que sé que se avecina. Que mi cuerpo me traicione en los últimos momentos. Con el tiempo de su lado, lo que me va a matar es mi cuerpo. La rodilla se bloqueará, el agarre se aflojará, el hombro se debilitará. No temo a la muerte. Era demasiado buen%o_swordmaster% para la muerte, así que la muerte tendrá que esperar. Mi cuerpo me matará primero, y luego la muerte podrá quedarse con lo que quede, la muy desgraciada y siniestra. ¿Los escritores y los historiadores? Que les jodan. Si quisiera la gloria eterna, habría luchado contra un ejército sin ayuda de nadie.%SPEECH_OFF%"
    }
    // context: aging_swordmaster_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: errata «ritme» por «ritmo»
        en = "[img]gfx/ui/events/event_17.png[/img]You hear the old swordmaster sigh as you move away. Keeping up with the rest of the company, it seems, has become a battle in and of itself for %them_swordmaster%."
        es = "[img]gfx/ui/events/event_17.png[/img]Oyes suspirar %al_swordmaster% viej%o_swordmaster% maestr%o_swordmaster% espadachín mientras te alejas. Al parecer, seguir el ritmo del resto de la compañía se ha convertido en una batalla en sí misma para %el_swordmaster%."
    }
    // FILE: mod_legends\hooks\events\events\aging_swordmaster_paycut_event.nut
    // context: aging_swordmaster_paycut_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // _screen.Text = "[img]gfx/ui/events/event_17.png[/img]%swordmaster% enters your tent. You wave %them_swordmaster% to the chair across your table. %They_swordmaster% sits so slowly and feebly that you fear %them_swordmaster% standing back up will take twice as long. The %person_swordmaster% clasps %their_swordmaster% hands together and elbows %their_swordmaster% arms onto the table, grunting and shifting, finding little comfort even in doing nothing at all. %Their_swordmaster% lips are dry, %their_swordmaster% face withered. Liver spots mottle %their_swordmaster% head and even the hairs about %their_swordmaster% nose and ears are grey.\n\n You always have time for %swordmaster% so you ask what it is %they_swordmaster% wishes to speak about.%SPEECH_ON%This might sound peculiar coming from a blade for hire, but I think it needs saying anyway, and it\'d make me sleep better at night. I\'ll be forward with you: I am not the %person_swordmaster% you hired so long ago. You know that. I know that. Some of the men know it, but they\'re respectful as good men are.%SPEECH_OFF%You agree, but don\'t nod. Instead, you ask what the %person_swordmaster% is getting at.%SPEECH_ON%I wish to lower my wage. Now don\'t be saying no, you don\'t have to bullshit me. I\'ll take a cut. Money\'s never been an issue anyhow. Those crowns could be used to help arm the men or even pay them better. God knows a young man could always use an extra crown or two.%SPEECH_OFF%Before you say another word, the %person_swordmaster% springs to %their_swordmaster% feet with surprising speed. %They_swordmaster% nods and grins playfully before yelling loudly.%SPEECH_ON%I agree with your decision, good sir. I could use a paycut!%SPEECH_OFF%You laugh as the %person_swordmaster% leaves your tent almost as soon as %they_swordmaster%\'d come in.";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_17.png[/img]%swordmaster% enters your tent. You wave %them_swordmaster% to the chair across your table. %They_swordmaster% sits so slowly and feebly that you fear %them_swordmaster% standing back up will take twice as long. The %person_swordmaster% clasps %their_swordmaster% hands together and elbows %their_swordmaster% arms onto the table, grunting and shifting, finding little comfort even in doing nothing at all. %Their_swordmaster% lips are dry, %their_swordmaster% face withered. Liver spots mottle %their_swordmaster% head and even the hairs about %their_swordmaster% nose and ears are grey.\n\n You always have time for %swordmaster% so you ask what it is %they_swordmaster% wishes to speak about.%SPEECH_ON%This might sound peculiar coming from a blade for hire, but I think it needs saying anyway, and it'd make me sleep better at night. I'll be forward with you: I am not the %person_swordmaster% you hired so long ago. You know that. I know that. Some of the men know it, but they're respectful as good men are.%SPEECH_OFF%You agree, but don't nod. Instead, you ask what the %person_swordmaster% is getting at.%SPEECH_ON%I wish to lower my wage. Now don't be saying no, you don't have to bullshit me. I'll take a cut. Money's never been an issue anyhow. Those crowns could be used to help arm the men or even pay them better. God knows a young man could always use an extra crown or two.%SPEECH_OFF%Before you say another word, the %person_swordmaster% springs to %their_swordmaster% feet with surprising speed. %They_swordmaster% nods and grins playfully before yelling loudly.%SPEECH_ON%I agree with your decision, good sir. I could use a paycut!%SPEECH_OFF%You laugh as the %person_swordmaster% leaves your tent almost as soon as %they_swordmaster%'d come in."
        es = "[img]gfx/ui/events/event_17.png[/img]%swordmaster% entra en tu tienda. Le indicas con un gesto la silla al otro lado de la mesa. Se sienta con tanta lentitud y torpeza que temes que volver a levantarse le cueste el doble. Junta las manos y apoya los codos en la mesa, gruñendo y removiéndose, sin encontrar apenas comodidad ni siquiera sin hacer nada. Tiene los labios secos y el rostro marchito. Las manchas de la edad le salpican la cabeza, y hasta los pelos de la nariz y de las orejas son canosos.\n\n Siempre tienes tiempo para %swordmaster%, así que le preguntas de qué quiere hablar.%SPEECH_ON%Puede que suene raro viniendo de una espada de alquiler, pero creo que hay que decirlo de todos modos, y así dormiría mejor por las noches. Seré franc%o_swordmaster% contigo: ya no soy %art_swordmaster% %hombre_swordmaster% que contrataste hace tanto tiempo. Tú lo sabes. Yo lo sé. Algunos de los hombres lo saben, pero son respetuosos, como lo son los hombres buenos.%SPEECH_OFF%Estás de acuerdo, pero no asientes. En su lugar, le preguntas adónde quiere llegar.%SPEECH_ON%Quiero que me bajes la paga. Y no me digas que no, no hace falta que me vengas con mierdas. Aceptaré el recorte. El dinero nunca ha sido un problema, de todos modos. Esas coronas podrían servir para armar a los hombres o incluso para pagarles mejor. Bien sabe Dios que a un joven siempre le vienen bien una o dos coronas de más.%SPEECH_OFF%Antes de que digas una palabra más, %swordmaster% se pone en pie de un salto con una rapidez sorprendente. Asiente y sonríe con picardía antes de gritar a pleno pulmón.%SPEECH_ON%¡Estoy de acuerdo con tu decisión, buen señor! ¡Me vendrá bien un recorte de sueldo!%SPEECH_OFF%Te ríes mientras sale de tu tienda casi tan pronto como había entrado."
    }
    // FILE: mod_legends\hooks\events\events\aging_swordmaster_preview_event.nut
    // context: aging_swordmaster_preview_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «Lo que me he dado cuenta es que» por «De lo que me he dado cuenta es de que» (darse cuenta rige «de»)
        // corrige base: doble «pero» en «sabes que ya lo ha pensado detenidamente, pero no desea»; y «como un anciano» por «siendo un anciano» (as an old man)
        // _screen.Text = "[img]gfx/ui/events/event_17.png[/img]You find %swordmaster% sitting on a stump. %They're_swordmaster% looking out at the land.%SPEECH_ON%You know, I\'ve realized something as an old %person_swordmaster% who has operated far too long in this business of killing. I\'m so much wiser these days. I\'ve come to know so much, so much that I now know what I don\'t know. And I look back and think, I was such a dummy back in my youth. Then I thought, what of all the men I\'ve slain, stopping their mortal coil when it was young and so ready to spring?%SPEECH_OFF%You take a seat and shrug. %They_swordmaster% continues.%SPEECH_ON%What I\'ve realized is that I\'m a killer of wisdom. That I took a lot of old men out of this world, and with them went so much learning and knowledge. There\'s so many worlds out there that I destroyed. Worlds where those men lived and went on living and did the great things they knew not was in them. Had the first man I fought slew me down, how many lives would he have saved? How much wisdom would have been spared? I\'m sorry, I don\'t mean to drone on.%SPEECH_OFF%The %person_swordmaster% stands, patting %their_swordmaster% wobbly legs. You grab %their_swordmaster% arm.%SPEECH_ON%Have you considered that you may have also saved worlds? That some of those men you\'ve slain could have lived on to be horrible monsters?%SPEECH_OFF%%They_swordmaster% smiles, but you know %they're_swordmaster% already thought that through and doesn\'t wish to disturb you with the answer. %They_swordmaster% simply nods before going off to join the rest of the company.";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_17.png[/img]You find %swordmaster% sitting on a stump. %They're_swordmaster% looking out at the land.%SPEECH_ON%You know, I've realized something as an old %person_swordmaster% who has operated far too long in this business of killing. I'm so much wiser these days. I've come to know so much, so much that I now know what I don't know. And I look back and think, I was such a dummy back in my youth. Then I thought, what of all the men I've slain, stopping their mortal coil when it was young and so ready to spring?%SPEECH_OFF%You take a seat and shrug. %They_swordmaster% continues.%SPEECH_ON%What I've realized is that I'm a killer of wisdom. That I took a lot of old men out of this world, and with them went so much learning and knowledge. There's so many worlds out there that I destroyed. Worlds where those men lived and went on living and did the great things they knew not was in them. Had the first man I fought slew me down, how many lives would he have saved? How much wisdom would have been spared? I'm sorry, I don't mean to drone on.%SPEECH_OFF%The %person_swordmaster% stands, patting %their_swordmaster% wobbly legs. You grab %their_swordmaster% arm.%SPEECH_ON%Have you considered that you may have also saved worlds? That some of those men you've slain could have lived on to be horrible monsters?%SPEECH_OFF%%They_swordmaster% smiles, but you know %they're_swordmaster% already thought that through and doesn't wish to disturb you with the answer. %They_swordmaster% simply nods before going off to join the rest of the company."
        es = "[img]gfx/ui/events/event_17.png[/img]Encuentras a %swordmaster% sentad%o_swordmaster% en un tocón, contemplando el paisaje.%SPEECH_ON%¿Sabes? Siendo %un_swordmaster% ancian%o_swordmaster% que lleva demasiado tiempo en este negocio de matar, me he dado cuenta de algo. Hoy en día soy mucho más sabi%o_swordmaster%. He llegado a saber tanto, tanto, que ahora sé lo que no sé. Y miro atrás y pienso: qué tont%o_swordmaster% era de joven. Luego pensé: ¿y todos los hombres que he matado, cortándoles el hilo de la vida cuando aún era joven y estaba listo para florecer?%SPEECH_OFF%Tomas asiento y te encoges de hombros. Continúa.%SPEECH_ON%De lo que me he dado cuenta es de que soy %un_swordmaster% asesin%o_swordmaster% de la sabiduría. Saqué de este mundo a muchos ancianos, y con ellos se fueron muchísimos aprendizajes y conocimientos. Hay muchísimos mundos ahí fuera que destruí. Mundos en los que esos hombres vivieron y siguieron viviendo e hicieron las grandes cosas que no sabían que llevaban dentro. Si el primer hombre contra el que luché me hubiera matado, ¿cuántas vidas habría salvado? ¿Cuánta sabiduría se habría ahorrado? Perdona, no pretendo enrollarme.%SPEECH_OFF%%swordmaster% se levanta, dándose palmaditas en las piernas temblorosas. %Lo_swordmaster% agarras del brazo.%SPEECH_ON%¿Has pensado que quizá también hayas salvado mundos? ¿Que algunos de esos hombres que mataste podrían haber vivido para convertirse en monstruos horribles?%SPEECH_OFF%Sonríe, pero sabes que ya lo ha pensado a fondo y no quiere inquietarte con la respuesta. Se limita a asentir antes de irse a reunirse con el resto de la compañía."
    }
    // FILE: mod_legends\hooks\events\events\all_naked_event.nut
    // context: all_naked_event.o.create.s.Text
    {
        // corrige base: errata «Un montón hombres» (falta «de»); «tela en la ingle» por «taparrabos» (cloth of loin); «se ve a» por «ves a» (you spot)
        en = "[img]gfx/ui/events/event_16.png[/img]Marching along, you spot a fellow traveler who leans forward and then back and then forward again, all the while his hand knowing not whether to shield the sun or peel away to let himself be blinded. He shakes his head and spits.%SPEECH_ON%I'd heard word of you folks. Buncha trouserless folk in a land of evil, like some devil's little joke sprung to life. The hell are you?%SPEECH_OFF%You shrug and tell the man that, so far, you've no issue with taking on your troubles sans leather or plate or cloth of loin. Again, the traveler shakes his head and spits.%SPEECH_ON%Farkin' hell. A warrior in battle with nothing on him is more naked than the day he'd done been born! I s'pose the irony is that if we - and I mean anybody-we - come find ya dead in the fields, then we'll probably dress ya better for the grave than you dress yourself now. Which shan't be hard, seeing as how you've dressed yourself none at all.%SPEECH_OFF%With a bit of a wave, you thank the traveler for his kind words before continuing your merry march."
        es = "[img]gfx/ui/events/event_16.png[/img]Durante la marcha, ves a un viajero que se inclina hacia delante, luego hacia atrás y luego otra vez hacia delante, sin que su mano sepa en ningún momento si hacerse sombra contra el sol o apartarse y dejar que lo ciegue. Sacude la cabeza y escupe.%SPEECH_ON%Había oído hablar de ustedes. Una panda de gente sin pantalones en una tierra malvada, como una bromita del diablo que hubiera cobrado vida. ¿Qué demonios son ustedes?%SPEECH_OFF%Te encoges de hombros y le dices al hombre que, hasta ahora, no tienes ningún problema en afrontar tus dificultades sin cuero, ni placas, ni taparrabos. De nuevo, el viajero sacude la cabeza y escupe.%SPEECH_ON%¡Maldita sea! ¡Un guerrero en batalla sin nada encima está más desnudo que el día en que nació! Supongo que lo irónico es que si nosotros, y me refiero a cualquier nosotros, te encontramos muerto en el campo, seguramente te vestiremos mejor para la tumba de lo que te vistes tú ahora. Lo cual no será difícil, visto que no te has vestido nada de nada.%SPEECH_OFF%Con un pequeño gesto de la mano, agradeces al viajero sus amables palabras antes de continuar tu alegre marcha."
    }
    // FILE: mod_legends\hooks\events\events\apprentice_learns_event.nut
    // context: apprentice_learns_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]The apprentice %apprentice% has apparently become a ward to %teacher%. The swordmaster, while long in the tooth, seems quite eager to help the young one become a better fighter. The apprentice uses a real sword, the swordmaster but a wooden one. It is in this rather large difference of chosen weaponry that the swordmaster displays the usefulness of positioning, finding openings, and getting out of the way of danger.\n\nEven in old age the master twirls and whirls, becoming impossible for the apprentice to hit. In one particularly brilliant trick, the swordmaster senses an incoming strike, so closes distance with the apprentice and steps on their foot. When the apprentice tilts back to create space, the foot does not follow. The sudden imbalance brings the trainee tumbling to the ground, then looks up to find a wooden sword prodding the neck.\n\nYou find the apprentice patting the dirt off pretty often, at least the young one is always getting up for more. Let's just say the apprentice is improving one splinter at a time."
        es = "[img]gfx/ui/events/event_05.png[/img]Por lo visto, %apprentice% se ha puesto bajo la tutela de %teacher%. A pesar de sus muchos años, %teacher% parece tener muchas ganas de ayudar a su aprendiz a ser mejor combatiente. %apprentice% usa una espada de verdad; %teacher%, una de madera. Es en esta diferencia de armas, bastante grande, donde %teacher% demuestra la utilidad de colocarse bien, encontrar huecos y quitarse de en medio del peligro.\n\nIncluso a su edad, %teacher% gira y revolotea hasta resultar imposible de alcanzar para %apprentice%. En un truco especialmente brillante, %teacher% intuye que se acerca un golpe, así que acorta distancia y le pisa un pie a %apprentice%. Cuando %apprentice% se echa hacia atrás para ganar espacio, el pie no le sigue. El repentino desequilibrio le hace acabar rodando por el suelo, y al levantar la vista se encuentra una espada de madera hincándosele en el cuello.\n\nA menudo ves a %apprentice% sacudiéndose la tierra, pero al menos siempre vuelve a levantarse para recibir más. Digamos que va mejorando astilla a astilla."
    }
    // context: apprentice_learns_event.o.create.s.Text
    {
        // corrige base: «el soldado retirado» por «que ha vuelto del retiro»: unretired es lo contrario de retirado
        // corrige base: «El viejo gruñón» por «veterano»: grunt aquí es «soldado raso», no «gruñón»
        en = "[img]gfx/ui/events/event_05.png[/img]%teacher% the unretired soldier has taking a liking to %apprentice%. You find the two practicing their craft whenever possible. The old grunt believes in the value of the offensive, showing the apprentice how to turn a blade, axe, or mace in such a manner that it inflicts the most damage. Unfortunately, they are using the company dining equipment to set up little dolls to beat up. The young one has certainly made a mess of those pots and pans in continuous pursuit of being a better fighter."
        es = "[img]gfx/ui/events/event_05.png[/img]%teacher%, que ha vuelto del retiro para servir como soldado, le ha tomado cariño a %apprentice%. Siempre que pueden, practican su oficio. Con su veteranía de soldado raso, %teacher% cree en el valor de la ofensiva y le enseña a %apprentice% a girar una espada, un hacha o una maza de forma que cause el mayor daño posible. Por desgracia, están usando el menaje de la compañía para montar muñequitos a los que dar golpes. Desde luego, %apprentice% ha destrozado esas ollas y sartenes en su continuo empeño por ser mejor combatiente."
    }
    // context: apprentice_learns_event.o.create.s.Text
    {
        // corrige base: «que no había notado antes» por «que no habías notado antes» (you did not notice: el sujeto es el capitán)
        // corrige base: «debe querer» por «debe de querer» (suposición); «dinero ensangrentado» por «dinero manchado de sangre» (blood money)
        en = "[img]gfx/ui/events/event_05.png[/img]It appears as though %teacher% the ol' sellsword has a little bird following around: young %apprentice%. Now in the company of mercenaries, the apprentice must want to learn from those with plenty of experience on the road earning blood money. While they train, you notice that the sellsword puts most of the emphasis on exercising one's body. Being faster than your opponent and outlasting are just as important as putting a blade through the brainbox. The earnest apprentice seems increasingly sturdy, earning some sense of vigor you did not notice before."
        es = "[img]gfx/ui/events/event_05.png[/img]Parece que %teacher%, que lleva toda la vida vendiendo su espada, tiene un pajarito que le sigue a todas partes: %apprentice%, que es muy joven. Ahora que anda en compañía de mercenarios, %apprentice% debe de querer aprender de quienes tienen mucha experiencia en los caminos ganando dinero manchado de sangre. Mientras entrenan, notas que %teacher% pone casi todo el énfasis en ejercitar el cuerpo. Ser más rápido que el oponente y aguantar más que él es tan importante como atravesarle la sesera con una hoja. Con tanto empeño, %apprentice% gana robustez día a día y muestra un vigor que no habías notado antes."
    }
    // context: apprentice_learns_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]A couple of times now you've caught %apprentice% watching %teacher% from a distance. The young apprentice seems rather enraptured by the hedge knight's brute violence. After a few days, the knight relents, asking the apprentice to come and have a chat. You know not what they say, but now you've noticed they have been training together. The hedge knight is not a kind trainer, either. Beats the young one frequently to toughen them up. At first, the apprentice flinches before every strike, but now you see a little more resolve in the face of such towering adversity. The hedge knight is also showing the how to kill fast and efficiently. Little mind is paid to defense in these talks you overhear, but who needs to defend themselves from a dead opponent?"
        es = "[img]gfx/ui/events/event_05.png[/img]Has sorprendido un par de veces a %apprentice% mirando a %teacher% desde la distancia. A %apprentice%, tan joven, parece embelesarle la violencia bruta de %teacher%. Al cabo de unos días, %teacher% cede y le pide a %apprentice% que se acerque a charlar. No sabes lo que se dicen, pero ahora te has dado cuenta de que entrenan juntos. Tampoco es que %teacher% sea amable entrenando: le pega con frecuencia para que se endurezca. Al principio, %apprentice% se encoge ante cada golpe, pero ahora ves algo más de determinación ante una adversidad tan imponente. %teacher% también le enseña a matar con rapidez y eficacia. En estas charlas que oyes de pasada se presta poca atención a la defensa, pero ¿quién necesita defenderse de un oponente muerto?"
    }
    // FILE: mod_legends\hooks\events\events\archery_stunt_event.nut
    // context: archery_stunt_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]Something of a commotion draws you from your tent. The company are sitting on a few stumps or on the ground, eagerly watching something in the distance. With squinting eyes, you spot %clown% and %archer% doing something odd. An apple rests on one mercenary's head, while the other is walking away - a bow in hand.\n\nYou ask %otherguy% what is going on, who explains that the two are going to try some sort of stunt or trick that involves shooting a piece of fruit off a person's head. Shocked, you exclaim that's not safe at all, to which the mercenary grins and explains that is the point."
        es = "[img]gfx/ui/events/event_05.png[/img]Un alboroto te hace salir de tu tienda. La compañía está sentada en unos cuantos tocones o en el suelo, observando con avidez algo a lo lejos. Entornando los ojos, ves a %clown% y a %archer% haciendo algo raro. Hay una manzana sobre una de las dos cabezas, mientras la otra persona se aleja con un arco en la mano.\n\nLe preguntas a %otherguy% qué está pasando, y te explica que los dos van a intentar una especie de número o truco que consiste en arrancar de un flechazo una pieza de fruta de la cabeza de alguien. Con espanto, exclamas que eso no es nada seguro, a lo que %otherguy% sonríe y te explica que de eso se trata."
    }
    // context: archery_stunt_event.o.create.s.Text
    {
        // corrige base: «golpear la manzana» por «darle a la manzana»: hit con una flecha es acertar, no golpear
        en = "[img]gfx/ui/events/event_10.png[/img]You mull the situation over. The company look to you, expecting a stoppage, but instead you take a seat amongst them. This spurs a brief cheer from the crowd which quickly quiets to hushed whispers as %clown% and %archer% get ready.%SPEECH_ON%Make sure to hit the apple!%SPEECH_OFF%One comrade shouts. Laughter ripples through the group.%SPEECH_ON%From that distance %clown_short%'s nose kinda looks like an apple to me.%SPEECH_OFF%More laughter, but it is ever nervous as the stunt is about to unfold."
        es = "[img]gfx/ui/events/event_10.png[/img]Reflexionas sobre la situación. La compañía te mira esperando que lo detengas, pero en lugar de eso tomas asiento entre ellos. Esto provoca una breve ovación del público que enseguida se apaga en susurros mientras %clown% y %archer% se preparan.%SPEECH_ON%¡Asegúrate de darle a la manzana!%SPEECH_OFF%Grita alguien de la compañía. Las risas recorren el grupo.%SPEECH_ON%Desde esa distancia, a mí la nariz de %clown_short% me parece una manzana.%SPEECH_OFF%Más risas, pero cada vez más nerviosas, porque el número está a punto de empezar."
    }
    // context: archery_stunt_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_10.png[/img]%archer% angles shoulders to %clown% and draws the bow, the silhouette forming a crescent of wood, string, and arm. You can't see %clown%'s face, but you assume eyes are closed. The shot is released. It zips. It disappears. %clown% rocks backward, clutching at their face. This isn't looking good. The mercenary screams. The crowd oohs. %archer% slowly lowers the bow and looks at it as though it is at fault.\n\n Eventually, %clown% is carried past you, a shaft of an arrow sticking out of their head. Another comrade lingers behind, quietly eating an apple in the wake of the chaos."
        es = "[img]gfx/ui/events/event_10.png[/img]%archer% encara los hombros hacia %clown% y tensa el arco, y su silueta forma una media luna de madera, cuerda y brazo. No ves la cara de %clown%, pero supones que tiene los ojos cerrados. Suelta la flecha. Zumba. Desaparece. %clown% se tambalea hacia atrás, llevándose las manos a la cara. Esto no pinta bien. %clown% grita. El público suelta un «¡oooh!». %archer% baja el arco despacio y lo mira como si la culpa fuera suya.\n\n Al final, se llevan a %clown% por delante de ti, con el astil de una flecha asomándole de la cabeza. Alguien más de la compañía se queda atrás, comiéndose en silencio una manzana tras el caos."
    }
    // context: archery_stunt_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_10.png[/img]The company cheer as you give an affirming nod. You take a seat amongst them as %archer% and %clown% get ready, the former nocking an arrow while the latter balances an apple atop their head. When the fruit is good and steady, the archer draws back the bow, forming but a silhouette of arm, wood, and string, a crescent of determination while aiming downfield. The company are exchanging bets on whether or not the archer misses. You want to look away, but the spectacle truly is too much.\n\n A great gasp follows the arrow's release, as though some ominous event long foretold had finally happened. Mercenaries reel back in their seats, wincing and gritting their teeth. The apple is shot off %clown%'s head, fruit and arrow spinning away. After a brief silence, the company erupts in cheers. %clown% takes a bow, while %archer% slackens draw and looks a bit relieved."
        es = "[img]gfx/ui/events/event_10.png[/img]La compañía vitorea cuando asientes en señal de aprobación. Tomas asiento entre ellos mientras %archer% y %clown% se preparan: %archer% coloca una flecha en la cuerda mientras %clown% se equilibra una manzana sobre la cabeza. Cuando la fruta está bien quieta, %archer% tensa el arco y se convierte en apenas una silueta de brazo, madera y cuerda, una media luna de determinación que apunta campo abajo. En la compañía se cruzan apuestas sobre si fallará o no. Quieres apartar la vista, pero el espectáculo es demasiado.\n\n Un gran grito ahogado sigue a la suelta de la flecha, como si por fin hubiera ocurrido algún funesto suceso largamente anunciado. Los mercenarios se echan hacia atrás en sus asientos, haciendo muecas y apretando los dientes. La flecha arranca la manzana de la cabeza de %clown%, y fruta y flecha salen girando. Tras un breve silencio, la compañía estalla en vítores. %clown% hace una reverencia, mientras %archer% afloja la cuerda con cara de cierto alivio."
    }
    // FILE: mod_legends\hooks\events\events\bad_curse_event.nut
    // context: bad_curse_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_05.png[/img]%superstitious% enters your tent with hat in hand. The rim of it turns round and round in their fingers as though plucking feathers from it. Even though you haven\'t said a word the %superstitious% \'s head nods furiously, with eyes darting around as if looking for the words to say.\n\nYou put your quill pen down and ask what the issue is. Licking lips, %superstitious%  nods again and begins to explain the predicament. The words come fast, but the general gist of it seems to be that a local witch has cursed %superstitious% to be incapable of some sexual exploit, as it were.\n\nYou shake your head and ask what it is the witch wants and %superstitious% says %payment% crowns, lest the curse be for life.";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_05.png[/img]%superstitious% enters your tent with hat in hand. The rim of it turns round and round in their fingers as though plucking feathers from it. Even though you haven't said a word the %superstitious% 's head nods furiously, with eyes darting around as if looking for the words to say.\n\nYou put your quill pen down and ask what the issue is. Licking lips, %superstitious%  nods again and begins to explain the predicament. The words come fast, but the general gist of it seems to be that a local witch has cursed %superstitious% to be incapable of some sexual exploit, as it were.\n\nYou shake your head and ask what it is the witch wants and %superstitious% says %payment% crowns, lest the curse be for life."
        es = "[img]gfx/ui/events/event_05.png[/img]%superstitious% entra en tu tienda sombrero en mano. Le da vueltas y más vueltas al ala entre los dedos, como si le estuviera arrancando plumas. Aunque no has dicho ni una palabra, %superstitious% asiente con la cabeza frenéticamente, con los ojos yendo de un lado a otro como si buscara qué decir.\n\nDejas la pluma y preguntas cuál es el problema. Tras humedecerse los labios, %superstitious% vuelve a asentir y empieza a explicar el apuro. Las palabras salen a borbotones, pero lo esencial parece ser que una bruja del lugar ha maldecido a %superstitious% para que sea incapaz de cierta proeza sexual, por así decirlo.\n\nSacudes la cabeza y preguntas qué quiere la bruja, y %superstitious% dice que %payment% coronas, o la maldición será de por vida."
    }
    // context: bad_curse_event.o.create.s.Text
    {
        // corrige base: «lo mezclas en un bolso» por «las metes en un monedero»: shuffle aquí es meter, no mezclar
        // s.Text = "[img]gfx/ui/events/event_05.png[/img]Thumb and finger pinching your eyes shut, you wonder if maybe this wasn\'t the life for you. Killing\'s easy, but this? Whatever. You throw your hands up and get out of your chair to retrieve a satchel of crowns. The superstitious mercenary totters up on toe tips.%SPEECH_ON%Please count it out! It mustn\'t be a crown short!%SPEECH_OFF%You begrudgingly set the satchel on the table and begin counting. Once the appropriate number is had, you shuffle it into a purse and toss it to %superstitious%, who bows, thanking you and your mercy. You wave the sellsword off to quickly get the whole incident out of your tent.";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_05.png[/img]Thumb and finger pinching your eyes shut, you wonder if maybe this wasn't the life for you. Killing's easy, but this? Whatever. You throw your hands up and get out of your chair to retrieve a satchel of crowns. The superstitious mercenary totters up on toe tips.%SPEECH_ON%Please count it out! It mustn't be a crown short!%SPEECH_OFF%You begrudgingly set the satchel on the table and begin counting. Once the appropriate number is had, you shuffle it into a purse and toss it to %superstitious%, who bows, thanking you and your mercy. You wave the sellsword off to quickly get the whole incident out of your tent."
        es = "[img]gfx/ui/events/event_05.png[/img]Apretándote los ojos cerrados con el pulgar y el índice, te preguntas si quizá esta no era la vida para ti. Matar es fácil, ¿pero esto? En fin. Levantas las manos al cielo y te levantas de la silla para ir a buscar una bolsa de coronas. Presa de la superstición, %superstitious% se balancea de puntillas.%SPEECH_ON%¡Cuéntalas, por favor! ¡No puede faltar ni una corona!%SPEECH_OFF%A regañadientes, dejas la bolsa sobre la mesa y empiezas a contar. Cuando tienes la cantidad justa, las metes en un monedero y se lo lanzas a %superstitious%, que hace una reverencia y te da las gracias por tu misericordia. Despachas a %superstitious% con un gesto para quitarte cuanto antes todo el asunto de la tienda."
    }
    // context: bad_curse_event.o.create.s.Text
    {
        // corrige base: «tripas» por «paparruchas»: tripe aquí es «tonterías», no «tripas»
        // corrige base: «un vagabundo» por «una pordiosera»: el tramp es la propia bruja
        // s.Text = "[img]gfx/ui/events/event_05.png[/img]You further muddy %superstitious%\'s poor countenance with some bad news: you\'re not paying any witch anything.%SPEECH_ON%A few farcical words from some strange woman in the woods is no basis for an exchange of business. What you\'ve heard is a tramp\'s attempt to get at you, mercenary. You cannot listen to such tripe, especially a tramp\'s tripe for a tramp\'s tripe is always in pursuit of one\'s coin.%SPEECH_OFF%None of these words help %superstitious% who quickly runs out of the tent, perhaps in pursuit of another mercenary who will give a loan.";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_05.png[/img]You further muddy %superstitious%'s poor countenance with some bad news: you're not paying any witch anything.%SPEECH_ON%A few farcical words from some strange woman in the woods is no basis for an exchange of business. What you've heard is a tramp's attempt to get at you, mercenary. You cannot listen to such tripe, especially a tramp's tripe for a tramp's tripe is always in pursuit of one's coin.%SPEECH_OFF%None of these words help %superstitious% who quickly runs out of the tent, perhaps in pursuit of another mercenary who will give a loan."
        es = "[img]gfx/ui/events/event_05.png[/img]Enturbias aún más el pobre semblante de %superstitious% con una mala noticia: no le vas a pagar nada a ninguna bruja.%SPEECH_ON%Cuatro palabras ridículas de una mujer extraña en el bosque no son base para ningún trato. Lo que has oído es el intento de una pordiosera de aprovecharse de ti, espada de alquiler. No puedes hacer caso de semejantes paparruchas, y menos de las paparruchas de una pordiosera, porque las paparruchas de una pordiosera siempre van detrás de tu dinero.%SPEECH_OFF%Ninguna de estas palabras le sirve de nada a %superstitious%, que sale corriendo de la tienda, quizá en busca de otro mercenario que le preste dinero."
    }
    // context: bad_curse_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_05.png[/img]Wondering if maybe %monk% could help, you go and fetch the holy figure.\n\n %monk% is happy to lend a hand, for the old gods are always at war with the evils of witchcraft and other sorcery. Before an incoming long monologue about this old god or that one, you dip away and send in %superstitious%. For a few minutes, there is peace and quiet in your tent. But you know it can\'t last, for you are like someone beneath a rockslide, awaiting the tumbling stone with their name on it.\n\n However, %superstitious% doesn\'t return. After a few minutes more you realize there still hasn\'t been a disruptive entrance. In fact, the absence altogether has you on edge, as though silence itself might be haranguing. You leave the tent to find the holy one and so-called cursed one deep in religious talks. Smiling, you return to your tent. If there\'s one thing the holy are best at, it\'s maintaining a sense of tranquility.";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_05.png[/img]Wondering if maybe %monk% could help, you go and fetch the holy figure.\n\n %monk% is happy to lend a hand, for the old gods are always at war with the evils of witchcraft and other sorcery. Before an incoming long monologue about this old god or that one, you dip away and send in %superstitious%. For a few minutes, there is peace and quiet in your tent. But you know it can't last, for you are like someone beneath a rockslide, awaiting the tumbling stone with their name on it.\n\n However, %superstitious% doesn't return. After a few minutes more you realize there still hasn't been a disruptive entrance. In fact, the absence altogether has you on edge, as though silence itself might be haranguing. You leave the tent to find the holy one and so-called cursed one deep in religious talks. Smiling, you return to your tent. If there's one thing the holy are best at, it's maintaining a sense of tranquility."
        es = "[img]gfx/ui/events/event_05.png[/img]Preguntándote si quizá %monk% podría ayudar, vas a buscar a tan santa figura.\n\n %monk% se alegra de echar una mano, pues los viejos dioses están siempre en guerra contra los males de la brujería y demás hechicerías. Antes de que empiece un largo monólogo sobre este o aquel viejo dios, te escabulles y haces pasar a %superstitious%. Durante unos minutos, hay paz y tranquilidad en tu tienda. Pero sabes que no puede durar, porque eres como alguien al pie de un desprendimiento, esperando la piedra que rueda con su nombre escrito.\n\n Sin embargo, %superstitious% no vuelve. Al cabo de unos minutos más te das cuenta de que sigue sin haber ninguna entrada intempestiva. De hecho, tanta ausencia te tiene en vilo, como si el propio silencio pudiera estar echándote un sermón. Sales de la tienda y te encuentras a la persona santa y a la supuesta víctima de la maldición en plena conversación religiosa. Sonriendo, vuelves a tu tienda. Si en algo destacan los santos, es en mantener la calma."
    }
    // context: bad_curse_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_05.png[/img]You snap your fingers, suddenly remembering %sorcerer%, the so-called sorceror. Wanting to not spend another minute being a part of this bizarre affair, you refer %superstitious% to the sorcerer who is quick to leave, but unfortunately returns a few minutes later, explaining that %sorcerer% has removed the curse.%SPEECH_ON%All I had to do was...%SPEECH_OFF%You hold your hand up, stopping the story right where it be. When asked if you want to hear the rest of it, you give a firm no.";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_05.png[/img]You snap your fingers, suddenly remembering %sorcerer%, the so-called sorceror. Wanting to not spend another minute being a part of this bizarre affair, you refer %superstitious% to the sorcerer who is quick to leave, but unfortunately returns a few minutes later, explaining that %sorcerer% has removed the curse.%SPEECH_ON%All I had to do was...%SPEECH_OFF%You hold your hand up, stopping the story right where it be. When asked if you want to hear the rest of it, you give a firm no."
        es = "[img]gfx/ui/events/event_05.png[/img]Chasqueas los dedos al acordarte de repente de %sorcerer%, que presume de dominar la hechicería. Como no quieres pasar ni un minuto más formando parte de este extraño asunto, mandas a %superstitious% a ver a %sorcerer%. Se marcha a toda prisa, pero por desgracia vuelve unos minutos después explicando que %sorcerer% le ha quitado la maldición.%SPEECH_ON%Lo único que tuve que hacer fue...%SPEECH_OFF%Levantas la mano y cortas la historia justo ahí. Cuando te pregunta si quieres oír el resto, le das un rotundo no."
    }
    // FILE: mod_legends\hooks\events\events\bad_omen_event.nut
    // context: bad_omen_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «el resto de la empresa» por «el resto de la compañía» (company)
        // corrige base: «lo capta con seriedad» por «lo recoge con gravedad» (picks it up with earnest)
        // corrige base: «se quita la cabeza de las manos» por «lo arroja lejos de sí» (throws the head out of his hands) y «Golpea el cráneo contra el suelo» por «Repiquetea hueco contra el suelo» (it clatters hollow)
        // _screen.Text = "{[img]gfx/ui/events/event_12.png[/img]Cries whip through the party like the howls of the wind. There is not an enemy in sight so you\'ve no idea what is causing this. You walk the ranks to find %superstitious% practically sobbing on the ground. %They_superstitious% is clutching %their_superstitious% chest with one hand while the other points to the sky, the finger shaking in pointed fear. %otherguy% explains that the %person_superstitious% saw a great blaze of fire cross by the stars. Apparently this pathetic fool takes it for an omen and, of course, it isn\'t a good one. Whatever it is, it isn\'t going to get you where you need to be so you order the sellswords to march. | [img]gfx/ui/events/event_12.png[/img] Shadows begin to fold in and on themselves in strange ways. You turn around to see the sun darkening, a great rim of black moving over it. Soon there is no sun at all. %superstitious% cries out that the end times are coming, but before %their_superstitious% wailing can find a grip on the rest of your mercenaries, the great shade unveils the sun once more and there is light again as though nothing happened at all. You tell the pathetic fool to get to %their_superstitious% feet. You\'ve places to march and tears sure as hell won\'t get you there. | [img]gfx/ui/events/event_11.png[/img] %superstitious% is poking %their_superstitious% sword into a warren when %they_superstitious% suddenly cries out. %They_superstitious% leaps away from the rabbit hole and screams that there is a two headed bunny within. Apparently this is a bad omen of things to come. All you can think is that two heads just means more meat for the stew. | [img]gfx/ui/events/event_11.png[/img]You pass beneath a tree whose branches are occupied by both a black cat and an albino crow. %superstitious% cries at the sight of it, saying that this is surely a sign of the end times. Why yes, of course it is. These things are never a sign of good things, right? Yeesh. | [img]gfx/ui/events/event_11.png[/img] You come across a deer skull. At first it means nothing to you, but %superstitious% picks it up with earnest. Muted dust pours out of the cavity as %they_superstitious% turns it this way and that. Hands trembling, %they_superstitious% throws the head out of %their_superstitious% hands. It clatters hollow against the ground, tumbling over onto where the horns should be. The scared %person_superstitious% claims that a soothsayer once told %them_superstitious% that %they_superstitious% would come across a skull such as this.\n\nThere are many skulls out here, you argue, because things have a tendency to die. Your words do nothing for the %person_superstitious% as %they_superstitious% slowly, and nervously, shuffles back into the marching rank. | [img]gfx/ui/events/event_11.png[/img] Marching along, a few of the men take up a game of finding shapes in the clouds. They banter back and forth about dogs and fat women and even of home, but the fun takes a wild turn when %superstitious% sees one odd-shaped cloud that brings %them_superstitious% to %their_superstitious% knees. %They_superstitious% cries out that it is a bad omen, this cloud, and that doom will soon be upon the company. Thankfully, the fear does not grip the rest of the company who, instead of trembling, soon start bickering over whether or not the cloud is truly representative of %randombrother%\'s impressive endowment.}";
        mode = "pattern"
        en = "{[img]gfx/ui/events/event_12.png[/img]Cries whip through the party like the howls of the wind. There is not an enemy in sight so you've no idea what is causing this. You walk the ranks to find %superstitious% practically sobbing on the ground. %They_superstitious% is clutching %their_superstitious% chest with one hand while the other points to the sky, the finger shaking in pointed fear. %otherguy% explains that the %person_superstitious% saw a great blaze of fire cross by the stars. Apparently this pathetic fool takes it for an omen and, of course, it isn't a good one. Whatever it is, it isn't going to get you where you need to be so you order the sellswords to march. | [img]gfx/ui/events/event_12.png[/img] Shadows begin to fold in and on themselves in strange ways. You turn around to see the sun darkening, a great rim of black moving over it. Soon there is no sun at all. %superstitious% cries out that the end times are coming, but before %their_superstitious% wailing can find a grip on the rest of your mercenaries, the great shade unveils the sun once more and there is light again as though nothing happened at all. You tell the pathetic fool to get to %their_superstitious% feet. You've places to march and tears sure as hell won't get you there. | [img]gfx/ui/events/event_11.png[/img] %superstitious% is poking %their_superstitious% sword into a warren when %they_superstitious% suddenly cries out. %They_superstitious% leaps away from the rabbit hole and screams that there is a two headed bunny within. Apparently this is a bad omen of things to come. All you can think is that two heads just means more meat for the stew. | [img]gfx/ui/events/event_11.png[/img]You pass beneath a tree whose branches are occupied by both a black cat and an albino crow. %superstitious% cries at the sight of it, saying that this is surely a sign of the end times. Why yes, of course it is. These things are never a sign of good things, right? Yeesh. | [img]gfx/ui/events/event_11.png[/img] You come across a deer skull. At first it means nothing to you, but %superstitious% picks it up with earnest. Muted dust pours out of the cavity as %they_superstitious% turns it this way and that. Hands trembling, %they_superstitious% throws the head out of %their_superstitious% hands. It clatters hollow against the ground, tumbling over onto where the horns should be. The scared %person_superstitious% claims that a soothsayer once told %them_superstitious% that %they_superstitious% would come across a skull such as this.\n\nThere are many skulls out here, you argue, because things have a tendency to die. Your words do nothing for the %person_superstitious% as %they_superstitious% slowly, and nervously, shuffles back into the marching rank. | [img]gfx/ui/events/event_11.png[/img] Marching along, a few of the men take up a game of finding shapes in the clouds. They banter back and forth about dogs and fat women and even of home, but the fun takes a wild turn when %superstitious% sees one odd-shaped cloud that brings %them_superstitious% to %their_superstitious% knees. %They_superstitious% cries out that it is a bad omen, this cloud, and that doom will soon be upon the company. Thankfully, the fear does not grip the rest of the company who, instead of trembling, soon start bickering over whether or not the cloud is truly representative of %randombrother%'s impressive endowment.}"
        es = "{[img]gfx/ui/events/event_12.png[/img]Unos gritos azotan al grupo como los aullidos del viento. No hay ningún enemigo a la vista, así que no tienes ni idea de qué los provoca. Recorres las filas y te encuentras a %superstitious% prácticamente sollozando en el suelo. Se agarra el pecho con una mano mientras con la otra señala al cielo, con el dedo temblando de miedo. %otherguy% explica que %superstitious% vio una gran llamarada de fuego cruzar junto a las estrellas. Al parecer, %ese_superstitious% patétic%o_superstitious% idiota lo toma por un augurio y, por supuesto, no uno bueno. Sea lo que sea, no te va a llevar adonde necesitas estar, así que ordenas a los mercenarios que se pongan en marcha. | [img]gfx/ui/events/event_12.png[/img] Las sombras empiezan a plegarse sobre sí mismas de formas extrañas. Te das la vuelta y ves que el sol se oscurece mientras un gran borde negro avanza sobre él. Pronto no queda nada de sol. %superstitious% grita que se acerca el fin de los tiempos, pero antes de que sus lamentos hagan mella en el resto de tus mercenarios, la gran sombra descubre de nuevo el sol y vuelve la luz como si no hubiera pasado nada. Le dices %al_superstitious% patétic%o_superstitious% idiota que se ponga en pie. Tienes sitios a los que marchar, y las lágrimas desde luego no te van a llevar allí. | [img]gfx/ui/events/event_11.png[/img] %superstitious% está hurgando con la espada en una madriguera cuando de repente suelta un grito. Se aparta de un salto del agujero y chilla que dentro hay un conejito de dos cabezas. Al parecer, es un mal augurio de lo que está por venir. Lo único que se te ocurre es que dos cabezas solo significan más carne para el guiso. | [img]gfx/ui/events/event_11.png[/img]Pasas bajo un árbol en cuyas ramas hay a la vez un gato negro y un cuervo albino. %superstitious% grita al verlo, diciendo que es sin duda una señal del fin de los tiempos. Pues sí, claro que lo es. Estas cosas nunca son señal de nada bueno, ¿verdad? Madre mía. | [img]gfx/ui/events/event_11.png[/img] Te topas con un cráneo de ciervo. Al principio no significa nada para ti, pero %superstitious% lo recoge con gravedad. Un polvo apagado cae de la cavidad mientras lo gira a un lado y a otro. Con las manos temblorosas, lo arroja lejos de sí. Repiquetea hueco contra el suelo y rueda hasta quedar apoyado donde deberían estar los cuernos. Muert%o_superstitious% de miedo, %superstitious% asegura que una vez un adivino le dijo que se toparía con un cráneo como este.\n\nAquí fuera hay muchos cráneos, le argumentas, porque las cosas tienden a morir. Tus palabras no le sirven de nada mientras, lenta y nerviosamente, vuelve arrastrando los pies a la fila de marcha. | [img]gfx/ui/events/event_11.png[/img] Durante la marcha, algunos de los hombres se ponen a jugar a encontrar formas en las nubes. Bromean sobre perros, mujeres gordas e incluso sobre su hogar, pero la diversión da un giro salvaje cuando %superstitious% ve una nube de forma extraña que %lo_superstitious% hace caer de rodillas. Grita que esa nube es un mal augurio y que la perdición pronto caerá sobre la compañía. Por suerte, el miedo no se apodera del resto de la compañía, que, en lugar de temblar, pronto empieza a discutir sobre si la nube representa de verdad o no la impresionante dotación de %randombrother%.}"
    }
    // FILE: mod_legends\hooks\events\events\ball_on_roof_event.nut
    // context: ball_on_roof_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_97.png[/img]You send %otherbrother% to try and retrieve the ball. Using %otherother% as a stepstool, %they_other% launches himself onto the roof and gets the toy. The boy is ecstatic and the smile on his face warms even the most cynical of your mercenaries."
        es = "[img]gfx/ui/events/event_97.png[/img]Envías a %otherbrother% a intentar recuperar la pelota. Usando a %otherother% como taburete, se lanza al techo y toma el juguete. El niño está extasiado, y la sonrisa de su cara conmueve incluso al más cínico de tus mercenarios."
    }
    // context: ball_on_roof_event.o.create.::Legends.Screens.hook()._screen.start.List.push().text
    {
        en = "The company's moral reputation increases slightly"
        es = "La reputación moral de la compañía aumenta ligeramente"
    }
    // en = "Bad"
    // context: ball_on_roof_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_97.png[/img]You send %otherbrother% to try and retrieve the ball. %They_other% climbs the tree and jumps across a branch to land atop the roof. Mission complete, %they_other% tosses the ball to the kid. Unfortunately, the boy lets go of the tree branch to try and catch it. He slips off the branch and falls a good fifteen feet to the earth. The wallop of his landing has the whole company cringing. When you check on him he isn't moving and his back has taken a new shape. %otherother% yells at the idiot still standing in shock on the roof.%SPEECH_ON%What the hell were you thinking? Holy shit, %person_other%!%SPEECH_OFF%The mercenary climbs down off the roof. %They_other% looks at the kid and then nervously looks around.%SPEECH_ON%Well he, uh, he's got the ball. Let's get the hell out of here. Our... our work here is done.%SPEECH_OFF%What a goatfuck of a situation. You and the company quickly leave the scene before the parents get back."
        es = "[img]gfx/ui/events/event_97.png[/img]Envías a %otherbrother% a intentar recuperar la pelota. Trepa al árbol y salta desde una rama para aterrizar sobre el techo. Misión cumplida: le lanza la pelota al niño. Por desgracia, el niño suelta la rama del árbol para intentar atraparla. Resbala de la rama y cae unos buenos cinco metros hasta el suelo. El golpe del aterrizaje hace que toda la compañía se estremezca. Cuando vas a verlo, no se mueve y su espalda ha adoptado una forma nueva. %otherother% le grita %al_other% idiota que sigue en el techo, en estado de shock.%SPEECH_ON%¿En qué diablos estabas pensando? ¡Mierda, %hombre_other%!%SPEECH_OFF%%otherbrother% baja del techo. Mira al niño y luego mira nerviosamente a su alrededor.%SPEECH_ON%B-bueno, él, eh, ya tiene la pelota. Larguémonos de aquí. Nuestro... nuestro trabajo aquí ha terminado.%SPEECH_OFF%Qué situación más jodida. Abandonas rápidamente la escena con la compañía antes de que vuelvan los padres."
    }
    // en = "Surefooted"
    // context: ball_on_roof_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // _screen.Text = "[img]gfx/ui/events/event_97.png[/img]%surefooted% clears %their_surefooted% throat and steps forward.%SPEECH_ON%I\'ll be your hero, kid.%SPEECH_OFF%%They_surefooted% opens %their_surefooted% arms and the kid jumps down into them. The boy is set aside and the sellsword points a finger to the earth.%SPEECH_ON%Stay down here.%SPEECH_OFF%The surefooted mercenary easily clambers up the tree and jumps over to the roof. %They_surefooted% picks the ball up and spins it on a finger before %they_surefooted% pirouettes off the eave like a tornado, landing right on %their_surefooted% toes with catlike grace. The boy claps excitedly and takes the toy and even the most cynical of mercenaries in the company are warmed by his happiness.";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_97.png[/img]%surefooted% clears %their_surefooted% throat and steps forward.%SPEECH_ON%I'll be your hero, kid.%SPEECH_OFF%%They_surefooted% opens %their_surefooted% arms and the kid jumps down into them. The boy is set aside and the sellsword points a finger to the earth.%SPEECH_ON%Stay down here.%SPEECH_OFF%The surefooted mercenary easily clambers up the tree and jumps over to the roof. %They_surefooted% picks the ball up and spins it on a finger before %they_surefooted% pirouettes off the eave like a tornado, landing right on %their_surefooted% toes with catlike grace. The boy claps excitedly and takes the toy and even the most cynical of mercenaries in the company are warmed by his happiness."
        es = "[img]gfx/ui/events/event_97.png[/img]%surefooted% carraspea y da un paso al frente.%SPEECH_ON%Yo te salvo, chico.%SPEECH_OFF%Abre los brazos y el niño salta a ellos. Deja al niño a un lado y señala el suelo con el dedo.%SPEECH_ON%Tú quédate aquí abajo.%SPEECH_OFF%Con paso seguro, %surefooted% trepa sin esfuerzo al árbol y salta al techo. Recoge la pelota y la hace girar sobre un dedo antes de saltar del alero dando vueltas como un tornado y aterrizar de puntillas con una gracia felina. El niño aplaude emocionado y toma el juguete, e incluso los mercenarios más cínicos de la compañía se ablandan con su felicidad."
    }
    // FILE: mod_legends\hooks\events\events\bastard_assassin_event.nut
    // en = "Take care you bastard."
    // en base_es
    // context: bastard_assassin_event.o.create.s.Options.getResult.::Legends.addFallen()
    {
        en = "Left to claim their birthright"
        es = "Partió a reclamar su derecho de cuna"
    }
    // en = "<bastard:str> is now loyal"
    // en base_es
    // en = "You risked your life for him"
    // en base_es
    // en = "You risked your life for the men"
    // en base_es
    // FILE: mod_legends\hooks\events\events\beggar_begs_event.nut
    // context: beggar_begs_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]{As you take stock of the inventory, you can't help but notice %beggar% lingering in your peripheral. Sighing, you finally turn to the %formerbeggar% and ask what %they_beggar% wants. Like the poorest of the poor %they_beggar% holds a hand out, asking if maybe you could spare a few crowns. | With practiced theatrics, %beggar% approaches you and lets loose a long tale of troubles and squabbles and empty bottles. The %formerbeggar% is down on %their_beggar% luck, apparently, and just needs a few extra crowns to get by. | %otherguy% tells you that %beggar% is going around the camp asking for crowns. Apparently the %formerbeggar% just needs a little more, expressing a longwinded sob story to anyone who'll listen. Hearing this news, you go to see the %person_beggar% yourself but before you can even get a word out the %person_beggar% lets loose %their_beggar% long narrative. Finished, %they_beggar% looks you in the eye, trying to gauge whether or not you'll give %them_beggar% something. | Apparently %beggar% the former beggar needs some help. %They_beggar%'s come to you, begging for a few crowns to help %them_beggar% get by. The %person_beggar% looks like %they_beggar%'s in a poor state, but %they_beggar%'s had plenty of practice of actually being poor so it's hard to tell if %they_beggar%'s being honest or not.}"
        es = "[img]gfx/ui/events/event_05.png[/img]{Mientras haces inventario, no puedes evitar notar que %beggar% ronda por el rabillo de tu ojo. Suspirando, al final te vuelves hacia %art_beggar% %formerbeggar% y le preguntas qué quiere. Como los más pobres entre los pobres, extiende una mano y te pregunta si quizá podrías darle unas cuantas coronas. | Con una teatralidad muy ensayada, %beggar% se te acerca y suelta una larga historia de penurias, riñas y botellas vacías. Por lo visto, %art_beggar% %formerbeggar% está pasando una mala racha y solo necesita unas coronas de más para ir tirando. | %otherguy% te cuenta que %beggar% va por el campamento pidiendo coronas. Al parecer, %art_beggar% %formerbeggar% solo necesita un poco más, y le suelta un larguísimo dramón a quien quiera escuchar. Al oírlo, vas a ver a %beggar% en persona, pero antes de que puedas abrir la boca te suelta su larga narración. Al terminar, te mira a los ojos, intentando adivinar si le vas a dar algo o no. | Por lo visto, %beggar%, que antes mendigaba, necesita algo de ayuda. Ha acudido a ti suplicando unas cuantas coronas para ir tirando. Parece estar en una situación lamentable, pero ha tenido mucha práctica siendo pobre de verdad, así que es difícil saber si está siendo sincer%o_beggar% o no.}"
    }
    // context: beggar_begs_event.o.create.s.Text
    {
        // corrige base: «así es como te atrapan» por «así es como te la juegan»: that's how they get ya es «así te engañan», no «te atrapan»
        en = "[img]gfx/ui/events/event_05.png[/img]{You tell the %justbeggar% you'll cross %their_beggar% hands with a sword if %they_beggar% doesn't get back to work. The %person_beggar% shrugs and pretty much does as told. That was easier than expected. | The %justbeggar%'s shoulders sag as you tell %them_beggar% to get back to work. You feel a little bad, but then remember that's how they get ya.}"
        es = "[img]gfx/ui/events/event_05.png[/img]{Le dices %al_beggar% %justbeggar% que le cruzarás las manos con una espada si no vuelve al trabajo. Se encoge de hombros y hace más o menos lo que le dicen. Ha sido más fácil de lo esperado. | Los hombros %del_beggar% %justbeggar% se hunden cuando le dices que vuelva al trabajo. Te sientes un poco mal, pero luego recuerdas que así es como te la juegan.}"
    }
    // context: beggar_begs_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]{The %justbeggar% takes the crowns and with a smile gets right back to work. | Tired of %their_beggar% games, you give the %justbeggar% a few crowns and tell %them_beggar% to get back to work. %They_beggar% bows and thanks you and, surprisingly, actually gets back to work.}"
        es = "[img]gfx/ui/events/event_05.png[/img]{%Art_beggar% %justbeggar% toma las coronas y, con una sonrisa, vuelve enseguida al trabajo. | Te cansas de sus jueguecitos, le das unas cuantas coronas %al_beggar% %justbeggar% y le dices que vuelva al trabajo. Hace una reverencia, te da las gracias y, para tu sorpresa, vuelve de verdad al trabajo.}"
    }
    // context: beggar_begs_event.o.onPrepareVariables.beggar
    {
        // local beggar = this.m.Beggar.getGender() == 0 ? "former beggar" : "widow";
        en = "former beggar"
        es = "antiguo mendigo"
    }
    // context: beggar_begs_event.o.onPrepareVariables.beggar
    {
        // local beggar = this.m.Beggar.getGender() == 0 ? "former beggar" : "widow";
        en = "widow"
        es = "viuda"
    }
    // en = "beggar"
    // context: beggar_begs_event.o.onPrepareVariables._vars.push()
    // en = "justbeggar"  // nombre de variable de evento (%justbeggar%), no se muestra
    // context: beggar_begs_event.o.onPrepareVariables._vars.push()
    // en = "formerbeggar"  // nombre de variable de evento (%formerbeggar%), no se muestra
    // FILE: mod_legends\hooks\events\events\bowyer_crafts_masterwork_event.nut
    // context: bowyer_crafts_masterwork_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]%bowyer% the bowyer comes to you with a bit of request: they wish to build a weapon for the ages. Apparently, %bowyer% has been attempting to build a bow of legendary qualities for many years, but now that they've has been on the road they've picked up a few things to fill in the gaps of knowledge. Truly, %bowyer% believes they can get it right this time. All tthe mercenary needs is a few resources to help procure the elements needed to construct it. A sum of 500 crowns is humbly requested, and the quality wood you carry."
        es = "[img]gfx/ui/events/event_05.png[/img]%bowyer%, que se dedica a fabricar arcos, acude a ti con una pequeña petición: quiere construir un arma para la posteridad. Por lo visto, %bowyer% lleva muchos años intentando construir un arco de cualidades legendarias, pero desde que anda por los caminos ha aprendido unas cuantas cosas que llenan las lagunas de su conocimiento. %bowyer% cree de verdad que esta vez puede lograrlo. Solo necesita algunos recursos para conseguir los materiales necesarios para construirlo. Te pide humildemente una suma de 500 coronas, además de la madera de calidad que llevas."
    }
    // en = "Build me a bow of legends!"
    // en base_es
    // context: bowyer_crafts_masterwork_event.o.create.s.Options[0].getResult
    // en = "BA"  // ID interno de pantalla de evento (getResult), no se muestra
    // en = "You spend <v:str_tag> Crowns"
    // en base_es
    // en = "You lose <item:str>"
    // en base_es
    // en = "<bowyer:str>'s <name:str>"
    // en base_es
    // en = "Created a masterwork"
    // en base_es
    // context: bowyer_crafts_masterwork_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]{This isn't the bow you expected, but it is an amazing creation. Your bowyer and inventor collaborated to make a minaturised crossbow that is attached to the wrist. It is light and easy to carry along side your main weapon without impeding weapon usage, but it has less damage than a regular crossbow. A curious invention that may enable some interesting tactics, and if nothing else will net a fair price in the market. You congratulate the bowyer.}"
        es = "[img]gfx/ui/events/event_05.png[/img]{No es el arco que esperabas, pero es una creación asombrosa. Quien te fabrica los arcos y quien te inventa artilugios han colaborado para crear una ballesta en miniatura que se sujeta a la muñeca. Es ligera y fácil de llevar junto al arma principal sin estorbar su uso, pero hace menos daño que una ballesta normal. Un invento curioso que puede permitir tácticas interesantes y que, como mínimo, alcanzará un buen precio en el mercado. Felicitas a quien fabrica tus arcos.}"
    }
    // en = "A masterwork!"
    // en base_es
    // FILE: mod_legends\hooks\events\events\brawler_teaches_event.nut
    // context: brawler_teaches_event.o.create.s.Text
    {
        // corrige base: «Usted pregunta» por «Preguntas»: el narrador tutea al capitán
        // corrige base: «te mira» por «te mira desde arriba» (looks down at you)
        en = "[img]gfx/ui/events/event_05.png[/img]A shadow crosses over you from behind. When you look back, %brawler% is standing there with a rather distant look in %their_brawler% eyes. %They_brawler% cracks %their_brawler% knuckles in one long staccato before asking if %they_brawler% can train up %noncom%. You ask why. The brawler looks down at you.%SPEECH_ON%Because weakness must leave the body through pain.%SPEECH_OFF%Hmmm, good enough."
        es = "[img]gfx/ui/events/event_05.png[/img]Una sombra te cubre por detrás. Cuando te das la vuelta, %brawler% está ahí plantad%o_brawler%, con una mirada bastante distante. Se hace crujir los nudillos en un largo staccato antes de preguntar si puede entrenar a %noncom%. Preguntas por qué. %brawler% te mira desde arriba.%SPEECH_ON%Porque la debilidad tiene que salir del cuerpo a través del dolor.%SPEECH_OFF%Mmm, razón suficiente."
    }
    // context: brawler_teaches_event.o.create.s.Options[0].Text
    {
        // corrige base: «puede» por «puedes»: el sujeto de «you can» es quien entrena, al que se habla
        en = "See how long you can keep it going."
        es = "A ver cuánto tiempo puedes mantenerlo."
    }
    // context: brawler_teaches_event.o.create.s.Options[1].Text
    {
        en = "Toughen em up, will you?"
        es = "Haz que se curta, ¿quieres?"
    }
    // context: brawler_teaches_event.o.create.s.Options[2].Text
    {
        en = "Show em how to brawl."
        es = "Enséñale a pelear."
    }
    // context: brawler_teaches_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_06.png[/img]%brawler% and %noncom% are found in a mudpit with their hands wrapped in cloth and leaves, padding for the knuckles and to keep them from cutting one another with every punch. The brawler has %their_brawler% trainee bouncing counter-clockwise along the ring of the fighting circle, punching the air as they go, and with the trainer hitting or kicking every time the student passes by. The mercenaries glisten with sweat as they work. When %noncom% begins to slow, %brawler% hits hard as though a jockey would a sluggish horse.\n\n After an hour of this, %brawler% steps back and invites %their_brawler% trainee to attack %them_brawler%. Predictably, the assault is aimless and pitiful. Long, looping punches are thrown with no energy behind them. The brawler ducks and weaves out of the way, punching every attempted strike with a counter-punch of %their_brawler% own.%SPEECH_ON%See what happens when you are tired? This is why we must train. Even the most able and deadly are worth nothing without air in their lungs and fresh legs beneath them.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_06.png[/img]Encuentras a %brawler% y %noncom% en un lodazal, con las manos envueltas en tela y hojas para acolchar los nudillos y no cortarse con cada puñetazo. %brawler% tiene a su aprendiz dando saltitos en sentido contrario a las agujas del reloj alrededor del círculo de pelea, golpeando el aire a cada paso, y cada vez que pasa por delante le suelta un puñetazo o una patada. Les brilla el sudor mientras trabajan. Cuando %noncom% empieza a aflojar, %brawler% le pega fuerte, como haría un jinete con un caballo perezoso.\n\n Después de una hora así, %brawler% retrocede e invita a su aprendiz a atacar%lo_brawler%. Como era de esperar, el asalto no tiene rumbo y es lamentable. Lanza golpes largos y circulares sin energía alguna. %brawler% se agacha y se aparta esquivando, y responde a cada intento de golpe con un contragolpe propio.%SPEECH_ON%¿Ves lo que pasa cuando te cansas? Por eso tenemos que entrenar. Hasta los más capaces y letales no valen nada sin aire en los pulmones y sin piernas frescas que los sostengan.%SPEECH_OFF%"
    }
    // context: brawler_teaches_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_06.png[/img]The brawler has %noncom% stand completely still. %They_brawler% circles about, cracking %their_brawler% knuckles as %they_brawler% sizes the trainee up. Finally, %they_brawler% lets %their_brawler% intentions be known.%SPEECH_ON%I am going to beat you until you break.%SPEECH_OFF%A moment is given to the trainee to acknowledge what is about to happen, who sucks in a great gulp of breath and then nods. %brawler% wastes no time wheeling a bola punch right into the chest. The trainee bowls over and is kicked in the shoulder repeatedly until managing to stand back up.\n\nThere the brawler continues to circle and deliver blows. Not every strike is thrown with conviction: most are meant to inflict pain, but not what could be called irreversible damage. The brawler, if %they_brawler% wanted to, could kill this mercenary with %their_brawler% bare fists, but that is not the purpose of this training. You realize that this mode of 'toughening up' probably happened to the brawler %themselves_brawler% at some point or another."
        es = "[img]gfx/ui/events/event_06.png[/img]%brawler% hace que %noncom% se quede completamente inmóvil. Da vueltas a su alrededor, haciéndose crujir los nudillos mientras evalúa a su aprendiz. Por fin, deja clara su intención.%SPEECH_ON%Voy a darte una paliza hasta que te rompas.%SPEECH_OFF%Le concede un momento a su aprendiz para asimilar lo que está a punto de pasar; %noncom% toma una gran bocanada de aire y asiente. %brawler% no pierde el tiempo y le planta un amplio golpe en molinete en pleno pecho. %noncom% se dobla y recibe patadas en el hombro una y otra vez hasta que logra ponerse de nuevo en pie.\n\nAhí %brawler% sigue dando vueltas y repartiendo golpes. No todos llevan convicción: la mayoría buscan causar dolor, pero no lo que podría llamarse un daño irreversible. Si quisiera, %brawler% podría matar a %noncom% con sus propios puños, pero ese no es el propósito de este entrenamiento. Te das cuenta de que este modo de «curtir» seguramente se lo aplicaron a %el_brawler% mism%o_brawler% en un momento u otro."
    }
    // context: brawler_teaches_event.o.create.s.Text
    {
        // corrige base: «dispara debajo de los brazos» por «se lanza por debajo de los brazos»: shoots in es el derribo de lucha, no disparar
        en = "[img]gfx/ui/events/event_06.png[/img]%brawler% the heavy-handed-rough-and-tumble brawler is found leaning over, %their_brawler% arms fenced out before %themselves_brawler% in a defensive posture, and %noncom% is standing adjacent, trying to mimic the stance. The brawler drops %their_brawler% body low and shoots in under %noncom%'s arms, there wrapping both hands around the waist and lifting up in the air before dumping the trainee hard, back smacking into the ground. %brawler% steps away, cracking %their_brawler% knuckles and telling %noncom% to get up.%SPEECH_ON%You need to be ready for two things: me coming in low, and me coming in high.%SPEECH_OFF%%noncom% dusts off then complains a little.%SPEECH_ON%How can I possibly do both?%SPEECH_OFF%The brawler ignores the question and simply asks the trainee to attack %them_brawler%. %noncom% obliges, coming in high with a hurled fist. %brawler% deflects the blow with a shoulder-roll before throwing a cross-counter that has %noncom% spinning on %their_student% feet. The fist-fighter cracks %their_brawler% knuckles again and spits.%SPEECH_ON%Practice. That's how. Now get back up and let's go again.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_06.png[/img]Encuentras a %brawler%, todo mano dura y pelea sin reglas, inclinad%o_brawler% hacia delante, con los brazos en guardia defensiva, y a %noncom% al lado, intentando imitar la postura. %brawler% baja el cuerpo y se lanza por debajo de los brazos de %noncom%, le rodea la cintura con ambas manos y alza a su aprendiz por los aires antes de estrellarle la espalda contra el suelo. %brawler% se aparta, haciéndose crujir los nudillos, y le dice a %noncom% que se levante.%SPEECH_ON%Tienes que prepararte para dos cosas: que entre por abajo y que entre por arriba.%SPEECH_OFF%%noncom% se sacude el polvo y luego se queja un poco.%SPEECH_ON%¿Y cómo voy a poder con las dos?%SPEECH_OFF%%brawler% ignora la pregunta y se limita a pedirle a su aprendiz que %lo_brawler% ataque. %noncom% obedece y entra por arriba con un puñetazo. %brawler% desvía el golpe rodando el hombro antes de soltar un contragolpe cruzado que hace girar a %noncom% sobre sus pies. %brawler% vuelve a hacerse crujir los nudillos y escupe.%SPEECH_ON%Practicando. Así se hace. Ahora levántate y otra vez.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\bright_vs_dumb_event.nut
    // context: bright_vs_dumb_event.o.create.s.Text
    {
        // corrige base: «entonada con sarcasmo» por «con tonito empalagoso»: smarmily es zalamero, no sarcástico
        en = "[img]gfx/ui/events/event_15.png[/img]%dumb% is perhaps one of the dumbest individuals you've ever met but, for a brief moment, it does appear that %bright% gets through and teaches %them_dumb% a thing or two about critical thinking and memorization. You watch as the two sit together and look over some scrolls. You're not sure where the smart %person_bright% got such papers, but the unlearning oaf is certainly paying a lot of attention to them.\n\nAs you watch, %dumb% is asking rather deep, profound questions. Questions about the land and its relationship to people, and the sky and its relationship to the birds. You slowly realize the idiot is merely glancing around and describing what %they're_dumb% seeing in the sort of 'inquisitive' language %bright% has taught %them_dumb% - namely by attaching a smarmily-intoned question to the end of every sentence. When the two finish up, %bright% comes to you with a grin.%SPEECH_ON%I think we're really getting somewhere with %them_dumb%. %They're_dumb% learning, you know? With students like that, all you gotta do is be patient and take your time.%SPEECH_OFF%A little ways away, %dumb% is pounding ants with a rock. You simply nod and let %bright% live out every teacher's biggest fantasy."
        es = "[img]gfx/ui/events/event_15.png[/img]%dumb% es quizá una de las personas más tontas que hayas conocido pero, durante un breve momento, parece que %bright% consigue hacerse entender y le enseña un par de cosas sobre pensamiento crítico y memorización. Observas cómo los dos se sientan juntos a repasar unos pergaminos. No sabes de dónde ha sacado esos papeles %art_bright% list%o_bright%, pero desde luego %art_dumb% zoquete que no aprende les está prestando mucha atención.\n\nMientras observas, %dumb% hace preguntas bastante hondas y profundas. Preguntas sobre la tierra y su relación con la gente, y sobre el cielo y su relación con los pájaros. Poco a poco te das cuenta de que %art_dumb% idiota se limita a mirar a su alrededor y a describir lo que ve con el tipo de lenguaje «inquisitivo» que %bright% le ha enseñado: es decir, añadiendo una pregunta con tonito empalagoso al final de cada frase. Cuando terminan, %bright% se te acerca con una sonrisa.%SPEECH_ON%Creo que de verdad estamos avanzando con %el_dumb%. Está aprendiendo, ¿sabes? Con estudiantes así, solo tienes que tener paciencia y tomarte tu tiempo.%SPEECH_OFF%Un poco más allá, %dumb% está aplastando hormigas con una piedra. Te limitas a asentir y dejas que %bright% viva la mayor fantasía de todo profesor."
    }
    // FILE: mod_legends\hooks\events\events\broken_cart_event.nut
    // context: broken_cart_event.o.create.::Legends.Screens.hook()._screen.start.List.push().text
    {
        en = "The company's moral reputation increases"
        es = "La reputación moral de la compañía aumenta"
    }
    // en = "D"
    // context: broken_cart_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «usted extiende» por «extiendes» (el narrador tutea al capitán) y «una fila de sus hombres» por «una fila de tus hombres» (your men)
        en = "[img]gfx/ui/events/event_55.png[/img]You order the men to search the cart and take what they can. %randombrother% draws %their_randombrother% sword and looks ready to slay the donkey, the animal looking stupidly at its own mortality in the reflection of the blade. The merchant cries out and you hold your hand out, staying the execution.%SPEECH_ON%Leave the draught animal where it stands.%SPEECH_OFF%The trader offers meager thanks as a line of your men walk behind him, his very goods in their hands."
        es = "[img]gfx/ui/events/event_55.png[/img]Ordenas a los hombres que registren el carro y se lleven lo que puedan. %randombrother% desenvaina la espada y parece a punto de matar al burro, que contempla estúpidamente su propia mortalidad en el reflejo de la hoja. El comerciante grita y extiendes la mano para detener la ejecución.%SPEECH_ON%Deja al animal de tiro donde está.%SPEECH_OFF%El comerciante te da unas escasas gracias mientras una fila de tus hombres pasa a su espalda, con sus propias mercancías en las manos."
    }
    // context: broken_cart_event.o.create.::Legends.Screens.hook()._screen.start.List.push().text
    {
        en = "The company's moral reputation decreases"
        es = "La reputación moral de la compañía disminuye"
    }
    // FILE: mod_legends\hooks\events\events\broken_wagon_in_swamp_event.nut
    // context: broken_wagon_in_swamp_event.o.create.s.Text
    {
        // corrige base: «machacar» por «dar tajos a»: hacking es cortar a golpes, no machacar
        en = "[img]gfx/ui/events/event_14.png[/img]%SPEECH_ON%Sir, wait.%SPEECH_OFF%The former meat seller, %butcher%, says. The mercenary moves on ahead and starts hacking at the corpse of a horse. %butcher% cuts out a series of chunks, wraps them in large leaves, dries them with a bit of dirt and salt, and hands them over.%SPEECH_ON%No reason in leaving behind what can be used.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_14.png[/img]%SPEECH_ON%Espere, jefe.%SPEECH_OFF%Dice %butcher%, que antes vendía carne. Se adelanta y empieza a dar tajos al cadáver de un caballo. %butcher% corta una serie de pedazos, los envuelve en hojas grandes, los seca con un poco de tierra y sal y te los entrega.%SPEECH_ON%No hay motivo para dejar atrás lo que se puede aprovechar.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\butcher_gives_pointers_event.nut
    // context: butcher_gives_pointers_event.o.create.s.Text
    {
        // corrige base: "taps it" es darle unos toquecitos, no "lo golpea"; "snap against" es restallar contra la espalda, no "se rompen"; "upon retrieval" es al retirarlos.
        en = "[img]gfx/ui/events/event_38.png[/img]You find %butcher% the butcher tracing a finger along %flagellant%'s unclothed back. He finds a point between the sinews and scars and taps it.%SPEECH_ON%Here. If you strike yourself here, the largest amount of meat - I mean muscle, I will be hit.%SPEECH_OFF%The flagellant looks up.%SPEECH_ON%Will it be painful?%SPEECH_OFF%A grin crosses the butcher's face.%SPEECH_ON%Oh yes, very much so.%SPEECH_OFF%It appears the man is giving the flagellant pointers on how to mark himself up. Before you can step in, %flagellant% takes up a whip and hits himself right where %butcher% had directed him to. The tendrils of leather, glass, and sharpened bone snap against the man's back, dig in, and then upon retrieval tear his flesh asunder."
        es = "[img]gfx/ui/events/event_38.png[/img]Encuentras a %butcher% el carnicero recorriendo con un dedo la espalda desnuda de %flagellant%. Encuentra un punto entre los tendones y las cicatrices y le da unos toquecitos.%SPEECH_ON%Aquí. Si te golpeas aquí, la mayor cantidad de carne, quiero decir, de músculo, recibirá el golpe.%SPEECH_OFF%El flagelante alza la vista.%SPEECH_ON%¿Será doloroso?%SPEECH_OFF%Una sonrisa cruza el rostro del carnicero.%SPEECH_ON%Oh, sí, muchísimo.%SPEECH_OFF%Parece que el hombre le está dando al flagelante consejos sobre cómo marcarse. Antes de que puedas intervenir, %flagellant% toma un látigo y se golpea justo donde %butcher% le había indicado. Los zarcillos de cuero, vidrio y hueso afilado restallan contra la espalda del hombre, se clavan y luego, al retirarlos, le desgarran la carne."
    }
    // FILE: mod_legends\hooks\events\events\butcher_vs_wardog_event.nut
    // context: butcher_vs_wardog_event.o.create.s.Text
    {
        // corrige base: "the bitch" estaba rebajado a "el perro" (es "la perra"); "yelp" es un gañido, no un grito; "cleaver" es una cuchilla, no un cuchillo.
        en = "[img]gfx/ui/events/event_27.png[/img]You hear a yelp and quickly rush to the noise. When you get there, you're not sure whether it was human or dog that produced it. %butcher% the butcher is holding a cleaver up and a wardog is rearing beneath them, both sides ready to lunge. The mercenary sees you and quickly sheathes the weapon. The hound takes a squat and throws some puppy eyes your way. Raising an eyebrow, you try not to make sense of the scene.%SPEECH_ON%Play nice now.%SPEECH_OFF%The butcher scoffs.%SPEECH_ON%Oy', me and the bitch were just having a talk that's all.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_27.png[/img]Escuchas un gañido y corres rápidamente hacia el ruido. Cuando llegas, no tienes claro si fue una persona o el perro quien lo soltó. Allí está %butcher%, con una cuchilla de carnicero en alto, y debajo un perro de guerra se encabrita, ambos lados listos para abalanzarse. Al verte, guarda rápidamente el arma. El sabueso se sienta y te lanza una mirada de cachorro. Alzando una ceja, ni siquiera intentas encontrarle algún sentido a la escena.%SPEECH_ON%Pórtense bien, ¿eh?%SPEECH_OFF%%butcher% suelta un bufido burlón.%SPEECH_ON%Eh, la perra y yo solo estábamos charlando, eso es todo.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\butcher_wardogs_event.nut
    // context: butcher_wardogs_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_27.png[/img]You open a crate of food to find the last of your reserves. An apple rolls across the bottom, sounding not unlike the grumble of an empty stomach as it totters about. A few loaves of bread give it some company and there is a piece of meat wrapped in a thick leaf. That's it.\n\nWhen you close the lid and turn around, %butcher% the butcher is standing there.%SPEECH_ON%Hey there boss. I see we got a problem. So how about I... fix it?%SPEECH_OFF%Just then, a thumb goes over the shoulder, right in the direction of two war dogs chained up to a stake."
        es = "[img]gfx/ui/events/event_27.png[/img]Abres una caja de comida para encontrar lo último de tus reservas. Una manzana rueda por el fondo, sonando similar al gruñido de un estómago vacío mientras se tambalea. Unas hogazas de pan le hacen compañía y hay un trozo de carne envuelto en una hoja gruesa. Eso es todo.\n\nCuando cierras la tapa y te das la vuelta, tienes delante a %butcher%, que antes trabajaba en una carnicería.%SPEECH_ON%Hola, jefe. Veo que tenemos un problema. Entonces, ¿qué tal si... lo arreglo?%SPEECH_OFF%En ese momento, señala con el pulgar por encima del hombro, justo en dirección a dos perros de guerra encadenados a una estaca."
    }
    // context: butcher_wardogs_event.o.create.s.Text
    {
        // corrige base: "company" es la compañía, no "la empresa".
        en = "[img]gfx/ui/events/event_14.png[/img]The dogs are sitting rather studiously, panting and looking pretty content, so durable is their sense of happiness. But you've mouths to feed and battles to fight. You give %butcher% the go ahead to do what is right for the company.\n\nThe butcher meanders toward the mutts, holding out one hand to pet them as the other clutches a hidden knife. You do not stick around to watch what happens next, but a short yelp quickly followed by another turns your already empty stomach."
        es = "[img]gfx/ui/events/event_14.png[/img]Los perros están sentados con bastante atención, jadeando y luciendo muy contentos, tan duradera es su sensación de felicidad. Pero tienes bocas que alimentar y batallas que pelear. Le das a %butcher% el visto bueno para hacer lo correcto para la compañía.\n\n%butcher% se acerca sin prisa a los chuchos, extendiendo una mano para acariciarlos mientras con la otra empuña un cuchillo escondido. No te quedas a ver qué pasa a continuación, pero un breve gañido seguido rápidamente por otro te revuelve el estómago, que ya está vacío."
    }
    // FILE: mod_legends\hooks\events\events\caravan_hand_cart_event.nut
    // context: caravan_hand_cart_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_55.png[/img]You come across the once-caravan hand, %caravanhand%, finicking with the company wagon. %They_caravanhand%'s nailing a slat of board to the bed and using pins to put it on a roller. The board can then drop down into the belly of the wagon with a little bit of a pull and switch. Rather ingenious. This will allow you to load more onto the wagon."
        es = "[img]gfx/ui/events/event_55.png[/img]Encuentras a %caravanhand%, antigu%o_caravanhand% caravaner%o_caravanhand%, trasteando con el carro de la compañía. Está clavando un listón de madera a la plataforma y usando pasadores para montarlo sobre un rodillo. Así, con un tirón y un giro de palanca, el listón puede bajar hasta el vientre del carro. Bastante ingenioso. Esto te permitirá cargar más cosas en el carro."
    }
    // FILE: mod_legends\hooks\events\events\cat_on_tree_event.nut
    // context: cat_on_tree_event.o.create.s.Text
    {
        // corrige base: "thank you for your troubles" es "te agradecen las molestias", no "le agradecen sus problemas".
        en = "[img]gfx/ui/events/event_97.png[/img]%archer% nocks an arrow and sticks their tongue out while aiming up the tree. The girl and boy don't seem fond of this idea and clap their hands over their eyes. The archer looses the shot and it cracks against the cat's branch, breaking it and sending the cat cartwheeling down the tree like a game of devil sticks. When it hits the ground, the boy and girl lunge on it. They pet it and thank you for your troubles. The girl squeezes the cat warmly.%SPEECH_ON%Finally, we got ourselves something to eat!%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_97.png[/img]%archer% coloca una flecha y saca la lengua mientras apunta hacia lo alto del árbol. A la niña y al niño no parece gustarles la idea y se tapan los ojos con las manos. Sale el tiro, que choca contra la rama del gato, la rompe y manda al gato dando volteretas árbol abajo como en un juego de palos del diablo. Cuando llega al suelo, el niño y la niña se abalanzan sobre él. Lo acarician y te agradecen las molestias. La niña aprieta cariñosamente al gato.%SPEECH_ON%¡Por fin tenemos algo de comer!%SPEECH_OFF%"
    }
    // context: cat_on_tree_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_97.png[/img]%archer% readies, nocking an arrow and taking aim. The cat purrs as it stares down the line of the shot, rather sublime in its suicidal stance. Closing one eye, the archer lets the arrow fly. There isn't much mewling to be had. The cat tumbles down the tree like a game of devil sticks and lands on the ground with an arrow shaft halfway out its head. The girl crouches down and stares at the slinky bit of brain wobbling off the arrowtip. She looks up at you, as though it were you who fired the shot.%SPEECH_ON%That was my friend.%SPEECH_OFF%You tell her you're sorry and that she'll find more friends. As for the boy, he pockets the bit of brain and slings the cat carcass over his shoulder. He bleakly states.%SPEECH_ON%At least we've somethin' to eat now.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_97.png[/img]%archer% se prepara, coloca una flecha y apunta. El gato ronronea mientras mira fijamente la línea de tiro, casi sublime en su postura suicida. Con un ojo cerrado, suelta la flecha. No hay muchos maullidos. El gato cae del árbol dando tumbos como en un juego de palos del diablo y aterriza en el suelo con media asta de flecha asomándole de la cabeza. La niña se agacha y se queda mirando el trocito de sesos, blando como gelatina, que se bambolea en la punta de la flecha. Alza la vista hacia ti, como si hubieras sido tú quien disparó.%SPEECH_ON%Era mi amigo.%SPEECH_OFF%Le dices que lo sientes y que encontrará más amigos. En cuanto al niño, se guarda el trocito de sesos en el bolsillo y se echa el cadáver del gato al hombro. Dice con tono sombrío.%SPEECH_ON%Al menos ahora tenemos algo pa' comer.%SPEECH_OFF%"
    }
    // context: cat_on_tree_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_97.png[/img]%ratcatcher% snaps their fingers.%SPEECH_ON%Oy, I'veuhplan! You little runts just wait a moment!%SPEECH_OFF%The rat catcher takes a rat out of a pocket you'd no idea they even had. Chirping through lips like a mewling cat, the ratcatcher holds the little rodent up. The cat takes notice, perking its ears.%SPEECH_ON%Yeah that's right you pussy, c'mon down, it's lunch time.%SPEECH_OFF%The rat catcher brings the rat to their lips and whispers.%SPEECH_ON%No it's not, heheh.%SPEECH_OFF%As the cat descends, %ratcatcher% holds the friend out a little more. It begins to scrape and scuttle against the mercenary's hands, perhaps not trusting its master to keep it. But the moment the cat lunges for the meal, the rat catcher pockets the rat and snags the cat all in one swift motion. The children clap and cheer as the cat is handed over. Even some of the company are impressed by the catcher's feline-like reflexes!"
        es = "[img]gfx/ui/events/event_97.png[/img]%ratcatcher% chasquea los dedos.%SPEECH_ON%¡Eh, tengounplan! ¡Ustedes, renacuajos, esperen un momento!%SPEECH_OFF%%ratcatcher% saca una rata de un bolsillo que ni sabías que tenía. Haciendo ruiditos con los labios como un gato que maúlla, levanta en alto al pequeño roedor. El gato se fija y levanta las orejas.%SPEECH_ON%Sí, eso es, minino cobarde, baja, que es la hora del almuerzo.%SPEECH_OFF%Se acerca la rata a los labios y susurra.%SPEECH_ON%No, no lo es, jejeje.%SPEECH_OFF%Mientras el gato baja, %ratcatcher% adelanta un poco más a su amiguita. La rata empieza a arañar y a revolverse entre sus manos, quizá sin fiarse de que vaya a salir bien parada. Pero en cuanto el gato se lanza a por su comida, %ratcatcher% se guarda la rata en el bolsillo y atrapa al gato en un solo movimiento rápido. Los niños aplauden y vitorean cuando les entregan el gato. ¡Incluso algunos de la compañía quedan impresionados por esos reflejos felinos!"
    }
    // FILE: mod_legends\hooks\events\events\childrens_crusade_event.nut
    // en = "%monk%, you speak for the old gods. What say you?"
    // en base_es
    // context: childrens_crusade_event.o.create.s.start.Options.push().Text
    {
        // Text = "%shieldmaiden%, why don\'t you show these runts what war really feels like.",
        mode = "pattern"
        en = "%shieldmaiden%, why don't you show these runts what war really feels like."
        es = "%shieldmaiden%, ¿por qué no les enseñas a estos mocosos lo que es la guerra de verdad?"
    }
    // context: childrens_crusade_event.o.create.s.start.Options.push().getResult
    // en = "Shieldmaiden"  // identificador de pantalla que devuelve getResult, no se muestra
    // context: childrens_crusade_event.o.create.s.start.Options.push().Text
    {
        en = "%doubter%, you've travelled up there. Say something."
        es = "%doubter%, tú has estado por allá arriba. Di algo."
    }
    // context: childrens_crusade_event.o.create.s.start.Options.push().getResult
    // en = "Doubter"  // identificador de pantalla que devuelve getResult, no se muestra
    // en = "%walker%, you've travelled up there. Say something."
    // en base_es
    // en = "Traveller"
    // en = "I'll save you the long walk and rid you of any valuables right here."
    // en base_es
    // en = "Good luck, I guess."
    // en base_es
    // context: childrens_crusade_event.o.create.s.Text
    {
        // corrige base: "slaves" es errata del inglés por "slavers" (esclavistas) y la 1.0 rompía la concordancia ("los esclavos no les importará"); "dónde estamos" llevaba tilde de más.
        en = "[img]gfx/ui/events/event_97.png[/img]You tell the kids to go home to their parents. The leader laughs and the others follow suit, like little 'uns easily impressed by their big brother. He shakes his head.%SPEECH_ON%Why do you think we've come this far? Our parents know right where we are, and they know where we are is truthfully right. The old gods need to be known throughout the land! Now, make way!%SPEECH_OFF%The kids press forth. A little banner flaps past you and there is much clinking and clanking of their little weapons, mostly bottles and slingshots and tableware.\n\n No doubt they are marching toward certain doom. Raiders and vagabonds are sure to prey upon them, like hawks upon lemmings, and slaves don't mind making ostensibly orphaned children 'disappear'. Were they to get further than those threats, the northern wastes will provide for them a frozen coffin to die in. \n\n [img]gfx/ui/icons/asset_moral_reputation.png[/img] The company's Moral reputation increases slightly"
        es = "[img]gfx/ui/events/event_97.png[/img]Les dices a los niños que se vayan a casa con sus padres. El líder se ríe y los demás hacen lo mismo, como críos que se impresionan fácilmente con su hermano mayor. Sacude la cabeza.%SPEECH_ON%¿Por qué crees que hemos llegado tan lejos? Nuestros padres saben exactamente dónde estamos, y saben que donde estamos es justo donde debemos estar. ¡Los dioses antiguos necesitan ser conocidos en todo el país! ¡Ahora, abran paso!%SPEECH_OFF%Los niños siguen adelante. Una pequeña bandera ondea junto a ti y hay mucho tintineo y golpeteo de sus pequeñas armas, en su mayoría botellas, tirachinas y utensilios de mesa.\n\n Sin duda, están marchando hacia una muerte segura. Los saqueadores y vagabundos seguramente se cebarán con ellos, como halcones con lemmings, y a los esclavistas no les importa hacer 'desaparecer' a niños aparentemente huérfanos. Si lograran superar esas amenazas, los yermos del norte les proporcionarán un ataúd helado en el que morir. \n\n [img]gfx/ui/icons/asset_moral_reputation.png[/img] La reputación moral de la compañía aumenta ligeramente"
    }
    // context: childrens_crusade_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_97.png[/img]%monk% the holy steps forward and brings the children to a huddle. They instantly respect the religious figure, representing in part the very cause they wish to promote. %monk% bends a knee.%SPEECH_ON%Was it the old gods who told you to come out and do this?%SPEECH_OFF%The little leader nods.%SPEECH_ON%They spoke to me in my sleep.%SPEECH_OFF%The monk nods back, hand rubbing chin, mulling it over and then patting the boy on his head.%SPEECH_ON%The old gods speak to me and I for them. Interpreting their message requires years of study, let me tell you! Are you certain that it was you, little one, that was meant to carry this burden? Perhaps you were to be the messenger, no? See us, we're warriors. Fit, fighting folk who can kill those who despise and demark the old gods. You are not yet like us, but you have a strong voice and the command of a true leader yet. I believe the old gods wanted to use you for your charisma, not your muscles.%SPEECH_OFF%The monk gives the boy a playful push. He smiles, realizing the truth of what the friar has to say. The little leader tells his party that they are to return home as the monk is assuredly right. Some men are thankful that these kids were talked out of going to a certain doom."
        es = "[img]gfx/ui/events/event_97.png[/img]%monk%, con toda su santidad, da un paso adelante y reúne a los niños en corro. Al instante respetan a esa figura religiosa, que representa en parte la misma causa que quieren promover. %monk% hinca una rodilla.%SPEECH_ON%¿Fueron los dioses antiguos quienes te dijeron que salieras a hacer esto?%SPEECH_OFF%El pequeño líder asiente.%SPEECH_ON%Me hablaron en sueños.%SPEECH_OFF%%monk% asiente a su vez, frotándose la barbilla, lo sopesa y luego le da unas palmaditas en la cabeza al niño.%SPEECH_ON%Los dioses antiguos me hablan a mí, y yo hablo por ellos. ¡Interpretar su mensaje requiere años de estudio, créeme! ¿Estás seguro de que eras tú, pequeño, quien debía cargar con este peso? Quizá tenías que ser el mensajero, ¿no? Míranos, somos guerreros. Gente en forma y combativa que puede matar a quienes desprecian y denigran a los dioses antiguos. Todavía no eres como nosotros, pero tienes una voz fuerte y el mando de un verdadero líder. Creo que los dioses antiguos querían usarte por tu carisma, no por tus músculos.%SPEECH_OFF%%monk% le da al niño un empujoncito juguetón. Él sonríe, al darse cuenta de la verdad de lo que acaba de oír. El pequeño líder le dice a su grupo que deben volver a casa, pues sin duda %monk% tiene razón. Algunos hombres agradecen que hayan convencido a estos niños de no marchar hacia una muerte segura."
    }
    // context: childrens_crusade_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_97.png[/img]Taking off well worn boots, %walker%'s feet reveal battered soles to the children. They recoil, gagging and covering their mouths. A little girl lets out a long 'ewww' to really drive the point home. %walker% wags a foot around, showing off disgustingly calloused skin.%SPEECH_ON%I spent years on the road and most of them without a good shoe to step with. I know what it's like out there. I've seen the dangers. People stabbing one another in their sleep. Killing for a bite of a biscuit. Strangers befriend ya so they can betray ya. And all that is when it's going well! When it goes bad, it gets... well, it gets real bad. You kids got no business being out here. You'll be raped, murdered, enslaved, tortured, fed to dogs, eaten by boars, bears, wolves, all things that look at ya like it's lunchtime on two legs. Go home. The lot of you.%SPEECH_OFF%The band of children murmurs amongst themselves. One announces he's going back to his mom. A little girl states that she didn't even want to be out here anyway and never got the treats she was promised. Sensing a morale break, the little leader tries to corral the children, but it's no use. The group breaks apart and, thankfully, starts going home. Some of the mercenaries are relieved as they did not wish to see the little ones continue their doomed journey."
        es = "[img]gfx/ui/events/event_97.png[/img]Al quitarse las botas gastadas, %walker% les enseña a los niños unas plantas de los pies destrozadas. Retroceden, con arcadas y tapándose la boca. Una niña suelta un largo 'puaaaj' para que quede bien claro. %walker% agita un pie de un lado a otro, presumiendo de una piel asquerosamente encallecida.%SPEECH_ON%Pasé años en el camino, y la mayoría sin un buen zapato con el que pisar. Sé cómo es aquello. He visto los peligros. Gente que se apuñala mientras duerme. Que mata por un mordisco de galleta. Desconocidos que se hacen tus amigos para poder traicionarte. ¡Y eso es cuando las cosas van bien! Cuando van mal, se ponen... bueno, se ponen muy feas. Ustedes, niños, no tienen nada que hacer aquí fuera. Los violarán, los asesinarán, los esclavizarán, los torturarán, los echarán a los perros, se los comerán los jabalíes, los osos, los lobos, todo bicho que los mire como si fueran el almuerzo con dos patas. Vete a casa. Tú y todos los demás.%SPEECH_OFF%La banda de niños murmura entre sí. Uno anuncia que se vuelve con su mamá. Una niña declara que, de todos modos, ni siquiera quería estar aquí y que nunca le dieron las golosinas que le prometieron. Al notar que la moral se quiebra, el pequeño líder intenta reagrupar a los niños, pero es inútil. El grupo se disgrega y, por suerte, empieza a volver a casa. Algunos de los mercenarios sienten alivio, pues no querían ver a los pequeños seguir con su viaje condenado."
    }
    // context: childrens_crusade_event.o.create.s.start.List.push().text
    {
        en = "The company's moral reputation decreases greatly"
        es = "La reputación moral de la compañía disminuye mucho"
    }
    // context: childrens_crusade_event.o.create.m.Screens.push().Text
    {
        // Text = "[img]gfx_ui/events/event_50.png[/img]%shieldmaiden% the shieldmaiden looks alarmingly eager as she steps up to the gaggle of little soldiers. She barks at them with such menace that you almost flinch, and it sends a few children physically reeling.%SPEECH_ON%Right then, \'crusaders\'. Let me see your technique, show me how you resist a real charge from a real enemy. Form up- into position!%SPEECH_OFF%She turns her back to the startled albeit enthusiastic horde of kids. She takes a few steps towards you, reveals a wicked smile, then spins on her heels. With a primal howl and mighty rap of her shield, she charges into the mass of flesh, sending a ripple through the meagre formation that sends some children crashing into the muck, with others immediately shattering and turning tail. A few shoves, hollers, and feinted strikes later, and the crusade had been thoroughly killed in its crib- children lay amongst the dirt groaning, others begin to snivel and loudly doubt their holy mission. %shieldmaiden% ends her assault almost as quick as she started it, planting her shield to the floor to offer a hand to the leader of the now broken army. Lifting him up, the ranks begin to reform around your now placated shieldmaiden, and she continues.%SPEECH_ON%See, my brave warriors. Such foes are not to be trifled with at such a tender age. Savages would not show mercy as I have, nor would they give such warning. Together, we can beat them, but for now you would all do better to go home and train, grow- become strong! In time, perhaps I will find you in my shieldwall, side to side as we bring the old gods to that godless land.%SPEECH_OFF%The leader, at first crestfallen from his troop\'s blistering destruction, is renewed with a vigour that could only be childlike naivety. He turns to his host and echoes the shieldmaiden, telling the children that they will serve the old gods in time, but for now they need to practice and prepare themselves. Like a horde of ants, the children begin to spill away in their singular purpose back down the road. %shieldmaiden% returns to you, visibly pleased with her instruction, although perhaps she just enjoyed the mock beatdown. A few of the company applaud her \'hands on\' lesson, others muse at how long such a rabble would have lasted had she not scared them off. Regardless, %shieldmaiden%\'s fierce assault has left her in a markedly better mood- after all, it\'s not everyday you can beat up kids and feel like the good guy.",
        mode = "pattern"
        en = "[img]gfx_ui/events/event_50.png[/img]%shieldmaiden% the shieldmaiden looks alarmingly eager as she steps up to the gaggle of little soldiers. She barks at them with such menace that you almost flinch, and it sends a few children physically reeling.%SPEECH_ON%Right then, 'crusaders'. Let me see your technique, show me how you resist a real charge from a real enemy. Form up- into position!%SPEECH_OFF%She turns her back to the startled albeit enthusiastic horde of kids. She takes a few steps towards you, reveals a wicked smile, then spins on her heels. With a primal howl and mighty rap of her shield, she charges into the mass of flesh, sending a ripple through the meagre formation that sends some children crashing into the muck, with others immediately shattering and turning tail. A few shoves, hollers, and feinted strikes later, and the crusade had been thoroughly killed in its crib- children lay amongst the dirt groaning, others begin to snivel and loudly doubt their holy mission. %shieldmaiden% ends her assault almost as quick as she started it, planting her shield to the floor to offer a hand to the leader of the now broken army. Lifting him up, the ranks begin to reform around your now placated shieldmaiden, and she continues.%SPEECH_ON%See, my brave warriors. Such foes are not to be trifled with at such a tender age. Savages would not show mercy as I have, nor would they give such warning. Together, we can beat them, but for now you would all do better to go home and train, grow- become strong! In time, perhaps I will find you in my shieldwall, side to side as we bring the old gods to that godless land.%SPEECH_OFF%The leader, at first crestfallen from his troop's blistering destruction, is renewed with a vigour that could only be childlike naivety. He turns to his host and echoes the shieldmaiden, telling the children that they will serve the old gods in time, but for now they need to practice and prepare themselves. Like a horde of ants, the children begin to spill away in their singular purpose back down the road. %shieldmaiden% returns to you, visibly pleased with her instruction, although perhaps she just enjoyed the mock beatdown. A few of the company applaud her 'hands on' lesson, others muse at how long such a rabble would have lasted had she not scared them off. Regardless, %shieldmaiden%'s fierce assault has left her in a markedly better mood- after all, it's not everyday you can beat up kids and feel like the good guy."
        es = "[img]gfx_ui/events/event_50.png[/img]%shieldmaiden%, la doncella escudera, parece alarmantemente ansiosa cuando se planta ante el tropel de pequeños soldados. Les ladra con tanta amenaza que casi te estremeces, y a unos cuantos niños los hace tambalearse de verdad.%SPEECH_ON%Muy bien, 'cruzados'. Déjenme ver su técnica, enséñenme cómo resisten una carga de verdad de un enemigo de verdad. ¡Formen... en posición!%SPEECH_OFF%Da la espalda a la sorprendida, aunque entusiasta, horda de críos. Da unos pasos hacia ti, revela una sonrisa malvada y luego gira sobre sus talones. Con un aullido primitivo y un poderoso golpe en el escudo, carga contra la masa de carne, provocando una onda en la escuálida formación que manda a algunos niños de bruces al barro, mientras otros se desbandan al instante y salen huyendo. Unos cuantos empujones, gritos y golpes fingidos después, la cruzada había quedado ahogada en la cuna: unos niños yacen en la tierra gimiendo, otros empiezan a lloriquear y a dudar en voz alta de su santa misión. %shieldmaiden% termina su asalto casi tan rápido como lo empezó, clavando el escudo en el suelo para tenderle la mano al líder del ejército ya deshecho. Mientras lo levanta, las filas empiezan a rehacerse alrededor de tu doncella escudera, ya aplacada, y ella continúa.%SPEECH_ON%Miren, mis valientes guerreros. Con enemigos así no se juega a una edad tan tierna. Los salvajes no mostrarían la piedad que yo he mostrado, ni darían semejante aviso. Juntos podemos vencerlos, pero por ahora harían mejor en volver a casa y entrenar, crecer... ¡hacerse fuertes! Con el tiempo, quizá los encuentre en mi muro de escudos, hombro con hombro mientras llevamos a los dioses antiguos a esa tierra sin dioses.%SPEECH_OFF%El líder, abatido al principio por la fulminante destrucción de su tropa, se renueva con un vigor que solo podría ser ingenuidad infantil. Se vuelve hacia su hueste y repite las palabras de la doncella escudera: servirán a los dioses antiguos con el tiempo, pero por ahora necesitan practicar y prepararse. Como una horda de hormigas, los niños empiezan a desfilar camino abajo con un único propósito. %shieldmaiden% vuelve contigo, visiblemente satisfecha con su lección, aunque quizá solo disfrutó de la paliza simulada. Algunos de la compañía aplauden su lección 'práctica'; otros se preguntan cuánto habría durado semejante chusma si no los hubiera ahuyentado. Sea como sea, el feroz asalto de %shieldmaiden% la ha dejado de un humor notablemente mejor; al fin y al cabo, no todos los días puedes darles una paliza a unos críos y sentirte el bueno de la historia."
    }
    // context: childrens_crusade_event.o.create.m.Screens.push().Options.Text
    {
        en = "You've been waiting for a moment like that, haven't you?"
        es = "Llevabas tiempo esperando un momento así, ¿verdad?"
    }
    // context: childrens_crusade_event.o.create.m.Screens.push().start.List.extend().::Legends.EventList.changeMood()
    {
        en = "Roughhoused kids out of the suicidal crusade"
        es = "Sacó a golpes a unos críos de una cruzada suicida"
    }
    // context: childrens_crusade_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_doubter_kids.png[/img]Looking grizzled and sad %doubter% approaches the kids, gets on a knee down at their level and speaks directly. He encourages them to march on, saying that the heartless fires of war needed their bodies as kindling. He speaks of the inevitability of death, the gruesome horrors of violence, the certainty of injury, a lifetimes of disability for the victors, and the endless entropy which tears at the bodies and souls of fragile humans.  The children stare mouths agape in horror, one cries and another runs. Their crusade is over."
        es = "[img]gfx/ui/events/legend_doubter_kids.png[/img]Con aire curtido y triste, %doubter% se acerca a los niños, hinca una rodilla para ponerse a su altura y les habla sin rodeos. Los anima a seguir marchando, diciéndoles que las despiadadas llamas de la guerra necesitan sus cuerpos como leña. Les habla de la inevitabilidad de la muerte, de los espantosos horrores de la violencia, de la certeza de las heridas, de toda una vida de discapacidad para los vencedores y de la entropía sin fin que desgarra los cuerpos y las almas de los frágiles humanos. Los niños miran boquiabiertos, horrorizados; uno llora y otro sale corriendo. Su cruzada ha terminado."
    }
    // context: childrens_crusade_event.o.create.m.Screens.push().Options.Text
    {
        en = "Always the life of the party."
        es = "Siempre el alma de la fiesta."
    }
    // en = "<actor:str> gains <v:val_tag> Resolve"
    // en base_es
    // en = "Saved some children from certain doom"
    // en base_es
    // context: childrens_crusade_event.o.create.m.Screens.push().start.bro.worsenMood()
    {
        // bro.worsenMood(1.0, "Remembers what " + _event.m.Doubter.getName() + " said about certain doom");
        mode = "pattern"
        en = "Remembers what <name:str> said about certain doom"
        es = "Recuerda lo que dijo <name> sobre una muerte segura"
    }
    // en = "Glad that <monk:str> saved children from certain doom"
    // en base_es
    // context: childrens_crusade_event.o.onPrepareVariables._vars.push()
    // en = "doubter"  // nombre de variable del evento (onPrepareVariables), no se muestra
    // context: childrens_crusade_event.o.onPrepareVariables._vars.push()
    // en = "shieldmaiden"  // nombre de variable del evento (onPrepareVariables), no se muestra
    // FILE: mod_legends\hooks\events\events\cocky_vs_iron_lungs_event.nut
    // context: cocky_vs_iron_lungs_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // _screen.Text = "[img]gfx/ui/events/event_05.png[/img]As you roll up some maps and put them back in their panniers, a commotion draws you outside your tent. The men are dragging %cocky% across the ground. %Their_cocky% clothes are sopping wet and %their_cocky% face one shade short of death. The mercenaries give %them_cocky% some good slaps on the cheeks. Eventually, %they_cocky% wakes up, eyes wild, mouth gargling water like a broken fountain. %They_cocky% looks around and asks what you, too, wish to know.%SPEECH_ON%What happened?%SPEECH_OFF%%ironlungs% walks over, a similarly wet visage, but with a far more colorful complexion.%SPEECH_ON%The cocky cunt dared to see which of us could hold their breath the longest. %They_cocky% lost because they don\'t call these the iron lungs for nuttin\'.%SPEECH_OFF%The company have a laugh as %ironlungs% boastfully pounds %their_ironlungs% chest. %cocky%, still wobbly, gets to %their_cocky% feet. Mere moments after being completely unconscious, %they're_cocky% already back to %their_cocky% prideful ways.%SPEECH_ON%Yeah yeah, you bested me this day, but I shall be the best, just you wait!%SPEECH_OFF%Another sellsword whimsically points out that the cocksure %sibling_cocky% has a huge string of snot dangling from %their_cocky% nose. %They_cocky% confidently wipes it away despite the roaring laughter of the company.";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_05.png[/img]As you roll up some maps and put them back in their panniers, a commotion draws you outside your tent. The men are dragging %cocky% across the ground. %Their_cocky% clothes are sopping wet and %their_cocky% face one shade short of death. The mercenaries give %them_cocky% some good slaps on the cheeks. Eventually, %they_cocky% wakes up, eyes wild, mouth gargling water like a broken fountain. %They_cocky% looks around and asks what you, too, wish to know.%SPEECH_ON%What happened?%SPEECH_OFF%%ironlungs% walks over, a similarly wet visage, but with a far more colorful complexion.%SPEECH_ON%The cocky cunt dared to see which of us could hold their breath the longest. %They_cocky% lost because they don't call these the iron lungs for nuttin'.%SPEECH_OFF%The company have a laugh as %ironlungs% boastfully pounds %their_ironlungs% chest. %cocky%, still wobbly, gets to %their_cocky% feet. Mere moments after being completely unconscious, %they're_cocky% already back to %their_cocky% prideful ways.%SPEECH_ON%Yeah yeah, you bested me this day, but I shall be the best, just you wait!%SPEECH_OFF%Another sellsword whimsically points out that the cocksure %sibling_cocky% has a huge string of snot dangling from %their_cocky% nose. %They_cocky% confidently wipes it away despite the roaring laughter of the company."
        es = "[img]gfx/ui/events/event_05.png[/img]Mientras enrollas unos mapas y los guardas de nuevo en sus alforjas, un alboroto te hace salir de tu tienda. Los hombres arrastran a %cocky% por el suelo. Tiene la ropa empapada y la cara a un tono de la muerte. Los mercenarios le dan unas buenas bofetadas en las mejillas. Al final, se despierta, con los ojos desorbitados y la boca gorgoteando agua como una fuente rota. Mira a su alrededor y pregunta lo mismo que tú quieres saber.%SPEECH_ON%¿Qué pasó?%SPEECH_OFF%%ironlungs% se acerca, con un aspecto igual de empapado, pero con la cara de un color mucho más vivo.%SPEECH_ON%%Ese_cocky% hij%o_cocky% de puta engreíd%o_cocky% me retó a ver quién de los dos aguantaba más la respiración. Perdió, porque a estos no les dicen pulmones de hierro por na'.%SPEECH_OFF%La compañía se ríe mientras %ironlungs% se golpea el pecho con fanfarronería. %cocky%, todavía tambaleándose, se pone de pie. Apenas unos momentos después de haber estado completamente inconsciente, ya ha vuelto a su soberbia de siempre.%SPEECH_ON%Sí, sí, hoy me ganaste, pero yo seré %art_cocky% mejor, ¡ya verás!%SPEECH_OFF%Otro de la compañía señala, divertido, que %art_cocky% engreíd%o_cocky% tiene un enorme hilo de mocos colgándole de la nariz. Se lo limpia con aplomo pese a las carcajadas de la compañía."
    }
    // FILE: mod_legends\hooks\events\events\combat_drill_event.nut
    // context: combat_drill_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]You step out of your tent to survey the company. A great many of them are freshly hired grunts, nervously buddying up with one another or trying their hand at some of the weapons. %oldguard% comes to your side.%SPEECH_ON%I know what yer thinking. Yer thinking you'd just hired a bunch of meat for a thresher. How about I whip these pups into shape so they don't eat an orcish blade their first go in the field?%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_05.png[/img]Sales de tu tienda para inspeccionar a la compañía. Muchos de ellos son reclutas recién contratados, haciendo amigos nerviosamente entre sí o probando algunas de las armas. %oldguard% se acerca a tu lado.%SPEECH_ON%Sé lo que estás pensando. Estás pensando que acabas de contratar un montón de carne para una trilladora. ¿Qué tal si pongo en forma a estos cachorros para que no se coman una espada orca en su primer intento en el campo de batalla?%SPEECH_OFF%"
    }
    // context: combat_drill_event.o.create.s.Options[0].Text
    {
        en = "Very well, see if you can teach them to fight one against one."
        es = "Muy bien, a ver si puedes enseñarles a luchar uno contra uno."
    }
    // context: combat_drill_event.o.create.s.Text
    {
        // corrige base: "coger" es léxico marcado (tomar); faltaba "slash" y "contrataque" es errata de "contraataque"; "legendaria" no está en el inglés; "fingen... lo parten" debe ir en imperativo.
        en = "[img]gfx/ui/events/event_05.png[/img]%oldguard% tells the recruits to take up weapons. When every single one of them picks up a sword, the old guard yells at them, stating that not every foe hankering for you being graveyard dead is gonna be wielding the exact same blade. A few nod before hurriedly exchanging their swords for axes and spears. With the crew equipped, the training begins. Mostly, %oldguard% teaches basics like how a formation makes it easier to defend not only one another, but also yourself.%SPEECH_ON%Ye need not watch corner-to-corner if ya know a brother is by yer side. But if yer separated, if yer all out there by yer lonesome, then ye might be proper farked lest ye got a heretofore unknown way with a blade which I'll go ahead and assume ye don't.%SPEECH_OFF%The training moves to offense where %oldguard% shows a few tricks with various weapons.%SPEECH_ON%With swords ye can slash, cut, stab, and riposte. Proper-hard to miss with a sword, given every side of it is a killin' side. If I see any of you trying to cut down an arrow with a sword like the fairy tales told ya I'mma beat ya down myself. It ain't true, so stop fancying it!\n\nSpears are good for keeping distance. They won't do much to armor, but they'll keep ya safe. Just point this sharp-end away from ya. If an armored brute gets past this pointy end here then yer probably proper farked so don't let that happen.\n\nFinally, there's the axe. Just pretend the enemy is a tree and cleave it so. Now let's practice!%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_05.png[/img]%oldguard% les dice a los reclutas que tomen las armas. Cuando todos y cada uno de ellos agarran una espada, les grita que no todos los desgraciados que desean mandarlos al cementerio van a llevar la misma espada. Algunos asienten antes de cambiar apresuradamente sus espadas por hachas y lanzas. Con la tropa equipada, comienza el entrenamiento. Principalmente, %oldguard% enseña lo básico, como el hecho de que una formación facilita la defensa no solo entre ellos, sino también individualmente.%SPEECH_ON%No necesitan vigilar cada rincón si saben que un hermano está a su lado. Pero si están separados, si están todos solos por ahí, entonces podrían estar jodidamente jodidos, a menos que tengan una maña con la espada nunca vista, lo que ya doy por hecho que no tienen.%SPEECH_OFF%El entrenamiento pasa a la ofensiva, donde %oldguard% muestra algunos trucos con diversas armas.%SPEECH_ON%Con las espadas, pueden tajar, cortar, apuñalar y contraatacar. Es difícil errar con una espada, dado que cada lado de ella es un lado mortal. Si veo a alguno de ustedes intentando cortar una flecha con una espada como en los cuentos de hadas, le daré una paliza con mis propias manos. Esas no son más que patrañas, así que dejen de fantasear con estupideces.\n\nLas lanzas son buenas para mantener la distancia. No harán mucho contra la armadura, pero los mantendrán a salvo. Solo tienen que apuntar esta punta afilada hacia fuera. Si un bruto blindado pasa esta punta puntiaguda aquí, es probable que estén jodidos de verdad, así que no permitan que eso suceda.\n\nPor último, está el hacha. Simplemente hagan como que el enemigo es un árbol y pártanlo. ¡Ahora practiquemos!%SPEECH_OFF%"
    }
    // context: combat_drill_event.o.create.s.Text
    {
        // corrige base: "come out the other side" es terminar, acabar; "salen del otro lado" es un calco sin sentido.
        en = "[img]gfx/ui/events/event_50.png[/img]The training goes fairly well from there, though the mercenaries do come out the other side with a few bumps and bruises."
        es = "[img]gfx/ui/events/event_50.png[/img]El entrenamiento continúa bastante bien a partir de ahí, aunque los mercenarios acaban con algunos golpes y magulladuras."
    }
    // context: combat_drill_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_10.png[/img]The mercenaries take practiced shots downrange, the arrows peppering all around their targets, a scant few lucky ones going where they should. %oldguard% spends the rest of the day exhaustingly having the mercenaries shoot and shoot and shoot until luck is squeezed out of the equation altogether."
        es = "[img]gfx/ui/events/event_10.png[/img]Los mercenarios practican el tiro al blanco; las flechas acribillan todo alrededor de los objetivos, y solo unas pocas, con suerte, van a donde deben. %oldguard% pasa el resto del día haciendo que los mercenarios disparen y disparen y disparen hasta el agotamiento, hasta que la suerte queda fuera de la ecuación por completo."
    }
    // context: combat_drill_event.o.create.s.Text
    {
        // corrige base: la 1.0 rebajaba "Swallow it like yer mother should've swallowed you" y "shitsticks", omitía "goatfarkers", "march" no es "paseo" y "shot stains" no es "he disparado a tipos".
        en = "[img]gfx/ui/events/event_05.png[/img]%oldguard% looses a sharp whistle, gathering the new recruits around. %oldguard% looks about, grinning, then nods.%SPEECH_ON%Alright ye limpwrist teatsucking noodlearm goatfarkers, we're going on a march!%SPEECH_OFF%The veteran spends the rest of the day ruthlessly running the recruits as far as possible until the last one drops from exhaustion.%SPEECH_ON%Breathe, little babe, breathe! Take it all in. There's plenty to go around for the rest of us, don't feel bad! Swallow it like yer mother should've swallowed you. Now, I've got stains that ran faster than the lot of ye, so I'll be seeing y'all again tomorrow on good, proper time. That'd be before the sun rises, shitsticks.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_05.png[/img]%oldguard% suelta un silbido agudo y reúne a los nuevos reclutas alrededor. Echa un vistazo, sonríe y luego asiente.%SPEECH_ON%Muy bien, muñecas flojas, chupatetas, bracitos de fideo, jodecabras, ¡nos vamos de marcha forzada!%SPEECH_OFF%Pasa el resto del día haciendo correr sin piedad a los reclutas todo lo posible, hasta que el último cae exhausto.%SPEECH_ON%¡Respira, bebé, respira! Trágatelo todo. Hay de sobra para el resto de nosotros, ¡no te sientas mal! Trágalo como tu madre debió tragarte a ti. Vaya, tengo manchas que corrían más rápido que todos ustedes, así que los veré de nuevo mañana a buena hora. Eso será antes de que salga el sol, pedazos de mierda.%SPEECH_OFF%"
    }
    // context: combat_drill_event.o.create.s.Text
    {
        en = "%oldguard% shows little mercy and has the mercenaries running again and again in the days to come. After all, %oldguard% says, it's for their own damn good."
        es = "%oldguard% muestra poca piedad y hace que los mercenarios corran una y otra vez en los días venideros. Después de todo, dice %oldguard%, es por su maldito bien."
    }
    // FILE: mod_legends\hooks\events\events\come_across_burial_event.nut
    // context: come_across_burial_event.o.create.s.start.List.push().text
    {
        en = "The company's moral reputation increases greatly"
        es = "La reputación moral de la compañía aumenta mucho"
    }
    // FILE: mod_legends\hooks\events\events\come_across_ritual_event.nut
    // context: come_across_ritual_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_140.png[/img]The footsteps meander through what seems to an an ancient path, long downtrodden and broken by the the frequent use of this trail. In the distance a chant becomes steadily louder and bolder. You tell the company to rest while you sneak forward, eventually finding a large bonfire.\n\n Around the fire cloaked figures circle this way and that, as if they knew of your intrusion and had set their sights on searching for you. %randombrother% crawls up beside you and shakes their head.%SPEECH_ON%Just what is going on down there? What should we do?%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_140.png[/img]Las huellas serpentean por lo que parece un antiguo sendero, pisoteado y roto desde hace mucho por el uso frecuente. A lo lejos, un cántico se vuelve cada vez más fuerte y osado. Le dices a la compañía que descanse mientras tú te adelantas a hurtadillas, hasta que encuentras una gran hoguera.\n\n Alrededor del fuego, unas figuras envueltas en capas dan vueltas de aquí para allá, como si supieran de tu intrusión y se hubieran propuesto buscarte. %randombrother% se arrastra hasta tu lado y niega con la cabeza.%SPEECH_ON%¿Qué demonios está pasando ahí abajo? ¿Qué hacemos?%SPEECH_OFF%"
    }
    // context: come_across_ritual_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_140.png[/img]You decide to wait it out and see what happens. Just as you say that, the cultists drag an old man before the fire. He bows his head before the flames, opens his arms, and then falls in.\n\n There are no screams.\n\n Another man is pulled forward. He whispers words to a cultist, they both nod, and so too this man puts himself to the flame. A third is pushed forth, but unlike the others he is shackled and wild-eyed. He screams at the captors.%SPEECH_ON%Fark your god, he means nothing! It's all a lie!%SPEECH_OFF%A face appears in the flames, its shape bulbous and churning in the smoke and fire. It is cruelty embodied, and could be no better painted by flames than by darkness itself. It turns and grins. One of the cultist shouts.%SPEECH_ON%Davkul awaits you!%SPEECH_OFF%But the prisoner kicks one of his imprisoners and tries to make a run for it."
        es = "[img]gfx/ui/events/event_140.png[/img]Decides esperar a ver qué sucede. Justo cuando dices eso, los cultistas arrastran a un anciano frente a la hoguera. Él inclina la cabeza ante las llamas, abre los brazos y luego cae en ellas.\n\n No hay gritos.\n\n Luego, otro hombre es llevado hacia adelante. Susurra unas palabras a un cultista, ambos asienten y este hombre también se arroja a las llamas. Un tercero es empujado hacia adelante, pero a diferencia de los otros, está encadenado y tiene los ojos desorbitados. Les grita a sus captores.%SPEECH_ON%¡Maldito sea su dios, no significa nada! ¡Todo es una mentira!%SPEECH_OFF%Un rostro aparece en las llamas, su forma bulbosa y revuelta en el humo y el fuego. Es la crueldad personificada y no podría estar mejor representada por las llamas que por la oscuridad misma. Gira y sonríe. Uno de los cultistas grita.%SPEECH_ON%¡Davkul te espera!%SPEECH_OFF%Pero el prisionero patea a uno de los que lo retienen e intenta huir."
    }
    // en = "Event"
    // FILE: mod_legends\hooks\events\events\cow_tipping_event.nut
    // context: cow_tipping_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "derribarlo" debe concordar con la vaca ("derribarla").
        en = "[img]gfx/ui/events/event_72.png[/img]While on the march, you come across a lone cow standing in a field. Not much to it: it's just a cow.\n\n But then %randombrother% sidles up next to you. %They're_randombrother% gnawing on some broomstraw and twists it around as %they_randombrother% talks.%SPEECH_ON%So who do you think can do it?%SPEECH_OFF%You ask 'do what.' %they_randombrother% smiles.%SPEECH_ON%Aw, sorry cap'. Didn't realize you hadn't heard. We're gonna see if someone can knock that cow over! Say, seeing as how we can only knock it over once, how about you choose which of us has a go?%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_72.png[/img]Durante la marcha, te encuentras con una vaca solitaria parada en un campo. No es gran cosa: es solo una vaca.\n\n Pero entonces %randombrother% se te arrima. Va mordisqueando una paja de escoba y la hace girar mientras habla.%SPEECH_ON%Entonces, ¿quién crees que puede hacerlo?%SPEECH_OFF%Preguntas '¿hacer qué?'. Sonríe.%SPEECH_ON%Ay, perdón, capi. No me di cuenta de que no te habías enterado. ¡Vamos a ver si alguien puede tumbar a esa vaca! Oye, como solo podemos tumbarla una vez, ¿qué tal si eliges quién de nosotros lo intenta?%SPEECH_OFF%"
    }
    // context: cow_tipping_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "badgering" es insistencia, no "insinuaciones"; "mouthing" es articular sin voz, no "diciendo".
        en = "[img]gfx/ui/events/event_72.png[/img]You tell the men to sort it out themselves. They quickly choose %cowtipper% who, after some badgering, agrees to give it a go.\n\n The sellsword carefully steps across the field, trying %their_other% best to avoid the cow patties. The cow itself nonchalantly looks over. It moos once before returning its short bovine attention to the grass. Snickering, the men shoo %cowtipper% onward, mouthing 'do it!' and 'what are you waiting for?' Finally, standing a few feet from the cow, %cowtipper% charges.%SPEECH_ON%Yaaahh!%SPEECH_OFF%%They_other% storms into the cow's side and %they_other% might as well have run into a house: %their_other% feet slip out from beneath %them_other% and %they_other% goes skidding beneath the animal, a glide well-oiled by fresh shit. The company bursts out laughing.%SPEECH_ON%You can't tip a cow ya fool! They're too goddam heavy!%SPEECH_OFF% %cowtipper% no doubt has a new beef with these jokers, but %their_other% 'sacrifice' was worth the easy entertainment."
        es = "[img]gfx/ui/events/event_72.png[/img]Les dices a los hombres que se arreglen entre ellos. Rápidamente eligen a %cowtipper%, que, tras mucha insistencia, acepta intentarlo.\n\n %Art_other% mercenari%o_other% cruza el campo con cuidado, haciendo lo posible por evitar las bostas. La vaca echa un vistazo con indiferencia. Muge una vez antes de volver a centrar su breve atención bovina en la hierba. Riéndose entre dientes, los hombres animan a %cowtipper% a seguir, articulando sin voz '¡hazlo!' y '¿a qué esperas?'. Por fin, a unos pocos pasos de la vaca, %cowtipper% carga.%SPEECH_ON%¡Yaaahh!%SPEECH_OFF%Se estrella contra el costado de la vaca, y es como si hubiera chocado contra una casa: los pies se le escapan y sale patinando por debajo del animal, en un deslizamiento bien engrasado con mierda fresca. La compañía estalla en carcajadas.%SPEECH_ON%¡No se puede volcar una vaca, idiota! ¡Pesan demasiado, joder!%SPEECH_OFF% %cowtipper% sin duda querrá hacer picadillo a estos bromistas, pero su 'sacrificio' valió la pena por la diversión fácil."
    }
    // context: cow_tipping_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_72.png[/img]You tell the men to sort it out themselves. They quickly choose %cowtipper%. The sellsword carefully steps across the field, trying %their_other% best to avoid the cow patties. The cow itself nonchalantly looks over and moos once before returning its attention to the grass. Snickering, the men shoo %cowtipper% onward, mouthing 'do it!' and 'hurry now!'. Finally, standing a few feet from the cow, %cowtipper% charges forward.%SPEECH_ON%Yaaahh!%SPEECH_OFF%The scream spooks the cow. She dips her withers and kicks, catching %cowtipper% with a bit of hooved heel. %They_other% violently spins on %their_other% feet and twists right into the grass. The men laugh for a moment, then realize it's serious. As the cow moos and trots away, the sellsword is 'rescued.' Though badly hurt, %they_other%'ll survive this near-bovine homicide."
        es = "[img]gfx/ui/events/event_72.png[/img]Les dices a los hombres que se arreglen entre ellos. Rápidamente eligen a %cowtipper%. %Art_other% mercenari%o_other% cruza el campo con cuidado, haciendo lo posible por evitar las bostas. La vaca echa un vistazo con indiferencia y muge una vez antes de volver a centrar su atención en la hierba. Riéndose entre dientes, los hombres animan a %cowtipper% a seguir, articulando sin voz '¡hazlo!' y '¡rápido!'. Por fin, a unos pocos pasos de la vaca, %cowtipper% se lanza hacia delante.%SPEECH_ON%¡Yaaahh!%SPEECH_OFF%El grito asusta a la vaca. Agacha la cruz y suelta una coz que alcanza a %cowtipper% con un poco de pezuña. Gira violentamente sobre sus pies y se retuerce hasta caer de lleno en la hierba. Los hombres se ríen un momento, pero luego se dan cuenta de que es grave. Mientras la vaca muge y se aleja al trote, %art_other% mercenari%o_other% es 'rescatad%o_other%'. Aunque está malherid%o_other%, sobrevivirá a este casi homicidio bovino."
    }
    // context: cow_tipping_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "propina" no sostiene el doble sentido de "a good tipping" ("revolcón" sí: tumbar y retozar); "More phrasing issues abound" no es "Más chistes surgen"; "las excrementos" es errata de concordancia.
        // _screen.Text = "[img]gfx/ui/events/event_72.png[/img]You figure the strong and burly %strong% could give the cow a good tipping. Your awkward wording alone has the men laughing, but %strong% respectfully bows.%SPEECH_ON%I am honored, sir.%SPEECH_OFF%%They_strong% rolls up %their_strong% sleeves and strolls across the field, striding over cow patties like a merchant stepping over the homeless. The cow looks over, raising a curious eyebrow. %strong% nods.%SPEECH_ON%That\'s right, I\'m coming.%SPEECH_OFF%More phrasing issues abound. Despite the laughter of the company, %strong% charges the cow. At first, %they_strong% simply presses against its side, muscled and heaving with breath. The men laugh as %their_strong% efforts get %them_strong% nowhere, but they quickly quiet down when the cow slides across the mud and grass. With a mighty roar, %strong% surges forward and the cow goes falling sideways with a confused moo.\n\n %otherbrother% stands there, slackjawed.%SPEECH_ON%It was a joke... I didn\'t think it was actually possible...%SPEECH_OFF%The company erupts in cheers for the strong man\'s incredible feat!";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_72.png[/img]You figure the strong and burly %strong% could give the cow a good tipping. Your awkward wording alone has the men laughing, but %strong% respectfully bows.%SPEECH_ON%I am honored, sir.%SPEECH_OFF%%They_strong% rolls up %their_strong% sleeves and strolls across the field, striding over cow patties like a merchant stepping over the homeless. The cow looks over, raising a curious eyebrow. %strong% nods.%SPEECH_ON%That's right, I'm coming.%SPEECH_OFF%More phrasing issues abound. Despite the laughter of the company, %strong% charges the cow. At first, %they_strong% simply presses against its side, muscled and heaving with breath. The men laugh as %their_strong% efforts get %them_strong% nowhere, but they quickly quiet down when the cow slides across the mud and grass. With a mighty roar, %strong% surges forward and the cow goes falling sideways with a confused moo.\n\n %otherbrother% stands there, slackjawed.%SPEECH_ON%It was a joke... I didn't think it was actually possible...%SPEECH_OFF%The company erupts in cheers for the strong man's incredible feat!"
        es = "[img]gfx/ui/events/event_72.png[/img]Supones que %strong%, fuerte y corpulent%o_strong%, podría darle un buen revolcón a la vaca. Tu torpe forma de decirlo basta para que los hombres se rían, pero %strong% hace una respetuosa reverencia.%SPEECH_ON%Es un honor, señor.%SPEECH_OFF%Se arremanga y se pasea por el campo, pasando por encima de las bostas como un mercader que pasa por encima de los sin techo. La vaca echa un vistazo y arquea una ceja con curiosidad. %strong% asiente.%SPEECH_ON%Así es, allá voy.%SPEECH_OFF%Las frases desafortunadas no paran. A pesar de las risas de la compañía, %strong% carga contra la vaca. Al principio, simplemente empuja contra su costado, con los músculos tensos y resoplando. Los hombres se ríen al ver que sus esfuerzos no %lo_strong% llevan a ninguna parte, pero se callan enseguida cuando la vaca se desliza por el barro y la hierba. Con un poderoso rugido, %strong% empuja con todo y la vaca cae de lado con un mugido confuso.\n\n %otherbrother% se queda ahí con la boca abierta.%SPEECH_ON%Era una broma... No pensé que fuera posible de verdad...%SPEECH_OFF%¡La compañía estalla en vítores por la increíble hazaña %del_strong% forzud%o_strong%!"
    }
    // context: cow_tipping_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "sellsword" es mercenario, no "espadachín"; "shite" estaba rebajado a "excremento"; "arms tent-poled" son brazos en jarras, no "en tensión".
        en = "[img]gfx/ui/events/event_72.png[/img]Before you can even finish your sentence, %cocky% beats %their_cocky% chest and steps forward.%SPEECH_ON%I will fell that petty cow!%SPEECH_OFF%You remind %them_cocky% that the company has no beef with the bovine creature and that this is all for fun and games. %They_cocky% stands there, arms tent-poled with %their_cocky% fists at %their_cocky% hips.%SPEECH_ON%Nonsense. The company laughs and thinks this an impossibility, but I'm here to show them all just how wrong they are!%SPEECH_OFF%The cocksure sellsword steps into the field and immediately cuts %their_cocky% boot across a cow patty. %They_cocky% sidewinders forward, arms flailing for balance, but it's all for naught as %they_cocky% slams to the ground. The men burst into laughter. The cow glances over before simply walking off. %cocky% cleans %themselves_cocky% up.%SPEECH_ON%A minor misstep. But look! The cowardly cattle wants no part of me!%SPEECH_OFF%%otherbrother% laughs and points at the sellsword's stained garb.%SPEECH_ON%Maybe, but it looks like you got a little part of her.%SPEECH_OFF%The cocky sellsword quickly swipes the shite off %their_cocky% shirt. Despite the failure, %they_cocky% is undeterred and the men are almost passing out they're laughing so hard."
        es = "[img]gfx/ui/events/event_72.png[/img]Antes de que puedas siquiera terminar la frase, %cocky% se golpea el pecho y da un paso al frente.%SPEECH_ON%¡Derribaré a esa vaca insignificante!%SPEECH_OFF%Le recuerdas que la compañía no tiene nada contra el bovino y que todo esto es pura diversión. Se queda ahí plantad%o_cocky%, con los brazos en jarras y los puños en las caderas.%SPEECH_ON%Tonterías. La compañía se ríe y cree que esto es imposible, ¡pero estoy aquí para demostrarles a todos lo equivocados que están!%SPEECH_OFF%%Art_cocky% mercenari%o_cocky%, tan segur%o_cocky% de sí, entra en el campo y de inmediato arrastra la bota por una bosta. Avanza dando bandazos, agitando los brazos para mantener el equilibrio, pero todo es en vano y se estrella contra el suelo. Los hombres estallan en carcajadas. La vaca echa un vistazo antes de simplemente alejarse. %cocky% se limpia.%SPEECH_ON%Un pequeño traspié. ¡Pero miren! ¡El cobarde ganado no quiere saber nada de mí!%SPEECH_OFF%%otherbrother% se ríe y señala la ropa manchada %del_cocky% mercenari%o_cocky%.%SPEECH_ON%Puede ser, pero parece que tú sí te llevaste un poco de ella.%SPEECH_OFF%%Art_cocky% mercenari%o_cocky% engreíd%o_cocky% se quita rápidamente la mierda de la camisa. Pese al fracaso, no se desanima, y los hombres casi se desmayan de tanto reírse."
    }
    // FILE: mod_legends\hooks\events\events\creepy_guy_event.nut
    // context: creepy_guy_event.o.create.::Legends.Screens.hook()._screen.start.Options.insert().Text
    {
        en = "Our shieldmaiden seems interested, how about she takes the lead?"
        es = "Nuestra doncella escudera parece interesada. ¿Y si se encarga ella?"
    }
    // context: creepy_guy_event.o.create.::Legends.Screens.hook()._screen.start.Options.insert().Text
    {
        en = "%militia% is eager to take action."
        es = "%militia% tiene ganas de actuar."
    }
    // context: creepy_guy_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "shake him down" es registrarlo a la fuerza, no "lo convences"; "dagger" es daga, no cuchillo.
        en = "[img]gfx/ui/events/event_43.png[/img]You muscle your way into the crowd, looking for fingers and toes or bloodied pockets. One man's got a good, lumpy sag in his pocket. You drive him into a corner and shake him down with a dagger to his throat.\n\n After him, you see a woman with a sickly grin on her face prancing along the cobbled stones. That's a scornful wench if you've ever seen one. Pulling her aside, you quickly find a finger and a toe in the linens of her frock. She lies and says they're just cooking ingredients. You tell her if that's the case then you'll report her to the guards for cannibalism. She gives them up.\n\n Returning the grossly extremities to the old man, you are promptly paid the five hundred crowns. He hardly even thanks you for your 'work' before rushing away. He never did explain what, exactly, such things were for. You don't care. Five hundred crowns is five hundred crowns."
        es = "[img]gfx/ui/events/event_43.png[/img]Te abres paso a empujones entre la multitud, buscando dedos de manos y pies o bolsillos ensangrentados. Uno de los hombres tiene un buen bulto en el bolsillo. Lo acorralas en una esquina y lo registras con una daga en la garganta.\n\n Después, ves a una mujer con una sonrisa enfermiza en el rostro saltando por los adoquines. Si alguna vez has visto una arpía desdeñosa, es esta. La llevas aparte y encuentras rápidamente un dedo y un dedo del pie entre las telas de su vestido. Ella miente y dice que son solo ingredientes para cocinar. Le dices que, si ese es el caso, la denunciarás a los guardias por canibalismo. Ella los entrega.\n\n Al devolverle las repugnantes extremidades al anciano, recibes de inmediato las quinientas coronas. Apenas te agradece tu 'trabajo' antes de salir corriendo. Nunca explicó para qué eran exactamente esas cosas. A ti no te importa. Quinientas coronas son quinientas coronas."
    }
    // en = "Thief"
    // en base_es
    // context: creepy_guy_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "pickpocket" es robar bolsillos (no solo robar) y "picked" juega con ello: "birlé", no "seleccioné".
        en = "[img]gfx/ui/events/event_43.png[/img]%thief% laughs.%SPEECH_ON%Hell, this'll be easy.%SPEECH_OFF%%They_thief% goes off to the crowd and you lose sight of %them_thief% in an instant. The old man chews on his gums for awhile before raising his voice.%SPEECH_ON%This feller, he is one to trust?%SPEECH_OFF%Before you can answer, %thief% emerges from behind the old man's shoulder and drops a bloody bandage into his palms. The creepy man unwraps the linens to discover freshly strewn extremities. The thief smugly smiles.%SPEECH_ON%Any thief worth %their_thief% salt learns to pickpocket before anything else. I usually go after keys instead of toes, but a job is a job. Also 'picked' some other things of interest here and there. Take a look.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_43.png[/img]%thief% se ríe.%SPEECH_ON%Diablos, esto será fácil.%SPEECH_OFF%Se mete entre la multitud y %lo_thief% pierdes de vista en un instante. El anciano se mordisquea las encías un rato antes de alzar la voz.%SPEECH_ON%Este tipo, ¿es de fiar?%SPEECH_OFF%Antes de que puedas responder, %thief% aparece por detrás del hombro del anciano y le deja caer un vendaje ensangrentado en las palmas. El tipo espeluznante desenvuelve los trapos y descubre extremidades recién arrancadas. %thief% sonríe con suficiencia.%SPEECH_ON%Cualquier ladrón que se precie aprende a robar bolsillos antes que nada. Normalmente busco llaves en lugar de dedos de los pies, pero un trabajo es un trabajo. También 'birlé' algunas otras cosas interesantes por aquí y por allá. Echa un vistazo.%SPEECH_OFF%"
    }
    // context: creepy_guy_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "you sorry sellswords" es "mercenarios de pacotilla", no "lo siento, mercenarios"; "purse" es la bolsa, no "el bolso".
        en = "[img]gfx/ui/events/event_92.png[/img]%minstrel% the minstrel grabs the old man by his shoulders.%SPEECH_ON%Say, what mighty muscles you seem to have, my burly friend. I shan't ask why you need the toes and fingers of that dead man...%SPEECH_OFF%The old man nods and says he'd never tell anyway. The minstrel continues.%SPEECH_ON%...but if you want a good, strong, and violent man, then am I not looking at it? It's you, old man! Take yer own fingers and toes and go with them to complete the task - ahem, whatever weird shite that might be, ahem - and you'll find the 'reward' you're after. You are the hero of this story, can't you see?%SPEECH_OFF%The old man spits and shakes his head.%SPEECH_ON%You take me for a fool, don't ya? Our business here is through! Get out of my way you sorry sellswords.%SPEECH_OFF%The old man leaves. You ask the minstrel what the hell %they're_minstrel% doing. %They_minstrel% shrugs and holds up a purse of crowns.%SPEECH_ON%Sleight of hand.%SPEECH_OFF%Nicely done. But you ask where your own purse is. %minstrel% raises another sack.%SPEECH_ON%Really, really good sleight of hand.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_92.png[/img]%minstrel%, %art_minstrel% juglar, agarra al anciano por los hombros.%SPEECH_ON%Dime, qué músculos tan poderosos pareces tener, mi corpulento amigo. No te preguntaré por qué necesitas los dedos de las manos y los pies de ese muerto...%SPEECH_OFF%El anciano asiente y dice que de todos modos nunca lo diría. %Art_minstrel% juglar continúa.%SPEECH_ON%...pero si quieres un hombre bueno, fuerte y violento, ¿acaso no lo tengo delante? ¡Eres tú, viejo! Toma tus propios dedos de manos y pies y ve con ellos a completar la tarea (ejem, sea cual sea esa mierda rara, ejem) y encontrarás la 'recompensa' que buscas. Eres el héroe de esta historia, ¿no lo ves?%SPEECH_OFF%El anciano escupe y sacude la cabeza.%SPEECH_ON%Me tomas por tonto, ¿no? ¡Aquí no hay más trato! Quítense de mi camino, mercenarios de pacotilla.%SPEECH_OFF%El viejo se va. Le preguntas %al_minstrel% juglar qué diablos está haciendo. Se encoge de hombros y levanta una bolsa de coronas.%SPEECH_ON%Juego de manos.%SPEECH_OFF%Bien hecho. Pero preguntas dónde está tu propia bolsa. %minstrel% levanta otro saco.%SPEECH_ON%Un juego de manos muy, pero muy bueno.%SPEECH_OFF%"
    }
    // context: creepy_guy_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "talentos 'ladronezcos'" no traduce "the thieving sort" y choca con "talento" (perk); faltaba el punto final del parlamento.
        en = "[img]gfx/ui/events/event_19.png[/img]%butcher% the butcher spits and says %they_butcher%'ll do it. You tell %them_butcher% that %they're_butcher% not exactly the thieving sort. %They_butcher% shakes %their_butcher% head.%SPEECH_ON%Naw. I mean I'll give him a finger. Just one, but it'll be a doozy and worth its weight in gold as far as this old fart's concerned. As far as you're concerned, captain, I want half the reward.%SPEECH_OFF%The creepy stranger nods as a smile crackles his dried, flaky skin.%SPEECH_ON%Yes... yes! A %person_butcher% who would do this would certainly fit the profile of the ingredients I need. Do it. Do it!%SPEECH_OFF%Before you can even agree to this, the butcher grabs a tong hanging off a nearby wall, leverages it atop an anvil, wedges a finger between the pincers, and presses %their_butcher% knee to the handle, promptly severing a finger all in one go. %They_butcher% wraps the hand before giving up the extremity to the stranger.%SPEECH_ON%There you have it: one especially cruel man's finger.%SPEECH_OFF%The stranger grabs it as though it were the key to the world. 'Marvelous!', you think he says, but it's hard to hear as he hurriedly gives you some crowns and runs off. It's actually more than you originally agreed to. The butcher has certainly 'earned' %their_butcher% half and you hand it over."
        es = "[img]gfx/ui/events/event_19.png[/img]%butcher%, %art_butcher% carnicer%o_butcher%, escupe y dice que lo hará. Le dices que robar no es precisamente lo suyo. Niega con la cabeza.%SPEECH_ON%Nah. Digo que le daré un dedo. Solo uno, pero será uno de primera y valdrá su peso en oro para este vejestorio. En cuanto a ti, capitán, quiero la mitad de la recompensa.%SPEECH_OFF%El desconocido espeluznante asiente mientras una sonrisa le resquebraja la piel seca y escamosa.%SPEECH_ON%Sí... ¡sí! %Un_butcher% %hombre_butcher% capaz de hacer esto sin duda encajaría en el perfil de los ingredientes que necesito. ¡Hazlo! ¡Hazlo!%SPEECH_OFF%Antes de que puedas siquiera aceptar, %art_butcher% carnicer%o_butcher% agarra unas tenazas que cuelgan de una pared cercana, las apoya sobre un yunque, mete un dedo entre las pinzas y aprieta el mango con la rodilla, cercenándose el dedo de un solo golpe. Se venda la mano antes de entregarle la extremidad al desconocido.%SPEECH_ON%Ahí lo tienes: el dedo de %un_butcher% %hombre_butcher% especialmente cruel.%SPEECH_OFF%El desconocido lo agarra como si fuera la llave del mundo. '¡Maravilloso!', crees que dice, pero cuesta oírlo mientras te da apresuradamente unas coronas y sale corriendo. En realidad, es más de lo que acordaron en un principio. %Art_butcher% carnicer%o_butcher% sin duda se ha 'ganado' su mitad, y se la entregas."
    }
    // context: creepy_guy_event.o.create.m.Screens.push().Text
    {
        // Text = "[img]gfx/ui/events/event_50.png[/img]As though waiting to be called forward, %shieldmaiden% steps before the old man and grimaces. She doesn\'t try to hide the blatant disgust she has for this connoisseur of loose limbs, but nevertheless invites him forward.%SPEECH_ON%You want the fingers of a violent, dangerous person? Take mine.%SPEECH_OFF%She offers her sword hand out to the creep who\'s almost as confused as you are by the offer. After sizing her up and perhaps satisfied to the malice of the hand offered to him, he produces a rust-mottled knife and reaches for the shieldmaiden\'s outstretched hand, eyes glazed over in a disturbing, hungry trance. In an instant, %shieldmaiden% pulls back and uses her shield to smash the outstretched arm of the old fool - a disgusting snap at the elbow and immediate wail of agony confirms your shieldmaiden struck true. Without relenting, the shield coils back for another strike, this time on the flapping jaw of the hollering creep, and one crunch later, his screams are notably muffled as he falls to the dirt. %shieldmaiden% stands proud over the crumpled mess of a man, notices his coin purse that now furnishes the floor, and soundly grabs it. She pockets some of it, then throws the rest back to you.%SPEECH_ON%Aww, tough luck old man. You\'ll have to be quicker than that.%SPEECH_OFF%Your shock at the swift and brutal violence is quickly dispelled as you see the digit-hungry crowd start to turn to investigate the commotion. Grabbing your shieldmaiden by the shoulder, you decide it\'s best if you get out of there.",
        mode = "pattern"
        en = "[img]gfx/ui/events/event_50.png[/img]As though waiting to be called forward, %shieldmaiden% steps before the old man and grimaces. She doesn't try to hide the blatant disgust she has for this connoisseur of loose limbs, but nevertheless invites him forward.%SPEECH_ON%You want the fingers of a violent, dangerous person? Take mine.%SPEECH_OFF%She offers her sword hand out to the creep who's almost as confused as you are by the offer. After sizing her up and perhaps satisfied to the malice of the hand offered to him, he produces a rust-mottled knife and reaches for the shieldmaiden's outstretched hand, eyes glazed over in a disturbing, hungry trance. In an instant, %shieldmaiden% pulls back and uses her shield to smash the outstretched arm of the old fool - a disgusting snap at the elbow and immediate wail of agony confirms your shieldmaiden struck true. Without relenting, the shield coils back for another strike, this time on the flapping jaw of the hollering creep, and one crunch later, his screams are notably muffled as he falls to the dirt. %shieldmaiden% stands proud over the crumpled mess of a man, notices his coin purse that now furnishes the floor, and soundly grabs it. She pockets some of it, then throws the rest back to you.%SPEECH_ON%Aww, tough luck old man. You'll have to be quicker than that.%SPEECH_OFF%Your shock at the swift and brutal violence is quickly dispelled as you see the digit-hungry crowd start to turn to investigate the commotion. Grabbing your shieldmaiden by the shoulder, you decide it's best if you get out of there."
        es = "[img]gfx/ui/events/event_50.png[/img]Como si esperara a que la llamaran, %shieldmaiden% se planta delante del anciano con una mueca. No intenta ocultar el asco descarado que siente por este conocedor de miembros sueltos, pero aun así lo invita a acercarse.%SPEECH_ON%¿Quieres los dedos de una persona violenta y peligrosa? Toma los míos.%SPEECH_OFF%Le ofrece la mano de la espada al tipo espeluznante, que está casi tan desconcertado como tú por la oferta. Tras evaluarla, y quizá satisfecho con la malicia de la mano que le ofrecen, saca un cuchillo moteado de óxido y alarga el brazo hacia la mano tendida de la doncella escudera, con los ojos vidriosos en un trance inquietante y hambriento. En un instante, %shieldmaiden% se aparta y usa el escudo para destrozarle el brazo extendido al viejo idiota: un chasquido asqueroso en el codo y un inmediato alarido de agonía confirman que tu doncella escudera dio en el blanco. Sin dar tregua, el escudo se retrae para otro golpe, esta vez contra la mandíbula colgante del tipo que no para de chillar, y tras un crujido sus gritos quedan notablemente ahogados mientras cae al suelo. %shieldmaiden% se yergue orgullosa sobre ese despojo arrugado de hombre, repara en su bolsa de monedas, que ahora adorna el suelo, y la recoge sin más. Se guarda una parte y te lanza el resto.%SPEECH_ON%Vaya, mala suerte, viejo. Tendrás que ser más rápido.%SPEECH_OFF%Tu asombro ante esa violencia rápida y brutal se disipa enseguida cuando ves que la multitud, ávida de dedos, empieza a volverse para averiguar a qué viene el alboroto. Agarrando a tu doncella escudera por el hombro, decides que lo mejor es salir de allí."
    }
    // context: creepy_guy_event.o.create.m.Screens.push().Options.Text
    {
        en = "Well, can't say that's what I would have done"
        es = "Bueno, no es lo que yo habría hecho"
    }
    // context: creepy_guy_event.o.create.m.Screens.push().start.List.extend().::Legends.EventList.changeMood()
    {
        en = "Enjoyed beating some old creep to the ground"
        es = "Disfrutó tirando a golpes al suelo a un viejo asqueroso"
    }
    // context: creepy_guy_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_65.png[/img]%militia% looks at the throng of peasants - all clamouring for their own macabre memento - and shakes %their_militia% head. You see %them_militia% pull a number of mismatched rags from %their_militia% jacket pocket and quickly tie one around %their_militia% arm before passing the rest to a few of the sturdier looking men from the company. %SPEECH_ON%With me. Follow my lead, and this should be over quick.%SPEECH_OFF%The deputised mercenaries are confused but agree nonetheless, perhaps eager to dispense lawful violence against such a lawless mob, or perhaps obliged by the unquestionable gravitas in %militia%'s order. One ties a floral patch around their arm, earning smirks from the rest of the company as they set off into the rabble. What follows resembles the sound of battle - as though the mob had suddenly become feral and decided to gorge themselves on your ad-hoc militia's flesh. Orders, roars, jeers, thuds, boos, and a few embarrassing yelps later, the crowd begins to calm, albeit with a few loud grumbles about them “ruining the fun”. The shouts of your impromptu militia turn to firm but measured commands to disperse and leave the dead alone, no matter how guilty they are. With the peasants returning to the less exciting doldrum of their insignificant realities, %militia% approaches with a self-assured smile.%SPEECH_ON%Well, captain. It can be a real ball-ache at times, but it's just like wrangling chickens: you find the cockerel and shut it up, and the rest don't feel as cocky all of a sudden.%SPEECH_OFF%%They_militia% turns and gestures to a battered peasant - the instigator perhaps - dazed and slipping in the churned earth of the mob as they slip away. You can't say you've ever been involved in chicken wrangling, but you feel you have a better idea of it now. The creep smiles a near toothless smile and slips a purse into your hands, looking through you to the now abandoned corpse. He licks his cracked lips as %militia% undoes their armband and pockets it as %they_militia% join the rest of the company.%SPEECH_ON%Wait, who was that?%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_65.png[/img]%militia% mira la muchedumbre de campesinos, todos clamando por su propio recuerdo macabro, y niega con la cabeza. Ves que saca del bolsillo de la chaqueta unos cuantos trapos desparejados y se ata rápidamente uno al brazo antes de pasarles el resto a algunos de los hombres de aspecto más robusto de la compañía. %SPEECH_ON%Conmigo. Sigan mi ejemplo y esto debería acabar rápido.%SPEECH_OFF%Los mercenarios, recién convertidos en ayudantes, están confundidos, pero aceptan de todos modos, quizá deseosos de repartir violencia legal contra una turba tan sin ley, o quizá obligados por la incuestionable gravedad de la orden de %militia%. Uno se ata al brazo un parche de flores, lo que le vale sonrisas burlonas del resto de la compañía mientras se adentran en el gentío. Lo que sigue suena a batalla, como si la turba se hubiera vuelto salvaje de repente y hubiera decidido darse un festín con la carne de tu milicia improvisada. Órdenes, rugidos, burlas, golpes sordos, abucheos y unos cuantos chillidos vergonzosos después, la multitud empieza a calmarse, aunque con algunas quejas en voz alta porque les han “arruinado la diversión”. Los gritos de tu milicia improvisada se convierten en órdenes firmes pero mesuradas de dispersarse y dejar en paz a los muertos, por muy culpables que sean. Con los campesinos de vuelta al aburrido letargo de sus insignificantes realidades, %militia% se acerca con una sonrisa segura de sí.%SPEECH_ON%Bueno, capitán. A veces es un auténtico dolor de huevos, pero es como domar gallinas: encuentras al gallo y lo haces callar, y de repente los demás ya no se hacen tanto los gallitos.%SPEECH_OFF%Se da la vuelta y señala a un campesino apaleado, quizá el instigador, que se escabulle aturdido, resbalando en la tierra removida por la turba. No puedes decir que hayas domado gallinas nunca, pero sientes que ahora te haces una mejor idea. El tipo espeluznante sonríe con una sonrisa casi desdentada y te desliza una bolsa en las manos, mirando a través de ti hacia el cadáver, ahora abandonado. Se relame los labios agrietados mientras %militia% se quita el brazalete y se lo guarda en el bolsillo al reunirse con el resto de la compañía.%SPEECH_ON%Espera, ¿quién era ese?%SPEECH_OFF%"
    }
    // context: creepy_guy_event.o.create.m.Screens.push().Options.Text
    {
        en = "Don't worry about it, let's go."
        es = "No te preocupes por eso, vámonos."
    }
    // context: creepy_guy_event.o.create.m.Screens.push().start.List.extend().::Legends.EventList.changeMood()
    {
        en = "Happy to restore order to a town."
        es = "Le alegra haber restablecido el orden en un pueblo."
    }
    // FILE: mod_legends\hooks\events\events\cripple_pep_talk_event.nut
    // context: cripple_pep_talk_event.o.create.s.Text
    {
        // corrige base: la 1.0 añadía "parece" y "lleno de obstáculos y dificultades", traducía "wobbles" (tambaleos) por "inseguridades" y metía un espacio de más tras %SPEECH_OFF%.
        en = "[img]gfx/ui/events/event_06.png[/img]%cripple% the cripple asks how %veteran% does it. The veteran raises an eyebrow.%SPEECH_ON%Do what?%SPEECH_OFF%The cripple bounces their head around as if figuratively beating around the bush.%SPEECH_ON%You know, it. Fight. Every time I get out there, I just think I'm not up to it, as though I were dragging you folk down.%SPEECH_OFF%%veteran% laughs.%SPEECH_ON%Aye, I get what you mean. A cripple ain't fit for sellswording. But is that who you are? Just a cripple? Or are ye a hero? You can choose to let your wobbles and ungainliness define who you are, or you can make your own path, as crooked and hobbled it may be.%SPEECH_OFF%Nodding, %cripple%'s face starts to glow.%SPEECH_ON%You're right. I'm not all that I could be and I got the body of a dying nun, but no one will put in more effort than I!%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_06.png[/img]%cripple%, con su cuerpo lisiado, le pregunta a %veteran% cómo lo hace. %veteran% arquea una ceja.%SPEECH_ON%¿Hacer qué?%SPEECH_OFF%%cripple% mueve la cabeza de un lado a otro, como si se fuera por las ramas.%SPEECH_ON%Ya sabes, eso. Pelear. Cada vez que salgo ahí, pienso que no estoy a la altura, como si fuera un lastre para todos ustedes.%SPEECH_OFF%%veteran% se ríe.%SPEECH_ON%Sí, entiendo lo que dices. Un cuerpo lisiado no sirve para el oficio de mercenario. Pero ¿eso es lo que eres? ¿Solo un cuerpo lisiado? ¿O eres alguien de leyenda? Puedes dejar que tus tambaleos y tu torpeza definan quién eres, o puedes trazar tu propio camino, por torcido y renqueante que sea.%SPEECH_OFF%Mientras asiente, a %cripple% se le empieza a iluminar la cara.%SPEECH_ON%Tienes razón. No soy todo lo que podría ser y tengo el cuerpo de una monja moribunda, ¡pero nadie se esforzará más que yo!%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\cripple_vs_injury_event.nut
    // context: cripple_vs_injury_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_26.png[/img]The recent battle left %injured% with a horrific and permanent injury. As the mercenary sits glumly about the campfire, %cripple% the cripple takes a seat next to the injured.%SPEECH_ON%So here you sit, bummed out about something that don't matter. Look at me. Just look at me! Look at where I am! I've lost that which can't be returned, but did I dwell on it? No. I pressed on. I joined the %companyname%. Because that, that injury right there, that's gone and done. This up here...%SPEECH_OFF%The cripple taps the side of their head.%SPEECH_ON%Up here is what can be made anew. Up here is where you can think, yeah, that happened, but I'm still alive and I'm still in this. If the world wants me dead, it'll have to take all the pieces I got to give because I'm not giving up until the last of me is gone!%SPEECH_OFF%%injured% nods with a mood that seems infinitely improved."
        es = "[img]gfx/ui/events/event_26.png[/img]La reciente batalla dejó a %injured% con una lesión horrible y permanente. Mientras %injured% pasa el rato junto a la fogata con aire abatido, %cripple%, con su cuerpo lisiado, toma asiento a su lado.%SPEECH_ON%Así que aquí estás, amargándote por algo que no importa. Mírame. ¡Solo mírame! ¡Mira dónde estoy! He perdido lo que no se puede recuperar, pero ¿me quedé lamentándolo? No. Seguí adelante. Me uní a los %companyname%. Porque eso, esa lesión de ahí, ya pasó y ya está. Esto de aquí arriba...%SPEECH_OFF%%cripple% se da unos golpecitos en un costado de la cabeza.%SPEECH_ON%Aquí arriba es donde se puede empezar de nuevo. Aquí arriba es donde puedes pensar: sí, eso pasó, pero sigo con vida y sigo en esto. Si el mundo quiere acabar conmigo, tendrá que llevarse todos los pedazos que tengo para dar, ¡porque no me rindo hasta que no quede nada de mí!%SPEECH_OFF%%injured% asiente, con un ánimo que parece infinitamente mejor."
    }
    // context: cripple_vs_injury_event.o.create.s.Options[0].Text
    {
        en = "Quite the spirit on that one."
        es = "Sin duda, tiene un espíritu admirable."
    }
    // FILE: mod_legends\hooks\events\events\crisis\civilwar_ambush_event.nut
    // en = "Ambushed some of their men"
    // en base_es
    // en = "Helped in an ambush against <x:str>"
    // en base_es
    // FILE: mod_legends\hooks\events\events\crisis\civilwar_deserter_event.nut
    // context: civilwar_deserter_event.o.create.s.Text
    {
        // corrige base: «vendado» por «con los ojos vendados» (blindfolded es con los ojos tapados, no con vendajes)
        // corrige base: «para que el prisionero se ponga de pie» por «para que la víctima se suba a él» (stand on: el barril es para subirse)
        // corrige base: «se enfrentarán a una situación similar» por «recibirán el mismo trato» (you will be dealt with in a similar fashion es una amenaza de correr la misma suerte)
        en = "[img]gfx/ui/events/event_02.png[/img]{While on the road you come across two soldiers of %noblehouse%'s army and they're stringing up what it appears to be one of their own. The soldier's head is put through a noose, but upon seeing you, calls out.%SPEECH_ON%They wanted me to kill children! This is what I get for not following orders?%SPEECH_OFF%%randombrother% looks at you with a 'maybe we can do something' face. | You find two men of %noblehouse%'s army stringing up someone who has been blindfolded. Curious, you ask what the crime was. One of the executioners laughs.%SPEECH_ON%The wretch was ordered to burn a small village and refused. You don't refuse the nobility, lest this happen.%SPEECH_OFF%The blindfolded soldier spits.%SPEECH_ON%To the hells with you all. I'll at least have my dignity and honor to the end.%SPEECH_OFF% | To the side of the path you see a man slinging a rope around a tree branch. A second man pushes a blindfolded prisoner forward, slipping the noose about their neck. The executioners see you and put their hands up.%SPEECH_ON%Step back, sellswords. This deserter is to be executed under the orders of %noblehouse%. Interfere, and you will be dealt with in a similar fashion.%SPEECH_OFF%The prisoner barks out.%SPEECH_ON%They wanted me to murder innocents and children. This is the price I pay for ignoring such orders, but at least I will leave this horrid world with my honor intact.%SPEECH_OFF% | The path opens to a shackled soldier sitting in the grass while two men angrily string a rope along a tree branch. They test it with a few good pulls before nodding and putting a barrel beneath it, presumably for the prisoner to stand on. The prisoner sees you and calls out.%SPEECH_ON%Sellswords, save me! All I did was refuse to burn a temple to the ground!%SPEECH_OFF%One of the executioners kicks the deserter.%SPEECH_ON%That temple was housing rebels, rebels that killed our lieutenant, you fool! You deserve this fate more than anyone. If %noblehouse% is to win this war, we cannot have rats such as you in our midst.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_02.png[/img]{Mientras viajas por el camino te encuentras con dos soldados del ejército de la %noblehouse% que están ahorcando a alguien que parece ser de los suyos. Ya le han metido la cabeza en la soga, pero al verte, grita.%SPEECH_ON%¡Querían que matara a niños! ¿Esto es lo que recibo por no seguir órdenes?%SPEECH_OFF%%randombrother% te mira con cara de «quizá podamos hacer algo». | Encuentras a dos hombres del ejército de la %noblehouse% ahorcando a alguien con los ojos vendados. Por curiosidad, preguntas cuál fue su crimen. Uno de los verdugos se ríe.%SPEECH_ON%A esta escoria le ordenaron quemar un pueblo pequeño y se negó. A la nobleza no se le desobedece, o pasa esto.%SPEECH_OFF%Quien lleva la venda escupe.%SPEECH_ON%¡Váyanse todos al infierno! Al menos conservaré mi dignidad y mi honor hasta el final.%SPEECH_OFF% | Al lado del camino ves a un hombre pasando una cuerda por encima de una rama. Otro hombre empuja hacia delante a una figura con los ojos vendados y le pasa la soga alrededor del cuello. Los verdugos te ven y levantan las manos.%SPEECH_ON%Atrás, mercenarios. Esta rata desertora será ejecutada por orden de la %noblehouse%. Interfieran y recibirán el mismo trato.%SPEECH_OFF%Desde la soga llega un grito.%SPEECH_ON%Querían que asesinara a inocentes y a niños. Este es el precio que pago por desobedecer esas órdenes, pero al menos dejaré este mundo horrible con mi honor intacto.%SPEECH_OFF% | Al abrirse el camino aparece una figura encadenada, sentada en la hierba, mientras dos hombres atan con rabia una cuerda a una rama de árbol. La prueban con unos buenos tirones antes de asentir y colocar un barril debajo, presumiblemente para que la víctima se suba a él. Al verte, la figura encadenada grita.%SPEECH_ON%¡Mercenarios, sálvenme! ¡Lo único que hice fue negarme a reducir un templo a cenizas!%SPEECH_OFF%Uno de los verdugos le da una patada.%SPEECH_ON%¡Ese templo albergaba a rebeldes, rebeldes que mataron a nuestro teniente, idiota! Te mereces este destino más que nadie. Si la %noblehouse% va a ganar esta guerra, no podemos tener ratas como tú entre nosotros.%SPEECH_OFF%}"
    }
    // context: civilwar_deserter_event.o.create.s.Options[0].Text
    {
        en = "Free that prisoner!"
        es = "¡Liberen a esa persona!"
    }
    // context: civilwar_deserter_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_02.png[/img]{You order the executioners to let the prisoner go. They laugh and draw out their swords, but that's about the last thing they do as the %companyname% descends upon them with liberating fury, hacking the two soldiers down in mere seconds. The prisoner thanks you and, in return for the rescue, offers to serve you in battle. | You won't stand for such an execution and order the mercenaries of the %companyname% to intervene. They quickly draw their weapons and descend upon the soldiers, slaughtering them in but a moment. The freed prisoner falls to their feet before you.%SPEECH_ON%Please, let me fight in your ranks, it is the least I can offer!%SPEECH_OFF% | You order the %companyname% to save the prisoner. It is an odd series of sights and sounds to see men who thought themselves the executioners be so suddenly put to the blade. Such turns of fortune bring out wild, wailing screaming. Your mercenaries would have made it quick had they not tried to run, but a man who is intent on saving himself oft dies the slowest. The prisoner, meanwhile, falls to your feet and offers allegiance.}"
        es = "[img]gfx/ui/events/event_02.png[/img]{Ordenas a los verdugos que dejen ir a su víctima. Se ríen y desenvainan las espadas, pero es casi lo último que hacen: la %companyname% se les echa encima con furia liberadora y despedaza a los dos soldados en cuestión de segundos. La persona rescatada te da las gracias y, a cambio del rescate, se ofrece a servirte en combate. | No piensas tolerar semejante ejecución y ordenas a los mercenarios de la %companyname% que intervengan. Desenvainan rápidamente sus armas y caen sobre los soldados, masacrándolos en un instante. Ya libre, quien iba a morir cae de rodillas ante ti.%SPEECH_ON%¡Por favor, déjame luchar en tus filas, es lo menos que puedo ofrecer!%SPEECH_OFF% | Ordenas a la %companyname% que salve a la víctima. Es una extraña sucesión de imágenes y sonidos ver a hombres que se creían los verdugos pasados a cuchillo tan de repente. Semejantes giros de la fortuna arrancan alaridos salvajes y lastimeros. Tus mercenarios habrían acabado rápido si no hubieran intentado huir, pero un hombre empeñado en salvarse suele ser el que más tarda en morir. Mientras tanto, la víctima cae a tus pies y te ofrece su lealtad.}"
    }
    // context: civilwar_deserter_event.o.create.s.Text
    {
        // corrige base: «Golpea su rostro con una roca» por «le destroza la cara con una piedra» (beats his face in; la 1.0 rebaja la crudeza)
        en = "[img]gfx/ui/events/event_02.png[/img]{You order the prisoner rescued. One of the soldiers draws his sword and is immediately cut down for his misplaced confidence. The other soldier, seemingly sharper of mind, has already run off. No doubt he'll tell %noblehouse% of what you have done here. The rescued prisoner comes to you personally, going to one knee and bows.%SPEECH_ON%Thank you, sellsword. You have my blade for this day until my last.%SPEECH_OFF% | In your mind, it is unlikely that the two executioners would abandon their noble flags to join you. But it is quite probable that the prisoner would fight on your side, were you to free the prisoner. So you order a rescue. One of the soldiers draws his sword and pledges allegiance to the %noblehouse%. It's the last thing he does. The other soldier flees. Maybe you could have recruited him, but it's unlikely he'll come back given the prompt killing of his partner. Most likely he will tell his superiors of your actions here.\n\n You go to the freed prisoner, who hurriedly bows and offers to fight for the %companyname%. | You order the soldiers to let the prisoner go. One laughs and simply tightens the noose about the neck and starts to hang the doomed soldier. %randombrother% jumps forward and knocks an executioner to the ground, beating his face in with a rock while the second soldier runs off. No doubt he'll tell his commanders what you've done here.\n\n Freed, the prisoner comes to you personally and bows, offering allegiance in return for the rescue.}"
        es = "[img]gfx/ui/events/event_02.png[/img]{Ordenas rescatar a la víctima. Uno de los soldados desenvaina la espada y lo abaten en el acto por su confianza fuera de lugar. El otro soldado, aparentemente más espabilado, ya ha salido corriendo. Sin duda le contará a %noblehouse% lo que has hecho aquí. La víctima rescatada se acerca a ti en persona, hinca una rodilla y se inclina.%SPEECH_ON%Gracias, mercenario. Mi espada es tuya desde hoy hasta mi último día.%SPEECH_OFF% | Para tus adentros, piensas que es improbable que los dos verdugos abandonen las banderas de sus señores para unirse a ti. Pero es bastante probable que quien iban a colgar luche a tu lado si le devuelves la libertad. Así que ordenas un rescate. Uno de los soldados desenvaina la espada y jura lealtad a la %noblehouse%. Es lo último que hace. El otro soldado huye. Quizá podrías haberlo reclutado, pero es improbable que vuelva después de ver morir tan deprisa a su compañero. Lo más probable es que informe a sus superiores de lo que has hecho aquí.\n\n Te acercas a la víctima liberada, que se inclina apresuradamente y se ofrece a luchar por la %companyname%. | Ordenas a los soldados que suelten a su víctima. Uno se ríe, se limita a apretar la soga alrededor del cuello y empieza a colgar a la víctima, ya condenada. %randombrother% se lanza hacia delante y tumba a un verdugo, al que le destroza la cara con una piedra mientras el segundo soldado huye. Sin duda contará a sus mandos lo que has hecho aquí.\n\n Ya libre, la víctima se acerca a ti en persona y se inclina, ofreciéndote su lealtad a cambio del rescate.}"
    }
    // context: civilwar_deserter_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_02.png[/img]{Though you can't necessarily fault the prisoner for ignoring those orders, the decision was the prisoner's, and not yours, just as the punishment will be the prisoner's, and not yours. You order the %companyname% to keep marching. | You've no reason to involve the %companyname% in the politics of the quarreling nobles. The prisoner nods, understandingly.  Head high before being hung him straight. | The executioners glance at you, perhaps sensing that you might step in to absolutely ruin their day. Instead, you tell the prisoner that it was a choice that ended here. The prisoner nods solemnly. The executioners rush to finish the hanging, lest this dangerous stranger crossing their path have a sudden change of heart.}"
        es = "[img]gfx/ui/events/event_02.png[/img]{Aunque no puedes reprocharle del todo a quien van a ajusticiar que desobedeciera esas órdenes, la decisión fue suya y no tuya, igual que el castigo será suyo y no tuyo. Ordenas a la %companyname% que siga la marcha. | No tienes motivo alguno para meter a la %companyname% en las intrigas de los nobles enfrentados. La víctima asiente con comprensión y mantiene la cabeza bien alta hasta el final. | Los verdugos te miran de reojo, quizá temiendo que intervengas para arruinarles el día por completo. En cambio, le dices a la víctima que fue su decisión y que aquí termina. Asiente con solemnidad. Los verdugos se apresuran a terminar el ahorcamiento, no vaya a ser que este peligroso desconocido que se ha cruzado en su camino cambie de opinión de repente.}"
    }
    // context: civilwar_deserter_event.o.create.s.Options[0].Text
    {
        en = "Their war was not ours."
        es = "Su guerra no era la nuestra."
    }
    // FILE: mod_legends\hooks\events\events\crisis\civilwar_hungry_hamlet_event.nut
    // context: civilwar_hungry_hamlet_event.o.create.s.Text
    {
        // corrige base: «espadachín» por «mercenario» (sellsword; vocabulario fijado) y «rodean» por «se arremolina» (concordancia con «la gente»)
        en = "[img]gfx/ui/events/event_79.png[/img]{Against typical mercenary judgment, you elect to give the poor villagers some food. %randombrother% is told to disperse what %they_randombrother% can, although obviously not too much. The people are forever grateful, swarming the sellsword as though %they_randombrother% was about to whisper an immense and unforgettable truth. The leader of the small town says he will spread word of your goodwill. You're actually not sure if news of altruism is good for a mercenary band... | Shocking the villagers, you order %randombrother% to hand out some food. Not too much, just enough that these people can eat. And obviously, don't give away anything too good!\n\n The leader of the town comes to you, shaking hands clapping your shoulders.%SPEECH_ON%You've no idea what this means to us! All shall hear of the good in the...%SPEECH_OFF%He glances at you and then your banner. You nod.%SPEECH_ON%The %companyname%.%SPEECH_OFF%The man laughs.%SPEECH_ON%Of course! Everyone shall hear of the %companyname%!%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_79.png[/img]{En contra del típico juicio mercenario, decides darles algo de comida a los pobres aldeanos. Le ordenas a %randombrother% repartir lo que pueda, aunque obviamente no demasiado. La gente queda eternamente agradecida y se arremolina en torno %al_randombrother% mercenari%o_randombrother% como si estuviera a punto de susurrarles una verdad inmensa e inolvidable. El líder del pequeño pueblo dice que difundirá la noticia de tu buena voluntad. La verdad, no estás seguro de que las noticias de altruismo le convengan a una banda de mercenarios... | Para sorpresa de los aldeanos, le ordenas a %randombrother% repartir algo de comida. No demasiada, solo lo suficiente para que esta gente pueda comer. Y, obviamente, ¡nada de repartir lo bueno!\n\n El líder del pueblo se acerca a ti, estrechándote la mano y dándote palmadas en el hombro.%SPEECH_ON%¡No tienes idea de lo que esto significa para nosotros! Todos oirán hablar de la bondad de la...%SPEECH_OFF%Te mira, y luego mira tu estandarte. Asientes.%SPEECH_ON%La %companyname%.%SPEECH_OFF%El hombre ríe.%SPEECH_ON%¡Por supuesto! ¡Todos oirán hablar de la %companyname%!%SPEECH_OFF%}"
    }
    // context: civilwar_hungry_hamlet_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_79.png[/img]{Goodness gets the better of you: you order %randombrother% to start handing out food. %They_randombrother% complies, but as soon as %they_randombrother% starts handing it out, the crowd goes nearly rabid, snatching it from one another. Fiery tempers are quickly fed by the air of empty bellies. The mercenary tries to maintain order, but anything %they_randombrother% says only spurs the hungry masses into thinking it's all %their_randombrother% fault. The violence spills over, ironically spilling all the food into the mud. Your brothers have to draw swords and by the end of it some peasants lay dead while the survivors look at the corpses with cannibalistic eyes.\n\nYou quickly order the %companyname% to move on before this gets any worse. | For some reason, perhaps to sleep better at night, you order %randombrother% to hand out parcels of food. %They're_randombrother% just getting started on the process when a villager quickly snatches a sack of food. Another peasant stoves that man's head in and takes the sack for himself. This quickly erupts into a total free-for-all and your mercenaries have to draw weapons to protect the rest of the stores. By the end of the scuffle a few laymen lay dead and your brothers are a little marked up. Seeing no reason to hang around, you order the company to get back on the road. The leader who asked for your help is spotted in the distance, staring out at the horizon as a bitter wind curls his thin pantaloons about his shins.}"
        es = "[img]gfx/ui/events/event_79.png[/img]{La bondad puede más que tú: ordenas a %randombrother% empezar a repartir comida. Obedece, pero apenas comienza a repartirla, la multitud se vuelve casi rabiosa, arrebatándosela unos a otros. Los ánimos encendidos se alimentan enseguida del aire de estómagos vacíos. %Art_randombrother% mercenari%o_randombrother% intenta poner orden, pero cualquier cosa que dice solo empuja a las masas hambrientas a pensar que todo es culpa suya. La violencia se desborda, derramando irónicamente toda la comida en el barro. Tus hermanos tienen que desenvainar sus espadas, y al final algunos campesinos yacen muertos mientras los supervivientes miran los cadáveres con ojos de caníbal.\n\nOrdenas rápidamente a la %companyname% que se ponga en marcha antes de que esto empeore. | Por alguna razón, quizás para dormir mejor por las noches, ordenas a %randombrother% repartir paquetes de comida. Apenas ha empezado cuando un aldeano le arrebata rápidamente un saco de comida. Otro campesino le rompe la cabeza a golpes y se queda con el saco. Esto degenera rápidamente en un tumulto general y tus mercenarios tienen que desenvainar sus armas para proteger el resto de las provisiones. Al final de la trifulca, algunos aldeanos yacen muertos y tus hermanos quedan algo magullados. Sin motivo para quedarse, ordenas a la compañía volver al camino. Ves a lo lejos al líder que pidió tu ayuda, con la mirada perdida en el horizonte mientras un viento cortante le enrosca los delgados pantalones en torno a las espinillas.}"
    }
    // context: civilwar_hungry_hamlet_event.o.create.s.Text
    {
        // corrige base: «espadachín» por «mercenario» (sellsword; vocabulario fijado)
        en = "[img]gfx/ui/events/event_79.png[/img]Well. This world is a terrible place and if you can do a little to relieve it of its horrid nature, why not? You order %randombrother% to start doling out food, but not too much, and nothing that your tastes will miss. But as %they_randombrother% goes about the business, a few soldiers waving the %noblehouse% banner show up. They sift through the hungry crowd, taking food and drawing swords whenever someone resists. Their supposed leader speaks out.%SPEECH_ON%This food is needed by the arm of %noblehouse%. Do not resist its seizure.%SPEECH_OFF%You explain to the man that it is in fact your food and you just handed it out.%SPEECH_ON%If it's your food, why is it in their hands? Go along, men, take all that you can! And don't try anything, sellsword, or there will be violence.%SPEECH_OFF%%randombrother% glances at you as if to say, what should we do?"
        es = "[img]gfx/ui/events/event_79.png[/img]Bien. Este mundo es un lugar terrible, y si puedes hacer algo, por poco que sea, para aliviar su naturaleza espantosa, ¿por qué no? Ordenas a %randombrother% empezar a repartir comida, pero no demasiada, y nada que vayas a echar de menos. Pero mientras se ocupa del asunto, aparecen unos soldados enarbolando el estandarte de %noblehouse%. Se abren paso entre la muchedumbre hambrienta, tomando comida y desenvainando espadas cuando alguien se resiste. Su supuesto líder habla en voz alta.%SPEECH_ON%Esta comida la requiere el brazo de %noblehouse%. No se resistan a que sea requisada.%SPEECH_OFF%Le explicas al hombre que, de hecho, es tu comida y que tú mismo acabas de repartirla.%SPEECH_ON%Si es tu comida, ¿por qué está en sus manos? Sigan adelante, hombres, ¡tomen todo lo que puedan! Y no intentes nada, mercenario, o habrá violencia.%SPEECH_OFF%%randombrother% te mira de reojo como preguntando qué deberíamos hacer."
    }
    // FILE: mod_legends\hooks\events\events\crisis\civilwar_outro_event.nut
    // context: civilwar_outro_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «¿A quién le importa?» por «¿A quién le importa una mierda?» (Who gives a shite?; la 1.0 rebaja la crudeza)
        // corrige base: «Tú escupes» por «Carraspeas, escupes un gargajo» (la 1.0 omite «hock a loogie»)
        en = "[img]gfx/ui/events/event_96.png[/img]You're in your tent when %dude% makes an entrance. %They_dude% speaks bluntly.%SPEECH_ON%Nobles be talking. Big fancy tent setup yonder and they're in there.%SPEECH_OFF%Putting your quill pen down, you respond.%SPEECH_ON%Just talking?%SPEECH_OFF%The mercenary shrugs.%SPEECH_ON%It's quiet. So they're either talking, or killing one another real quiet like.%SPEECH_OFF%You get up and step outside. A brisk air hits you, and on it is the scent of spices and flavors. Looking upwind, you spot the tent. Cooks and chefs are hurrying about with orders of food and other makings. Servants carry platters of meats, vegetables, and fruits. An opulent tent, black with gold embroidering, houses the nobles. Bannermen stand outside. They take no part in the festivities. They're mostly playing cards while occasionally glancing at one another. Some are bandaged with blood splotched linens. One man stands on crutches with a haggard, half-cocked knee. You ask %dude% what the news is. %They_dude% nods toward the scene.%SPEECH_ON%Well, they rolled up about an hour ago while you were checking the maps. We didn't want to bother ya, but, well, they seemed intent on staying so, you know.%SPEECH_OFF%You get a good look at the noble tent. Through its opening, you can see the faint glisten of crowned heads passing back and forth. %dude% spits and asks.%SPEECH_ON%Well, who do you think won the war?%SPEECH_OFF%You hock a loogie, spit, and shake your head.%SPEECH_ON%Who gives a shite?%SPEECH_OFF%All that matters to you is that peace means fewer contracts. Perhaps now would be a good time to put up the sword and enjoy your crowns? Or maybe say to hell with all that sentimental crap and just keep pressing forward, leading the company to even greater things?\n\n%OOC%Something burns down inside of you. Something that struggles to be free. Perhaps it is the success you have had along the way, or the failings that you couldn't stop in time. Maybe there is more out there to see?%OOC_OFF%"
        es = "[img]gfx/ui/events/event_96.png[/img]Estás en tu tienda cuando %dude% hace su entrada. Habla sin rodeos.%SPEECH_ON%Los nobles están hablando. Han montado una gran tienda allí y están adentro.%SPEECH_OFF%Dejando tu pluma de escribir a un lado, respondes.%SPEECH_ON%¿Solo hablando?%SPEECH_OFF%%Art_dude% mercenari%o_dude% encoge los hombros.%SPEECH_ON%Está tranquilo. Así que o están hablando, o se están matando entre ellos muy calladamente.%SPEECH_OFF%Te levantas y sales de la tienda. Un aire fresco te golpea, llevando consigo el aroma de especias y sabores. Mirando hacia el viento, ves la tienda. Cocineros y chefs se apresuran con órdenes de comida y otros preparativos. Sirvientes llevan bandejas de carne, verduras y frutas. Una tienda opulenta, negra con bordados de oro, alberga a los nobles. Los portadores de estandartes están afuera. No participan en las festividades. Mayormente están jugando a las cartas mientras se miran de reojo ocasionalmente. Algunos están vendados con telas manchadas de sangre. Un hombre está de pie con muletas, con una rodilla maltrecha. Preguntas a %dude% qué noticias hay. Señala la escena con la cabeza.%SPEECH_ON%Bueno, llegaron hace una hora mientras tú revisabas los mapas. No queríamos molestarte, pero, bueno, parecían empeñados en quedarse, ya sabes.%SPEECH_OFF%Observas la tienda noble. A través de su abertura, puedes ver el leve destello de cabezas coronadas que van y vienen. %dude% escupe y pregunta.%SPEECH_ON%Bueno, ¿quién crees que ganó la guerra?%SPEECH_OFF%Carraspeas, escupes un gargajo y niegas con la cabeza.%SPEECH_ON%¿A quién le importa una mierda?%SPEECH_OFF%Lo único que te importa es que la paz significa menos contratos. Tal vez ahora sería un buen momento para guardar la espada y disfrutar de tus coronas. ¿O tal vez mandar todo ese sentimentalismo al diablo y seguir adelante, liderando la compañía hacia cosas aún mayores?\n\n%OOC%Algo arde en lo más hondo de ti. Algo que lucha por liberarse. Quizá sean los éxitos que has cosechado por el camino, o los fracasos que no pudiste evitar a tiempo. ¿Quizá quede más por ver ahí fuera?%OOC_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\crisis\civilwar_refugees_event.nut
    // context: civilwar_refugees_event.o.create.s.Text
    {
        // corrige base: «Tienen poco valor» por «Tienen poco de valor» (They've little of value: poseen pocas cosas valiosas, no valen poco)
        // corrige base: «la cabeza de la columna de sufrimiento» por «la cabeza de ese ciempiés doliente» (la 1.0 pierde la imagen del ciempiés)
        en = "[img]gfx/ui/events/event_59.png[/img]{A true war has plenty of living amongst the casualties and this one is no different: going along a path, you find a large group of refugees huddling together. They were washing themselves in a creek when you discovered them, a party half-naked and half-washed and all-terrified. Mostly women and children, a few elders, and a few men who seem ready to lay down their lives for the rest, no matter how fruitless an effort their defense would be. One such man steps forward.%SPEECH_ON%What is it that you want?%SPEECH_OFF%%aggro_bro% approaches you.%SPEECH_ON%Sir, we could take everything they got, but I'm sure they won't give it up willingly.%SPEECH_OFF%%injured_bro% shakes their head.%SPEECH_ON%I'd say it ain't worth it. These people been through enough as it is and they've little left to give the world.%SPEECH_OFF% | You come across a band of refugees. Women, children, elders, and a scattering of wide-eyed men. They've little of value, but they still have things worth taking were you to put in the effort. | Refugees. A band of them stringed along the path in a long and filed row. At the sight of you, the head of the suffering centipede rears to a stop and all the bodies slowly shuffle together into a fearful blob. %aggro_bro% suggests killing them and taking what they got, although what they got doesn't appear to be much at all by your measurement.}"
        es = "[img]gfx/ui/events/event_59.png[/img]{Las situaciones de guerra suelen tener a muchos vivos entre las bajas, y esta no es diferente: mientras avanzas por un camino, encuentras a un gran grupo de refugiados reunidos. Estaban lavándose en un arroyo cuando los descubriste, un grupo medio desnudo, medio lavado y completamente aterrado. Principalmente mujeres y niños, algunos ancianos y algunos hombres que parecen dispuestos a dar sus vidas por los demás, sin importar cuán infructuoso sería su esfuerzo defensivo. Uno de esos hombres da un paso adelante.%SPEECH_ON%¿Qué es lo que quieres?%SPEECH_OFF%%aggro_bro% se acerca a ti.%SPEECH_ON%Señor, podríamos tomar todo lo que tienen, pero estoy seguro de que no lo entregarán voluntariamente.%SPEECH_OFF%%injured_bro% niega con la cabeza.%SPEECH_ON%Yo diría que no vale la pena. Estas personas ya han pasado por bastante y les queda poco que dar al mundo.%SPEECH_OFF% | Te encuentras con un grupo de refugiados. Mujeres, niños, ancianos y unos cuantos hombres con los ojos como platos. Tienen poco de valor, pero aún tienen cosas que valdría la pena llevarse si te tomaras la molestia. | Refugiados. Un grupo de ellos se extiende a lo largo del camino en una fila larga y ordenada. Al verte, la cabeza de ese ciempiés doliente se detiene en seco y todos los cuerpos se apelotonan lentamente en una masa temerosa. %aggro_bro% sugiere matarlos y quedarse con lo que tienen, aunque, a tu juicio, lo que tienen no parece gran cosa.}"
    }
    // context: civilwar_refugees_event.o.create.s.Text
    {
        // corrige base: «se suman a sus filas» por «se meten entre sus filas» (file into their ranks: entran entre los refugiados, no se unen a ellos)
        en = "[img]gfx/ui/events/event_59.png[/img]You order your mercenaries to take what they can. The refugees reel back in horror and some protest as your warriors file into their ranks. Suddenly, one of the refugees takes a large stone and bashes %injured_bro% over the head with it. Women and children scream and a few other men grab onto the mercenaries, fighting over weapons still sheathed. But the wandering souls haven't eaten in days and their weakened bodies are no match for your men. The %companyname% takes what it wants."
        es = "[img]gfx/ui/events/event_59.png[/img]Ordenas a tus mercenarios que se lleven lo que puedan. Los refugiados retroceden horrorizados y algunos protestan mientras tus guerreros se meten entre sus filas. De repente, uno de los refugiados toma una piedra grande y golpea a %injured_bro% en la cabeza con ella. Las mujeres y los niños gritan y algunos hombres más se aferran a los mercenarios, peleando por las armas aún envainadas. Pero las almas errantes no han comido en días y sus cuerpos debilitados no son rival para tus hombres. La %companyname% toma lo que quiere."
    }
    // context: civilwar_refugees_event.o.create.s.Text
    {
        // corrige base: «más confundidos que comprensivos» por «más confundidos que conscientes de lo que pasa» (understanding aquí es entender, no ser comprensivo)
        en = "[img]gfx/ui/events/event_59.png[/img]You order your mercenaries to take what they can. The refugees reel back in horror. Women cry out, children, more confused than understanding, do the same. Some tearful men beg that you simply leave. Unfortunately for this band of useless tramps, the %companyname% takes what it wants. Your warriors freely sift through the crowds, eventually returning with their hauls."
        es = "[img]gfx/ui/events/event_59.png[/img]Ordenas a tus mercenarios que se lleven lo que puedan. Los refugiados retroceden horrorizados. Las mujeres gritan; los niños, más confundidos que conscientes de lo que pasa, hacen lo mismo. Algunos hombres, entre lágrimas, te ruegan que simplemente te vayas. Desafortunadamente para esta banda de vagabundos inútiles, la %companyname% toma lo que quiere. Tus guerreros se abren paso libremente entre la multitud y finalmente regresan con su botín."
    }
    // context: civilwar_refugees_event.o.create.s.Text
    {
        // corrige base: «Decides intervenir con» por «Decides apoyarte en» (weigh on: recurrir a alguien, no intervenir)
        en = "[img]gfx/ui/events/event_59.png[/img]You decide to weigh on a mercenary who has personal experience as a refugee: %refugee_bro%.\n\nThe mercenary heads into the sobbing and praying mass of weary travelers. Talking with them for a time and sharing some food, friendly gesticulations and tales of %refugee_bro%'s own past gradually bringing the crowd on side. You watch as an old man hands over something wrapped in sheepskin with leather thongs swooping beneath. The sellsword bows, shakes the man's hand, and returns.\n\n Throwing the sheepskin back unveils a sword that glints in the light about as sharply as you can imagine it cuts. %refugee_bro% smiles.%SPEECH_ON%Like me mum always said, a bit of friendliness never hurt nobody, but this sword sure will!%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_59.png[/img]Decides apoyarte en alguien de la compañía que sabe en carne propia lo que es ser refugiado: %refugee_bro%.\n\nSe adentra entre la masa de viajeros agotados que sollozan y rezan. Pasa un rato hablando con ellos y comparte algo de comida, y los gestos amistosos y las historias del pasado de %refugee_bro% van poniendo poco a poco a la multitud de su parte. Observas cómo un anciano le entrega algo envuelto en piel de oveja, con correas de cuero colgando por debajo. Hace una reverencia, estrecha la mano del anciano y regresa.\n\n Al retirar la piel de oveja aparece una espada cuyo destello a la luz parece tan afilado como su filo. %refugee_bro% sonríe.%SPEECH_ON%Como siempre decía mi madre, un poco de amabilidad nunca le ha hecho daño a nadie, ¡pero esta espada seguro que sí lo hará!%SPEECH_OFF%"
    }
    // en = "You gain <item:str>"
    // en base_es
    // FILE: mod_legends\hooks\events\events\crisis\greenskins_outro_event.nut
    // context: greenskins_outro_event.o.create.s.Text
    {
        // corrige base: «Son todo actuación, teatralidad» por «Todo este teatro es pura mierda» (It's all bullshit; la 1.0 rebaja la crudeza)
        // corrige base: «acabara de insultar a su madre» por «le hubiera dado un puñetazo a su madre» (socked es golpear)
        // corrige base: «ponen en peligro a la gente» por «hacen que maten a gente» (get people killed; la 1.0 lo suaviza)
        // corrige base: «¿qué hubiera pasado sí» por «¿y si...?» (errata en la tilde de «si»)
        en = "[img]gfx/ui/events/event_05.png[/img]%dude% reaches for his weapon, but you shake your head. The lieutenant nods toward the mercenary.%SPEECH_ON%Best keep that dog on its leash, aye?%SPEECH_OFF%You fan your arm out, inviting the soldiers a 'passage' they knew they already had. The soldiers gear up and the lieutenant smirks.%SPEECH_ON%I knew you'd make the right choice. We're just 'aving a bit of fun, yeah? You ladies stay tight.%SPEECH_OFF%The man blows a kiss as he walks by. %dude% stands up looking like someone just socked his mother. You tell him to sit back down and he begrudgingly does so. It's all bullshit, these theatrics, but you're not one to lose your temper and get people killed over it.\n\nThe incident does make you wonder if maybe it's time to turn it all in. The greenskins are beaten back and you've made enough money to leave the life for good, but then again you'd hate to live out the rest of your days wondering 'what if'...\n\n%OOC%Something burns down inside of you. Something that struggles to be free. Perhaps it is the success you have have had along the way, or the failings that you couldn't stop in time. Maybe there is more out there to see?%OOC_OFF%"
        es = "[img]gfx/ui/events/event_05.png[/img]%dude% echa mano a su arma, pero niegas con la cabeza. El teniente señala con la cabeza al mercenario.%SPEECH_ON%Mejor mantén a ese perro atado, ¿sí?%SPEECH_OFF%Extiendes el brazo, ofreciendo a los soldados un «paso» que ya sabían que tenían. Los soldados se preparan y el teniente sonríe con suficiencia.%SPEECH_ON%Sabía que harías la elección correcta. Solo nos estamos divirtiendo un poco, ¿eh? Ustedes, damas, manténganse firmes.%SPEECH_OFF%El hombre lanza un beso al pasar. %dude% se levanta con cara de que alguien le hubiera dado un puñetazo a su madre. Le dices que vuelva a sentarse y lo hace de mala gana. Todo este teatro es pura mierda, pero no eres de los que pierden los estribos y hacen que maten a gente por ello.\n\nEl incidente sí te hace preguntarte si tal vez es hora de dejarlo todo. Los verdes han sido rechazados y has ganado suficiente dinero para abandonar esta vida para siempre, pero, por otro lado, odiarías pasar el resto de tus días preguntándote «¿y si...?»...\n\n%OOC%Algo arde en lo más hondo de ti. Algo que lucha por liberarse. Quizá sean los éxitos que has cosechado por el camino, o los fracasos que no pudiste evitar a tiempo. ¿Quizá quede más por ver ahí fuera?%OOC_OFF%"
    }
    // context: greenskins_outro_event.o.create.s.Text
    {
        // corrige base: «¿Cuántos más de estos errores te esperan en el futuro?» por «¿Cuántas cagadas más como esta te esperan?» (cockups; la 1.0 rebaja la crudeza)
        en = "[img]gfx/ui/events/event_05.png[/img]The soldiers' lieutenant glares at you.%SPEECH_ON%Do as I said, sellsword, or there will be trouble.%SPEECH_OFF%Ignoring him, you give another nod to %dude%. He gets up, the blade of his weapon loudly scraping off the dirt. The soldiers turn to the mercenary. He hefts his weapon into both hands and stares back. As the lieutenant starts to talk, %dude% bluntly interrupts.%SPEECH_ON%Shush, little man. I see softness in your skin. Not a scar to be seen. Eyes as fresh as the day they were born. Hands as smooth as untouched candles. If you was of the fightin' sort, you'd be out there in those battles you speak of, not out here pissing into the wind. I'll give you two options because I'm feeling nice. First option, are you listening? First option is this. Go where you are going and don't say another goddam word.%SPEECH_OFF%He pauses to hold up two fingers.%SPEECH_ON%Option two is a mystery. Speak and ye shall learn of it.%SPEECH_OFF%The lieutenant's eyes have gotten a little wider, and his mouth infinitely quieter. He glances at you, but all you can do is shrug. After another moment, the soldiers hurry away with determined silence.\n\n%dude% laughs it up, but the incident has you wondering if perhaps it is finally the time to retire. How many more of these cockups are in your future? How many more battles? How many more dead men will you have to bury? The company would do well standing on the foundations you've built for it. But on the other hand, if you retired now, what adventures would you miss out on?\n\n%OOC%Something burns down inside of you. Something that struggles to be free. Perhaps it is the success you have have had along the way, or the failings that you couldn't stop in time. Maybe there is more out there to see?.%OOC_OFF%"
        es = "[img]gfx/ui/events/event_05.png[/img]El teniente de los soldados te fulmina con la mirada.%SPEECH_ON%Haz lo que te dije, mercenario, o habrá problemas.%SPEECH_OFF%Ignorándolo, le haces otro gesto a %dude%. Se levanta, y la hoja de su arma raspa ruidosamente contra el suelo. Los soldados se vuelven hacia el mercenario. Sostiene su arma con ambas manos y les devuelve la mirada. Cuando el teniente empieza a hablar, %dude% lo interrumpe bruscamente.%SPEECH_ON%Shh, hombrecito. Veo suavidad en tu piel. No hay ni una cicatriz a la vista. Ojos tan frescos como el día en que nacieron. Manos tan suaves como velas sin tocar. Si tuvieras madera de luchador, estarías allí afuera en esas batallas de las que hablas, no aquí afuera meando al viento. Te daré dos opciones, porque me siento amable. ¿Estás escuchando? La primera opción es esta. Ve a donde vas y no digas otra puta palabra.%SPEECH_OFF%Hace una pausa para levantar dos dedos.%SPEECH_ON%La segunda opción es un misterio. Habla y descubrirás qué es.%SPEECH_OFF%Los ojos del teniente se han vuelto un poco más amplios y su boca infinitamente más silenciosa. Te mira de reojo, pero todo lo que puedes hacer es encoger los hombros. Después de otro momento, los soldados se apresuran a alejarse en silencio decidido.\n\n%dude% se ríe, pero el incidente te hace preguntarte si quizás es el momento de retirarte. ¿Cuántas cagadas más como esta te esperan? ¿Cuántas batallas más? ¿Cuántos hombres muertos más tendrás que enterrar? La compañía se desenvolvería bien sobre los cimientos que has construido para ella. Pero, por otro lado, si te retiraras ahora, ¿qué aventuras te perderías?\n\n%OOC%Algo arde en lo más hondo de ti. Algo que lucha por liberarse. Quizá sean los éxitos que has cosechado por el camino, o los fracasos que no pudiste evitar a tiempo. ¿Quizá quede más por ver ahí fuera?%OOC_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\crisis\greenskins_pet_goblin_event.nut
    // en = "You lose <v:int_tag> Medical Supplies."
    // en base_es
    // FILE: mod_legends\hooks\events\events\crisis\greenskins_slayer_event.nut
    // context: greenskins_slayer_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_35.png[/img]While marching, as stranger crosses paths with the %companyname%. %They_dude% wears light armor while looking aloof and distant at first - as if staring off at something you can't see. %SPEECH_ON%Evening, sellswords.%SPEECH_OFF%The warrior waves. There's an uncanny air to this character, as though you can barely see %them_dude% while %they_dude% is standing right in front of you. %They_dude% nods and continues speaking.%SPEECH_ON%You seem the greenskin skinnin' sort, and that's the sort of company I'd be most agreeable to joining.%SPEECH_OFF%%randombrother% exchanges a glance with you and shrugs. %They_randombrother% whispers %Their_randombrother% indifference.%SPEECH_ON%If %they_dude% becomes a problem, we can handle %them_dude%.%SPEECH_OFF%The warrior shakes %their_dude% head.%SPEECH_ON%Oh, I'll be no problem. I just want to kill orcs and goblins. What more do you need to know? Shall we get on with killing some greenskins, then?%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_35.png[/img]Mientras marchan, %un_dude% desconocid%o_dude% se cruza en el camino de la %companyname%. Lleva armadura ligera y al principio parece distante y ausente, como si mirara algo que tú no puedes ver.%SPEECH_ON%Buenas noches, mercenarios.%SPEECH_OFF%%Art_dude% guerrer%o_dude% saluda con la mano. Hay algo inquietante en este personaje, como si apenas pudieras ver%lo_dude% aunque esté justo delante de ti. Asiente y sigue hablando.%SPEECH_ON%Ustedes parecen de los que despellejan pieles verdes, y ese es el tipo de compañía a la que me uniría con mucho gusto.%SPEECH_OFF%%randombrother% cruza una mirada contigo y se encoge de hombros. Te susurra su indiferencia.%SPEECH_ON%Si da problemas, nos encargamos.%SPEECH_OFF%%Art_dude% guerrer%o_dude% niega con la cabeza.%SPEECH_ON%Oh, no daré ningún problema. Solo quiero matar orcos y goblins. ¿Qué más necesitan saber? ¿Nos ponemos a matar pieles verdes, entonces?%SPEECH_OFF%"
    }
    // context: greenskins_slayer_event.o.create.s.start._event.m.Dude.getBackground().m.RawDescription
    {
        en = "The forests scream and wail. Nature has been out of balance for a long time and %name% is one of the few chosen to listen."
        es = "Los bosques gritan y se lamentan. La naturaleza lleva mucho tiempo desequilibrada y %name% es de los pocos elegidos para escucharla."
    }
    // context: greenskins_slayer_event.o.create.s.start._event.m.Dude.getBackground().m.RawDescription
    {
        en = "Part of an ancient order somewhere in the forests, %name% vowed to maintain balance of nature and all other things, even if violence was necessary."
        es = "Miembro de una antigua orden de algún lugar de los bosques, %name% juró mantener el equilibrio de la naturaleza y de todas las demás cosas, aunque hiciera falta la violencia."
    }
    // en = "<dude:str>'s Necklace"
    // en base_es
    // FILE: mod_legends\hooks\events\events\crisis\undead_crusader_event.nut
    // context: undead_crusader_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_35.png[/img]A figure stops you on the path. You put a hand to your sword and order %them_dude% to announce %their_dude% intentions, all the while keeping your eyes peeled for an ambush. The stranger takes a step forward and removes %their_dude% helm.%SPEECH_ON%I am %crusader%, a fighter from a distant order. My order has been reduced to ruins. I slew the monsters of Dev'ungrad. I gave peace to the spirits at Shellstaya. When the ancients speak, I listen. And so here I am.%SPEECH_OFF%You take your hand off your sword and ask %them_dude% of the ancients. %They_dude% nods and speak.%SPEECH_ON%The men before men, the ancients were suzerain over all things, having forged an empire that stretched to realms far beyond this one. All this chaos is a mere fragment of their destruction. A man may die, but an empire does not. An empire decays, piece by piece, and takes with it all that it thinks it is owed.%SPEECH_OFF%The stranger puts %their_dude% helmet back on and holds %their_dude% sword up.%SPEECH_ON%The Empire of the Ancients stirs in its grave. I wish to help quiet it. I offer you my sword, mercenary.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_35.png[/img]Una figura te corta el paso en el camino. Llevas la mano a la espada y le ordenas que anuncie sus intenciones, sin dejar de vigilar por si hay una emboscada. %Art_dude% desconocid%o_dude% da un paso adelante y se quita el yelmo.%SPEECH_ON%Soy %crusader%, combatiente de una orden lejana. Mi orden ha quedado reducida a ruinas. Di muerte a los monstruos de Dev'ungrad. Di paz a los espíritus de Shellstaya. Cuando los antiguos hablan, yo escucho. Y por eso estoy aquí.%SPEECH_OFF%Apartas la mano de la espada y le preguntas por los antiguos. Asiente y habla.%SPEECH_ON%Los hombres de antes de los hombres, los antiguos, eran señores supremos de todas las cosas, y forjaron un imperio que se extendía hasta reinos mucho más allá de este. Todo este caos no es más que un fragmento de su destrucción. Un hombre puede morir, pero un imperio no. Un imperio se descompone, pieza a pieza, y se lleva consigo todo lo que cree que se le debe.%SPEECH_OFF%%Art_dude% desconocid%o_dude% vuelve a ponerse el yelmo y alza la espada.%SPEECH_ON%El Imperio de los Antiguos se agita en su tumba. Quiero ayudar a acallarlo. Te ofrezco mi espada, mercenario.%SPEECH_OFF%"
    }
    // context: undead_crusader_event.o.create.s.start._event.m.Dude.getBackground().m.RawDescription
    {
        en = "With nowhere else to go, %name% resorted to seeking you out after the destruction of the monastery. With their home gone, the future from %them% and the order looks bleaker still."
        es = "Sin otro lugar adonde ir, %name% recurrió a buscarte tras la destrucción del monasterio. Perdido su hogar, el futuro para %el% y para la orden se ve aún más sombrío."
    }
    // FILE: mod_legends\hooks\events\events\crisis\undead_frozen_pond_event.nut
    // context: undead_frozen_pond_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_143.png[/img]%chosenbrother% elects to try and make a run on getting the dead knight's sword. %Their_other% first step on the pond sends an icy warble clear across the underbelly of the frozen sheet. %They_other% tests %their_other% footing again. The ice shifts and chitters, but it does not crack. With every step, the sellsword measures %their_other% own weight and its likelihood to collapse the ice - all the meanwhile, making sure %they_other% doesn't step on one of the corpses littered about. \n\n %They_other% successfully gets to the undead knight. Icicles dangle off its sword, the blade itself encapsulated in a layer of ice. The sellsword grabs the blade and yanks. The undead knight's arm lurches forward and breaks off at the elbow, sending the sellsword arse-skating backward across the pond. %They_other% slides up against the edge where your men help %them_other% up. The sword will need to be heated to get the ice off, but the weapon is definitely usable."
        es = "[img]gfx/ui/events/event_143.png[/img]%chosenbrother% decide intentar hacerse con la espada del caballero muerto. Su primer paso sobre el estanque envía un gorjeo helado por todo el vientre de la capa congelada. Vuelve a tantear dónde pisa. El hielo se mueve y chirría, pero no se agrieta. A cada paso, %art_other% mercenari%o_other% calcula su propio peso y la probabilidad de que hunda el hielo, todo ello mientras se asegura de no pisar ninguno de los cadáveres esparcidos por ahí. \n\n Consigue llegar hasta el caballero no muerto. De su espada cuelgan carámbanos, y la propia hoja está envuelta en una capa de hielo. Agarra la hoja y tira con fuerza. El brazo del caballero no muerto da una sacudida hacia delante y se parte por el codo, y %art_other% mercenari%o_other% sale patinando de culo hacia atrás por el estanque. Se desliza hasta el borde, donde tus hombres %lo_other% ayudan a levantarse. Habrá que calentar la espada para quitarle el hielo, pero el arma es sin duda utilizable."
    }
    // context: undead_frozen_pond_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_143.png[/img]%chosenbrother% tries the ice, putting a foot right on the edge of the pond. A soft warble echoes across the pondwater's cold underbelly, as though someone had skipped a drumming rock across a barreled surface. %They_other% looks back at the party and shrugs.%SPEECH_ON%Seem's aight.%SPEECH_OFF%%Their_other% next step sends %them_lightweight% crashing through the ice. Shards break into a sort of chevron entrapment and when %They_other% reaches out to grab one it slices %their_other% hands. The men quickly throw %them_lightweight% a rope and drag him out.\n\n Bloodied and shivering, %chosenbrother% shakes %their_other% head as %they_other%'s wrapped in blankets.%SPEECH_ON%I-I-I-I believe that was aw-aw-aw-awful. Aw-aw-awful idea, sir.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_143.png[/img]%chosenbrother% prueba el hielo poniendo un pie justo en el borde del estanque. Un suave gorjeo resuena por el frío vientre del agua, como si alguien hubiera hecho saltar una piedra sobre el parche tenso de un tambor. Se vuelve hacia el grupo y se encoge de hombros.%SPEECH_ON%Parece que aguanta.%SPEECH_OFF%Con el siguiente paso, atraviesa el hielo y se hunde. Los fragmentos se quiebran formando una especie de trampa en cuña, y cuando intenta agarrarse a uno, se corta las manos. Los hombres le lanzan enseguida una cuerda y %lo_other% sacan a rastras.\n\n Ensangrentad%o_other% y tiritando, %chosenbrother% niega con la cabeza mientras %lo_other% envuelven en mantas.%SPEECH_ON%C-c-c-creo que eso fue ho-ho-ho-horrible. Una i-i-idea ho-ho-horrible, señor.%SPEECH_OFF%"
    }
    // context: undead_frozen_pond_event.o.create.s.Text
    {
        // corrige base: «¿qué no se puede amar de este resultado?» por «¿qué más se puede pedir?» (calco de what's not to love)
        en = "[img]gfx/ui/events/event_143.png[/img]%lightweight% steps forward.%SPEECH_ON%Ice? Ice is nothing. You can glide on it like this.%SPEECH_OFF%Without even a pause, the %person_lightweight% leaps out onto the frozen pond and skates across its surface. Cracks emerge out from behind him like a wake of imminently bad news, but %they_lightweight% remains unperturbed. %They_lightweight% swings by the undead knight and grabs the frozen sword. The wiederganger groans as its arm breaks off at the elbow. The %person_lightweight% merrily skates %their_lightweight% way back to the edge of the pond and presents the sword to you. %otherbrother% steps forward and cracks the wiederganger's frozen arm off the handle like a man breaking a crab claw.%SPEECH_ON%Would ya look at that?%SPEECH_OFF%He crushes the fingers into fragments and in the powdered remains there is a signet. A sword and jewelry, what's not to love about this result?"
        es = "[img]gfx/ui/events/event_143.png[/img]%lightweight% da un paso adelante.%SPEECH_ON%¿Hielo? El hielo no es nada. Puedes deslizarte sobre él así.%SPEECH_OFF%Sin siquiera vacilar, salta al estanque congelado y patina sobre su superficie. Tras %el_lightweight% surgen grietas como una estela de malas noticias inminentes, pero permanece imperturbable. Se desliza junto al caballero no muerto y agarra la espada congelada. El wiederganger gime cuando su brazo se quiebra por el codo. Regresa patinando alegremente hasta el borde del estanque y te ofrece la espada. %otherbrother% da un paso adelante y desprende del mango el brazo congelado del wiederganger como quien parte la pinza de un cangrejo.%SPEECH_ON%¡Fíjate en esto!%SPEECH_OFF%Aplasta los dedos hasta hacerlos pedazos y entre los restos pulverizados hay un sello. Una espada y joyas, ¿qué más se puede pedir?"
    }
    // FILE: mod_legends\hooks\events\events\crisis\undead_necrosavant_event.nut
    // context: undead_necrosavant_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «perno» por «virote» (bolt de ballesta; «perno» es un calco)
        // corrige base: «trasero» por «culo» (arse; la 1.0 rebaja el registro)
        en = "[img]gfx/ui/events/event_76.png[/img]Suddenly, a crossbow aims over your shoulder and fires so closely you can feel the air rushing past the twang of its rope. The bolt pierces the old man's skull and he tips forward, head to the mud, arse in the air, hands still beside himself in dispirited supination.\n\nYou turn to see %witchhunter% the witch hunter standing behind you. %They_witchhunter% lowers the crossbow and walks over to the corpse, grabbing it by the nape of the neck and putting a stake through its back. The body wretches with a shriek and the clothing bloats as the body implodes, a swirling dust hurriedly exiting out the cloak as though it had been caught impersonating a man.\n\n The witch hunter turns to you.%SPEECH_ON%Necrosavant. Rare. Extremely dangerous.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_76.png[/img]De repente, una ballesta apunta por encima de tu hombro y dispara tan cerca que sientes el aire que pasa junto al zumbido de su cuerda. El virote atraviesa el cráneo del anciano, que cae hacia delante: la cabeza en el barro, el culo en el aire y las manos aún a los costados, en una supinación abatida.\n\nTe das la vuelta y ves a %witchhunter% detrás de ti. Baja la ballesta y se acerca al cadáver, lo agarra por la nuca y le clava una estaca en la espalda. El cuerpo se convulsiona con un chillido y la ropa se hincha mientras el cuerpo implosiona; un remolino de polvo sale a toda prisa por la capa, como si lo hubieran sorprendido haciéndose pasar por un hombre.\n\n %witchhunter% se vuelve hacia ti.%SPEECH_ON%Necrosavante. Raro. Extremadamente peligroso.%SPEECH_OFF%"
    }
    // context: undead_necrosavant_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_76.png[/img]The figure rises and turns to you with a dark gaze of one who has lived for a thousand years.%SPEECH_ON%Ah, brothers, I have waited for you.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_76.png[/img]La figura se levanta y se vuelve hacia ti con la mirada oscura de quien ha vivido mil años.%SPEECH_ON%Ah, hermanos, los estaba esperando.%SPEECH_OFF%"
    }
    // en = "Welcome to the %companyname%."
    // en base_es
    // context: undead_necrosavant_event.o.create.m.Screens.push().Options.Text
    {
        en = "Too much flesh for us"
        es = "Demasiada carne para nosotros"
    }
    // FILE: mod_legends\hooks\events\events\crisis\undead_outro_event.nut
    // context: undead_outro_event.o.create.s.Text
    {
        // corrige base: «decidir tomar las riendas de %companyname%» por «mandar todo al diablo y llevar a la %companyname%» (la 1.0 omite «say damn it all»)
        // corrige base: espacios sobrantes tras %SPEECH_ON% y %SPEECH_OFF% que el inglés no tiene
        en = "[img]gfx/ui/events/event_33.png[/img]You wake. A rough wind bends the tent, curling the leather and rolling tides across the ceiling. Faint candlelight flicks and dashes darkness and light all the same. %dude% is standing there, watching you, shadows crossing back and forth across %their_dude% chest. %They_dude% shifts on %their_dude% feet, an uneasy look on %their_dude% face.%SPEECH_ON%Who were you talking to?%SPEECH_OFF%Rolling out of bed, you put your boots to the ground, wanting to be sure of this reality before you dare parlay with it. Dirt rustles and crunches beneath your feet. You answer.%SPEECH_ON%I'm not sure. I think... I think the invasion is over.%SPEECH_OFF%The mercenary nods and turns a hand to the tent's entrance.%SPEECH_ON%Aye, that's why I'm here. A noble messenger arrived just a minute ago. %They_dude% says the undead have ceased erupting from the ground. The scribes believe it is over. Are you alright, sir?%SPEECH_OFF%You rub your head. Is it time to retire? What can you make of this world now that you know what you do? It is either go live out the rest of your days in peace, or say damn it all and command the %companyname% to further glory.\n\n%OOC%Something burns down inside of you. Something that struggles to be free. Perhaps it is the success you have have had along the way, or the failings that you couldn't stop in time. Maybe there is more out there to see?%OOC_OFF%"
        es = "[img]gfx/ui/events/event_33.png[/img]Despiertas. Un viento fuerte hace que la tienda se doble, curvando el cuero y formando olas en el techo. Una tenue luz de las velas se agita y entremezcla la oscuridad y la luz por igual. %dude% está parad%o_dude% allí, observándote, con las sombras cruzándole el pecho de un lado a otro. Cambia el peso de un pie a otro, con una mirada incómoda en el rostro.%SPEECH_ON%¿Con quién estabas hablando?%SPEECH_OFF%Sales de la cama y pones las botas en el suelo; quieres asegurarte de esta realidad antes de atreverte a parlamentar con ella. La tierra cruje bajo tus pies. Respondes.%SPEECH_ON%No estoy seguro. Creo... creo que la invasión ha terminado.%SPEECH_OFF%%Art_dude% mercenari%o_dude% asiente y señala hacia la entrada de la tienda.%SPEECH_ON%Sí, por eso estoy aquí. Un mensajero noble llegó hace apenas un minuto. Dice que los muertos vivientes han dejado de surgir del suelo. Los escribas creen que ha terminado. ¿Está bien, señor?%SPEECH_OFF%Te frotas la cabeza. ¿Es hora de retirarse? ¿Qué puedes hacer de este mundo ahora que sabes lo que sabes? O te vas a vivir en paz el resto de tus días, o mandas todo al diablo y llevas a la %companyname% hacia una gloria aún mayor.\n\n%OOC%Algo arde en lo más hondo de ti. Algo que lucha por liberarse. Quizá sean los éxitos que has cosechado por el camino, o los fracasos que no pudiste evitar a tiempo. ¿Quizá quede más por ver ahí fuera?%OOC_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\crisis\undead_warnings_event.nut
    // context: undead_warnings_event.o.create.s.Text
    {
        // corrige base: «¿Por qué no han estado cerca por un tiempo?» por «Pues hace tiempo que no andan por aquí» (Why they ain't... es una muletilla, no una pregunta) y «animado y distraído en la cabeza hueca» por «animando distraído hacia la cabeza hueca»
        // corrige base: «Aquí no hay nada» por «Aquí no hay una mierda» (Ain't shit here; la 1.0 rebaja la crudeza)
        // corrige base: «Hay pistas» por «Hay rastros» (tracks) y «quedó atado allí» por «se enredó allí» (got tied up, stuck)
        // corrige base: «Estrecha los ojos como si protegiera de los vientos un pasado» por «como si los protegiera de los vientos de un pasado» (son los ojos lo que protege) y «Sí, carne» por «Ya sabes, carne» (You know, flesh)
        // corrige base: «Está en sus manos y rodillas» por «Está a cuatro patas» (calco), «¡Extraño!» por «¡Forastero!» (Stranger) y «quiénes eran, eh, éramos» por «quiénes somos, eh, éramos» (who we are, er, were)
        // corrige base: «cortando brutalmente a todos los enemigos [...] con eficiencia brutal» (redundancia que el inglés no tiene) y «soldados blindados» por «soldados con armadura»
        // corrige base: «Mirando cautelosamente alrededor antes de preguntar» por «Miras con cautela a tu alrededor antes de preguntarle» (oración sin verbo principal)
        // corrige base: «del que hay dos agujeros» por «en el que hay dos agujeros», «hay los restos» por «están los restos» y «cruza sus manos en un rastrillo» por «apoya las manos en una horquilla» (pitchfork)
        // corrige base: «No nos tomamos amablemente las apreciaciones chamanísticas» por «Aquí no nos gustan nada esos augurios de chamán» (calco de We don't take kindly to)
        // corrige base: «¿Excepto que... se llevaron los cuerpos también?» por «Solo que... ¿también se llevaron los cuerpos?» (calco)
        // corrige base: «Marchan hacia ellos un horda» por «Hacia ellas avanza una horda» (errata y concordancia con «huellas»)
        // corrige base: «El %companyname%» y «%companyname%» sin artículo por «la %companyname%» (the %companyname%; unifica el género de la compañía)
        // corrige base: espacios sobrantes tras [img], antes de %SPEECH_ON% y tras %SPEECH_OFF% que el inglés no tiene
        en = "{[img]gfx/ui/events/event_17.png[/img]While stopping for a brief respite, a stranger approaches the camp. He's got a wooden stake for a leg, though he wobbles on it with practiced efficiency. Hobbling to you, he tips a cap of broomstraw.%SPEECH_ON%I suppose you fellas are here for the happenings?%SPEECH_OFF%You glance at %randombrother% then back to the man. He shrugs.%SPEECH_ON%Ah, mayhaps ye don't know. I don't really know, either, but there be a lot of grisly stories about what is happening all around these parts. The way I hear it, the dead are walking the earth, but that's hogwash. I think it's just a bunch of brigands with new tricks up their sleeves. Anyway, be seeing you. Stay safe and all that malarkey.%SPEECH_OFF%The man laughs as he stilts away. | [img]gfx/ui/events/event_97.png[/img]A child is found beside the path with a skull laid between their legs. Its upside down with insects battling one another in the bowl of the brainpan. The kid briefly looks up.%SPEECH_ON%Hi there.%SPEECH_OFF%You ask where his parents are. He picks up a dead bug from the skull, looks at it, then tosses it over his shoulder. He puts another wriggling gladiator into the grey arena then stares at you.%SPEECH_ON%Parents? Why they ain't been around for awhile. Father went to his parents, and mother to hers. And they both was ate'n.%SPEECH_OFF%You raise an eyebrow and ask for him to repeat what he just said, but the kid ignores you, absentmindedly cheering into the hollow head as his bugs do battle. | [img]gfx/ui/events/event_18.png[/img]You come to a man standing in the path. He's got a shovel yoked over both shoulders, his hands crucifixed across each side, and he's dripping with mud. He glances up, this golem of earth, and asks where you're going. Before you answer, he interrupts.%SPEECH_ON%Don't go that way. Don't go no way. They're everywhere. I was digging, you see? Digging to get to them first. But they know. They know where we are. Don't go nowhere, because they're everywhere. Don't go nowhere, because they're everywhere, and they know... they know, don't you see?%SPEECH_OFF%He presses his head forward, his cringing face crooning forth from his dripping arms like some muddied bat come to feast on your dreams. You ease past the man. %randombrother% looks him up and down, shrugs, and follows you. The %companyname% has no time for such madmen. | [img]gfx/ui/events/event_71.png[/img]While on the road, you come to a small, empty hut. %randombrother% snoops around inside, you beside him, the both of you with blades out. He shakes his head.%SPEECH_ON%Ain't shit here.%SPEECH_OFF%He looks up and points.%SPEECH_ON%Except there.%SPEECH_OFF%You look up and see that the ceiling is covered in blood. Not just covered... written over. Unfortunately, the script is hard to read as the crimson words are muddied by mold and termitic erasure.\n\n You mouth the visible letters: DO---GO---IDE---WE---LL---R---OOMED.\n\n Clearly the work of a madman. | [img]gfx/ui/events/event_46.png[/img]There's a copse in the path, a little set of trees that stand tall in an otherwise flat clearing. You take some respite there, for little trees such as these borrow the silence and sereneness from their larger forest cousins. Except not this one. This one you find a dead child in the bushes.\n\n %randombrother% comes up and covers his mouth.%SPEECH_ON%By the might of the old gods, who would do such a thing?%SPEECH_OFF%You take a knee. There are tracks all over the area. It appears the kid was chased and ended up running into the bushes. Probably got tied up there, stuck. More footsteps followed. Way more. They stayed for a while, then left with bloody footprints. The kid, what is left of him, is covered in bite marks. You turn to the mercenary and answer.%SPEECH_ON%I think it's a matter of what, not who. But they're gone. Somewhere yonder, a few days ahead I'd wager, but...%SPEECH_OFF%You count the footsteps, but they prove too many.%SPEECH_ON%I think whatever did this... we'll be seeing it soon.%SPEECH_OFF% | [img]gfx/ui/events/event_76.png[/img]You come to a man standing with a white banner, an unthreaded sigil in the middle, its frayed remains billowing in the wind. He nods.%SPEECH_ON%Good to see some flesh.%SPEECH_OFF%Well, that was not what you were expecting as his first words. Naturally, you inquire as to what he means. He looks incredulous.%SPEECH_ON%You know, flesh. As opposed to bones. I've seen too many of those lately so, yeah, it's nice seeing some flesh.%SPEECH_OFF%You inquire further, asking what kind of bones this man has been seeing. He slims his eyes as if guarding them against the winds of a past he'd prefer to forget.%SPEECH_ON%The walkin' kind. Bones that'll walk through your door in the middle of the night. Bones that kill everything in front of them. Bones that want to see more bones just like them. Them sort of bones, got it?%SPEECH_OFF%His face lightens up, the eyes widening. He pivots toward you and suddenly leans forward.%SPEECH_ON%You wouldn't happen to be made of bones, would you?%SPEECH_OFF%Sensing a threat in the words, %randombrother% jumps in, positioning to kill the man before he can act. You settle everyone down. The stranger appears at ease, but you order the %companyname% to walk around him with care. He doesn't move. He simply stands as the last tendrils of his banner unravel into the wind. | [img]gfx/ui/events/event_40.png[/img]There's a man in the path. He's on his hands and knees with scrolls littered all around. He bounds from one to the other like a dog would a scattering of treats. He shakes his head.%SPEECH_ON%No no no, no! Where is it? Ah! Stranger! I mean, uh, sellsword, er, friend! Friend?%SPEECH_OFF%You ask what the man is doing. His hands are shaking as he answers.%SPEECH_ON%I, uh, have a theory. About who we are, er, were. In the past. Way before today, understand? Of course you do.%SPEECH_OFF%You watch as the man gathers his notes, stuffing them into a satchel. He continues.%SPEECH_ON%I think our past is coming to haunt us again, my dear sir sellsword friend, and when they come, they will kill us all. Because they want it back. They want it ALL back.%SPEECH_OFF%The man throws the satchel over his shoulder and nods.%SPEECH_ON%Now I have others to inform. Thanks for listening and, uh, farewell.%SPEECH_OFF%Well... bye. | [img]gfx/ui/events/event_75.png[/img]While marching, something crunches awkwardly underfoot. You stop and take a knee to see. Swiping away some dirt, you find splintered shards of pottery. They appear to be, or used to be, part of a piece of art. You piece them together until a picture comes into view. %randombrother% stands behind you and asks.%SPEECH_ON%So, what is that?%SPEECH_OFF%You trace a finger along the artwork. Depicted are armored soldiers with spears and behind them more men stand with polearms, their formation as thick as the forests from which they made their weapons. They appear to be marching forward one step at a time, cutting down all the enemies in their path with brutal efficiency.\n\n You try and pick the shards up. A low hum emits from the clay and each piece suddenly turns to powder, the remains streaming between your fingers. Something that old... that peculiar... what is it doing out here in the middle of nowhere? | [img]gfx/ui/events/event_11.png[/img]An odd figure shuffles across the path. You draw your sword and follow, eventually creeping behind a small girl holding an infant. The child wheels around to look at you, the bundled babe in her arms comfortably asleep. You ask what they are doing way out here. The girl shrugs.%SPEECH_ON%Running from the bads.%SPEECH_OFF%You cautiously glance around before asking what she means. She responds as if the answer to the question is tiresomely obvious.%SPEECH_ON%The bads. We buried them good, but they came up bad. Now they're killing everyone. So I run. I run from the bads.%SPEECH_OFF%She peers down at the infant and then out toward the land.%SPEECH_ON%Excuse me, sir. My grandfather lives yonder. He is expecting me and me alone.%SPEECH_OFF%You grab her shoulder and ask where her parents are. She shrugs off your hand.%SPEECH_ON%They're with the bads. Now excuse me, I must get going.%SPEECH_OFF%Clutching the baby, the girl quickly ducks into some brush. Such a little thing, she hardly makes a noise thereafter, and you've little doubt that her safe silence will see her to her destination. | [img]gfx/ui/events/event_91.png[/img]You come to an old woman in the road. She waves you down with one hand while the other clutches her neck. As you get closer, you see that her white hairs are waning, leaving a dome of her skull revealed, and her garish nose wheeze with every breath. Age has been most unkind in all resorts. Her words are expectedly labored.%SPEECH_ON%Have you seen an old man on the roads?%SPEECH_OFF%Shaking your head, you ask what happened to her. She reveals her neck from which there are two holes. A bit of pus flows from each until she covers back up.%SPEECH_ON%My husband and I were attacked last night. I don't know where he is. I think they took him. They tried to take me, but the man attacking me must've smelled something foul because he got but a small taste before running off. Maybe it was my cooking. I always add too much garlic. My husband, he skipped dinner that night, that grouchy fool.%SPEECH_OFF%You put up a hand, slowing her down. You tell her to carefully explain who or what actually attacked. She nods and responds.%SPEECH_ON%Right, it was...%SPEECH_OFF%She pauses and her eyes seem to change attention, as if she blinked without closing a single eyelid. She glances back at you and smiles.%SPEECH_ON%Hello, have you seen an old man on the roads? He's my husband. We were attacked last night and I think they took him...%SPEECH_OFF% | [img]gfx/ui/events/event_16.png[/img]You come to a tiny little town by the side of the path. An insular place where no doubt everyone knows everyone. Outside one of the hovels, there's the charred remains of a bonfire. The sickly black shape of a person is in the ruins. One of the townspeople comes over, tipping their strawhat up while tenting their hands on a pitchfork. He speaks rather cheerily.%SPEECH_ON%That right there is taking care of a problem once and for all.%SPEECH_OFF%Curious, you ask what happened. The man answers earnestly, as if happy to relive the moments.%SPEECH_ON%Well, that there deadened thing you see used to be %randomname%. The man lived yonder from here, in the backend parts of this backend town. He used to do readings, like you know, from bones and blood or some sorry sortition. Fool kept going on and on about how the dead were going to come back and kill us all. We don't take kindly to shamanistic reckonings so we gave him the straight-and-narrow side of what is right and lawful.%SPEECH_OFF%The man spits and nods.%SPEECH_ON%And that was that.%SPEECH_OFF%Almost as if on cue, the bonfire crumbles and the boneshards scatter. A plume of ash and smoke are all that remain. | [img]gfx/ui/events/event_57.png[/img]You come across a graveyard off to the side of the path. The place is a mess. The plots are uncovered and the gravestones overturned and scattered. It is as if a horde of graverobbers descended upon the place and picked it clean. Except... they took the bodies too? %randombrother% stands at your side and shakes his head.%SPEECH_ON%Cannibals?%SPEECH_OFF%This was not the work of cannibals, but you nod for that answer is more calming then what might be the truth: whatever was buried here got up and left on their own two feet... | [img]gfx/ui/events/event_46.png[/img]While marching, you come across an abandoned camp. %randombrother% walks through it and kick over a pan slick with oil. Rotten bacon and eggs spill into the grass. He turns his attention to some bags but comes up empty.\n\n The ground reveals fresh footprints. A clutter of them circle around what was the fire, but there is no dance in their evidence, instead it seems they were frantically rushing to and fro. Marching toward them is a horde of prints, shuffling and dragging their feet with no order. And then, as these two storied prints meet, only the latter continues forward.\n\n %randombrother% pulls back a bush to reveal a dead body. There's a shovel firmly slotted into its skull. The skin of it makes you think the person had been dead for at least two or three weeks - so the footprints are far too fresh for this body to have created them. You've no idea what happened here, but it could not have been good. Going forward, the men of %companyname% should stay sharp for some evil walks these lands.}"
        es = "{[img]gfx/ui/events/event_17.png[/img]Mientras hacen una breve pausa, un extraño se acerca al campamento. Tiene una estaca de madera por pierna, aunque se tambalea sobre ella con eficiencia practicada. Cojeando hacia ti, saluda con una gorra de paja.%SPEECH_ON%Supongo que ustedes están aquí por los acontecimientos, ¿verdad?%SPEECH_OFF%Miras a %randombrother% y luego al hombre. Él encoge los hombros.%SPEECH_ON%Ah, tal vez no lo sepan. Yo tampoco lo sé realmente, pero hay muchas historias horribles sobre lo que está sucediendo por aquí. Según escucho, los muertos están caminando por la tierra, pero eso es tontería. Creo que son solo un montón de bandidos con nuevos trucos bajo la manga. De todos modos, nos veremos. Manténganse a salvo y toda esa palabrería.%SPEECH_OFF%El hombre se ríe mientras se aleja dando tumbos. | [img]gfx/ui/events/event_97.png[/img]Te encuentras a un niño al lado del camino con un cráneo entre las piernas. Está boca abajo, con insectos luchando entre sí en la cavidad del cerebro. El niño levanta la vista un momento.%SPEECH_ON%Hola.%SPEECH_OFF%Le preguntas dónde están sus padres. Recoge un bicho muerto del cráneo, lo mira y luego lo arroja por encima del hombro. Mete a otro gladiador retorciéndose en la arena gris y luego te mira.%SPEECH_ON%¿Padres? Pues hace tiempo que no andan por aquí. Padre se fue con sus padres, y madre con los suyos. Y a los dos se los comieron.%SPEECH_OFF%Alzas una ceja y le pides que repita lo que acaba de decir, pero el niño te ignora y anima distraído hacia la cabeza hueca mientras sus bichos combaten. | [img]gfx/ui/events/event_18.png[/img]Te encuentras con un hombre parado en el camino. Lleva una pala cruzada sobre los hombros, con las manos crucificadas a cada lado, y chorrea barro. Levanta la vista, este gólem de tierra, y te pregunta adónde vas. Antes de que respondas, te interrumpe.%SPEECH_ON%No vayas por ese camino. No vayas a ningún lado. Están en todas partes. Estaba cavando, ¿ves? Cavando para llegar a ellos primero. Pero ellos saben. Saben dónde estamos. No vayas a ningún lugar, porque están en todas partes. No vayas a ningún lugar, porque están en todas partes, y saben... saben, ¿no lo ves?%SPEECH_OFF%Adelanta la cabeza, y su rostro crispado asoma entre sus brazos chorreantes como un murciélago embarrado que viene a darse un festín con tus sueños. Pasas junto al hombre con cuidado. %randombrother% lo mira de arriba abajo, encoge los hombros y te sigue. La %companyname% no tiene tiempo para semejantes locos. | [img]gfx/ui/events/event_71.png[/img]Mientras estás en el camino, llegas a una cabaña pequeña y vacía. %randombrother% husmea dentro, contigo a su lado, los dos con las armas desenvainadas. Niega con la cabeza.%SPEECH_ON%Aquí no hay una mierda.%SPEECH_OFF%Levanta la vista y señala.%SPEECH_ON%Salvo ahí.%SPEECH_OFF%Miras hacia arriba y ves que el techo está cubierto de sangre. No solo cubierto... escrito. Por desgracia, el texto es difícil de leer, ya que las palabras carmesí están emborronadas por el moho y la erosión de las termitas.\n\n Murmuras las letras visibles: NO---ENTR---DENT---ES---TAM---CO---ND---ADOS.\n\n Claramente obra de un loco. | [img]gfx/ui/events/event_46.png[/img]Hay un bosquecillo junto al camino, un pequeño grupo de árboles altos en un claro por lo demás llano. Te tomas allí un respiro, pues los arbolillos como estos toman prestados el silencio y la serenidad de sus primos más grandes del bosque. Salvo este. En este encuentras a un niño muerto entre los arbustos.\n\n %randombrother% se acerca y se tapa la boca.%SPEECH_ON%Por el poder de los dioses antiguos, ¿quién haría algo así?%SPEECH_OFF%Te arrodillas. Hay rastros por toda la zona. Parece que persiguieron al niño y que terminó metiéndose entre los arbustos. Seguramente se enredó allí y quedó atrapado. Lo siguieron más pasos. Muchos más. Se quedaron un rato y luego se marcharon dejando huellas de sangre. El niño, o lo que queda de él, está cubierto de mordeduras. Te vuelves hacia el mercenario y respondes.%SPEECH_ON%Creo que es cuestión de qué, no de quién. Pero ya se han ido. A algún lugar más allá, unos días por delante, diría yo, pero...%SPEECH_OFF%Cuentas las pisadas, pero resultan ser demasiadas.%SPEECH_ON%Creo que sea lo que sea que hizo esto... lo veremos pronto.%SPEECH_OFF% | [img]gfx/ui/events/event_76.png[/img]Te encuentras con un hombre de pie con una bandera blanca, con un emblema descosido en el centro cuyos restos deshilachados ondean al viento. Asiente.%SPEECH_ON%Qué bueno ver algo de carne.%SPEECH_OFF%Bueno, eso no era lo que esperabas como primeras palabras. Naturalmente, le preguntas a qué se refiere. Parece incrédulo.%SPEECH_ON%Ya sabes, carne. En contraposición a los huesos. He visto demasiados de esos últimamente, así que, sí, es agradable ver algo de carne.%SPEECH_OFF%Indagas más y le preguntas qué clase de huesos ha estado viendo. Entorna los ojos como si los protegiera de los vientos de un pasado que preferiría olvidar.%SPEECH_ON%De los que caminan. Huesos que entran por tu puerta en mitad de la noche. Huesos que matan todo lo que tienen delante. Huesos que quieren ver más huesos como ellos. Ese tipo de huesos, ¿entiendes?%SPEECH_OFF%Se le ilumina la cara y abre mucho los ojos. Gira hacia ti y de repente se inclina hacia delante.%SPEECH_ON%No estarás hecho de huesos, ¿verdad?%SPEECH_OFF%Al detectar una amenaza en sus palabras, %randombrother% interviene y se coloca para matar al hombre antes de que pueda actuar. Calmas a todos. El desconocido parece tranquilo, pero ordenas a la %companyname% que lo rodee con cuidado. No se mueve. Simplemente se queda de pie mientras los últimos jirones de su bandera se deshacen en el viento. | [img]gfx/ui/events/event_40.png[/img]Hay un hombre en el camino. Está a cuatro patas, con pergaminos esparcidos por todas partes. Salta de uno a otro como lo haría un perro entre golosinas desperdigadas. Niega con la cabeza.%SPEECH_ON%¡No, no, no, no! ¿Dónde está? ¡Ah! ¡Forastero! Digo, eh, mercenario, esto, ¡amigo! ¿Amigo?%SPEECH_OFF%Le preguntas qué está haciendo. Le tiemblan las manos al responder.%SPEECH_ON%Tengo, eh, una teoría. Sobre quiénes somos, eh, éramos. En el pasado. Mucho antes de hoy, ¿entiendes? Claro que sí.%SPEECH_OFF%Observas cómo el hombre recoge sus notas y las mete en una bolsa. Continúa.%SPEECH_ON%Creo que nuestro pasado vuelve a atormentarnos, mi querido señor amigo mercenario, y cuando vengan, nos matarán a todos. Porque lo quieren de vuelta. Lo quieren TODO de vuelta.%SPEECH_OFF%El hombre se echa la bolsa al hombro y asiente.%SPEECH_ON%Ahora tengo que avisar a otros. Gracias por escuchar y, eh, adiós.%SPEECH_OFF%Bueno... adiós. | [img]gfx/ui/events/event_75.png[/img]Mientras marchas, algo cruje torpemente bajo tus pies. Te detienes y te arrodillas para ver. Apartas algo de tierra y encuentras fragmentos astillados de cerámica. Parecen ser, o haber sido, parte de una obra de arte. Los unes hasta que aparece una imagen. %randombrother% se pone detrás de ti y pregunta.%SPEECH_ON%Entonces, ¿qué es eso?%SPEECH_OFF%Recorres la obra con un dedo. Representa a soldados con armadura y lanzas y, detrás de ellos, más hombres con armas de asta, en una formación tan densa como los bosques de los que sacaron sus armas. Parecen avanzar paso a paso, abatiendo a todos los enemigos que encuentran con una eficiencia brutal.\n\n Intentas recoger los fragmentos. Un zumbido grave emana de la arcilla y cada pieza se convierte de repente en polvo, y los restos se escurren entre tus dedos. Algo tan antiguo... tan peculiar... ¿qué hace aquí, en medio de la nada? | [img]gfx/ui/events/event_11.png[/img]Una figura extraña cruza el camino arrastrando los pies. Sacas la espada y la sigues hasta acabar acechando detrás de una niña pequeña que sostiene a un bebé. La niña se da la vuelta para mirarte; el bebé, envuelto en sus brazos, duerme plácidamente. Le preguntas qué hacen tan lejos de todo. La niña encoge los hombros.%SPEECH_ON%Huyendo de los malos.%SPEECH_OFF%Miras con cautela a tu alrededor antes de preguntarle qué quiere decir. Responde como si la respuesta fuera de una obviedad agotadora.%SPEECH_ON%Los malos. Los enterramos buenos, pero salieron malos. Ahora están matando a todos. Así que huyo. Huyo de los malos.%SPEECH_OFF%Mira al bebé y luego hacia el horizonte.%SPEECH_ON%Perdóneme, señor. Mi abuelo vive allá. Me espera a mí y solo a mí.%SPEECH_OFF%La agarras del hombro y le preguntas dónde están sus padres. Se zafa de tu mano.%SPEECH_ON%Están con los malos. Ahora, discúlpeme, tengo que irme.%SPEECH_OFF%Apretando al bebé, la niña se mete rápidamente entre unos matorrales. Tan pequeña, apenas hace ruido después, y no te cabe duda de que su silencio la llevará a salvo hasta su destino. | [img]gfx/ui/events/event_91.png[/img]Te encuentras con una anciana en el camino. Te hace señas con una mano mientras con la otra se agarra el cuello. Al acercarte, ves que su pelo blanco escasea, dejando al descubierto la cúpula del cráneo, y que su nariz chillona silba con cada respiración. La edad ha sido de lo más cruel en todos los aspectos. Como era de esperar, le cuesta hablar.%SPEECH_ON%¿Has visto a un anciano por los caminos?%SPEECH_OFF%Niegas con la cabeza y le preguntas qué le ha pasado. Te muestra el cuello, en el que hay dos agujeros. De cada uno mana un poco de pus hasta que vuelve a taparse.%SPEECH_ON%A mi esposo y a mí nos atacaron anoche. No sé dónde está. Creo que se lo llevaron. Intentaron llevarme a mí, pero el hombre que me atacó debió de oler algo asqueroso, porque solo me probó un poco antes de salir corriendo. Quizá fue mi comida. Siempre le echo demasiado ajo. Mi esposo se saltó la cena esa noche, el muy cascarrabias.%SPEECH_OFF%Levantas una mano para que vaya más despacio. Le pides que explique con calma quién o qué la atacó en realidad. Asiente y responde.%SPEECH_ON%Claro, fue...%SPEECH_OFF%Se detiene y su mirada parece cambiar de foco, como si hubiera parpadeado sin cerrar un solo párpado. Vuelve a mirarte y sonríe.%SPEECH_ON%Hola, ¿has visto a un anciano por los caminos? Es mi esposo. Nos atacaron anoche y creo que se lo llevaron...%SPEECH_OFF% | [img]gfx/ui/events/event_16.png[/img]Llegas a un pueblito a un lado del camino. Un lugar cerrado en el que sin duda todos se conocen. Frente a una de las chozas están los restos carbonizados de una hoguera. Entre ellos se ve la enfermiza silueta negra de una persona. Uno de los lugareños se acerca, se echa hacia atrás el sombrero de paja y apoya las manos en una horquilla. Habla con bastante alegría.%SPEECH_ON%Eso de ahí es ocuparse de un problema de una vez por todas.%SPEECH_OFF%Con curiosidad, preguntas qué pasó. El hombre responde con sinceridad, como si le alegrara revivir el momento.%SPEECH_ON%Bueno, esa cosa muerta que ves ahí era %randomname%. Vivía más allá, en lo más perdido de este pueblo perdido. Hacía lecturas, ya sabes, de huesos y sangre o alguna adivinación de esas de pena. El muy tonto no paraba de decir que los muertos iban a volver y nos iban a matar a todos. Aquí no nos gustan nada esos augurios de chamán, así que le enseñamos el camino recto de lo que es justo y legal.%SPEECH_OFF%El hombre escupe y asiente.%SPEECH_ON%Y se acabó.%SPEECH_OFF%Casi como si fuera su señal, la hoguera se desmorona y las astillas de hueso se dispersan. Solo queda una columna de ceniza y humo. | [img]gfx/ui/events/event_57.png[/img]Te encuentras con un cementerio a un lado del camino. El lugar es un desastre. Las tumbas están abiertas y las lápidas volcadas y desperdigadas. Es como si una horda de saqueadores de tumbas hubiera caído sobre el lugar y lo hubiera dejado limpio. Solo que... ¿también se llevaron los cuerpos? %randombrother% se pone a tu lado y niega con la cabeza.%SPEECH_ON%¿Caníbales?%SPEECH_OFF%Esto no es obra de caníbales, pero asientes, porque esa respuesta es más tranquilizadora que lo que podría ser la verdad: lo que sea que estuviera enterrado aquí se levantó y se marchó por su propio pie... | [img]gfx/ui/events/event_46.png[/img]Mientras marchan, te encuentras con un campamento abandonado. %randombrother% camina por él y patea una sartén untada de aceite. El tocino podrido y los huevos se derraman en la hierba. Luego dirige su atención a unas bolsas, pero no encuentra nada.\n\n El suelo revela huellas frescas. Un montón de ellas rodea lo que fue la hoguera, pero no indican ninguna danza: más bien parece que corrían frenéticamente de un lado a otro. Hacia ellas avanza una horda de huellas que arrastran los pies sin orden alguno. Y entonces, donde se encuentran estas dos historias de huellas, solo las segundas siguen adelante.\n\n %randombrother% aparta un arbusto y deja al descubierto un cadáver. Tiene una pala firmemente clavada en el cráneo. Por el aspecto de la piel, dirías que la persona llevaba muerta al menos dos o tres semanas, así que las huellas son demasiado frescas para que las haya dejado este cuerpo. No tienes ni idea de lo que pasó aquí, pero no pudo ser nada bueno. De ahora en adelante, los hombres de la %companyname% deben estar alerta, porque algún mal recorre estas tierras.}"
    }
    // FILE: mod_legends\hooks\events\events\cultist_finale_event.nut
    // en = "Sacrificed to Davkul"
    // en base_es
    // en = "<actor:str_tag> has died"
    // en base_es
    // en = "A grisly aspect of Davkul, an ancient power not from this world, and the last remnants of <sacrifice:str> from whose body it has been fashioned. It shall never break, but instead keep regrowing its scarred skin on the spot."
    // en base_es
    // en = "You gain the <item:str>"
    // en base_es
    // en = "Appeased Davkul"
    // en base_es
    // en = "Horrified by the death of <sacrifice:str>"
    // en base_es
    // en = "Was denied the chance to appease Davkul"
    // en base_es
    // FILE: mod_legends\hooks\events\events\cultist_vs_old_gods_event.nut
    // context: cultist_vs_old_gods_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_06.png[/img] You step off to the side, letting the mercenaries hash out their differences as folk with great differences do. Fists for arguments, the follower of the old gods makes a case, battering the cultist again and again. But the sellsword with the scarred head only grins in return. Eyes puffing up, the lids purpled and puckering over eyes. Yet, still, the grin, and there is bloody laughter spewing out of a reddened mouth.%SPEECH_ON%Such darkness! Davkul is most pleased!%SPEECH_OFF%With an anxious look, %oldgods% steps off %cultist% and backs away. Rubbing his bloodied knuckles, realizing a few may have broken in the seemingly one-sided scuffle. But it's the cultist's words that hurt most of all.%SPEECH_ON%Man isn't tempted by the darkness, he is called to it! Lost without it! Gleeful in its return!%SPEECH_OFF%Almost afraid to look back, %oldgods% hurries away as the cultist remains behind, laughing and chuckling on the grass, nobody daring to get near."
        es = "[img]gfx/ui/events/event_06.png[/img] Te haces a un lado y dejas que los mercenarios zanjen sus diferencias como lo hace la gente con grandes diferencias. Con los puños por argumentos, quien sigue a los viejos dioses defiende su postura golpeando una y otra vez a su rival. Pero quien lleva la cabeza llena de cicatrices se limita a devolverle una sonrisa. Se le hinchan los ojos, con los párpados amoratados y abultados sobre ellos. Y aun así sigue la sonrisa, y de una boca enrojecida brota una risa sangrienta.%SPEECH_ON%¡Cuánta oscuridad! ¡Davkul está muy complacido!%SPEECH_OFF%Con una mirada inquieta, %oldgods% se quita de encima de %cultist% y retrocede, frotándose los nudillos ensangrentados y dándose cuenta de que quizá se haya roto alguno en una pelea en apariencia tan desigual. Pero son las palabras de su rival lo que más duele.%SPEECH_ON%¡El hombre no cae tentado por la oscuridad, sino que es llamado a ella! ¡Se pierde sin ella! ¡Se regocija cuando vuelve!%SPEECH_OFF%Casi con miedo de mirar atrás, %oldgods% se aleja a toda prisa, mientras a sus espaldas siguen las risas y las carcajadas sobre la hierba, sin que nadie se atreva a acercarse."
    }
    // context: cultist_vs_old_gods_event.o.create.s.Options[0].Text
    {
        en = "I didn't know %oldgods% could get so angry."
        es = "No sabía que %oldgods% pudiera perder así los estribos."
    }
    // context: cultist_vs_old_gods_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_03.png[/img] The way things are going, you've hardly a mercenary to spare. Just as fists are about to start flying, you step in between the two and put an end to it. You tell %oldgods% they are better than this, and you tell %cultist% nothing, for the cultist is almost bowled over in fits of laughter. Pointing, grinning madly.%SPEECH_ON%The light steps in, but darkness is patient. Davkul awaits you all.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_03.png[/img] Tal como van las cosas, apenas te sobra un mercenario. Justo cuando los puños están a punto de volar, te interpones entre ambos y pones fin al asunto. Le dices a %oldgods% que vale más que esto, y a %cultist% no le dices nada, porque apenas se tiene en pie entre ataques de risa, señalando con una sonrisa demente.%SPEECH_ON%La luz se interpone, pero la oscuridad es paciente. Davkul los espera a todos.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\cultist_vs_uneducated_event.nut
    // context: cultist_vs_uneducated_event.o.create.s.start
    {
        // _event.m.Uneducated.getBackground().m.RawDescription += " " + _event.m.Cultist.getName() + " helped " + _event.m.Uneducated.getName() + " see the darkness.";
        mode = "pattern"
        en = " <cultist:str> helped <uneducated:str> see the darkness."
        es = " <cultist> ayudó a <uneducated> a ver la oscuridad."
    }
    // en = "<uneducated:str> has been converted to a Cultist"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Resolve"
    // en base_es
    // FILE: mod_legends\hooks\events\events\dastard_loses_trait_event.nut
    // context: dastard_loses_trait_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_58.png[/img]You come across %braveman1% and %braveman2% sitting with %dastard%. The two mercenaries are pepping up the rather skittish %sibling_dastard%, letting %them_dastard% know that there is nothing to fear in battle. %dastard% explains that %they_dastard% is fearful of a painful death. %braveman1% says %they_braveman1% has seen many people die and by the sword, truly, is one of the fastest. %braveman2% raises %their_braveman2% hand.%SPEECH_ON%Unless it gets you in the stomach.%SPEECH_OFF%%braveman1% nods.%SPEECH_ON%Right. But other than that, you have nothing to fear!%SPEECH_OFF%";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_58.png[/img]You come across %braveman1% and %braveman2% sitting with %dastard%. The two mercenaries are pepping up the rather skittish %sibling_dastard%, letting %them_dastard% know that there is nothing to fear in battle. %dastard% explains that %they_dastard% is fearful of a painful death. %braveman1% says %they_braveman1% has seen many people die and by the sword, truly, is one of the fastest. %braveman2% raises %their_braveman2% hand.%SPEECH_ON%Unless it gets you in the stomach.%SPEECH_OFF%%braveman1% nods.%SPEECH_ON%Right. But other than that, you have nothing to fear!%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_58.png[/img]Te encuentras con %braveman1% y %braveman2%, que se han sentado con %dastard%. Están levantándole el ánimo %al_dastard% asustadiz%o_dastard% herman%o_dastard%, haciéndole ver que no hay nada que temer en la batalla. %dastard% explica que teme una muerte dolorosa. %braveman1% dice que ha visto morir a mucha gente y que morir por la espada es, de verdad, de las formas más rápidas. %braveman2% levanta la mano.%SPEECH_ON%Salvo que te alcance en el estómago.%SPEECH_OFF%%braveman1% asiente.%SPEECH_ON%Cierto. Pero aparte de eso, ¡no tienes nada que temer!%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\dead_lumberjack_event.nut
    // context: dead_lumberjack_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_25.png[/img]The forest is home to many curiosities and dead bodies, really, aren't even the most curious of those. So when you stumble upon a litter of dead lumberjacks the only thing that piques your interest is the lump of a direwolf slain beside them. %randombrother% eyes the tracks going back and forth across a cutting field so abruptly interrupted that some axes were left hewn into tree trunks. %They_randombrother% spits and nods.%SPEECH_ON%Poor fellas. Looks like some direwolves bushwhacked them something fierce.%SPEECH_OFF%You have the men collect what's left to be recovered and make your leave."
        es = "[img]gfx/ui/events/event_25.png[/img]El bosque alberga muchas curiosidades y, en realidad, los cadáveres ni siquiera son las más curiosas. Así que cuando te topas con un reguero de leñadores muertos, lo único que despierta tu interés es el bulto de un lobo huargo abatido junto a ellos. %randombrother% observa las huellas que van y vienen por un claro de tala interrumpido tan de golpe que algunas hachas se quedaron clavadas en los troncos. Escupe y asiente.%SPEECH_ON%Pobres diablos. Parece que unos lobos huargo los emboscaron con saña.%SPEECH_OFF%Haces que los hombres recojan lo que queda por recuperar y te marchas."
    }
    // FILE: mod_legends\hooks\events\events\deserter_in_forest_event.nut
    // context: deserter_in_forest_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_25.png[/img]While trundling through the forest, birds suddenly scatter into the sky, shaking the trees and branches with the very frightful urgency of their leaving. Not a moment later does a figure come barreling through a bush, looking more flash flood than flesh and blood. The frightened human seizes up, this dirty earthen golem, and begs you for a place to hide.%SPEECH_ON%Look, I'll be perfectly honest. I'm a deserter. That's that. I didn't, I mean, alright I don't really have a defense. But look, what are you? Mercenaries? Great! Hide me and I'll fight for you to the end of time!%SPEECH_OFF%Halfway through the pleading spiel, you hear dogs barking in the distance. The deserter instinctively hides away into an arboreal cubby, quickly covering over with dirt. The dirt pile nods as if to say you've already come to an agreement.\n\n Bounty hunters come through the tree line, their dogs already sniffing around. Their lieutenant looks around.%SPEECH_ON%Don't even try to fool me, sellsword. I know that deserter came this way. Two hundred crowns for the head. Where is the wretch?%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_25.png[/img]Mientras avanzas a duras penas por el bosque, de repente las aves alzan el vuelo, sacudiendo árboles y ramas con la urgencia aterrada de su huida. Un instante después, una figura irrumpe a través de un arbusto, más parecida a una riada de lodo que a un ser de carne y hueso. Presa del pánico, este sucio gólem de tierra se detiene en seco y te ruega un sitio donde esconderse.%SPEECH_ON%Mira, te diré la verdad sin rodeos. Deserté. Eso es todo. No... o sea, bueno, la verdad es que no tengo defensa. Pero mira, ¿qué son ustedes? ¿Mercenarios? ¡Genial! ¡Escóndanme y pelearé por ustedes hasta el fin de los tiempos!%SPEECH_OFF%A mitad de la perorata suplicante, oyes perros ladrando a lo lejos. Por instinto, se esconde en un hueco entre los árboles y se cubre rápidamente de tierra. El montón de tierra asiente, como diciendo que ya tienen un trato.\n\n Varios cazarrecompensas salen de entre los árboles, con los perros ya olfateando por todas partes. Su teniente echa un vistazo alrededor.%SPEECH_ON%Ni se te ocurra intentar engañarme, mercenario. Sé que quien desertó vino por aquí. Doscientas coronas por esa cabeza. ¿Dónde se esconde esa escoria?%SPEECH_OFF%"
    }
    // context: deserter_in_forest_event.o.create.s.Options[0].Text
    {
        en = "Right there."
        es = "Ahí mismo."
    }
    // context: deserter_in_forest_event.o.create.s.start._event.m.Dude.getBackground().m.RawDescription
    {
        en = "You found %name% the deserter being chased through the forest. Though bounty hunters were hot on the trail, you elected to defend the fugitive and for that swore an oath to you."
        es = "Encontraste a %name%, que había desertado, mientras le daban caza por el bosque. Aunque los cazarrecompensas le pisaban los talones, decidiste dar protección a quien huía y, por ello, te juró lealtad."
    }
    // context: deserter_in_forest_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_25.png[/img]You nod to where the deserter is hiding, who must have kept one distrusting eye on you because the mess of dirt immediately jumps out of the hole and goes fleeing. The dogs run the deserter down with ease, glomming on with caninal ferocity and dragging the screaming ass to the ground. Before you can even so much as laugh, the bounty hunter puts a bag of crowns into your palm.%SPEECH_ON%That's half my cut, but without the happenstance of your being here, I'm not sure we would have caught that wily dastard.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_25.png[/img]Señalas con la cabeza el escondite y, como debía de estar vigilándote con desconfianza, el montón de tierra salta al instante fuera del agujero y echa a correr. Los perros le dan alcance sin esfuerzo, se le echan encima con ferocidad canina y arrastran al suelo a ese saco de mierda que no para de chillar. Antes de que puedas siquiera reírte, el cazarrecompensas te pone una bolsa de coronas en la palma.%SPEECH_ON%Es la mitad de mi parte, pero sin la casualidad de que estuvieras aquí, no sé si habríamos atrapado a esa sabandija escurridiza.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\disowned_noble_reminisces_event.nut
    // context: disowned_noble_reminisces_event.o.create.s.Text
    {
        // corrige base: "Riéndote, aceptas un poco de su bebida, que tomas" cambia el sujeto (quien ríe y ofrece es el noble) y es redundante; "desterrado" debe ser "desheredado" (disowned), como en el resto del evento.
        en = "[img]gfx/ui/events/event_26.png[/img]You find %disowned% sitting by %themselves_disowned% outside the camp. As the jeers and cheers of the mercenaries around the campfire crackle behind you, you approach the %person_disowned% and ask what %they_disowned%'s sulking for. %They_disowned% shrugs.%SPEECH_ON%Not sulking, sir, just thinking. Though I suppose one could be easily mistaken for the other.%SPEECH_OFF%Chuckling, %they_disowned% offers a bit of %their_disowned% drink, which you take. Settling down beside %them_disowned%, you ask what it is %they_disowned% is 'thinking' about. The disowned noble%person_disowned% shrugs again.%SPEECH_ON%Ahh, nothing really. Just thinking about home. I'm a long ways away from it now, and the last I remember of it isn't exactly the best, yet I still find myself wishing to be there now and again. Homesick for a land that thinks me a sort of noble sickness, go figure.%SPEECH_OFF%You hand %them_disowned% back to %their_disowned% drink as %they_disowned% probably needs it more than you. While you're still clearheaded, you try and speak your mind..."
        es = "[img]gfx/ui/events/event_26.png[/img]Encuentras a %disowned% sentad%o_disowned% a solas fuera del campamento. Mientras las burlas y los vítores de los mercenarios alrededor de la fogata crepitan a tus espaldas, te acercas y le preguntas por qué está enfurruñad%o_disowned%. Se encoge de hombros.%SPEECH_ON%No estoy enfurruñad%o_disowned%, señor, solo pensando. Aunque supongo que es fácil confundir una cosa con la otra.%SPEECH_OFF%Riendo por lo bajo, te ofrece un poco de su bebida, y la aceptas. Te sientas a su lado y le preguntas en qué está 'pensando'. %Art_disowned% noble desheredad%o_disowned% vuelve a encogerse de hombros.%SPEECH_ON%Ah, en nada, la verdad. Solo pienso en casa. Ahora estoy muy lejos de ella, y lo último que recuerdo no es precisamente lo mejor, pero aun así de vez en cuando me sorprendo deseando estar allí. Añoro una tierra que me tiene por una especie de enfermedad noble, figúrate.%SPEECH_OFF%Le devuelves la bebida, ya que probablemente la necesita más que tú. Mientras aún tienes la cabeza despejada, intentas decirle lo que piensas..."
    }
    // context: disowned_noble_reminisces_event.o.create.s.Text
    {
        // corrige base: añade "Tus hermanos de", que el inglés no tiene; es la compañía la que cuida de él.
        en = "[img]gfx/ui/events/event_26.png[/img]You speak.%SPEECH_ON%Where you're from is a house, not a home. You yearn for a different place in a different time, when you're in this place, right here, right now. The %companyname% looks after you, and you it, and only together will we persevere.%SPEECH_OFF%The %person_disowned% stares into %their_disowned% drink for a time. %They_disowned% chuckles, sips, and wipes the froth away.%SPEECH_ON%Yeah, I suppose that's one way to look at it. Thank you, captain.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_26.png[/img]Hablas.%SPEECH_ON%De donde vienes hay una casa, no un hogar. Anhelas otro lugar en otro tiempo, cuando estás en este lugar, aquí mismo, ahora mismo. %companyname% vela por ti, y tú por ella, y solo juntos saldremos adelante.%SPEECH_OFF%%Art_disowned% %hombre_disowned% contempla su bebida durante un rato. Ríe por lo bajo, da un sorbo y se limpia la espuma.%SPEECH_ON%Sí, supongo que es una forma de verlo. Gracias, capitán.%SPEECH_OFF%"
    }
    // context: disowned_noble_reminisces_event.o.create.s.Text
    {
        // corrige base: "la chimenea encendida, humo saliendo por la chimenea" repite término; "hearth" es el hogar (el fuego), no la chimenea. "recordarlos" remite a los hermanos que la 1.0 había añadido; el inglés habla de la compañía.
        en = "[img]gfx/ui/events/event_26.png[/img]You clap the %person_disowned% on %their_disowned% shoulder and speak.%SPEECH_ON%Hey, thinking of the old is good for the soul, even if it's through a thicket of shit and cruelty and evil and all else that makes any %person_disowned% stay up at night. But it's only good for a time. You look at the past, you acknowledge it, and then you move on. You have to be sure to only visit the past, not dwell in it. Everyone here has a past, %disowned%, and in that respect you will never be alone.%SPEECH_OFF%The disowned noble%person_disowned% stares at the ground for a time. %They_disowned% slowly starts to nod.%SPEECH_ON%Yeah, yeah, that's right. I guess a part of me was worried that I was genuinely wanting to return there. I was picturing it with the hearth alight, smoke out of the chimney, soft candlelight beyond the windows, and my family there awaiting me. I was ignoring the locked door, the guard dogs squatting outside, and those I love telling me to never come back lest it's in a box to bury far beneath the earth. I wasn't thinking of my past so much as dreaming of it, and I think you've helped me realize that, captain. Thank you. I know that, one day, I shan't have to dream about the %companyname%, but instead remember it clearly and fondly.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_26.png[/img]Le das una palmada en el hombro y hablas.%SPEECH_ON%Oye, pensar en lo de antes es bueno para el alma, aunque haya que atravesar un matorral de mierda, crueldad, maldad y todo lo demás que le quita el sueño a cualquiera. Pero solo es bueno durante un tiempo. Miras el pasado, lo reconoces y sigues adelante. Tienes que asegurarte de solo visitar el pasado, no quedarte a vivir en él. Todos aquí tienen un pasado, %disowned%, y en ese sentido nunca estarás sol%o_disowned%.%SPEECH_OFF%%Art_disowned% noble desheredad%o_disowned% se queda mirando el suelo un rato. Poco a poco empieza a asentir.%SPEECH_ON%Sí, sí, es cierto. Supongo que una parte de mí temía querer volver de verdad. Me lo imaginaba con el hogar encendido, humo saliendo de la chimenea, la suave luz de las velas tras las ventanas y mi familia allí esperándome. Pasaba por alto la puerta cerrada con llave, los perros guardianes agazapados fuera y a quienes amo diciéndome que no vuelva nunca, salvo en una caja para enterrarla bien hondo. No estaba pensando en mi pasado tanto como soñándolo, y creo que me has ayudado a darme cuenta, capitán. Gracias. Sé que un día no tendré que soñar con %companyname%, sino recordarla con claridad y cariño.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\addict_steals_potion_event.nut
    // context: addict_steals_potion_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]{You go to check the inventory only to find %addict% splayed half-assed into a barrel, all four limbs hanging over the lip. There's a number of vials collected onto %their_addict% belly. %They_addict% stares at you with dim, reddened eyes, and the sockets holding them are purple as though all the blood had rushed there. You ask what the hell is going on and %addict% only smiles.%SPEECH_ON%Do, uh, do what you must. Er, captain. For I have already won.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_05.png[/img]{Vas a revisar el inventario y te encuentras a %addict% despatarrad%o_addict% de mala manera dentro de un barril, con las cuatro extremidades colgando por el borde. Tiene varios frascos amontonados sobre la barriga. Te mira con ojos apagados y enrojecidos, y las cuencas que los rodean están moradas, como si toda la sangre se le hubiera agolpado allí. Le preguntas qué demonios está pasando y %addict% se limita a sonreír.%SPEECH_ON%Haz, eh, haz lo que tengas que hacer. Esto, capitán. Porque yo ya he ganado.%SPEECH_OFF%}"
    }
    // context: addict_steals_potion_event.o.create.::Legends.Screens.hook()._screen.Options.Text
    {
        en = "I just hope you'll heal in time. (Morals reputation increased)"
        es = "Solo espero que te recuperes con el tiempo. (Aumenta la reputación moral)"
    }
    // en = "This needs to stop now, %addict%."
    // en base_es
    // context: addict_steals_potion_event.o.create.::Legends.Screens.hook()._screen.Options.Text
    {
        // corrige base: omite "whipped" (a latigazos), que es lo que anuncia la opción.
        en = "Enough. I'll have this bloody demon whipped out of you! (Moral reputation decreased)"
        es = "Basta. ¡Haré que te saquen este maldito demonio a latigazos! (Disminuye la reputación moral)"
    }
    // context: addict_steals_potion_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_38.png[/img]{You have %addict% taken to an ad-hoc whipping post. %They_addict% lays limply against the wood, %their_addict% fingers splayed out and pinching and clenching. %They_addict% looks like %they're_addict% chasing butterflies, and %they_addict% carries that absent look when %otherbrother% hides %them_addict% fierce with the whip.\n\n At first, the whipping does nothing, not even as it snaps across the %person_addict%'s back, leaving crescents of crimson. But after a few strikes, %they_addict% wakes to reality and begins to scream. You come around to face %them_addict% and ask if %they_addict%'ll swallow %their_addict% addiction. %They_addict% nods hurriedly. You let %them_addict% get whipped again, and ask again, and again %they_addict% nods. Another whipping, another question, another answer. So this goes, until %they_addict% is broken and whatever ailed %them_addict% is gone.}"
        es = "[img]gfx/ui/events/event_38.png[/img]{Haces que lleven a %addict% a un poste de flagelación improvisado. Se queda desplomad%o_addict% contra la madera, con los dedos abiertos, pellizcando y apretando el aire. Parece estar persiguiendo mariposas, y mantiene esa mirada ausente mientras %otherbrother% %lo_addict% azota con saña.\n\n Al principio, los latigazos no surten ningún efecto, ni siquiera cuando restallan sobre la espalda %del_addict% %hombre_addict% y dejan medias lunas carmesí. Pero tras unos cuantos golpes, despierta a la realidad y empieza a gritar. Te pones frente a %el_addict% y le preguntas si va a tragarse su adicción. Asiente apresuradamente. Dejas que %lo_addict% azoten otra vez, vuelves a preguntar y de nuevo asiente. Otro azote, otra pregunta, otra respuesta. Y así sigue la cosa, hasta que queda quebrad%o_addict% y lo que fuera que %lo_addict% aquejaba desaparece.}"
    }
    // context: addict_steals_potion_event.o.create.::Legends.Screens.hook()._screen.Options[0].Text
    {
        en = "Get %them_addict% out of my sight."
        es = "Quítenmel%o_addict% de la vista."
    }
    // context: addict_steals_potion_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]{You pull %addict% out of the barrel and throw %them_addict% to the ground. %They_addict% wobbles there as though the earth was a staircase and %they_addict% was looking down the top step's precipice.%SPEECH_ON%Oy, sir, careful, it's just down and down!%SPEECH_OFF%At first you think to kick %their_addict% arse, but relent. You crouch and set down next to the %person_addict% as %they_addict% rolls over to stare at the clouds. Time passes, and after a while %addict% purses %their_addict% lips and you can see clarity has returned to %their_addict% eyes.%SPEECH_ON%I got a problem, sir.%SPEECH_OFF%You nod and tell %them_addict% to ease up on the potions, that you can't trust %them_addict% in this state. If %they're_addict% got a problem with being a sellsword, if that's why %they're_addict% like this, then that's okay, but it is a problem. %They_addict% purses %their_addict% lips again and nods.%SPEECH_ON%Thank you, sir. I'll do my best to unfark myself and set things straight.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_05.png[/img]{Sacas a %addict% del barril y %lo_addict% tiras al suelo. Se tambalea allí como si la tierra fuera una escalera y estuviera asomándose al precipicio desde el escalón de arriba.%SPEECH_ON%¡Eh, señor, cuidado, que esto no para de bajar y bajar!%SPEECH_OFF%Al principio piensas en darle una patada en el culo, pero te contienes. Te agachas y te sientas junto %al_addict% %hombre_addict% mientras se da la vuelta para mirar las nubes. Pasa el tiempo y, al cabo de un rato, %addict% aprieta los labios y ves que la lucidez ha vuelto a sus ojos.%SPEECH_ON%Tengo un problema, señor.%SPEECH_OFF%Asientes y le dices que afloje con las pociones, que no puedes fiarte de %el_addict% en este estado. Si tiene un problema con ser mercenari%o_addict%, si es por eso que está así, no pasa nada, pero es un problema. Vuelve a apretar los labios y asiente.%SPEECH_ON%Gracias, señor. Haré lo que pueda para sacarme de esta mierda y poner las cosas en orden.%SPEECH_OFF%}"
    }
    // context: addict_steals_potion_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "Ese gordo imbécil va a ser inteligente conmigo" rebaja "sumbitch" y calca "be smart with me" (hacerse el listo); además tiene los signos de exclamación descuadrados.
        en = "[img]gfx/ui/events/event_05.png[/img]{You pull %addict% out of the barrel and throw %them_addict% to the ground. %They_addict% wobbles there as though the earth was a staircase and %they_addict% was looking down the top step's precipice.%SPEECH_ON%Oy, sir, careful, it's just down and down!%SPEECH_OFF%At first you think to kick %their_addict% arse, but relent. You crouch and set down next to the %person_addict% as %they_addict% rolls over to stare at the clouds. After a while %they_addict% looks over.%SPEECH_ON%You trying to help me?%SPEECH_OFF%You nod and say you are, but %addict% simply smiles and shakes %their_addict% head.%SPEECH_ON%Ain't talking to you, I'm talking to you!%SPEECH_OFF%%They_addict% points behind you at the barrel, and by the time you look back the %person_addict% is up to %their_addict% feet and charging forward.%SPEECH_ON%Fat sumbitch gon' be smart with me huh!%SPEECH_OFF%The sellsword tackles the barrel and it splinters from top to bottom and a number of items within spill out and shatter. A few mercenaries rush over and get the %person_addict% and take %them_addict% away while you count what's been lost.}"
        es = "[img]gfx/ui/events/event_05.png[/img]{Sacas a %addict% del barril y %lo_addict% tiras al suelo. Se tambalea allí como si la tierra fuera una escalera y estuviera asomándose al precipicio desde el escalón de arriba.%SPEECH_ON%¡Eh, señor, cuidado, que esto no para de bajar y bajar!%SPEECH_OFF%Al principio piensas en darle una patada en el culo, pero te contienes. Te agachas y te sientas junto %al_addict% %hombre_addict% mientras se da la vuelta para mirar las nubes. Al cabo de un rato, te mira.%SPEECH_ON%¿Intentas ayudarme?%SPEECH_OFF%Asientes y le dices que sí, pero %addict% se limita a sonreír y niega con la cabeza.%SPEECH_ON%¡No te hablo a ti, te hablo a ti!%SPEECH_OFF%Señala el barril que tienes detrás, y para cuando vuelves la vista, %art_addict% %hombre_addict% ya está en pie y cargando hacia delante.%SPEECH_ON%¡Conque el gordo hijo de puta se hace el listo conmigo!%SPEECH_OFF%%Art_addict% mercenari%o_addict% embiste el barril, que se astilla de arriba abajo, y varios de los objetos que contenía se desparraman y se hacen añicos. Unos cuantos mercenarios acuden corriendo, agarran %al_addict% %hombre_addict% y se %lo_addict% llevan mientras tú haces recuento de lo perdido.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\ailing_recovers_event.nut
    // context: ailing_recovers_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]{%ailing% is walking around camp with %their_ailing% hands out and %their_ailing% fingers stretched as though %they_ailing% was balancing across a rope. %They_ailing% nods to %themselves_ailing% as %they_ailing% turns around, foot placed before foot, marching %their_ailing% way back across.%SPEECH_ON%For the first time in a long time I actually feel quite alright. Thanks, %healer%!%SPEECH_OFF%It seems %healer% knew of a couple means to rid what ailed %ailing%.}"
        es = "[img]gfx/ui/events/event_05.png[/img]{%ailing% se pasea por el campamento con las manos extendidas y los dedos estirados, como si hiciera equilibrios sobre una cuerda. Asiente para sí mientras da la vuelta y, un pie delante del otro, desanda el camino.%SPEECH_ON%Por primera vez en mucho tiempo me siento bastante bien de verdad. ¡Gracias, %healer%!%SPEECH_OFF%Parece que %healer% conocía un par de remedios para librar a %ailing% de lo que %lo_ailing% aquejaba.}"
    }
    // context: ailing_recovers_event.o.create.::Legends.Screens.hook()._screen.start.::Legends.EventList.changeMood()
    {
        // corrige base: calco agramatical del inglés; en castellano es "mejor que en mucho tiempo".
        en = "Feels the best %they_ailing% did in a long time"
        es = "Se siente mejor que en mucho tiempo"
    }
    // en = "<ailing:str> is no longer ailing"
    // en base_es
    // FILE: mod_legends\hooks\events\events\dlc2\alp_captured_in_hole_event.nut
    // context: alp_captured_in_hole_event.o.create.s.start.Options.push().Text
    {
        en = "Let the Guildmaster speak."
        es = "Que hable quien dirige el gremio."
    }
    // context: alp_captured_in_hole_event.o.create.s.start.Options.push().getResult
    // en = "guildmaster"  // identificador de pantalla que devuelve getResult, no se muestra
    // context: alp_captured_in_hole_event.o.create.s.Text
    {
        // corrige base: "takes a bow" es coger un arco, no "recibe una reverencia" (luego dispara y devuelve el arco); "se las arreglan" debe ir en singular (este alp).
        en = "[img]gfx/ui/events/event_122.png[/img]{%beastslayer% the beast slayer walks up to the hole and stares in, nodding.%SPEECH_ON%You don't have it captured. Alps cannot be captured.%SPEECH_OFF%The monster enslaver looks over and asks how so. The slayer laughs.%SPEECH_ON%Because that is no ordinary creature. This alp is biding its time. You said it sends nightmares to people looking in, yeah? Yeah, that's right. Fear is its blade and it is sharpening it right and steady. It is practicing its craft the best it can. Alps use environments to put their victims in and currently it's making do with the dirt. But eventually you'll look in and it'll be looking up, ready for the very moment, and you'll find yourself in the hole with it. Not you, yourself. No, the body would be spared. It will take your mind into that hole. And it will be there. You and that monstrosity alone in all the dark this world has to spare. For how long? Days, weeks. A very dangerous alp can cage your mind for what seems like years. You'll come out of it a fool, broken and slobbering and begging for death, that is if you still have the capacity to speak by then.%SPEECH_OFF%The slayer takes a bow from one of the enslaver's guards and nocks an arrow. The alp looks up and its mouth blossoms open to rows of razor sharp teeth. The slayer shoots it right in the maw killing it instantly, before handing the bow back and unfurling a journeyman sheet.%SPEECH_ON%This is the pay I am owed. Extra for saving your soul and mind from an alp's forever harvest. I'll also be taking the alp's skin. Agreed?%SPEECH_OFF%The enslaver hurriedly nods.%SPEECH_ON%Yes, yes of course!%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_122.png[/img]{%beastslayer%, que caza bestias de oficio, se acerca al agujero, mira dentro y asiente.%SPEECH_ON%No lo tienes capturado. A los Alps no se les puede capturar.%SPEECH_OFF%El esclavizador de monstruos se vuelve y pregunta por qué. La respuesta es una carcajada.%SPEECH_ON%Porque esa no es una criatura cualquiera. Este alp está esperando su momento. Dijiste que manda pesadillas a quien se asoma, ¿verdad? Sí, así es. El miedo es su espada y la está afilando bien y sin prisa. Está practicando su oficio lo mejor que puede. Los Alps se valen de entornos para meter en ellos a sus víctimas, y ahora mismo este se las arregla con la tierra. Pero tarde o temprano te asomarás y estará mirando hacia arriba, listo para el momento justo, y te verás en el agujero con él. No tú en persona. No, el cuerpo se libraría. Se llevará tu mente a ese agujero. Y allí estará. Tú y esa monstruosidad, a solas en toda la oscuridad que este mundo tenga de sobra. ¿Durante cuánto tiempo? Días, semanas. Un alp muy peligroso puede enjaular tu mente durante lo que parecen años. Saldrás de ahí hecho un idiota, roto, babeando y suplicando la muerte, eso si para entonces todavía eres capaz de hablar.%SPEECH_OFF%Sin más, le quita un arco a uno de los guardias del esclavizador y coloca una flecha. El alp alza la vista y su boca se abre como una flor en hileras de dientes afilados como cuchillas. Un disparo justo en las fauces lo mata al instante; después devuelve el arco y despliega una hoja de pago.%SPEECH_ON%Esta es la paga que se me debe. Un extra por salvar tu alma y tu mente de la eterna cosecha de un alp. También me quedaré con la piel del alp. ¿De acuerdo?%SPEECH_OFF%El esclavizador asiente a toda prisa.%SPEECH_ON%¡Sí, sí, por supuesto!%SPEECH_OFF%}"
    }
    // context: alp_captured_in_hole_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_122.png[/img]{%guildmaster% gently approaches the man and his bodyguards like a stranger would approach a feral dog. %guildmaster% puts their arm around the peddler and leads him out of earshot of their hired help. The guards barely blink at this as their employer is led away under the wing of the old master.\n\n Several minutes pass as the master and peddler calmly talk back and forth. Occasionally the peddler rubs their forehead as if being told he'd go backrupt. %guildmaster% produces a book from a small pack and finds a page — almost as if by magic, and begins pointing to the illustrations within.\n The peddler begins to steadily turn a pale shade of white as their eyes move quickly across the page. Now even the hired help are interested as to what is going on but before they can react, %guildmaster% takes a pike out of the closest guard's hands and thrusts it into the pit — followed by an agonising wail.\n\n The peddler quickly gets between the master and the guards and whispers in hushed tones. No doubt with some embellishment. The guards look from you, to him — then back to you and finally at the guild master. The merchant nods in your direction with a concerned smile as the group depart.\n %guildmaster% returns with a trophy and smiles in your direction. %SPEECH_ON%What did you tell them?%SPEECH_OFF% %guildmaster% shrugs and keeps you in the corner of their gaze as they watch the peddler and their thugs leave. %SPEECH_ON%I told 'im that the young alp would steal his genitals.%SPEECH_OFF% You feel something tingle in your body. %SPEECH_ON%No — only witchlings do that. Best be going before they figure it out, he even paid me to kill it. The daft man.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_122.png[/img]{%guildmaster% se acerca con cuidado al hombre y a sus guardaespaldas, como se acercaría un desconocido a un perro salvaje. %guildmaster% le pasa el brazo por los hombros al buhonero y se lo lleva lejos de los oídos de sus matones a sueldo. Los guardias apenas pestañean mientras su patrón se aleja bajo el ala de esa vieja eminencia del gremio.\n\n Pasan varios minutos mientras ambos conversan con calma. De vez en cuando, el buhonero se frota la frente, como si le estuvieran diciendo que va a arruinarse. %guildmaster% saca un libro de una pequeña mochila y encuentra una página, casi como por arte de magia, y empieza a señalar las ilustraciones.\n Al buhonero se le va yendo el color de la cara mientras sus ojos recorren la página a toda prisa. Ahora hasta los matones a sueldo sienten curiosidad por lo que pasa, pero antes de que puedan reaccionar, %guildmaster% le arrebata una pica al guardia más cercano y la hunde en el foso, y le sigue un alarido de agonía.\n\n El buhonero se interpone enseguida entre unos y otros y habla en susurros, sin duda adornando un poco la historia. Los guardias te miran a ti, luego a él, otra vez a ti y por último a la vieja eminencia. El mercader te hace un gesto con la cabeza y una sonrisa preocupada mientras el grupo se marcha.\n %guildmaster% vuelve con un trofeo y te sonríe. %SPEECH_ON%¿Qué les dijiste?%SPEECH_OFF% %guildmaster% se encoge de hombros y te mantiene en el rabillo del ojo mientras observa cómo se marchan el buhonero y sus matones. %SPEECH_ON%Le dije que el alp joven le robaría los genitales.%SPEECH_OFF% Sientes un cosquilleo por el cuerpo. %SPEECH_ON%No, eso solo lo hacen las brujitas. Más vale irnos antes de que se den cuenta; hasta me pagó por matarlo. El muy bobo.%SPEECH_OFF%}"
    }
    // context: alp_captured_in_hole_event.o.create.m.Screens.push().Options.Text
    {
        en = "Best all of you check yourselves before we get going..."
        es = "Más vale que todos se revisen antes de ponernos en marcha..."
    }
    // en = "You gain <v:val_tag> Crowns"
    // en base_es
    // context: alp_captured_in_hole_event.o.create.m.Screens.push().start._event.m.Guildmaster.improveMood()
    {
        en = "Dealt with an Alp"
        es = "Se encargó de un Alp"
    }
    // en = "<actor:str> gains <v:val_tag> Resolve"
    // en base_es
    // FILE: mod_legends\hooks\events\events\dlc2\alp_nightmare1_event.nut
    // context: alp_nightmare1_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // _screen.Text = "[img]gfx/ui/events/event_26.png[/img]{The men are talking around the campfire when %spiderbro% suddenly jumps to %their_victim% feet screaming. %They_victim% bounds backward, and lit by the flames you see a spider the size of a helmet glommed onto %their_victim% boot!}";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_26.png[/img]{The men are talking around the campfire when %spiderbro% suddenly jumps to %their_victim% feet screaming. %They_victim% bounds backward, and lit by the flames you see a spider the size of a helmet glommed onto %their_victim% boot!}"
        es = "[img]gfx/ui/events/event_26.png[/img]{Los hombres están charlando alrededor de la fogata cuando %spiderbro% se pone en pie de un salto, gritando. Retrocede a brincos y, a la luz de las llamas, ¡ves una araña del tamaño de un casco aferrada a su bota!}"
    }
    // context: alp_nightmare1_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // _screen.Text = "[img]gfx/ui/events/event_26.png[/img]{You draw your blade, but %otherbro% has already beaten you to the punch. %They_other% yells at %spiderbro% to stand still which %they_other% reluctantly does. But the armed sellsword swings %their_other% blade far too high and cuts straight through the %person_victim%\'s neck. The headless body buckles and the rest of the company screams in horror and rage.}";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_26.png[/img]{You draw your blade, but %otherbro% has already beaten you to the punch. %They_other% yells at %spiderbro% to stand still which %they_other% reluctantly does. But the armed sellsword swings %their_other% blade far too high and cuts straight through the %person_victim%'s neck. The headless body buckles and the rest of the company screams in horror and rage.}"
        es = "[img]gfx/ui/events/event_26.png[/img]{Desenvainas tu espada, pero %otherbro% se te ha adelantado. Le grita a %spiderbro% que se quede quiet%o_victim%, y lo hace a regañadientes. Pero %art_other% mercenari%o_other% armad%o_other% lanza el tajo demasiado alto y atraviesa de lleno el cuello %del_victim% %hombre_victim%. El cuerpo decapitado se desploma y el resto de la compañía grita de horror y de rabia.}"
    }
    // context: alp_nightmare1_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // _screen.Text = "[img]gfx/ui/events/event_39.png[/img]{You run toward %otherbro% looking to choke the very life out of %them_other%, only for your hands to sift through the flesh like fingers into fog and your momentum sails you into the ground.%SPEECH_ON%Uh, you alright captain?%SPEECH_OFF%Looking back, you see a perfectly healthy %spiderbro% sitting beside the fire. Far off in the distance, something pale and sleek steps back from a tree trunk. When you blink, it\'s gone. You tell the men to mind the perimeter and then return to your tent, shaking your head and pinching your eyes.}";
        // corrige base: "choke" es estrangular, no ahorcar (que es colgar).
        mode = "pattern"
        en = "[img]gfx/ui/events/event_39.png[/img]{You run toward %otherbro% looking to choke the very life out of %them_other%, only for your hands to sift through the flesh like fingers into fog and your momentum sails you into the ground.%SPEECH_ON%Uh, you alright captain?%SPEECH_OFF%Looking back, you see a perfectly healthy %spiderbro% sitting beside the fire. Far off in the distance, something pale and sleek steps back from a tree trunk. When you blink, it's gone. You tell the men to mind the perimeter and then return to your tent, shaking your head and pinching your eyes.}"
        es = "[img]gfx/ui/events/event_39.png[/img]{Corres hacia %otherbro% dispuesto a estrangular%lo_other% hasta el último aliento, pero tus manos atraviesan la carne como dedos en la niebla y el impulso te estampa contra el suelo.%SPEECH_ON%Eh... ¿estás bien, capitán?%SPEECH_OFF%Al mirar atrás, ves a %spiderbro% junto al fuego, sin un solo rasguño. A lo lejos, algo pálido y estilizado se aparta del tronco de un árbol. Cuando parpadeas, ha desaparecido. Les dices a los hombres que vigilen el perímetro y vuelves a tu tienda, negando con la cabeza y frotándote los ojos.}"
    }
    // context: alp_nightmare1_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // _screen.Text = "[img]gfx/ui/events/event_26.png[/img]{%spiderbro% nods and stiffly walks toward the campfire with the spiderling looking up at %them_victim% with oddly trusting eyes. %They_victim% puts the critter to the pit and it is immediately set ablaze. At first, you think %they're_victim% done it, %they're_victim% in the clear, but the fiery spiderling sprints up the %person_victim%\'s pantleg, setting %their_victim% attire alight, and gloms onto %their_victim% head. Set afire, the %person_victim% throws %their_victim% hands out and begins to run around for help. The beast burrows its fangs into %their_victim% skull and the screaming ceases in sudden paralysis and the sellsword falls into the campfire like a board of wood.}";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_26.png[/img]{%spiderbro% nods and stiffly walks toward the campfire with the spiderling looking up at %them_victim% with oddly trusting eyes. %They_victim% puts the critter to the pit and it is immediately set ablaze. At first, you think %they're_victim% done it, %they're_victim% in the clear, but the fiery spiderling sprints up the %person_victim%'s pantleg, setting %their_victim% attire alight, and gloms onto %their_victim% head. Set afire, the %person_victim% throws %their_victim% hands out and begins to run around for help. The beast burrows its fangs into %their_victim% skull and the screaming ceases in sudden paralysis and the sellsword falls into the campfire like a board of wood.}"
        es = "[img]gfx/ui/events/event_26.png[/img]{%spiderbro% asiente y camina con rigidez hacia la fogata, con la cría de araña mirándo%lo_victim% con unos ojos extrañamente confiados. Echa al bicho al fuego y prende al instante. Al principio crees que lo ha conseguido, que está a salvo, pero la arañita en llamas trepa a toda velocidad por la pernera %del_victim% %hombre_victim%, prendiéndole fuego a la ropa, y se le aferra a la cabeza. Envuelt%o_victim% en llamas, %art_victim% %hombre_victim% extiende los brazos y echa a correr pidiendo ayuda. La bestia le hunde los colmillos en el cráneo, los gritos cesan en una parálisis repentina y %art_victim% mercenari%o_victim% cae en la fogata como un tablón de madera.}"
    }
    // context: alp_nightmare1_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // _screen.Text = "[img]gfx/ui/events/event_39.png[/img]{You scream at the mercenaries to do their part, but when you jump toward the campfire and %spiderbro% there\'s a wash of embers and sparks and when they fade you find the sellsword calmly sitting beside the flames.%SPEECH_ON%Ah, captain, did you say something?%SPEECH_OFF%Looking around, you find the rest of the company engaged in idle chat. When you look back at %spiderbro% you thought you saw a white shadow passing behind %them_victim%, but upon second glance it is gone. You tell the men to keep a vigilant eye for intruders and then return to your tent.}";
        // corrige base: "¡Ah, capitán, ¿dijiste algo?" lleva un signo de apertura de exclamación sin cierre.
        mode = "pattern"
        en = "[img]gfx/ui/events/event_39.png[/img]{You scream at the mercenaries to do their part, but when you jump toward the campfire and %spiderbro% there's a wash of embers and sparks and when they fade you find the sellsword calmly sitting beside the flames.%SPEECH_ON%Ah, captain, did you say something?%SPEECH_OFF%Looking around, you find the rest of the company engaged in idle chat. When you look back at %spiderbro% you thought you saw a white shadow passing behind %them_victim%, but upon second glance it is gone. You tell the men to keep a vigilant eye for intruders and then return to your tent.}"
        es = "[img]gfx/ui/events/event_39.png[/img]{Les gritas a los mercenarios que hagan su parte, pero cuando te lanzas hacia la fogata y hacia %spiderbro% se levanta una oleada de brasas y chispas, y cuando se apagan encuentras %al_victim% mercenari%o_victim% sentad%o_victim% tranquilamente junto a las llamas.%SPEECH_ON%Ah, capitán, ¿decías algo?%SPEECH_OFF%Al mirar a tu alrededor, ves al resto de la compañía enfrascado en charlas ociosas. Cuando vuelves a mirar a %spiderbro%, te parece haber visto una sombra blanca pasar detrás de %el_victim%, pero al mirar de nuevo ya no está. Les dices a los hombres que estén muy atentos a posibles intrusos y vuelves a tu tienda.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\bird_shits_on_sellsword_event.nut
    // context: bird_shits_on_sellsword_event.o.create.s.Text
    {
        en = "%terrainImage%{While traveling the land, %birdbro% gets struck by birdshite. It hits %their_victim% swordhand and splashes crosswise all over %their_victim% armor.%SPEECH_ON%Aww, awwww!%SPEECH_OFF%%Their_victim% arms go wide like chicken wings as %they_victim% looks at the damage.%SPEECH_ON%Bloody hell, just my luck!%SPEECH_OFF%}"
        es = "%terrainImage%{Mientras recorren estas tierras, a %birdbro% le cae una cagada de pájaro. Le da en la mano de la espada y salpica en diagonal por toda la armadura.%SPEECH_ON%¡Ay, aaay!%SPEECH_OFF%Abre los brazos como alas de pollo mientras contempla el estropicio.%SPEECH_ON%¡Maldita sea, qué suerte la mía!%SPEECH_OFF%}"
    }
    // context: bird_shits_on_sellsword_event.o.create.s.Text
    {
        // s.Text = "%terrainImage%{The ever superstitious %superstitious% analyzes the shit with the appraising eye of a proper jeweler. %They_superstitious% purses %their_superstitious% lips and nods, as satisfied a summary of bird shit as there ever was. %They_superstitious% says.%SPEECH_ON%This is a good thing.%SPEECH_OFF%In the face of very incredulous company the %person_superstitious% calmly explains that being shat on by a bird is an omen of good things to come. A few of the sellswords seem convinced by this notion. It is rather spectacular to have a bird choose you, out of all earth below, to land a squat on. You nod and say %birdbro% should open %their_superstitious% mouth next time for extra special good fortune.}";
        // corrige base: "joyero adecuado" calca "proper jeweler" (un joyero de verdad), y "excremento" rebaja "shit".
        mode = "pattern"
        en = "%terrainImage%{The ever superstitious %superstitious% analyzes the shit with the appraising eye of a proper jeweler. %They_superstitious% purses %their_superstitious% lips and nods, as satisfied a summary of bird shit as there ever was. %They_superstitious% says.%SPEECH_ON%This is a good thing.%SPEECH_OFF%In the face of very incredulous company the %person_superstitious% calmly explains that being shat on by a bird is an omen of good things to come. A few of the sellswords seem convinced by this notion. It is rather spectacular to have a bird choose you, out of all earth below, to land a squat on. You nod and say %birdbro% should open %their_superstitious% mouth next time for extra special good fortune.}"
        es = "%terrainImage%{%superstitious%, siempre tan supersticios%o_superstitious%, analiza la mierda con el ojo experto de un joyero de verdad. Frunce los labios y asiente, con el veredicto más satisfecho que se haya dado jamás sobre una cagada de pájaro. Y dice:%SPEECH_ON%Esto es algo bueno.%SPEECH_OFF%Ante una compañía de lo más incrédula, %art_superstitious% %hombre_superstitious% explica con calma que el hecho de que te cague un pájaro es presagio de cosas buenas por venir. Algunos de los mercenarios parecen convencidos con la idea. Es bastante espectacular que un pájaro te elija a ti, de entre toda la tierra, para soltarte su carga encima. Asientes y dices que la próxima vez %birdbro% debería abrir la boca para tener una suerte especialmente buena.}"
    }
    // context: bird_shits_on_sellsword_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_10.png[/img]{%archer% looks up, hand shielded over %their_archer% eyes, tongue out. %They_archer% sees the bird and nods. %They_archer% licks a finger, puts it to the air, and nods again. The archer grins as %they_archer% nocks an arrow.%SPEECH_ON%With crime there is punishment.%SPEECH_OFF%The mercenaries groan and mock the %person_archer%'s moralizing, but %they_archer% calmly raises the bow and lets the arrow loose. It zips and shrinks high into the air and you can hardly see the shot but you do see the bird suddenly crank sideways and start twirling to the earth. The sharpshooter nods and looks over at the company.%SPEECH_ON%You laughing now?%SPEECH_OFF%This only brings more jeers. The archer snidely comments about %their_archer% importance and this brings about a healthy debate between the sellswords who stand on the frontline and those in the back. You tell the company that if they want to argue which is better they can prove it on the battlefield.}"
        es = "[img]gfx/ui/events/event_10.png[/img]{%archer% alza la vista, con la mano a modo de visera y la lengua fuera. Ve el pájaro y asiente. Se chupa un dedo, lo levanta al aire y vuelve a asentir. Sonríe mientras coloca una flecha.%SPEECH_ON%Todo crimen tiene su castigo.%SPEECH_OFF%Los mercenarios refunfuñan y se burlan de los sermones %del_archer% arquer%o_archer%, pero levanta el arco con calma y suelta la flecha. Sale zumbando y se va haciendo pequeña en lo alto; apenas ves el disparo, pero sí ves al pájaro torcerse de golpe hacia un lado y caer dando vueltas hacia la tierra. Con un gesto de aprobación, mira a la compañía.%SPEECH_ON%¿Ahora sí se ríen?%SPEECH_OFF%Esto solo provoca más abucheos. %Art_archer% arquer%o_archer% suelta un comentario mordaz sobre su propia importancia, y eso desata un sano debate entre los mercenarios que forman en primera línea y los que se quedan atrás. Le dices a la compañía que, si quieren discutir quién vale más, pueden demostrarlo en el campo de batalla.}"
    }
    // context: bird_shits_on_sellsword_event.o.create.s.Text
    {
        // corrige base: "sellsword" es mercenario, no soldado, y "company" es compañía, no grupo; "ensuciado", "excremento" y "suciedad" rebajan "shit".
        en = "%terrainImage%{You tell %birdbro% that being shit on is a part of life and get the company ready to get back on the road. But a modest %historian% comes up and tells the ill-fated sellsword to hold off on cleaning the shite. The historian takes a good look at the shite and then up at the bird which authored it.%SPEECH_ON%Yes, yes... I know that bird! That magical creature!%SPEECH_OFF%The mercenaries look up at the bird as though they were sealeagured sailors finding rarified land. %historian% points at %birdbro%.%SPEECH_ON%You got shat on by a red-and-blue mockingbird! That's all I wanted to say, really. I just hadn't seen one in awhile. You... you can clean it now.%SPEECH_OFF%The mercenaries stand slackjawed before bursting into laughter. %birdbro% grabs the historian and uses %their_historian% sleeves to clean the shit off which brings more roars from the company.}"
        es = "%terrainImage%{Le dices a %birdbro% que te caguen encima es parte de la vida y preparas a la compañía para volver al camino. Pero %historian% se acerca con modestia y le pide a la víctima del pájaro que espere antes de limpiarse la mierda. %historian% examina bien la mierda y luego mira al pájaro que la ha firmado.%SPEECH_ON%Sí, sí... ¡conozco ese pájaro! ¡Esa criatura mágica!%SPEECH_OFF%Los mercenarios alzan la vista hacia el pájaro como marineros a la deriva que avistan una tierra largo tiempo anhelada. %historian% señala a %birdbro%.%SPEECH_ON%¡Te ha cagado un sinsonte rojo y azul! Eso es todo lo que quería decir, la verdad. Hacía tiempo que no veía uno. Ya... ya puedes limpiarte.%SPEECH_OFF%Los mercenarios se quedan boquiabiertos antes de estallar en carcajadas. %birdbro% agarra a %historian% y se limpia la mierda con sus mangas, lo que arranca más carcajadas a la compañía.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\collector_wants_trophy_event.nut
    // en = "Deal."
    // en base_es
    // en = "Merchant"
    // en = "Peddler"
    // en base_es
    // en = "No deal."
    // en base_es
    // context: collector_wants_trophy_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_01.png[/img]{%peddler% steps forward and pushes you back as though you were a random customer and not the company captain. %peddler% yells at the buyer and throws a hand up and the buyer responds and it's like two dogs barking at one another and it's all so fast and with so many numbers being thrown around it may as well be another language. After a minute passes, the peddler returns.%SPEECH_ON%Alright. He's now offering %reward% crowns. I'm off to look at some pots and pans, good luck.%SPEECH_OFF%He pats you on the shoulder and walks off.}"
        es = "[img]gfx/ui/events/event_01.png[/img]{%peddler% da un paso al frente y te aparta de un empujón como si fueras un cliente cualquiera y no el capitán de la compañía. %peddler% le grita al comprador y levanta una mano, el comprador responde, y es como dos perros ladrándose; todo va tan rápido y con tantas cifras de por medio que bien podría ser otro idioma. Pasado un minuto, vuelve contigo.%SPEECH_ON%Bueno. Ahora ofrece %reward% coronas. Me voy a ver unas ollas y sartenes, suerte.%SPEECH_OFF%Te da una palmada en el hombro y se marcha.}"
    }
    // context: collector_wants_trophy_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_01.png[/img]{You see your chance and step forward, the buyer looks a little concerned as if they just wandered into a tavern filled with angry barbarians. You playfully lean on the stall and lock eyes with him. You gracefully smile while maintaining eye contact. %SPEECH_ON%This isn't just any trophy — this came from a great beast with jaws bigger than a horse and a tail as long as a man!%SPEECH_OFF%The merchant recoils slightly, trying to picture the beast in his mind while eye the trophy in your hands. %SPEECH_ON%This beast was mighty — legendary even! You'll be the talk of the market when you have it safely away in your store...%SPEECH_OFF%The man purses his lips and contemplates this for a moment, before gingerly counting out additional coin from an unassuming bag. %SPEECH_ON%I'll give you %reward% for it. No more.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_01.png[/img]{Ves tu oportunidad y das un paso al frente; el comprador parece algo inquieto, como si acabara de entrar en una taberna llena de bárbaros furiosos. Te apoyas con desenfado en el puesto y le sostienes la mirada. Sonríes con elegancia sin apartar los ojos. %SPEECH_ON%Este no es un trofeo cualquiera: ¡viene de una gran bestia con unas fauces más grandes que un caballo y una cola tan larga como un hombre!%SPEECH_OFF%El mercader retrocede un poco, intentando imaginarse la bestia mientras mira el trofeo que tienes en las manos. %SPEECH_ON%Esta bestia era poderosa, ¡legendaria incluso! Serás la comidilla del mercado cuando la tengas bien guardada en tu tienda...%SPEECH_OFF%El hombre frunce los labios y lo medita un momento, antes de contar con cuidado unas monedas más de una bolsa de aspecto humilde. %SPEECH_ON%Te doy %reward% por él. Ni una moneda más.%SPEECH_OFF%}"
    }
    // context: collector_wants_trophy_event.o.onPrepareVariables._vars.push()
    // en = "merchant"  // nombre de la variable de evento (%merchant%), no se muestra
    // FILE: mod_legends\hooks\events\events\dlc2\corpses_in_forest_event.nut
    // context: corpses_in_forest_event.o.create.s.Text
    {
        // corrige base: "you have the body cut down" es hacer que descuelguen el cuerpo, no "bajas el cuerpo cortado"; "fingertips" son las yemas, no los dedos enteros.
        en = "[img]gfx/ui/events/event_132.png[/img]{%killer% the murderer on the run smirks and snorts and nods and spits, then nods again and points at the pile of bodies.%SPEECH_ON%That's a cruelty so fierce I don't think its doer survived the doing.%SPEECH_OFF%You ask what that means, but the killer holds a finger up and walks about the forest, looking behind tree after tree until coming to a stop.%SPEECH_ON%Just as I thought.%SPEECH_OFF%You come round to see a man hanging there. His fingertips are black and there's ash on his face and a noose about his neck. A note in his hand carries apologies, though it does not describe the nature of his crime or if it were a crime at all. Below his feet is his armor and weapons. He may have been a nobleman. Regardless, you have the body cut down and everything looted.}"
        es = "[img]gfx/ui/events/event_132.png[/img]{%killer%, que anda huyendo por asesinato, sonríe con suficiencia, resopla, asiente y escupe; luego vuelve a asentir y señala la pila de cadáveres.%SPEECH_ON%Esa es una crueldad tan feroz que no creo que quien la cometió sobreviviera a cometerla.%SPEECH_OFF%Preguntas qué quiere decir eso, pero te hace callar levantando un dedo y se pone a recorrer el bosque, mirando detrás de un árbol tras otro hasta que se detiene.%SPEECH_ON%Justo lo que pensaba.%SPEECH_OFF%Te acercas y ves a un hombre colgado allí. Tiene las yemas de los dedos negras, ceniza en la cara y una soga al cuello. Una nota en su mano pide perdón, aunque no explica la naturaleza de su crimen ni si llegó a ser un crimen. A sus pies están su armadura y sus armas. Puede que fuera un noble. Sea como sea, haces que descuelguen el cuerpo y que lo saqueen todo.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\dog_in_swamp_event.nut
    // context: dog_in_swamp_event.o.create.s.Options[1].Text
    {
        en = "Comrades, we've got to help that dog!"
        es = "¡Camaradas, tenemos que ayudar a ese perro!"
    }
    // context: dog_in_swamp_event.o.create.s.Text
    {
        // corrige base: "no es nada si no es un maldito nadador" invierte el sentido; el dueño dice que el perro es un nadador de mierda. "sellsword" es mercenario, no soldado.
        en = "[img]gfx/ui/events/event_09.png[/img]%helpbro% wades into the swampwater with arms out and swaying as though screwing the lid off a barrel. Lifting a weapon on high as the dog's owner nervously watches. A grin crosses the sellsword's face.%SPEECH_ON%Gotcha!%SPEECH_OFF%Skewers the swamp water and wrangling up a snake longer than any you've ever seen, the length of it flopping about as the mercenary parades its corpse like a colored rope of a reward. The owner goes for his dog, but it slips out his grasp as though his arms were but another snake and it sprints right to your side. You ask if it's his dog at all. He nods, then slowly shakes his head.%SPEECH_ON%I suppose it's yer dog now. He's a fighter, that one, but he ain't nothing at all if not a goddam shite swimmer. I'd see it a fair trade if I can keep that there snake.%SPEECH_OFF%You nod and make the trade, telling %helpbro% to hand over the newfound trophy."
        es = "[img]gfx/ui/events/event_09.png[/img]%helpbro% se mete en el agua del pantano con los brazos extendidos y balanceándose como quien desenrosca la tapa de un barril. Levanta un arma en alto mientras el dueño del perro mira con nervios. Una sonrisa se le dibuja en la cara.%SPEECH_ON%¡Te tengo!%SPEECH_OFF%Ensarta el agua del pantano y saca a pulso una serpiente más larga que cualquiera que hayas visto, que se agita en toda su longitud mientras pasea su cadáver como si fuera una cuerda de colores a modo de premio. El dueño va por su perro, pero se le escurre de las manos como si sus brazos fueran otra serpiente y corre directo a tu lado. Le preguntas si de verdad es su perro. Asiente y luego niega despacio con la cabeza.%SPEECH_ON%Supongo que ahora es tu perro. Es un luchador, ese, pero si algo es, es un nadador de mierda, maldita sea. Me parecería un trato justo si puedo quedarme con esa serpiente de ahí.%SPEECH_OFF%Asientes y cierras el trato, diciéndole a %helpbro% que entregue su recién conseguido trofeo."
    }
    // en = "Swimmer"
    // en base_es
    // context: dog_in_swamp_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_09.png[/img]%helpbro% heads to the shoreline and draws a weapon. Wading into the mire like some ale strewn saint departing a crowd before they recognize a face. Such is the struggle that the mercenary topples over on top of the dog and disappears into the froth and bubbles of the battle. You rush to pull the sellsword ashore, who is now covered in moss with boots wrapped in lily pads and hacking nasty swamp water and picking out the brine which fermented it. There's no sight of the dog, just a slight ripple of water which trails away from the scene. Unnerved, its owner nods.%SPEECH_ON%Appreciate the effort, but it is what it is. The swamp sees to such things because it's a swamp and fark this goddam farkin' place I'd see this whole shitstain of geographical oddity drained and burned and salted to nothing but a wasteland whole if I could!%SPEECH_OFF%You raise an eyebrow and ask if he lives in the swamp. He takes a long breath and nods.%SPEECH_ON%Yessir. Rent free.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_09.png[/img]%helpbro% va hacia la orilla y desenvaina un arma. Se adentra en el fango como un santo regado de cerveza que se escabulle de la multitud antes de que le reconozcan la cara. Tal es la lucha que acaba cayendo encima del perro y desaparece entre la espuma y las burbujas de la refriega. Corres a ayudarle a salir a la orilla, y sale con musgo por todas partes, las botas envueltas en hojas de nenúfar, tosiendo agua de pantano asquerosa y escupiendo la salmuera que la fermentó. No hay rastro del perro, solo una leve onda en el agua que se aleja del lugar. Su dueño, alterado, asiente.%SPEECH_ON%Agradezco el esfuerzo, pero es lo que hay. El pantano se encarga de estas cosas porque es un pantano, y maldito sea este maldito lugar del demonio: ¡si pudiera, vería toda esta mancha de mierda de rareza geográfica drenada, quemada y salada hasta no ser más que un páramo!%SPEECH_OFF%Arqueas una ceja y le preguntas si vive en el pantano. Respira hondo y asiente.%SPEECH_ON%Sí, señor. Sin pagar renta.%SPEECH_OFF%"
    }
    // context: dog_in_swamp_event.o.create.s.Options[0].Text
    {
        // corrige base: "worthwhile" es que valió la pena (aquí con ironía), no "de toda la vida".
        en = "Well, that was a worthwile endeavour."
        es = "Bueno, eso sí que valió la pena."
    }
    // context: dog_in_swamp_event.o.create.s.Text
    {
        // corrige base: "Riéndose, te agachas" debe ser "Riéndote" (quien ríe eres tú); "the departed" es quien se ha ido corriendo, no "el difunto"; "desgraciado" rebaja "sonuvabitch".
        en = "[img]gfx/ui/events/event_09.png[/img]%houndmaster% the houndmaster rushes forward to help, but the dog the swamp surface goes still. The mercenary slips into the water and feels about, hands clench and staring back at the stranger.%SPEECH_ON%I'm a dog handler at heart. That means I train 'em to not get into this much trouble. But I ain't ever would need to train a dog to beware this here bog, which means this sonuvabitch here threw him in there, ain't that right?%SPEECH_OFF%The stranger's first words are excuses and so the houndmaster batters him. The stranger scissors his legs backwards so awkwardly his pants fall about his ankles and there in his drawers spill an assortment of treasures. The damned fool is a treasure hunter! %houndmaster% draws a weapon and looks ready to murder this man. Screaming, the stranger kicks his pants off and runs off into the swampwoods hooting and pallidly half naked like some potato sack governed by a ghost. Laughing, you crouch to sift through the departed's goods, not all of which is shiny."
        es = "[img]gfx/ui/events/event_09.png[/img]%houndmaster%, que vive de adiestrar perros, se lanza a ayudar, pero el perro deja de agitarse en la superficie del pantano. Se mete en el agua y tantea; aprieta las manos y se vuelve a mirar al desconocido.%SPEECH_ON%En el fondo, lo mío es adiestrar perros. Eso quiere decir que los entreno para que no se metan en tantos líos. Pero nunca me haría falta entrenar a un perro para que se cuide de este pantano, lo que quiere decir que este hijo de puta de aquí lo tiró ahí, ¿o no?%SPEECH_OFF%Las primeras palabras del desconocido son excusas, así que se lleva una paliza. El desconocido echa las piernas hacia atrás de forma tan torpe que se le caen los pantalones a los tobillos, y de sus calzones se desparrama un surtido de tesoros. ¡El maldito idiota es un cazador de tesoros! %houndmaster% saca un arma y parece a punto de matar a este hombre. Gritando, el desconocido se quita los pantalones a patadas y huye hacia el bosque del pantano, chillando y medio desnudo, pálido como un saco de papas gobernado por un fantasma. Riéndote, te agachas a revisar las pertenencias del que acaba de huir, y no todas brillan."
    }
    // context: dog_in_swamp_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_09.png[/img]The slayer of creatures, %beastslayer%, nods and wades into the swamp. The mercenary calmly comes to the thrashing water and stands over it, staring into the mire with eyes tracking left to right as though watching carp in clear waters. Finally, the beast hunter draws a dinner knife and slashes it into the water. Once more. And again. The dog surfaces and it snorts for air. The slayer stabs again and this time the dog runs free and goes between your legs where it huddles wet and whimpering. %beastslayer% holds something in hand and then lets it go, whatever it is diving across the swamp, the water rippling in its wake.%SPEECH_ON%Nothing but a snake, captain.%SPEECH_OFF%The beast slayer kicks a foot up out of the water and riding on a toe is a shiny goblet. The slayer regards the swamp stranger with complete contempt.%SPEECH_ON%Your cowardice has made you a monster, treasure hunter, a right savage that'd use a dog in place of his own two hands. You've no business in these swamps. When I turn around, you'd best be gone, got it?%SPEECH_OFF%The beast slayer hands you the goblet and the stranger retreats without delay."
        es = "[img]gfx/ui/events/event_09.png[/img]%beastslayer%, que caza criaturas de oficio, asiente y se adentra en el pantano. Llega con calma hasta el agua revuelta y se planta sobre ella, mirando el fango y siguiendo algo con los ojos de izquierda a derecha, como quien observa carpas en aguas claras. Por fin, saca un cuchillo de mesa y lo hunde en el agua de un tajo. Otra vez. Y otra. El perro sale a la superficie resoplando en busca de aire. Una nueva cuchillada y esta vez el perro queda libre y se mete entre tus piernas, donde se acurruca empapado y gimoteando. %beastslayer% sostiene algo en la mano y luego lo suelta, y lo que sea se aleja buceando por el pantano, con el agua rizándose a su paso.%SPEECH_ON%Nada más que una serpiente, capitán.%SPEECH_OFF%Saca un pie del agua de una patada y en la punta trae enganchada una copa reluciente. Mira al desconocido del pantano con absoluto desprecio.%SPEECH_ON%Tu cobardía te ha convertido en un monstruo, cazador de tesoros, un auténtico salvaje capaz de usar a un perro en lugar de sus propias manos. No pintas nada en estos pantanos. Cuando me dé la vuelta, más te vale haberte ido, ¿entendido?%SPEECH_OFF%Te entrega la copa y el desconocido se retira sin demora."
    }
    // FILE: mod_legends\hooks\events\events\dlc2\fear_beasts_event.nut
    // context: fear_beasts_event.o.m.excludedBackgrounds
    // en = "companion"  // identificador interno de trasfondo excluido, no se muestra
    // en = "hunter"
    // en = "witchhunter"
    // en = "wildman"
    // context: fear_beasts_event.o.m.excludedBackgrounds
    // en = "wildwoman"  // identificador interno de trasfondo excluido, no se muestra
    // context: fear_beasts_event.o.m.excludedTraits
    // en = "fearless"  // identificador interno de rasgo excluido, no se muestra
    // context: fear_beasts_event.o.m.excludedTraits
    // en = "brave"  // identificador interno de rasgo excluido, no se muestra
    // en = "determined"
    // context: fear_beasts_event.o.m.excludedTraits
    // en = "bloodthirsty"  // identificador interno de rasgo excluido, no se muestra
    // context: fear_beasts_event.o.create.s.Text
    {
        // corrige base: "this ain't game" juega con "game" (presas de caza), no "juego"; "¡Ni de coña!" es léxico regional; signos de exclamación descuadrados en "¡Oh, ¿a quién...".
        en = "[img]gfx/ui/events/event_26.png[/img]{%brother% is carving a rabbit into a piece of bark. It's shaping up nicely until the whole thing is angrily thrown into the campfire.%SPEECH_ON%Oh who the fark am I kidding? I wish I was out here hunting game! But this ain't game, these are monsters! Creatures of the night! Bullshit, all of it, where'd they even come from? Well I tell you what, I ain't gonna be killed by one of them things! Not a farking chance!%SPEECH_OFF%The rest of the company stares as %brother% comes down from the outburst. %brother% quietly sits watching the rabbit carving churn and burn.}"
        es = "[img]gfx/ui/events/event_26.png[/img]{%brother% está tallando un conejo en un trozo de corteza. Va quedando bastante bien hasta que lo arroja todo con rabia a la fogata.%SPEECH_ON%Ay, ¿a quién demonios quiero engañar? ¡Ojalá estuviera aquí cazando presas! Pero esto no son presas, ¡son monstruos! ¡Criaturas de la noche! Una mierda, todo esto, ¿de dónde han salido siquiera? Pues te digo una cosa: ¡a mí no me va a matar una de esas cosas! ¡Ni de maldita broma!%SPEECH_OFF%El resto de la compañía se queda mirando mientras %brother% se calma tras el estallido. %brother% contempla en silencio cómo la talla del conejo se retuerce y arde.}"
    }
    // context: fear_beasts_event.o.create.s.Options[0].Text
    {
        en = "This is taking a toll on the mercenaries."
        es = "Esto les está pasando factura a los mercenarios."
    }
    // context: fear_beasts_event.o.onUpdateScore.bro.getSkills().hasSkill()
    // en = "trait.<trait>"  // identificador interno de habilidad (hasSkill), no se muestra
    // FILE: mod_legends\hooks\events\events\dlc2\fear_greenskins_event.nut
    // context: fear_greenskins_event.o.create.s.Text
    {
        // corrige base: "spreading it sure as hell ain't" dice que propagarlo no está justificado, no que "no ayuda".
        en = "[img]gfx/ui/events/event_26.png[/img]{%brother% stares at the campfire with their hands bridged between their knees.%SPEECH_ON%Fark, man. I don't know if I can look at a greenskin again. They're so much stronger and faster than us! We, we shouldn't face them again until we got at least, two, no three times as many mercenaries!%SPEECH_OFF%You tell the company to keep an eye on %brother%. Fear is justified but spreading it sure as hell ain't.}"
        es = "[img]gfx/ui/events/event_26.png[/img]{%brother% mira fijamente la fogata con las manos entrelazadas entre las rodillas.%SPEECH_ON%Maldita sea, hombre. No sé si podré volver a mirar a un pielverde. ¡Son mucho más fuertes y rápidos que nosotros! No... ¡no deberíamos volver a enfrentarnos a ellos hasta que tengamos al menos el doble, no, el triple de mercenarios!%SPEECH_OFF%Le pides a la compañía que no le quite el ojo de encima a %brother%. El miedo está justificado, pero sembrarlo, ni de lejos.}"
    }
    // context: fear_greenskins_event.o.create.s.Options[0].Text
    {
        en = "This is taking a toll on the company."
        es = "Esto le está pasando factura a la compañía."
    }
    // FILE: mod_legends\hooks\events\events\dlc2\fear_undead_event.nut
    // en = "crusader"
    // en = "gravedigger"
    // en = "graverobber"
    // context: fear_undead_event.o.create.s.Text
    {
        // corrige base: "ponderous" es pesado, no "ponderado" (que significa mesurado).
        en = "[img]gfx/ui/events/event_26.png[/img]{%brother% looks around at the others around the campfire, then looks at the ground for a few minutes before exploding.%SPEECH_ON%Am I the only one here who is sane? How is no one else losing their farking minds over the dead walking the earth again? What the hell, where are the old gods in all this, they just farking gonna watch this shitshow?%SPEECH_OFF%The company tries to temper the fears, but %brother% goes back to a ponderous silence of a person with too much to think about and no one willing, or wanting, to truly listen.}"
        es = "[img]gfx/ui/events/event_26.png[/img]{%brother% mira a los demás alrededor de la fogata y luego se queda mirando el suelo unos minutos antes de estallar.%SPEECH_ON%¿Es que solo yo conservo la cordura aquí? ¿Cómo es que nadie más está perdiendo la maldita cabeza con los muertos caminando otra vez por la tierra? ¿Qué demonios? ¿Dónde están los viejos dioses en todo esto? ¿Se van a quedar mirando este espectáculo de mierda, maldita sea?%SPEECH_OFF%La compañía intenta calmar sus miedos, pero %brother% vuelve al silencio pesado de quien tiene demasiado en qué pensar y nadie dispuesto, ni con ganas, a escuchar de verdad.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\hate_greenskins_event.nut
    // en = "dastard"
    // context: hate_greenskins_event.o.m.excludedTraits
    // en = "craven"  // identificador interno de rasgo excluido, no se muestra
    // en = "fainthearted"
    // context: hate_greenskins_event.o.m.excludedTraits
    // en = "weasel"  // identificador interno de rasgo excluido, no se muestra
    // FILE: mod_legends\hooks\events\events\dlc2\hedge_knight_vs_refugee_event.nut
    // context: hedge_knight_vs_refugee_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_52.png[/img]%hedgeknight% the hedge knight walks up to an eating %refugee%. The former refugee sees the shadow looming and slowly turns about.%SPEECH_ON%Yeah?%SPEECH_OFF%The hedge knight snorts and spits a loogie about the size of a baby's arm. Snorting again.%SPEECH_ON%You ran from your home. You watched it burn and put yer back to the flames rather than fight them. This company is your home now. What stops you from running from the fire now?%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_52.png[/img]%hedgeknight%, caballero errante, se acerca a %refugee% mientras come. Al ver cernirse la sombra, se gira despacio.%SPEECH_ON%¿Sí?%SPEECH_OFF%La respuesta es un resoplido y un gargajo del tamaño del brazo de un bebé. Otro resoplido.%SPEECH_ON%Huiste de tu hogar. Lo viste arder y diste la espalda a las llamas en vez de combatirlas. Ahora esta compañía es tu hogar. ¿Qué te impide huir del fuego esta vez?%SPEECH_OFF%"
    }
    // context: hedge_knight_vs_refugee_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_52.png[/img]You step forward and tell the hedge knight to stuff it. The company ain't here to stroke egos. Laughing, the bear of a mercenary steps off.%SPEECH_ON%As you say, sir. Wouldn't want to get into a scrap with the company princess.%SPEECH_OFF%The company laughs, but the refugee only stares into their bowl of food like someone'd just spat in it."
        es = "[img]gfx/ui/events/event_52.png[/img]Das un paso al frente y le dices que cierre el pico. La compañía no está aquí para masajear egos. Entre risas, esa mole se aparta.%SPEECH_ON%Como usted diga, señor. No querría meterme en una pelea con la princesita de la compañía.%SPEECH_OFF%La compañía se ríe, pero al otro lado solo hay una mirada clavada en el cuenco de comida, como si alguien acabara de escupir dentro."
    }
    // context: hedge_knight_vs_refugee_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_06.png[/img]You don't intervene. The hedge knight continues.%SPEECH_ON%I've no pity for your pain. You understand?%SPEECH_OFF%Nodding, the refugee looks up.%SPEECH_ON%Aye, but what pity does anyone have for yours?%SPEECH_OFF%%refugee%'s arm shoots forward so fast it flips the plate into the campfire. The fork sticks in the thigh of %hedgeknight% and %refugee% can't wrench it out no better than if it were stuck in a trunk of oak. The hedge knight grits and falls, flattening the refugee. The knight's giant hands press the refugee's skull into the earth until the poor sellsword's breathing dirt. The rest of the company stands up and backs off. You step forward, but %hedgeknight% holds a hand out before standing back up.%SPEECH_ON%Alright, little runner, alright. You've fight in you yet.%SPEECH_OFF%He retrieves the fork and holds it out. A drop of blood grooves between he tines.%SPEECH_ON%Whatcha eating? Oh yeah? Good. I'll double it with my portion. Come and sit.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_06.png[/img]No intervienes, y la provocación continúa.%SPEECH_ON%No siento ninguna lástima por tu dolor. ¿Lo entiendes?%SPEECH_OFF%%refugee% asiente y levanta la vista del plato.%SPEECH_ON%Sí, pero ¿quién siente lástima por el tuyo?%SPEECH_OFF%El brazo de %refugee% sale disparado tan rápido que lanza el plato a la fogata. El tenedor se clava en el muslo de %hedgeknight%, y %refugee% no consigue arrancarlo, igual que si estuviera clavado en un tronco de roble. %hedgeknight% aprieta los dientes y se le echa encima con todo su peso. Unas manazas le hunden el cráneo en la tierra hasta que no le queda más que tierra que respirar. El resto de la compañía se levanta y retrocede. Das un paso al frente, pero %hedgeknight% extiende una mano antes de volver a ponerse en pie.%SPEECH_ON%Está bien, liebre, está bien. Todavía te quedan ganas de pelea.%SPEECH_OFF%Recupera el tenedor y lo tiende. Una gota de sangre se desliza entre los dientes.%SPEECH_ON%¿Qué estás comiendo? ¿Ah, sí? Bien. Te lo doblo con mi ración. Ven y siéntate.%SPEECH_OFF%"
    }
    // context: hedge_knight_vs_refugee_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_80.png[/img]%streetrat% steps forward and points a finger at the hedge knight.%SPEECH_ON%You ain\'t got a lick of understanding of no flame nor fire.%SPEECH_OFF%Laughing, %hedgeknight% turns around and cracks huge knuckles.%SPEECH_ON%Course I do. I AM the fire.%SPEECH_OFF%The lowborn\'s arms are defiantly crossed.%SPEECH_ON%And we ain\'t the ash, but the wood itself. You\'re a whore for the noblemen, that\'s what you truly are. They pay you a high price and you go on with your strength and cruelty and do what they tell you to do. Like... like a whore...%SPEECH_OFF%Another sellsword holds up a finger.%SPEECH_ON%I think yer describing us in general. We\'re mercenaries.%SPEECH_OFF%And another adds.%SPEECH_ON%Did you just compare yerself to kindling?%SPEECH_OFF%%streetrat% rubs the back of his head.%SPEECH_ON%Yeah I\'m gonna be honest the hedge knight scared me a bit there and I lost what I was going to say.%SPEECH_OFF%The company looks around before bursting into laughter and whatever animosity there was is gone.";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_80.png[/img]%streetrat% steps forward and points a finger at the hedge knight.%SPEECH_ON%You ain't got a lick of understanding of no flame nor fire.%SPEECH_OFF%Laughing, %hedgeknight% turns around and cracks huge knuckles.%SPEECH_ON%Course I do. I AM the fire.%SPEECH_OFF%The lowborn's arms are defiantly crossed.%SPEECH_ON%And we ain't the ash, but the wood itself. You're a whore for the noblemen, that's what you truly are. They pay you a high price and you go on with your strength and cruelty and do what they tell you to do. Like... like a whore...%SPEECH_OFF%Another sellsword holds up a finger.%SPEECH_ON%I think yer describing us in general. We're mercenaries.%SPEECH_OFF%And another adds.%SPEECH_ON%Did you just compare yerself to kindling?%SPEECH_OFF%%streetrat% rubs the back of his head.%SPEECH_ON%Yeah I'm gonna be honest the hedge knight scared me a bit there and I lost what I was going to say.%SPEECH_OFF%The company looks around before bursting into laughter and whatever animosity there was is gone."
        es = "[img]gfx/ui/events/event_80.png[/img]%streetrat% da un paso al frente y apunta con el dedo a %hedgeknight%.%SPEECH_ON%No tienes ni pizca de idea de llamas ni de fuego.%SPEECH_OFF%Entre risas, se da la vuelta y hace crujir unos nudillos enormes.%SPEECH_ON%Claro que sí. YO SOY el fuego.%SPEECH_OFF%Con los brazos cruzados en actitud desafiante, llega la réplica.%SPEECH_ON%Y nosotros no somos la ceniza, sino la madera misma. Eres una puta de los nobles, eso es lo que eres en realidad. Te pagan un precio alto y tú vas con tu fuerza y tu crueldad y haces lo que te dicen. Como... como una puta...%SPEECH_OFF%Otro mercenario levanta un dedo.%SPEECH_ON%Creo que nos estás describiendo a todos. Somos mercenarios.%SPEECH_OFF%Y otro añade:%SPEECH_ON%¿Te acabas de comparar con la leña menuda?%SPEECH_OFF%%streetrat% se rasca la nuca.%SPEECH_ON%Sí, para qué voy a mentir, esa mole me ha asustado un poco y he perdido el hilo de lo que iba a decir.%SPEECH_OFF%Todos en la compañía se miran antes de estallar en carcajadas, y cualquier animosidad que hubiera desaparece."
    }
    // FILE: mod_legends\hooks\events\events\dlc2\kid_blacksmith_event.nut
    // context: kid_blacksmith_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_97.png[/img]{%other% is fetched to go help the kid. %They_other% helps place the sword's handle and steel together and the kid works his magic on his own, easily mending the sword back into one piece. You're amazed by his skill and wonder how good the blacksmith himself must be if this is his apprentice. After the work is done, the boy offers to fix some of the weapons for the %companyname% which you happily accept.}"
        es = "[img]gfx/ui/events/event_97.png[/img]{Mandas a buscar a %other% para que ayude al chico. Ayuda a encajar la empuñadura y el acero de la espada, y el chico obra su magia por su cuenta, dejando la espada de una pieza sin ningún esfuerzo. Te asombra su destreza y te preguntas lo bueno que debe de ser el propio herrero si este es su aprendiz. Terminado el trabajo, el chico se ofrece a arreglar algunas armas de %companyname%, y aceptas encantado.}"
    }
    // en = "Your <item:str> is repaired"
    // en base_es
    // context: kid_blacksmith_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_97.png[/img]{%other% sighs after you ask that %they_other% go help the kid with his duties. %They_other% lazily steps over to the blacksmith's anvil which is shaped like a molar as it rests on thin iron stilts. The blacksmith's goods are hanging from ad hoc walls manufactured out of old iron fences, the spokes curved outward to help catch the metalworks. The kid claps his hands.%SPEECH_ON%Now don't touch nothing else, just help me with this.%SPEECH_OFF% %other% turns 'round with confusion and mid-sentence knocks the anvil's leg out. It starts to crumple sideways and the kid rushes to catch it if only to stem the tide of trouble which has beset his day. The insane weight pastes him flat against the cobblestones, his limbs briefly stretched up like a cricket smooshed beneath a thumb. You see this all from a distance and whistle for the mercenary to head back before there's trouble. %They_other% makes his escape just as a few passersby start to take notice. %They_other% shrugs.%SPEECH_ON%We didn't do nothing, right sir?%SPEECH_OFF%You nod.}"
        es = "[img]gfx/ui/events/event_97.png[/img]{%other% suspira cuando le pides que vaya a ayudar al chico con sus tareas. Se acerca con desgana al yunque del herrero, que tiene forma de muela y descansa sobre unos finos zancos de hierro. La mercancía del herrero cuelga de paredes improvisadas hechas con viejas verjas de hierro, con los barrotes curvados hacia fuera para sujetar las piezas. El chico da una palmada.%SPEECH_ON%Ahora no toques nada más, solo ayúdame con esto.%SPEECH_OFF% %other% se da la vuelta, confundid%o_other%, y a mitad de frase le tumba la pata al yunque. Empieza a desplomarse de lado y el chico corre a sujetarlo, aunque solo sea para frenar la marea de problemas que le ha caído encima ese día. El peso descomunal lo deja aplastado contra los adoquines, con las extremidades estiradas un instante hacia arriba como un grillo despachurrado bajo un pulgar. Lo ves todo desde lejos y silbas para que %art_other% mercenari%o_other% vuelva antes de que haya problemas. Se escabulle justo cuando algunos transeúntes empiezan a darse cuenta. Se encoge de hombros.%SPEECH_ON%No hicimos nada, ¿verdad, señor?%SPEECH_OFF%Asientes.}"
    }
    // context: kid_blacksmith_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "taking a sound leather hiding" es una buena zurra con el cinturón, no "una reprimenda".
        en = "[img]gfx/ui/events/event_97.png[/img]{Your suspicions about the juggler volunteering to be sent to help are confirmed true as you soon see %them_juggler% throwing daggers and axes into the air and wowing the public at large. Seeing the crowds gather, %they_juggler% places a hat upon the cobblestones and continues the act. They throw plenty of coin in, and the applause is deafening as %they_juggler% plays out his final act of five maces at the same time. Bowing, %they_juggler% picks up the hat and rushes back over.%SPEECH_ON%A fine day's work, aye sir?%SPEECH_OFF%Nodding, you ask about the boy's broken sword. %They_juggler% clears the sweat from %their_juggler% brow.%SPEECH_ON%What you say, sir? Get back with the company? Aye sir, I'll get back with the company now.%SPEECH_OFF%Pursing your lips, you look back toward the smithery to see the boy bent over an anvil and taking a sound leather hiding from the returned blacksmith.}"
        es = "[img]gfx/ui/events/event_97.png[/img]{Tus sospechas sobre por qué %art_juggler% malabarista se ofreció voluntari%o_juggler% para ayudar se confirman en cuanto %lo_juggler% ves lanzando dagas y hachas al aire y maravillando al público en general. Al ver que se reúne una multitud, deja un sombrero sobre los adoquines y sigue con el número. La gente echa monedas de sobra, y los aplausos son ensordecedores cuando remata con su número final: cinco mazas a la vez. Con una reverencia, recoge el sombrero y vuelve a toda prisa.%SPEECH_ON%Buen día de trabajo, ¿eh, señor?%SPEECH_OFF%Asintiendo, le preguntas por la espada rota del chico. Se seca el sudor de la frente.%SPEECH_ON%¿Cómo dices, señor? ¿Volver con la compañía? Sí, señor, ya mismo vuelvo con la compañía.%SPEECH_OFF%Apretando los labios, vuelves la vista hacia la herrería y ves al chico doblado sobre un yunque, llevándose una buena zurra con el cinturón del herrero, que ya ha vuelto.}"
    }
    // en = "Apprentice"
    // en base_es
    // context: kid_blacksmith_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // _screen.Text = "[img]gfx/ui/events/event_97.png[/img]{%apprentice% the young apprentice is tasked with helping the kid. %They_apprentice% saunters over to the smithy and starts helping the kid. But %they_apprentice% does more than just help: %they_apprentice% fashions the sword back together in such a way that is stronger than it was to begin with. The blacksmith returns to find the handiwork and demands to know how to do it, almost begging for insight. %apprentice% laughs.%SPEECH_ON%You give me this sword and I\'ll give you the secret my meister passed down to me.%SPEECH_OFF%You didn\'t even know the apprentice knew how to do any of this, but the %sib_apprentice% is nothing if not a sponge in boots. A trade is made with the blacksmith and both parties leave more than happy.}";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_97.png[/img]{%apprentice% the young apprentice is tasked with helping the kid. %They_apprentice% saunters over to the smithy and starts helping the kid. But %they_apprentice% does more than just help: %they_apprentice% fashions the sword back together in such a way that is stronger than it was to begin with. The blacksmith returns to find the handiwork and demands to know how to do it, almost begging for insight. %apprentice% laughs.%SPEECH_ON%You give me this sword and I'll give you the secret my meister passed down to me.%SPEECH_OFF%You didn't even know the apprentice knew how to do any of this, but the %sib_apprentice% is nothing if not a sponge in boots. A trade is made with the blacksmith and both parties leave more than happy.}"
        es = "[img]gfx/ui/events/event_97.png[/img]{%apprentice%, %art_apprentice% joven aprendiz, recibe el encargo de ayudar al chico. Se acerca con aire despreocupado a la herrería y empieza a ayudarlo. Pero no se limita a ayudar: recompone la espada de tal manera que queda más fuerte de lo que era al principio. El herrero vuelve, se encuentra el trabajo hecho y exige saber cómo se hace, casi suplicando que se lo explique. %apprentice% se ríe.%SPEECH_ON%Tú dame esta espada y yo te doy el secreto que me enseñó mi maestro.%SPEECH_OFF%Ni siquiera sabías que %art_apprentice% aprendiz supiera hacer nada de esto, pero %art_apprentice% muchach%o_apprentice% es, ante todo, una esponja con botas. Se cierra un trato con el herrero y ambas partes se van más que contentas.}"
    }
    // en = "Killer"
    // context: kid_blacksmith_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "manténlo" no lleva tilde (mantenlo es llana); "a blacksmith's hiding" es una zurra del herrero, no "la furia de un herrero".
        en = "[img]gfx/ui/events/event_97.png[/img]{You ask %killer% the murderer to help the kid. The %person_killer% obliges with a smile to which the kid seems intuitively offended by. He takes a few steps back and waves the help away.%SPEECH_ON%No sir, I think I'm quite alright. Th-thank you. After all, a man's gotta do what a man's gotta do, right?%SPEECH_OFF%The killer smiles, crouches, and puts a thumb to the kid's cheek and leaves it laying there.%SPEECH_ON%That's right, boy. That's right. A man does what he needs.%SPEECH_OFF%Now you're offended and ask %killer% to go count inventory. %They_killer% rubs the lad's hair and then rises and departs. The kid runs off, but quickly returns with a dagger.%SPEECH_ON%H-here, take this. Keep that creep all the hells away from me, please sir. Got it? I want no business with that %person_killer% and would sooner seek a blacksmith's hiding than see %them_killer% ever again. You take the weapon, you keep %them_killer% away. Deal? Deal, yeah? Take it!%SPEECH_OFF%You measure that the kid's never bargained in his life, that or this is the first time he's felt his life on the line. Either way, you accept the dagger. The kid sighs in relief before returning to the smithy, there working away, and there always keeping an eye over his shoulder.}"
        es = "[img]gfx/ui/events/event_97.png[/img]{Le pides a %killer%, %art_killer% asesin%o_killer%, que ayude al chico. %Art_killer% %hombre_killer% accede con una sonrisa que al chico, por instinto, parece ofenderle. Retrocede unos pasos y rechaza la ayuda con un gesto.%SPEECH_ON%No, señor, creo que estoy bien. G-gracias. Al fin y al cabo, un hombre tiene que hacer lo que tiene que hacer, ¿no?%SPEECH_OFF%%Art_killer% asesin%o_killer% sonríe, se agacha, le pone un pulgar en la mejilla y lo deja ahí.%SPEECH_ON%Así es, chico. Así es. Un hombre hace lo que necesita.%SPEECH_OFF%Ahora el ofendido eres tú, y le pides a %killer% que vaya a hacer inventario. Le revuelve el pelo al muchacho, se levanta y se marcha. El chico sale corriendo, pero vuelve enseguida con una daga.%SPEECH_ON%T-toma, toma esto. Mantén a esa alimaña bien lejos de mí, por favor, señor. ¿Entendido? No quiero tratos con %ese_killer% %hombre_killer%, y antes me ganaría una zurra del herrero que volver a ver%lo_killer%. Tú te quedas el arma y %lo_killer% mantienes lejos. ¿Trato? Trato, ¿sí? ¡Tómala!%SPEECH_OFF%Calculas que el chico no ha regateado en su vida, o que es la primera vez que siente que se juega el pellejo. Sea como sea, aceptas la daga. El chico suspira aliviado antes de volver a la herrería, y allí sigue trabajando, siempre echando un ojo por encima del hombro.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\location\ancient_statue_event.nut
    // context: ancient_statue_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "a %companyname% completos" no concuerda con el nombre de la compañía; sobra "soldado" en "soldado mercenario"; "sacando algo" pierde "a fair share" y "alone"
        en = "[img]gfx/ui/events/event_116.png[/img]{A golden man the size of a castle sits atop his stone throne with such august stature it seems even he, as inanimate as he is, should rule the land. And perhaps the world would be better for it, this nonspeaking entity with such awesome presence would make a finer ruler than the lot of skunks you constantly run into. The bulk of the statue rests upon an enormous disc made of spiraling square stones. Were they coffins it'd take all of two bricks to store the %companyname% whole. %randombrother% tilts %their_randombrother% helm up.%SPEECH_ON%If it ain't the biggest thing I ever seen I don't know what is.%SPEECH_OFF%%randombrother2% smirks and makes a reach for the sellsword's crotch.%SPEECH_ON%I thought the womenfolk said that little worm was the biggest thing to ever be seen!%SPEECH_OFF%As the company laughs, you step forward and look up. You're not much for kneeling, but you feel the urge here. The statue's staring out at the world with firm authority, and its hands are out at the sides, one upon a sword staked into the earth, and the other supinated as though to weigh justice herself. You nod at the golden sheen present before you. That there is not a single scratch of a wouldbe robber suggests its austere presence still has some ethereal grip on the world. But that doesn't make sense. Any smart man would be nicking a fair share from the statue's shins alone. A few mercenaries ask if they can have a stab at collecting some gold for themselves.}"
        es = "[img]gfx/ui/events/event_116.png[/img]{Un hombre dorado del tamaño de un castillo se sienta en su trono de piedra con tanta majestuosidad que parece que incluso él, por inanimado que sea, debería gobernar la tierra. Y quizás el mundo estaría mejor así: esta entidad muda de presencia tan imponente sería mejor gobernante que el montón de bribones con los que te cruzas constantemente. La mayor parte de la estatua descansa sobre un enorme disco hecho de piedras cuadradas dispuestas en espiral. Si fueran ataúdes, bastarían dos de esos bloques para guardar a todos los de %companyname%. %randombrother% se echa el yelmo hacia atrás.%SPEECH_ON%Si esto no es lo más grande que he visto, no sé qué lo será.%SPEECH_OFF%%randombrother2% sonríe con sorna y hace ademán de agarrarle la entrepierna %al_randombrother% mercenari%o_randombrother%.%SPEECH_ON%¡Creía que las mujeres decían que ese gusanito era lo más grande que se había visto jamás!%SPEECH_OFF%Mientras la compañía se ríe, avanzas y miras hacia arriba. No eres mucho de arrodillarte, pero aquí sientes el impulso. La estatua mira al mundo con firme autoridad y tiene las manos a los lados: una sobre una espada clavada en la tierra y la otra en supinación, como si sopesara a la mismísima justicia. Asientes ante el brillo dorado que tienes delante. Que no haya ni un solo rasguño de algún aspirante a ladrón sugiere que su austera presencia aún tiene cierto dominio etéreo sobre el mundo. Pero eso no tiene sentido. Cualquier hombre listo se llevaría una buena tajada solo de las espinillas de la estatua. Algunos mercenarios preguntan si pueden intentar llevarse algo de oro para ellos.}"
    }
    // context: ancient_statue_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "Cierras el espacio... con el puño" no traduce "fist the gap" (meter el puño en la rendija); faltaba "angrily"
        en = "[img]gfx/ui/events/event_116.png[/img]{The statue is so huge perhaps it scared off the lesser scapegraces by superstition alone. You've no reason to let a good thing go, like a nearly endless pile of gold shaped into something 'pretty.' To hell with history and the artistry. You tell the men to have it. They leap to the task with the tools available, but the second %randombrother% makes contact %they_randombrother% falls limp and slumps against the statue. Another mercenary goes to help %them_randombrother%, brushes the enormous toe there, and collapses atop the sellsword. Just as the company begins to panic, the two mercenaries bolt back to their feet and start screaming about amazing sights, sights beyond this world, sights of the future itself!\n\n Invigorated by this, the company gladly runs themselves into the statue, the lot banging against its giant toes and falling backward like mimes unexpectedly finding a very real wall. It's the most ridiculous thing you've ever seen, but each sellsword springs back to their feet spilling out fantastic stories. You shrug and walk up to the statue yourself, standing before the big toe with its big toenail. The company urge you forward. Sighing, you put your hand out and touch the toenail. Nothing. Nothing happens. You fist the gap between the nail and golden flesh. You angrily put both hands to the toe like it owes you money. Nothing. Well then. Looks like you've riches to harvest. You draw your sword out...}"
        es = "[img]gfx/ui/events/event_116.png[/img]{La estatua es tan enorme que tal vez ahuyentó a los bribones de menor calaña por pura superstición. No tienes motivo para dejar pasar algo bueno, como una pila casi interminable de oro con forma de algo 'bonito'. Al diablo con la historia y el arte. Les dices a los hombres que se hagan con ello. Se lanzan a la tarea con las herramientas que tienen, pero en cuanto %randombrother% la toca, se queda inerte y se desploma contra la estatua. Otro mercenario va a ayudar%lo_randombrother%, roza el enorme dedo del pie y se derrumba encima de %el_randombrother%. Justo cuando la compañía empieza a entrar en pánico, los dos mercenarios se levantan de un salto y se ponen a gritar sobre visiones asombrosas, visiones más allá de este mundo, ¡visiones del futuro mismo!\n\nAnimada por esto, la compañía se lanza encantada contra la estatua: todos se estrellan contra sus dedos gigantes y caen hacia atrás como mimos que encuentran inesperadamente una pared muy real. Es lo más ridículo que has visto nunca, pero cada mercenario se levanta de un salto soltando historias fantásticas. Te encoges de hombros y te acercas tú mismo a la estatua, hasta plantarte frente al dedo gordo y su enorme uña. La compañía te anima a seguir. Con un suspiro, extiendes la mano y tocas la uña. Nada. No pasa nada. Metes el puño en la rendija entre la uña y la carne dorada. Con rabia, agarras el dedo con ambas manos como si te debiera dinero. Nada. Pues bien. Parece que tienes riquezas que cosechar. Desenvainas la espada...}"
    }
    // context: ancient_statue_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "viento arado" es calco de "plow wind" (vendaval); "la rompió" mete el usted frente al tuteo del resto del evento; "oxidada en bronce" por "rusted bronze"
        en = "[img]gfx/ui/events/event_116.png[/img]{You step back and flip your sword crosswise and crouch at the knees to brace for impact. The killer's two-hander slams against your sword and just like that the world snaps away and still frozen in a parry you can feel the issuance of time and space fly by your sides like a plow wind, and ungodly amounts of suffering, screaming, living and dying, and in the far distance a speck of light that fast approaches until you arrive back in your body and your sword hits the statue and swings backward so hard it flies out of your hands and sails through the air until stabbing into the earth with an earthen chunk. The men look about one another. You go and fetch your sword.%SPEECH_ON%I think you broke it, sir.%SPEECH_OFF%Says %randombrother% as %they_randombrother% gets handsy with the pinky toe. You tell %them_randombrother% and the rest of the sellswords to pack their things, it's time to leave this place. Looking at the statue, you see that it is all rusted bronze now. You think to ask one of the mercenaries if it had been gold earlier, but you already know the answer to that. Instead, you stare at the head of the statue. At the face. At the very familiar face.}"
        es = "[img]gfx/ui/events/event_116.png[/img]{Das un paso atrás, cruzas la espada y flexionas las rodillas para aguantar el impacto. El mandoble del asesino choca contra tu espada y, sin más, el mundo se desvanece; todavía inmóvil en plena parada, sientes el devenir del tiempo y el espacio pasar a tu lado como un vendaval, y cantidades impías de sufrimiento, gritos, vidas y muertes, y a lo lejos un punto de luz que se acerca deprisa hasta que vuelves a tu cuerpo y tu espada golpea la estatua y rebota con tanta fuerza que se te escapa de las manos y surca el aire hasta clavarse en el suelo levantando un terrón. Los hombres se miran unos a otros. Vas a recoger tu espada.%SPEECH_ON%Creo que la rompiste, señor.%SPEECH_OFF%Dice %randombrother% mientras manosea el dedo meñique del pie. Les dices a %el_randombrother% y al resto de los mercenarios que recojan sus cosas: es hora de irse de este lugar. Al mirar la estatua, ves que ahora es toda de bronce oxidado. Piensas en preguntarle a algún mercenario si antes era de oro, pero ya sabes la respuesta. En cambio, te quedas mirando la cabeza de la estatua. El rostro. Ese rostro tan familiar.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\location\ancient_temple_enter_event.nut
    // context: ancient_temple_enter_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: errata "un una"; "frieze" es friso, no pared; faltaba "slinging your legs over the earth"
        en = "[img]gfx/ui/events/event_111.png[/img]{Only half of the temple's entrance is visible, the rest long since sunk into the earth as though unsure whether to be coffin or mausoleum. Along a visible frieze you can see a stony relief of tables being thrown and monied men running from what looks like an armored skeleton with a whip. A few of the mercenaries seem uncomfortable with the idea of going in, but you've the notion that others have felt that way as well and have thus left the place unmolested.\n\n You take out a torch and enter with a sellsword's spirit and robber's resolve. After gathering supplies, you crouch and enter the temple by slinging your legs over the earth and jumping into the steps below. The clap of your boots snickers into the marbled halls and you wave the torch before you as if to watch the echoes go. Looking back, the light between the shelf of earth and the temple top silhouetting your company as though they were a throng of sextons satisfied at their work. %volunteer% shakes %their_volunteer% head and says %they're_volunteer% coming with. The rest of the company mutually agrees to keep watch.}"
        es = "[img]gfx/ui/events/event_111.png[/img]{Solo se ve la mitad de la entrada del templo; el resto se hundió en la tierra hace mucho, como si no supiera si ser ataúd o mausoleo. A lo largo de un friso visible distingues un relieve de piedra con mesas volcadas y hombres adinerados que huyen de lo que parece un esqueleto con armadura y un látigo. Algunos mercenarios parecen incómodos con la idea de entrar, pero sospechas que otros sintieron lo mismo y por eso dejaron el lugar intacto.\n\nSacas una antorcha y entras con el espíritu de un mercenario y la determinación de un ladrón. Tras reunir suministros, te agachas y entras en el templo pasando las piernas por encima del borde de tierra y saltando a los escalones de abajo. El taconeo de tus botas resuena por los pasillos de mármol y agitas la antorcha frente a ti como si quisieras ver alejarse los ecos. Al mirar atrás, la luz que entra entre la repisa de tierra y lo alto del templo recorta la silueta de tu compañía como si fueran una cuadrilla de sepultureros satisfechos con su trabajo. %volunteer% niega con la cabeza y dice que va contigo. El resto de la compañía acuerda montar guardia.}"
    }
    // context: ancient_temple_enter_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_111.png[/img]{The sides of the halls are blanketed in military mosaics so large they're more fit to a whole campaign than any single battle. One parcel in particular stretches seemingly forever down the hall, a scene of armored men running roughshod over what looks like a barbarian horde so thick in number they lose humanity and begin to look indiscernible from bugs. Your torch bulbs and dims in the dark, the light bringing an artist's battlefield to an orangish life and in the corners you find depictions of righteous torture and outrage. Between the lockstep forces and the disassembled mob, it looks like order and chaos have come to clash, and while order is surely set to win, it is chaos itself which is driving the way to victory.\n\n %volunteer% whistles. You look to see %their_volunteer% torch flaring in the distance like an ignis fatuus. You run over to find %them_volunteer% holding a vial with a strange liquid inside. The sellsword swings %their_volunteer% torch to an alcove in the wall. A marbled post hold the center and there's a throng of skeletons at its base.%SPEECH_ON%I found the vial on the pedestal there. And I see two more like it yonder, but they're behind gates.%SPEECH_OFF%You ask the sellsword why %they_volunteer% didn't tell you about the bodies. %They_volunteer% shrugs.%SPEECH_ON%They ain't breathing, then I ain't caring. You wanna make a try for the other two flasks or no?%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_111.png[/img]{Los lados de los pasillos están cubiertos de mosaicos militares tan grandes que parecen más propios de toda una campaña que de una sola batalla. Uno en particular se extiende aparentemente sin fin por el pasillo: una escena de hombres con armadura arrasando lo que parece una horda bárbara tan numerosa que pierde toda humanidad y empieza a parecer indistinguible de un enjambre de insectos. Tu antorcha chisporrotea y se atenúa en la oscuridad, la luz da una vida anaranjada al campo de batalla del artista y en los rincones encuentras escenas de tortura y furia justicieras. Entre las fuerzas que marchan al paso y la turba desordenada, parece que el orden y el caos han venido a chocar, y aunque sin duda el orden está destinado a ganar, es el propio caos el que le abre el camino a la victoria.\n\n%volunteer% silba. Al mirar, ves su antorcha ardiendo a lo lejos como un fuego fatuo. Corres hacia allí y %lo_volunteer% encuentras sosteniendo un frasco con un líquido extraño dentro. %Art_volunteer% mercenari%o_volunteer% dirige la antorcha hacia un nicho de la pared. Un pilar de mármol ocupa el centro y hay un montón de esqueletos a sus pies.%SPEECH_ON%Encontré el frasco ahí, en el pedestal. Y veo otros dos iguales por allá, pero están detrás de unas puertas.%SPEECH_OFF%Le preguntas %al_volunteer% mercenari%o_volunteer% por qué no te avisó de los cuerpos. Se encoge de hombros.%SPEECH_ON%Si no respiran, no me importan. ¿Quieres intentar sacar los otros dos frascos o no?%SPEECH_OFF%}"
    }
    // context: ancient_temple_enter_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "óxido" no está en el inglés ("slag" son restos de fundición)
        en = "[img]gfx/ui/events/event_111.png[/img]{The last vial is behind another gate, an unsettling one to look at just by an architectural standpoint. There are not mere stone bars here, but twisted iron spires scarred with scoria and slag, and the gate is not at chest level, but at your shins. The vial itself is on a further rise, meaning you'd have to reach under the wall and then up again to get it. The voice returns.%SPEECH_ON%From me all comes to being, from me all shall be in the end. When man crosses the earth, I follow in his footsteps.%SPEECH_OFF%You stand in the silence and look over at %volunteer%. %They_volunteer% shrugs.}"
        es = "[img]gfx/ui/events/event_111.png[/img]{El último frasco está detrás de otra puerta, inquietante de ver solo desde el punto de vista arquitectónico. Aquí no hay simples barrotes de piedra, sino agujas de hierro retorcidas y marcadas de escoria y restos de fundición, y la puerta no llega a la altura del pecho, sino a la de tus espinillas. El frasco está además en un nivel más alto, así que tendrías que meter el brazo por debajo de la pared y luego subirlo para alcanzarlo. La voz regresa.%SPEECH_ON%De mí proviene todo ser, de mí todo será al final. Cuando el hombre atraviesa la tierra, yo sigo sus pasos.%SPEECH_OFF%Te quedas en silencio y miras a %volunteer%. Se encoge de hombros.}"
    }
    // en = "H"
    // context: ancient_temple_enter_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: errata "inferuir"; "gets up at the vial" es subir el brazo hasta el frasco, no levantarse; "linterna" por "torch"; "sticky paper" es papel pegajoso (el chiste), no adhesivo; "los regresas" por "return to the company" (vuelves tú)
        en = "[img]gfx/ui/events/event_111.png[/img]{As soon as the word leaves your lips the gate jolts up. You pensively stare at the remaining gap. %volunteer% crouches down and slings %their_volunteer% arm under the gateway's top and gets up at the vial. %Their_volunteer% fingers scrape its glass while the gate's spires rattle in their catches like a bear reluctantly letting someone brush its teeth. The %person_volunteer% finally pinches the vial between two fingers and scissor-flips it into the safe embrace of %their_volunteer% palm. %They_volunteer% stands up and hands it over.%SPEECH_ON%Simple enough, eh?%SPEECH_OFF%You nod but then turn around with your torch and yell out, demanding to know who was talking. There is no answer. A brief search in the darkness turns up no hidey-holes or dugouts, but you do find scraps and notes with drawings on them. The pages seem to indicate the vials are capable of killing wiedergangers with but a single touch of the liquid within each flask. There is also a sticky paper with a crudely drawn woman on it. Whoever was here, you don't care. You take the vials back out and return to the %companyname%. They draw swords at the sound of you, then sheepishly sheathe them once they see your face.%SPEECH_ON%Sorry captain, thought ya a mite dead. And walking. A walking dead man.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_111.png[/img]{En cuanto la palabra sale de tus labios, la puerta se alza de una sacudida. Miras con aire pensativo el hueco que queda. %volunteer% se agacha, pasa el brazo por debajo del borde de la puerta y lo sube hacia el frasco. Sus dedos rozan el cristal mientras las agujas de la puerta traquetean en sus enganches como un oso que deja a regañadientes que alguien le cepille los dientes. Al fin, pinza el frasco entre dos dedos y, con un giro de tijera, lo deja caer a salvo en la palma de la mano. Se levanta y te lo entrega.%SPEECH_ON%Bastante simple, ¿eh?%SPEECH_OFF%Asientes, pero luego te das la vuelta con la antorcha y gritas, exigiendo saber quién estaba hablando. No hay respuesta. Una breve búsqueda en la oscuridad no revela escondrijos ni refugios, pero sí papeles sueltos y notas con dibujos. Las páginas parecen indicar que los frascos pueden matar wiedergangers con un solo toque del líquido que contiene cada uno. También hay un papel pegajoso con una mujer toscamente dibujada. Quienquiera que estuviera aquí, te da igual. Sacas los frascos y vuelves con %companyname%. Desenvainan al oírte y, al ver tu cara, envainan avergonzados.%SPEECH_ON%Perdón, capitán, te creímos un pelín muerto. Y andando. Un muerto andante.%SPEECH_OFF%}"
    }
    // en = "I"
    // context: ancient_temple_enter_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "te largas" rebaja "fark you"; "Es más pesado" no concuerda con la puerta; "el esqueleto" por los esqueletos del primer frasco; "acertijo" por "riddler" (el de los acertijos); sobra "duelen pero", que el inglés no tiene
        en = "[img]gfx/ui/events/event_111.png[/img]{As soon as the word leaves your lips the gate jolts up. You pensively stare at the remaining gap. %volunteer% crouches down and slings %their_volunteer% arm under the gateway's top and gets up at the vial. %Their_volunteer% fingers scrape its glass while the gate's spires rattle in their catches. The voice suddenly booms back in.%SPEECH_ON%G-go fark myself? How about fark you, uh, pal!%SPEECH_OFF%With that, the gate's catch fails and its tips sink down and spear %volunteer%'s arm. The %person_volunteer% yells out and you drop to your knees and yank the gate back up. It's heavier than expected and when you let go it slams with unnerving finality, a strip of the sellsword's arm here, a gush of %their_volunteer% veins there. You wrap the wound and help the %person_volunteer% toward the exit, all the while waving the torch around to ward off any would be ambush. However, while heading out, you pause and look at the skeleton's you found beside the first flask. You take a drop from the vial and touch it to your fingertips. No response. You then put your finger on one of the bones and it sizzles and smokes. %volunteer% laughs.%SPEECH_ON%That's why you're captain, sir. Intuition like that can take you far!%SPEECH_OFF%You never hear the mysterious voice again and, not wanting to sound insane, make no reference of the riddler to the %companyname%.\n\n %volunteer%'s wounds won't be the end of %them_volunteer%. Tis but a small price to pay for the ancient vials.}"
        es = "[img]gfx/ui/events/event_111.png[/img]{En cuanto la palabra sale de tus labios, la puerta se alza de una sacudida. Miras con aire pensativo el hueco que queda. %volunteer% se agacha, pasa el brazo por debajo del borde de la puerta y lo sube hacia el frasco. Sus dedos rozan el cristal mientras las agujas de la puerta traquetean en sus enganches. De repente, la voz vuelve a retumbar.%SPEECH_ON%¿Q-que me vaya a la mierda? ¡Vete tú a la mierda, eh... amigo!%SPEECH_OFF%Dicho esto, el enganche de la puerta cede y sus puntas se hunden y atraviesan el brazo de %volunteer%. %Art_volunteer% %hombre_volunteer% grita, y tú te dejas caer de rodillas y tiras de la puerta hacia arriba. Pesa más de lo esperado y, cuando la sueltas, cae de golpe con una contundencia inquietante: una tira del brazo %del_volunteer% mercenari%o_volunteer% por aquí, un chorro de sus venas por allá. Vendas la herida y ayudas %al_volunteer% herid%o_volunteer% a llegar a la salida, agitando la antorcha todo el rato para ahuyentar cualquier posible emboscada. Sin embargo, al salir, te detienes a mirar los esqueletos que encontraste junto al primer frasco. Te echas una gota del frasco en las yemas de los dedos. Nada. Luego pones el dedo sobre uno de los huesos y chisporrotea y echa humo. %volunteer% se ríe.%SPEECH_ON%Por eso eres capitán, señor. ¡Con esa intuición se llega lejos!%SPEECH_OFF%Nunca vuelves a oír la voz misteriosa y, para que no parezca que has perdido el juicio, no le cuentas nada a %companyname% sobre el de los acertijos.\n\nLas heridas de %volunteer% no serán su fin. No es más que un pequeño precio a pagar por los antiguos frascos.}"
    }
    // en = "K"
    // context: ancient_temple_enter_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "media cabeza" por "half a brain"; "huesos de ratas mohosas" (lo mohoso son los huesos); se recupera el "Kidding" del juego de palabras
        en = "[img]gfx/ui/events/event_111.png[/img]{The man's eyes gleam in the dark and each glance is like an ember scattered.%SPEECH_ON%Ya mean it? I can join ya? Alright!%SPEECH_OFF%He slowly gets to his feet as though quick action might lead to even quicker reneging. He puts a hand out, which you do not shake.%SPEECH_ON%My name's %idiot%. I've got half a brain, rest is wood and pulp. I'm kindling, of course. Kidding. Kindling. Get it?%SPEECH_OFF%You look at %volunteer% who stabs the man in the chest. The idiot's face goes tense as he looks down at the sword impaling his heart.%SPEECH_ON%Hey. I think you killed me.%SPEECH_OFF%%volunteer% nods.%SPEECH_ON%Aye. I did. You got seconds. Speech?%SPEECH_OFF%The riddler thinks briefly.%SPEECH_ON%Well, I didn't prepare one, but... since... ya... asked...%SPEECH_OFF%He dies on the word and the blade. The sellsword cleans the blood and picks through the body, finding only musty rat bones in his pockets. When %they_volunteer% lets the corpse go it clunks the tile rather hollowly. You crouch and feel the man's skull and find he actually wasn't kidding, its half made of wood! You look at %volunteer% who shrugs.%SPEECH_ON%He could have shat gold for all I care, I ain't putting up with his mouth. Besides, look at his eyes! That fool was blind as a bat.%SPEECH_OFF%The riddler's eyes are a blank grey. Who knows how long he spent in this temple.}"
        es = "[img]gfx/ui/events/event_111.png[/img]{Los ojos del hombre brillan en la oscuridad y cada mirada es como una brasa que se dispersa.%SPEECH_ON%¿Lo dices en serio? ¿Puedo unirme a ustedes? ¡Genial!%SPEECH_OFF%Se levanta despacio, como si moverse deprisa pudiera provocar una retractación todavía más rápida. Te tiende la mano, que no estrechas.%SPEECH_ON%Me llamo %idiot%. Tengo medio cerebro, el resto es madera y pulpa. Tengo madera de mercenario, por supuesto. Es broma. Madera. ¿Entiendes?%SPEECH_OFF%Miras a %volunteer%, que le clava la espada al hombre en el pecho. El idiota tensa la cara al bajar la vista hacia la espada que le atraviesa el corazón.%SPEECH_ON%Oye. Creo que me mataste.%SPEECH_OFF%%volunteer% asiente.%SPEECH_ON%Sí. Eso hice. Te quedan segundos. ¿Unas últimas palabras?%SPEECH_OFF%El de los acertijos se lo piensa un momento.%SPEECH_ON%Bueno, no preparé nada, pero... ya que... lo... pides...%SPEECH_OFF%Muere sobre la palabra y sobre la hoja. %Art_volunteer% mercenari%o_volunteer% limpia la sangre y registra el cuerpo, pero solo encuentra huesos de rata mohosos en sus bolsillos. Cuando suelta el cadáver, golpea las baldosas con un ruido bastante hueco. Te agachas, palpas el cráneo del hombre y descubres que de verdad no bromeaba: ¡está medio hecho de madera! Miras a %volunteer%, que se encoge de hombros.%SPEECH_ON%Por mí, como si cagara oro: no le iba a aguantar esa boca. ¡Además, mírale los ojos! Ese tonto estaba ciego como un murciélago.%SPEECH_OFF%Los ojos del de los acertijos son de un gris apagado. Quién sabe cuánto tiempo pasó en este templo.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\location\ancient_watchtower_event.nut
    // context: ancient_watchtower_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "sigue allí" pierde que el esqueleto ha aparecido abajo; faltaba "damn" en "Damn near right to the clouds"
        en = "[img]gfx/ui/events/event_108.png[/img]{The spire is twice as tall as any castle you've seen, and narrower than any tower. It is as though someone had all the material to build a fortress, and instead of building the bastion they built the spire. %randombrother% squints as %they_randombrother% looks up at its rise.%SPEECH_ON%Like it just goes on forever, sir. Damn near right to the clouds.%SPEECH_OFF%You enter with a map and a few mercenaries. Inside you find a glass sphere sitting on a hollowed lectern. Inside the bulb sits some powdery remains. Perhaps the last issuance of magic, you know not. Your intuition tells you that whoever dwelled in this slender refuge did not always take the stairs. But you'll have to. The climb is brutal and long. At the top you find yet another bulb, this one jagged and shattered, and beneath the glass a skeleton. A broken staff lies nearby. You shake your head and head toward the crenelations. So far are the sights the world itself seems to curve at the horizon, a strange trick of the eye no doubt. You draw the geography upon your map, take a five minute breather, then descend back down.\n\nWhen you get to the bottom the skeleton is there with its staff beside it and the busted bulb is on the lectern. The whole group of sellswords run out the door and you're hot on their heels. Looking back, you see the spire's gate slowly close with a mighty metal clank.}"
        es = "[img]gfx/ui/events/event_108.png[/img]{La aguja es el doble de alta que cualquier castillo que hayas visto, y más estrecha que cualquier torre. Es como si alguien hubiera tenido todo el material para construir una fortaleza y, en lugar de levantar el bastión, hubiera levantado la aguja. %randombrother% entorna los ojos mientras sigue con la vista su altura.%SPEECH_ON%Es como si no se acabara nunca, señor. Llega casi hasta las malditas nubes.%SPEECH_OFF%Entras con un mapa y unos cuantos mercenarios. Dentro encuentras una esfera de cristal sobre un atril hueco. En el interior de la esfera hay unos restos polvorientos. Quizá lo último que quedó de alguna magia; no lo sabes. Tu intuición te dice que quien habitó este estrecho refugio no siempre subía por las escaleras. Pero tú tendrás que hacerlo. La subida es brutal y larga. Arriba encuentras otra esfera, esta mellada y hecha añicos, y bajo el cristal un esqueleto. Cerca yace un bastón roto. Niegas con la cabeza y te diriges a las almenas. Las vistas llegan tan lejos que el mundo mismo parece curvarse en el horizonte; un extraño engaño de la vista, sin duda. Trazas la geografía en tu mapa, te tomas cinco minutos de respiro y vuelves a bajar.\n\nCuando llegas abajo, el esqueleto está allí, con el bastón a su lado, y la esfera rota está sobre el atril. Todos los mercenarios salen corriendo por la puerta y tú vas pisándoles los talones. Al mirar atrás, ves que la puerta de la aguja se cierra lentamente con un tremendo estruendo metálico.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\location\fountain_of_youth_event.nut
    // context: fountain_of_youth_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_114.png[/img]{You throw the waterskin aside and put your mouth into the puddle and drink. The world beneath the puddle's surface is empty and silent. Your lips move, your throat gulps, but there is nothing to drink here. You scream. There is nothing. Not even a feeling. Just the notion of fear, a tickle with no means to scratch it. When you put your hands to the earth to try and remove yourself, you find that you cannot leave the puddle.\n\n Faint faces wink in and out of the void. They are like the tree's, dramatically inanimate, painfully issued from past to present to future, and here they approach, gathering in number, bubbling and jostling forward, turning this black hell into a frothy white. As they near, you realize you've been not looking right. Individually, they are but faces without presence. Taken as a whole, as the great white sheet on the approach, you realize that they make up one large face: yours. And it is laughing.\n\n Screaming, you finally fall back out of the puddle. %randombrother% has you under %their_randombrother% arm and %they're_randombrother% looking at you with concern.%SPEECH_ON%Sir, are you alright? You was napping then your head slid into the water there.%SPEECH_OFF%You look up, thinking to see the grotesque tree and its awful faces. It is not there and no matter how many times you look or in how many places, it is never there again.}"
        es = "[img]gfx/ui/events/event_114.png[/img]{Tiras el odre a un lado, metes la boca en el charco y bebes. El mundo bajo la superficie del charco está vacío y en silencio. Tus labios se mueven, tu garganta traga, pero aquí no hay nada que beber. Gritas. No hay nada. Ni siquiera una sensación. Solo la idea del miedo, un picor sin forma de rascarlo. Cuando apoyas las manos en la tierra para intentar salir, descubres que no puedes abandonar el charco.\n\nRostros tenues aparecen y desaparecen en el vacío. Son como los del árbol, rotundamente inanimados, arrancados dolorosamente del pasado al presente y al futuro, y ahí se acercan, cada vez más numerosos, burbujeando y empujándose hacia delante, convirtiendo este infierno negro en un blanco espumoso. A medida que se acercan, te das cuenta de que no estabas mirando bien. Uno a uno, no son más que rostros sin presencia. Vistos en conjunto, como la gran sábana blanca que se aproxima, te das cuenta de que forman un único rostro enorme: el tuyo. Y se está riendo.\n\nEntre gritos, por fin caes de espaldas fuera del charco. %randombrother% te sujeta bajo el brazo y te mira con preocupación.%SPEECH_ON%Señor, ¿estás bien? Te echaste una siesta y se te fue la cabeza al agua.%SPEECH_OFF%Levantas la vista, pensando que verás el árbol grotesco y sus horribles caras. No está, y por más veces que mires y por más sitios que recorras, nunca vuelve a estar ahí.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\location\goblin_city_enter_event.nut
    // context: goblin_city_enter_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_119.png[/img]{%randombrother% shakes %their_randombrother% head.%SPEECH_ON%May the old gods have mercy upon us for allowing such a sight.%SPEECH_OFF%The goblin city is sequestered between opposing mountains. Saying the goblins built their city around the mountains is like saying a soldier sheathed his sword in his enemy's chest. The gibbering greenskins didn't add to the terrain, they desecrated the place whole, putting mines where trees used to be, constructing a maze of rusted shanties and lean-tos, raising cultish totems and digging primitive sacrificial pits, piling unused timber as though the mutilation of the mountain was not truly finished without blatant waste.\n\n But beyond the goblin rubbish does stand a central core of the city, a number of towers unambiguously set apart from the riffraff. These are clearly ancient requisitions, the stonework being unlike anything you've ever seen and surely beyond the greenskin's scope of construct. The goblins walking amongst the walls are upright and boastful as though invigorated by being allowed to stride such hallowed grounds. Nestled inside the fortress seem to be of some sort of higher nobility, well dressed goblins with servants mucking about, which means the same thing it does when it comes to humans: there's good loot to be had.\n\n A rare sight are the little ones running about. Families, if that's what the greenskins truly have, will mean that a fight here will be a vicious one. The little maggots will have more to protect than just their savageness and greed, and that which must extend itself beyond its own vices is also that which has been weakened.}"
        es = "[img]gfx/ui/events/event_119.png[/img]{%randombrother% niega con la cabeza.%SPEECH_ON%Que los viejos dioses se apiaden de nosotros por permitir algo así.%SPEECH_OFF%La ciudad goblin está recluida entre dos montañas enfrentadas. Decir que los goblins construyeron su ciudad en torno a las montañas es como decir que un soldado envainó la espada en el pecho de su enemigo. Los pieles verdes, con su parloteo, no le añadieron nada al terreno: profanaron el lugar entero, abrieron minas donde antes había árboles, levantaron un laberinto de chabolas oxidadas y cobertizos, alzaron tótems de culto y cavaron toscos fosos para sacrificios, y amontonaron madera sin usar, como si la mutilación de la montaña no estuviera completa sin un desperdicio descarado.\n\nPero más allá de la basura goblin sí se alza un núcleo central de la ciudad, un puñado de torres que se distinguen sin lugar a dudas de la chusma. Son a todas luces construcciones antiguas requisadas: la cantería no se parece a nada que hayas visto y queda sin duda fuera del alcance de lo que saben construir los pieles verdes. Los goblins que caminan entre esos muros van erguidos y ufanos, como si los envalentonara poder pisar un suelo tan sagrado. Los que se cobijan dentro de la fortaleza parecen ser una especie de alta nobleza, goblins bien vestidos con sirvientes trajinando a su alrededor, lo que significa lo mismo que entre los humanos: hay buen botín que sacar.\n\nAlgo raro de ver son los pequeños que corretean por ahí. Las familias, si es que los pieles verdes de verdad las tienen, harán que una pelea aquí sea despiadada. Esos gusanos tendrán algo más que proteger que su salvajismo y su codicia, y aquello que debe extenderse más allá de sus propios vicios es también aquello que se ha debilitado.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\location\golden_goose_event.nut
    // context: golden_goose_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "pan moldeado" por "molded" (mohoso); "ropa real" es ambiguo, es vestimenta de la realeza
        en = "[img]gfx/ui/events/event_125.png[/img]{You step into the bowels of the ship. It's completely vacant save for a stump with an axehead chopped into it. %observer% looks at it.%SPEECH_ON%There's an axehead.%SPEECH_OFF%Nodding, you say there it is indeed. But the metal of it carries veins of a sort of golden hue. Getting closer to the stump, you can see embers flittering upward out of the wedge. %observer% taps your shoulder and you find %them_observer% pointing into the dark of the ship.%SPEECH_ON%Skeleton. Dead one.%SPEECH_OFF%Just faintly can you see the pale bones. As you draw near, the clothing becomes apparent, and readily obvious as royal attire. There is a cracked ale horn in one hand and a molded loaf of bread in the other. His jacket is blown open and shredded by splinters. Upon closer inspection, some of the wood is embedded in his brainpan.}"
        es = "[img]gfx/ui/events/event_125.png[/img]{Entras en las entrañas del barco. Está completamente vacío, salvo por un tocón con una cabeza de hacha clavada. %observer% la mira.%SPEECH_ON%Ahí hay una cabeza de hacha.%SPEECH_OFF%Asientes y dices que, en efecto, ahí está. Pero su metal tiene vetas de un tono como dorado. Al acercarte al tocón, ves ascuas que revolotean hacia arriba desde la cuña. %observer% te toca el hombro y %lo_observer% ves señalando hacia la oscuridad del barco.%SPEECH_ON%Un esqueleto. Uno muerto.%SPEECH_OFF%Apenas distingues los huesos pálidos. Al acercarte, la ropa se hace visible y salta a la vista que es vestimenta de la realeza. Tiene un cuerno de cerveza agrietado en una mano y una hogaza de pan mohosa en la otra. La chaqueta está reventada y hecha jirones por las astillas. Al mirar más de cerca, ves que tiene astillas clavadas en el cráneo.}"
    }
    // context: golden_goose_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_125.png[/img]{Seeing as how the skeleton and his beer and bread ain't going anywhere, you leave it be. The axehead however draws your eye again. %observer% walks over to the stump and the glowing wedge. %They_observer% tries to take it out. Finding no luck there, %they_observer% steps back and kicks it further in. The trump cracks in twain and the sellsword suddenly flies upside down and the axehead shoots through the roof of the boat and you can hear it clunk and clatter down its sides outside. Debris and smoke drift lazily about. The sellsword gets up and pats %themselves_observer% off.%SPEECH_ON%What in all the hells was that?%SPEECH_OFF%You shush %them_observer% and point. A little golden goose squats where the stump's base used to be. The sheen of its metal glows and swirls. You've heard stories of a golden goose, but never thought they were anything beyond that!}"
        es = "[img]gfx/ui/events/event_125.png[/img]{Como el esqueleto, con su cerveza y su pan, no va a ir a ninguna parte, lo dejas estar. La cabeza de hacha, en cambio, vuelve a llamarte la atención. %observer% se acerca al tocón y a la cuña resplandeciente. Intenta sacarla. Como no hay suerte, retrocede un paso y le da una patada que la hunde más. El tocón se parte en dos, %art_observer% mercenari%o_observer% sale volando patas arriba y la cabeza de hacha atraviesa el techo del barco; la oyes golpear y repiquetear por el casco, fuera. Restos y humo flotan perezosamente por el aire. %Art_observer% mercenari%o_observer% se levanta y se sacude el polvo.%SPEECH_ON%¿Por todos los infiernos, qué fue eso?%SPEECH_OFF%Le mandas callar y señalas. Un pequeño ganso dorado está agazapado donde antes estaba la base del tocón. El brillo de su metal reluce y se arremolina. Has oído historias sobre un ganso dorado, ¡pero nunca creíste que fueran más que eso!}"
    }
    // context: golden_goose_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_125.png[/img]{%observer% stumbles forward.%SPEECH_ON%Sir, what are you doing?%SPEECH_OFF%You wave %them_observer% off and pick the golden goose up. Holding it in both hands, it feels oddly warm. And it isn't exploding or melting your face. You can feel its metal rippling ever so slightly against your fingers. It might even be growing? With the treasure safely huddled beneath your elbow, you wonder why the skeleton didn't fare better. %observer% walks up and touches the golden goose on the head, but quickly recoils. You ask if it burned %them_observer%. The sellsword purses %their_observer% lips.%SPEECH_ON%Really, sir? Was it not obvious?%SPEECH_OFF%%They_observer% sticks %their_observer% finger in %their_observer% mouth. You tell %them_observer% to not be so snappy with %their_observer% commander or you'll throw the goose at %them_observer% and see if it makes short work of %them_observer% as it did the skeleton. The %person_observer% shrugs.%SPEECH_ON%Oh look at the man chosen by a shiny bauble, put a blade beneath a wing so it can knight ye, or hells why not put it on yer head and call yerself king already?%SPEECH_OFF%You look down at the goose. A drop of red blood runs down its length, turns gold, and drops to the ground with a tiny plink. You pick it up and bite it. The gold smooshes satisfyingly in your teeth and you then throw it to %observer%. It does not burn %them_observer% this time, and you realize you may have found the genuine Golden Goose from the tales!}"
        es = "[img]gfx/ui/events/event_125.png[/img]{%observer% da un traspié hacia delante.%SPEECH_ON%Señor, ¿qué haces?%SPEECH_OFF%Le haces un gesto para que se aparte y levantas el ganso dorado. Sostenido con ambas manos, se nota extrañamente tibio. Y no explota ni te derrite la cara. Sientes su metal ondular levísimamente contra los dedos. ¿Estará incluso creciendo? Con el tesoro bien acurrucado bajo el codo, te preguntas por qué al esqueleto no le fue mejor. %observer% se acerca y le toca la cabeza al ganso dorado, pero retrocede enseguida. Le preguntas si se ha quemado. %Art_observer% mercenari%o_observer% frunce los labios.%SPEECH_ON%¿En serio, señor? ¿No era obvio?%SPEECH_OFF%Se mete el dedo en la boca. Le dices que no sea tan insolente con su comandante o le lanzarás el ganso para ver si acaba con %el_observer% tan rápido como con el esqueleto. Ante eso, se encoge de hombros.%SPEECH_ON%Pero mira nada más al elegido de una baratija brillante. Ponle una espada bajo el ala para que te arme caballero o, qué demonios, ¿por qué no te lo pones en la cabeza y te proclamas rey de una vez?%SPEECH_OFF%Bajas la vista hacia el ganso. Una gota de sangre roja le recorre el cuerpo, se vuelve de oro y cae al suelo con un diminuto tintineo. La recoges y la muerdes. El oro cede entre tus dientes de una forma muy satisfactoria, y luego se la lanzas a %observer%. Esta vez no %lo_observer% quema, ¡y te das cuenta de que quizá hayas encontrado el auténtico Ganso Dorado de los cuentos!}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\location\monolith_destroyed_event.nut
    // context: monolith_destroyed_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "yelmo" por "pauldrons" (hombreras); "regazo de un sureño" por "bosom" (pecho); "peines" por "combs" (crestas); "venga" (usted) choca con el tuteo del mismo mercenario
        en = "[img]gfx/ui/events/event_101.png[/img]{%SPEECH_START%It's disappointing.%SPEECH_OFF%%randombrother% says as %they_randombrother% looks at the slain corpses. %They_randombrother% snorts and spits.%SPEECH_ON%Don't think disappointing is the word for it, though. They're just lying there, bones and coats, like we'd fought a closet. No flesh, no blood. It's unsatisfying. And knowing that, thinking it true, well that unnerves me.%SPEECH_OFF%You got nothing to say to such things other than there's a kernel of truth in the matter. If it weren't the issuances of its lust, why else the vigor for violence? Another sellsword calls you over, interrupting any solemn introspection.%SPEECH_ON%Sir, come have a look.%SPEECH_OFF%You head over and spot a skull sitting in the bed of pauldrons like an egg in the bosom of a well-endowed southerner. The rest of its body is battered and thrown to the winds as far as you can tell. What remains is a decadent slab of chest armor. It is covered in glyphs and treatments, fortunes and historical retellings, and is embroidered with red tassels and combs made of bristly hair. You touch the metal and the second you do the skull beside it powders and blows away. The mercenary seeing this shrugs rather sheepishly.%SPEECH_ON%If you got magical powers I won't tell no one.%SPEECH_OFF%You slug the sellsword in the shoulder and tell him to the load armor into the inventory for later allocation.}"
        es = "[img]gfx/ui/events/event_101.png[/img]{%SPEECH_START%Es decepcionante.%SPEECH_OFF%Dice %randombrother% mientras mira los cadáveres abatidos. Resopla y escupe.%SPEECH_ON%Aunque no creo que «decepcionante» sea la palabra. Están ahí tirados, huesos y abrigos, como si hubiéramos peleado contra un armario. Ni carne ni sangre. No satisface. Y saberlo, creer que es así, bueno, eso me inquieta.%SPEECH_OFF%No tienes nada que decir a eso, salvo que hay un fondo de verdad en el asunto. Si no fueran los arrebatos de su lujuria, ¿de dónde saldría ese ímpetu para la violencia? Otro mercenario te llama e interrumpe cualquier reflexión solemne.%SPEECH_ON%Señor, ven a echar un vistazo.%SPEECH_OFF%Te acercas y ves un cráneo asentado en un lecho de hombreras como un huevo entre los pechos de una sureña bien dotada. El resto del cuerpo, por lo que alcanzas a ver, está destrozado y esparcido a los cuatro vientos. Lo que queda es una suntuosa coraza. Está cubierta de glifos y tratados, augurios y crónicas, y adornada con borlas rojas y crestas de pelo hirsuto. Tocas el metal y, en ese mismo instante, el cráneo de al lado se hace polvo y se lo lleva el viento. El mercenario que lo ve se encoge de hombros con bastante timidez.%SPEECH_ON%Si tienes poderes mágicos, no se lo diré a nadie.%SPEECH_OFF%Le das un puñetazo en el hombro al mercenario y le dices que cargue la armadura en el inventario para asignarla más tarde.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\location\waterwheel_enter_event.nut
    // context: waterwheel_enter_event.o.create.::Legends.Screens.hook()
    // en = "D2"
    // identificador de pantalla
    // context: waterwheel_enter_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: errata "Qué así sea" (es "Que así sea", fijado en el glosario)
        en = "[img]gfx/ui/events/event_109.png[/img]{The %weapon% then falls and you reach to catch it, but a ghostly hand steals it away. You look up to see the elder unsheathing the blade, revealing its fire and ice as though he brokered a new day and gloomy night in the very spectrum of its steel. He chokes with laughter.%SPEECH_ON%'Avenge my son!' 'Be worthy!' Idle doings for simpletons. You did well to chase the carrot, sellsword, and for that I will kill you quick.%SPEECH_OFF%Pauldrons and bracers and a chest plate rise out of the mill well, sheets of grain streaming off them to reveal their garish shapes, and the metals twist and float to the elder, fiercely striking his body as though they meant to armor the very anvil that helped craft them. The suit of steel comes together as its occupant croaks with laughter. Hands grab you by your shoulders and drag you out of the house. You are shielded by the %companyname%. The elder geist turns his head.%SPEECH_ON%A mob of morons, is it? Depart, the lot of you, and you shall be spared. I only ask that you leave me the captain as I have already promised his demise.%SPEECH_OFF%%randombrother% draws %their_randombrother% weapon and the rest of the company follows suit. The elder holds up the crepuscular sword in return. Though the steel is firmly real, the elder's body is rippling to and fro like a thinly veiled curtain on a moonlit night. He sighs and parts of blue ether drift from his lips. He turns the blade so its edge faces you.%SPEECH_ON%So be it.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_109.png[/img]{Entonces %weapon% cae y alargas la mano para atrapar el arma, pero una mano fantasmal te la arrebata. Al levantar la vista, ves al anciano desenvainando la hoja, que revela su fuego y su hielo como si hubiera pactado un nuevo día y una noche sombría en el espectro mismo de su acero. Se atraganta de risa.%SPEECH_ON%«¡Vengar a mi hijo!», «¡Ser digno!». Pasatiempos de simplones. Hiciste bien en perseguir la zanahoria, mercenario, y por eso te mataré rápido.%SPEECH_OFF%Hombreras, brazales y una coraza emergen del pozo del molino, con regueros de grano que se escurren de ellos para revelar sus formas estridentes, y los metales se retuercen y flotan hacia el anciano, golpeando con fiereza su cuerpo como si quisieran acorazar el mismísimo yunque que ayudó a forjarlos. La armadura de acero se ensambla mientras su ocupante suelta una risa ronca. Unas manos te agarran por los hombros y te arrastran fuera de la casa. Quedas a resguardo tras %companyname%. El espectro del anciano gira la cabeza.%SPEECH_ON%¿Una turba de imbéciles, eh? Márchense todos y serán perdonados. Solo pido que me dejen al capitán, pues ya he prometido su fin.%SPEECH_OFF%%randombrother% desenvaina su arma y el resto de la compañía hace lo mismo. El anciano alza la espada crepuscular en respuesta. Aunque el acero es firmemente real, el cuerpo del anciano ondula de un lado a otro como una cortina fina en una noche de luna. Suspira y jirones de éter azul se escapan de sus labios. Gira la hoja para que el filo te apunte.%SPEECH_ON%Que así sea.%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\location\witchhut_enter_event.nut
    // context: witchhut_enter_event.o.create.::Legends.Screens.hook()._screen.start.Options.push().Text
    {
        en = "Can tell me what this relic does?"
        es = "¿Puedes decirme qué hace esta reliquia?"
    }
    // context: witchhut_enter_event.o.create.m.Screens.push().Options.Text
    {
        en = "Back to the knife..."
        es = "Volvamos a lo del cuchillo..."
    }
    // context: witchhut_enter_event.o.create.m.Screens.push().start.Text
    {
        en = "[img]gfx/ui/events/event_52.png[/img]{A hint of weariness enters the woman's voice as you ask your question. She offers her hand. %SPEECH_ON%Show me.%SPEECH_OFF% You hand the heavy jug to her, the contents of which slosh this way and that inside the vessel. Her eyes gleam and study the art covering the amphora. She whispers to herself a few things, but you only make out %SPEECH_ON%I thought I had lost you...%SPEECH_OFF% Without warning, she drips her finger into the mulch and sucks on it. You wait for a reaction but none comes, she either has tasted worse or hides her pain very well. She places the jug down and locks eyes with you. %SPEECH_ON%You have a problem, I know of this item and have come across it before - but it is not how I remember it. The mixture inside has spoiled, which I did not think was possible until now. It has long passed it's orginal purpose and I cannot guarantee what you will be drinking each time this refills.%SPEECH_OFF% She takes a sip from the vessel, and instantly pales and spits it out with a force that could blind a man.}"
        es = "[img]gfx/ui/events/event_52.png[/img]{Un deje de cansancio asoma a la voz de la mujer cuando le haces la pregunta. Extiende la mano.%SPEECH_ON%Muéstramelo.%SPEECH_OFF% Le das la pesada jarra, cuyo contenido chapotea de un lado a otro dentro del recipiente. Le brillan los ojos mientras estudia los dibujos que cubren el ánfora. Murmura unas cuantas cosas para sí, pero solo alcanzas a entender %SPEECH_ON%Creía que te había perdido...%SPEECH_OFF% Sin previo aviso, mete el dedo en el mejunje y se lo chupa. Esperas una reacción, pero no llega: o ha probado cosas peores o disimula muy bien el dolor. Deja la jarra y te clava la mirada.%SPEECH_ON%Tienes un problema. Conozco este objeto y ya me había topado con él antes, pero no es como lo recuerdo. La mezcla de dentro se ha echado a perder, cosa que hasta ahora no creía posible. Hace mucho que dejó atrás su propósito original y no puedo garantizarte qué vas a beber cada vez que se rellene.%SPEECH_OFF% Da un sorbo de la vasija y al instante palidece y lo escupe con una fuerza capaz de dejar ciego a un hombre.}"
    }
    // context: witchhut_enter_event.o.create.m.Screens.push().start.Text
    {
        en = "[img]gfx/ui/events/event_52.png[/img]{The woman takes the tome and flicks through it's pages. At first the speed of which is rapid, but after a time she freezes and starts from the beginning again, reading very carefully and methodically between what appears to be blank pages. Minutes pass as she digests the information on each page before moving on. After a dozen pages, the reading becomes faster and she finally flicks through the last pages all the way to end end. %SPEECH_ON%Interesting, but not finished. I liked the part about the mackrel and the bucket.%SPEECH_OFF% Your mind begins to wander, is this another trick? She smiles at you wryly and folds her arms. %SPEECH_ON%It's blank for you, isn't it? I have read about this book before. It often trades hands because the owner doesn't like to be reminded of how uncontrollable their life is each time they pass their bookshelf. They think that passing on Van Hoorst's 'hronolosko ludilo' will bring them back control. This is only one of five volumes, this is volume four, I believe.%SPEECH_OFF% The woman flicks through a few more of the pages again, possibly trying to discern if this conversation has had any impact on her end. She closes the book carefully and slides it across the table to you. %SPEECH_ON%Regardless, you should know that anyone who holds this is playing a risky game. Many think that the books alter fate themselves, not just reveal it. Those who die with these books in hand often do so with no chance at recovery. Some have said that they have seen men bleed to death from a pinprick because the book willed it so.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_52.png[/img]{La mujer toma el tomo y pasa sus páginas. Al principio lo hace muy deprisa, pero al cabo de un rato se detiene en seco y vuelve a empezar desde el principio, leyendo con mucho cuidado y método entre lo que parecen páginas en blanco. Pasan los minutos mientras digiere lo que hay en cada página antes de seguir. Tras una docena de páginas, la lectura se acelera y al fin pasa las últimas hojas hasta el final.%SPEECH_ON%Interesante, pero inacabado. Me gustó la parte de la caballa y el cubo.%SPEECH_OFF% Tu mente empieza a divagar: ¿será otro truco? Te dedica una sonrisa irónica y se cruza de brazos.%SPEECH_ON%Para ti está en blanco, ¿verdad? Ya había leído sobre este libro. Cambia de manos a menudo porque a su dueño no le gusta que le recuerden lo incontrolable que es su vida cada vez que pasa junto a la estantería. Creen que, si se deshacen del 'hronolosko ludilo' de Van Hoorst, recuperarán el control. Es solo uno de cinco volúmenes; este es el cuarto, creo.%SPEECH_OFF% La mujer vuelve a hojear unas cuantas páginas más, quizá tratando de discernir si esta conversación ha cambiado algo en lo que a ella le toca. Cierra el libro con cuidado y te lo desliza por la mesa.%SPEECH_ON%En cualquier caso, debes saber que quien lo tenga está jugando a un juego arriesgado. Muchos creen que los libros alteran el destino, no que solo lo revelan. Quienes mueren con uno de estos libros en la mano suelen hacerlo sin posibilidad de recuperarse. Hay quien dice haber visto a hombres desangrarse por un pinchazo porque el libro así lo quiso.%SPEECH_OFF%}"
    }
    // context: witchhut_enter_event.o.create.m.Screens.push().start.Text
    {
        en = "[img]gfx/ui/events/event_52.png[/img]{The woman rolls her eyes and offers her hand. You produce the bound ledger and in almost the same motion, she flicks it open at a random page. Her eyes dart horizontially more than vertically across the page. She closes the ledger, and then opens it again and her curiosity deepens. With that, she closes the ledger a final time and throws it back at you, which you only just manage to catch. %SPEECH_ON%Boring!%SPEECH_OFF% She attends to a cooking pot starting to boil. %SPEECH_ON%I have seen these before, they're ledgers to track debtors and indebted alike. I know none of these names or what they mean but I do know the symbols in the margins.%SPEECH_OFF% She sips the soup from a spoon, and throws the spoon back into the pot the way a squirrel would discard a spent acorn. %SPEECH_ON%Symbols like 'Dead' or 'Missing', but there is one in there which is more broad - 'Taken'. Be whom or what I am unsure, but based on the age of that skin and the names I think you found a relic of the Fallen Empire. Have you seen those packs of bones out there? Pretending like nothing is wrong despite being a magnet for wild and hungry dogs who don't know any better? They were a superstitious lot and even in death, they still are. If I were you I'd tie that around my neck and you'll have them running back to that black pit of theirs in no time.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_52.png[/img]{La mujer pone los ojos en blanco y extiende la mano. Sacas el libro de cuentas encuadernado y, casi en el mismo movimiento, ella lo abre por una página al azar. Sus ojos recorren la página más a lo ancho que a lo largo. Cierra el libro, vuelve a abrirlo y su curiosidad aumenta. Con eso, lo cierra por última vez y te lo lanza de vuelta; apenas alcanzas a atraparlo.%SPEECH_ON%¡Aburrido!%SPEECH_OFF% Se ocupa de una olla que empieza a hervir.%SPEECH_ON%Ya he visto otros así: son libros para llevar la cuenta de deudores y endeudados por igual. No conozco ninguno de estos nombres ni sé qué significan, pero sí conozco los símbolos de los márgenes.%SPEECH_OFF% Sorbe la sopa de una cuchara y la vuelve a tirar a la olla como una ardilla tiraría una bellota ya roída.%SPEECH_ON%Símbolos como 'Muerto' o 'Desaparecido', pero hay uno ahí que es más amplio: 'Arrebatado'. Por quién o por qué, no lo sé, pero por la antigüedad de esa piel y por los nombres, creo que has encontrado una reliquia del Imperio Caído. ¿Has visto esas manadas de huesos que andan por ahí? ¿Haciendo como si nada pasara, aunque atraen a perros salvajes y hambrientos que no saben hacer otra cosa? Eran gente supersticiosa y, aun muertos, lo siguen siendo. Yo que tú me ataría eso al cuello, y en nada los tendrás corriendo de vuelta a ese pozo negro suyo.%SPEECH_OFF%}"
    }
    // context: witchhut_enter_event.o.create.m.Screens.push().start.Text
    {
        en = "[img]gfx/ui/events/event_52.png[/img]{You take the hairy paw from your bag and lay it on the table. The woman barely looks at it. %SPEECH_ON%Manwolf paw. Seen a dozen of them. We like to collect them for sport.%SPEECH_OFF% She flashes another paw of a larger size than yours attached to a belt on her dress. You think you catch the paw twitching, but it could just be her movement making it sway. %SPEECH_ON%Good for vigor, gives you that energy you need to run through the woods...or more.%SPEECH_OFF% She flashes you a wry smile and looks you up and down. A veil of discomfort decends down on you. %SPEECH_ON%be aware that those who pretend to be a beast also think like a beast. They may be big, hairy and strong but they have the bravery of a dog all the same when real danger comes.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_52.png[/img]{Sacas la pata peluda de tu bolsa y la dejas sobre la mesa. La mujer apenas la mira.%SPEECH_ON%Pata de hombre lobo. He visto una docena. Nos gusta coleccionarlas por deporte.%SPEECH_OFF% Te enseña otra pata, más grande que la tuya, sujeta a un cinturón de su vestido. Te parece verla moverse, pero puede que solo se balancee por el movimiento de ella.%SPEECH_ON%Buena para el vigor, te da la energía que necesitas para correr por el bosque... o para algo más.%SPEECH_OFF% Te dedica una sonrisa pícara y te mira de arriba abajo. Un velo de incomodidad cae sobre ti.%SPEECH_ON%Ten en cuenta que quien se hace pasar por bestia también piensa como una bestia. Puede que sean grandes, peludos y fuertes, pero cuando llega el peligro de verdad tienen el mismo valor que un perro.%SPEECH_OFF%}"
    }
    // context: witchhut_enter_event.o.create.m.Screens.push().start.Text
    {
        en = "[img]gfx/ui/events/event_52.png[/img]{You produce the rib from your pack, the woman studies it as it comes out and fixes her gaze at it touches the table. No sooner as your hand is clear does she take it and hold it at either end. She softly bites one end and taps it on the edge of her cooking pot. A jolt of energy runs up your legs as you wnat to move in to stop her mishandling the relic you paid so much for. %SPEECH_ON%It's the real thing. I am quite impressed. No sheep bones or plaster as usual, this is the bone of a woman who i feel a burning hatred for. I know a godwhore when I see one, or in this case, part of one.%SPEECH_OFF% She notices how jittery you have become, and places the bone neatly back into your hands. %SPEECH_ON%These fools die for many reasons. Mostly killed by their own kind. This one has a painful energy about it - a mixture of pain and fear. I feel sharpness and hear the whistling of arrows when I hold it.%SPEECH_OFF% She exhales as if to purge the memory from her mind. %SPEECH_ON%Her loss will be your gain, however. These martyrs often protect against what killed them in the first place. But often at a cost of what didn't kill them.%SPEECH_OFF% She purses her lips. %SPEECH_ON%Stay away from axes, spears and the like, stranger.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_52.png[/img]{Sacas la costilla de tu morral; la mujer la estudia mientras sale y no le quita la vista de encima hasta que toca la mesa. En cuanto retiras la mano, la toma y la sujeta por ambos extremos. Muerde suavemente un extremo y lo golpea contra el borde de su olla. Una sacudida te recorre las piernas: quieres lanzarte a impedir que maltrate la reliquia que tanto te costó.%SPEECH_ON%Es auténtica. Estoy bastante impresionada. Nada de huesos de oveja ni yeso, como de costumbre: es el hueso de una mujer por la que siento un odio abrasador. Reconozco a una puta de los dioses en cuanto la veo, o en este caso, a un trozo de una.%SPEECH_OFF% Nota tu nerviosismo y te devuelve el hueso con cuidado a las manos.%SPEECH_ON%Estas necias mueren por muchas razones. Casi siempre a manos de los suyos. Esta tiene una energía dolorosa: una mezcla de dolor y miedo. Al sostenerla siento filos y oigo el silbido de las flechas.%SPEECH_OFF% Exhala como si quisiera purgar el recuerdo de su mente.%SPEECH_ON%Pero lo que ella perdió será tu ganancia. Estas mártires suelen proteger contra lo que las mató. Aunque a menudo a costa de lo que no las mató.%SPEECH_OFF% Frunce los labios.%SPEECH_ON%Aléjate de las hachas, las lanzas y demás, forastero.%SPEECH_OFF%}"
    }
    // context: witchhut_enter_event.o.create.m.Screens.push().start.List.text
    {
        // text = item.getName() + " is now identified and its tooltip has now been updated"
        mode = "pattern"
        en = "<name:str> is now identified and its tooltip has now been updated"
        es = "Se ha identificado <name> y se ha actualizado su descripción"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\lose_fear_greenskins_event.nut
    // context: lose_fear_greenskins_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_26.png[/img]{%fearful% is staring into the campfire and nodding as %they_casualty% mumbles to %themselves_casualty%. It's a worrisome sight, but almost on cue of that thought %they_casualty% speaks up.%SPEECH_ON%You know what? The greenskins ain't shit.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_26.png[/img]{%fearful% mira fijamente la hoguera y asiente mientras masculla para sí. Es preocupante de ver, pero, casi como si respondiera a ese pensamiento, toma la palabra.%SPEECH_ON%¿Sabes qué? Los pieles verdes no valen una mierda.%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\lucky_finds_something_event.nut
    // context: lucky_finds_something_event.o.create.s.Text
    {
        // corrige base: "defecó" rebaja "shat"; "La ave" es errata (el ave); faltaba "ever" de "ever lucky"
        en = "%terrainImage%{%lucky% the ever lucky sellsword has managed to find something interesting. You ask how %they_lucky% came across the item. %They_lucky% shrugs.%SPEECH_ON%{I was walking, and then I stepped on it. Simple enough. | I looked up and this bird shat and it just missed me. When I looked at where it landed, well, there it was. The bird shit and that thing you got in your hands. | Felt a tingle in my fingers, and then a tingle in my crotch. After that I got to looking around for somethin' boring to absolve myself and saw it just settin' there. | Saw a horseshoe just layin' on the ground there and thought to go and fetch it and, well, that was underneath. | Well, see, I saw this four-leaf clover just setting there and I was gonna add it to my bag, see, I got dozens, anyway when I went to go pick it up I saw that item just settin' there. Pretty nifty, huh?}%SPEECH_OFF%}"
        es = "%terrainImage%{%lucky%, %art_lucky% mercenari%o_lucky% de la eterna suerte, ha logrado encontrar algo interesante. Le preguntas cómo dio con el objeto. Se encoge de hombros.%SPEECH_ON%{Iba caminando y lo pisé. Así de simple. | Miré hacia arriba, un pájaro cagó y no me dio por poco. Cuando miré dónde había caído, bueno, ahí estaba. La cagada del pájaro y eso que tienes en las manos. | Sentí un hormigueo en los dedos y luego un hormigueo en la entrepierna. Después de eso me puse a buscar algo aburrido para calmarme y lo vi ahí tirado. | Vi una herradura tirada en el suelo, pensé en ir a recogerla y, bueno, eso estaba debajo. | Bueno, verás, vi este trébol de cuatro hojas ahí plantado e iba a guardarlo en mi bolsa, verás, tengo docenas; total, que cuando fui a recogerlo vi ese objeto ahí tirado. Nada mal, ¿eh?}%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\march_wear_and_tear_event.nut
    // context: march_wear_and_tear_event.o.create.s.Text
    {
        en = "%terrainImage%{Marching all around the world has put some wear and tear on your sellswords. Whenever a mercenary takes off a boot you can see the blood seeping through the sock. They've accumulated sores and boils. One peels the flesh off a toe and instantly barks their regret, and you nod. All in all, this is the price to pay for being on the road so much.}"
        es = "%terrainImage%{Tanto marchar por todo el mundo ha desgastado a tus mercenarios. Cada vez que uno se quita una bota, se ve la sangre empapando el calcetín. Han ido acumulando llagas y forúnculos. Uno se arranca la piel de un dedo del pie y al instante suelta un grito de arrepentimiento, y asientes. En resumidas cuentas, es el precio de pasar tanto tiempo en el camino.}"
    }
    // context: march_wear_and_tear_event.o.create.s.Text
    {
        // corrige base: "keep it together" es aguantar, no "mantenerse unidos"
        en = "%terrainImage%{The next stop ain't far. You hope the mercenaries can keep it together until they get there. What bandages you have are applied as necessary.}"
        es = "%terrainImage%{La próxima parada no está lejos. Esperas que los mercenarios aguanten hasta llegar allí. Los vendajes que tienes se aplican donde hace falta.}"
    }
    // context: march_wear_and_tear_event.o.create.s.Text
    {
        en = "%terrainImage%{%tailor% the tailor rubs their chin with two fingers before finally pointing them forward.%SPEECH_ON%I've got it. Comrades, give me every scrap of unused or trashy clothing you have. Every article you got. Hand it over. There you go. Yes, that's absolutely trash, %otherbrother%. Your favorite shirt? By the gods, just give it to me already. Thank you.%SPEECH_OFF%The tailor collects armfuls of discarded clothing and gets to work with scissors. %tailor% slices and dices and pauses. %tailor% pauses a lot, always unsure of the work. But finally the results are presented. A pile of fresh socks and enough left over scraps to furnish some extra bandages. %tailor%'s also wearing a surprisingly flashy new garb, and you've no idea how it was created.}"
        es = "%terrainImage%{%tailor%, sastre de oficio, se frota la barbilla con dos dedos y por fin apunta con ellos hacia delante.%SPEECH_ON%Ya lo tengo. Compañeros, denme cada retal de ropa que no usen o que esté hecho una porquería. Todas las prendas que tengan. Pásenmelas. Eso es. Sí, eso es basura sin ninguna duda, %otherbrother%. ¿Tu camisa favorita? Por los dioses, dámela ya. Gracias.%SPEECH_OFF%Recoge brazadas de ropa desechada y se pone manos a la obra con las tijeras. %tailor% corta, trocea y se detiene. %tailor% se detiene mucho, siempre con dudas sobre el trabajo. Pero por fin presenta el resultado. Un montón de calcetines nuevos y retales suficientes para hacer unos cuantos vendajes más. Además, %tailor% luce una prenda nueva sorprendentemente vistosa, y no tienes ni idea de cómo la hizo.}"
    }
    // context: march_wear_and_tear_event.o.create.s.Options[0].Text
    {
        // corrige base: "si alguna vez lo veo" es calco con el tiempo verbal equivocado
        en = "Now that's a magician if I've ever seen one."
        es = "¡Eso sí que es magia!"
    }
    // context: march_wear_and_tear_event.o.create.s.start._event.m.Tailor.improveMood()
    {
        en = "Fashioned something nice from cloth scraps"
        es = "Hizo algo bonito con retales de tela"
    }
    // context: march_wear_and_tear_event.o.create.s.Text
    {
        en = "%terrainImage%{When it comes to walking the earth, %travelbro% is longer in the tooth than anyone and laughs at the plight of fellow sellswords.%SPEECH_ON%Ah, now this is what I'm talking about! Nevermind the pain, folks, embrace the soreness!%SPEECH_OFF%The company collectively tells %travelbro% to stuff it, but the traveller happily wiggles toes around. You didn't even realize %travelbro%'s boots were off before that, those feet are so calloused you thought the bony figures but folds of leather!}"
        es = "%terrainImage%{Cuando se trata de recorrer el mundo, %travelbro% tiene más experiencia que nadie y se ríe de las penurias de sus compañeros mercenarios.%SPEECH_ON%¡Ah, de esto es de lo que hablo! Olvídense del dolor, gente, ¡abracen las molestias!%SPEECH_OFF%La compañía en pleno le manda cerrar el pico, pero %travelbro% sigue meneando alegremente los dedos de los pies. Ni siquiera te habías dado cuenta de que %travelbro% se había quitado las botas: ¡tiene los pies tan encallecidos que tomaste esas formas huesudas por pliegues de cuero!}"
    }
    // context: march_wear_and_tear_event.o.create.s.Text
    {
        // corrige base: "me ayudé con las mercancías" es calco de "helped myself to" (servirse sin pagar)
        en = "%terrainImage%{%thief% the thief sidles up to you. Stepping away and putting your hands in your pockets, you ask what they want. The shady character smirks and answers.%SPEECH_ON%Alright I'll be honest with you captain. Last time we stopped in town I helped myself to a blind peacemaker's wares. What? I'd a sore tooth. No reason to pay to fix what the old gods gave me. Anyway, I fixed my tooth. See? What a smile, right? But then I thought I felt some aches, man, aches all over the place! So I visited the peacemaker again and...%SPEECH_OFF%You interrupt the man and ask just how much was stolen. The answer comes in the form of a sack of medicinal goods. The thief proudly puts hands on hips and stares out at the world with a crooked grin.%SPEECH_ON%Suffice it to say I ain't hurtin' no more.%SPEECH_OFF%} "
        es = "%terrainImage%{%thief%, que vive de lo ajeno, se te arrima con disimulo. Te apartas, te metes las manos en los bolsillos y le preguntas qué quiere. Con una sonrisa socarrona, te responde.%SPEECH_ON%Está bien, te voy a hablar con franqueza, capitán. La última vez que paramos en un pueblo me serví a gusto de las mercancías de un pacificador ciego. ¿Qué? Tenía una muela dolorida. No hay por qué pagar para arreglar lo que me dieron los viejos dioses. En fin, me arreglé la muela. ¿Ves? Qué sonrisa, ¿eh? Pero luego me pareció notar dolores, ¡hombre, dolores por todas partes! Así que volví a visitar al pacificador y...%SPEECH_OFF%Le interrumpes y le preguntas cuánto robó exactamente. La respuesta llega en forma de saco de productos medicinales. Con orgullo, se pone las manos en las caderas y mira al mundo con una sonrisa torcida.%SPEECH_ON%Baste decir que ya no me duele nada.%SPEECH_OFF%} "
    }
    // FILE: mod_legends\hooks\events\events\dlc2\monk_crafts_holy_water_event.nut
    // context: monk_crafts_holy_water_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]{%monk% the modest holy figure enters your tent with a vial in hand. The flask is topped with a bark stopper and a wreath of greenery with berries hanging beneath the leaves. Inside the vial is a goldish liquid sloshing about. Whatever it is, it catches any glimpse of light and seems to capture it and swirl it around. It is held out.%SPEECH_ON%Blessed water, sir, to fight the dead that walk again.%SPEECH_OFF%You ask if it's a gift from the old gods and are greeted with a nod. You ask if it's really a gift from the old gods, though. Through pursed lips the reply comes .%SPEECH_ON%No, not exactly. The monasteries know how to make it, but it is an ancient recipe protected under penalty of death.%SPEECH_OFF%Of course. You offer thanks for taking such a risk to contribute and instruct it be put in the inventory.}"
        es = "[img]gfx/ui/events/event_05.png[/img]{%monk%, figura santa y modesta, entra en tu tienda con un frasco en la mano. El frasco está tapado con un corcho de corteza y una corona de hojas verdes con bayas colgando bajo ellas. Dentro se agita un líquido dorado. Sea lo que sea, atrapa cualquier destello de luz y parece capturarlo y hacerlo girar. Te lo tiende.%SPEECH_ON%Agua bendita, señor, para combatir a los muertos que vuelven a caminar.%SPEECH_OFF%Le preguntas si es un regalo de los viejos dioses y recibes un asentimiento. Le preguntas si de verdad es un regalo de los viejos dioses. Con los labios fruncidos, llega la respuesta.%SPEECH_ON%No, no exactamente. Los monasterios saben hacerla, pero es una receta antigua protegida bajo pena de muerte.%SPEECH_OFF%Por supuesto. Le das las gracias por correr semejante riesgo para contribuir y ordenas que lo guarden en el inventario.}"
    }
    // context: monk_crafts_holy_water_event.o.create.s.Options[0].Text
    {
        en = "Even the holy have tricks of the trade."
        es = "Hasta los santos tienen sus trucos del oficio."
    }
    // FILE: mod_legends\hooks\events\events\dlc2\nightowl_catches_thief_event.nut
    // context: nightowl_catches_thief_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "búho real" es otra especie; "an actual owl" es un búho de verdad (el chiste con "night owl"); "un poco cansado" por "a little too tired"
        en = "[img]gfx/ui/events/event_33.png[/img]{Waking from a strange dream, you step out of your tent to find most of the company asleep, aside from the night owl %nightowl%. %They_nightowl%'s at the edge of the camp with %their_nightowl% back turned, but %they_nightowl% seems to hear you approaching and speaks without looking.%SPEECH_ON%This is how it starts, captain. The rage. The fever. That turns good men, hoooo.%SPEECH_OFF%%They_nightowl% wheels around to show off an actual owl %they_nightowl% has caught. Its eyelids are half-closed, probably worn out from escaping and now simply humiliated at being caught without any carnivorous purpose. You ask %nightowl% how the hell %they_nightowl% caught it. The sellsword lets the bird go and shrugs.%SPEECH_ON%With my hands. I also caught this.%SPEECH_OFF%%They_nightowl% crouches and pulls up a heretofore unseen corpse.%SPEECH_ON%Slick little thief. I happened upon him, eh, discounting our wares so to speak. I was a little too tired to talk, so I let my blade here tell him the shop's closed. I then followed his footsteps out to where he came from and found his, eh, let's say accoutrements.%SPEECH_OFF%You nod. Right. Of course. You tell the %person_nightowl% you're going back to sleep and you'll make judgments of %their_nightowl% doings in the morning. %They_nightowl% nods back.%SPEECH_ON%Right captain. I'll try and get some shuteye myself. Been a couple days. Or was it weeks?%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_33.png[/img]{Al despertar de un sueño extraño, sales de la tienda y encuentras dormida a casi toda la compañía, salvo a %nightowl%, el búho nocturno del grupo. Está en el borde del campamento, de espaldas, pero parece oírte llegar y habla sin mirar.%SPEECH_ON%Así es como empieza, capitán. La rabia. La fiebre. Eso que echa a perder a los buenos hombres, uuuuh.%SPEECH_OFF%Se da la vuelta para enseñarte un búho de verdad que ha atrapado. Tiene los párpados entornados, seguramente agotado de intentar escapar y ahora simplemente humillado por haber sido atrapado sin ningún fin carnívoro. Le preguntas a %nightowl% cómo diablos lo atrapó. %Art_nightowl% mercenari%o_nightowl% suelta al ave y se encoge de hombros.%SPEECH_ON%Con las manos. También atrapé esto.%SPEECH_OFF%Se agacha y levanta un cadáver que no habías visto hasta ahora.%SPEECH_ON%Un ladronzuelo escurridizo. Me lo encontré, eh, haciéndonos descuentos en la mercancía, por así decirlo. Estaba demasiado cansad%o_nightowl% para hablar, así que dejé que mi hoja le dijera que la tienda estaba cerrada. Luego seguí sus pasos hasta de donde venía y encontré sus, eh, digamos... enseres.%SPEECH_OFF%Asientes. Claro. Por supuesto. Le dices que vuelves a dormir y que por la mañana juzgarás lo que ha hecho. Asiente a su vez.%SPEECH_ON%Claro, capitán. Intentaré pegar ojo yo también. Llevo un par de días en vela. ¿O eran semanas?%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\oracle_event.nut
    // context: oracle_event.o.create.s.start.Options.push().Text
    {
        en = "I'll pay you 100 crowns if you can tell me what this relic does."
        es = "Te pagaré 100 coronas si puedes decirme qué hace esta reliquia."
    }
    // context: oracle_event.o.create.m.Screens.push().Options.Text
    {
        en = "Appreciate it."
        es = "Te lo agradezco."
    }
    // en = "You spend <v:str_tag> Crowns"
    // en base_es
    // FILE: mod_legends\hooks\events\events\dlc2\spooky_forest_event.nut
    // context: spooky_forest_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_25.png[/img]While camping in the woods, %randombrother% calls you out of the command tent. You ask what it is and you see a finger to lips in a silent shush. %randombrother% points up a tree which grows tall into the evening darkness. You hear cracks as though something were making a nest out of branches whole. The noisemaker only pauses to snort and chortle in a quick tittering of guttural chirps, like a bird crying for help from the belly of a snake. When you look back down, the company are staring at you, looking for an idea as to what to do about this event."
        es = "[img]gfx/ui/events/event_25.png[/img]Mientras la compañía acampa en el bosque, %randombrother% te llama para que salgas de la tienda de mando. Preguntas qué pasa y ves un dedo sobre los labios que te pide silencio. %randombrother% señala un árbol que se alza hacia la oscuridad del anochecer. Oyes crujidos, como si algo estuviera haciendo un nido con ramas enteras. Lo que hace el ruido solo se detiene para resoplar y soltar risitas en un rápido parloteo de gorjeos guturales, como un pájaro que pide auxilio desde el vientre de una serpiente. Cuando vuelves a bajar la mirada, la compañía te observa, esperando alguna idea sobre qué hacer al respecto."
    }
    // context: spooky_forest_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_25.png[/img]You order %lumberjack% the lumberjack to bring the tree down. The mercenary nods and gets to work, using a host of tools available, not all of which are axes. The lumberjack plies the wood open in a divot on one side and jams the gaps with the helves of weapons and then goes to the other side and chops away at its trunk. The mercenary works with the sort of speed you'd love to see on the battlefield. It's the sort of authenticity one rarely sees in life, someone who is home at work, eyes settled on modeling an undeniable future, hands hardly assigned to the task so much as born for it.%SPEECH_ON%Ay-yo!%SPEECH_OFF%The lumberjack yells out and the tree is felled. It cracks and slumbers down the heft and tilts into the forest where its long stock falls through the wickets and slams the ground so hard it seems to ache the very earth. Drawing your sword, you go to investigate the felled treetop. You find a pair of Nachzehrers there, smashed flat, teeth skittered to the forest floor like capless shrooms. The company's fear is settled by the grisly sight."
        es = "[img]gfx/ui/events/event_25.png[/img]Le ordenas a %lumberjack%, que se ganaba la vida talando, que eche abajo el árbol. Asiente y se pone manos a la obra con todo un surtido de herramientas a mano, no todas ellas hachas. Abre una muesca en la madera por un lado, encaja mangos de armas en las grietas y luego pasa al otro lado a golpear el tronco. Trabaja con una rapidez que te encantaría ver en el campo de batalla. Es una autenticidad que rara vez se ve en la vida: alguien que está en su elemento trabajando, con la vista puesta en dar forma a un futuro innegable, con unas manos que no parecen asignadas a la tarea, sino nacidas para ella.%SPEECH_ON%¡Allá va!%SPEECH_OFF%Con ese grito, el árbol cae. Cruje, cede bajo su propio peso y se inclina hacia el bosque, donde su largo tronco atraviesa la maleza y golpea el suelo con tanta fuerza que la misma tierra parece dolerse. Desenvainas la espada y vas a examinar la copa derribada. Allí encuentras un par de Nachzehrers aplastados, con los dientes desperdigados por el suelo del bosque como setas sin sombrero. El macabro espectáculo calma el miedo de la compañía."
    }
    // context: spooky_forest_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_25.png[/img]%bravebro%, the ever brave sellsword, clambers up the tree with speed not to be erred by fear or reluctance. You'd think they spotted a fair flirt up in those parts the speed of ascent. It isn't long until the mercenary is gone, though the scratch 'n' scratch of his noisy ascent is unmistakable. Finally you hear returning sounds, the clutter of descent coming in stops and starts as finding safe footing. You see the mercenary break back into view. with boots first to appear like butter trays dangling in the dark. The rest of the shadowy silhouette follows, sliding ever downward until making a last leap to the earth. The mercenary intentionally buckles at the knees and rolls back against the tree trunk with tired hands limp across knees.%SPEECH_ON%T'was a black bear head deep in a honeycomb, but the beast been dead at least two days. I saw a group of bats skitter on out when I approached, I think they was eating its insides. This tumbled on out when they fled.%SPEECH_OFF% The tired mercenary turns and throws a sword upon the ground. It's covered in sticky honey and pinestraw, but otherwise looks like a remarkable blade."
        es = "[img]gfx/ui/events/event_25.png[/img]%bravebro%, con su valentía de siempre, trepa al árbol con una rapidez que ni el miedo ni la duda consiguen frenar. Por la velocidad con que sube, cualquiera diría que ha visto allá arriba a alguien con quien coquetear. Al poco rato se pierde de vista, aunque el ras, ras de su ruidosa subida es inconfundible. Por fin oyes el regreso: el estrépito de la bajada, a trompicones, buscando dónde apoyar los pies con seguridad. Reaparece a la vista, primero las botas, que asoman como bandejas de mantequilla colgando en la oscuridad. Le sigue el resto de la silueta en sombra, que se desliza cada vez más abajo hasta dar un último salto al suelo. %bravebro% dobla las rodillas a propósito y se deja caer de espaldas contra el tronco, con las manos cansadas colgando sobre las rodillas.%SPEECH_ON%Era un oso negro con la cabeza metida hasta el fondo en un panal, pero el bicho llevaba muerto por lo menos dos días. Vi salir correteando un montón de murciélagos cuando me acerqué; creo que le estaban comiendo las tripas. Esto se cayó cuando salieron volando.%SPEECH_OFF% Con un gesto de cansancio, %bravebro% se gira y arroja una espada al suelo. Está cubierta de miel pegajosa y pinocha, pero por lo demás parece una hoja excelente."
    }
    // context: spooky_forest_event.o.create.s.Text
    {
        // corrige base: «Afortunadamente,» es un añadido; el inglés dice solo «No one is crushed».
        en = "[img]gfx/ui/events/event_25.png[/img]You order the company to chop the tree down. They get to the task, though there's little experience in doing it and the end result is a frantic run for safety as the trunk comes barreling down in an unexpected direction. A very frightened black bear bolts off the treetop. It has a honeycomb for a snout and huffs its way into the dark of the forest.\n\n No one is crushed, but the chaos and debris leaves a few of the mercenaries worse for the wear."
        es = "[img]gfx/ui/events/event_25.png[/img]Ordenas a la compañía que corte el árbol. Se ponen manos a la obra, aunque tienen poca experiencia en ello, y el resultado final es una huida frenética en busca de seguridad, ya que el tronco cae en una dirección inesperada. Un oso negro muy asustado sale corriendo desde la copa del árbol. Tiene un panal en lugar de hocico y se aleja resoplando hacia la oscuridad del bosque.\n\nNadie queda aplastado, pero el caos y los escombros dejan a algunos mercenarios peor de lo que estaban."
    }
    // context: spooky_forest_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_25.png[/img]You order the company to cut the tree down. %randombrother% starts in with a heavy thwack, planting a foot on the trunk to wrench the tool free and that's about the last you see as the mercenary goes flying away. A tree branch swings back into view with a long groan emanating from the trunk as though some ancient wood were being felled inside its very body. You watch as the wood cracks loose of the soil and uproots itself. Emerald eyes flare and widen, their stare blinkered by the twists of falling leaves."
        es = "[img]gfx/ui/events/event_25.png[/img]Ordenas a la compañía que tale el árbol. %randombrother% empieza con un fuerte hachazo y apoya un pie en el tronco para soltar la herramienta, y eso es casi lo último que ves antes de que salga volando por los aires. Una rama vuelve a aparecer con un balanceo, mientras del tronco brota un largo gemido, como si talaran alguna madera antigua dentro de su mismo cuerpo. Ves cómo la madera se desprende del suelo con un crujido y se arranca de raíz. Unos ojos esmeralda se encienden y se abren de par en par, con la mirada velada por los remolinos de hojas que caen."
    }
    // context: spooky_forest_event.o.create.s.Text
    {
        // corrige base: «can't be bothered» es no querer perder el tiempo, no «no puedes preocuparte»; «línea de pensamiento» es calco de «line of thinking».
        en = "[img]gfx/ui/events/event_25.png[/img]You can't be bothered by such trivial nonsense. It's likely to be a lynx or an eagle of some sort. If it's worse, it'll come on down and the company will deal with it then. This line of thinking doesn't sit well with some of the company."
        es = "[img]gfx/ui/events/event_25.png[/img]No vas a perder el tiempo con semejantes tonterías. Probablemente sea un lince o algún tipo de águila. Si es algo peor, ya bajará, y la compañía se ocupará de ello entonces. Esta forma de pensar no sienta bien a algunos miembros de la compañía."
    }
    // FILE: mod_legends\hooks\events\events\dlc2\teamplayer_is_bro_event.nut
    // context: teamplayer_is_bro_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_65.png[/img]{%teamplayer%, always the sort to take one for the company, seems to have singlehandedly helped the resolve of each mercenary. As one sellsword explains it.%SPEECH_ON%I dunno how to explain it.%SPEECH_OFF%As another more articulate mercenary says.%SPEECH_ON%It\'s like %they_teamplayer%\'s more than just a sword for hire, you know? %They_teamplayer%\'s someone we can depend on. Like a %sibling_teamplayer%. But not a whole %sibling_teamplayer%, obviously. More like a half%sibling_teamplayer%. A %sib_teamplayer%, if you will.%SPEECH_OFF%}";
        // corrige base: «alguien en quien podemos depender» es incorrecto; se depende «de» alguien.
        mode = "pattern"
        en = "[img]gfx/ui/events/event_65.png[/img]{%teamplayer%, always the sort to take one for the company, seems to have singlehandedly helped the resolve of each mercenary. As one sellsword explains it.%SPEECH_ON%I dunno how to explain it.%SPEECH_OFF%As another more articulate mercenary says.%SPEECH_ON%It's like %they_teamplayer%'s more than just a sword for hire, you know? %They_teamplayer%'s someone we can depend on. Like a %sibling_teamplayer%. But not a whole %sibling_teamplayer%, obviously. More like a half%sibling_teamplayer%. A %sib_teamplayer%, if you will.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_65.png[/img]{%teamplayer%, siempre dispuest%o_teamplayer% a sacrificarse por la compañía, parece haber fortalecido por sí sol%o_teamplayer% la determinación de cada mercenario. Como lo explica un mercenario:%SPEECH_ON%No sé cómo explicarlo.%SPEECH_OFF%Y como dice otro mercenario más elocuente:%SPEECH_ON%Es como si fuera más que %un_teamplayer% simple mercenari%o_teamplayer%, ¿sabes? Es alguien de quien podemos depender. Como %un_teamplayer% herman%o_teamplayer%. Pero no %un_teamplayer% herman%o_teamplayer% complet%o_teamplayer%, obviamente. Más bien como medi%o_teamplayer% herman%o_teamplayer%. %Un_teamplayer% %sib_teamplayer%, por así decirlo.%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\dlc2\treasure_in_rock_event.nut
    // en = "You gain an <item:str>"
    // en base_es
    // en = "You gain an <item:str>"
    // en base_es
    // en = "Used his unique stature to benefit the company"
    // en base_es
    // FILE: mod_legends\hooks\events\events\dlc2\youngling_alp_event.nut
    // context: youngling_alp_event.o.create.s.Text
    {
        // corrige base: «he ahí el dilema» es un añadido; «so there's that» solo apunta que eso también cuenta.
        en = "[img]gfx/ui/events/event_33.png[/img]{%callbrother% runs into your tent and says something is watching the camp. You come outside to see a silhouette in the distance, skulking behind brush and tree limbs. You know its staring when it hisses, for what else would it be looking at to elicit such a charge. Its arms are long and slender and end in claws. You take a torch and sling it toward the beast. Its slick skin winks a vibrant orange and it shrieks away from the cloud of embers and sparks as the torch lands and rolls past. The toothy maw is the last thing you see fading back into the darkness.%SPEECH_ON%I think it's an alp, sir. It's all by itself as far as we can tell.%SPEECH_OFF%You ask if the sellsword has had visions, and are met with shrugs.%SPEECH_ON%Yeah, some, but I also been drinking so there's that.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_33.png[/img]{%callbrother% corre hacia tu tienda y dice que algo está observando el campamento. Sales para ver una silueta a lo lejos, escondiéndose entre arbustos y ramas de árboles. Sabes que te está observando cuando silba, ¿qué más podría estar mirando para provocar tal reacción? Sus brazos son largos y delgados, terminando en garras. Tomas una antorcha y la lanzas hacia la bestia. Su piel brillante parpadea en un vibrante naranja y se aleja chillando de la nube de brasas y chispas cuando la antorcha aterriza y rueda. La mandíbula llena de dientes es lo último que ves desvaneciéndose en la oscuridad.%SPEECH_ON%Creo que es un alp, señor. Está completamente solo según podemos ver.%SPEECH_OFF%Le preguntas si ha tenido visiones, y la respuesta es un encogimiento de hombros.%SPEECH_ON%Sí, algunas, pero también he estado bebiendo, así que eso también cuenta.%SPEECH_OFF%}"
    }
    // context: youngling_alp_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_122.png[/img]{The alp is alone and possibly a youngling. Even monsters have to cut their cloth and put in the work to become truly horrible beasts, and this one just doesn't seem there yet. You send a pair of sellswords to slay the beast. They close in on it through the shroud of darkness. You see the silhouettes rising up in ambush and there's a clatter and a scream, and another scream which is nothing humanlike at all. Shrieking now. And this time a mercenary crying. Someone speaking. Quiet. A long, long quiet. Then the pair comes back. One is clutching their head as though taken by a terrific ache, the other looks at you and nods.%SPEECH_ON%We killed it and, uh, I think we need to lie down.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_122.png[/img]{El alp está solo y posiblemente sea joven. Incluso los monstruos tienen que trazar su camino y trabajar para convertirse en bestias verdaderamente horribles, y este simplemente no parece estar en ese punto aún. Envías a un par de mercenarios a matar a la bestia. Se acercan a ella entre el velo de la oscuridad. Ves las siluetas que se alzan en emboscada y hay un estrépito y un grito, y otro grito que no es humano en absoluto. Chillidos ahora. Y esta vez un mercenario llorando. Alguien habla. Silencio. Un silencio largo, muy largo. Luego, la pareja regresa. Uno se sujeta la cabeza como si sufriera un dolor terrible, el otro te mira y asiente.%SPEECH_ON%La matamos y, eh, creo que necesitamos descansar.%SPEECH_OFF%}"
    }
    // context: youngling_alp_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_33.png[/img]{You tell the company to ignore the alp. If it were of any danger it would have already proven so. Instead, it has let you know it is there, whether by ignorance or arrogance, neither of which bother you none. A few of the mercenaries do not agree with this decision and they stay up all night watching for the beast.}"
        es = "[img]gfx/ui/events/event_33.png[/img]{Le dices a la compañía que no le haga caso al alp. Si fuera peligroso, ya lo habría demostrado. En cambio, te ha hecho saber que está ahí, ya sea por ignorancia o por arrogancia, y ninguna de las dos te preocupa lo más mínimo. Algunos mercenarios no están de acuerdo con la decisión y se pasan la noche en vela vigilando por si aparece la bestia.}"
    }
    // context: youngling_alp_event.o.create.s.Text
    {
        // corrige base: «te había llamado desde tu tienda» cambia el sentido de «fetched you from your tent» (fue a buscarte a tu tienda).
        // corrige base: «El soldado» traduce «The sellsword» (%callbrother%), que es mercenario, no soldado.
        en = "[img]gfx/ui/events/event_122.png[/img]{%beastslayer% the beast slayer comes over.%SPEECH_ON%It ain't dangerous, it's confused. I'll take care of this.%SPEECH_OFF%He's chewing on a dried biscuit and grunts and puts the biscuit in a pocket and sets off into the dark all alone. A moment later, the alp's silhouette suddenly falls away and disappears. A few minutes later and the slayer returns, mouth bulging with the last morsels of the biscuit. You ask why the alp didn't put up much of a fight. The beast slayer laughs.%SPEECH_ON%You said %callbrother% fetched you from your tent, right? Right. And where is %callbrother%?%SPEECH_OFF%The beast slayer points toward the campfire. The sellsword is there. Asleep. Deeply asleep. %beastslayer% gets another biscuit.%SPEECH_ON%Young alps are still learning how to pry into your mind. They're not good at it and often call attention to themselves while trying. They're like thieves who can't pick a lock, so they knock on the door instead.%SPEECH_OFF%A few of the company listen to this and are emboldened by the apparent flaws of these otherwise horrifying creatures.}"
        es = "[img]gfx/ui/events/event_122.png[/img]{Se acerca %beastslayer%, que se gana la vida cazando bestias.%SPEECH_ON%No es peligroso, está confundido. Yo me encargo.%SPEECH_OFF%Mastica una galleta seca, suelta un gruñido, se guarda la galleta en un bolsillo y se adentra sin compañía en la oscuridad. Un momento después, la silueta del alp se desploma de repente y desaparece. Unos minutos más tarde regresa %beastslayer%, con la boca llena de los últimos trozos de galleta. Le preguntas por qué el alp no opuso mucha resistencia. Se ríe.%SPEECH_ON%Dijiste que %callbrother% fue a buscarte a tu tienda, ¿verdad? Bien. ¿Y dónde está %callbrother%?%SPEECH_OFF%Con la mano, señala hacia la fogata. Allí está %callbrother%. Durmiendo. En un sueño profundo. %beastslayer% toma otra galleta.%SPEECH_ON%Los alps jóvenes todavía están aprendiendo a husmear en tu mente. No son buenos en eso y a menudo llaman la atención sobre sí mismos mientras lo intentan. Son como ladrones que no pueden abrir una cerradura, así que tocan la puerta en su lugar.%SPEECH_OFF%Algunos miembros de la compañía escuchan esto y se sienten fortalecidos por las aparentes debilidades de estas criaturas, por lo demás, aterradoras.}"
    }
    // context: youngling_alp_event.o.create.s.Text
    {
        // corrige base: «hiding» es azotarse (dar una paliza), no «ocultándose».
        // corrige base: en el discurso se pierde el pronombre y el vocativo: «No es que tema, sombras...», «mi mente en mi cuerpo» (es «mind in my body», a quien se dirige).
        en = "[img]gfx/ui/events/event_33.png[/img]{%flagellant% the flagellant is at the rim of the camp self whipped raw. The soul cleansing tool is rigged with broken glass and cat claws, bound tight with leather rinsed taut in urine, and tassels of twisted horse hair. The mercenary walks out into the wilderness, hiding their own back with every step.%SPEECH_ON%It's not that I fear you, creature in the shadows. It's not that I fear you, shadows in my mind. It's not that I fear you, mind in my body.%SPEECH_OFF%The mercenary stops walking, but the urgency of the flagellation increases and you can see the flecks of blood winking in the moonlight.%SPEECH_ON%It is that I fear the old gods of which you are not! Of which you are but an insect!%SPEECH_OFF%The alp's silhouette shrinks away, shrieks, and then scurries off altogether. The mercenary returns and collapses into the camp. A few of the company are horrified, while others are emboldened by the courage and righteousness.}"
        es = "[img]gfx/ui/events/event_33.png[/img]{%flagellant% está al borde del campamento, con la piel en carne viva de tanto azotarse. El instrumento con el que purifica su alma está armado con vidrios rotos y garras de gato, sujetos con cuero tensado en orina, y lleva borlas de crin de caballo retorcida. Se adentra en la espesura, azotándose la espalda a cada paso.%SPEECH_ON%No es que te tema, criatura en las sombras. No es que les tema, sombras de mi mente. No es que te tema, mente de mi cuerpo.%SPEECH_OFF%%flagellant% deja de caminar, pero los azotes se vuelven más urgentes y ves las gotas de sangre brillar a la luz de la luna.%SPEECH_ON%¡Es que temo a los viejos dioses de los cuales no eres parte! ¡De los cuales eres solo un insecto!%SPEECH_OFF%La silueta del alp se encoge, chilla y luego huye del todo. %flagellant% regresa y se desploma en el campamento. Algunos miembros de la compañía se horrorizan, mientras que a otros los envalentona tanto valor y rectitud.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc4\adopt_warhound_event.nut
    // en = "Warrior the Warhound"
    // en base_es
    // context: adopt_warhound_event.o.create.s.Text
    {
        // corrige base: «sheep» son ovejas, no corderos; «take the hound» es llevarse al perro, no acercarse.
        // corrige base: la frase «ves que ha muerto yace inmóvil en el suelo» está rota y omite el hocico en la tierra; «to many cheers» son vítores; «al grupo» traduce «the company».
        en = "%terrainImage%{You move to take the hound, but as you crouch down one of the sheep bays and charges, knocking you over. The company laughs and by the time you get to your knees another sheep crushes you from behind to many cheers. Drawing out your sword emits a sharp twang that sends the sheep scurrying. When you look back at the hound its nose is to the dirt and its eyes peerless. It has died and the sheep slowly collect around it bleating and crying out. You sheathe your sword and tell the company to move on.}"
        es = "%terrainImage%{Te dispones a llevarte al perro, pero cuando te agachas, una de las ovejas bala, embiste y te derriba. La compañía se ríe, y para cuando logras ponerte de rodillas, otra oveja te arrolla por detrás entre muchos vítores. Al desenvainar la espada se oye un tañido agudo que hace huir a las ovejas despavoridas. Cuando vuelves a mirar al perro, tiene el hocico pegado a la tierra y los ojos sin vida. Ha muerto, y las ovejas se van reuniendo a su alrededor, balando y gimiendo. Envainas la espada y ordenas a la compañía que siga adelante.}"
    }
    // context: adopt_warhound_event.o.create.s.Text
    {
        // corrige base: «Sé de esta raza» no es natural; «I know this breed» es «Conozco esta raza».
        // corrige base: «scratch» es rascar, no acariciar.
        en = "%terrainImage%{%houndman% steps forward.%SPEECH_ON%I know this breed. It is of northern stock, a sturdy creature. There is one thing it shall respect in a pack leader and it is strength.%SPEECH_OFF%The sellsword crouches before the dog and without pause puts its hands around the scuff of its neck and starts to scratch. Despite the sudden movements, the dog responds positively and when the mercenary stops scratching the dog lifts up off the ground and lopes forward and follows the dog whisperer. %houndman% stares back at you and roughs the dog up with some heavy petting.%SPEECH_ON%Yeah he'll fight for us. Fightin' is what he's made for. He just needed someone to watch him rip and tear.%SPEECH_OFF%What a lovely creature this is. And the dog is fine, too.}"
        es = "%terrainImage%{%houndman% da un paso adelante.%SPEECH_ON%Conozco esta raza. Es de ascendencia norteña, una criatura resistente. Hay una cosa que respetará en el líder de la manada y es la fuerza.%SPEECH_OFF%%houndman% se agacha ante el perro y, sin vacilar, le pone las manos alrededor del pescuezo y empieza a rascarlo. A pesar de los movimientos bruscos, el perro responde bien, y cuando deja de rascarlo, el perro se levanta del suelo, avanza al trote y va tras quien tan bien sabe hablarles a los perros. %houndman% te devuelve la mirada y le da al perro unas buenas caricias bien rudas.%SPEECH_ON%Sí, peleará por nosotros. Pelear es para lo que fue hecho. Solo necesitaba a alguien que lo viera desgarrar y despedazar.%SPEECH_OFF%Qué hermosa criatura es esta. Y el perro está bien también.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc4\barbarian_tells_story_event.nut
    // context: barbarian_tells_story_event.o.create.s.Text
    {
        // corrige base: el salto de párrafo «\n\n» antes de las variantes es un añadido; el inglés sigue en la misma línea.
        // corrige base: «aparentemente» traduce «apparently»; va «por lo visto».
        en = "[img]gfx/ui/events/event_26.png[/img]{%barbarian% shares tales around the campfire of northern heroics and monsters. There can't be much said of the dialogue, given that brute isn't the most eloquent, but the story is well conveyed through miming and drawing in the ground. {One tale seems to be that of a huge warrior defeating a much larger warrior, or perhaps even defeating an ogre. It's hard to tell, but the barbarian makes a fascinating display of combat which the company applauds. | One tale is of two lovers, and with great use of waving hands, makes a riveting show of what it is to plough and be ploughed. And, apparently, what it is to be betrayed and stabbed in the back. You're not sure who is stabbing whom, nor when or in what sense, but the tale has the mercenaries on the edges of their seats and ends with applause. | One tale speaks to a friendly unhold. The company gasp at the very notion of it, but the barbarian slaps at wrists and wags a finger. This, you assume, is a way of telling you it's all true, every word or grunt. The idea of a friendly monster unsettles the mercenaries initially, but by the end of the story they clap and nod as though they wish it really were the truth.}"
        es = "[img]gfx/ui/events/event_26.png[/img]{%barbarian% comparte alrededor de la hoguera relatos de hazañas y monstruos del norte. Poco se puede decir de su forma de hablar, dado que la elocuencia no es lo suyo, pero la historia se entiende bien gracias a la mímica y a los dibujos en el suelo. {Una de las historias parece ser sobre un guerrero enorme que derrota a otro guerrero aún más grande, o tal vez incluso a un ogro. Es difícil de decir, pero %barbarian% hace una fascinante representación del combate, que la compañía aplaude. | Una historia trata de dos amantes y, agitando mucho las manos, hace una representación cautivadora de lo que es arar y ser arado. Y, por lo visto, de lo que es ser traicionado y apuñalado por la espalda. No estás seguro de quién está apuñalando a quién, ni cuándo ni en qué sentido, pero la historia mantiene a los mercenarios al borde de sus asientos y termina con aplausos. | Una historia habla de un trol amistoso. La compañía se queda boquiabierta ante la mera idea, pero %barbarian% se golpea las muñecas y agita un dedo. Esto, supones, es una manera de decirte que todo es cierto, cada palabra o gruñido. La idea de un monstruo amistoso desconcierta a los mercenarios al principio, pero al final de la historia aplauden y asienten como si desearan que realmente fuera cierto.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc4\barbarian_volunteer_event.nut
    // context: barbarian_volunteer_event.o.create.s.Text
    {
        // corrige base: «hablas lo suficientemente alto» es un añadido; en el inglés es el ruido de la espada al desenvainarla lo que llama su atención.
        // corrige base: «si tu aceptarme» lleva «tú» sin tilde.
        en = "%terrainImage%{Unlike the south, finding travelers on the northern 'roads' is often a cause for caution. You never know what monstrous man or beastly barbarian you'll come across next. This time it is a large %person_dude% limping with a dog beside %them_dude%. You draw your sword halfway out of its sheath and loud enough to gain %their_dude% ear. The %person_dude% looks up and %their_dude% dog rears to the sudden yank of a leash. The northerner can speak a bit of your tongue.%SPEECH_ON%Ahh, fighters. I'm a fighter myself.%SPEECH_OFF%You ask why %they_dude% is alone. %They_dude% explains that %their_dude% clan had a dispute, and that %they_dude% was to duel another man to decide who would take control. You ask why %they_dude% did not duel this man, you ask if %they_dude% is afraid. The traveler shakes %their_dude% head.%SPEECH_ON%No. The clansman was my brother. And I'd no desire to kill kin. They gave me this bitch here as both insult and reward and threw me from the tribe. I've no land or people to go to, but if you'd have me, I'd surely fight for you just as well as anyone else.%SPEECH_OFF%}"
        es = "%terrainImage%{A diferencia del sur, encontrar viajeros en los 'caminos' del norte a menudo es motivo de precaución. Nunca sabes con qué hombre monstruoso o bárbaro bestial te toparás a continuación. Esta vez es %un_dude% %hombre_dude% corpulent%o_dude% que cojea con un perro a su lado. Sacas la espada hasta la mitad de la vaina, con el ruido suficiente para llamar su atención. %Art_dude% %hombre_dude% levanta la vista y su perro se encabrita ante el repentino tirón de la correa. %Art_dude% norteñ%o_dude% puede hablar un poco de tu lengua.%SPEECH_ON%Ahh, luchadores. Yo también luchar.%SPEECH_OFF%Le preguntas por qué está sol%o_dude%. Explica que su clan tuvo una disputa y que debía batirse en duelo con otro hombre para decidir quién tomaría el control. Le preguntas por qué no se batió con él, le preguntas si tiene miedo. %Art_dude% viajer%o_dude% niega con la cabeza.%SPEECH_ON%No. Compañero de clan... mi hermano. Y no tener ningún deseo de matar pariente. Ellos darme esta perra como insulto y recompensa, y echarme de la tribu. No tener tierras ni gente a la que ir, pero si tú aceptarme... yo luchar por ti tan bien como cualquier otro.%SPEECH_OFF%}"
    }
    // context: barbarian_volunteer_event.o.create.s.start._event.m.Dude.getBackground().m.RawDescription
    {
        en = "%name% joined you after being exiled from %their% tribe in the north for refusing to kill %their% brother. They'll fight for you as well as for anyone."
        es = "%name% se unió a ti después de ser desterrad%o% de su tribu en el norte por negarse a matar a su hermano. Luchará por ti tan bien como por cualquiera."
    }
    // FILE: mod_legends\hooks\events\events\dlc4\cultist_origin_armor_event.nut
    // context: cultist_origin_armor_event.o.create.s.Text
    {
        // corrige base: «jalar» es léxico regional; en neutro, «sacar de un tirón».
        // corrige base: «patrónizada» no existe; «patterned with» es «decorada con».
        en = "[img]gfx/ui/events/event_03.png[/img]{An urgency takes %randomcultist%,  who stands, leaves the party's campfire, strides across the campground and retires to a tent. It is there that you see %randomcultist% at work, a silhouette and shadows moving frenetically. And there's more than just %randomcultist% in there: curves of unknown come and go beside, reaching up in poles of black, tendrils of darkness, whipping and flailing to match the energy of the faithful's own procession. And then it is done, a silhouette falling forward before yanking something to the light.\n\n %randomcultist% leaves the tent with the sort of hurry with which it was entered, but this time with a piece of leather chest armor in hand. %randomcultist% drops it to the ground.%SPEECH_ON%He awaits us all, brethren.%SPEECH_OFF%The chest armor is patterned with unique cuts which are arranged in strips that, to the unbelieving eye, would be meaningless. To you, it is but a language of Davkul.}"
        es = "[img]gfx/ui/events/event_03.png[/img]{Una urgencia se apodera de %randomcultist%, que se levanta, se aparta de la hoguera del grupo, cruza el campamento a grandes zancadas y se retira a una tienda. Es allí donde ves a %randomcultist% en plena faena, una silueta y unas sombras que se mueven frenéticamente. Y ahí dentro hay algo más que %randomcultist%: curvas de origen desconocido van y vienen a su lado, alzándose en columnas de negrura, tentáculos de oscuridad que se agitan y azotan para igualar la energía de su propia procesión. Y luego termina, y la silueta cae hacia delante antes de sacar algo a la luz de un tirón.\n\n%randomcultist% sale de la tienda con la misma prisa con la que entró, pero esta vez con una pieza de armadura de cuero para el torso en la mano. La deja caer al suelo.%SPEECH_ON%Él nos espera a todos, hermanos.%SPEECH_OFF%La armadura del torso está decorada con cortes singulares, dispuestos en tiras que, a ojos incrédulos, no tendrían sentido. Para ti, no es sino un lenguaje de Davkul.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc4\cultist_origin_finale_event.nut
    // context: cultist_origin_finale_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_33.png[/img]%cultist% enters your tent and a strong, brisk wind chases in after, rearing up your scrolls and other notes. %cultist% walks forward, hands crossed infront, a rather priestly look to the approach.%SPEECH_ON%Sir, I've been spoken to and it is a grave matter which I've been given responsibility for.%SPEECH_OFF%You put your hand up and call for silence. Carefully, you reach out to each candle in the tent and snuff them out until one remains. You bring it to your face..."
        es = "[img]gfx/ui/events/event_33.png[/img]%cultist% entra en tu tienda y un viento fuerte y enérgico se cuela detrás, levantando tus pergaminos y demás notas. %cultist% avanza con las manos cruzadas por delante, con un aire bastante sacerdotal.%SPEECH_ON%Señor, me han hablado, y es un asunto grave del que me han hecho responsable.%SPEECH_OFF%Levantas la mano y pides silencio. Con cuidado, te acercas a cada vela de la tienda y las apagas hasta que queda una. Te la llevas a la cara..."
    }
    // context: cultist_origin_finale_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_33.png[/img]Kneeling before the candle, you hold your hand over the flame and the fire comes to a standstill, pointing upright and unmoving. You\'ve seen icicles more animated than it. You stare into the glow and the tent melts away, slipping into the folds of an immense and immutable darkness. The cultist is gone. In place is a black cloak, its arms to your shoulders, a slate of granite for a head, its edges chipped and cracking. It appears there is something behind this mask, behind this futile effort to keep your mind safe from its true visage. You reach out to the mask, but some invisible force stops you.%SPEECH_ON%In good time you shall see all that I am.%SPEECH_OFF%The voice is booming yet narrowed into a brutish whisper only for you to hear.%SPEECH_ON%I\'ll give you Death, mortal, and warmed in its comforts, Death shall be visited upon your enemies. %sacrifice% will not be lost, they will be with you always, this I promise you.%SPEECH_OFF%A whiteness snaps back over you, a rush of wind, tent flaps curling outward, the candle\'s flame tilting impossibly without going out, and a frigid coolness that has your first breath seen floating across the air. %cultist% is nowhere to be seen. You quickly get up and touch your face and skin, making sure that you are all that you\'re supposed to be. To your great disappointment, Davkul is gone and you are still you.";
        // corrige base: «icicles» son carámbanos, no rocas.
        // corrige base: «Death shall be visited upon your enemies» es que la Muerte caerá sobre tus enemigos; «será visitada por tus enemigos» invierte el sentido.
        // corrige base: «asegurándote de que sigues siendo tú» adelanta el remate; el inglés dice «that you are all that you're supposed to be».
        mode = "pattern"
        en = "[img]gfx/ui/events/event_33.png[/img]Kneeling before the candle, you hold your hand over the flame and the fire comes to a standstill, pointing upright and unmoving. You've seen icicles more animated than it. You stare into the glow and the tent melts away, slipping into the folds of an immense and immutable darkness. The cultist is gone. In place is a black cloak, its arms to your shoulders, a slate of granite for a head, its edges chipped and cracking. It appears there is something behind this mask, behind this futile effort to keep your mind safe from its true visage. You reach out to the mask, but some invisible force stops you.%SPEECH_ON%In good time you shall see all that I am.%SPEECH_OFF%The voice is booming yet narrowed into a brutish whisper only for you to hear.%SPEECH_ON%I'll give you Death, mortal, and warmed in its comforts, Death shall be visited upon your enemies. %sacrifice% will not be lost, they will be with you always, this I promise you.%SPEECH_OFF%A whiteness snaps back over you, a rush of wind, tent flaps curling outward, the candle's flame tilting impossibly without going out, and a frigid coolness that has your first breath seen floating across the air. %cultist% is nowhere to be seen. You quickly get up and touch your face and skin, making sure that you are all that you're supposed to be. To your great disappointment, Davkul is gone and you are still you."
        es = "[img]gfx/ui/events/event_33.png[/img]Arrodillado frente a la vela, colocas la mano sobre la llama y el fuego se detiene, erguido e inmóvil. Has visto carámbanos más animados. Miras fijamente el resplandor y la tienda se derrite, deslizándose entre los pliegues de una inmensa e inmutable oscuridad. %cultist% ha desaparecido. En su lugar hay una capa negra, con los brazos llegando hasta tus hombros, una losa de granito por cabeza, con los bordes astillados y agrietados. Parece que hay algo detrás de esta máscara, detrás de este inútil esfuerzo por mantener tu mente a salvo de su verdadero rostro. Tiendes la mano hacia la máscara, pero una fuerza invisible te detiene.%SPEECH_ON%A su debido tiempo verás todo lo que soy.%SPEECH_OFF%La voz retumba, pero se estrecha en un susurro brutal que solo tú puedes oír.%SPEECH_ON%Te daré la Muerte, mortal, y, calentada en sus consuelos, la Muerte caerá sobre tus enemigos. %sacrifice% no se perderá; estará siempre contigo, esto te lo prometo.%SPEECH_OFF%Una blancura vuelve a envolverte de golpe, una ráfaga de viento, las lonas de la tienda se curvan hacia fuera, la llama de la vela se inclina de manera imposible sin apagarse y un frío glacial deja ver tu primer aliento flotando en el aire. %cultist% no está por ninguna parte. Te levantas rápidamente y te tocas la cara y la piel, asegurándote de que eres todo lo que se supone que debes ser. Para tu gran desilusión, Davkul se ha ido y sigues siendo tú."
    }
    // context: cultist_origin_finale_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_33.png[/img]Davkul would be most unhappy with your failure to obey, not that you feel any urge other than to do what is asked. You and the %cultist% go to %sacrifice%\'s tent. Leaning up as though already expecting you, %sacrifice% sees the knife in the carriage of your party and nods at the simple sight of it. %cultist% kneels beside and you realize they\'ve already talked before this, that the question to you very well may have been a test of your devotion to Davkul. You are happy to have passed.\n\n%sacrifice% unbuttons their shirt and %cultist% pierces the chest as though he were putting a key into a lock, and twists it all the same. The sacrifice gasps and tenses, for no devotion to Davkul can put aside the manner in which death may be permitted, which is in pain and suffering. But %sacrifice% smiles, and the light doesn\'t so much go out of the eyes as the darkness, a sort you haven\'t seen before, replaces it. And like that, %sacrifice% is gone.\n\n %cultist% gets to work on the still warm corpse, carving the flesh with rapid slices across the skin and hard cuts into the tendons. Pulling the chest apart, a black fog lingers with the blade\'s every move, and it seems to sway cheerily after its every move. When %cultist% is done, %sacrfice% has been turned into a slab of armor, flesh torn asunder and stretched, teeth for rivets, tendons for strappings, bones for pauldrons, a cuirass of absolute carnage. And it pulses and moves as though that manifested it still lived. %cultist% turns to you, hands slopped red.%SPEECH_ON%Davkul awaits us all.%SPEECH_OFF%You nod and embrace your fellow comrade.";
        // corrige base: «in the carriage of your party» es el cuchillo que lleva tu grupo, no un cuchillo «en el carro».
        // corrige base: «la luz no se va de sus ojos, sino que la oscuridad [...] la reemplaza» deja la frase sin verbo; el inglés dice que más que irse la luz, la oscuridad ocupa su lugar.
        // corrige base: «Tú y el %cultist% se dirigen» lleva un artículo que no corresponde ante el nombre.
        mode = "pattern"
        en = "[img]gfx/ui/events/event_33.png[/img]Davkul would be most unhappy with your failure to obey, not that you feel any urge other than to do what is asked. You and the %cultist% go to %sacrifice%'s tent. Leaning up as though already expecting you, %sacrifice% sees the knife in the carriage of your party and nods at the simple sight of it. %cultist% kneels beside and you realize they've already talked before this, that the question to you very well may have been a test of your devotion to Davkul. You are happy to have passed.\n\n%sacrifice% unbuttons their shirt and %cultist% pierces the chest as though he were putting a key into a lock, and twists it all the same. The sacrifice gasps and tenses, for no devotion to Davkul can put aside the manner in which death may be permitted, which is in pain and suffering. But %sacrifice% smiles, and the light doesn't so much go out of the eyes as the darkness, a sort you haven't seen before, replaces it. And like that, %sacrifice% is gone.\n\n %cultist% gets to work on the still warm corpse, carving the flesh with rapid slices across the skin and hard cuts into the tendons. Pulling the chest apart, a black fog lingers with the blade's every move, and it seems to sway cheerily after its every move. When %cultist% is done, %sacrfice% has been turned into a slab of armor, flesh torn asunder and stretched, teeth for rivets, tendons for strappings, bones for pauldrons, a cuirass of absolute carnage. And it pulses and moves as though that manifested it still lived. %cultist% turns to you, hands slopped red.%SPEECH_ON%Davkul awaits us all.%SPEECH_OFF%You nod and embrace your fellow comrade."
        es = "[img]gfx/ui/events/event_33.png[/img]Davkul estaría muy descontento con tu falta de obediencia, no es que sientas ningún deseo de hacer algo distinto a lo que se te pide. Te diriges con %cultist% a la tienda de %sacrifice%. Incorporándose como si ya te esperara, %sacrifice% ve el cuchillo que lleva tu grupo y asiente con solo verlo. %cultist% se arrodilla a su lado y te das cuenta de que ya han hablado antes de esto, de que la pregunta que te hicieron bien podría haber sido una prueba de tu devoción a Davkul. Te alegra haberla superado.\n\n%sacrifice% se desabrocha la camisa y %cultist% le perfora el pecho como quien mete una llave en una cerradura, y la gira del mismo modo. El sacrificio jadea y se tensa, porque ninguna devoción a Davkul puede dejar de lado la forma en que se permite la muerte, que es con dolor y sufrimiento. Pero %sacrifice% sonríe, y más que irse la luz de sus ojos, es la oscuridad, de una clase que nunca habías visto, la que ocupa su lugar. Y así, sin más, %sacrifice% se ha ido.\n\n%cultist% se pone a trabajar en el cadáver aún tibio, tallando la carne con cortes rápidos sobre la piel y tajos profundos en los tendones. Mientras abre el pecho, una niebla negra acompaña cada movimiento de la hoja y parece mecerse alegremente tras cada uno. Cuando %cultist% termina, %sacrfice% se ha convertido en una losa de armadura: carne desgarrada y estirada, dientes por remaches, tendones por correas, huesos por hombreras, una coraza de carnicería absoluta. Y late y se mueve como si lo que la manifestó siguiera vivo. %cultist% se vuelve hacia ti, con las manos empapadas de rojo.%SPEECH_ON%Davkul nos espera a todos.%SPEECH_OFF%Asientes y abrazas a tu camarada."
    }
    // context: cultist_origin_finale_event.o.create.s.Text
    {
        // corrige base: «No uno que pase por sacrificar» no concuerda con «prueba» y deforma el sentido («Not one to pass by sacrificing» es una prueba que no se supera sacrificando).
        // corrige base: «solo sabes que es» rompe la frase («you just know, which is...»); y «Cuando ya no lo sientes» no concuerda con «la presencia».
        en = "[img]gfx/ui/events/event_33.png[/img]You feel this is a test. Not one to pass by sacrificing one of your men, but quite the opposite. Davkul may have sent false believers to see if you would do all that they say, simply because they say it. You do not know how you know this, you just know, which is the very sort of certainty one should follow most. Just as you stand to go tell %cultist% of your decision, half the candles in the room suddenly blow out. Tendrils of smoke waft in the remaining gloom, a twisting haze through which, for but a moment, you swear you see a blackened visage fade out the tent's opening. You get the feeling that %cultist% already knows what choice you've made. You stay in the tent and await Davkul's presence. When it is not felt, you simply light the candles again and speak to the emptied room.%SPEECH_ON%Davkul awaits us all.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_33.png[/img]Sientes que esto es una prueba. No una que se supere sacrificando a uno de tus hombres, sino todo lo contrario. Es posible que Davkul haya enviado falsos creyentes para ver si harías todo lo que ellos dicen, simplemente porque ellos lo dicen. No sabes cómo lo sabes; simplemente lo sabes, y ese es precisamente el tipo de certeza que uno debería seguir por encima de todo. Justo cuando te levantas para contarle a %cultist% tu decisión, la mitad de las velas de la habitación se apagan de repente. Zarcillos de humo flotan en la penumbra restante, una neblina retorcida a través de la cual, por un momento, juras ver un rostro ennegrecido desvanecerse por la abertura de la tienda. Tienes la sensación de que %cultist% ya sabe qué elección has hecho. Te quedas en la tienda y esperas la presencia de Davkul. Cuando no la sientes, simplemente vuelves a encender las velas y le hablas a la habitación vacía.%SPEECH_ON%Davkul nos espera a todos.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\dlc4\cultist_origin_flock_event.nut
    // context: cultist_origin_flock_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_03.png[/img]{%joiner%, a wandering devotee of Davkul, has come to join the %companyname%. The company gathers around, the stranger nods, they nod back, and just like that %joiner% is with you. | %joiner%, in rags, yet armored in the shadows of Davkul, has joined the %companyname%. | A devotee by the name of %joiner% shows you dedication to Davkul, a series of spiritual rites shaped about their skull as gruesome scars. %joiner% is welcomed into the %companyname%. | %joiner% stalked the company for a time before approaching you directly. After a time advocating for Davkul's purpose, the argument has been made and yourself engendered to it all the same. %joiner% joins the company. | Davkul surely watches over you as a devotee by the name of %joiner% joins the %companyname%. Stating but one purpose, and it was to find you and ensure that this world sees all that awaits it. | %joiner% says they saw the shadows flicker behind your body as though they were 'of flame.' %joiner% declaring to join your cause for surely Davkul has embedded in you an aspect of the dark and infinite. | %joiner% walks beside you, calling you an aspect of Davkul's darkness, and that eternal eyes surely watch over your party whole. The %companyname% takes %joiner% beneath its many shadowed wings. | %joiner% finds the %companyname% on the march and joins its ranks as though no stranger at all. No one says a word and you simply direct %joiner% to the inventory where the purpose may gather teeth. | With a showing of a scarred head, %joiner% claims to be at the speartip of Davkul's purpose. You nod and welcome %joiner% into the %companyname%. | Walking in the shadow of Davkul, you were bound to find folk such as %joiner%. Keen on joining the company, in particular because you are in command of it, and more particularly due to a belief Davkul has chosen you. | %joiner% bands with the company and there is little argument as to why. When asked where %joiner% came from, there is a shrug and talk of Davkul while nodding knowingly in your direction.}"
        es = "[img]gfx/ui/events/event_03.png[/img]{%joiner%, que vaga por los caminos con su devoción a Davkul, ha venido a unirse a la %companyname%. La compañía se reúne a su alrededor, la persona recién llegada asiente, ellos le devuelven el gesto y, así sin más, %joiner% ya forma parte de la compañía. | %joiner%, en harapos pero con las sombras de Davkul por armadura, se ha unido a la %companyname%. | Alguien de nombre %joiner% te muestra su entrega a Davkul: una serie de ritos espirituales grabados en su cráneo en forma de horribles cicatrices. La %companyname% le da la bienvenida a %joiner%. | %joiner% siguió a la compañía a escondidas durante un tiempo antes de acercarse a ti directamente. Tras un rato defendiendo el propósito de Davkul, ha expuesto sus argumentos y te ha ganado para la causa igualmente. %joiner% se une a la compañía. | Sin duda Davkul vela por ti, pues alguien tan fiel a él como %joiner% se une a la %companyname%. Declara un único propósito: encontrarte y asegurarse de que este mundo vea todo lo que le espera. | %joiner% dice que vio las sombras parpadear detrás de tu cuerpo como si fueran 'de llama'. %joiner% declara que se une a tu causa, pues sin duda Davkul ha incrustado en ti una faceta de lo oscuro e infinito. | %joiner% camina a tu lado, te llama faceta de la oscuridad de Davkul y asegura que unos ojos eternos velan sin duda por todo tu grupo. La %companyname% acoge a %joiner% bajo sus muchas alas en sombra. | %joiner% encuentra a la %companyname% en plena marcha y se une a sus filas como si conociera a todos de siempre. Nadie dice una palabra y simplemente mandas a %joiner% al inventario, donde su propósito podrá armarse de dientes. | Enseñando una cabeza llena de cicatrices, %joiner% afirma estar en la punta de lanza del propósito de Davkul. Asientes y das la bienvenida a %joiner% a la %companyname%. | Caminando a la sombra de Davkul, era inevitable que te toparas con gente como %joiner%, con muchas ganas de unirse a la compañía, sobre todo porque tú la diriges y, más aún, por creer que Davkul te ha elegido. | %joiner% se une a la compañía y poco hay que discutir sobre el porqué. Cuando le preguntan de dónde viene, se encoge de hombros y habla de Davkul mientras asiente con complicidad en tu dirección.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc4\cultist_origin_hood_event.nut
    // context: cultist_origin_hood_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_03.png[/img]{%randomcultist%, one your followers, enters your tent and then just as soon leaves. You stand to see where the've gone, but come to find a leather half-helm sitting atop your table. The leather is stitched with hairs of unknown origin and pinched together by what look like hooks and fingernails. The holes of the helm are a pitch black, and you get the sense that even if you filled them the darkness would never depart. It is then, staring into those emptied sockets, that you know something is staring back. You nod approvingly.}"
        es = "[img]gfx/ui/events/event_03.png[/img]{%randomcultist%, que te sigue en la fe, entra en tu tienda y sale casi al instante. Te levantas para ver adónde ha ido, pero te encuentras un medio yelmo de cuero sobre la mesa. El cuero está cosido con pelos de origen desconocido y unido por lo que parecen ganchos y uñas. Los agujeros del yelmo son de un negro absoluto, y tienes la sensación de que, aunque los rellenaras, la oscuridad nunca se iría. Es entonces, mirando esas cuencas vacías, cuando sabes que algo te devuelve la mirada. Asientes con aprobación.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc4\cultist_origin_sacrifice_event.nut
    // context: cultist_origin_sacrifice_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_140.png[/img]{%sacrifice% is bound and put to the fire. The smell of burnt pork fills the air and the faithful around you rejoice with tears in their eyes. You see a face twisting in the smoke of the sacrifice, a knowing visage that approves. The company are emboldened. | %sacrifice% is chopped to pieces until they are but a torso and head. The blood has emptied across the ground and yet there\'s still light in the eyes and a perverse smile upon the face. You take an axehead and run it into the throat until %sacrifice% is no more. Every bodypart is separated and put upon a pole, caked in grease, and lit aflame. You and the faithful dance beneath the pyres as the night comes and the night goes. | The procession is such: %sacrifice% is flayed alive and pierced with sharpened sticks through each limb and held aloft, spread-eagled over a fire which cooks the sacrifice until death. The faithful watch %sacrifice%\'s passing in silence, but as soon as one of the charred limbs breaks and collapses  the corpse into the flames the faithful cheer and hoot and holler, some pray, others roll around in the ashes of %sacrifice%, some licking it off their fingertips like it were sweets. It is a good night. | A long stick is pierced through %sacrifice% from posterior to out the side of the neck. The sacrifice is tilted up into the sky and held there by one person while others use long spears to stab %sacrifice% through until the corpse is the apex of an uncovered tent. The conical corpse is then covered with grass and mud until there stands a tipi, a torso and head of %sacrifice% all that remains above, and should you enter the tent you would find legs dangling from its ceiling. The monument should stand as an omen for those to come, and a sign that they should come to accept that which awaits us all.}";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_140.png[/img]{%sacrifice% is bound and put to the fire. The smell of burnt pork fills the air and the faithful around you rejoice with tears in their eyes. You see a face twisting in the smoke of the sacrifice, a knowing visage that approves. The company are emboldened. | %sacrifice% is chopped to pieces until they are but a torso and head. The blood has emptied across the ground and yet there's still light in the eyes and a perverse smile upon the face. You take an axehead and run it into the throat until %sacrifice% is no more. Every bodypart is separated and put upon a pole, caked in grease, and lit aflame. You and the faithful dance beneath the pyres as the night comes and the night goes. | The procession is such: %sacrifice% is flayed alive and pierced with sharpened sticks through each limb and held aloft, spread-eagled over a fire which cooks the sacrifice until death. The faithful watch %sacrifice%'s passing in silence, but as soon as one of the charred limbs breaks and collapses  the corpse into the flames the faithful cheer and hoot and holler, some pray, others roll around in the ashes of %sacrifice%, some licking it off their fingertips like it were sweets. It is a good night. | A long stick is pierced through %sacrifice% from posterior to out the side of the neck. The sacrifice is tilted up into the sky and held there by one person while others use long spears to stab %sacrifice% through until the corpse is the apex of an uncovered tent. The conical corpse is then covered with grass and mud until there stands a tipi, a torso and head of %sacrifice% all that remains above, and should you enter the tent you would find legs dangling from its ceiling. The monument should stand as an omen for those to come, and a sign that they should come to accept that which awaits us all.}"
        es = "[img]gfx/ui/events/event_140.png[/img]{Atan a %sacrifice% y le prenden fuego. El olor a cerdo quemado llena el aire y los fieles a tu alrededor se regocijan con lágrimas en los ojos. Ves un rostro retorciéndose en el humo del sacrificio, un semblante cómplice que da su aprobación. La compañía se envalentona. | Despedazan a %sacrifice% hasta que no queda más que un torso y una cabeza. La sangre se ha derramado por el suelo y, aun así, todavía hay luz en sus ojos y una sonrisa perversa en su rostro. Tomas una cabeza de hacha y la hundes en la garganta hasta que %sacrifice% deja de existir. Separan cada parte del cuerpo, la colocan en un poste, la embadurnan de grasa y le prenden fuego. Bailas con los fieles bajo las piras mientras la noche llega y la noche se va. | La ceremonia es así: desuellan en vida a %sacrifice%, le atraviesan cada extremidad con palos afilados y el cuerpo queda en alto, con brazos y piernas abiertos, sobre un fuego que cocina el sacrificio hasta la muerte. Los fieles contemplan en silencio el tránsito de %sacrifice%, pero en cuanto una de las extremidades carbonizadas se rompe y hace caer el cadáver a las llamas, los fieles vitorean, ululan y gritan; algunos rezan, otros se revuelcan en las cenizas de %sacrifice% y algunos se las lamen de la punta de los dedos como si fueran dulces. Es una buena noche. | Atraviesan a %sacrifice% con un palo largo desde el trasero hasta que asoma por un lado del cuello. Inclinan el sacrificio hacia el cielo y una persona lo sostiene ahí mientras otros clavan largas lanzas en %sacrifice% hasta que el cadáver se convierte en el vértice de una tienda descubierta. Después cubren el cadáver cónico con hierba y barro hasta que se alza un tipi, del que solo asoman por arriba el torso y la cabeza de %sacrifice%, y si entraras en la tienda, verías unas piernas colgando del techo. El monumento debería servir de presagio para los que vengan y de señal de que deben llegar a aceptar aquello que nos espera a todos.}"
    }
    // context: cultist_origin_sacrifice_event.o.create.s.start.candleChanges.push().text
    {
        // text = bro.getName() + " has received " + this.Const.Strings.getArticle(skill.getName()) + skill.getName()
        // getArticle antepone "a " o "an " al nombre: un par para cada uno.
        mode = "pattern"
        en = "<name:str> has received a <skill:str>"
        es = "<name> ha recibido <skill:t>"
    }
    // context: cultist_origin_sacrifice_event.o.create.s.start.candleChanges.push().text
    {
        // el getName de la habilidad ya sale traducido y entonces el :t de arriba aborta: esta segunda regla
        // la recoge sin :t (otro nombre de captura, para que no se tome por duplicada)
        mode = "pattern"
        en = "<bro:str> has received a <skill:str>"
        es = "<bro> ha recibido <skill>"
    }
    // context: cultist_origin_sacrifice_event.o.create.s.start.candleChanges.push().text
    {
        mode = "pattern"
        en = "<name:str> has received an <skill:str>"
        es = "<name> ha recibido <skill:t>"
    }
    // context: cultist_origin_sacrifice_event.o.create.s.start.candleChanges.push().text
    {
        mode = "pattern"
        en = "<bro:str> has received an <skill:str>"
        es = "<bro> ha recibido <skill>"
    }
    // en = "<bro:str> is now <skill:str>"
    // en base_es
    // en = "Horrified by the sacrifice of <sacrifice:str>"
    // en base_es
    // FILE: mod_legends\hooks\events\events\dlc4\cultist_origin_vs_uneducated_event.nut
    // context: cultist_origin_vs_uneducated_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]A few mercenaries come to you looking rather worried. They say %cultist% has been sitting with %uneducated% for a few hours now. When you ask what's the worry, they remind you that the cultist has a scarred forehead and speaks of incredibly strange things. Yeah. Those are the demands of Davkul, an example of one's committment. You do not understand what could possibly be wrong with that.\n\n You go and see the two of them. %uneducated% looks up at you, smiling, and says the cultist actually has a lot to teach. Perhaps so, but you know Davkul's presence need not be felt in all, and if it desired being forced upon the world it would be a misapprehension of Davkul's purpose."
        es = "[img]gfx/ui/events/event_05.png[/img]Unos cuantos mercenarios se te acercan con cara de bastante preocupación. Dicen que %cultist% lleva ya unas horas en compañía de %uneducated%. Cuando preguntas qué les preocupa, te recuerdan que %cultist% tiene la frente llena de cicatrices y habla de cosas increíblemente extrañas. Ya. Son las exigencias de Davkul, una muestra del compromiso de cada uno. No entiendes qué puede tener eso de malo.\n\nVas a ver qué hacen. %uneducated% levanta la vista hacia ti, sonriendo, y dice que %cultist%, en realidad, tiene mucho que enseñar. Quizá sea así, pero sabes que no hace falta que todos sientan la presencia de Davkul, y que, si quisiera imponerse al mundo, eso sería malinterpretar su propósito."
    }
    // context: cultist_origin_vs_uneducated_event.o.create.s.Options[0].Text
    {
        en = "Show the darkness."
        es = "Muéstrale la oscuridad."
    }
    // context: cultist_origin_vs_uneducated_event.o.create.s.Text
    {
        // corrige base: los signos de exclamación son un añadido; el inglés cierra con punto («Davkul AWAITS us all.») y solo enfatiza el verbo.
        en = "[img]gfx/ui/events/event_05.png[/img]You nod and turn away. By next morning, %uneducated% is found with a freshly wounded forehead, the blood of conversion and the price some must pay to devote themselves to Davkul. When you ask how  %uneducated% is doing, the reply is simple.%SPEECH_ON%Davkul is coming.%SPEECH_OFF%Shaking your head, you correct the initiate.%SPEECH_ON%Davkul is not coming. Davkul AWAITS us all.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_05.png[/img]Asientes y te alejas. A la mañana siguiente, encuentras a %uneducated% con la frente recién herida, la sangre de la conversión y el precio que algunos deben pagar para dedicarse a Davkul. Cuando le preguntas cómo está, la respuesta es sencilla.%SPEECH_ON%Davkul viene.%SPEECH_OFF%Niegas con la cabeza y corriges su error.%SPEECH_ON%Davkul no viene. Davkul nos ESPERA a todos.%SPEECH_OFF%"
    }
    // en = "<actor:str> gains <v:val_tag> Melee Skill"
    // en base_es
    // context: cultist_origin_vs_uneducated_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]You separate the two, telling %uneducated% to go count some inventory. With that done, %cultist% sneers at you.%SPEECH_ON%Davkul awaits. You see him in your sleep. You see him in the nights. His darkness is coming. No light burns forever.%SPEECH_OFF%The cultist pauses and stares into your soul. And you stare back from somewhere not of your body. You can only see infinite blackness around you and a pip of light through which %cultist% is looking. Slowly, you float back toward the light and find yourself blinking and staring. %cultist%  bows.%SPEECH_ON%Apologies, captain, I did not know that Davkul had such plans.%SPEECH_OFF%Blinking again, you can only nod."
        es = "[img]gfx/ui/events/event_05.png[/img]Interrumpes la charla y le dices a %uneducated% que vaya a contar inventario. Hecho esto, %cultist% te mira con desdén.%SPEECH_ON%Davkul espera. Lo ves en tu sueño. Lo ves en las noches. Su oscuridad se acerca. Ninguna luz arde para siempre.%SPEECH_OFF%%cultist% hace una pausa y mira profundamente en tu alma. Y tú le devuelves la mirada desde algún lugar que no es tu cuerpo. Solo puedes ver la oscuridad infinita a tu alrededor y un punto de luz a través del cual %cultist% está mirando. Lentamente, flotas de regreso hacia la luz y te encuentras parpadeando y con la mirada fija. %cultist% se inclina.%SPEECH_ON%Disculpa, capitán, no sabía que Davkul tenía tales planes.%SPEECH_OFF%Parpadeando de nuevo, solo puedes asentir."
    }
    // FILE: mod_legends\hooks\events\events\dlc4\drunk_nobleman_event.nut
    // context: drunk_nobleman_event.o.create.s.Text
    {
        // corrige base: «birdshit» es mierda de pájaro; «excremento» rebaja la crudeza.
        // corrige base: «juice» es el botín que lleva encima el noble, no bebida; y «el objetivo más perfecto» es incorrecto («the greatest magnet for a mugging»).
        en = "%terrainImage%{While on the march, you find a drunken nobleman tottering side to side on the path. Mussy is the name of his hair, leaves and grass and what looks like birdshit swept up in it like someone stirred the ingredients to a prank. But his clothes sweep about with the finest of silks and his fingers glisten with jewelry. He has a bottle in each hand and he swings them around as he sings gibberish pub songs.\n\nHe is in all regards the greatest magnet for a mugging you've ever seen. %randombrother% purses lips and looks like a wolf staring at a fat sheep.%SPEECH_ON%I'm not saying nothing, sir, I'm just. I'm just seeing it. That's a lot of juice. A lot of juice limping down the road. But again I ain't saying nothing.%SPEECH_OFF%You know what the sellsword's talking about.}"
        es = "%terrainImage%{Mientras marchan, encuentran a un noble borracho tambaleándose de un lado a otro en el camino. Su cabello es un desastre, con hojas, hierba y lo que parece mierda de pájaro mezclados en él, como si alguien hubiera revuelto los ingredientes para una broma. Sin embargo, su ropa ondea con las mejores sedas y sus dedos brillan con joyas. Tiene una botella en cada mano y las agita mientras canta canciones sin sentido de taberna.\n\nEs, en todos los aspectos, el mayor imán para un atraco que hayas visto nunca. %randombrother% frunce los labios y parece un lobo mirando a una oveja gorda.%SPEECH_ON%No estoy diciendo nada, señor, solo... solo lo estoy viendo. Eso es mucho botín. Mucho botín cojeando por el camino. Pero de nuevo, no estoy diciendo nada.%SPEECH_OFF%Sabes a qué se refiere.}"
    }
    // en = "Why is he looking at %servant%?"
    // en base_es
    // en = "Perhaps %thief% can ease his burden."
    // en base_es
    // context: drunk_nobleman_event.o.create.s.start.Options.push().Text
    {
        en = "Hey that's %noble%'s cousin."
        es = "¡Eh, es el primo de %noble%!"
    }
    // en = "Leave him be."
    // en base_es
    // context: drunk_nobleman_event.o.create.s.Text
    {
        // corrige base: «strip him down» es desnudarlo, no despojarlo de sus pertenencias.
        // corrige base: se pierde el juego con «scampered off» / «scampering sort» (el niño sale correteando y el mercenario no es de corretear).
        en = "%terrainImage%{You walk up to the man and help him sit down. He grins as one of his bottles clanks off the path and rolls away.%SPEECH_ON%Thankiicup, sir, jast, no, well, ya.%SPEECH_OFF%Nodding, you hold his hand out and spit on his fingers, then roll the jewelry off and pocket them. He merely watches as though you were a physician treating a malady. The rest of your mercenaries strip him down and throw a goatskin tarp over him and then leave him there. As you walk away he asks if you know about the drink.%SPEECH_ON%Not, not sayin' away the secret, but, sirs, drinks are good.%SPEECH_OFF%Yes, are they ever. Unfortunately, as you rejoin the company %randombrother% reports that a kid saw everything and scampered off. You ask why the mercenary didn't chase after him, the bemused sellsword looks at you shrewdly.%SPEECH_ON%I'm not the scampering sort, sir.%SPEECH_OFF%}"
        es = "%terrainImage%{Caminas hacia el hombre y lo ayudas a sentarse. Él sonríe mientras una de sus botellas golpea el camino y rueda lejos.%SPEECH_ON%Gracias... señor -hic- solo... bueno, sí.%SPEECH_OFF%Asintiendo, extiendes su mano y escupes en sus dedos, luego retiras las joyas y las guardas en tu bolsillo. Él simplemente observa como si fueras un médico tratando una enfermedad. El resto de tus mercenarios lo desnudan, le echan encima una lona de piel de cabra y lo dejan allí. Mientras te alejas, el noble te pregunta si conoces la bebida.%SPEECH_ON%No... no revelaré el secreto -hic- pero, señores, esas bebidas son muy buenas.%SPEECH_OFF%Sí, lo son. Desafortunadamente, al reunirte con la compañía, %randombrother% informa de que un niño lo vio todo y salió correteando. Le preguntas por qué no salió tras él, y te dirige una mirada astuta y divertida.%SPEECH_ON%No soy de ir correteando, señor.%SPEECH_OFF%}"
    }
    // context: drunk_nobleman_event.o.create.s.Text
    {
        // corrige base: «pero logras bloquear la ballesta con tu espada» es un añadido que el inglés no tiene; y «Sin embargo, desafortunadamente» es redundante.
        // corrige base: «perno de ballesta» es calco de «crossbow bolt»; en castellano es virote.
        en = "%terrainImage%{You look back at the company, then unsheathe your sword as you turn around. You swing it up and clip the crossbow and the man shoots it just over your shoulder. You drive the blade down the slat of wood and cut the cords of the weapon and stab the steel into the man's chest. He goes down easy and you hear men shout in the distance, but they're scared and scampering away. Thieves like this know not to fight with sellswords. Unfortunately, the crossbow bolt that went over your shoulder struck %hurtbro%. Who'll survive, but it is a garish wound.}"
        es = "%terrainImage%{Miras hacia atrás a la compañía y desenvainas la espada mientras te das la vuelta. La alzas de un golpe y desvías la ballesta, y el hombre dispara justo por encima de tu hombro. Deslizas la hoja por el listón de madera, cortas las cuerdas del arma y le clavas el acero en el pecho. Cae sin dificultad y oyes gritar a otros hombres a lo lejos, pero están asustados y huyen a toda prisa. Los ladrones como estos saben que no deben enfrentarse a mercenarios. Por desgracia, el virote de ballesta que pasó por encima de tu hombro alcanzó a %hurtbro%. Sobrevivirá, pero es una herida fea.}"
    }
    // context: drunk_nobleman_event.o.create.s.Text
    {
        en = "%terrainImage%As you approach the drunkard, a sharp whistle cracks across the path. You and the drunkard both look to see %thief% the thief standing there with a weapon to the back of another man.%SPEECH_ON%That feller's no nobleman, and probably ain't no drunk neither. They're working together to either ambush travelers or threaten them with blackmail. They're robbers, sir.%SPEECH_OFF%You look back to see the man smiling nervously. He explains with suddenly sharpened clarity.%SPEECH_ON%We'd no interest in robbing sellswords, sir, I-I-I swear I was about to explain myself soon as I saw yer swords.%SPEECH_OFF%%thief% yells out, asking where the cache is. You look back at the man and tell him to hand over everything he's stolen. He nods and asks if you'll gut him if he refuses. You nod and tell him the gutting will come last, and by that point it'll be a relief. The man puts a little pep in his step.%SPEECH_ON%Yessir gotcha sir, right this way.%SPEECH_OFF%"
        es = "%terrainImage%Mientras te acercas al borracho, un silbido agudo restalla en el camino. Te giras junto con el borracho y ves a %thief%, que conoce bien el oficio del robo, apuntando con un arma a la espalda de otro hombre.%SPEECH_ON%Ese tipo no es ningún noble, y seguramente tampoco está borracho. Trabajan juntos para tender emboscadas a los viajeros o para chantajearlos. Son ladrones, señor.%SPEECH_OFF%Vuelves a mirar al hombre, que sonríe nervioso. Se explica con una claridad de pronto muy afilada.%SPEECH_ON%No teníamos ningún interés en robar a mercenarios, señor, l-l-lo juro, iba a explicarme en cuanto vi sus espadas.%SPEECH_OFF%%thief% grita y pregunta dónde está el escondite. Vuelves a mirar al hombre y le dices que entregue todo lo que ha robado. Asiente y pregunta si lo destriparás si se niega. Asientes y le dices que el destripamiento vendrá al final, y que para entonces será un alivio. El hombre acelera un poco el paso.%SPEECH_ON%Sí, señor, entendido, señor, por aquí.%SPEECH_OFF%"
    }
    // context: drunk_nobleman_event.o.create.m.Screens.push().Text
    {
        en = "%terrainImage%As you approach the drunkard, he immediately recognizes %noble% and runs up sobbing. %SPEECH_ON%Cousin! Oh my gentile and cultured cousin, my favorite second cousin, you would not believe the outrageous injustice perpetrated against one's self!%SPEECH_OFF%You look on skeptically as the obviously drunken and slightly bedraggled nobleman continues.%SPEECH_ON%I was due to be wed you see, to the love of my life. It was to the richest, wealthiest, prosperous, bountiful, most affluent, most.. well endowed..%SPEECH_OFF% The noble's mind wanders off, as if in fantasy. You prompt again and the speech continues somewhat more deflated.%SPEECH_ON%Alas it was not to be, they discovered that {I am not a marquess from the border lands but only a viscount heir | My winnings at the table were not as grand as perhaps I had let on | my horrible father disowned me for having too much fun with wine and women}. They turned me out on the road, perhaps I could come on a travelling adventure with you? %SPEECH_OFF%"
        es = "%terrainImage%Mientras te acercas al borracho, reconoce de inmediato a %noble% y se acerca corriendo entre sollozos. %SPEECH_ON%¡Pariente! ¡Oh, mi gentil pariente de tanta cultura, la persona que más estimo de toda mi familia en segundo grado! ¡No te creerías la escandalosa injusticia que se ha cometido contra mi persona!%SPEECH_OFF%Observas con escepticismo mientras el noble, a todas luces borracho y algo desaliñado, continúa.%SPEECH_ON%Verás, iba a casarme con el amor de mi vida. Con la más rica, la más pudiente, próspera, generosa, la más opulenta, la más... bien dotada...%SPEECH_OFF% La mente del noble divaga, como perdida en una fantasía. Le insistes y el discurso continúa algo más desinflado.%SPEECH_ON%Por desgracia, no pudo ser: descubrieron que {no soy un marqués de las tierras fronterizas, sino solo el heredero de un vizconde | mis ganancias en la mesa de juego no eran tan grandes como quizá había dado a entender | mi horrible padre me desheredó por divertirme demasiado con el vino y las mujeres}. Me echaron al camino. ¿Quizá podría acompañarlos en sus viajes y aventuras? %SPEECH_OFF%"
    }
    // context: drunk_nobleman_event.o.create.m.Screens.push().Options.Text
    {
        en = "A pauper is no cousin of mine"
        es = "Ningún mendigo es primo mío"
    }
    // FILE: mod_legends\hooks\events\events\dlc4\horse_race_event.nut
    // context: horse_race_event.o.create.s.Text
    {
        en = "%terrainImage%{You nominate %randombrother% to try and see if %they_other% can best the beast. The race's rules are first to the apple tree and before you can even begin to root for the sellsword the horse smokes %them_other% completely. It gets to the finish line and begins fishing the branches for apples. The company is sitting completely silent, but when %randombrother% crosses the finish line in a distant last place they roar with delight as though %they_other% just won the keys to the kingdom's finest whorehouse. The horse's owner laughs.%SPEECH_ON%Don't be hard on yerself, kind sir. The fun is in the chance.%SPEECH_OFF%Indeed it seems the spectacle of the %person_other%'s efforts entertained the company.} "
        es = "%terrainImage%{Has nominado a %randombrother% para intentar ver si puede vencer al animal. Las reglas de la carrera son llegar primero al árbol de manzanas, y antes de que puedas siquiera empezar a animar %al_other% mercenari%o_other%, el caballo %lo_other% supera por completo. Llega a la línea de meta y comienza a buscar manzanas entre las ramas. La compañía está completamente en silencio, pero cuando %randombrother% cruza la línea de meta en un lejano último lugar, rugen de alegría como si acabara de ganar las llaves del burdel más fino del reino. El propietario del caballo se ríe.%SPEECH_ON%No seas tan dur%o_other% contigo mism%o_other%. La diversión está en la oportunidad.%SPEECH_OFF%De hecho, parece que el espectáculo de los esfuerzos %del_other% %hombre_other% entretuvo a la compañía.} "
    }
    // context: horse_race_event.o.create.s.Text
    {
        // corrige base: «wart» es verruga, no «grano de pus».
        // corrige base: «sellsword» es mercenario, no espadachín.
        en = "%terrainImage%{%athlete% steps forward. %Their_athletic% calves bulge from %their_athletic% socks and %they_athletic% shoulder rolls to loosen up.%SPEECH_ON%Yeah I'll race that sorry horse.%SPEECH_OFF%The wager is made and the horse's owner directs you to a path. With the race set up, he holds up a pair of wooden tongs held apart, and backwards, by some tine. When he cuts the rope, the tongs snap clap together and start the race. Despite being looking like a wart left in the rain, the horse instantly gets a step on the nimble sellsword. It's only halfway down the track does the mercenary's stamina seem to put %them_athletic% back in the race, but %they_athletic% ultimately fails at the finish line. The owner claps his hands.%SPEECH_ON%Oh, that was a close one! The closest I've seen!%SPEECH_OFF%You nod and pay the man what he is owed. %athlete% was beaten, but despite that it seems the loss has bettered %them_athletic% in some regard and the company certainly enjoyed the spectacle.}"
        es = "%terrainImage%{%athlete% da un paso al frente. Las pantorrillas le sobresalen de los calcetines y se balancea de hombros para aflojar los músculos.%SPEECH_ON%Sí, correré contra ese caballo lamentable.%SPEECH_OFF%Se hace la apuesta y el dueño del caballo te indica un camino. Con la carrera lista, sostiene unas tenazas de madera separadas y hacia atrás por unos dientes. Cuando corta la cuerda, las tenazas chocan y marcan el comienzo de la carrera. A pesar de parecer una verruga dejada bajo la lluvia, el caballo se adelanta instantáneamente %al_athletic% ágil mercenari%o_athletic%. Solo a mitad del camino la resistencia %del_athletic% mercenari%o_athletic% parece devolver%lo_athletic% a la carrera, pero finalmente fracasa en la línea de meta. El dueño aplaude.%SPEECH_ON%¡Oh, eso estuvo cerca! ¡Lo más parejo que he visto!%SPEECH_OFF%Asientes y pagas al hombre lo que le corresponde. Aunque %athlete% fue derrotad%o_athletic%, parece que la derrota %lo_athletic% ha mejorado en cierto sentido y la compañía sin duda disfrutó del espectáculo.}"
    }
    // context: horse_race_event.o.create.s.Text
    {
        en = "%terrainImage%{Feeling rather courageous, you nominate the fattest %person_fat% in the company to handle the race. %fat% steps forward with an eyebrow raised, asking if you're sure about taking %them_fat% as your horseracing champion. You hold your hand on %their_fat% shoulder and say %they're_fat% the fattest fark you've ever seen being a sellsword, but that you believe in %them_fat%. You also believe the horse is a haggard draught animal that's on its last legs, but you keep that part to yourself.\n\n The %person_fat% and horse are put next to each other. An apple tree stands in the distance and the first to it is the winner. With the rules laid out, the race is started. It's not an especially close one. %fat% falls behind almost instantly and trundles down the track with %their_fat% face beet red and huffing breath and the men nearly die laughing at the sight. The fat sellsword and dire horse meet back up at the apple tree and there share the fruits of their labors. You pay the horse's owner what he is owed. He smiles as he counts the coin.%SPEECH_ON%Don't usually get a show with the race, sir.%SPEECH_OFF%}"
        es = "%terrainImage%{Con bastante valor, eliges para la carrera %al_fat% %hombre_fat% más gord%o_fat% de la compañía. %fat% da un paso al frente con una ceja levantada y te pregunta si de verdad quieres que sea quien te represente en la carrera de caballos. Le pones la mano en el hombro y le dices que es la bola de sebo más grande que has visto haciendo de mercenari%o_fat%, pero que crees en %el_fat%. También crees que el caballo es un penco de tiro demacrado que está en las últimas, pero esa parte te la guardas.\n\n%Art_fat% %hombre_fat% y el caballo se colocan uno junto al otro. A lo lejos se alza un manzano, y quien llegue primero gana. Con las reglas claras, empieza la carrera. No es especialmente reñida. %fat% se queda atrás casi al instante y avanza pesadamente por la pista con la cara roja como un tomate y resoplando, y los hombres casi se mueren de risa ante la escena. %Art_fat% gord%o_fat% mercenari%o_fat% y el lamentable caballo se reencuentran en el manzano y allí comparten los frutos de su esfuerzo. Le pagas al dueño del caballo lo que le corresponde. Sonríe mientras cuenta las monedas.%SPEECH_ON%No suelen darme espectáculo con la carrera, señor.%SPEECH_OFF%}"
    }
    // context: horse_race_event.o.create.s.Text
    {
        // corrige base: «flips head over hind» es dar una voltereta, no «da vueltas por encima de su cabeza».
        // corrige base: «your sellsword» es tu mercenario, no «tu hombre»; y los signos «¡... ¿...?» quedan mal anidados.
        en = "%terrainImage%{You elect %dumb%, the company's biggest idiot, to be your horse racing champion. The horse's owner takes one look at the %person_dumb% and raises an eyebrow.%SPEECH_ON%Well. Alright.%SPEECH_OFF%Rules of the race are clear: first to a distant apple tree is the winner. The %person_dumb% and animal line up on the track. Pretending that %they_dumb% knows what %they're_dumb% doing, %dumb% crouches in a tri-pointed stance. The horse owner yells and slaps his beast on the buttocks. %dumb% releases into a nice stride and shockingly gets ahead of the horse, but %they're_dumb% unable to handle %their% speed and tilts into the second lane and collides with the beast. The horse buckles at the knees and flips head over hind and %dumb% somehow ends up in the curve of its loins and on the flip around is catapulted through the air. It's a damned sight and one you'll surely never see again. The horse gets back to its feet and stares around confused while %dumb%'s unconscious body flies over the finish line. You turn your palms to the horse owner whose hands are gripping his head.%SPEECH_ON%By the old gods, man, are you not concerned for your sellsword?%SPEECH_OFF%}"
        es = "%terrainImage%{Has elegido a %dumb%, %art_dumb% mayor idiota de la compañía, para que corra por ti en la carrera de caballos. El dueño del caballo echa un vistazo %al_dumb% %hombre_dumb% y levanta una ceja.%SPEECH_ON%Bien. Está bien.%SPEECH_OFF%Las reglas de la carrera están claras: el primero en llegar a un manzano distante es el ganador. %Art_dumb% %hombre_dumb% y el animal se alinean en la pista. Fingiendo que sabe lo que está haciendo, %dumb% se agacha en una posición de tres puntos. El dueño del caballo grita y le da una palmada en las nalgas a su bestia. %dumb% se lanza a una buena zancada y, sorprendentemente, se pone por delante del caballo, pero no puede controlar su velocidad, se desvía hacia el segundo carril y choca con la bestia. El caballo se dobla de rodillas y da una voltereta, y %dumb% de alguna manera termina en la curva de sus lomos y en la vuelta sale catapultad%o_dumb% por los aires. Es un maldito espectáculo y uno que seguramente nunca volverás a ver. El caballo se pone de pie y mira confundido a su alrededor mientras el cuerpo inconsciente de %dumb% vuela sobre la línea de meta. Giras las palmas hacia el dueño del caballo, que se agarra la cabeza con las manos.%SPEECH_ON%¡Por los viejos dioses, hombre! ¿No te preocupa tu mercenari%o_dumb%?%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\dlc4\kings_guard_1_event.nut
    // context: kings_guard_1_event.o.create.s.Text
    {
        en = "%terrainImage%{The snowy wastes are home to not much of anything, so to find someone half-naked in its frigid geography is rather unusual. That the frozen figure is actually alive even more so. You crouch beside the frigid body, their eyes are hollow and rime frosts make blinking them a struggle, lips are jagged and purple and nose a deep red bordering on black. You ask if the pitiful wretch can speak, and are greeted with nods.%SPEECH_ON%Barbarians. Took. Me.%SPEECH_OFF%You ask where the kidnappers are, the figure shrugs and continues the cold cadence.%SPEECH_ON%They. Got. Bored. And. Left.%SPEECH_OFF%It does seem in tune with the primitives to up and leave a prisoner in the ice. The shivering prisoner explains they were once a sturdy swordfighter. A smile squeezes through the pain.%SPEECH_ON%A. King's. Guard. In. The. Kingless. Land. Things. Could. Be. Worse?%SPEECH_OFF%}"
        es = "%terrainImage%{En los páramos nevados no vive casi nada, así que encontrar a alguien casi sin ropa en esta geografía helada es bastante insólito. Que esa figura congelada siga con vida lo es todavía más. Te agachas junto al cuerpo helado: tiene los ojos hundidos y la escarcha hace que parpadear sea un suplicio, los labios agrietados y morados y la nariz de un rojo intenso que roza el negro. Preguntas si esa pobre criatura puede hablar, y te responde con un asentimiento.%SPEECH_ON%Bárbaros. Me. Llevaron.%SPEECH_OFF%Preguntas dónde están los secuestradores; la figura se encoge de hombros y sigue con esa cadencia helada.%SPEECH_ON%Se. Aburrieron. Y. Se. Fueron.%SPEECH_OFF%Desde luego, cuadra con esos primitivos eso de largarse sin más y dejar a un prisionero en el hielo. Entre temblores, explica que en otro tiempo fue una espada temible. Una sonrisa asoma a través del dolor.%SPEECH_ON%Guardia. Del. Rey. En. La. Tierra. Sin. Rey. ¿Podría. Ir. Peor?%SPEECH_OFF%}"
    }
    // context: kings_guard_1_event.o.create.s.start._event.m.Dude.getBackground().m.RawDescription
    {
        en = "You found %name% frozen half to death in the north. %They% claims %they% was a King's Guard once, but looking at %them% now you see but a cripple."
        es = "Encontraste a %name% congelad%o% y medio muert%o% en el norte. Afirma que una vez fue %un% Guardia del rey, pero al mirar%lo% ahora, solo ves a %un% lisiad%o%."
    }
    // en = "Got taken by barbarians and left to die in the cold"
    // en base_es
    // context: kings_guard_1_event.o.create.s.Text
    {
        en = "%terrainImage%{You pat the %person_dude% on the head, but tell %them_dude% it's already over. %They_dude% nods.%SPEECH_ON%Speak. For. Yourself. Mercenary.%SPEECH_OFF%%They_dude% smiles again, but this time it does release. It sticks. Literally. And %they_dude% leans forward and %their_dude% eyes are open and do not blink and in this state %they_dude% is gone. You get the men back on the road, or what one can make of a road in these snowed stretches.}"
        es = "%terrainImage%{Le das unas palmaditas en la cabeza %al_dude% %hombre_dude%, pero le dices que ya se acabó. Asiente.%SPEECH_ON%Eso. Lo. Dirás. Tú. Mercenario.%SPEECH_OFF%Vuelve a sonreír, pero esta vez la sonrisa no se le va. Se le queda. Literalmente. Se inclina hacia delante con los ojos abiertos, sin parpadear, y así se va de este mundo. Haces que los hombres vuelvan al camino, o a lo que puede llamarse camino en estas extensiones nevadas.}"
    }
    // context: kings_guard_1_event.o.create.s.Text
    {
        en = "%terrainImage%{The nearly frozen %person_dude% joins the company. %They're_dude% a ragged wreck, but if what %they_dude% said is true maybe %they_dude% will someday become the fighter %they_dude% could barely speak of.}"
        es = "%terrainImage%{%Art_dude% %hombre_dude% casi congelad%o_dude% se une a la compañía. Es un desastre harapiento, pero si lo que dijo es cierto, tal vez algún día se convierta en la espada de la que apenas pudo hablar.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc4\kings_guard_2_event.nut
    // context: kings_guard_2_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_82.png[/img]{You find %guard% stretching about with surprising limberness. %They_dude% looks nothing at all like the freezing, frigid %person_dude% you found abandoned in the ice by those barbarians. Spotting you, %they_dude% nods and comes over with a quiet voice.%SPEECH_ON%I'm glad you trusted in me, captain. Perhaps you did it out of the kindness of your heart, but I need to show you something.%SPEECH_OFF%%They_dude% flashes an emblem you have heard referenced many times, but have never seen: it carries the sigil of the King's Guard and its pristineness is such that there is no way it could have been a farce. The %person_dude% smiles at you.%SPEECH_ON%I think I am in good health and ready to serve you as I did my liege.%SPEECH_OFF%The kings of these lands have long since fallen, replaced by squabbling lords and nobles. If this %person_dude% can fight for you as well as %they_dude% did for the kings, then the %companyname% has brighter days ahead surely.}"
        es = "[img]gfx/ui/events/event_82.png[/img]{Encuentras a %guard% estirándose con una agilidad sorprendente. No se parece en nada %al_dude% %hombre_dude% helad%o_dude% y aterid%o_dude% que encontraste abandonad%o_dude% en el hielo por aquellos bárbaros. Al verte, asiente y se acerca a hablarte en voz baja.%SPEECH_ON%Me alegra que confiaras en mí, capitán. Quizá lo hiciste por la bondad de tu corazón, pero tengo que enseñarte algo.%SPEECH_OFF%Te muestra un emblema del que has oído hablar muchas veces, pero que nunca habías visto: lleva el sello de la Guardia del rey y está tan impecable que es imposible que sea una farsa. %Art_dude% %hombre_dude% te sonríe.%SPEECH_ON%Creo que estoy bien de salud y list%o_dude% para servirte como serví a mi señor.%SPEECH_OFF%Los reyes de estas tierras cayeron hace mucho, sustituidos por señores y nobles que no paran de reñir. Si %ese_dude% %hombre_dude% puede luchar por ti tan bien como luchó por los reyes, sin duda a la %companyname% le esperan días más brillantes.}"
    }
    // context: kings_guard_2_event.o.create.s.start._event.m.Dude.getBackground().m.RawDescription
    {
        // corrige base: «La misma espada que sirvió a reyes...ahora dará su vida por la compañia.» es un añadido que el inglés no tiene (y «compañia» va sin tilde).
        // corrige base: «Guardia real» no sigue el glosario; «King's Guard» es «Guardia del rey».
        en = "You found %name% frozen half to death in the north. With your help, the former King's Guard regained %their% strength and now fights for you."
        es = "Encontraste a %name% congelad%o% a punto de morir en el norte. Con tu ayuda, %art% antigu%o% Guardia del rey ha recuperado su fuerza y ahora lucha a tu lado."
    }
    // context: kings_guard_2_event.o.create.s.start._event.m.Dude.improveMood()
    {
        en = "Is %their% former self again"
        es = "Vuelve a ser quien era"
    }
    // en = "<actor:str> gains <v:val_tag> Melee Defense"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Ranged Defense"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Melee Skill"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Max Fatigue"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Initiative"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Hitpoints"
    // en base_es
    // FILE: mod_legends\hooks\events\events\dlc4\location\icy_cave_enter_event.nut
    // context: icy_cave_enter_event.o.create.::Legends.Screens.hook()
    // en = "A1"
    // identificador de pantalla
    // en = "As you approach..."
    // en base_es
    // en = "I need you to scout ahead, <bro:str>."
    // en base_es
    // en = "We should leave this place."
    // en base_es
    // context: icy_cave_enter_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «heads off» es «se aleja», no «desaparece».
        // corrige base: se perdió «loud» («his loud voice echoes not at all»); el contraste es que una voz potente no haga eco.
        en = "[img]gfx/ui/events/event_144.png[/img]{%chosen% heads off while you and the rest work on the front of the cave. You knock a few of the thick icicles out letting you see into the cave with better eyes. Just as you do, %chosen% comes tumbling down an adjacent slope and lands right in the middle of the cave and slides across the frozen river and rides up its embankment. %They_champion% hops to %their_champion% feet and dusts %themselves_champion% off with a childish grin.\n\n In a flash the huddled man slams the pickaxe into the ice with unhinted power and the shards splinter from one side of the embankment to the other. The clank of the metal and shattered ice reverberates as though lightning itself had struck. Now you can finally see the stranger: he is a barbarian shelled in broken armor that rattles as he moves. The icy walls mirror his steps, scattering his presence all around the cave in transient sheens. Jittery and jutting, his walk is seemingly going backwards despite his advance as though his shadow were his true self and his flesh the afterimage. Despite being in a cave, his loud voice echoes not at all.%SPEECH_ON%An interloper in my midst, a mere moment from the mist, these things I shall not miss.%SPEECH_OFF%He approaches the sellsword like a cold spider unfurling from its trapdoor. You see that his face is half-frozen, and a wry smile squeezes across the half that could still be called flesh.%SPEECH_ON%I long to leave this body, my dear fighter. Will you help guide me out and to something higher?%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_144.png[/img]{%chosen% se aleja mientras trabajas con el resto en la entrada de la cueva. Derribas algunos de los gruesos carámbanos, lo que te permite ver mejor dentro de la cueva. Justo cuando lo haces, %chosen% cae rodando por una pendiente adyacente y aterriza en medio de la cueva, deslizándose por el río congelado y subiendo por su orilla. Se pone de pie y se sacude el polvo con una sonrisa infantil.\n\nEn un instante, el hombre acurrucado golpea el hielo con el pico con una fuerza inesperada y los fragmentos se astillan de un lado del terraplén al otro. El sonido metálico y el hielo roto resuenan como si hubiera caído un rayo. Ahora finalmente puedes ver al desconocido: es un bárbaro cubierto de una armadura rota que hace ruido al moverse. Las paredes heladas reflejan sus pasos, dispersando su presencia por toda la cueva en fulgores fugaces. Su andar nervioso y brusco parece retroceder a pesar de su avance, como si su sombra fuera su verdadero ser y su carne la imagen residual. A pesar de estar en una cueva, su voz atronadora no produce eco alguno.%SPEECH_ON%Un intruso en mi presencia, a un paso de la niebla, estas cosas no las extrañaré.%SPEECH_OFF%Se acerca al mercenario como una fría araña desplegándose desde su trampilla. Ves que su rostro está medio congelado, y una sonrisa irónica se extiende por la mitad que todavía se puede llamar carne.%SPEECH_ON%Deseo abandonar este cuerpo, querido luchador. ¿Me ayudarás a salir y alcanzar algo más elevado?%SPEECH_OFF%}"
    }
    // context: icy_cave_enter_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «cuts the madman down» es «abate», no «corta».
        // corrige base: «tendrils» son filamentos, no «tendones».
        // corrige base: «Just a crazy fuck» quedó rebajado a «Solo un loco»; se restituye la crudeza.
        // corrige base: «strangely sparkling rime» es escarcha, que la 1.0 perdió, y «wild grin» es una sonrisa desquiciada, no «amplia».
        // corrige base: «holds it at length» es sostenerla con el brazo extendido, no «con cautela».
        // corrige base: «Tienes la sustancia y la armadura puestas» calca «You have ... put»; es «haces guardar». «Jugándote trucos» es calco; en castellano es «jugar una mala pasada».
        en = "[img]gfx/ui/events/event_144.png[/img]{%chosen% cuts the madman down. His chest armor shatters and flies off his body, chunks of plate spinning and warbling into the air and yet tethered together by some strange blue tendrils.\n\n Your men finally break through the icy cavern's entrance and slide down the declination. %chosen% is quite alright, nodding smugly as %they_champion% sheathes %their_champion% weapon.%SPEECH_ON%Just a crazy fuck, captain.%SPEECH_OFF%You crouch beside the body. Ice contorts half the flesh, twisting it into nubs of black, and what isn't frozen is flaked by strangely sparkling rime. Despite his grisly state, the mad man died with a wild grin still on his face. The eyes are a bright blue and you see yourself in their gaze, a faceless silhouette. And then the color slowly slips away, not like you've seen before, but as though someone were dragging a curtain through a window, slowly sucking all color right into the sockets. The corpse grins at you, but you refuse to believe that is what you saw.\n\n One of the mercenaries picks up the mad man's bizarre armor and holds it at length.%SPEECH_ON%What do you figure this is?%SPEECH_OFF%The plates dangle from one another by some strange blue gelatin, and the insides of the metal slats are coated in bubbling, twirling blues as though it were the work of some celestial blacksmith. It is cool to the touch and gives beneath the slightest push of your finger. You've never seen or felt anything like it, but the armor itself is currently in an unusable state. You have the goop and armor put into inventory, scour the cave for more goods which there are none. Before you leave the cave, you glance at the corpse one last time. You think you saw it move again, but surely it is the cold of the frozen north that is playing tricks on you.}"
        es = "[img]gfx/ui/events/event_144.png[/img]{%chosen% abate al loco. Su armadura de pecho se quiebra y vuela lejos de su cuerpo, pedazos de placa girando y retorciéndose en el aire, pero aún unidos por extraños filamentos azules.\n\nFinalmente, tus hombres abren camino a través de la entrada de la caverna helada y se deslizan por la pendiente. %chosen% está bastante bien, asintiendo con suficiencia mientras enfunda su arma.%SPEECH_ON%Solo era un puto loco, capitán.%SPEECH_OFF%Te agachas junto al cuerpo. El hielo retuerce la mitad de la carne, convirtiéndola en protuberancias negras, y lo que no está congelado está cubierto de escamas de una escarcha extrañamente centelleante. A pesar de su estado macabro, el loco murió con una sonrisa desquiciada aún en el rostro. Los ojos son de un azul brillante y te ves reflejado en su mirada, una silueta sin rostro. Y luego el color se desvanece lentamente, no como lo has visto antes, sino como si alguien estuviera arrastrando una cortina a través de una ventana, succionando lentamente todo el color directamente en las cuencas. El cadáver te sonríe, pero te niegas a creer que eso es lo que viste.\n\nUno de los mercenarios recoge la extraña armadura del loco y la sostiene con el brazo extendido.%SPEECH_ON%¿Qué crees que es esto?%SPEECH_OFF%Las placas cuelgan unas de otras por una extraña gelatina azul, y el interior de las láminas de metal está recubierto de burbujeantes azules, como si fuera obra de algún herrero celestial. Está frío al tacto y cede ante el ligero empujón de tu dedo. Nunca has visto ni sentido algo así, pero la armadura en sí está actualmente en un estado inutilizable. Haces guardar la sustancia y la armadura en el inventario y registras la caverna en busca de más objetos, pero no encuentras ninguno. Antes de dejar la cueva, miras el cadáver una última vez. Te parece que lo has visto moverse de nuevo, pero seguramente es el frío del norte helado, que te está jugando una mala pasada.}"
    }
    // en = "Defeat"
    // en base_es
    // context: icy_cave_enter_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_144.png[/img]{Through the icicles you can see the madman cutting down %chosen%. Even as %they_champion% lies dead on the ground, the stranger continues to hack away at %them_champion%, and each time a muffled thump echoes through the cave. What will you do now?}"
        es = "[img]gfx/ui/events/event_144.png[/img]{A través de los carámbanos ves cómo el loco abate a %chosen%. Aun cuando ya yace muert%o_champion% en el suelo, el desconocido sigue acuchillándo%lo_champion%, y a cada golpe un ruido sordo resuena por la cueva. ¿Qué vas a hacer ahora?}"
    }
    // FILE: mod_legends\hooks\events\events\dlc4\location\tundra_elk_destroyed_event.nut
    // context: tundra_elk_destroyed_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «frozen solid» es «congelado por completo», no «congelado, sólido».
        // corrige base: «tendrils» son filamentos, no «tentáculos» (como en icy_cave_enter_event).
        // corrige base: «jalar las placas juntas» calca «pull the plates together»; es «jalar las placas hasta unirlas».
        // corrige base: «have the mind to keep it in inventory to see» es guardarla para averiguarlo; «la cautela» y «probarla más tarde» no están en el inglés. «Matted elk fur conjoins» es piel apelmazada que se funde con el metal, no que «se enreda». Calcos: «destella un deslumbrante destello», «se dobla de rodillas ... se dobla» y «%randombrother% dice,» tras la cita.
        en = "[img]gfx/ui/events/event_146.png[/img]{With the killing blow well placed, the Ijirok clambers side to side gripping its final wound. It lets out a howl of pain and buckles at the knees and can only barely hold itself up with one hand as its body doubles over and vomits into the ground. But the whole thing seems like a charade and the beast at times looks over as though to make sure you are watching. It is a drama. A poorly acted show put on by that which does not know death in any sense. The eyes lock with yours and that unsettling grin returns, then the monstrosity flashes a blinding strobe of blue and when the natural light of the world returns the corpse is frozen solid and flakes of snow drizzle from the sky.\n\n That can't be it. You just know it. You walk up to the iced remains and start chopping away. As you hew into the ice, a blue ooze drips from channels and gaps. One final swing smashes the ice apart and a blob of goo runs every which way. As the men looked on rather concerned, you grab the shattered armor from the cave and throw it into the Ijirok's blood. The strange tendrils which held its pieces together instantly brighten and you watch as they begin to twist taut and pull the plates together. Matted elk fur conjoins with the metal as though they were one being coming to heal old wounds. Blood snakes over the plates like moss twirling beneath a riverbed, curling to and fro before flattening out and painting the armor a slick red. \n\nPicking it up, you feel a buzz on your fingertips.%SPEECH_ON%I hope you don't suggest I wear that, captain.%SPEECH_OFF%%randombrother% says, shaking %their_randombrother% head with a nervous smile. You're not yet sure what the armor is capable of, but no doubt have the mind to keep it in inventory to see. As for the Ijirok, you've no doubt it is still out there somewhere. Its corpse is already decaying rapidly and the bones which remain are not that of a giant beast but simply that of a poor elk.}"
        es = "[img]gfx/ui/events/event_146.png[/img]{Con el golpe mortal bien colocado, el Ijirok se tambalea de lado a lado agarrando su herida mortal. Deja escapar un aullido de dolor, se le doblan las rodillas y apenas puede sostenerse con una mano mientras su cuerpo se encorva y vomita en el suelo. Pero todo parece una farsa, y la bestia a veces mira por encima como para asegurarse de que estás mirando. Es un drama. Un espectáculo mal interpretado realizado por algo que no conoce la muerte en ningún sentido. Los ojos se encuentran con los tuyos y esa inquietante sonrisa regresa, luego la monstruosidad lanza un cegador destello azul y cuando la luz natural del mundo vuelve, el cadáver está congelado por completo y copos de nieve caen del cielo.\n\nEso no puede ser todo. Lo sabes. Te acercas a los restos helados y comienzas a golpear. A medida que golpeas el hielo, una sustancia azul gotea desde canales y brechas. Un último golpe rompe el hielo y un montón de baba corre en todas direcciones. Mientras los hombres observan bastante preocupados, tomas la armadura destrozada de la cueva y la arrojas a la sangre del Ijirok. Los extraños filamentos que sostenían sus piezas juntas se iluminan al instante y observas cómo comienzan a retorcerse, a tensarse y a jalar las placas hasta unirlas. La piel apelmazada de alce se funde con el metal como si fueran un solo ser curando viejas heridas. La sangre se desliza sobre las placas como musgo retorcido bajo el lecho de un río, rizando de un lado a otro antes de aplanarse y pintar la armadura de un rojo brillante.\n\nAl levantarla, sientes un cosquilleo en tus dedos.%SPEECH_ON%Espero que no sugieras que me ponga eso, capitán.%SPEECH_OFF%%randombrother% lo dice sacudiendo la cabeza con una sonrisa nerviosa. Aún no estás seguro de lo que es capaz de hacer la armadura, pero tienes muy claro que la guardarás en el inventario para averiguarlo. En cuanto al Ijirok, no tienes duda de que todavía está por ahí en alguna parte. Su cadáver ya se está descomponiendo rápidamente y los huesos que quedan no son los de una bestia gigante, sino simplemente los de un pobre alce.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc4\lone_wolf_origin_squire_event.nut
    // context: lone_wolf_origin_squire_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «pub» es «taberna»; «bar» es anacrónico en el juego.
        // corrige base: «wench or wife or whore» quedó rebajado a «taberneras, esposas o prostitutas»; es «mozas, esposas o putas».
        en = "[img]gfx/ui/events/event_20.png[/img]The pub is full of drunk denizens sloshing about, cheering, singing, carousing with the womenfolk of either wench or wife or whore. A man with a lute dances and plays and another with metal cymbals crashes overhead while a fat man booms with songs of battles or love, and whether a tale of victory or defeat they provoke rounds of ale and more merriment all the same.\n\n You leave the pub and enter the next building over. The wind whistles down a pew filled nave as you stand at the door. A man sweeping the stone floor looks up for a time then continues with his work. Another man cheerfully crosses the room and asks if you'd like to pray. You decline and he purses his lips and crosses his arms. The crowd next door roars with drunken delight as though to make a mockery of you both and then he moves on. You stay for a moment longer and then leave and go back out to the town center and squat on a series of steps. It seems there used to be a statue at the top of those steps, but vandals and raiders alike have made short work of another's artisanry. You fall asleep there at the foot of impermanence. \n\n Waking from a nap, you find a young %person_dude% at the bottom of the steps. %They_dude% says %they_dude% knows you're a knight and %they're_dude% come to offer %their_dude% services as a squire."
        es = "[img]gfx/ui/events/event_20.png[/img]La taberna está llena de lugareños ebrios, chapoteando, vitoreando, cantando y disfrutando de las mujeres, ya sean mozas, esposas o putas. Un hombre con un laúd baila y toca, mientras otro hace sonar címbalos de metal sobre su cabeza, y un hombre gordo entona canciones sobre batallas o el amor, y ya sea una historia de victoria o derrota, provocan rondas de cerveza y más alegría por igual.\n\nSales de la taberna y entras en el edificio de al lado. El viento silba por un templo lleno de bancos mientras te paras en la puerta. Un hombre barriendo el suelo de piedra te mira durante un tiempo y luego continúa con su trabajo. Otro hombre cruza la sala con alegría y te pregunta si quieres rezar. Declinas y él frunce los labios y cruza los brazos. La multitud de al lado ruge con deleite ebrio como si quisiera burlarse de ambos, y luego él se va. Te quedas por un momento más y luego sales y vuelves al centro del pueblo, donde te sientas en una serie de escalones. Parece que solía haber una estatua en la parte superior de esos escalones, pero vándalos y saqueadores por igual han acabado con el trabajo artesanal de otro. Te quedas dormido allí a los pies de la impermanencia.\n\nCuando te despiertas de una siesta, encuentras a %un_dude% joven al pie de los escalones. Dice que sabe que eres un caballero y que ha venido a ofrecer sus servicios como escuder%o_dude%."
    }
    // context: lone_wolf_origin_squire_event.o.create.::Legends.Screens.hook()._screen.start._event.m.Dude.getBackground().m.RawDescription
    {
        // _event.m.Dude.getBackground().m.RawDescription = "You met %name% in " + _event.m.Town.getName() + " where %they% volunteered to be your squire. %They% probably had no idea what %they% was getting into back then.";
        mode = "pattern"
        // corrige base: «El chico» es un añadido que el inglés no tiene.
        en = "You met %name% in <town:str> where %they% volunteered to be your squire. %They% probably had no idea what %they% was getting into back then."
        es = "Conociste a %name% en <town>, donde se ofreció a seguirte como tu escuder%o%. Probablemente no tenía ni idea de en qué se estaba metiendo en ese momento."
    }
    // en = "the Squire"
    // en base_es
    // context: lone_wolf_origin_squire_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_20.png[/img]{The %person_dude% shakes %their_dude% head no.%SPEECH_ON%Ain't never killed no one, sir.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_20.png[/img]{%Art_dude% %hombre_dude% niega con la cabeza.%SPEECH_ON%Nunca he matao a nadie, señor.%SPEECH_OFF%}"
    }
    // context: lone_wolf_origin_squire_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_20.png[/img]{The %person_dude% stands up straight.%SPEECH_ON%I know how to sharpen steel and mend leather. I can disassemble and reassemble heavy and light armors both, no matter how complex or simple, and I can do it fast. If we have a horse.%SPEECH_OFF%You interrupt.%SPEECH_ON%I walk.%SPEECH_OFF%Shifting uneasily on %their_dude% feet, the %person_dude% continues.%SPEECH_ON%Alright. Well I can cook. I can cook a fine meal whether I got the ingredients or not. I make do. And. And. That's. That's about it. But I'm willing to learn!%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_20.png[/img]{%Art_dude% %hombre_dude% se yergue.%SPEECH_ON%Sé afilar el acero y remendar el cuero. Puedo desmontar y volver a montar armaduras tanto pesadas como ligeras, por complejas o sencillas que sean, y lo hago rápido. Si tenemos un caballo...%SPEECH_OFF%%Lo_dude% interrumpes.%SPEECH_ON%Yo voy a pie.%SPEECH_OFF%Removiéndose incómod%o_dude%, %art_dude% %hombre_dude% continúa.%SPEECH_ON%Está bien. Bueno, sé cocinar. Puedo preparar una buena comida tenga los ingredientes o no. Me las arreglo. Y. Y. Eso. Eso es todo, más o menos. ¡Pero estoy dispuest%o_dude% a aprender!%SPEECH_OFF%}"
    }
    // context: lone_wolf_origin_squire_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // _screen.Text = "[img]gfx/ui/events/event_20.png[/img]{You ask the %person_dude% %their_dude% name. %They_dude% swallows nervously.%SPEECH_ON%%squire%, sir.%SPEECH_OFF%You nod.%SPEECH_ON%Well alright then. I\'ll take ya with me.%SPEECH_OFF%%They_dude% smiles.%SPEECH_ON%That\'s. That\'s it?%SPEECH_OFF%You nod.%SPEECH_ON%Yeah. That\'s it.%SPEECH_OFF%%squire% looks around.%SPEECH_ON%Well. Alright. What now?%SPEECH_OFF%You lean back against the stone steps.%SPEECH_ON%You follow me. Right now I\'m gonna take another nap. If yer still around when I wake, well, then you\'ve passed your first test. Defeating boredom.%SPEECH_OFF%The squire is grinning ear to ear. %They're_dude% still there when you wake.}";
        mode = "pattern"
        // corrige base: «That's. That's it?» / «That's it.» es «¿Ya. Ya está?» / «Ya está», no «¿E-en serio?» / «en serio».
        // corrige base: «Para tu sorpresa» es un añadido que el inglés no tiene.
        en = "[img]gfx/ui/events/event_20.png[/img]{You ask the %person_dude% %their_dude% name. %They_dude% swallows nervously.%SPEECH_ON%%squire%, sir.%SPEECH_OFF%You nod.%SPEECH_ON%Well alright then. I'll take ya with me.%SPEECH_OFF%%They_dude% smiles.%SPEECH_ON%That's. That's it?%SPEECH_OFF%You nod.%SPEECH_ON%Yeah. That's it.%SPEECH_OFF%%squire% looks around.%SPEECH_ON%Well. Alright. What now?%SPEECH_OFF%You lean back against the stone steps.%SPEECH_ON%You follow me. Right now I'm gonna take another nap. If yer still around when I wake, well, then you've passed your first test. Defeating boredom.%SPEECH_OFF%The squire is grinning ear to ear. %They're_dude% still there when you wake.}"
        es = "[img]gfx/ui/events/event_20.png[/img]{Le preguntas su nombre %al_dude% %hombre_dude%. Traga saliva nerviosamente.%SPEECH_ON%%squire%, señor.%SPEECH_OFF%Asientes.%SPEECH_ON%Bien... está bien. Te llevaré conmigo.%SPEECH_OFF%Sonríe.%SPEECH_ON%¿Ya. Ya está?%SPEECH_OFF%Asientes.%SPEECH_ON%Sí. Ya está.%SPEECH_OFF%%squire% mira a su alrededor.%SPEECH_ON%Bien. De acuerdo. ¿Y ahora qué?%SPEECH_OFF%Te recuestas contra los escalones de piedra.%SPEECH_ON%Me sigues. Ahora mismo voy a tomar otra siesta. Si todavía estás aquí cuando despierte, bueno, entonces habrás pasado tu primer examen. Vencer el aburrimiento.%SPEECH_OFF%%Art_dude% escuder%o_dude% sonríe de oreja a oreja. Todavía sigue allí cuando te despiertas.}"
    }
    // context: lone_wolf_origin_squire_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: errata «no tienes porque que estar»; es «no tienes por qué estar».
        en = "[img]gfx/ui/events/event_20.png[/img]{You look at the would-be squire long and hard and then tell %them_dude% no. %They_dude% shrugs.%SPEECH_ON%Just so you know, you ain't gotta be alone in this world. Loneliness has no presence. It is not a place. It is not a being. It is action!%SPEECH_OFF%Spitting, you wipe your face and laugh.%SPEECH_ON%Is that what you tell yourself every morning? Get out of here.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_20.png[/img]{Miras fijamente %al_dude% aspirante a escuder%o_dude% y luego le dices que no. Se encoge de hombros.%SPEECH_ON%Solo para que lo sepas, no tienes por qué estar solo en este mundo. La soledad no tiene presencia. No es un lugar. No es un ser. ¡Es una decisión!%SPEECH_OFF%Escupiendo, te frotas la cara y te ríes.%SPEECH_ON%¿Es eso lo que te dices a ti mism%o_dude% todas las mañanas? Lárgate de aquí.%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\dlc4\raiders_origin_redemption_event.nut
    // en = "Your relations to <faction:str> improve"
    // en base_es
    // FILE: mod_legends\hooks\events\events\dlc4\wild_dog_sounds_event.nut
    // en = "You're a hunter, %hunter%, go take a look."
    // en base_es
    // context: wild_dog_sounds_event.o.create.s.start.Options.push().Text
    {
        en = "You came from the wilds, %wildman%, go take a look."
        es = "Tú vienes de las tierras salvajes, %wildman%. Ve a echar un vistazo."
    }
    // en = "Looks like a job for the new guy. Go take a look, %recruit%!"
    // en base_es
    // context: wild_dog_sounds_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_33.png[/img]{You tell the company to ignore the sounds. That's a hard task to oblige as the cries of the wild dogs only grow louder and louder until, just like that, they stop. Your mercenaries stand still as though making any noise could bring the hell of whatever horror it is that's out there. Nothing comes to pass, but a number of the company have a hard time sleeping through the night.}"
        es = "[img]gfx/ui/events/event_33.png[/img]{Le dices a la compañía que ignore los ruidos. Es una orden difícil de cumplir, porque los aullidos de los perros salvajes no hacen más que crecer y crecer hasta que, de repente, cesan. Tus mercenarios se quedan inmóviles, como si hacer cualquier ruido pudiera atraer el infierno de lo que sea que acecha ahí fuera. No pasa nada, pero a varios miembros de la compañía les cuesta dormir en toda la noche.}"
    }
    // en = "Didn't get a good night's sleep"
    // en base_es
    // en = "<bro:str> is exhausted"
    // en base_es
    // context: wild_dog_sounds_event.o.create.s.Text
    {
        // corrige base: omite que el capitán ya se ha metido una bola de cera en un oído («before you can get the second ear»), y luego «Retiras la cera» no tiene sentido.
        en = "[img]gfx/ui/events/event_33.png[/img]{You tell the company to plug their ears if it bothers them so much. As the cries of the wild dogs grow louder the company turn to impromptu ear candling to keep the sounds at bay. Eventually, the sense deprived sellswords are awkwardly walking around like animatronics. You look to join the muted, plugging a waxball into your ear, but before you can get the second ear a loud crash sends inventory flowing and a tent billows as it collapses. You drain your ear and bark orders to the mercenaries who are scattered all over the camp.}"
        es = "[img]gfx/ui/events/event_33.png[/img]{Le dices a la compañía que se tapen los oídos si tanto les molesta. A medida que los aullidos de los perros salvajes aumentan de volumen, la compañía improvisa tapones de cera para los oídos para mantener a raya los sonidos. Con el tiempo, los mercenarios privados de su sentido del oído caminan torpemente como gólems. Te dispones a unirte a los ensordecidos y te metes una bola de cera en un oído, pero antes de que puedas taparte el otro, un fuerte estruendo hace que el inventario se derrame y una tienda se desploma. Retiras la cera de tu oído y das órdenes a gritos a los mercenarios, que están dispersos por todo el campamento.}"
    }
    // context: wild_dog_sounds_event.o.create.s.Text
    {
        // corrige base: «grow a pair» se adaptó como «'ya tienen pelo ahi abajo' como para preocuparse», que desvía el sentido, rebaja la crudeza y lleva errata («ahi»); es «que le echen huevos».
        // corrige base: «they'd not found the print but had been stomped there» significa que no cayeron en la huella, sino que los aplastaron allí; la 1.0 lo calca sin sentido.
        // corrige base: «dead on its feet» es «muerto de pie», no «muerto en sus patas».
        // corrige base: «slings forward a rack of meat» es «lanza hacia delante un costillar», no «avanza con una parrilla de carne».
        en = "[img]gfx/ui/events/event_14.png[/img]{It does appear the mercenaries will not be assuaged by telling them to grow a pair. %hunter% elects to go seek out the noise, sure it's nothing more than the wild dogs squabbling over primacy over the pack. You agree, the archer venturing into the dark all alone. Just as soon as the outline is gone the canines cease their crying and you hear a growl that seems as though it came from a much higher ground. The whole camp is dead silent, daring not to even move.\n\n An hour later and the hunter walks into camp, nobody having heard the archer come in. The hunter is camouflaged in mud slaked with twigs and leaves. %hunter%'s grafted stems into a hood, worn like some arboreal abbess. With hushed tones, the sellswords ask what it was. With a shrug the reply comes.%SPEECH_ON%Well. I seen about a dozen dead dogs. Some ripped apart. Found a few in the pit of very large footprints and they'd not found the print but had been stomped there, you know. And I saw something move along in the shadows between the tree tops and it went the other way and I did not follow. I found a deer dead on its feet leaning against a tree. Heart faltered by whatever it saw, I suppose. I harvested everything I could.%SPEECH_OFF%The hunter turns and slings forward a rack of meat strung to a paneling of wood and leaves.%SPEECH_ON%Anyone hungry?%SPEECH_OFF%} "
        es = "[img]gfx/ui/events/event_14.png[/img]{Parece que a los mercenarios no los va a tranquilizar que les digas que le echen huevos. %hunter% decide ir a buscar el origen del ruido, con la certeza de que no son más que los perros salvajes peleándose por el dominio de la manada. Das tu aprobación, y la silueta se adentra a solas en la oscuridad. En cuanto desaparece de la vista, los perros dejan de aullar y oyes un gruñido que parece venir de un terreno mucho más alto. En todo el campamento reina un silencio sepulcral; nadie se atreve siquiera a moverse.\n\nUna hora después, vuelve al campamento sin que nadie haya oído sus pasos. Trae un camuflaje de barro mezclado con ramitas y hojas. %hunter% se ha hecho una capucha entretejiendo tallos y la lleva como una especie de abadesa arbórea. En voz baja, los mercenarios preguntan qué era aquello. La respuesta llega con un encogimiento de hombros.%SPEECH_ON%Bueno. Vi como una docena de perros muertos. Algunos despedazados. Encontré unos cuantos en el fondo de unas huellas muy grandes, y no es que hubieran ido a parar a la huella, sino que los habían aplastado ahí mismo, ¿sabes? Y vi algo moverse entre las sombras de las copas de los árboles; se fue para el otro lado y no lo seguí. Encontré un ciervo muerto de pie, apoyado contra un árbol. Se le pararía el corazón con lo que fuera que vio, supongo. Aproveché todo lo que pude.%SPEECH_OFF%Se da la vuelta y lanza hacia delante un costillar de carne atado a un armazón de madera y hojas.%SPEECH_ON%¿Alguien tiene hambre?%SPEECH_OFF%} "
    }
    // en = "<actor:str> gains <v:val_tag> Resolve"
    // en base_es
    // en = "Concerned that there's something big out there"
    // en base_es
    // context: wild_dog_sounds_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_33.png[/img]{You look about the company. A young %recruit% looks back. Looking down, as though to look within themself, and then hurriedly gets to their feet.%SPEECH_ON%Say no more, captain. I will find out what this disturbance is.%SPEECH_OFF%The fresh recruit gathers their things and then stands at the edge of the camp's light, a very dark forest looking back at them. The mercenary stares down again and clenches and unclenches their hands.%SPEECH_ON%Alright. Alright.%SPEECH_OFF%He looks up.%SPEECH_ON%Let's do this.%SPEECH_OFF%The recruit is never seen again.}"
        es = "[img]gfx/ui/events/event_33.png[/img]{Recorres a la compañía con la mirada. %recruit%, que es joven, te devuelve la mirada. Baja la vista, como si mirara dentro de sí, y luego se pone en pie apresuradamente.%SPEECH_ON%No digas más, capitán. Yo averiguaré qué es esta perturbación.%SPEECH_OFF%La nueva incorporación reúne sus cosas y se planta en el borde de la luz del campamento, con un bosque muy oscuro devolviéndole la mirada. Vuelve a mirar hacia abajo y cierra y abre los puños.%SPEECH_ON%Bien. Bien.%SPEECH_OFF%Alza la vista.%SPEECH_ON%Hagámoslo.%SPEECH_OFF%Nunca se le vuelve a ver.}"
    }
    // en = "Went missing"
    // en base_es
    // en = "<name:str> went missing"
    // en base_es
    // context: wild_dog_sounds_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_33.png[/img]{You look about the company. A young %recruit% looks back. They look down, as though to look within themself, and then hurriedly gets to their feet.%SPEECH_ON%Say no more, captain. I will find out what this disturbance is.%SPEECH_OFF%The fresh recruit gathers their things and then stands at the edge of the camp's light, a very dark forest looking back at them. The mercenary stares down again and clenches and unclenches their hands. %recruit% huffs and then steps forth, immediately slipping into the shadows. Hours pass. Finally, %recruit% returns. Their clothes are in tatters. Weapons are gone.  Spitting forth story after story. Magic rings, volcanoes, giant eagles, absolute nonsense. Whatever %recruit% saw, it's clear the blubbering sellsword needs to clear their head with some well earned beauty sleep. Which the'll get since all that awful noise has ceased.}"
        es = "[img]gfx/ui/events/event_33.png[/img]{Recorres a la compañía con la mirada. %recruit%, que es joven, te devuelve la mirada. Baja la vista, como si mirara dentro de sí, y luego se pone en pie apresuradamente.%SPEECH_ON%No digas más, capitán. Yo averiguaré qué es esta perturbación.%SPEECH_OFF%La nueva incorporación reúne sus cosas y se planta en el borde de la luz del campamento, con un bosque muy oscuro devolviéndole la mirada. Vuelve a mirar hacia abajo y cierra y abre los puños. %recruit% resopla y da un paso al frente, y se pierde al instante entre las sombras. Pasan las horas. Por fin, %recruit% regresa. Trae la ropa hecha jirones. Las armas han desaparecido. Suelta una historia tras otra. Anillos mágicos, volcanes, águilas gigantes, puros disparates. Sea lo que sea lo que vio %recruit%, entre tanto balbuceo está claro que necesita despejar la cabeza con un buen sueño reparador, bien merecido. Y lo tendrá, porque todo ese espantoso ruido ha cesado.}"
    }
    // en = "<actor:str> gains <v:val_tag> Experience"
    // en base_es
    // en = "Had an excellent adventure"
    // en base_es
    // en = "You lose <item:str>"
    // en base_es
    // en = "recruit"
    // FILE: mod_legends\hooks\events\events\dlc6\belly_dancer_event.nut
    // context: belly_dancer_event.o.create.s.Text
    {
        // corrige base: «shoots a tiny dagger» es «lanza», no «dispara» (una daga no se dispara).
        // corrige base: erratas «sus pies en puntillas» (es «de puntillas») y «grande,;corta».
        // corrige base: «claps gently» quedó en «aplaude por esto»; se recupera «suavemente».
        // corrige base: «the whole midriff exposed» es el vientre al descubierto, no «toda la zona del torso».
        en = "[img]gfx/ui/events/event_163.png[/img]{A belly dancer magnetizes %townname%'s center plaza. Rhythmic movements on their own can coerce a beggar to donating a crown, but with the stage of the whole plaza it is enough to draw crowds and with it heaps of gold. Masked by green silk, nearly see through, and clothed in thin silks with the whole midriff exposed, the dancer is no doubt an expert in her field. She whirls, hips hypnotic, elbows bowed, hands clapping little cymbals, her feet tiptoeing as she spins a spot so tight there very well may be an invisible god above holding her in place as she razzles and dazzles.\n\n Someone throws an apple through the air and the dancer spins around and shoots a tiny dagger through it, plugging it dead center and dropping the fruit to the ground. Another apple soars in and this time a large saber is produced and slashes the stem off and she catches the rest and takes a bite. The crowd claps gently to this.}"
        es = "[img]gfx/ui/events/event_163.png[/img]{Una bailarina del vientre magnetiza el centro de la plaza de %townname%. Los movimientos rítmicos por sí solos pueden persuadir a un mendigo para que done una corona, pero con el escenario de toda la plaza es suficiente para atraer multitudes y con ellas montones de oro. Enmascarada por seda verde, casi transparente, y vestida con telas delgadas que dejan al descubierto todo el vientre, la bailarina es sin duda una experta en su campo. Gira, caderas hipnóticas, codos arqueados, manos golpeando pequeños platillos, de puntillas mientras gira en un espacio tan reducido que muy bien podría haber un dios invisible sobre ella sosteniéndola en su lugar mientras deslumbra y asombra.\n\nAlguien lanza una manzana por el aire y la bailarina gira y le lanza una pequeña daga que la atraviesa, clavándola por el centro y haciendo caer la fruta al suelo. Otra manzana vuela y esta vez aparece un sable grande que corta el tallo, y ella atrapa el resto y le da un mordisco. La multitud aplaude suavemente.}"
    }
    // context: belly_dancer_event.o.create.s.Text
    {
        // corrige base: «Sacaste ... lanzaste» en pasado; el inglés va en presente, como el resto del evento.
        // corrige base: «with a toe» es «con un dedo del pie», y «clay pot» es «vasija de barro», no «maceta de arcilla».
        en = "[img]gfx/ui/events/event_163.png[/img]{You take out a crown and flip it to the dancer. Her eyes catch its glint, but she doesn't break the dance. She drops her weapons and sashays over, cymbals clattering, hips gyrating, her knees hardly bending, her feet almost mystically carrying her across the ground. She claps the cymbals in your face, then swings around, briefly bumping you with her hips, and starts to dance back to the middle. She picks up your coin with a toe and flips it up and it lands in a clay pot. The crowd cheers.}"
        es = "[img]gfx/ui/events/event_163.png[/img]{Sacas una corona y se la lanzas a la bailarina. Sus ojos captan su brillo, pero no interrumpe la danza. Deja caer sus armas y se acerca contoneándose, címbalos resonando, caderas girando, sus rodillas apenas se doblan, sus pies casi místicamente la llevan por el suelo. Choca los címbalos frente a tu rostro, luego da un giro, te da un breve golpe de cadera y comienza a danzar de regreso al centro. Recoge tu moneda con un dedo del pie, la lanza hacia arriba y la moneda cae en una vasija de barro. La multitud la vitorea.}"
    }
    // context: belly_dancer_event.o.create.s.Options[0].Text
    {
        en = "Maybe we can make use of this woman?"
        es = "¿Quizás podamos hacer uso de esta mujer?"
    }
    // context: belly_dancer_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_163.png[/img]{After the belly dancer takes your crown you wait around for the show to end. You approach as she picks up daggers and coins. She looks at you with a wry smile.%SPEECH_ON%Ah, an admirer. Sorry, only one show tonight, darling.%SPEECH_OFF%You shake your head and ask if she knows anything about fighting. She nods.%SPEECH_ON%The Gilded One's gleam is upon us all, but not at all hours or days. Sometimes, we must find our own way through the dark. I take it by your dress that you are a Crownling, putting that blade of yours where it does and sometimes does not belong.%SPEECH_OFF%You nod and ask her if she'd be interested in joining. She drops, bowlegged, and sinks to the ground like a collapsing truss. She counts her crowns.%SPEECH_ON%I'm not sure if you have a good eye for the wandering nature of ones such as myself. Perhaps there is a certain... recognition, for those of us willing to kill for what we want. That said, you'll have to try harder to get me to go around killing for coin...%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_163.png[/img]{Cuando la bailarina del vientre se queda con tu corona, esperas a que termine el espectáculo. Te acercas mientras recoge dagas y monedas. Te mira con una sonrisa irónica.%SPEECH_ON%Ah, un admirador. Lo siento, solo hay una función esta noche, cariño.%SPEECH_OFF%Niegas con la cabeza y le preguntas si sabe algo de pelear. Asiente.%SPEECH_ON%El brillo del Dorado está sobre todos nosotros, pero no a todas horas ni todos los días. A veces tenemos que encontrar nuestro propio camino en la oscuridad. Por tu atuendo, supongo que eres un Cuentacoronas, de los que meten esa espada donde corresponde y, a veces, donde no.%SPEECH_OFF%Asientes y le preguntas si le interesaría unirse. Se deja caer, con las piernas arqueadas, y se hunde hasta el suelo como un armazón que se desploma. Cuenta sus coronas.%SPEECH_ON%No sé si tienes buen ojo para la naturaleza errante de gente como yo. Quizá haya cierto... reconocimiento entre quienes estamos dispuestos a matar por lo que queremos. Dicho esto, tendrás que esforzarte más para que me ponga a matar por dinero...%SPEECH_OFF%}"
    }
    // context: belly_dancer_event.o.create.s.start._event.m.Dude.getBackground().m.RawDescription
    {
        // _event.m.Dude.getBackground().m.RawDescription = "You found %name% in " + _event.m.Town.getName() + ", masked by green silk and drawing crowds with rhythmic movements and impressively precise fruit slicing. The latter skill is a boon to any mercenary company, and so you didn\'t hesitate to recruit %them%.";
        mode = "pattern"
        en = "You found %name% in <town:str>, masked by green silk and drawing crowds with rhythmic movements and impressively precise fruit slicing. The latter skill is a boon to any mercenary company, and so you didn't hesitate to recruit %them%."
        es = "Encontraste a %name% en <town>, enmascarad%o% por seda verde y atrayendo multitudes con movimientos rítmicos y cortes de fruta impresionantemente precisos. Esta última habilidad es una ventaja para cualquier compañía de mercenarios, así que no dudaste en reclutar%lo%."
    }
    // context: belly_dancer_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_163.png[/img]{You assuage her ego by saying she's one of the best with the blade you've seen. The dancer turns her hands to the dust, her fingers sliding beneath each coin and flipping it into her clay pot. Her left hand reaches across the ground, but as this catches your eye, her right hand snatches a blade that had been entirely buried beneath the sands. She holds it toward your crotch.%SPEECH_ON%I'm deadly with the blade, as I'm sure you are with that stinger there. Now, I know you are merely petting things which shall make me purr, preying upon my pride as the hunter does the lions, and I will say this: it has worked. I will fight for you, captain of the Crownlings, and I will fight well.%SPEECH_OFF%Nodding, you ask that she lower the blade. She spins it in her hand and sheathes it in one swift motion. She gets to her feet and dresses in a more sturdy outfit.%SPEECH_ON%This life I will leave behind in total, and to the Crownling's life I will be devoted in whole.%SPEECH_OFF%You shake the woman's hand. Just at that moment, a leering passerby struts over and attempts to clutch her by her hips. Without as much as a glance nor warning, she throws a knife out of nowhere, landing point first in a pole right next to the passerby's hips. He stumbles backwards, yelling in a mix a fear and surprise%SPEECH_ON%Hey! I thought you were a lady of the dance! I just wanted to dance!%SPEECH_OFF%Finally turning to face him, her expression darkens into a foreboding smile%SPEECH_ON% How uncouth! You'd best be careful what you ask for. I now dance the dance of death%SPEECH_OFF%The dancer looks at you and laughs.%SPEECH_ON%We've all dangers to confront in our respective vocations, Crownling, and I look forward to seeing yours.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_163.png[/img]{Halagas su ego diciéndole que es de las mejores que has visto con una espada. La bailarina lleva las manos al polvo; sus dedos se deslizan bajo cada moneda y la lanzan a su vasija de barro. Su mano izquierda se estira por el suelo, pero mientras eso atrae tu mirada, su mano derecha arrebata una hoja que estaba enterrada por completo bajo la arena. Te la apunta a la entrepierna.%SPEECH_ON%Soy letal con la espada, como seguro que tú lo eres con ese aguijón de ahí. Ya sé que solo me estás acariciando donde me hace ronronear, aprovechándote de mi orgullo como hace el cazador con los leones, y te diré una cosa: ha funcionado. Lucharé por ti, capitán de los Cuentacoronas, y lucharé bien.%SPEECH_OFF%Asintiendo, le pides que baje la hoja. La hace girar en la mano y la enfunda en un solo movimiento rápido. Se pone en pie y se viste con un atuendo más resistente.%SPEECH_ON%Dejaré atrás esta vida por completo, y me entregaré en cuerpo y alma a la vida de Cuentacoronas.%SPEECH_OFF%Estrechas la mano de la mujer. Justo en ese momento, un transeúnte lascivo se acerca pavoneándose e intenta agarrarla por las caderas. Sin una mirada ni una advertencia, ella lanza un cuchillo salido de la nada, que se clava de punta en un poste justo al lado de las caderas del transeúnte. Él retrocede a trompicones, gritando entre el miedo y la sorpresa.%SPEECH_ON%¡Eh! ¡Creía que eras una dama de la danza! ¡Solo quería bailar!%SPEECH_OFF%Volviéndose por fin hacia él, su expresión se ensombrece en una sonrisa amenazadora.%SPEECH_ON%¡Qué grosero! Mejor ten cuidado con lo que pides. Ahora bailo la danza de la muerte.%SPEECH_OFF%La bailarina te mira y se ríe.%SPEECH_ON%Todos tenemos peligros que afrontar en nuestros respectivos oficios, Cuentacoronas, y estoy deseando ver los tuyos.%SPEECH_OFF%}"
    }
    // context: belly_dancer_event.o.create.s.Text
    {
        // corrige base: «Crownling» aparece como «Buscafortuna»; se unifica con «Coronero» (hoy «cuentacoronas»), que la 1.0 usa en holywar_outro_south_event.
        // corrige base: se omitió el segundo «Crownling» («and earn your coin, Crownling»).
        en = "[img]gfx/ui/events/event_163.png[/img]{You tell the dancer that she is one of the best you've seen with a blade. She laughs.%SPEECH_ON%A truly well intentioned attempt on your part, Crownling, to drag me to your ways of life. But you know well that there is nothing you could say or do that would take me away from this life. Yes, the blade suits me well, but so does flittering about for the crowd, earning praise without spilling blood to do it. You go play gladiator on the sands and earn your coin, Crownling, and I will be here earning mine.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_163.png[/img]{Le dices a la bailarina que es de las mejores que has visto con una espada. Se ríe.%SPEECH_ON%Un intento verdaderamente bien intencionado de tu parte, Cuentacoronas, de arrastrarme a tu forma de vida. Pero sabes bien que no hay nada que puedas decir o hacer que me aleje de esta vida. Sí, la espada me queda bien, pero también me siento cómoda danzando para la multitud, ganando elogios sin derramar sangre para lograrlo. Ve y juega a los gladiadores en las arenas y gánate tus monedas, Cuentacoronas, que yo estaré aquí ganándome las mías.%SPEECH_OFF%}"
    }
    // context: belly_dancer_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_163.png[/img]{You offer five hundred crowns to the dancer. She keeps picking up the coins from her performance- one at a time - and putting them in her clay pot. It is almost a silent affair, coins clapping loudly as they fall into a nearly empty barrel of clay. She looks up, looks down. She puts in one more crown then gets to her feet. She strips off her clothes and holds out her hand.%SPEECH_ON%The Gilded One must be gleaming upon us both, for you to have earned such keep, and no doubt He has guided your purse here to bring it to me.%SPEECH_OFF%You nod and shake her hand. The dancer asks that she take a look at your inventory.%SPEECH_ON%A body like mine, anything will fit, inside or out, I'll make it work.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_163.png[/img]{Le ofreces quinientas coronas a la bailarina. Ella sigue recogiendo las monedas de su actuación, una a una, y metiéndolas en su vasija de barro. Es un asunto casi silencioso, salvo por las monedas que resuenan con fuerza al caer en una tinaja de barro casi vacía. Alza la vista, la baja. Echa una corona más y se pone en pie. Se quita la ropa y te tiende la mano.%SPEECH_ON%El Dorado debe de estar brillando sobre nosotros dos para que te hayas ganado semejante sustento, y sin duda Él ha guiado tu bolsa hasta aquí para traérmela.%SPEECH_OFF%Asientes y le estrechas la mano. La bailarina pide echar un vistazo a tu inventario.%SPEECH_ON%Con un cuerpo como el mío, todo me entra, por dentro o por fuera. Ya me las arreglo.%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\dlc6\crisis\holywar_crucified_1_event.nut
    // context: holywar_crucified_1_event.o.create.s.Text
    {
        en = "{[img]gfx/ui/events/event_161.png[/img]{In the middle of the desert wastes one has to be somewhat suspicious of anything they come across, especially if it's a lone figure on the road. The stranger sways from side to side as they drink the last of their water to talk. %SPEECH_ON%Although it may not look it, crownlings, I am one of the best healers and limb-hackers in these parts...%SPEECH_OFF% They sway a little more and take one last drink. %SPEECH_ON%My camp was overrun by knights from the north — I refused to abandon those in need but after they were killed in their beds, I had no choice but to run.%SPEECH_OFF%}"
        es = "{[img]gfx/ui/events/event_161.png[/img]{En medio de los páramos del desierto, uno tiene que desconfiar un poco de cualquier cosa que encuentre, sobre todo si es una figura solitaria en el camino. La figura se tambalea de un lado a otro mientras apura lo que le queda de agua para poder hablar.%SPEECH_ON%Aunque no lo parezca, cuentacoronas, en estas tierras no hay quien cure y ampute miembros mejor que yo...%SPEECH_OFF%Se tambalea un poco más y da un último trago.%SPEECH_ON%Mi campamento fue arrasado por caballeros del norte. Me negué a abandonar a los necesitados, pero después de que los mataran en sus camas, no tuve más remedio que huir.%SPEECH_OFF%}"
    }
    // context: holywar_crucified_1_event.o.create.s.Options[0].Text
    {
        en = "And what now?"
        es = "¿Y ahora qué?"
    }
    // context: holywar_crucified_1_event.o.create.s.Text
    {
        en = "{[img]gfx/ui/events/event_161.png[/img]{The stranger nods.%SPEECH_ON%I know a few things about medicine — I know it is not in a crownling's nature to help others but I would surely be able to help you in the coming days of this war and beyond.%SPEECH_OFF%}"
        es = "{[img]gfx/ui/events/event_161.png[/img]{La figura asiente.%SPEECH_ON%Sé algunas cosas de medicina. Sé que ayudar a los demás no está en la naturaleza de un cuentacoronas, pero sin duda podría ayudarlos en los próximos días de esta guerra, y también después.%SPEECH_OFF%}"
    }
    // context: holywar_crucified_1_event.o.create.s.Options[1].Text
    {
        en = "I don't believe you. Keep walking."
        es = "No te creo. Sigue tu camino."
    }
    // context: holywar_crucified_1_event.o.create.s.Text
    {
        en = "{[img]gfx/ui/events/event_161.png[/img]{You reach for your belt and toss your waterskin to the half cooked stranger. They file in but will need some time to recover.}"
        es = "{[img]gfx/ui/events/event_161.png[/img]{Te llevas la mano al cinturón y le lanzas tu odre a la figura medio cocida por el sol. Se une a la columna, pero necesitará algo de tiempo para recuperarse.}"
    }
    // context: holywar_crucified_1_event.o.create.s.Options[0].Text
    {
        en = "We could use someone who knows how to attach limbs for once."
        es = "Nos vendría bien alguien que sepa unir miembros, para variar."
    }
    // context: holywar_crucified_1_event.o.create.s.start._event.m.Dude.improveMood()
    {
        en = "Was rescued from the desert"
        es = "Le salvaron la vida en el desierto"
    }
    // context: holywar_crucified_1_event.o.create.s.start.bro.improveMood()
    {
        en = "Saved a dying surgeon from the desert"
        es = "Salvó en el desierto a alguien moribundo que sabe de cirugía"
    }
    // context: holywar_crucified_1_event.o.create.s.Text
    {
        en = "{[img]gfx/ui/events/event_150.png[/img]{You tell the stranger to keep walking, casually thumbing the direction behind you from where you came. The stranger, half cooked in the heat mutters something under the breath and continues in the direction you came from.}"
        es = "{[img]gfx/ui/events/event_150.png[/img]{Le dices a la figura que siga su camino y, sin darle importancia, señalas con el pulgar la dirección por la que has venido. Medio cocida por el calor, la figura masculla algo entre dientes y continúa hacia el lugar del que vienes.}"
    }
    // context: holywar_crucified_1_event.o.create.s.Options[0].Text
    {
        en = "A real surgeon? Not likely."
        es = "¿Que sabe cirugía de verdad? Lo dudo."
    }
    // FILE: mod_legends\hooks\events\events\dlc6\crisis\holywar_ill_southerners_event.nut
    // en = "Approved of your decision to end the suffering of fellow Gilded"
    // en base_es
    // en = "Disliked that you ended the suffering of southern invaders"
    // en base_es
    // FILE: mod_legends\hooks\events\events\dlc6\crisis\holywar_outro_north_event.nut
    // context: holywar_outro_north_event.o.create.s.Text
    {
        // corrige base: «crownling» traducido como «noble», que cambia el sentido; es «coronero».
        // corrige base: «a small fortune» quedó en «una fortuna».
        // corrige base: errata «coronas?n\n» (falta la barra del salto de línea) y «totems» sin tilde.
        // corrige base: «son burlados» usa «burlar» (engañar) por «burlarse de»; es «son objeto de burla».
        en = "[img]gfx/ui/events/event_84.png[/img]{Faith placed in the old gods has been rewarded: the holy war is over, and the northerners stand victorious. Songs fill the air as crowds move as a mob, fists pumping, flags flying, becoming briefly uniform in a shared sense of piety. You stand by the wayside, your shoulders already wreathed in adornments, beads, necklaces, things of no material value, and yet they bear some weight which the wearer can only find by looking into the eyes of those who hand them out.\n\n Of course, certain dignities go unrealized in the celebration: the bodies of the defeated are put on display, thrashed in ways meant to satisfy the old gods that are watching, and holy totems of the Gilder are mocked, desecrated, and ultimately burned. And it is indeed certain that not a joyful soul will recognize you as a force in this cheerful culmination. You've merely slipped right into the background once more, sellsword, crownling, interloper. But the %companyname% made a small fortune in the religious endeavors. Despite the smiles and laughs, you know that strife such as this is buried in the mind, not in the earth, and someday someone or something will come and resurrect it, and there the company will await another glorious payday. Or perhaps now would be a good time to put up the sword and enjoy your crowns?\n\n%OOC%Something burns down inside of you. Something that struggles to be free. Perhaps it is the success you have have had along the way, or the failings that you couldn't stop in time. Maybe there is more out there to see?%OOC_OFF%}"
        es = "[img]gfx/ui/events/event_84.png[/img]{La fe depositada en los viejos dioses ha sido recompensada: la guerra sagrada ha terminado y los del Norte se alzan victoriosos. Canciones llenan el aire mientras las multitudes se mueven como una turba, puños en alto, banderas ondeando, volviéndose brevemente uniformes en un sentido compartido de piedad. Te quedas al margen, tus hombros ya adornados con collares, abalorios, cosas de ningún valor material, y sin embargo, llevan consigo un peso que solo el portador puede sentir al mirar a los que los distribuyen.\n\nPor supuesto, ciertas dignidades pasan desapercibidas en la celebración: los cuerpos de los derrotados se exhiben, maltratados de formas destinadas a satisfacer a los viejos dioses que observan, y los tótems sagrados del Dorado son objeto de burla, profanados y finalmente quemados. Y es cierto que ningún alma alegre te reconocerá como una fuerza en esta alegre culminación. Simplemente te has deslizado de nuevo al fondo, mercenario, cuentacoronas, intruso. Pero %companyname% hizo una pequeña fortuna en los esfuerzos religiosos. A pesar de las sonrisas y risas, sabes que un conflicto como este está enterrado en la mente, no en la tierra, y algún día alguien o algo vendrá y lo resucitará, y allí la compañía esperará otro glorioso día de pago. ¿O tal vez ahora sería un buen momento para guardar la espada y disfrutar de tus coronas?\n\n%OOC%Algo arde en lo más hondo de ti. Algo que lucha por liberarse. Quizá sea el éxito que has tenido por el camino, o los fracasos que no pudiste evitar a tiempo. ¿Quizá haya más por ver ahí fuera?%OOC_OFF%}"
    }
    // context: holywar_outro_north_event.o.create.s.Text
    {
        // corrige base: «both got their dues» es que ambas (espada y bolsa) recibieron lo suyo; «obtuvieron su merecido» sugiere castigo.
        // corrige base: «Encantador como esto es» calca «Endearing as this is». «Sellswords that you are, you put faith in your sword» va en segunda persona e incluye al capitán; la 1.0 lo pasó a tercera («confían»).
        en = "[img]gfx/ui/events/event_84.png[/img]{Uttering their name is to draw words from tongue to intemporal: the old gods. They are beyond time, and their vast number invoke awe over specificity. Endearing as this is to any listener familiar or not with the faith, it also brings greater weight to any defeat of those who follow these unbranded beings. The crusades are over, and the northerners have lost.\n\n You watch as the northerners try and explain it to one another how it came to pass. It was not a terrestrial defeat here, nor even a victory by the southerners - no, this was punishment. Northerners have grazed far from the holy lands, they have meadowed in the material world, priories and churches dot the realm, empty and hollow for far too long. Naturally, inquiries about the nature of this southern 'Gilder' have also come, but they quickly pass. To even dwell on Him is to invite doubt, and right now doubt is as dangerous as any poison. Of course, the %companyname% stays at a distance. Sellswords that you are, you put faith in your sword and in the purse, and both got their dues in this war. The only philosophizing you'll be doing in the days to come is pondering just how soon the north and south will resume stating their differences. Perhaps now would be a good time to put up the sword and enjoy your crowns?\n\n%OOC%Something burns down inside of you. Something that struggles to be free. Perhaps it is the success you have have had along the way, or the failings that you couldn't stop in time. Maybe there is more out there to see?%OOC_OFF%}"
        es = "[img]gfx/ui/events/event_84.png[/img]{Pronunciar su nombre es traer palabras de la lengua a lo intemporal: los viejos dioses. Están más allá del tiempo y su vasto número invoca asombro sobre la especificidad. Por entrañable que resulte para cualquier oyente, familiarizado o no con la fe, esto también otorga un mayor peso a cualquier derrota de aquellos que siguen a estos seres sin marca. Las cruzadas han terminado, y los del norte han perdido.\n\nObservas cómo los del norte intentan explicarse entre ellos cómo sucedió. No fue una derrota terrestre aquí, ni siquiera una victoria de los del sur; no, esto fue un castigo. Los del norte han pastado lejos de las tierras sagradas, han pastoreado en el mundo material, prioratos e iglesias salpican el reino, vacíos y huecos durante demasiado tiempo. Naturalmente, también han surgido preguntas sobre la naturaleza de este \"Dorado\" del sur, pero rápidamente se desvanecen. Incluso detenerse en Él es invitar a la duda, y en este momento la duda es tan peligrosa como cualquier veneno. Por supuesto, %companyname% se mantiene a distancia. Como mercenario que eres, pones tu fe y la de los tuyos en la espada y en la bolsa, y ambas recibieron lo que les correspondía en esta guerra. La única reflexión que harás en los días venideros es preguntarte cuán pronto el norte y el sur volverán a expresar sus diferencias. ¿Tal vez ahora sería un buen momento para guardar la espada y disfrutar de tus coronas?\n\n%OOC%Algo arde en lo más hondo de ti. Algo que lucha por liberarse. Quizá sea el éxito que has tenido por el camino, o los fracasos que no pudiste evitar a tiempo. ¿Quizá haya más por ver ahí fuera?%OOC_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\dlc6\crisis\holywar_outro_south_event.nut
    // context: holywar_outro_south_event.o.create.s.Text
    {
        // corrige base: «leveling the old gods» es arrasarlos o derribarlos, no «igualar a los viejos dioses».
        // corrige base: «Some misplaced notion that» es «una idea errónea», no «Algunos tenían»; «an onlooker to pitch herself in» es una espectadora; «the hardening iron» es hierro que se está endureciendo, no ya endurecido. Calcos: «caerá desde arriba» (will plummet) y «no necesitas desear tener la oportunidad de nuevo».
        en = "[img]gfx/ui/events/event_84.png[/img]{You recall the followers of the Gilder to once be united in their pursuit of leveling the old gods. Some misplaced notion that, were they to satisfy their God enough, He would put his powerful eye upon all enemies of His faithful and obliterate them. Instead, the Gilded find their resolve greatly tested: they have lost the holy war. Cities and towns have been burned, holy totems desecrated, and sacred grounds looted.\n\n Crowds of people listlessly shift about in the streets, wailing now and again, not with purpose, but as though they've lost all language to articulate the pain they must now endure. On occasion, a body will plummet from above, or you find the guards pulling corpses out of the well only for an onlooker to pitch herself in. A few prostrate themselves before golden relics, letting themselves cook in the sun struck glare of the shiny emblems, the grief stricken crawling beneath the simmering reflections until their skins turn to crust and their throats choke on their own flesh, and as the sun comes and goes, bodies lay in the wake of its stare. As for the %companyname%, you've put yourself to one side or the other, and regardless of winners or losers, you made a small fortune. For the future you need not wish to have the opportunity again, either: if there's one thing you know about a man of faith it's that defeat is only but one strike upon the hardening iron. With all that you've achieved, perhaps now would be a good time to put up the sword and enjoy your crowns?\n\n%OOC%Something burns down inside of you. Something that struggles to be free. Perhaps it is the success you have have had along the way, or the failings that you couldn't stop in time. Maybe there is more out there to see?%OOC_OFF%}"
        es = "[img]gfx/ui/events/event_84.png[/img]{Recuerdas que los seguidores del Dorado alguna vez estaban unidos en su empeño por arrasar a los viejos dioses. Albergaban la errónea idea de que, si satisfacían lo suficiente a su dios, Él posaría su poderoso ojo sobre todos los enemigos de sus fieles y los aniquilaría. En cambio, los dorados ven su resolución seriamente probada: han perdido la guerra sagrada. Ciudades y pueblos han sido quemados, tótems sagrados profanados y lugares sagrados saqueados.\n\nMultitudes de personas se desplazan sin rumbo por las calles, lamentándose de vez en cuando, no con un propósito, sino como si hubieran perdido todo lenguaje para expresar el dolor que ahora deben soportar. De vez en cuando, un cuerpo se desploma desde lo alto, o encuentras a los guardias sacando cadáveres del pozo solo para que una espectadora se arroje dentro. Algunos se postran ante reliquias doradas, dejándose cocinar bajo el resplandor del sol en los brillantes emblemas, arrastrándose en medio de los reflejos hirvientes hasta que sus pieles se convierten en costra y sus gargantas se ahogan con su propia carne, y mientras el sol va y viene, los cuerpos quedan en el rastro de su mirada. En cuanto a %companyname%, te has colocado en un lado u otro, y sin importar ganadores o perdedores, has hecho una pequeña fortuna. Y ni siquiera hace falta que desees que la ocasión se repita: si hay algo que sabes sobre un hombre de fe es que la derrota es solo un golpe más sobre el hierro que se endurece. Con todo lo que has logrado, ¿quizás ahora sería un buen momento para guardar la espada y disfrutar tus coronas?\n\n%OOC%Algo arde en lo más hondo de ti. Algo que lucha por liberarse. Quizá sea el éxito que has tenido por el camino, o los fracasos que no pudiste evitar a tiempo. ¿Quizá haya más por ver ahí fuera?%OOC_OFF%}"
    }
    // context: holywar_outro_south_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_84.png[/img]{Faith placed in the Gilder has been rewarded: the holy war is over, and the southerners stand victorious. The Vizier, councilmen, and clergy alike are found in the streets, each riding great wagons which, in place of wheels, are lofted on the backs of slaves. Northern slaves, particularly, indebted to the Gilder for their crimes. You can hardly see the men, just their legs black in shadow as though a procession of swaying beetles was on the go. The wealthy and profligate men take great chalices and hurl what looks like golden water upon the cheering faithful. You yourself lean into one of these splashes, but find it is merely just tinted water.\n\n While the faux fortunes served only to slake your thirst, the very real war between the followers of the old gods and the Gilded themselves served to fill the %companyname%'s treasury. As a Crownling, you'll never find the respect of bared heads and bowed bodies, nor the prostrations of peasants, nor the gleam of gold too heavy for any one man to carry. That is the reality for you, but that won't stop the company from being ready the next time the pious wanna have a squabble over righteousness. Or perhaps now would be a good time to put up the sword and enjoy your crowns?\n\n%OOC%Something burns down inside of you. Something that struggles to be free. Perhaps it is the success you have have had along the way, or the failings that you couldn't stop in time. Maybe there is more out there to see?%OOC_OFF%}"
        es = "[img]gfx/ui/events/event_84.png[/img]{La fe depositada en el Dorado ha sido recompensada: la guerra sagrada ha terminado y los sureños se alzan victoriosos. El Visir, los consejeros y el clero se encuentran en las calles, cada uno montando grandes carros que, en lugar de ruedas, son sostenidos por la espalda de esclavos. Especialmente, esclavos del norte, deudores ante el Dorado por sus crímenes. Apenas puedes ver a los hombres, solo sus piernas en sombra como si fuera una procesión de escarabajos meciéndose. Los hombres adinerados y pródigos toman grandes cálices y arrojan lo que parece ser agua dorada sobre los fieles que vitorean. Tú mismo te inclinas hacia uno de estos salpicones, pero descubres que es simplemente agua teñida.\n\nMientras las falsas riquezas solo sirvieron para saciar tu sed, la guerra real entre los seguidores de los viejos dioses y los propios dorados sirvió para llenar las arcas de %companyname%. Como Cuentacoronas, nunca encontrarás el respeto de cabezas descubiertas y cuerpos inclinados, ni las postraciones de los campesinos, ni el destello de oro demasiado pesado para que un solo hombre lo cargue. Esa es la realidad para ti, pero eso no impedirá que la compañía esté lista la próxima vez que los piadosos quieran discutir sobre la rectitud. ¿O tal vez ahora sería un buen momento para guardar la espada y disfrutar de tus coronas?\n\n%OOC%Algo arde en lo más hondo de ti. Algo que lucha por liberarse. Quizá sea el éxito que has tenido por el camino, o los fracasos que no pudiste evitar a tiempo. ¿Quizá haya más por ver ahí fuera?%OOC_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\dlc6\crisis\holywar_sand_storm_event.nut
    // en = "Approved of your decision to end the suffering of fellow northerners"
    // en base_es
    // en = "Disliked that you ended the suffering of northern invaders"
    // en base_es
    // FILE: mod_legends\hooks\events\events\dlc6\cultural_conflagration_event.nut
    // context: cultural_conflagration_event.o.create.s.Text
    {
        // corrige base: «old gods» aparece como «antiguos dioses»; en el resto de la 1.0 son «viejos dioses».
        // corrige base: «hot arse sandy dune» y «sumbitch» quedaron rebajados («maldita duna caliente», y el insulto desaparece de la imitación); se restituye la crudeza.
        // corrige base: «each other» es «unos a otros», no «a ellos mismos».
        en = "[img]gfx/ui/events/event_175.png[/img]{Shouting and yelling drags you from counting inventory. You find a few of the mercenaries standing at opposite ends of the campfire pointing fingers and even a weapon or two. Seems there's a bit of a dustup over whose people are more beautiful: southerners or northerners. Ironically, the northerners are voting for the southerners and vice versa. A couple of stern commands brings order back to the company, but the tensions remain. | There's been a bit of fisticuffs between some of the company. Apparently, there was a disagreement about the marriage rites. The northerners believe it should be one and one, while the southerners prefer marrying as many as one can get their hands on. You tell the company to stop fighting like unmarried children and focus on the task at hand, which may or may not be to finish a job to get coin to then spend on a marriage, but that's neither here nor there. | A couple of the mercenaries get into it over some religious differences. Some conflict over the old gods and the Gilder, each mercenary a little ambassador of their faith, diplomatically putting fists into the opposition's faces. You tell them all to quit it and get their heads straight. If they want to argue over which gods are best, they can do it in the afterlife. | A couple of the mercenaries get into it over matters of... sand? It seems the northerners in the company are poking fun at the southerners, asking how stupid one would have to be to settle in a land with nothing but sand.%SPEECH_ON%Who looks around in a hot arse sandy dune and thinks, aye, this'll be my home. Bet you wish yer forefathers had a proper mind to realize there's more to the world than a gods damned forever sunburn.%SPEECH_OFF%This garners the first punch thrown. The scuffle has a few injured, but you get the company back to order, commanding them to keep their geographic opinions to themselves. | An argument breaks out when southerners in the company start poking fun at their northern's lack of articulation. One mimics with their hands splayed out at ears.%SPEECH_ON%We's all talks like this, aye, yessir, ain't y'all ready to come on to somesuch sumbitch thing, aye? Ain't ain't ain-%SPEECH_OFF%Fisticuffs end the jestering. A few are bruised in the exchange, but you manage to break it up before it gets more serious. | Though normally dismissive of their overlords, the northerners and the southerners take to defending the lords and Viziers of their lands respectively. It seems the foil of having some cultural opposition has spurred heretofore unseen fealties. The arguments unwind into an actual fist fight, with not a lord around to be impressed, mind. You break it up, telling them the only one they should look to impress is either you or each other as comrades in battle.}"
        es = "[img]gfx/ui/events/event_175.png[/img]{Los gritos y alborotos interrumpen tu conteo de inventario. Encuentras a algunos mercenarios parados en extremos opuestos de la fogata señalándose e incluso con alguna arma. Parece que hay una disputa sobre qué gente es más hermosa: la del sur o la del norte. Irónicamente, los del norte votan por los del sur y viceversa. Un par de órdenes firmes devuelven el orden a la compañía, pero las tensiones persisten. | Ha habido algún que otro puñetazo entre miembros de la compañía. Al parecer, hubo una discrepancia sobre los ritos matrimoniales. Los del norte creen que debería ser uno con uno, mientras que los del sur prefieren casarse con tantos como sea posible. Le dices a la compañía que deje de pelear como críos solteros y se centre en la tarea que tiene entre manos, que puede o no ser terminar un trabajo para ganar monedas y luego gastarlas en una boda, pero eso no viene al caso. | Un par de mercenarios se enzarzan por algunas diferencias religiosas. Algo de conflicto sobre los viejos dioses y el Dorado, cada mercenario un pequeño embajador de su fe, poniendo diplomáticamente sus puños en la cara de la oposición. Les dices a todos que lo dejen y se aclaren las ideas. Si quieren discutir sobre qué dioses son mejores, pueden hacerlo en el más allá. | Un par de mercenarios se enzarzan por cuestiones de... ¿arena? Parece que los del norte en la compañía se burlan de los del sur, preguntándoles qué tan estúpido habría que ser para establecerse en una tierra sin nada más que arena.%SPEECH_ON%¿Quién mira a su alrededor en una puta duna de arena ardiente y piensa: sí, este será mi hogar? Apuesto a que desearías que tus ancestros hubieran tenido el sentido común de darse cuenta de que hay más en el mundo que una maldita quemadura de sol eterna.%SPEECH_OFF%Esto provoca el primer puñetazo. La pelea deja a algunos heridos, pero logras devolver el orden a la compañía, ordenándoles que se guarden sus opiniones geográficas para ellos mismos. | Estalla una discusión cuando los sureños de la compañía comienzan a burlarse de la falta de elocuencia de sus compañeros del norte. Uno los imita con las manos abiertas junto a las orejas.%SPEECH_ON%Tos' hablamo' asín, sí, señó, ¿no tán listo' pa' meterse en argún lío d'esos, hijo'e puta, eh? No tán, no tán, no t-%SPEECH_OFF%Los puñetazos terminan con las bromas. Algunos quedan magullados en el intercambio, pero logras detenerlo antes de que se ponga más serio. | Aunque normalmente desdeñan a sus señores, los del norte y los del sur se ponen a defender a los señores y visires de sus respectivas tierras. Parece que el contraste cultural ha suscitado fidelidades nunca antes vistas. Las discusiones desembocan en una pelea real, sin ningún señor presente para impresionar, claro está. Lo detienes, diciéndoles que a los únicos que deberían intentar impresionar es a ti o unos a otros, como camaradas de batalla.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc6\desert_bugbite_event.nut
    // context: desert_bugbite_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_161.png[/img]{While standing around looking at maps and taking inventory, %bitbro% suddenly yells out and falls over in the sand. %They_someguy% slaps at %their_someguy% legs and a black scorpion goes soaring. Another sellsword screams and chops the bug in half with the sort of ferocity you've never even seen him use on the battlefield. %bitbro% clenches %their_someguy% teeth as %they_someguy% takes off %their_someguy% boots. It looks like someone jammed a nail into %their_someguy% ankle. %They_someguy% says %they're_someguy% feeling woozy, but it's not too serious.}"
        es = "[img]gfx/ui/events/event_161.png[/img]{Mientras están por ahí mirando mapas y haciendo inventario, %bitbro% grita de repente y cae sobre la arena. Se da manotazos en las piernas y un escorpión negro sale volando. Alguien más de la compañía chilla y parte el bicho por la mitad con una ferocidad que nunca le has visto ni siquiera en el campo de batalla. %bitbro% aprieta los dientes mientras se quita las botas. Parece que le hubieran clavado un clavo en el tobillo. Dice que está maread%o_someguy%, pero no es demasiado grave.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc6\fire_juggler_event.nut
    // context: fire_juggler_event.o.create.s.Text
    {
        // corrige base: «un set de antorchas» es anglicismo y pierde el «trip-set»; es «un juego de tres antorchas».
        en = "[img]gfx/ui/events/event_163.png[/img]{A fire juggler has the eyes of everyone in a plaza of %townname%. He's got a trip-set of torches with bronze handles. His routine goes fairly well, but he does drop a torch at one point which raises some jeers in return. The next act he is to place a board over an open barrel of oil and then juggle the torches, arms out at his sides, except now with five torches instead of three.\n\nIn summary, his next act seems to be one of suicide and he unsurprisingly looks reluctant to follow through with it. But the crowd continues to cheer and jeer, no doubt snorting and huffing like a wolf pressing a deer to the cliffside, and the juggler, wide-eyed looks around for some form of escape.}"
        es = "[img]gfx/ui/events/event_163.png[/img]{Un malabarista con fuego tiene la atención de todos en una plaza de %townname%. Tiene un juego de tres antorchas con mangos de bronce. Su rutina va bastante bien, pero en un momento suelta una antorcha, lo que provoca algunas burlas a cambio. El siguiente acto consiste en colocar una tabla sobre un barril abierto de aceite y luego malabarear con las antorchas, con los brazos extendidos a los lados, excepto que ahora son cinco antorchas en lugar de tres.\n\nEn resumen, su próximo acto parece ser uno de suicidio y, comprensiblemente, parece renuente a llevarlo a cabo. Pero la multitud continúa vitoreando y burlándose, sin duda resoplando como un lobo empujando a un ciervo hacia el acantilado, y el malabarista, con los ojos bien abiertos, busca alguna forma de escapar.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc6\gladiators_food_event.nut
    // context: gladiators_food_event.o.create.s.Text
    {
        // corrige base: «gamey shit» es carne de sabor rancio, no «de juego», y «porquería» rebaja «shit»; es «mierda rancia».
        // corrige base: «delicassens» es errata y «delicatessens» extranjerismo; se unifica en «exquisiteces».
        // corrige base: «The Gladiators», con mayúscula en el inglés, va como «Gladiadores», según el glosario.
        // corrige base: «the coddled treatment the chefs there gave» son los mimos de los cocineros; «caprichosos tratos» cambia el sentido.
        en = "[img]gfx/ui/events/event_155.png[/img]{The Gladiators demand better food.%SPEECH_ON%I'm sorry, 'captain', but what would you have me do with this?%SPEECH_OFF%%gl% holds up a loaf of bread.%SPEECH_ON%Where's the meat? Look at it. LOOK. At it. Who made this? A baker? You want me to a baker's loaf? I want to eat that which fights back. Does bread fight back? I don't think so.%SPEECH_OFF%It seems the Gladiators might be far from the arena, but not far from the coddled treatment the chefs there gave day in and day out. Perhaps you should seek a variety of high quality food to keep them quelled. | %SPEECH_START%Where is the good stuff, huh?%SPEECH_OFF%%gl% holds up a piece of a meal. It is stringy and flops around in his hand.%SPEECH_ON%This is not the food of gladiators, it is the food of wimps!%SPEECH_OFF%With a turn the food is thrown and it slaps against the side of the company wagon where it unsticks and then curls over like an upside down hook.%SPEECH_ON%We demand good food, captain! None of this gamey shit.%SPEECH_OFF%You should probably look into getting the gladiators food that is more to their standards. | %SPEECH_START%Where's the wine? Where are the delicatessens!%SPEECH_OFF%%gl% takes a plate of food and throws it like a disc. It goes impressively far, bits of food spraying off in a cone of caloric debris.%SPEECH_ON%I demand delicatessens, captain! Where are my delicatessens?%SPEECH_OFF%It seems the gladiators require food of finer qualities.}"
        es = "[img]gfx/ui/events/event_155.png[/img]{Los Gladiadores exigen comida de mejor calidad.%SPEECH_ON%Lo siento, 'capitán', ¿pero qué se supone que debo hacer con esto?%SPEECH_OFF%%gl% levanta una hogaza de pan.%SPEECH_ON%¿Dónde está la carne? Mira esto. MIRA. Esto. ¿Quién hizo esto? ¿Un panadero? ¿Quieres que coma el pan de un panadero? Quiero comer algo que se defienda. ¿El pan se defiende? No lo creo.%SPEECH_OFF%Parece que los Gladiadores podrían estar lejos de la arena, pero no de los mimos que allí les daban los cocineros día tras día. Tal vez deberías buscar una variedad de comida de alta calidad para mantenerlos contentos. | %SPEECH_START%¿Dónde está lo bueno, eh?%SPEECH_OFF%%gl% sostiene un trozo de comida. Es fibroso y se mueve en su mano.%SPEECH_ON%¡Esto no es comida de gladiadores, es comida de cobardes!%SPEECH_OFF%Se da la vuelta y lanza la comida, que golpea el costado del carro de la compañía, se despega y luego se enrolla como un anzuelo boca abajo.%SPEECH_ON%¡Exigimos buena comida, capitán! Nada de esta mierda rancia.%SPEECH_OFF%Probablemente deberías considerar conseguir para los gladiadores comida que esté más a la altura de sus estándares. | %SPEECH_START%¿Dónde está el vino? ¡¿Dónde están las exquisiteces?!%SPEECH_OFF%%gl% toma un plato de comida y lo lanza como un disco. Va impresionantemente lejos, con pedazos de comida salpicando en un cono de escombros calóricos.%SPEECH_ON%¡Exijo exquisiteces, capitán! ¿Dónde están mis exquisiteces?%SPEECH_OFF%Parece que los gladiadores requieren comida de calidades más finas.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc6\gladiators_vibes_event.nut
    // context: gladiators_vibes_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_155.png[/img]{%gl1% watches %gl2% pluck their eyebrows, using a weapon blade for a mirror.%SPEECH_ON%Your back is looking thick and tight, %gl2%. Das it, mane.%SPEECH_OFF%The gladiator turns around and nods.%SPEECH_ON%Thanks, I use it to carry this company.%SPEECH_OFF% | %SPEECH_ON%Form check! Form check!%SPEECH_OFF%%gl1% yells while mid-squat. %gl2% rushes over and palms the gladiator's buttocks and yells 'go!'. The gladiator dips the squat far past ninety degrees.%SPEECH_ON%It's tight!%SPEECH_OFF%%gl2% confirms.%SPEECH_ON%How tight?%SPEECH_OFF%%gl2% takes a hand back, balls into a fist, and punches the gladiator's ass. %gl2%' hand flails back and forth like it touched a hot pan.%SPEECH_ON%Tighter than a Vizier's purse!%SPEECH_OFF%%gl1% finishes the squat and stands up and they chest bump.%SPEECH_ON%Your turn! Let's gooo!%SPEECH_OFF% | %SPEECH_ON%Hey. Look at this.%SPEECH_OFF%%gl1%'s chest bounces, one boob at a time. You mention it is impressive and move on, but %gl1% grabs you.%SPEECH_ON%They're pecs. And they're beautiful. Hey. Say they're beautiful.%SPEECH_OFF%One tit bumps, and then the other, back and forth. Sighing, you say they're beautiful. %gl1% nods and wipes something from their eye.%SPEECH_ON%Thanks, captain.%SPEECH_OFF% | You find %gl1% bench pressing %gl2%, the latter reading from a scroll as while going up and down.%SPEECH_ON%%randomcitystate% is said to have beautiful folk.%SPEECH_OFF%%gl2% looks down affectionately at %gl1% who is still lifting. %gl1% glances at you, then back to the workout.%SPEECH_ON%Ninety-eight. Ninety-nine. One hundred! Alright, flip over.%SPEECH_OFF%%gl2% rolls over, %gl1%'s hands puttying chest and belly.%SPEECH_ON%Alright, one-hundred more reps.%SPEECH_OFF% | %gl1% holds up four fingers. %gl2% holds up six. Head cocked, %gl1% laughs.%SPEECH_ON%In one night?%SPEECH_OFF%The other gladiator nods.%SPEECH_ON%Yessir. In one night.%SPEECH_OFF%%gl1% laughs and asks if they were all women. %gl2% hesitates.%SPEECH_ON%Well, there were a couple men there. But who knows which part belongs to whom. We got close though, cause at one point he was down there, and I was positioned like this behind-%SPEECH_OFF%You walk over clapping, not in applause but to tell the gladiators to stay focused. You understand the roads can be long and boring, but this is getting ridiculous. | %gl1% flexes a biceps.%SPEECH_ON%I could snap a mule's neck with one arm.%SPEECH_OFF%Head shaking, %gl2% asks why flex both arms then. %gl1%'s head cocks in return.%SPEECH_ON%Well obviously I plan to kill two mules at the same time.%SPEECH_OFF%You interrupt, telling the gladiators they won't be killing any animals until they complete the %companyname%'s primary tasks which is only sometimes to kill animals. | %gl1% sits beside %gl2% and turns away while saying.%SPEECH_ON%Put your hand on my spine. Right between the shoulders.%SPEECH_OFF%The other gladiator obliges without question or curiosity. In turn, %gl1% flexes, trapping the hand between two masses of muscle.%SPEECH_ON%How do you like that power?%SPEECH_OFF%Again, without a hint of irony or incredulity, %gl2% obliges a response.%SPEECH_ON%It is awesome! I can hear my hand bones cracking!%SPEECH_OFF%You think to interrupt, but technically nobody is hurt... yet. You leave the gladiators to their, eh, proclivities. | %SPEECH_START%So I had my lover over the fruit cart like this and we're just having a grand old time when their father walks in. He stands all slackjawed and can hardly get a word out.%SPEECH_OFF%%gl1% nods.%SPEECH_ON%So I says to him, watch this. And I stand back and flex with both arms and slowly, ever so slowly, my lover lifts up off the ground.%SPEECH_OFF%%gl2% slaps the other gladiator in his glistening chest.%SPEECH_ON%You lie! That's a buncha lies!%SPEECH_OFF%The gladiator holds a hand up.%SPEECH_ON%By the light of the Gilder, and whatever other gods may deem to gawk at my body, it is the truth. My love has power.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_155.png[/img]{%gl1% observa cómo %gl2% se depila las cejas usando la hoja de un arma como espejo.%SPEECH_ON%Esa espalda se ve ancha y dura, %gl2%. ¡Eso es, hermano!%SPEECH_OFF%%gl2% se da la vuelta y asiente.%SPEECH_ON%Gracias, la uso para llevar a cuestas a esta compañía.%SPEECH_OFF% | %SPEECH_ON%¡Mírame la técnica! ¡Mírame la técnica!%SPEECH_OFF%%gl1% lo grita en plena sentadilla. %gl2% se acerca corriendo, le planta la palma en las nalgas y grita '¡ya!'. %gl1% baja la sentadilla mucho más allá de los noventa grados.%SPEECH_ON%¡Está bien apretado!%SPEECH_OFF%%gl2% lo confirma.%SPEECH_ON%¿Pero cuánto?%SPEECH_OFF%%gl2% echa una mano hacia atrás, cierra el puño y le da un puñetazo en el culo a %gl1%. La mano de %gl2% se sacude de un lado a otro como si hubiera tocado una sartén caliente.%SPEECH_ON%¡Más apretado que la bolsa de un visir!%SPEECH_OFF%%gl1% termina la sentadilla, se pone de pie y chocan pecho con pecho.%SPEECH_ON%¡Te toca! ¡Vamooos!%SPEECH_OFF% | %SPEECH_ON%Oye. Mira esto.%SPEECH_OFF%El pecho de %gl1% rebota, una teta tras otra. Comentas que es impresionante y sigues tu camino, pero %gl1% te agarra.%SPEECH_ON%Son pectorales. Y son hermosos. Oye. Di que son hermosos.%SPEECH_OFF%Una teta da un brinco, y luego la otra, una y otra vez. Con un suspiro, dices que son hermosos. %gl1% asiente y se limpia algo del ojo.%SPEECH_ON%Gracias, capitán.%SPEECH_OFF% | Encuentras a %gl1% levantando a %gl2% en press de banca, y %gl2% va leyendo un pergamino mientras sube y baja.%SPEECH_ON%Dicen que en %randomcitystate% la gente es hermosa.%SPEECH_OFF%%gl2% mira con cariño hacia abajo, a %gl1%, que sigue levantando. %gl1% te echa un vistazo y vuelve al ejercicio.%SPEECH_ON%Noventa y ocho. Noventa y nueve. ¡Cien! Bien, date la vuelta.%SPEECH_OFF%%gl2% se da la vuelta, y las manos de %gl1% se hunden como masilla en su pecho y su vientre.%SPEECH_ON%Bien, cien repeticiones más.%SPEECH_OFF% | %gl1% levanta cuatro dedos. %gl2% levanta seis. Con la cabeza ladeada, %gl1% se ríe.%SPEECH_ON%¿En una noche?%SPEECH_OFF%%gl2% asiente.%SPEECH_ON%Sí, señor. En una noche.%SPEECH_OFF%%gl1% se ríe y pregunta si todas eran mujeres. %gl2% vacila.%SPEECH_ON%Bueno, había un par de hombres. Pero vaya uno a saber qué parte era de quién. Aunque estuvimos cerca, porque en un momento él estaba ahí abajo y yo me había puesto así, por detrás...%SPEECH_OFF%Te acercas dando palmadas, no para aplaudir sino para pedirles que se concentren. Entiendes que los caminos pueden ser largos y aburridos, pero esto ya roza lo ridículo. | %gl1% flexiona un bíceps.%SPEECH_ON%Podría partirle el cuello a una mula con un solo brazo.%SPEECH_OFF%Negando con la cabeza, %gl2% pregunta entonces para qué flexionar los dos brazos. %gl1% ladea la cabeza a su vez.%SPEECH_ON%Pues es obvio: pienso matar dos mulas a la vez.%SPEECH_OFF%Interrumpes para decirles que no van a matar ningún animal hasta que cumplan las tareas principales de %companyname%, que solo a veces consisten en matar animales. | %gl1% se sienta junto a %gl2% y le da la espalda mientras dice:%SPEECH_ON%Pon la mano en mi columna. Justo entre los omóplatos.%SPEECH_OFF%%gl2% obedece sin preguntas ni curiosidad. A su vez, %gl1% tensa la espalda y atrapa la mano entre dos masas de músculo.%SPEECH_ON%¿Qué te parece esa potencia?%SPEECH_OFF%De nuevo, sin un atisbo de ironía ni de incredulidad, %gl2% le da la respuesta que espera.%SPEECH_ON%¡Es increíble! ¡Oigo crujir los huesos de mi mano!%SPEECH_OFF%Piensas en interrumpir, pero técnicamente nadie ha salido herido... todavía. Te marchas y dejas que sigan con sus, eh, inclinaciones. | %SPEECH_START%Así que tenía a mi amante sobre el carro de la fruta, así, y lo estábamos pasando de maravilla cuando entra su padre. Se queda ahí con la boca abierta y casi no le sale ni una palabra.%SPEECH_OFF%%gl1% asiente.%SPEECH_ON%Así que voy y le digo: mira esto. Y me echo para atrás, flexiono los dos brazos y despacio, muy despacito, mi amante se eleva del suelo.%SPEECH_OFF%%gl2% le da una palmada a %gl1% en el pecho reluciente.%SPEECH_ON%¡Mientes! ¡Eso es una sarta de mentiras!%SPEECH_OFF%%gl1% levanta una mano.%SPEECH_ON%Por la luz del Dorado, y de cualquier otro dios que se digne a mirar boquiabierto mi cuerpo, es la verdad. Mi amor tiene poder.%SPEECH_OFF%}"
    }
    // context: gladiators_vibes_event.o.create.Text
    {
        en = "[img]gfx/ui/events/event_155.png[/img]{%gl1% bursts into your tent.%SPEECH_ON%Captain! Quick, %gl2% needs help!%SPEECH_OFF%You rush out of the tent and find %gl2% sitting before the campfire practically shaking. %gl1% tells you %gl2% had a nightmare.%SPEECH_ON%Dreamed of being so scrawny, could hardly lift a basket of apples. Folk spat at the sight. Children ran in fear. Went to the arenas, and had to sit in the stands!%SPEECH_OFF%%gl2% looks up sorrowfully.%SPEECH_ON%They weren't even good seats, captain. They weren't even good seats.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_155.png[/img]{%gl1% irrumpe en tu tienda.%SPEECH_ON%¡Capitán! ¡Rápido, %gl2% necesita ayuda!%SPEECH_OFF%Sales a toda prisa de la tienda y encuentras a %gl2% ante la fogata, temblando casi sin control. %gl1% te cuenta que %gl2% ha tenido una pesadilla.%SPEECH_ON%Soñó que se quedaba en los huesos, que apenas podía levantar una cesta de manzanas. La gente escupía a su paso. Los niños huían de miedo. ¡Fue a las arenas y tuvo que sentarse en las gradas!%SPEECH_OFF%%gl2% levanta la vista con pesar.%SPEECH_ON%Y ni siquiera eran buenos asientos, capitán. Ni siquiera eran buenos asientos.%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\dlc6\location\sunken_library_enter_event.nut
    // context: sunken_library_enter_event.o.create.s.Text
    {
        // corrige base: "una losa de piedra que está agrietada" → "una losa de piedra con una abertura" (gapped: tiene un hueco por el que se entra, no está agrietada)
        // corrige base: "tirando carros con pergaminos" → "tirando de carros cargados de pergaminos" (tirar carros es arrojarlos)
        // corrige base: sobraba un espacio entre %SPEECH_OFF% y %randombrother%
        // corrige base: "alguien aproximado a tu época" → "alguien de una época cercana a la tuya" (approximal to your era; la 1.0 no se entendía)
        en = "[img]gfx/ui/events/event_173.png[/img]{The shine and shimmer is so bright you almost think the Gilder Himself has ordained you a proper visit - unfortunately or fortunately, what you've stumbled across is actually a great gilded dome protruding ever so slightly from the sands. Immediately, you test if you can pull some of the gold away, but it has no give. %randombrother% calls you over to a slab of stone which is gapped. Perhaps a belltower at one point? Light fades quick and you can see very little inside. Above the entryway a relief depicts men pulling carts of scrolls.\n\n There's a set of words repeatedly scrawled across the relief. None of the languages look remotely familiar to anything you've ever heard or seen. It takes a bit of time until you can find a hurriedly etched translation left by someone approximal to your era: 'the Library, the Labyrinth of the Night, the Labyrinth of the Mind, Leave here as you would Leave a Dream, Tread here as you would Tread a Dream, Leave to Dwell upon the Horror of not Knowing, Enter to be One with Knowing, and in Knowing the Dream, Know the Nightmare'.%SPEECH_ON%Fair bit ominous, captain, but if you wanna go down in there we got the rope and torches to see to it.%SPEECH_OFF%%randombrother% tells you this, and the look on %their_randombrother% face suggests %they're_randombrother% hoping you decline the proposition.}"
        es = "[img]gfx/ui/events/event_173.png[/img]{El brillo y resplandor son tan intensos que casi podrías pensar que el propio Dorado te ha concedido una visita adecuada; desafortunadamente o afortunadamente, lo que has descubierto es en realidad una gran cúpula dorada que sobresale ligeramente de entre las arenas. Inmediatamente, intentas ver si puedes quitar un poco del oro, pero no cede. %randombrother% te llama hacia una losa de piedra con una abertura. ¿Quizás en algún momento fue una torre campanario? La luz desaparece rápidamente y apenas puedes ver adentro. Encima de la entrada hay un relieve que representa a hombres tirando de carros cargados de pergaminos.\n\nHay un conjunto de palabras escritas repetidamente a lo largo del relieve. Ninguno de los idiomas se parece remotamente a algo que hayas escuchado o visto alguna vez. Toma un poco de tiempo hasta que encuentras una traducción apresuradamente grabada dejada por alguien de una época cercana a la tuya: 'la Biblioteca, el Laberinto de la Noche, el Laberinto de la Mente, Deja este lugar como Dejarías un Sueño, Camina aquí como Caminarías un Sueño, Sal para Reflexionar sobre el Horror de no Saber, Entra para Ser Uno con el Saber, y en Saber el Sueño, Conoce la Pesadilla'.%SPEECH_ON%Un tanto ominoso, capitán, pero si quieres adentrarte allí, tenemos la cuerda y antorchas para hacerlo.%SPEECH_OFF%%randombrother% te dice esto, y su expresión sugiere que espera que rechaces la proposición.}"
    }
    // context: sunken_library_enter_event.o.create.s.Text
    {
        // corrige base: "Escaleras de mano están dispuestas" → "Escaleras corredizas descansan" (rolling ladders: la 1.0 perdía que son de ruedas)
        // corrige base: "Han violado un lugar" → "Sin duda has profanado un lugar" (el sujeto es el capitán, "you", y la 1.0 omitía "absolutely")
        en = "[img]gfx/ui/events/event_89.png[/img]{The climb down is a perilous one, the dark so thick you can't even see your own boots. But eventually you hit a marbled floor and quickly light up some torches. You find yourself in a massive hall around which spiral rows and rows of bookcases. Every shelf is adorned with piles of scrolls, many dwelling within glass enclosures. The shelves are stacked upon each other and seem to ascend to the very ceiling from which you descended. Rolling ladders rest at each level, but even further up runs a floating mezzanine with metal chutes stationed here and there. It seems as though once upon a time one was meant to pass these scrolls up and down, though now everything is rusted, and the mezzanine has collapsed in parts.\n\n %randombrother% calls your attention. %They_randombrother% points to an enormous scroll flattened behind a sheet of glass. Drawings sprawl over the paper, and upon closer inspection it appears they are blueprints for seemingly everything: the human body, the bodies of many animals, castles, towers, windmills, ships, weapons and armor, boots and gloves, alignments of the stars, and a great number of drawings of things which you have never seen before, things which don't make sense.%SPEECH_ON%Captain, this place is not meant for us. The languages, the halls, we should go.%SPEECH_OFF%One of the sellswords expresses the mood in the air. You have absolutely trespassed to a place few have gone before. And if they have gone before, where are they? A place like this surely can't stay hidden, right?}"
        es = "[img]gfx/ui/events/event_89.png[/img]{La bajada es peligrosa, la oscuridad es tan densa que ni siquiera puedes ver tus propias botas. Pero finalmente alcanzas un suelo de mármol y rápidamente enciendes algunas antorchas. Te encuentras en una enorme sala alrededor de la cual se arremolinan filas y más filas de estanterías. Cada estante está adornado con montones de pergaminos, muchos de ellos dentro de vitrinas de vidrio. Los estantes están apilados unos sobre otros y parecen ascender hasta el techo desde el que descendiste. Escaleras corredizas descansan en cada nivel, pero aún más arriba hay un entrepiso flotante con conductos de metal colocados aquí y allá. Parece que en algún momento se pretendía pasar estos pergaminos hacia arriba y hacia abajo, aunque ahora todo está oxidado y el entrepiso se ha derrumbado en partes.\n\n%randombrother% llama tu atención. Señala un enorme pergamino aplanado detrás de una lámina de vidrio. Dibujos se extienden sobre el papel, y al observar más de cerca parece que son planos de aparentemente todo: el cuerpo humano, los cuerpos de muchos animales, castillos, torres, molinos de viento, barcos, armas y armaduras, botas y guantes, alineaciones de las estrellas y una gran cantidad de dibujos de cosas que nunca has visto antes, cosas que no tienen sentido.%SPEECH_ON%Capitán, este lugar no es para nosotros. Los idiomas, los pasillos, deberíamos irnos.%SPEECH_OFF%Uno de los mercenarios expresa el ambiente en el aire. Sin duda has profanado un lugar al que pocos han llegado antes. Y si alguien ha estado aquí antes, ¿dónde están? Un lugar como este seguramente no puede permanecer oculto, ¿verdad?}"
    }
    // context: sunken_library_enter_event.o.create.s.Text
    {
        // corrige base: "collapsa al suelo sobre un montón de cenizas" → "se desploma en el suelo convertido en un montón de cenizas" ("collapsa" no existe y el Cronista se convierte en ceniza, no cae sobre ella)
        // corrige base: "fuego blanco y apagado se enciende" → "fuego blanco y mortecino se enciende" (dull: la 1.0 se contradecía)
        // corrige base: "Flota solo, con los ojos blancos" → "Flota sola, con los ojos ardiendo en blanco" (concuerda con la calavera y recupera "burning")
        en = "[img]gfx/ui/events/event_89.png[/img]{The Lorekeeper collapses onto the ground a pile of ash and the phylacteries slowly fade back to dark. You walk over with torch in hand. Its black skull resides atop the book that once dwelled in its chest with the mysterious magestaff close by.%SPEECH_ON%Captain, I don't think we should be touching anything here.%SPEECH_OFF%You ignore one of your men and pick the book up and the weapon up. Its leather covering is stitched together, and as you look closer you can see the flesh of ears and noses encompassing the cover. Immediately, the bones of the slain undead scratch across the marbled floor. One zips between your legs and flies into the pile of ash. A dull white fire alights inside the socket of the skull. That's more than enough for you: with a quick command, you get the men to climb back up the rope, yourself the last to leave. As you near the light of the earth above, you take one moment to stare back down and - the black skull is already in your face! It floats alone, eyes burning white, capturing your sight in a cone of fire you cannot understand, and as you stare into it you can hear the voices of your men fade away. The skull floats alone, and you almost feel the urge to let the rope go. The skull speaks to your mind:%SPEECH_ON%It is but one of its gifts, Interloper, and you are not the first to have it. There is many who have taken it, and in the many there is but one end, the one who awaits us all!%SPEECH_OFF%The skull's fire snuffs out and it drops away into the dark where you hear a brief clatter. The voices of your men rush back in, louder than ever and you look up to see %randombrother%'s hand. Grabbing hold, they pull you out. As you exit, the entrance sinks into the sand, and all you have of the place is a strange, fleshen book filled with writings you cannot ever hope to decipher.}"
        es = "[img]gfx/ui/events/event_89.png[/img]{El Cronista se desploma en el suelo convertido en un montón de cenizas y las filacterias lentamente vuelven a oscurecerse. Te acercas con antorcha en mano. Su cráneo negro reside encima del libro que una vez habitó en su caja torácica, con el misterioso bastón de mago cerca.%SPEECH_ON%Capitán, no creo que debamos tocar nada aquí.%SPEECH_OFF%Ignoras a uno de tus hombres y recoges el libro y el arma. La cubierta de cuero del libro está cosida y, si miras más de cerca, puedes ver la carne de las orejas y las narices que rodean la cubierta. Inmediatamente, los huesos de los muertos vivientes asesinados raspan el suelo de mármol. Uno se desliza entre tus piernas y vuela hacia el montón de cenizas. Un fuego blanco y mortecino se enciende dentro de la cavidad del cráneo. Eso es más que suficiente para ti: con una orden rápida, consigues que los hombres vuelvan a subir por la cuerda y tú eres el último en salir. A medida que te acercas a la luz de la tierra, te tomas un momento para mirar hacia abajo y ¡la calavera negra ya está en tu cara! Flota sola, con los ojos ardiendo en blanco, capturando tu vista en un cono de fuego que no puedes entender, y mientras lo miras puedes escuchar las voces de tus hombres desvanecerse. La calavera flota sola y casi sientes la necesidad de soltar la cuerda. La calavera te habla a la mente:%SPEECH_ON%Es solo uno de sus regalos, Intruso, y no eres el primero en tenerlo. Hay muchos que lo han tomado, y entre los muchos hay un solo final, ¡el que nos espera a todos!%SPEECH_OFF%El fuego de la calavera se apaga y cae en la oscuridad donde se escucha un breve ruido. Las voces de tus hombres regresan, más fuertes que nunca y levantas la vista para ver la mano de %randombrother%. Agarrándote, te sacan. Al salir, la entrada se hunde en la arena y todo lo que queda del lugar es un libro extraño y carnoso lleno de escritos que nunca podrás esperar descifrar.}"
    }
    // en = "After the battle..."
    // en base_es
    // context: sunken_library_enter_event.o.create.s.start.List.push().text
    {
        // text = bro.getName() + " finds " + item.getName()
        // El objeto es siempre legend_ancient_scroll_item, y su getName llega ya en
        // castellano; la regla libre "<name> finds <item>" casaba con cualquier frase.
        mode = "pattern"
        en = "<name:str> finds Pergamino antiguo"
        es = "<name> encuentra Pergamino antiguo"
    }
    // context: sunken_library_enter_event.o.create.s.start.List.push().text
    {
        mode = "pattern"
        en = "<name:str> finds Ancient Scroll"
        es = "<name> encuentra Pergamino antiguo"
    }
    // en = "Lorekeeper"
    // FILE: mod_legends\hooks\events\events\dlc6\retired_gladiator_event.nut
    // en = "You lose <v:str_tag> Crowns"
    // en base_es
    // FILE: mod_legends\hooks\events\events\dlc6\runaway_harem_event.nut
    // context: runaway_harem_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_harem_slave.png[/img]{You draw your sword and tell the Vizier's men to lose themselves before they lose their lives. The declaration shifts the balance of power in favour of the nomads, and the vizier's men retreat.  The nomads thank you, as do the freed harem. One woman steps forward.%SPEECH_ON%You have shown bravery stranger. We hate that man of the Vizier. He lies, and worse. If you have set your blade against him, then I wish to join you. I have a score to settle.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/legend_harem_slave.png[/img]{Desenvainas la espada y les dices a los hombres del visir que se pierdan de vista antes de que pierdan la vida. La declaración inclina la balanza de poder a favor de los nómadas, y los hombres del visir se retiran. Los nómadas te dan las gracias, al igual que el harén liberado. Una mujer da un paso al frente.%SPEECH_ON%Has demostrado valentía, forastero. Odiamos a ese hombre del visir. Miente, y cosas peores. Si has alzado tu espada contra él, quiero unirme a ti. Tengo cuentas que saldar.%SPEECH_OFF%}"
    }
    // en = "Welcome. I hope you know how to use a weapon."
    // en base_es
    // context: runaway_harem_event.o.create.m.Screens.push().Options.Text
    {
        en = "We don't have room for another"
        es = "No hay lugar para nadie más"
    }
    // context: runaway_harem_event.o.create.m.Screens.push().start._event.m.Dude.setTitle()
    {
        en = "of the dance"
        es = "de la danza"
    }
    // context: runaway_harem_event.o.create.m.Screens.push().start._event.m.Dude.getBackground().m.RawDescription
    {
        en = "You rescued %name% from a life in slavery after she was forced into the vizier's harem. She seeks revenge on the vizier."
        es = "Rescataste a %name% de una vida de esclavitud después de que la obligaran a entrar en el harén del visir. Busca vengarse del visir."
    }
    // en = "Got taken captive by manhunters"
    // en base_es
    // context: runaway_harem_event.o.create.m.Screens.push().start._event.m.Dude.improveMood()
    {
        en = "Got saved from a life in slavery"
        es = "Se libró de una vida de esclavitud"
    }
    // en = "You aided in the escape of a Vizier's harem"
    // en base_es
    // FILE: mod_legends\hooks\events\events\dlc6\sellsword_vs_bees_event.nut
    // context: sellsword_vs_bees_event.o.create.s.Text
    {
        en = "%terrainImage%{%chosen% confidently walks up toward the tree and the bees seem shunted away by %their_dude% very presence. The noise of their fluttering thickens with angry vibrations, but otherwise they take no further offense. %They_dude% carefully scoops some of the honey into a jar and then eases back and steps away. %They_dude% returns to the company.%SPEECH_ON%Easy peasy beehive squeezy, lads.%SPEECH_OFF%}"
        es = "%terrainImage%{%chosen% se acerca con confianza al árbol y las abejas parecen apartarse por su simple presencia. El ruido de su aleteo se intensifica con vibraciones enojadas, pero por lo demás, no se ofenden más. Con cuidado, recoge algo de miel en un frasco y luego retrocede y se aleja. Regresa con la compañía.%SPEECH_ON%Pan comido, chicos.%SPEECH_OFF%}"
    }
    // context: sellsword_vs_bees_event.o.create.s.Text
    {
        en = "%terrainImage%{%chosen% laces %their_dude% fingers and cracks the knuckles with a long stretch.%SPEECH_ON%Like stealing candy from a baby.%SPEECH_OFF%%They_dude% walks up to the tree and stands beneath the hive. %They_dude% poses and points up at it, laughs, then turns %their_dude% hands up and - much to the shock of everyone - just grabs the entire beehive. The bees instantly swarm the sellsword and %they_dude% drops the hive and sprints away, a cloud of angry buzzing chasing %them_dude% down a sand dune. %They_dude% rolls and rolls, %their_dude% screams issuing out whenever %they_dude% flies out of the sand, and then %they_dude% lands at the bottom and a wash of sand covers %them_dude% and spares %them_dude% from further bee stings. You wait a while before retrieving %them_dude%, lest the bees know your hand in this attempted thievery.}"
        es = "%terrainImage%{%chosen% entrelaza los dedos y se hace crujir los nudillos con un largo estiramiento.%SPEECH_ON%Como quitarle un dulce a un niño.%SPEECH_OFF%Se acerca al árbol y se planta bajo la colmena. Posa, la señala, se ríe y entonces vuelve las palmas hacia arriba y, para asombro de todos, agarra la colmena entera sin más. Al instante, las abejas envuelven %al_dude% mercenari%o_dude%, que suelta la colmena y sale corriendo, con una nube de zumbidos furiosos persiguiéndo%lo_dude% duna abajo. Rueda y rueda, y sus gritos escapan cada vez que sale volando de la arena; al final aterriza en el fondo y una ola de arena %lo_dude% cubre y %lo_dude% libra de más picaduras. Esperas un buen rato antes de ir a buscar%lo_dude%, no sea que las abejas descubran que tuviste algo que ver en este intento de robo.}"
    }
    // context: sellsword_vs_bees_event.o.create.s.Text
    {
        en = "%terrainImage%{You're sure %wildman% the Wildman has seen a hive or two in %their_wildman% time estranged to the forests. %They_wildman% grunts and points at the beehive and then at %themselves_wildman%. You nod. %They_wildman% grunts again and goes up the sand dune to the tree while you watch from a safe distance. When %they_wildman% stands beneath the hive, %they_wildman% hoots again, cupping %their_wildman% hand over %their_wildman% mouth to make sure you hear %them_wildman%. %They_wildman% points at the beehive. You nod again and point aggressively at the hive. It's the only beehive for miles, what could possibly be so confusing about this? \n\n The Wildman turns toward the beehive. %They_wildman% cocks an arm back. That... that is not what you wanted to see. %They_wildman% sizes up the beehive, tongue out, eyes slimmed. You rush forward, yelling at %them_wildman%, but %they_wildman%'s already honed in. %They_wildman% launches a fist and absolutely obliterates the bees. Honeycombs stickily flail around %their_wildman% wrist as though %their_wildman% hairy arm were an impromptu maypole. The Wildman casually walks back down the sand dune. As %they_wildman% nears, you see bees crawling all over %their_wildman% face and stinging away like the pissed off savages that they are, but %they_wildman% doesn't seem to even sense their presence. %They_wildman% holds out the crunchy remains of %their_wildman% honeyed demolition as though %they_wildman% held the heart of a ferocious beast.}"
        es = "%terrainImage%{Estás seguro de que %wildman%, %art_wildman% salvaje, ha visto una colmena o dos en sus años perdidos en los bosques. Gruñe y señala la colmena y luego a sí mism%o_wildman%. Asientes. Vuelve a gruñir y sube por la duna hasta el árbol mientras tú miras desde una distancia segura. Cuando está bajo la colmena, vuelve a dar un aullido, haciendo bocina con la mano sobre la boca para asegurarse de que %lo_wildman% oyes. Señala la colmena. Asientes de nuevo y señalas la colmena con energía. Es la única colmena en leguas a la redonda, ¿qué puede tener esto de confuso?\n\n%Art_wildman% salvaje se vuelve hacia la colmena. Echa un brazo hacia atrás. Eso... eso no es lo que querías ver. Mide la colmena con la mirada, con la lengua fuera y los ojos entornados. Corres hacia delante gritándole, pero ya tiene el blanco fijado. Lanza un puñetazo y aniquila por completo a las abejas. Los panales se agitan pegajosos alrededor de su muñeca como si su brazo peludo fuera un improvisado palo de mayo. %Art_wildman% salvaje baja tranquilamente por la duna. Cuando se acerca, ves abejas arrastrándose por toda su cara y picando sin parar como las salvajes rabiosas que son, pero ni siquiera parece notar su presencia. Te tiende los restos crujientes de su melosa demolición como si sostuviera el corazón de una bestia feroz.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc6\sword_eater_event.nut
    // context: sword_eater_event.o.create.s.Options[0].Text
    {
        en = "Impressive skill"
        es = "Habilidad impresionante"
    }
    // FILE: mod_legends\hooks\events\events\dlc6\trade_black_book_event.nut
    // en = "You lose <item:str>"
    // en base_es
    // en = "You gain a <a:str>"
    // en base_es
    // FILE: mod_legends\hooks\events\events\dlc8\anatomist_creeps_out_locals_event.nut
    // context: anatomist_creeps_out_locals_event.o.create.s.Text
    {
        // corrige base: "un parlanchín" → "%un_anatomist% sabelotodo" (wiseacre es un sabelotodo, no un charlatán)
        // corrige base: "monstruos desollados y sus extrañas entrañas" → "monstruos abiertos en canal, con sus curiosas entrañas desparramadas" (ripped open no es desollar y faltaba "churned out")
        // corrige base: "el hombre se aleja, pero no retrocede" → "el hombre se echa hacia atrás, pero no retrocede" (leans away; la 1.0 se contradecía)
        // corrige base: "Desafortunadamente, estoy feliz de que" → "Una lástima, aunque me alegra que" (Unfortunate, though...: la 1.0 invertía el sentido)
        // corrige base: "seguramente puede ver" → "sin duda puede ver" (absolutely); "pregunta si el campesino pensó [...], ¿alguna vez se lo habría preguntado?" → "le pregunta si, de creer que eso fuera remotamente cierto, se atrevería siquiera a preguntárselo" (la 1.0 mezclaba pregunta directa e indirecta); "Dice." → "Dice:"
        en = "[img]gfx/ui/events/event_43.png[/img]{Despite the noise of the surrounding villagers and their commerce, %anatomist% opens up a book of dissections and starts poring through its contents. While a local peasant might not be able to read the texts, he can absolutely see the disgusting images drawn on the pages: lurid documentation of opened bodies, identifications of body parts the peasant didn't even know he had, and a number of inane symbolism that any layman would use to invite his own devilments. Unsurprisingly, the peasant takes an interest in the anatomist's tome.%SPEECH_ON%So are you some sort of sorcerer or something?%SPEECH_OFF%Smiling, %anatomist% turns and says if the peasant thought that was remotely true, would he ever ask it of %them_anatomist%? The peasant leans back.%SPEECH_ON%Oh, so yer a wiseacre, huh? Some smartass with a book for fools.%SPEECH_OFF%%anatomist% watches the peasant turn and leave, then looks at you with a wide grin.%SPEECH_ON%That peasant had a curious bulge on his cheek. He'll be dead within a year. Two if he's unlucky and death is too generous with its time.%SPEECH_OFF% | Taking a break from the road and sellswording, %anatomist% sets down on a stone and opens up one of %their_anatomist% books. A few moments into %their_anatomist% studies, a little girl approaches, flowers in hand. She hands him one and asks what it is %they_anatomist%'s reading. The anatomist holds up %their_anatomist% book and turns it around. She stares at the grisly drawings of beasts and monsters ripped open and their curious insides churned out. After a pause, she slowly pushes the book down to stare at the anatomist holding it. She says.%SPEECH_ON%I know of a beast you could have.%SPEECH_OFF%You and the anatomist turn a keen ear. The little girl lowers her voice, nearly hissing with childlike conspiracy.%SPEECH_ON%My little brother. He's two, but I swear he forsakes the old gods and the devilry is in him.%SPEECH_OFF%%anatomist% nods dutifully.%SPEECH_ON%But of course. I will put it in my notes to see to this matter, and if I have time I will find the foulness within your kin.%SPEECH_OFF%The little girl thanks the anatomist once more and gives %them_anatomist% more flowers for %their_anatomist% promised aid. %anatomist% holds the flowers softly, rolling them back and forth as %they_anatomist% goes back to %their_anatomist% reading, a small smile on %their_anatomist% face. You're hoping that the smile is just an indicator that %they_anatomist%'s bemused by a child, and not that %they_anatomist% actually wishes to see to some ungodly boy. | As the company takes a rest, a man stands off at the side of the path, watching curiously. He nods.%SPEECH_ON%You lot have the stench of death about you, but I can't say I'd take ye for butcherers or executioners. Yer something else entire.%SPEECH_OFF%Without missing a beat, %anatomist% steps up and eyes the man, getting right up in his face, and the man leans away, but doesn't retreat. The anatomist's lost gaze ends with a dutiful nod.%SPEECH_ON%You are right, we do carry a stench, as do you. Ours is a matter of science, yours a matter of disease. And yours, hmm, yes, yours is a hint of the pox. Lemme see your feet.%SPEECH_OFF%The peasant nervously declines the request. He steps back as the anatomist hunts forward, fingers clambering like a spider, his eyes wide. The man eventually screams and runs off. %anatomist% turns around with a smile.%SPEECH_ON%What a curious subject, that man. I believe he was very, very ill, but he does not yet know it. Oh well.%SPEECH_OFF% | You come across an open-air wagon carrying a casket, its pathing trailed by a retinue of mourners. %anatomist% steps out from the company and inquires about the death of the individual. They said it was from a beast's strike. Curious, the anatomist inquires what sort of beast would be capable killing a man. The people look at one another before opening the coffin to reveal a man with a small scratch across his cheek. The wound had long since turned dark purple with veins of green and other disturbing discoloration, evidence that his demise was one of being stricken. One of the peasants looks up.%SPEECH_ON%It was his housecat that did it. Nicked him right there, and he paid little mind to it, then the colors went out and wandered his flesh until he was dead within two nights.%SPEECH_OFF%The anatomist shares some words with the mourners then returns to you. %They_anatomist% sighs.%SPEECH_ON%T'was a simple blighting. All he needed to do was clean the cut. Unfortunate, though I am happy that my learnings are giving me real world insights, even if it is too late to apply them.%SPEECH_OFF%You ask what came of the cat. The anatomist nods and says it was in the coffin with its victim, the feline 'beast' tucked there seemingly unawares of its final destination.}"
        es = "[img]gfx/ui/events/event_43.png[/img]{A pesar del ruido de los aldeanos y su comercio circundante, %anatomist% abre un libro de disecciones y comienza a hojear su contenido. Mientras que un campesino local puede que no sea capaz de leer los textos, sin duda puede ver las imágenes repugnantes dibujadas en las páginas: documentación vívida de cuerpos abiertos, identificación de partes del cuerpo que el campesino ni siquiera sabía que tenía, y una serie de símbolos inanes que cualquier laico usaría para invocar sus propios demonios. Como era de esperar, el campesino se interesa en el tomo %del_anatomist% anatomista.%SPEECH_ON%Entonces, ¿eres algún tipo de hechicer%o_anatomist% o algo así?%SPEECH_OFF%Sonriendo, %anatomist% se vuelve y le pregunta si, de creer que eso fuera remotamente cierto, se atrevería siquiera a preguntárselo. El campesino se echa para atrás.%SPEECH_ON%Oh, ¿así que eres %un_anatomist% sabelotodo, eh? %Un_anatomist% sabiond%o_anatomist% con un libro para tontos.%SPEECH_OFF%%anatomist% observa al campesino alejarse y luego te mira con una amplia sonrisa.%SPEECH_ON%Ese campesino tenía un bulto curioso en la mejilla. Estará muerto en un año. Dos si tiene mala suerte y la muerte es demasiado generosa con su tiempo.%SPEECH_OFF% | Tomando un descanso de la carretera y del oficio de mercenario, %anatomist% se sienta en una piedra y abre uno de sus libros. Unos momentos después, se acerca una niña pequeña con flores en la mano. Le entrega una y le pregunta qué está leyendo. %Art_anatomist% anatomista levanta su libro y lo gira. Ella mira los dibujos macabros de bestias y monstruos abiertos en canal, con sus curiosas entrañas desparramadas. Después de una pausa, empuja lentamente el libro hacia abajo para mirar %al_anatomist% anatomista que lo sostiene. Dice:%SPEECH_ON%Sé de una bestia que podrías tener.%SPEECH_OFF%Junto %al_anatomist% anatomista, prestas mucha atención. La niña baja la voz, casi susurrando con complicidad infantil.%SPEECH_ON%Mi hermanito. Tiene dos años, pero te juro que reniega de los viejos dioses y la maldad está en él.%SPEECH_OFF%%anatomist% asiente con diligencia.%SPEECH_ON%Claro, lo anotaré para ocuparme de este asunto, y si tengo tiempo, buscaré la maldad dentro de tu familia.%SPEECH_OFF%La niña agradece %al_anatomist% anatomista una vez más y le da más flores por su prometida ayuda. %anatomist% sostiene las flores suavemente, haciéndolas rodar de un lado a otro mientras vuelve a sus lecturas, con una pequeña sonrisa en el rostro. Esperas que esa sonrisa sea simplemente un indicador de que le divierte la compañía de una niña y no que realmente desee ocuparse de un niño impío. | Mientras la compañía descansa, un hombre se para en un lado del camino, observando con curiosidad. Asiente.%SPEECH_ON%Tienen el hedor de la muerte sobre ustedes, pero no diría que son carniceros o verdugos. Son algo completamente distinto.%SPEECH_OFF%Sin perder un segundo, %anatomist% se acerca y mira al hombre, poniéndose justo delante de su rostro, y el hombre se echa hacia atrás, pero no retrocede. La mirada perdida %del_anatomist% anatomista termina con un asentimiento de deber cumplido.%SPEECH_ON%Tienes razón, llevamos un hedor, al igual que tú. El nuestro es un asunto de ciencia, el tuyo un asunto de enfermedad. Y el tuyo, hmm, sí, tiene un toque de viruela. Déjame ver tus pies.%SPEECH_OFF%El campesino declina nerviosamente la solicitud. Retrocede mientras %art_anatomist% anatomista avanza, sus dedos trepando como una araña, sus ojos bien abiertos. El hombre finalmente grita y se aleja corriendo. %anatomist% se da la vuelta con una sonrisa.%SPEECH_ON%Qué sujeto tan curioso, ese hombre. Creo que estaba muy, muy enfermo, pero él aún no lo sabe. Bueno, qué se le va a hacer.%SPEECH_OFF% | Te encuentras con un carro al aire libre que lleva un ataúd, seguido por un séquito de dolientes. %anatomist% se aparta de la compañía y pregunta acerca de la muerte del individuo. Dicen que fue a causa de un golpe de una bestia. Con curiosidad, %art_anatomist% anatomista pregunta qué tipo de bestia sería capaz de matar a un hombre. La gente se mira entre sí antes de abrir el ataúd para revelar a un hombre con un pequeño rasguño en la mejilla. La herida hacía mucho tiempo que se había vuelto morada oscura con venas verdes y otras decoloraciones perturbadoras, señal de que su muerte había sido por un golpe. Uno de los campesinos mira hacia arriba.%SPEECH_ON%Fue su gato doméstico quien lo hizo. Lo arañó justo ahí, y él apenas le prestó atención, luego los colores se dispersaron y se extendieron por su carne hasta que murió en dos noches.%SPEECH_OFF%%Art_anatomist% anatomista intercambia algunas palabras con los dolientes y luego vuelve a ti. Suspira.%SPEECH_ON%Tuvo una simple gangrena. Todo lo que necesitaba era limpiar la herida. Una lástima, aunque me alegra que mis estudios me estén brindando conocimientos del mundo real, aun cuando sea demasiado tarde para aplicarlos.%SPEECH_OFF%Le preguntas qué pasó con el gato. %Art_anatomist% anatomista asiente y dice que estaba en el ataúd con su víctima, el felino 'bestia', aparentemente ajeno a su destino final.}"
    }
    // context: anatomist_creeps_out_locals_event.o.create.s.Options[0].Text
    {
        en = "If only %they_anatomist% was this happy about mercenary work, too."
        es = "Ojalá disfrutara así también del trabajo de mercenario."
    }
    // FILE: mod_legends\hooks\events\events\dlc8\anatomist_dead_knight_event.nut
    // en = "Got to examine the corpse of a heroic knight"
    // en base_es
    // en = "Was denied the opportunity to examine a promising corpse"
    // en base_es
    // en = "Saw the decaying remains of an old friend"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Experience"
    // en base_es
    // FILE: mod_legends\hooks\events\events\dlc8\anatomist_dissects_beetles_event.nut
    // context: anatomist_dissects_beetles_event.o.create.s.Text
    {
        // corrige base: "Aún así" → "Aun así" (sin tilde: equivale a "incluso así")
        // corrige base: "Este de bajo el agua" → "Este de debajo del agua" (errata)
        // corrige base: sobraban espacios antes de los dos %SPEECH_ON%
        en = "[img]gfx/ui/events/event_184.png[/img]{You find %anatomist% crouching over a piece of log. %They_anatomist%'s got a trio of beetles laid out. One has a needle pinning it to the wood, its little legs pedaling haplessly in the air. Another is nothing but a bodied husk, its legs removed and set beside it. The last is in a small tin of water with a stone weighing it down. %anatomist% shakes %them_anatomist% head.%SPEECH_ON%The duress these creatures can undergo is quite impressive. Physical damage does not allude to destruction as it does with us. Take these three, for example: pierced, dismembered, and drowning. Yet they all live. The efficiency is something else, wouldn't you agree?%SPEECH_OFF%Sure. You ask %they_anatomist% where %they_anatomist% even got all those beetles. %They_anatomist% shrugs.%SPEECH_ON%They crawl all over us when we're sleeping. I just happen to stay up to catch them in the act. This underwater one, for example, I caught pecking at your ear opening.%SPEECH_OFF%You tell %them_anatomist% to continue %their_anatomist% research and to capture as many beetles as %they_anatomist% can.}"
        es = "[img]gfx/ui/events/event_184.png[/img]{Encuentras a %anatomist% agachad%o_anatomist% sobre un trozo de madera. Tiene un trío de escarabajos dispuestos. Uno de ellos está atravesado por una aguja, sus pequeñas patas pedalean sin rumbo en el aire. Otro es poco más que un caparazón, sus patas separadas y colocadas junto a él. El último está en una pequeña lata de agua con una piedra que lo mantiene sumergido. %anatomist% sacude la cabeza.%SPEECH_ON%La tensión que pueden soportar estas criaturas es bastante impresionante. El daño físico no conduce a la destrucción como lo hace en nosotros. Toma a estos tres, por ejemplo: atravesado, desmembrado y ahogándose. Aun así, todos están vivos. La eficiencia es algo sorprendente, ¿no estás de acuerdo?%SPEECH_OFF%Claaaro. Le preguntas de dónde sacó todos esos escarabajos. Se encoge de hombros.%SPEECH_ON%Se arrastran por encima de nosotros cuando dormimos. Solo me quedo despiert%o_anatomist% para atraparlos in fraganti. Este de debajo del agua, por ejemplo, lo atrapé picoteando en la abertura de tu oído.%SPEECH_OFF%Le dices que continúe con su investigación y que capture tantos escarabajos como pueda.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc8\anatomist_helps_blighted_guy_1_event.nut
    // context: anatomist_helps_blighted_guy_1_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_53.png[/img]{You come across a %person_dude% being buried alive, an inference you take from the fact that %they're_dude% bound like a dead %person_dude% yet still screaming about the whole affair. You ask what is going on and one of the diggers turns and holds a hand out.%SPEECH_ON%Keep yer distance. This %person_dude% is blighted and anyone %they_dude% touches becomes blighted. We don't want no disease, and neither should you.%SPEECH_OFF%The %person_dude% cries out for help as another clump of soil lands on %them_dude%. %They_dude% tries to climb back out of the grave but one of the diggers kicks %them_dude% back in, the kicker himself complaining he'll have to burn his favorite boot. %anatomist% comes over with a quieted voice. %They_anatomist% says the %person_dude% has a skin disease which might look like leprosy or a plague, but is in fact benign. You ask if %they're_anatomist% sure of it, and %they_anatomist% nods, albeit with a finger of reluctance held up.%SPEECH_ON%I may be wrong, of course. And if I am, then %their_dude% very real disease might spawn itself upon us all. But to bury a %person_dude% alive is not something I find, how do you say, scientifically compelling.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_53.png[/img]{Te topas con %un_dude% %hombre_dude% a quien están enterrando viv%o_dude%, deducción que sacas del hecho de que está atad%o_dude% como un cadáver y, aun así, sigue gritando por todo el asunto. Preguntas qué ocurre y uno de los sepultureros se gira y levanta una mano.%SPEECH_ON%Mantén la distancia. %Ese_dude% %hombre_dude% tiene la peste, y a quien toque se le pega. No queremos ninguna peste, y tú tampoco deberías.%SPEECH_OFF%%Art_dude% %hombre_dude% pide ayuda a gritos mientras otro terrón cae sobre %el_dude%. Intenta salir de la tumba, pero uno de los sepultureros %lo_dude% devuelve dentro de una patada, y el propio pateador se queja de que tendrá que quemar su bota favorita. %anatomist% se acerca y habla en voz baja. Dice que %art_dude% %hombre_dude% tiene una enfermedad de la piel que puede parecer lepra o una plaga, pero que en realidad es benigna. Le preguntas si está segur%o_anatomist%, y asiente, aunque levanta un dedo con cierta reticencia.%SPEECH_ON%Podría equivocarme, claro. Y si me equivoco, su muy real enfermedad podría propagarse entre todos nosotros. Pero enterrar viv%o_dude% a %un_dude% %hombre_dude% no es algo que me parezca, ¿cómo decirlo?, científicamente convincente.%SPEECH_OFF%}"
    }
    // context: anatomist_helps_blighted_guy_1_event.o.create.::Legends.Screens.hook()._screen.Options[0].Text
    {
        en = "In that case we're going to help %them_dude%."
        es = "En ese caso, %lo_dude% vamos a ayudar."
    }
    // context: anatomist_helps_blighted_guy_1_event.o.create.::Legends.Screens.hook()._screen.start._event.m.Dude.getBackground().m.RawDescription
    {
        // _event.m.Dude.getBackground().m.RawDescription = "" + _event.m.Anatomist.getNameOnly() + " the Anatomist rescued %name% from being buried alive for carrying some strange disease. Now %they% has the unique pleasure of both bearing the plague AND being a lab rat for some researchers. Stay over there, please.";
        mode = "pattern"
        en = "<anatomist:str> the Anatomist rescued %name% from being buried alive for carrying some strange disease. Now %they% has the unique pleasure of both bearing the plague AND being a lab rat for some researchers. Stay over there, please."
        es = "<anatomist>, anatomista de oficio, rescató a %name% cuando %lo% estaban enterrando viv%o% por portar una extraña enfermedad. Ahora tiene el singular placer de cargar con la peste Y de servir de rata de laboratorio a unos investigadores. Quédate ahí lejos, por favor."
    }
    // en = "Was almost buried alive for bearing a disease"
    // en base_es
    // context: anatomist_helps_blighted_guy_1_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_88.png[/img]{You draw out your sword and order the diggers to stop. They look at you with incredulous stares. One points at the %person_dude% in the grave.%SPEECH_ON%Did you not hear? This one is blighted. What we're doing here might not look right but-%SPEECH_OFF%With a point of your sword, the digger falls quiet. You tell the %person_dude% in the grave to hop on out, and as %they_dude% does the diggers drop their shovels and back off. They tell you %they're_dude% all yours. The supposedly diseased %person_dude% ambles over, still frightened and no doubt unsure if %their_dude% rescuers have anything better in mind for %them_dude% than those who would bury %them_dude% alive. %anatomist% takes %them_dude% under %their_anatomist% wing and you slowly fall back. The anatomist states that the %person_dude% is ill, but it's not serious and %they_dude% will recover in good time. For now, though, %they_dude% needs rest.}"
        es = "[img]gfx/ui/events/event_88.png[/img]{Desenvainas la espada y ordenas a los sepultureros que se detengan. Te miran con incredulidad. Uno señala %al_dude% %hombre_dude% de la tumba.%SPEECH_ON%¿No oíste? Tiene la peste. Puede que lo que hacemos no parezca correcto, pero...%SPEECH_OFF%Basta con que lo señales con la espada para que el sepulturero se calle. Le dices %al_dude% %hombre_dude% de la tumba que salga de un salto, y mientras lo hace, los sepultureros sueltan las palas y retroceden. Te dicen que es tod%o_dude% tuy%o_dude%. %Art_dude% %hombre_dude% supuestamente enferm%o_dude% se acerca arrastrando los pies, todavía asustad%o_dude% y seguramente sin saber si sus salvadores tienen en mente algo mejor para %el_dude% que quienes querían enterrar%lo_dude% viv%o_dude%. %anatomist% %lo_dude% toma bajo su ala y tú te retiras despacio. %Art_anatomist% anatomista afirma que %art_dude% %hombre_dude% está enferm%o_dude%, pero que no es grave y que se recuperará con el tiempo. Por ahora, eso sí, necesita descansar.}"
    }
    // context: anatomist_helps_blighted_guy_1_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_18.png[/img]{In the most reluctant rescue ever, you sigh and draw out your sword, ordering the diggers to stop immediately. They look over at you, their hands on their shovels, their eyebrows far up their brows.%SPEECH_ON%What? Did ye you not hear us? This one's blighted!%SPEECH_OFF%%anatomist% comes forward and waves them off. You nod and gesture for the diggers to do as told. The anatomist helps the %person_dude% out of the grave, though you notice %they're_anatomist% doing it with %their_anatomist% own sleeve and hand covered. %They_dude% is helped back to the company. As the %person_dude% turns to thank you, %anatomist% drives a hammer into the back of %their_dude% head, knocking %them_dude% out cold. The anatomist follows %them_dude% to the ground and begins to cut up the %person_dude%'s arm, removing a slab of flesh before backing away.%SPEECH_ON%This should be good enough for our studies, I believe.%SPEECH_OFF%You ask if the %person_dude% was indeed sick. The anatomist nods.%SPEECH_ON%Of course, but it's better if %they're_dude% at least useful while sick instead of just dead in the ground like some worm. %They_dude% may, of course, go die now. There is not much left for %them_dude% in this world.%SPEECH_OFF%The %person_dude% moans as %they_dude% writhes on the ground. There's a bit of a jangle in %their_dude% boots which you remove to find stowed away crowns. You briefly consider putting %them_dude% out of %their_dude% misery, but decide that now %they're_dude% free of the grave %they_dude% may %themselves_dude% decide how %they_dude% wishes to return to it. You do, however, take %their_dude% money.}"
        es = "[img]gfx/ui/events/event_18.png[/img]{En el rescate más desganado de la historia, suspiras, desenvainas la espada y ordenas a los sepultureros que paren de inmediato. Te miran con las manos en las palas y las cejas por las nubes.%SPEECH_ON%¿Qué? ¿Es que no nos oíste? ¡Tiene la peste!%SPEECH_OFF%%anatomist% se adelanta y los despide con un gesto. Asientes y les indicas a los sepultureros que hagan lo que se les dice. %Art_anatomist% anatomista ayuda %al_dude% %hombre_dude% a salir de la tumba, aunque notas que lo hace con la mano cubierta por su propia manga. Entre todos %lo_dude% llevan de vuelta a la compañía. Cuando %art_dude% %hombre_dude% se gira para darte las gracias, %anatomist% le estampa un martillo en la nuca y %lo_dude% deja inconsciente en el acto. %Art_anatomist% anatomista %lo_dude% sigue hasta el suelo y empieza a abrirle el brazo, le arranca un trozo de carne y se aparta.%SPEECH_ON%Creo que esto bastará para nuestros estudios.%SPEECH_OFF%Le preguntas si %art_dude% %hombre_dude% estaba realmente enferm%o_dude%. %Art_anatomist% anatomista asiente.%SPEECH_ON%Por supuesto, pero es mejor que al menos sea útil mientras está enferm%o_dude% en lugar de estar simplemente muert%o_dude% bajo tierra como un gusano. Ahora, por supuesto, puede irse a morir. No le queda gran cosa en este mundo.%SPEECH_OFF%%Art_dude% %hombre_dude% gime mientras se retuerce en el suelo. Algo tintinea en sus botas; se las quitas y encuentras coronas escondidas. Por un momento piensas en acabar con su sufrimiento, pero decides que, ahora que se ha librado de la tumba, puede decidir por sí mism%o_dude% cómo quiere volver a ella. Eso sí, te quedas con su dinero.}"
    }
    // context: anatomist_helps_blighted_guy_1_event.o.create.::Legends.Screens.hook()._screen.Options[0].Text
    {
        // corrige base: "Bueno suerte ahi" → "Buena suerte ahí" (dos erratas)
        en = "Good luck out there, %person_dude%."
        es = "Buena suerte ahí fuera, %hombre_dude%."
    }
    // context: anatomist_helps_blighted_guy_1_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "no necesita más hombres" → "no necesita más mercenarios" (sellswords)
        // corrige base: "Bien. Aprecio que me hayas salvado." → "Bueno. Te lo agradezco." (el inglés no dice "que me hayas salvado")
        en = "[img]gfx/ui/events/event_04.png[/img]{You tell the %person_dude that the %companyname% doesn't need anymore sellswords. You also imply that, before %they_dude% goes, %they_dude% should maybe consider compensating you for the help. %They_dude% nods and takes off %their_dude% boot, revealing %they_dude% had gold stashed in there. Not trusting what illness %they_dude% has, you tell %them_dude% to rub the coins on the grass and then kick it over with %their_dude% feet. %They_dude% does as told. %They_dude% nods.%SPEECH_ON%Well. I appreciate it. You take care out there.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_04.png[/img]{Le dices %al_dude% %hombre_dude% que %companyname% no necesita más mercenarios. También le insinúas que, antes de irse, tal vez debería considerar compensarte por la ayuda. Asiente y se quita la bota, revelando que tenía oro guardado en ella. Sin confiar en la enfermedad que tiene, le dices que frote las monedas en la hierba y luego las patee con los pies. Hace lo que le dices. Asiente.%SPEECH_ON%Bueno. Te lo agradezco. Cuídate ahí fuera.%SPEECH_OFF%}"
    }
    // en = "You gain <v:val_tag> Crowns"
    // en base_es
    // en = "Was denied the study of an unusual illness"
    // en base_es
    // context: anatomist_helps_blighted_guy_1_event.o.create.::Legends.Screens.hook()._screen.start._event.m.Anatomist.worsenMood()
    {
        en = "Was denied the chance to help a sick %person_dude%"
        es = "Le negaron la oportunidad de ayudar a alguien enfermo"
    }
    // FILE: mod_legends\hooks\events\events\dlc8\anatomist_helps_blighted_guy_2_event.nut
    // context: anatomist_helps_blighted_guy_2_event.o.create.s.Text
    {
        // corrige base: sobraban espacios junto a %SPEECH_ON% y %SPEECH_OFF%
        // corrige base: "me alegrará luchar" → "me alegra luchar" (I'm glad: la 1.0 cambiaba el tiempo)
        en = "[img]gfx/ui/events/event_58.png[/img]{The supposedly diseased %person_militiacaptain% the anatomists had rescued from the literal grave comes forward. %They_militiacaptain%'s looking better than ever. %They_militiacaptain% thanks the anatomists for their work, though they regard %them_militiacaptain% with barely any notice at all. It seems %they_militiacaptain% was of more interest to them when %they_militiacaptain% was ill, and they could poke and prod and learn from that which ailed %them_militiacaptain%, and there was some unspoken hope that %they_militiacaptain% would in fact die so they could learn even more. Seeing this, the %person_militiacaptain% then turns to you.%SPEECH_ON%It's all much appreciated, I hope at least you know that. You don't know what hells I've been through with that lot who tried to bury me alive. I think they knew I wasn't no blight, they just wanted my property. See, I used to head the local militia, but that position comes with the weight of conspiracy and jealousy.%SPEECH_OFF%%They_militiacaptain% rubs the back of %their_militiacaptain% head, then comes out with it.%SPEECH_ON%I've nothing else after those gravediggers done taken it all so regardless of whether I'm alive or dead, I may well be of the latter. So, well, let me just say I'm glad to be fighting for you and making myself a new living out here.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_58.png[/img]{%Art_militiacaptain% %hombre_militiacaptain% supuestamente enferm%o_militiacaptain% a quien los anatomistas habían rescatado de la tumba, literalmente, se acerca. Se ve mejor que nunca. Agradece a los anatomistas por su trabajo, aunque apenas le prestan atención. Parece que les interesaba más cuando estaba enferm%o_militiacaptain%, y podían investigar y aprender de lo que %lo_militiacaptain% afligía, y había una esperanza no expresada de que realmente muriera para que pudieran aprender aún más. Viendo esto, %art_militiacaptain% %hombre_militiacaptain% luego se gira hacia ti.%SPEECH_ON%Es todo muy apreciado, espero que al menos lo sepas. No sabes por lo que he pasado con ese grupo que intentó enterrarme viv%o_militiacaptain%. Creo que sabían que no tenía ninguna enfermedad, solo querían mi propiedad. Verás, solía estar al mando de la milicia local, pero ese cargo viene con el peso de las conspiraciones y los celos.%SPEECH_OFF%Se frota la parte trasera de la cabeza, luego prosigue.%SPEECH_ON%No tengo nada más después de que esos sepultureros se llevaron todo, así que, esté viv%o_militiacaptain% o muert%o_militiacaptain%, bien podría ser lo último. Así que permíteme decir que me alegra luchar por ti y ganarme una nueva vida aquí.%SPEECH_OFF%}"
    }
    // context: anatomist_helps_blighted_guy_2_event.o.create.s.start._event.m.MilitiaCaptain.getBackground().m.RawDescription
    {
        // corrige base: "capitán de la guardia de la ciudad" → "capitanear la guardia" (el inglés no dice "de la ciudad")
        en = "You found %name% being buried alive for carrying some unknown blight. The anatomists took interest in %them% and rescued %them%, nursing %them% back to health. Now, %they% fights for you, putting to use the skills that made %them% captain of the guard in a previous life."
        es = "Encontraste a %name% cuando %lo% estaban enterrando viv%o% por llevar una enfermedad desconocida. Los anatomistas se interesaron por %el% y %lo% rescataron, y %lo% cuidaron hasta que se recuperó. Ahora lucha por ti, poniendo en práctica las habilidades que %lo% llevaron a capitanear la guardia en una vida anterior."
    }
    // en = "Recovered from the blight afflicting him"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Melee Defense"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Ranged Defense"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Melee Skill"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Ranged Skill"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Max Fatigue"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Initiative"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Resolve"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Hitpoints"
    // en base_es
    // FILE: mod_legends\hooks\events\events\dlc8\anatomist_reflects_on_webknechts_event.nut
    // context: anatomist_reflects_on_webknechts_event.o.create.s.Text
    {
        // corrige base: "sostiene su brazo" → "extiende el brazo" (holding out: lo tiene extendido, no se lo sujeta)
        // corrige base: "los antiguos dioses" → "los viejos dioses" (término fijado en el resto del corpus)
        // corrige base: "antes de que le chupen la sangre con colmillos" → "antes de que unos colmillos te chupen la sangre" ("your blood": la 1.0 cambiaba de persona)
        // corrige base: sobraba un espacio antes de %SPEECH_ON%
        // corrige base: "bellaco" → "bribón" (scapegrace: el resto de eventos del anatomista dice "bribón")
        en = "[img]gfx/ui/events/event_184.png[/img]{%anatomist% is holding out %their_anatomist% arm, watching a long-legged spider trundling across %their_anatomist% flesh. As the creature reaches the ends of its newfound earth, the anatomist turns %their_anatomist% arm, suggesting the spider continue on another way. %They_anatomist% does this for a time until putting %their_anatomist% fingers toward the ground and the spider shuffles off entirely, perhaps not ever once aware it was on a living being. The anatomist writes a few pages down in %their_anatomist% notes.%SPEECH_ON%The other day I watched a spider jump twenty-times its body length to snatch a fly. And this spider I've let go would, upon seeing its prey, speed across the ground like a hunting dog. It seems that the old gods have taken pity on us, scapegrace, for neither of these creatures can be found in their larger, webknecht forms.%SPEECH_OFF%While being tackled and ripped apart would be quite terrible, you tell him that being wrapped in a cocoon before having your blood sucked out by fangs is undoubtedly worse. The anatomist raises a finger.%SPEECH_ON%A common misconception, scapegrace, for the webknecht actually prefers to feed long after you are deceased. We believe its toxins are designed to target the belly, opening it up and using its fluids to melt you from the inside out. This is presumably why they hang their prey upside down, so the toxins can slosh over the organs, turning you into a sort of sack of fluids. The consuming phase of the process is merely one of digesting whatever is left. The only time they don't eat you is if they're placing their brood inside you as the spiderlings will need sustenance upon hatching.%SPEECH_OFF%That still sounds infinitely worse than being shanked by a hunting spider, but either way you regret having the conversation and pursue it no further. Unfortunately, %otherbro% is nearby and has heard all too much...}"
        es = "[img]gfx/ui/events/event_184.png[/img]{%anatomist% extiende el brazo, observando una araña de patas largas avanzar por su piel. A medida que la criatura alcanza los extremos de su nuevo mundo, %art_anatomist% anatomista gira el brazo, sugiriendo que la araña continúe en otra dirección. Lo hace durante un tiempo hasta que dirige sus dedos hacia el suelo y la araña se aleja por completo, quizás sin darse cuenta de que estaba sobre un ser vivo. %Art_anatomist% anatomista anota algunas páginas en sus notas.%SPEECH_ON%El otro día vi a una araña saltar veinte veces la longitud de su cuerpo para atrapar una mosca. Y esta araña que he dejado ir, al ver a su presa, se movería por el suelo como un perro cazador. Parece que los viejos dioses se han compadecido de nosotros, bribón, ya que ninguno de estos seres se encuentra en sus formas más grandes, como webknecht.%SPEECH_OFF%A pesar de que ser atacado y desmembrado sería bastante terrible, le dices que ser envuelto en un capullo antes de que unos colmillos te chupen la sangre es indudablemente peor. %Art_anatomist% anatomista levanta un dedo.%SPEECH_ON%Un error común, bribón, ya que el webknecht en realidad prefiere alimentarse mucho después de que hayas fallecido. Creemos que sus toxinas están diseñadas para atacar el vientre, abriéndolo y utilizando sus fluidos para disolverte desde adentro. Presumiblemente, por eso cuelgan a su presa boca abajo, para que las toxinas puedan bañar los órganos, convirtiéndote en una especie de bolsa de fluidos. La fase de consumo del proceso es simplemente la digestión de lo que queda. La única vez que no te comen es si están colocando su prole dentro de ti, ya que las crías de araña necesitarán alimento al eclosionar.%SPEECH_OFF%Aún suena infinitamente peor que ser atacado por una araña cazadora, pero de todos modos lamentas haber tenido la conversación y no la profundizas más. Desafortunadamente, %otherbro% está cerca y ha escuchado demasiado...}"
    }
    // FILE: mod_legends\hooks\events\events\dlc8\anatomist_vs_ailing_event.nut
    // en = "<ailing:str> is no longer Ailing"
    // en base_es
    // en = "<ailing:str> gains <trait:str>"
    // en base_es
    // FILE: mod_legends\hooks\events\events\dlc8\anatomist_wants_skull_event.nut
    // context: anatomist_wants_skull_event.o.create.s.Text
    {
        // corrige base: "un gran cráneo, cuidadosamente colocado" → "un gran cráneo blanqueado, colocado como adorno" (faltaba "bleached" y "decoratively" no es "cuidadosamente")
        // corrige base: "como si [...] cerrar una boca así sería un peligro" → "fuera un peligro" (tras "como si" va subjuntivo)
        // corrige base: "estará en mejores manos en las nuestras que en las de ellos" → "será de más utilidad en nuestras manos que en las suyas" (of better use; la 1.0 era redundante)
        en = "[img]gfx/ui/events/event_16.png[/img]{You come to a remote village to find a few of its peoples crouched before a large, bleached skull decoratively set on a lectern. Passing peasants pause and profess faith to it. As you get closer, you realize the skull itself is extraordinary: a long, thick forehead juts out from the top, its brow quite dominant and ridged, and the jaw of it, still intact, carries enormous and sharp teeth, most of which are in a state of disorder, as if in any ordinary head closing such a mouth would be a danger to itself. What it very well may be is a Nachzehrer's skull. Naturally, with this strange skeletal sight before you, you hope to turn the company away before-%SPEECH_ON%We should take that for studying.%SPEECH_OFF%Sighing, you turn to see %anatomist% standing there, ogling the skull. You correct %them_anatomist%, saying instead that what %they_anatomist% really means is %they_anatomist% intends to steal it. The anatomist stares at you.%SPEECH_ON%The vocabulary needn't matter, when the studying is done, it will be of better use in our hands than theirs, that much is clear.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_16.png[/img]{Llegas a un pueblo remoto y encuentras a algunas de sus gentes arrodilladas ante un gran cráneo blanqueado, colocado como adorno en un atril. Los campesinos que pasan se detienen y profesan su fe ante él. A medida que te acercas, te das cuenta de que el cráneo en sí es extraordinario: una frente larga y gruesa sobresale en la parte superior, su ceja es dominante y con crestas, y la mandíbula, aún intacta, lleva enormes y afilados dientes, la mayoría de los cuales están en un estado desordenado, como si en cualquier cabeza común cerrar una boca así fuera un peligro para sí misma. Lo que bien podría ser es el cráneo de un Nachzehrer. Naturalmente, con esta extraña vista esquelética ante ti, esperas dar media vuelta con la compañía antes de que...%SPEECH_ON%Deberíamos llevarlo para estudiarlo.%SPEECH_OFF%Suspirando, te das la vuelta y ves a %anatomist% ahí de pie, mirando fijamente el cráneo. %Lo_anatomist% corriges, diciendo en su lugar que lo que realmente quiere es robarlo. %Art_anatomist% anatomista te mira.%SPEECH_ON%El vocabulario no importa; cuando se haga el estudio, será de más utilidad en nuestras manos que en las suyas, eso está claro.%SPEECH_OFF%}"
    }
    // context: anatomist_wants_skull_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_46.png[/img]{Sighing, you agree to the anatomist's fancies, but you tell %them_anatomist% that it will be %they_anatomist% who does the stealing, if it is %they_anatomist% who wishes to do the studying. The man doesn't even hesitate and heads off, eyes narrowed to the bony item central to %their_anatomist% scientific fancy. You're not going to be responsible for the mayhem that goes down if %they_anatomist% is caught so you leave %them_anatomist% to it, returning instead to count inventory while keeping your ears perked for sounds of religion wrecking chaos. A few moments later, %anatomist% returns, a fat skull cradled under an arm and a bit of sweat on %their_anatomist% brow.%SPEECH_ON%It's a Nachzehrer's skull and should be of great value to our studies.%SPEECH_OFF%Curious, you ask %them_anatomist% how it was that %they_anatomist% managed to get the skull in the first place. %anatomist% raises an eyebrow.%SPEECH_ON%You weren't watching? I thought the endeavor was quite impressive, but alas so impressive that I believe telling it second hand will make you susceptible to believing me to tell a tall tale. A fable, if you will. Just know that we should probably get out of here soon. Perhaps sooner than soon, and quicker than quick. Do you understand?%SPEECH_OFF%A din of shouting grows in the distance. The anatomist wipes %their_anatomist% brow and turns and walks away. The back of %their_anatomist% shirt is clawed apart and there are little darts or arrows sticking out of %their_anatomist% back - and those distant shouts are getting louder.}"
        es = "[img]gfx/ui/events/event_46.png[/img]{Con un suspiro, accedes a los caprichos %del_anatomist% anatomista, pero le dejas claro que, si es %el_anatomist% quien quiere estudiarlo, será %el_anatomist% quien lo robe. %anatomist% ni siquiera vacila y se pone en marcha, con los ojos entornados fijos en el objeto óseo que centra su capricho científico. No vas a hacerte responsable del caos que se desate si %lo_anatomist% atrapan, así que %lo_anatomist% dejas a lo suyo y vuelves a contar el inventario, con el oído atento a cualquier sonido de la religión sembrando el caos. Unos momentos después, %anatomist% vuelve con un cráneo enorme bajo el brazo y algo de sudor en la frente.%SPEECH_ON%Es el cráneo de un Nachzehrer y debería ser de gran valor para nuestros estudios.%SPEECH_OFF%Con curiosidad, le preguntas cómo consiguió el cráneo. %anatomist% arquea una ceja.%SPEECH_ON%¿No estabas mirando? Me pareció una hazaña bastante impresionante, pero, por desgracia, tan impresionante que creo que, si te la cuento de segunda mano, pensarás que te cuento una patraña. Una fábula, si quieres. Solo debes saber que probablemente deberíamos irnos de aquí pronto. Quizá más pronto que pronto, y más rápido que rápido. ¿Entiendes?%SPEECH_OFF%A lo lejos crece un estruendo de gritos. %Art_anatomist% anatomista se seca la frente, se da la vuelta y se aleja. La espalda de su camisa está desgarrada a zarpazos y tiene pequeños dardos o flechas clavados en la espalda... y esos gritos lejanos suenan cada vez más fuerte.}"
    }
    // context: anatomist_wants_skull_event.o.create.s.Text
    {
        // corrige base: "un rastrillo" → "una horca" (pitchfork; un rastrillo es un rake)
        // corrige base: "Tomas distancia" → "Extiendes las manos" (You hold your hands out)
        en = "[img]gfx/ui/events/event_04.png[/img]{You tell %anatomist% %they_anatomist% can take the skull. %They_anatomist% stares at you for a time, then says %they_anatomist% thought you were the one that was going to do it. You tell %them_anatomist% there's no way you're taking a skull from local peasants who worship said skull. If %they_anatomist% wishes to do the studying, then it is %they_anatomist% who should do the stealing. %anatomist% draws a hand to %their_anatomist% chest.%SPEECH_ON%I'm a %their_anatomist% of science, and no ordinary scribe, I could not deign myself to a task of such lowness. It requires someone of knowhow, one who understands the grit and grime of daily life, to steal this skull.%SPEECH_OFF%The anatomist clenches a fist, so certain that %their_anatomist% speech is not an insult to you, and %their_anatomist% eyes staring off with determined ferocity that could only be vicarious at best.%SPEECH_ON%What the fark you two strangers talkin' about?%SPEECH_OFF%You both turn around to see a peasant holding a pitchfork, and as a few more join %them_anatomist% %they_anatomist% motions toward you.%SPEECH_ON%These fellas were aimin' to steal the skull!%SPEECH_OFF%You hold your hands out, explaining that- before you finish, %anatomist% turns and sprints away. Thinking fast, you call %them_anatomist% a thief and promise to have %their_anatomist% head, making a grand show of drawing out your sword and waving it at the peasants. You pretend to accidentally drop a purse of crowns, turning the peasants' anger into greed, and giving you enough time to escape.}"
        es = "[img]gfx/ui/events/event_04.png[/img]{Le dices a %anatomist% que puede llevarse el cráneo. Te mira durante un rato y luego dice que pensaba que eras tú quien iba a hacerlo. Le dices que no tienes intención de llevarte un cráneo de los aldeanos locales que adoran dicho cráneo. Si es %el_anatomist% quien desea hacer el estudio, entonces es %el_anatomist% quien debe hacer el robo. %anatomist% se lleva una mano al pecho.%SPEECH_ON%Soy %un_anatomist% %hombre_anatomist% de ciencia, y no %un_anatomist% simple escriba; no podría rebajarme a una tarea de tan poca importancia. Hace falta alguien entendido, alguien que comprenda la dureza y la suciedad de la vida cotidiana, para robar este cráneo.%SPEECH_OFF%%Art_anatomist% anatomista aprieta el puño, tan segur%o_anatomist% de que su discurso no es un insulto hacia ti, y sus ojos miran con una ferocidad resuelta que a lo sumo podría ser vicaria.%SPEECH_ON%¿De qué diablos están hablando ustedes dos, forasteros?%SPEECH_OFF%Ambos se dan la vuelta para ver a un campesino sosteniendo una horca, y cuando se le unen algunos más, hace un gesto hacia ti.%SPEECH_ON%¡Estos tipos querían robar el cráneo!%SPEECH_OFF%Extiendes las manos, explicando que... antes de que termines, %anatomist% se da la vuelta y se aleja corriendo. Pensando rápido, %lo_anatomist% acusas de robo y prometes tener su cabeza, haciendo un gran espectáculo de sacar tu espada y agitarla ante los campesinos. Finges que dejas caer accidentalmente un saco de coronas, convirtiendo la ira de los campesinos en codicia, y dándote tiempo suficiente para escapar.}"
    }
    // context: anatomist_wants_skull_event.o.create.s.Text
    {
        // corrige base: "El ladrón y el aspirante a ladrón de cráneos se alejan" → "%thief%, aspirante a robacráneos, se aleja" (es una sola persona: el ladrón, que aspira a robar el cráneo)
        // corrige base: "antes de volver" → "antes de volverse" (turning back: se gira hacia ellos, no regresa)
        // corrige base: "dos prostitutas" → "dos putas" (whores; la 1.0 rebajaba la crudeza)
        en = "[img]gfx/ui/events/event_65.png[/img]{Sighing, you agree to the idea of stealing the skull. Before you can say anything more, %thief% the thief appears. %They_thief% comes up chewing grass and walking with swagger.%SPEECH_ON%So you wanna steal something, hm? Just point at whatcha need and I'll go and fetch it for you. Is it gold? A weapon?%SPEECH_OFF%%anatomist% points at the skull. The thief stares at it for a time before turning back.%SPEECH_ON%Oh, uh, alright.%SPEECH_OFF%The thief and would be skull stealer wanders off. You go and count inventory, giving %them_thief% time to do %their_thief% job. %They_thief% later returns with the skull in tow, as well as a bevy of weapons and armor which you know %they_thief% didn't buy. As you stare at the clearly lifted goods, the man shrugs.%SPEECH_ON%What? I had to make it worth my time.%SPEECH_OFF%The anatomist takes the skull away without saying a word, carrying it off while staring into its emptied eyesockets as though it were a lover, muttering that many things will be learned from its vacant stare. The thief does the same, but instead with a satchel of crowns and other goodies, %themselves_thief% muttering that %they_thief%'ll finally be able to afford two whores at the same time, an apparent long held dream of %their_thief%. You take the weapons and armor to inventory, and in the distance you hear the wailing of peasants looking for the relic.}"
        es = "[img]gfx/ui/events/event_65.png[/img]{Suspirando, aceptas la idea de robar el cráneo. Antes de que puedas decir algo más, aparece %thief%, que se gana la vida robando. Se acerca masticando hierba y caminando con desparpajo.%SPEECH_ON%Así que quieres robar algo, ¿eh? Solo señala lo que necesitas y yo iré a buscarlo para ti. ¿Es oro? ¿Un arma?%SPEECH_OFF%%anatomist% señala el cráneo. %thief% lo mira durante un rato antes de volverse.%SPEECH_ON%Oh, eh, está bien.%SPEECH_OFF%%thief%, aspirante a robacráneos, se aleja. Tú vas a contar el inventario, dándole tiempo para hacer su trabajo. Más tarde regresa con el cráneo bajo el brazo, así como una gran cantidad de armas y armaduras que sabes que no compró. Mientras miras los bienes claramente robados, se encoge de hombros.%SPEECH_ON%¿Qué? Tenía que hacer que valiera la pena.%SPEECH_OFF%%anatomist% se lleva el cráneo sin decir una palabra, cargándolo mientras mira sus cuencas vacías como si fuera un amante, murmurando que se aprenderán muchas cosas de su mirada vacía. %thief% hace lo mismo, pero en su caso con una bolsa de coronas y otros tesoros, murmurando que por fin podrá permitirse dos putas a la vez, un sueño que al parecer acariciaba desde hacía mucho tiempo. Tú llevas las armas y la armadura al inventario, y a lo lejos oyes los lamentos de los campesinos que buscan la reliquia.}"
    }
    // en = "Acquired an unusual skull to study"
    // en base_es
    // en = "Successfully stole from the peasantry"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Experience"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Initiative"
    // en base_es
    // context: anatomist_wants_skull_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_43.png[/img]{You decide that if the anatomists can make some grand use of the skull, then you'll abide by giving them the chance to study it. The question is how does one go about stealing a hideous skull from a group so insane they'd worship it? Almost as if on cue, %wildman% the wild%person_wildman% appears, chowing down on a handful of worms. %Their_wildman% nature-rinsed face and cruelly shaped skull seem almost kin to the monstrosity which resides on the village's town center lectern. %anatomist% snaps %their_anatomist% fingers and claims to have an idea. %They_anatomist% pulls the wild%person_wildman% forward, and the two walk straight toward the village's beloved skull.\n\nThe anatomist pushes the wild%person_wildman% before the praying folk, and claims that they have murdered one who is cousin to %their_wildman% being. %They_anatomist% states that by stealing the skull of %their_wildman% kin, they have doomed %them_wildman% to a life of being cursed. The crowd is horrified, not realizing the error of their ways. The wild%person_wildman% eats another worm. You continue to watch as the anatomist picks up the skull, lofts it over %their_anatomist% head, and says that with this %they_anatomist% may finally heal %wildman% of what ails %them_wildman%, and through %them_wildman% also lift any curses which have befallen the village itself. By this point the crowd is arisen, taken to the anatomist like a tentpole priest, and they clap as %they_anatomist% leaves, cheering the theft as it were, the skull lofted above %their_anatomist% head. The two men return to you. %anatomist% grins.%SPEECH_ON%To study the body, one shouldn't forget to study the mind, and in studying the mind, one shouldn't forget to study minds, plural! For many minds put together are a creature to study in and of themselves.%SPEECH_OFF%The anatomist walks off. A group of peasants approach carrying goods of all sorts. They throw them at the feet of %wildman% in apology. The wild%person_wildman% eats another worm.}"
        es = "[img]gfx/ui/events/event_43.png[/img]{Decides que, si los anatomistas pueden darle un gran uso al cráneo, les darás la oportunidad de estudiarlo. La cuestión es: ¿cómo se le roba un cráneo espantoso a un grupo tan demente como para adorarlo? Casi como si le hubieran dado la entrada, aparece %wildman%, %art_wildman% salvaje, zampándose un puñado de gusanos. Su rostro curtido por la naturaleza y su cráneo de forma brutal parecen casi emparentados con la monstruosidad que descansa en el atril del centro del pueblo. %anatomist% chasquea los dedos y asegura tener una idea. Tira %del_wildman% salvaje hacia delante, y juntos se dirigen directos hacia el adorado cráneo del pueblo.\n\n%Art_anatomist% anatomista empuja %al_wildman% salvaje ante los fieles en oración y afirma que han asesinado a un pariente de su especie. Declara que, al robar el cráneo de su pariente, %lo_wildman% han condenado a una vida maldita. La multitud se horroriza, sin haberse dado cuenta hasta ahora de su error. %Art_wildman% salvaje se come otro gusano. Sigues mirando mientras %art_anatomist% anatomista recoge el cráneo, lo alza por encima de su cabeza y dice que con esto podrá por fin curar a %wildman% de lo que %lo_wildman% aflige y, a través de %el_wildman%, levantar también cualquier maldición que haya caído sobre el propio pueblo. A estas alturas la multitud está en pie, entregada %al_anatomist% anatomista como a un predicador de carpa, y aplaude mientras se marcha, celebrando el robo, por así decirlo, con el cráneo en alto sobre su cabeza. Regresan contigo. %anatomist% sonríe.%SPEECH_ON%Para estudiar el cuerpo, no hay que olvidar estudiar la mente, ¡y al estudiar la mente, no hay que olvidar estudiar las mentes, en plural! Pues muchas mentes juntas son una criatura digna de estudio en sí misma.%SPEECH_OFF%%Art_anatomist% anatomista se aleja. Un grupo de campesinos se acerca con bienes de todo tipo. Los arrojan a los pies de %wildman% a modo de disculpa. %Art_wildman% salvaje se come otro gusano.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc8\anatomist_white_nachzehrer_event.nut
    // context: anatomist_white_nachzehrer_event.o.create.s.Text
    {
        // corrige base: "algunos necrófagos" → "algunos nachs" (el glosario fija Nachzehrer y "nachs" es su apócope)
        // corrige base: "me han hecho caer en una gran caza falsa" → "me han mandado a perseguir una quimera" (snipe hunt: búsqueda de algo que no existe; la 1.0 no se entendía)
        // corrige base: "el ojo de la laicidad" → "el ojo escrutador de los legos" (laity son los legos, no el laicismo; faltaba "scrying")
        // corrige base: sobraban espacios junto a %SPEECH_ON% y %SPEECH_OFF%
        en = "[img]gfx/ui/events/event_184.png[/img]{%anatomist% hasn't been writing in %their_anatomist% journals so much lately. When %they_anatomist% does, the pen only seems to tap the pages now and again without scribbling anything of import. You inquire as to what has %them_anatomist% so bothered. Somber in tone, %they_anatomist% says that %their_anatomist% primary hope in coming out to these lands was to find the White Nachzehrer, a monster that's larger than any of its kind. You tell %them_anatomist% that you've slain a few nachs that were quite rotund, but the anatomist shakes %their_anatomist% head.%SPEECH_ON%Per the literature, this nachzehrer cannot be felled by any man for it has grown to such proportions that its flesh has turned white, and it is covered in great ridges of calloused skin that no steel can penetrate. It was spotted roaming these lands and I'd hoped to find it, but it seems that, perhaps, I have been led astray. Maybe the anatomists who told me this tale have put me on a great snipe hunt. I worry, scapegrace, that I have been made a fool of.%SPEECH_OFF%You tell %them_anatomist% that this creature sounds like the 'king' of nachzehrers, and if that's the case then perhaps it no longer roams, but instead uses a small army of lesser nachzehrers to do its bidding for it. The anatomist smiles.%SPEECH_ON%Truly, this may be the case! Of course it took the scrying eye of the laity, so used to staring up at our purpled suzerains, to bring this to my clouded attention!%SPEECH_OFF%Agreeing with yourself further, you note that perhaps the 'White Nachzehrer' is so pale cause it doesn't get much sun. The anatomist laughs.%SPEECH_ON%Please, scapegrace, the first observation was sufficient input from your side.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_184.png[/img]{%anatomist% no ha estado escribiendo mucho en sus diarios últimamente. Cuando lo hace, la pluma parece tocar las páginas de vez en cuando sin escribir nada de importancia. Le preguntas qué es lo que %lo_anatomist% preocupa tanto. Con tono sombrío, dice que su principal esperanza al salir a estas tierras era encontrar al Nachzehrer Blanco, un monstruo más grande que cualquier otro de su tipo. Le dices que has matado a algunos nachs que eran bastante rechonchos, pero %art_anatomist% anatomista niega con la cabeza.%SPEECH_ON%Según la literatura, este nachzehrer no puede ser derrotado por ningún hombre, ya que ha crecido tanto que su carne se ha vuelto blanca y está cubierto de grandes crestas de piel callosa que ninguna espada puede penetrar. Se le vio deambulando por estas tierras y yo esperaba encontrarlo, pero parece que, tal vez, me han llevado por el mal camino. Quizás los anatomistas que me contaron esta historia me han mandado a perseguir una quimera. Me preocupa, bribón, que me hayan hecho quedar como %un_anatomist% tont%o_anatomist%.%SPEECH_OFF%Le dices que esta criatura suena como el 'rey' de los nachzehrers, y si ese es el caso, tal vez ya no deambule, sino que utilice un pequeño ejército de nachzehrers menores para hacer su trabajo. %Art_anatomist% anatomista sonríe.%SPEECH_ON%¡En verdad, este puede ser el caso! ¡Por supuesto, se necesitó el ojo escrutador de los legos, tan acostumbrado a mirar hacia nuestros soberanos morados, para traer esto a mi atención nublada!%SPEECH_OFF%Estás de acuerdo contigo mismo y notas que tal vez el 'Nachzehrer Blanco' es tan pálido porque no recibe mucho sol. %Art_anatomist% anatomista se ríe.%SPEECH_ON%Por favor, bribón, la primera observación fue una aportación suficiente de tu parte.%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\dlc8\captured_oathbringer_event.nut
    // en = "Pleased you slew an Oathbringer heretic"
    // en base_es
    // en = "Disliked that you slew a captive in cold blood"
    // en base_es
    // context: captured_oathbringer_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]{You nod.%SPEECH_ON%Torture him until his tongue points us to Young Anselm's jaw. I don't care how you do it, just do it.%SPEECH_OFF%Turning away, the prisoner screams out that Anselm would not approve. He then just starts screaming indiscriminately and eventually shouting out things that don't make a whole lot of sense. You retire to your tent, bouncing your foot to the screams that now take a rhythmic sort of wailing. Eventually, %randombrother% reappears. %They_randombrother% has with %them_randombrother% some weapons and armor you know weren't in inventory.%SPEECH_ON%He led us to a location that had these hidden away, but Anselm's jawbone is still missing. I'm afraid the Oathbringers must have it in their own camp, but he wouldn't say where that was. We, uh, we had some difficulties communicating after we cut his tongue out.%SPEECH_OFF%Sighing, you ask where the prisoner is now. The %person_randombrother% clears %their_randombrother% throat.%SPEECH_ON%Oh he went all white and fell over. He's dead, sir.%SPEECH_OFF%We did right by Young Anselm, at least.}"
        es = "[img]gfx/ui/events/event_05.png[/img]{Asientes.%SPEECH_ON%Tortúrenlo hasta que su lengua nos lleve a la mandíbula del Joven Anselm. Me da igual cómo lo hagan, solo háganlo.%SPEECH_OFF%Cuando te das la vuelta, el prisionero grita que Anselm no lo aprobaría. Luego se pone a gritar sin ton ni son y acaba vociferando cosas que no tienen mucho sentido. Te retiras a tu tienda y marcas el compás con el pie al son de los gritos, que ahora se han vuelto una especie de lamento rítmico. Al cabo, %randombrother% reaparece. Trae consigo unas armas y armaduras que sabes que no estaban en el inventario.%SPEECH_ON%Nos llevó a un sitio donde tenían esto escondido, pero la mandíbula de Anselm sigue sin aparecer. Me temo que los Juramentadores la tienen en su propio campamento, pero no quiso decir dónde está. Tuvimos, eh, tuvimos algunas dificultades para comunicarnos después de cortarle la lengua.%SPEECH_OFF%Suspirando, preguntas dónde está ahora el prisionero. %Art_randombrother% %hombre_randombrother% se aclara la garganta.%SPEECH_ON%Ah, se puso blanco como la cal y se desplomó. Está muerto, señor.%SPEECH_OFF%Al menos cumplimos con el Joven Anselm.}"
    }
    // en = "Tortured an Oathbringer heretic"
    // en base_es
    // en = "Is horrified that you ordered a captive tortured"
    // en base_es
    // context: captured_oathbringer_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]{You tell the men to torture the man for information. If there's one thing every Oathbringer knows, it's where Young Anselm's jawbone is and that is something every Oathtaker wishes to find out. The man screams as he's dragged away, and you retire to your tent to drown out the annoyances of things like shrieking and crying which really put a crimp on your mood. A moment later, %torturer% enters the tent, blood on his shirt. %They_torturer% looks to speak, then collapses to the ground. Another Oathtaker comes in saying the prisoner escaped, shanking his torturer before fleeing. You tell the men to help %torturer% before %they_torturer% bleeds out.%SPEECH_ON%Those damned Oathbringers have no honor! We'll find and kill him dead, so sayeth Young Anselm, so sayeth us all!%SPEECH_OFF%You speak with a clenched jaw, and an air of theatrics. The truth is the bastard got away and those Oathbringers are hard to catch, the rats that they are. You just hope that %torturer% survives.}"
        es = "[img]gfx/ui/events/event_05.png[/img]{Les dices a los hombres que torturen al prisionero para sacarle información. Si hay algo que todo Juramentador sabe, es dónde está la mandíbula del Joven Anselm, y eso es algo que todo Juramentado desea averiguar. El hombre grita mientras se lo llevan a rastras, y te retiras a tu tienda para no oír molestias como los chillidos y los llantos, que de verdad te agrian el humor. Un momento después, %torturer% entra en la tienda con sangre en la camisa. Parece que va a hablar, pero se desploma en el suelo. Otro Juramentado entra diciendo que el prisionero ha escapado, no sin antes apuñalar a quien lo torturaba. Les dices a los hombres que ayuden a %torturer% antes de que se desangre.%SPEECH_ON%¡Esos malditos Juramentadores no tienen honor! Lo encontraremos y lo mataremos, así lo dice el Joven Anselm, ¡así lo decimos todos!%SPEECH_OFF%Hablas con la mandíbula apretada y un aire teatral. Lo cierto es que el bastardo se ha escapado, y esos Juramentadores son difíciles de atrapar, ratas como son. Solo esperas que %torturer% sobreviva.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc8\disowned_noble_welcomed_back_event.nut
    // context: disowned_noble_welcomed_back_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_20.png[/img]{While in %townname%, you receive a letter from a messenger. He asks that you not read it, but as soon as he's around the corner you do just that, breaking apart a wax royal seal. You read that %disowned%, the disowned noble%person_disowned%, is no longer exiled. Instead, %them_disowned% place is on the family throne as soon as %them_disowned% already gravely-ill father passes away.\n\nYou hold the letter in your hand, unsure of what to do with it. %disowned% has long been a member of the %companyname%. For some, there is a strange appeal to a %person_disowned% who was once in the royal rooms of the world, and now finds %themselves_disowned% in the veritable lowlands of a mercenary company. But while a bloodline may dry, a lineage never truly dies...}"
        es = "[img]gfx/ui/events/event_20.png[/img]{Mientras estás en %townname%, un mensajero te entrega una carta. Te pide que no la leas, pero en cuanto dobla la esquina haces justo eso y rompes un sello real de cera. Lees que %disowned%, %art_disowned% noble desterrad%o_disowned%, ya no está en el exilio. Al contrario, su lugar está en el trono familiar en cuanto su padre, ya gravemente enfermo, fallezca.\n\nSostienes la carta en la mano, sin saber qué hacer con ella. %disowned% lleva mucho tiempo en %companyname%. Para algunos, tiene un extraño atractivo %un_disowned% %hombre_disowned% que antaño frecuentó los salones reales del mundo y que ahora se encuentra en los auténticos bajos fondos de una compañía de mercenarios. Pero aunque una estirpe pueda secarse, un linaje nunca muere del todo...}"
    }
    // context: disowned_noble_welcomed_back_event.o.create.s.Options[0].Text
    {
        en = "I'll show %them_disowned% the letter."
        es = "Le enseñaré la carta."
    }
    // context: disowned_noble_welcomed_back_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_82.png[/img]{Sighing with the realization of what might happen, you decide to go and show %them_disowned% the letter. %They_disowned% reads it for a length of time, then looks up.%SPEECH_ON%I know you've read this.%SPEECH_OFF%%They_disowned% holds the letter back toward you.%SPEECH_ON%And I know you could have just as easily burned this letter. But you didn't. That only goes to show me what I already know: the %companyname% is my family now. If you want me to stay, I'll stay, if you want me to go, I'll go.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_82.png[/img]{Suspirando al darte cuenta de lo que podría suceder, decides ir y mostrarle la carta. La lee durante un tiempo y luego levanta la vista.%SPEECH_ON%Sé que has leído esto.%SPEECH_OFF%Te devuelve la carta.%SPEECH_ON%Y sé que podrías haberla quemado igual de fácilmente. Pero no lo hiciste. Eso solo me muestra lo que ya sé: %companyname% es mi familia ahora. Si quieres que me quede, me quedaré; si quieres que me vaya, me iré.%SPEECH_OFF%}"
    }
    // context: disowned_noble_welcomed_back_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_82.png[/img]{You take the letter back, then put it toward a nearby candle. It burns quickly, ashes feathering way from your fingertips as the fire climbs up the paper. %disowned% nods.%SPEECH_ON%I'm glad you did it. If my homelands need me, I shall only return when my work with the %companyname% is over. But until then, you shall have my sword, my sweat, and my blood.%SPEECH_OFF%%They_disowned% grins.%SPEECH_ON%For the right price, of course. I am, as it is, still yet a sellsword.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_82.png[/img]{Tomas la carta de nuevo y la acercas a una vela cercana. Se quema rápidamente, las cenizas se desprenden de tus dedos mientras el fuego se eleva por el papel. %disowned% asiente.%SPEECH_ON%Me alegra que lo hayas hecho. Si mis tierras natales me necesitan, solo regresaré cuando mi trabajo con %companyname% haya terminado. Pero hasta entonces, tendrás mi espada, mi esfuerzo y mi sangre.%SPEECH_OFF%Sonríe.%SPEECH_ON%Por el precio correcto, por supuesto. Después de todo, sigo siendo %un_disowned% mercenari%o_disowned%.%SPEECH_OFF%}"
    }
    // en = "<disowned:str> is now a Regent in Absentia"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Resolve"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Initiative"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Melee Defense"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Ranged Defense"
    // en base_es
    // context: disowned_noble_welcomed_back_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_74.png[/img]{You push the letter back toward %them_disowned%.%SPEECH_ON%I think a %person_disowned% removed from %their_disowned% family is more in need of that family when they call %them_disowned% back, and certainly they must be in dire need of %them_disowned%. Your time with the %companyname% is over.%SPEECH_OFF%At first, the disowned noble%person_disowned% appears despondent, but %they_disowned% then begins to nod, agreeing with your assessment that %their_disowned% family must be in need of %them_disowned% and %they_disowned% should not leave them twisting in the wind. %They_disowned% says %their_disowned% goodbyes to you and the rest of the company, but before %they_disowned% leaves for good %they_disowned% has prepared you a letter.%SPEECH_ON%You will have my thanks, captain. Don't think I'd ever just leave without acknowledging how important you were to saving my life, because that's precisely what you did, whether you realize it or not.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_74.png[/img]{Le devuelves la carta.%SPEECH_ON%Creo que %un_disowned% %hombre_disowned% apartad%o_disowned% de su familia necesita más a esa familia cuando %lo_disowned% llaman de vuelta, y sin duda ellos deben de necesitar%lo_disowned% desesperadamente. Tu tiempo con %companyname% ha terminado.%SPEECH_OFF%Al principio, %art_disowned% noble desterrad%o_disowned% parece abatid%o_disowned%, pero luego empieza a asentir, conforme con tu valoración de que su familia debe de necesitar%lo_disowned% y de que no debe dejarlos en la estacada. Se despide de ti y del resto de la compañía, pero antes de marcharse para siempre te ha preparado una carta.%SPEECH_ON%Tienes mi gratitud, capitán. No creas que me iría sin reconocer lo importante que fuiste para salvarme la vida, porque eso es precisamente lo que hiciste, te des cuenta o no.%SPEECH_OFF%}"
    }
    // context: disowned_noble_welcomed_back_event.o.create.s.Text
    {
        // corrige base: «todos los detalles de su aceptación de nuevo en su linaje familiar» es un calco ininteligible (readmisión en el linaje); «si hay algo mal» y «No, nada mal» calcan «anything wrong» («si pasa algo», «no pasa nada»); «ves al mensajero que está entregando algo» por «pulling something over» (arrastrando algo).
        en = "[img]gfx/ui/events/event_98.png[/img]{There's no way you're showing that to %disowned%. You promptly burn the letter and all details of %their_disowned% acceptance back into %their_disowned% family lineage. Just then, %they_disowned% comes around the corner. He looks a little perplexed and asks if there's anything wrong. You shake your head and ask if %they_disowned% wants to help count inventory. %disowned% grins.%SPEECH_ON%Of course. The %companyname% can't do what it does without a good inventory, or without your command, captain.%SPEECH_OFF%Just as you turn to join %them_disowned%, you see the messenger from earlier pulling something over. You leave %disowned% to the task and head the man off, asking what it is now. He pulls a heavy chest over and then wipes his brow, stating that this was also intended for the disowned noble%person_disowned%. You kick it open to find a litany of arms and armor, some of which have %their_disowned% family crest on them. You thank the messenger, send %them_disowned% on %their_disowned% way, and then hurriedly break the crests off and throw the emblems into the gutters lest the noble%person_disowned% see them %themselves_disowned%. Curious, %they_disowned% hollers over if anything is wrong. You shake your head.%SPEECH_ON%No, nothing wrong. Just got a shipment of new gear, that's all.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_98.png[/img]{No hay forma de que le enseñes eso a %disowned%. Quemas de inmediato la carta y, con ella, todos los detalles de su readmisión en el linaje familiar. Justo en ese momento, aparece por la esquina. Parece algo perplej%o_disowned% y pregunta si pasa algo. Niegas con la cabeza y le preguntas si quiere ayudar a hacer inventario. %disowned% sonríe.%SPEECH_ON%Por supuesto. %companyname% no puede hacer lo que hace sin un buen inventario, ni sin tu mando, capitán.%SPEECH_OFF%Justo cuando te vuelves para unirte a %el_disowned%, ves al mensajero de antes arrastrando algo hacia aquí. Dejas a %disowned% con la tarea y le sales al paso al hombre, preguntándole qué pasa ahora. Arrastra un pesado cofre hasta ti y se enjuga la frente, diciendo que esto también iba destinado %al_disowned% noble desterrad%o_disowned%. Lo abres de una patada y encuentras un sinfín de armas y armaduras, algunas con el blasón de su familia. Le das las gracias al mensajero, lo despides y luego arrancas a toda prisa los blasones y tiras los emblemas a las cunetas, no vaya a ser que %art_disowned% noble los vea con sus propios ojos. Curios%o_disowned%, te grita desde lejos si pasa algo. Niegas con la cabeza.%SPEECH_ON%No, no pasa nada. Acaba de llegar un envío de equipo nuevo, eso es todo.%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\dlc8\fake_witchhunter_event.nut
    // context: fake_witchhunter_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «rastrillos» por «pitchforks» (horcas); «les dice a la multitud que hagan» debe ser «le dice... que haga»; «la arma» es «el arma»; «maestro del gremio de cazadores» añade «de cazadores», que el inglés no dice.
        en = "[img]gfx/ui/events/event_141.png[/img]{%witchhunter% comes forward. %They_witchhunter% says the man in the black hat is a known fraud in witch hunting circles.%SPEECH_ON%We've been looking for this man for some time as his lies sully the name of our profession. I've long been looking for a chance to get this scalp.%SPEECH_OFF%Before you can say another word, %witchhunter% walks through the crowd and emerges on the other end with one of the peasant's pitchforks in hand and promptly drives it through the faux hunter's leg. The man bends over screaming. The faux hunter wheels up with the crossbow, but %witchhunter% catches it by the barrel and rides it upward where the shot harmlessly launches into the sky. %They_witchhunter% yanks the crossbow away, yelling that it does not belong to him, and %they_witchhunter% announces to the crowd that the man is a charlatan. %They_witchhunter% throws him to the ground, telling the crowd to do whatever it is they wish. They descend on the liar, though the extent of torture is hard to see through the excited ranks of laity. %witchhunter% returns with the crossbow, turning it one way and another. It is the most incredible weapon you've seen in some time. The witch hunter explains.%SPEECH_ON%This belonged to a guildmaster in the region. We believe this fool murdered him, took his clothes, and has been walking around pretending the part ever since. If his screams disturb you, captain, just remember he has burned countless innocents and stolen countless crowns from the desperate and confused. Fark him.%SPEECH_OFF%You stare over the %person_witchhunter% and into the crowd. You can just make out the man being hoisted onto the pyre and the early smoke of fires getting their start.}"
        es = "[img]gfx/ui/events/event_141.png[/img]{%witchhunter% se adelanta y dice que el hombre del sombrero negro es un fraude conocido en los círculos de cazadores de brujas.%SPEECH_ON%Hace tiempo que buscamos a este hombre, pues sus mentiras manchan el nombre de nuestra profesión. Llevo mucho tiempo esperando la ocasión de hacerme con esta cabellera.%SPEECH_OFF%Antes de que puedas decir otra palabra, %witchhunter% se abre paso entre la multitud, sale por el otro lado con una de las horcas de los campesinos en la mano y la clava sin más en la pierna del falso cazador. El hombre se dobla gritando. El falso cazador se revuelve con la ballesta en alto, pero %witchhunter% la agarra por delante y la empuja hacia arriba, de modo que el virote sale disparado inofensivamente hacia el cielo. Le arranca la ballesta de las manos, gritando que no le pertenece, y anuncia a la multitud que el hombre es un charlatán. Lo arroja al suelo y le dice a la multitud que haga con él lo que quiera. Se abalanzan sobre el mentiroso, aunque el alcance de la tortura es difícil de ver entre las filas enardecidas del populacho. %witchhunter% vuelve con la ballesta, girándola a un lado y a otro. Es el arma más increíble que has visto en mucho tiempo. %witchhunter% lo explica.%SPEECH_ON%Esto pertenecía a un maestro de gremio de la región. Creemos que este necio lo asesinó, se puso su ropa y desde entonces ha ido por ahí haciéndose pasar por él. Si sus gritos te perturban, capitán, recuerda que ha quemado a innumerables inocentes y robado innumerables coronas a los desesperados y confundidos. Que le jodan.%SPEECH_OFF%Miras más allá %del_witchhunter% %hombre_witchhunter%, hacia la multitud. Apenas alcanzas a distinguir al hombre al que izan a la pira y el primer humo de las hogueras que empiezan a prender.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc8\incense_trade_event.nut
    // context: incense_trade_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «aparentemente» por «apparently» abriendo la afirmación (es «por lo visto»); «cometa» es femenino y la 1.0 alterna «sus cometas negras» con «los cometas».
        en = "[img]gfx/ui/events/event_143.png[/img]{%bellydancer% the belly dancer steps forward, peers into the snow, and rather unexpectedly wonders aloud if that is %their_dancer% father. The crazed man comes forward, his black kites following after him like buzzards in the tailwind of the doomed, then his face lights up and the two embrace. The man is apparently %bellydancer%'s long lost father, an incense merchant who had headed far north only to be ambushed and enslaved by the savage barbarians there whom he has since escaped. He smiles madly.%SPEECH_ON%It had been so long since I had seen good incense I could smell your wagon from miles away. My wife, your mother, %bellydancer%, how is she?%SPEECH_OFF%The belly dancer's smile fades. %They_dancer% mentions that she held out hope for as long as she could. The kite-kitted man nods solemnly, but also expectedly. He says it wouldn't be right for her to be married to a specter of what once was, and that he himself, with no hope of making a return home, moved on as well. The man pulls out an ornate weapon with a blade unlike anything you've seen before. He says that it is a long held relic of the family, and that he kept it buried and safe all his years in the north.%SPEECH_ON%Best you take it and make use of it before one of the savages here eats me and uses it as a toothpick.%SPEECH_OFF%The man smiles fondly and the two embrace for a time. Curious, you ask him why the kites. He responds that they are tools of fear meant to ward off dangerous animals and the like, including the more superstitious of the barbarians. You bid the man goodbye and suggest to %bellydancer% that %they_dancer% can leave if %they_dancer% needs to as well, but %they_dancer% shakes %their_dancer% head.%SPEECH_ON%The %child_dancer% and father mustn't share the gilded path, for we know that we shall be together at its end as we were at its beginning.%SPEECH_OFF%%They_dancer% says a few words to %their_dancer% father in %their_dancer% native tongue, and then the two depart and that is that.}"
        es = "[img]gfx/ui/events/event_143.png[/img]{%bellydancer%, que baila la danza del vientre, da un paso al frente, escudriña la nieve y, de forma bastante inesperada, se pregunta en voz alta si ese es su padre. El hombre enloquecido avanza, con sus cometas negras siguiéndolo como buitres tras los condenados; entonces se le ilumina la cara y los dos se abrazan. Por lo visto, el hombre es el padre de %bellydancer%, perdido hace mucho tiempo: un comerciante de incienso que había viajado al lejano norte solo para ser emboscado y esclavizado por los bárbaros salvajes de allí, de quienes ha logrado escapar. Sonríe como un loco.%SPEECH_ON%Hacía tanto que no veía buen incienso que pude oler tu carreta desde millas de distancia. Mi esposa, tu madre, %bellydancer%, ¿cómo está?%SPEECH_OFF%La sonrisa de %bellydancer% se desvanece. Cuenta que ella mantuvo la esperanza tanto como pudo. El hombre de las cometas asiente con solemnidad, pero también como quien ya se lo esperaba. Dice que no sería justo que ella siguiera casada con el espectro de lo que una vez fue, y que él mismo, sin esperanza de volver a casa, también rehízo su vida. El hombre saca un arma ornamentada con una hoja como ninguna que hayas visto antes. Dice que es una reliquia que la familia conserva desde hace mucho, y que la mantuvo enterrada y a salvo durante todos sus años en el norte.%SPEECH_ON%Más vale que te la lleves y le des buen uso antes de que uno de los salvajes de aquí me coma y la use como palillo.%SPEECH_OFF%El hombre sonríe con cariño y los dos se abrazan un rato. Por curiosidad, le preguntas por qué las cometas. Responde que son herramientas para infundir miedo, pensadas para ahuyentar a animales peligrosos y demás, incluidos los bárbaros más supersticiosos. Te despides del hombre y le sugieres a %bellydancer% que también puede irse si lo necesita, pero niega con la cabeza.%SPEECH_ON%%Art_dancer% hij%o_dancer% y el padre no deben compartir el camino dorado, pues sabemos que estaremos juntos al final como lo estuvimos al principio.%SPEECH_OFF%Le dice unas palabras a su padre en su lengua materna, luego los dos se marchan y ahí se acaba todo.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc8\lindwurm_slayer_event.nut
    // context: lindwurm_slayer_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_35.png[/img]{You're enjoying a drink at one of %townname%'s cozy taverns. Naturally, this comfort doesn't last long as a %person_dude% struts into the place with %their_dude% armor clinking and clanking. You make the error of glancing at %them_dude% and catching %their_dude% eye. %They_dude% immediately heads over. Sighing, you put your opposite hand onto your sword and await what this could possibly be. The %person_dude% stomps to the end of your table and straightens up.%SPEECH_ON%Let me introduce myself, in case rumor and myth have not done it already. I am %dragonslayer%. My chosen life in this world is to hunt and slay dragons.%SPEECH_OFF%You take a drink and set it down, telling the %person_dude% that dragons don't exist. %They_dude% grins.%SPEECH_ON%That is because my father slew them all. In truth, I am a killer of lindwurms, and I hear you are the captain of the %companyname%, an outfit of some renown, almost as much as renown as yours truly. What would you say to combining our skills and talents, hm? I'd be willing to join you for %price% crowns.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_35.png[/img]{Disfrutas de una bebida en una de las acogedoras tabernas de %townname%. Naturalmente, esta comodidad no dura mucho, ya que %un_dude% %hombre_dude% entra pavoneándose en el local, con la armadura tintineando y chirriando. Cometes el error de mirar%lo_dude% y cruzarte con su mirada. Enseguida se dirige hacia ti. Suspirando, pones la otra mano en la espada y esperas a ver qué puede ser esto. %Art_dude% %hombre_dude% llega a pisotones hasta el extremo de tu mesa y se yergue.%SPEECH_ON%Permíteme presentarme, por si los rumores y los mitos no lo han hecho ya. Soy %dragonslayer%. La vida que he elegido en este mundo es cazar y matar dragones.%SPEECH_OFF%Das un trago, dejas la jarra en la mesa y le dices %al_dude% %hombre_dude% que los dragones no existen. Sonríe.%SPEECH_ON%Eso es porque mi padre los mató a todos. En verdad, soy %un_dude% asesin%o_dude% de lindwurms, y he oído que eres el capitán de %companyname%, una compañía de cierto renombre, casi tanto como el mío. ¿Qué te parecería combinar nuestras habilidades y talentos, eh? Estaría dispuest%o_dude% a unirme a ti por %price% coronas.%SPEECH_OFF%}"
    }
    // context: lindwurm_slayer_event.o.create.s.Text
    {
        // corrige base: «Alcanzas a tus bolsillos» es agramatical (te metes la mano en los bolsillos); «rebusca en el cambio» calca «change» (entre las monedas).
        en = "[img]gfx/ui/events/event_35.png[/img]{You reach into your pockets and put the purse on the table. The %person_dude% takes it up, picking through the change. %They_dude% nods and cinches the pursestrings.%SPEECH_ON%Very well. You have my services, captain of the %companyname%, and by my father's good name you shall not regret it.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_35.png[/img]{Te metes la mano en los bolsillos y pones la bolsa sobre la mesa. %Art_dude% %hombre_dude% la toma y rebusca entre las monedas. Asiente y aprieta los cordones de la bolsa.%SPEECH_ON%Muy bien. Tienes mis servicios, capitán de %companyname%, y por el buen nombre de mi padre, no te arrepentirás.%SPEECH_OFF%}"
    }
    // context: lindwurm_slayer_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_35.png[/img]{The %person_dude% will either prove %themselves_dude% to be worthy of %their_dude% stated accomplishments, or %they_dude%'ll end up dead meat. If %they_dude%'s willing to join without any upfront cost to you, what does it hurt to see how %they_dude% fares? You hold your hand out and the %person_dude% shakes it. %Their_dude% armor clinks and clanks as %their_dude% arm bounces up and down.%SPEECH_ON%Your Oathtakers will not be disappointed, that I can promise you.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_35.png[/img]{O bien %art_dude% %hombre_dude% demuestra estar a la altura de las hazañas que proclama, o acabará siendo carne muerta. Si está dispuest%o_dude% a unirse sin que te cueste nada por adelantado, ¿qué tiene de malo ver cómo le va? Le tiendes la mano y %art_dude% %hombre_dude% te la estrecha. Su armadura tintinea y repiquetea mientras el brazo sube y baja.%SPEECH_ON%Tus Juramentados no se decepcionarán, eso te lo prometo.%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\dlc8\oathbreaker_event.nut
    // en = "You lose <v:val_tag> Crowns"
    // en base_es
    // en = "the Oathbreaker"
    // en base_es
    // en = "Like many men, %name% was found in squalor. Ale on his lips, grime in his ears, piss and shit at least somewhere on his person. But he was an Oathtaker at heart, and by the providence of Young Anselm it was certainly no ordinary circumstance which brought him back into the faith. Of course, he'll still yet pair beer with belief, but now and again one must allow a man his vices, particularly if said man shares an interest in slaying Oathbringers."
    // en base_es
    // FILE: mod_legends\hooks\events\events\dlc8\oathtaker_joins_event.nut
    // context: oathtaker_joins_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_180.png[/img]{A %person_dude% in armor approaches the company. %They_dude% seems most usual, until %they_dude% opens %their_dude%  mouth.%SPEECH_ON%Hear ye, hear ye, I am a proud Oathtaker! Now, I see you also have what appears to be a high regard for doing what is right. That makes me believe you, too, are Oathtakers. So! I have but one question for you: that skull hanging from a necklace, what is his name? If it is the one I seek, then ye shall have my hand.%SPEECH_OFF% | %People_dude%  in armor are not a rare sight on the roads these days, but this %person_dude% has a certain level of pomp and theatrics that draws the eye, as does the fact %they_dude% confidently strides right over to you.%SPEECH_ON%I'd been carousing at a local pub when I got word that a band of Oathtakers had been passing through these lands. Now, either that is some graveyard skullduggery hanging from yer neck, or that is...well, you tell me. Give me the right name of that skull and I'll join you right here and now.%SPEECH_OFF% | You come across a %person_dude% in armor. %They_dude% stands in the road like %they_dude% either wants to commit suicide by sellsword, or he's looking to risk %their_dude%  neck for a coin. As you draw near, %they_dude% waves you down.%SPEECH_ON%Ah, the company I am looking for. Are you with the Oathtakers? I wish to join you on the path. The path of...%SPEECH_OFF%%They_dude% pauses, gesturing toward the company's resident skull. Oh, %they_dude% means... | A %person_dude% in armor hurries out onto the road. You put a hand to your sword, but %they_dude% simply bows as though you were an executioner.%SPEECH_ON%I prayed to the old gods to harden my virtues and keep me on the path. Surely, stranger, surely that is his skull there hanging from your neck? If it is, I shall join you and the oaths you're on this very minute. Please, tell me, is that the jawless skull of our dear...our...%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_180.png[/img]{%Un_dude% %hombre_dude% con armadura se acerca a la compañía. Parece de lo más normal, hasta que abre la boca.%SPEECH_ON%¡Oigan, oigan, soy %un_dude% orgullos%o_dude% Juramentad%o_dude%! Veo que ustedes también parecen tener en gran estima hacer lo correcto. Eso me hace creer que también son Juramentados. ¡Así que! Solo tengo una pregunta para ustedes: esa calavera que cuelga de un collar, ¿cuál es su nombre? Si es quien busco, contarán con mi brazo.%SPEECH_OFF% | No es raro ver gente con armadura por los caminos estos días, pero %ese_dude% %hombre_dude% tiene cierta pompa y teatralidad que llama la atención, igual que el hecho de que se dirija hacia ti con paso decidido.%SPEECH_ON%Estaba de juerga en una taberna de por aquí cuando me llegó la noticia de que una banda de Juramentados andaba por estas tierras. Bueno, o eso que te cuelga del cuello es alguna triquiñuela de cementerio, o es... bueno, dímelo tú. Dime el nombre correcto de esa calavera y me uniré a ustedes aquí y ahora.%SPEECH_OFF% | Te topas con %un_dude% %hombre_dude% con armadura. Está plantad%o_dude% en mitad del camino como si quisiera suicidarse a manos de mercenarios o buscara jugarse el cuello por una moneda. Cuando te acercas, te hace señas para que te detengas.%SPEECH_ON%Ah, la compañía que busco. ¿Están con los Juramentados? Deseo unirme a ustedes en el camino. El camino de...%SPEECH_OFF%Se interrumpe y señala la calavera residente de la compañía. Ah, se refiere a... | %Un_dude% %hombre_dude% con armadura sale a toda prisa al camino. Llevas la mano a la espada, pero se limita a hacer una reverencia, como ante un verdugo.%SPEECH_ON%Recé a los viejos dioses para que endurecieran mis virtudes y me mantuvieran en el camino. Sin duda, forastero, sin duda esa que cuelga de tu cuello es su calavera, ¿no? Si lo es, me uniré a ti y a tus juramentos en este mismo instante. Por favor, dime, ¿es esa la calavera sin mandíbula de nuestro querido... nuestro...%SPEECH_OFF%}"
    }
    // context: oathtaker_joins_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_180.png[/img]{The %person_dude% drops to a knee, %their_dude% head down.%SPEECH_ON%Truly, Young Anselm has guided me here! I shall join you on the path, fellow Oathtakers!%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_180.png[/img]{%Art_dude% %hombre_dude% hinca una rodilla en el suelo, con la cabeza gacha.%SPEECH_ON%¡En verdad el Joven Anselm me ha guiado hasta aquí! ¡Me uniré a ustedes en el camino, compañeros Juramentados!%SPEECH_OFF%}"
    }
    // context: oathtaker_joins_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_180.png[/img]{The %person_dude% sighs.%SPEECH_ON%Ah, I see now. There are far too many Hugos in this world, it does not surprise me that yet another has appeared in such a state as that dreary skull, though I know not why you carry it around like so.%SPEECH_OFF% | %SPEECH_ON%Hugo.%SPEECH_OFF%The %person_dude% says.%SPEECH_ON%Another farkin' Hugo, huh? How many are out here? Every other man I run into is a Hugo.%SPEECH_OFF%%they_dude% turns and walks off, mumbling angrily about the commoners and their unoriginal naming schemes. | The %person_dude% sighs.%SPEECH_ON%Hugo, huh? Alright. Whelp, see you later.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_180.png[/img]{%Art_dude% %hombre_dude% suspira.%SPEECH_ON%Ah, ahora lo entiendo. Hay demasiados Hugos en este mundo; no me sorprende que haya aparecido otro más en un estado como el de esa lúgubre calavera, aunque no sé por qué la llevas de un lado a otro así.%SPEECH_OFF% | %SPEECH_ON%Hugo.%SPEECH_OFF%Dice %art_dude% %hombre_dude%.%SPEECH_ON%Otro jodido Hugo, ¿eh? ¿Cuántos hay por aquí? Uno de cada dos hombres con los que me cruzo es un Hugo.%SPEECH_OFF%Se da la vuelta y se marcha, refunfuñando sobre la plebe y su falta de originalidad a la hora de poner nombres. | %Art_dude% %hombre_dude% suspira.%SPEECH_ON%Hugo, ¿eh? Muy bien. Pues nada, hasta luego.%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\dlc8\shadow_dissection_event.nut
    // context: shadow_dissection_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «soldados» por «sellswords» (mercenarios); la réplica de los mercenarios suavizaba y cambiaba el sentido («make like dicks and slags and shite»: hacer sombras de pollas, putas y mierdas así); «se despliegan en nuestro interior» pierde «set against us» (se vuelven contra nosotros); «lo que ha regresado para protegernos» invierte «that which it has returned to ward away» (lo que ha vuelto a ahuyentar).
        en = "[img]gfx/ui/events/event_184.png[/img]{%anatomist% the anatomist looks up from the campfire, %their_anatomist% face squirming with shadows as the flames rise and fall.%SPEECH_ON%Our shadows are but cuts upon the world which wound and mend all in one stride of black, dissecting the earth with our presence and self-same shaded presence in such a transient manner that it can't but be a preview of our stay here. But does the shadow think of dissecting you? Does it wish to free others which are like itself? Surely it is not alone. Surely our insides have shades. Do they cast tricks of themselves against our inner walls? What of when we sleep, are these things set against us from within or do they escape out into the world and wander? Are they the guards against our own minds, departing us in the night and leaving us to the horrors of dreamscapes which are surely present when we are awake? What distills the truth of the morning light better, than our shadow cast along the ground, and the fleeting memories of that which it has returned to ward away?%SPEECH_OFF%One of the sellswords stares at %them_anatomist%.%SPEECH_ON%What?%SPEECH_OFF%The rest of the sellswords scoff.%SPEECH_ON%Hey man, we just wanna make like dicks and slags and shite. Check this out, I'm %anatomist%'s shadow. Blah blah blah blah!%SPEECH_OFF%The man mimes a mouth opening and closing over and over again as the company laughs.}"
        es = "[img]gfx/ui/events/event_184.png[/img]{%anatomist%, %art_anatomist% anatomista, levanta la vista de la fogata, con el rostro retorcido por las sombras mientras las llamas suben y bajan.%SPEECH_ON%Nuestras sombras no son más que cortes en el mundo que hieren y curan en un solo paso de la oscuridad, disecando la tierra con nuestra presencia y nuestra fugaz presencia sombría, que no puede ser otra cosa que un anticipo de nuestra estadía aquí. Pero ¿acaso la sombra piensa en disecarte? ¿Desea liberar a otros que son como ella? Seguramente no está sola. Seguramente nuestras entrañas tienen sombras. ¿Lanzan acaso trucos de sí mismas contra las paredes internas de nuestro ser? ¿Y cuando dormimos, se vuelven estas cosas contra nosotros desde dentro o escapan al mundo y vagan? ¿Son ellas las guardianas de nuestras propias mentes, que nos abandonan en la noche y nos dejan a merced de los horrores de los paisajes oníricos que sin duda están presentes mientras estamos despiertos? ¿Qué destila mejor la verdad de la luz de la mañana que nuestra sombra proyectada en el suelo y los recuerdos fugaces de aquello que ha vuelto a ahuyentar?%SPEECH_OFF%Uno de los mercenarios %lo_anatomist% mira fijamente.%SPEECH_ON%¿Qué?%SPEECH_OFF%El resto de los mercenarios se burlan.%SPEECH_ON%Oye, nosotros solo queremos hacer sombras de pollas y putas y mierdas así. Miren esto, soy la sombra de %anatomist%. ¡Bla, bla, bla, bla!%SPEECH_OFF%El hombre imita una boca que se abre y se cierra una y otra vez mientras la compañía se ríe.}"
    }
    // context: shadow_dissection_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_03.png[/img]{%cultist% the cultist leans toward the fire, %their_cultist% face almost touching the flames. The men glance at %them_cultist% as %their_cultist% eyes go wide, the wetness drying and peeling back until blood veins grow fat on the white. %They_cultist% leans back.%SPEECH_ON%Shadows are but ambassadors of the greater dark.%SPEECH_OFF%The campfire crackles and the %person_cultist%'s shadow blossoms against the priory wall, and for a moment the company sees something else in that black, something twisted and leaning in, an entity not at all at the behest of %cultist%'s shape. As the fires die down, the shadow cuts to pieces and draws away into the greater night, and only the cultist's own shadowed self remains, flickering uncertainly against the priory walls.}"
        es = "[img]gfx/ui/events/event_03.png[/img]{%cultist%, %art_cultist% cultista, se inclina hacia el fuego, con la cara casi rozando las llamas. Los hombres %lo_cultist% miran de reojo mientras abre los ojos de par en par; la humedad se seca y se retira hasta que las venas se hinchan de sangre sobre el blanco. Se echa hacia atrás.%SPEECH_ON%Las sombras no son más que embajadoras de la gran oscuridad.%SPEECH_OFF%La fogata crepita y la sombra %del_cultist% %hombre_cultist% florece contra el muro del priorato, y por un momento la compañía ve algo más en esa negrura, algo retorcido que se inclina hacia ellos, una entidad que no obedece en absoluto a la silueta de %cultist%. Cuando el fuego se apaga, la sombra se hace pedazos y se retira hacia la noche más vasta, y solo queda la propia sombra %del_cultist% cultista, parpadeando insegura contra los muros del priorato.}"
    }
    // context: shadow_dissection_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «¡oíd, oíd!» usa «vosotros», que el corpus no admite; se cambia por «¡Eso, eso!».
        en = "[img]gfx/ui/events/event_40.png[/img]{Standing up, %monk% the %monk_background_name% makes an appeal to the old gods. %They_monk% has one hand to %their_monk% chest as the other swings upward as though in a great oratory offering.%SPEECH_ON%It is not the shadows we should mind, but the fire which has produced them, for it is the flame which the gods have bestowed upon us, such that we may carry the day into the night, and make our productive habits unending, and our allegiance to that which is good unerring.%SPEECH_OFF%The men shout 'hear hear!'}"
        es = "[img]gfx/ui/events/event_40.png[/img]{Poniéndose en pie, %monk%, %monk_background_name%, eleva una súplica a los viejos dioses. Tiene una mano en el pecho mientras alza la otra como en una gran ofrenda oratoria.%SPEECH_ON%No son las sombras lo que debe preocuparnos, sino el fuego que las ha producido, pues es la llama que los dioses nos han otorgado para que podamos llevar el día al interior de la noche, hacer que nuestros hábitos productivos no tengan fin y que nuestra lealtad a lo que es bueno sea infalible.%SPEECH_OFF%Los hombres gritan \"¡Eso, eso!\"}"
    }
    // context: shadow_dissection_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_82.png[/img]{One of the mercenaries stands up and points across the campfire and announces that %mercenary% has the scariest shadow of them all. The large sellsword looks over as if annoyed %their_mercenary% name was spoken aloud. %They_mercenary% grits %their_mercenary% teeth and slowly raises %their_mercenary% hands and the rest of the company fearfully rears back. %mercenary% laces %their_mercenary% fingers and puts the thumbs out.%SPEECH_ON%This is a chicken. See?%SPEECH_OFF%The men glance at the shadows on the wall. It looks absolutely nothing like a chicken, but nobody dares to say that. They all nod and agree.%SPEECH_ON%Frankly, %mercenary%, that is the best cock I've ever seen.%SPEECH_OFF%The men roar with laughter, but %mercenary% gets to %their_mercenary% feet and the laughter stops.%SPEECH_ON%I said it was a chicken, didn't I?%SPEECH_OFF%The other man nods hurriedly and agrees it was indeed a chicken. Tensions settle down, but the shadow games are effectively over.}"
        es = "[img]gfx/ui/events/event_82.png[/img]{Uno de los mercenarios se pone de pie, señala al otro lado de la fogata y anuncia que %mercenary% tiene la sombra más aterradora de todas. %Art_mercenary% robust%o_mercenary% mercenari%o_mercenary% mira como si le molestara que su nombre se dijera en voz alta. Aprieta los dientes y levanta lentamente las manos, y el resto de la compañía retrocede con miedo. %mercenary% entrelaza los dedos y saca los pulgares.%SPEECH_ON%Esto es un pollo. ¿Ven?%SPEECH_OFF%Los hombres miran las sombras en la pared. No se parece en absoluto a un pollo, pero nadie se atreve a decirlo. Todos asienten y le dan la razón.%SPEECH_ON%Sinceramente, %mercenary%, es el mejor gallo que he visto en mi vida.%SPEECH_OFF%Los hombres ríen a carcajadas, pero %mercenary% se pone de pie y las risas cesan.%SPEECH_ON%Dije que era un pollo, ¿no?%SPEECH_OFF%El otro hombre asiente apresuradamente y admite que era, en efecto, un pollo. Las tensiones se calman, pero los juegos de sombras se han acabado a todos los efectos.}"
    }
    // context: shadow_dissection_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «de los incautos» cambia «from the filthy» (a los mugrientos); «y carcajadas» es un añadido; «una reverencia» por «wave» (un gesto de la mano); «no era mierda de perro» pierde el «farkin'».
        en = "[img]gfx/ui/events/event_26.png[/img]{%minstrel% the minstrel stands up, %their_minstrel% head cocked to a side, %their_minstrel% walk a shuffling amble, %their_minstrel% eyes affixed to %their_minstrel% own shadow upon the priory wall, every step %they_minstrel% takes drawing it smaller and smaller yet. %They_minstrel% stares at the shadow as though it were a body, and %their_minstrel% closing in on it was akin to that of solving who murdered it. Suddenly, %they_minstrel% bolts upright, hands to %their_minstrel% hips.%SPEECH_ON%By the gods, men, I've got it figured out! My shadow is an absolute womanizer! A scapegrace smellsmock. He's got a big hammer in his pants, and every woman's a nail! A philanderer, he is! And a drunk, a pitiful sot. And...and a thief! Filching crowns from the filthy, this he cannot resist. And a little prankster, a little rat filled with devilments. Just the other day, my shadow took a shit in %othersellsword%'s boot! I couldn't believe it!%SPEECH_OFF%%othersellsword% jumps to %their_otherbro% feet, knocking over the fire and spewing embers that seem to twirl and twist on the laughter of the men. %They_otherbro% comes forward.%SPEECH_ON%I knew that wasn't no farkin' dogshite you bastard! What sorta man shits in another man's boots!%SPEECH_OFF%The sellsword slips and falls which arises applause from the company, and the minstrel delicately prances away, %their_minstrel% shadow bidding goodbye with a kiss and wave.}"
        es = "[img]gfx/ui/events/event_26.png[/img]{%minstrel%, %art_minstrel% juglar, se levanta con la cabeza ladeada y paso torpe y arrastrado, los ojos fijos en su propia sombra sobre la pared del priorato; cada paso que da la hace más y más pequeña. Mira la sombra como si fuera un cadáver y acercarse a ella fuera como resolver quién la asesinó. De repente, se yergue de golpe, con las manos en las caderas.%SPEECH_ON%¡Por los dioses, muchachos, ya lo tengo! ¡Mi sombra es un mujeriego de cuidado! Un sinvergüenza salido. ¡Tiene un gran martillo en los pantalones y cada mujer es un clavo! ¡Un donjuán, eso es! Y un borracho, un triste beodo. Y... ¡y un ladrón! Birlarles coronas a los mugrientos, eso no lo puede resistir. Y un bromista, una ratita llena de diabluras. ¡El otro día, mi sombra cagó en la bota de %othersellsword%! ¡No me lo podía creer!%SPEECH_OFF%%othersellsword% se pone en pie de un salto, tirando el fuego y esparciendo brasas que parecen girar y retorcerse con las risas de los hombres. Se acerca.%SPEECH_ON%¡Sabía que eso no era ninguna jodida mierda de perro, bastardo! ¡Qué clase de hombre caga en las botas de otro hombre!%SPEECH_OFF%%Art_otherbro% mercenari%o_otherbro% resbala y cae, lo que arranca aplausos de la compañía, y %art_minstrel% juglar se aleja dando delicados saltitos, mientras su sombra se despide con un beso y un gesto de la mano.}"
    }
    // context: shadow_dissection_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_51.png[/img]{As the men bandy back and forth making shadows, %killer%, the alleged killer on the run, walks up to the camp carrying armfuls of jewelry and other goods, their metals glistening with crimson sheens. %They're_killer% murmuring to %themselves_killer%, but then suddenly stops and looks at the rest of the company.%SPEECH_ON%Oh. You guys are still awake? I was just, uh, out. Doing things.%SPEECH_OFF%There's blood on %their_killer% face and caked under %their_killer% fingernails. Sensing %themselves_killer% in trouble, %they_killer% drops the goods.%SPEECH_ON%These are for the company, of course. I'm just so, uh, thankful that you all took me in. Thought I'd repay the favor, you know?%SPEECH_OFF%The men stare at the goods. You ask the %person_killer% if someone is going to come looking for those items. %They_killer% grins.%SPEECH_ON%No sir, of course not. I made sure of it. Oh captain, did I make sure of it, heh, heh, heh.%SPEECH_OFF%You tell the %person_killer% to put the goods into inventory, but to be sure to clean them up first. As %they_killer% walks away, the rest of the men quietly exchange glances. There's no more shadow games left to play, it seems.}"
        es = "[img]gfx/ui/events/event_51.png[/img]{Mientras los hombres se turnan haciendo sombras, %killer%, %art_killer% presunt%o_killer% asesin%o_killer% en fuga, llega al campamento con los brazos llenos de joyas y otros bienes, cuyos metales relucen con destellos carmesíes. Murmura para sus adentros, pero de repente se detiene y mira al resto de la compañía.%SPEECH_ON%Oh. ¿Todavía están despiertos? Solo estaba, eh, fuera. Haciendo cosas.%SPEECH_OFF%Tiene sangre en la cara y reseca bajo las uñas. Al darse cuenta de que se ha metido en un lío, suelta los bienes.%SPEECH_ON%Son para la compañía, por supuesto. Es que estoy tan, eh, agradecid%o_killer% de que me acogieran. Pensé en devolverles el favor, ¿saben?%SPEECH_OFF%Los hombres miran los bienes. Le preguntas %al_killer% %hombre_killer% si alguien vendrá a buscar esos objetos. Sonríe.%SPEECH_ON%No, señor, claro que no. Me aseguré de ello. Ay, capitán, vaya si me aseguré, je, je, je.%SPEECH_OFF%Le dices %al_killer% %hombre_killer% que guarde los bienes en el inventario, pero que se asegure de limpiarlos antes. Mientras se aleja, el resto de los hombres intercambian miradas en silencio. Parece que ya no quedan juegos de sombras.}"
    }
    // FILE: mod_legends\hooks\events\events\dlc8\strange_scribe_event.nut
    // context: strange_scribe_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_31.png[/img]{While in %townname%, you are approached by a person you had seen around one of the noblemen in the area. %They_dude% is wearing a black cloak and %they_dude% keeps %their_dude% face deep in the cowl. %They_dude% is the definition of suspicious. Naturally, %anatomist% the anatomist sets %their_anatomist% eyes on %them_dude% as though %they_dude% were one of %their_anatomist% objects of scientific observation. The %person_dude% bows.%SPEECH_ON%I have come with great respect for the work you do, %anatomist%. We have read many of your texts.%SPEECH_OFF%You put a hand on your sword and wait to see where this is going. The %person_dude% continues.%SPEECH_ON%We would like to invite you for a meal and to discuss matters of bodily import a little more...deeply.%SPEECH_OFF%Stepping between them, you ask who this 'we' is. The %person_dude% states that %they_dude% is with a group of scribes and scholars who study matters of the human body, as well as the bodies who have comported themselves well to the nature of their bestial tasks, which is to say they study the world's monsters.%SPEECH_ON%We, of course, have a particular interest in the beasts which are man himself...after he has lost what he himself is.%SPEECH_OFF%With so much intrigue flitting about, you're not surprised that the anatomist wishes to go with the strange scribe.}"
        es = "[img]gfx/ui/events/event_31.png[/img]{Mientras estás en %townname%, se te acerca una persona a la que habías visto rondando a uno de los nobles de la zona. Lleva un manto negro y mantiene el rostro hundido en la capucha. Es la definición misma de sospechos%o_dude%. Naturalmente, %anatomist%, %art_anatomist% anatomista, fija la vista en %el_dude% como si fuera uno de sus objetos de observación científica. %Art_dude% %hombre_dude% hace una reverencia.%SPEECH_ON%He venido con gran respeto por el trabajo que realizas, %anatomist%. Hemos leído muchos de tus textos.%SPEECH_OFF%Apoyas la mano en la espada y esperas a ver adónde lleva esto. %Art_dude% %hombre_dude% continúa.%SPEECH_ON%Nos gustaría invitarte a una cena y discutir asuntos de importancia corporal de una manera algo más... profunda.%SPEECH_OFF%Te interpones entre ambos y preguntas quién es ese \"nosotros\". %Art_dude% %hombre_dude% afirma que forma parte de un grupo de escribas y eruditos que estudian asuntos del cuerpo humano, así como los cuerpos que se han adaptado bien a la naturaleza de sus tareas bestiales; es decir, estudian a los monstruos del mundo.%SPEECH_ON%Nosotros, por supuesto, tenemos un interés particular en las bestias que son el propio hombre... después de que ha perdido lo que él mismo es.%SPEECH_OFF%Con tanta intriga en el aire, no te sorprende que %art_anatomist% anatomista quiera ir con %art_dude% extrañ%o_dude% escriba.}"
    }
    // context: strange_scribe_event.o.create.::Legends.Screens.hook()._screen.start._event.m.Dude.getBackground().m.RawDescription
    {
        // corrige base: «espada a sueldo» por «sellsword», que el corpus fija como «mercenario».
        en = "{%name% was found deploying %their% minstrel talents in street scamming. Vouched for by a fellow minstrel, %they% joined the %companyname% to seek out a life on the road. Hopefully the charlatan-turned-sellsword will be able to 'fake it til %they% makes it', as %they% likes to say a little too often.}"
        es = "{%name% fue encontrad%o% usando sus dotes de juglar para estafar en la calle. Con el aval de otro juglar, se unió a %companyname% en busca de una vida en los caminos. Con suerte, ahora que ha cambiado las estafas por la vida de mercenari%o%, podrá \"fingirlo hasta conseguirlo\", como le gusta decir un poco demasiado a menudo.}"
    }
    // context: strange_scribe_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «está claro que irá solo» invierte el sentido de «he sure as shit isn't going alone» (no irá solo) y además rebaja la crudeza.
        en = "[img]gfx/ui/events/event_31.png[/img]{If %anatomist% is going anywhere in this town, %they_anatomist% sure as shit isn't going alone. You tag along, your hand never leaving your sword. The strange %person_dude% invites you to a beautiful stone house, candlelight beaming from every window. Inside, you are quickly ushered to what should be a dinner table, but instead find slabbed across it a pale man whose skin is barely hanging on. The strange scribe bows like a chef who has delivered %their_dude% finest meal.%SPEECH_ON%We believe this is a wiederganger, a man who hath died yet walks again.%SPEECH_OFF%The strange scribe rolls up %their_dude% sleeve and holds it over the decrepit corpse. Its maw suddenly juts left to right, the jaw unhinged, its white eyes rolling. %anatomist% merely leans back and mentions that it is 'interesting.' The two begin to talk, while you nervously finger the hilt of your sword in case this 'wiederganger' takes an interest in escaping. When the two are finished, %anatomist% and the scribe take out quill pens and put their signatures in each other's tomes, all the while congratulating each other on their work.\n\nThe whole affair has you cringing, and you notice what looks like a bead of sweat on the wiederganger's brow, but before you can comment you are ushered out from the home. Whatever they discussed, the anatomist is renewed with energy. %They_anatomist% speaks gingerly.%SPEECH_ON%The creature was a fraud, of course, don't think I did not notice that. However, this has given me plenty insight into the inventive depths of the locals. There's something to be preened from such creativity, being that one's imagination draws surreptitiously from the sublime and real, and makes inferences on what it intuits yet knows not how to describe with scientific distinction. Even in the mire and fog of regional superstition and legerdemain I can make great advances.%SPEECH_OFF%Well, alright. You mention that you knew it was a fraud because the supposedly dead cretin was sweating. The anatomist nods, and says you might not have an eye for diagnostic inquiry, but the street smarts are well enough for perspicuous scrying. You simply nod, hoping %they_anatomist% meant well by whatever that means.}"
        es = "[img]gfx/ui/events/event_31.png[/img]{Si %anatomist% va a ir a alguna parte en esta ciudad, de ninguna puta manera va a ir sol%o_anatomist%. Te apuntas, sin apartar la mano de la espada. %Art_dude% extrañ%o_dude% %hombre_dude% te invita a una hermosa casa de piedra, con la luz de las velas brillando en cada ventana. Dentro, te conducen rápidamente a lo que debería ser una mesa de comedor, pero en su lugar encuentras tendido sobre ella a un hombre pálido cuya piel apenas se sostiene. %Art_dude% extrañ%o_dude% escriba hace una reverencia como un chef que acaba de servir su mejor plato.%SPEECH_ON%Creemos que esto es un wiederganger, un hombre que ha muerto y sin embargo vuelve a caminar.%SPEECH_OFF%%Art_dude% extrañ%o_dude% escriba se arremanga y pone el brazo sobre el cadáver decrépito. De repente, sus fauces se sacuden de un lado a otro, con la mandíbula desencajada y los ojos blancos girando. %anatomist% se limita a echarse hacia atrás y comenta que es \"interesante\". Los dos se ponen a hablar, mientras tú toqueteas con nerviosismo la empuñadura de la espada por si a este \"wiederganger\" le da por escapar. Cuando terminan, %anatomist% y %art_dude% escriba sacan plumas y firman cada uno en el tomo del otro, sin dejar de felicitarse mutuamente por su trabajo.\n\nTodo el asunto te da escalofríos, y notas lo que parece una gota de sudor en la frente del wiederganger, pero antes de que puedas decir nada te hacen salir de la casa. Sea lo que sea lo que discutieron, %art_anatomist% anatomista rebosa energía renovada. Habla con cautela.%SPEECH_ON%La criatura era una farsa, por supuesto, no creas que no me di cuenta. Sin embargo, esto me ha dado mucha perspectiva sobre las profundidades inventivas de los lugareños. Hay algo que se puede extraer de tanta creatividad, ya que la imaginación de uno se nutre subrepticiamente de lo sublime y lo real, e infiere lo que intuye pero no sabe describir con distinción científica. Incluso en el fango y la niebla de la superstición regional y el ilusionismo puedo hacer grandes avances.%SPEECH_OFF%Bueno, está bien. Comentas que sabías que era una farsa porque el cretino supuestamente muerto estaba sudando. %Art_anatomist% anatomista asiente y dice que puede que no tengas ojo para la indagación diagnóstica, pero que tu astucia callejera basta para una perspicaz observación. Te limitas a asentir, esperando que lo dijera con buena intención, signifique eso lo que signifique.}"
    }
    // context: strange_scribe_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_97.png[/img]{You agree to let the anatomist go, but you're coming along. This draws the attention of the strange scribe. %They_dude% seems reluctant about the matter now, having lost the energy which %they_dude% had in his initial invitations. As you round a corner, %they_dude% makes a sharp birdlike call, and a few men step out and you draw your sword and push %anatomist% back. One makes an attempt to attack. You're not in much fighting shape these days, but with a quick parry you knock him back and dissuade him of further attack. The scribe and %their_dude% minions then depart in a hurry, saying you're not worth it. %anatomist% looks disappointed.%SPEECH_ON%Ah, I see. So it was a scam, an endeavor that was as creative as it was criminal.%SPEECH_OFF%Looking around, you realize that your coinpurse is gone. You look over just in time to see a child holding it, then throwing it skyward to be caught by another child hanging on some gutters. %anatomist% stands beside you, looking up, fascinated by the engineering effort put in by the scamps.%SPEECH_ON%It seems where one offender fails, another may take his place. So it is that by attrition the criminals may succeed. Interesting.%SPEECH_OFF%The anatomist suddenly realizes %they_anatomist% also is a bit light on the hip and sees that %their_anatomist% purse, too, has been yoinked. You look past %them_anatomist% to see yet another child running off like a rat with its cheese. Another child runs past and tries to pickpocket you when there's nothing left to steal. Angered by his empty hands, the boy yells back.%SPEECH_ON%Get a job!%SPEECH_OFF%Sighing, you say it's probably time to head back to the company.}"
        es = "[img]gfx/ui/events/event_97.png[/img]{Aceptas dejar ir a %art_anatomist% anatomista, pero tú vas con %el_anatomist%. Esto llama la atención %del_dude% extrañ%o_dude% escriba. Ahora parece reaci%o_dude% al asunto, pues ha perdido la energía que tenía en sus invitaciones iniciales. Al doblar una esquina, emite un agudo silbido como de pájaro y unos cuantos hombres salen al paso; desenvainas la espada y empujas a %anatomist% hacia atrás. Uno intenta atacar. No estás en gran forma para pelear estos días, pero con una rápida parada lo haces retroceder y le quitas las ganas de seguir. %Art_dude% escriba y sus secuaces se marchan a toda prisa, diciendo que no vales la pena. %anatomist% parece decepcionad%o_anatomist%.%SPEECH_ON%Ah, ya veo. Así que era una estafa, una empresa tan creativa como criminal.%SPEECH_OFF%Al mirar a tu alrededor, te das cuenta de que tu bolsa de monedas ha desaparecido. Miras justo a tiempo de ver a un niño que la sostiene y la lanza al aire para que la atrape otro niño colgado de unas canaletas. %anatomist% está a tu lado, mirando hacia arriba, fascinad%o_anatomist% por el esfuerzo de ingeniería de los pilluelos.%SPEECH_ON%Parece que donde un delincuente falla, otro puede ocupar su lugar. Así es como, por desgaste, los criminales pueden triunfar. Interesante.%SPEECH_OFF%De repente, %art_anatomist% anatomista se da cuenta de que también le pesa menos la cadera y ve que su bolsa también ha volado. Miras más allá de %el_anatomist% y ves a otro niño huyendo como una rata con su queso. Otro niño pasa corriendo e intenta robarte cuando ya no queda nada que robar. Enfadado por quedarse con las manos vacías, el chico te grita.%SPEECH_ON%¡Búscate un trabajo!%SPEECH_OFF%Suspirando, dices que probablemente es hora de volver con la compañía.}"
    }
    // context: strange_scribe_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_51.png[/img]{You agree to let %anatomist% and the strange scribe talk, but before you can even head down the street %minstrel% the minstrel steps forth, grinning and pointing.%SPEECH_ON%%fakescribe%! What in the hells are you doing these days? This some new scam you've got up your sleeve, huh?%SPEECH_OFF%The strange scribe clears %their_dude% throat. %They_dude% throws %their_dude% hands out, and clears %their_dude% throat again, %they_dude% seems ready to speak deeply to some subject, but then sighs and throws back %their_dude% cloak. A youngish and not at all scholarly looking fellow is revealed. %They_dude% shakes %their_dude% head.%SPEECH_ON%Life's been rough in the big city, %minstrel%. How are you doing?%SPEECH_OFF%The two chat for a time while you and %anatomist% look on bewildered. Eventually, the two minstrels turn to you, %minstrel% leading the way.%SPEECH_ON%Captain, this is %fakescribe%. %They're_dude% on hard times out here in %townname%. What say %they_dude% come along into the %companyname%? %They're_dude% a lot like me, a shitass fighter, but a %person_dude% of spunk, of moxy, a %person_dude% who has what it takes if merely given the time to find it, especially if there's a woman involved.%SPEECH_OFF%%fakescribe% shakes %their_dude% head.%SPEECH_ON%Ehem, ehh, with them I never, uh, find it.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_51.png[/img]{Aceptas dejar que %anatomist% y %art_dude% extrañ%o_dude% escriba hablen, pero antes de que puedas siquiera echar a andar calle abajo, %minstrel%, que se gana la vida como juglar, da un paso adelante, sonriendo y señalando.%SPEECH_ON%¡%fakescribe%! ¿Qué demonios andas haciendo estos días? ¿Es alguna nueva estafa que te guardas bajo la manga, eh?%SPEECH_OFF%%Art_dude% extrañ%o_dude% escriba se aclara la garganta. Extiende las manos y vuelve a aclararse la garganta; parece list%o_dude% para disertar a fondo sobre algún tema, pero entonces suspira y se echa atrás la capa. Queda al descubierto %un_dude% %hombre_dude% más bien joven y sin pinta alguna de erudit%o_dude%. Niega con la cabeza.%SPEECH_ON%La vida ha sido dura en la gran ciudad, %minstrel%. ¿Cómo te va a ti?%SPEECH_OFF%Charlan un rato mientras miras desconcertado junto a %anatomist%. Al final, se vuelven hacia ti, con %minstrel% llevando la voz cantante.%SPEECH_ON%Capitán, te presento a %fakescribe%. Está pasando por tiempos difíciles aquí en %townname%. ¿Qué te parece si se une a %companyname%? Se parece mucho a mí: pelea como el culo, pero es %un_dude% %hombre_dude% con chispa, con agallas, %un_dude% %hombre_dude% que tiene lo que hace falta si se le da tiempo para encontrarlo, sobre todo si hay una mujer de por medio.%SPEECH_OFF%%fakescribe% niega con la cabeza.%SPEECH_ON%Ejem, eh, con ellas nunca, eh, lo encuentro.%SPEECH_OFF%}"
    }
    // context: strange_scribe_event.o.create.::Legends.Screens.hook()._screen.Options[0].Text
    {
        en = "Sure, %they_dude% can come along."
        es = "Claro, puede venir."
    }
    // context: strange_scribe_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_51.png[/img]{You take the minstrel along free of any hiring charges. %anatomist% the anatomist looks a little sullen about the whole affair, saying that %they_anatomist% longs for rare knowledge, yet all this world seems to have on offer are scams and falsities. Smiling, you tell %them_anatomist% to consider this street knowledge. %They_anatomist% smiles as well.%SPEECH_ON%Yes, perhaps I should acquire more of these...street smarts.%SPEECH_OFF%No, street knowledge. 'Street smarts' sounds ridiculous.}"
        es = "[img]gfx/ui/events/event_51.png[/img]{Sumas a la compañía a quien se hacía pasar por escriba, sin coste alguno de contratación. %anatomist%, %art_anatomist% anatomista, parece algo enfurruñad%o_anatomist% con todo el asunto; dice que anhela conocimientos excepcionales, pero que lo único que este mundo parece ofrecer son estafas y falsedades. Sonriendo, le dices que lo considere conocimiento de la calle. También sonríe.%SPEECH_ON%Sí, quizá debería adquirir más de esta... astucia callejera.%SPEECH_OFF%No, conocimiento de la calle. \"Astucia callejera\" suena ridículo.}"
    }
    // context: strange_scribe_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «No sabes a quién o qué confiar» es agramatical (de qué ni de quién fiarte); «cuchilla» por «knife» (cuchillo); «desangrándose por todas partes» pierde «all over your boots».
        en = "[img]gfx/ui/events/event_12.png[/img]{You agree to let the anatomist and strange scribe have their conversations, yourself tagging along. The %person_dude% takes you to the head of an alleyway which is considerably suspicious. %They_dude% turns around with a wild grin on %their_dude% face and %they_dude% slowly starts to unsheathe a dagger from %their_dude% sleeve, and then suddenly a knife stabs through %their_dude% face, a glimmer of steel winking in %their_dude% mouth. As %they_dude% gargles, another knife comes in and cuts %their_dude% throat in a quick slash. %killer%, the alleged killer on the run, appears from the alleyway.%SPEECH_ON%'Ello captain and, eh, anatomist? Mortician? This 'ere was a murderer. And an encroacher, encroaching on my...uh...affairs.%SPEECH_OFF%%They_killer% drops the body to the ground and starts stripping away the cloak to reveal that this supposed scribe was in fact well armed and armored. The killer cuts off one of the ears and pockets it, then nods.%SPEECH_ON%Hey, looks like we got some free gear, eh? We should probably hide the body though. This %person_dude% puts up a great front of eminence and some may find %their_dude% absence worth investigation.%SPEECH_OFF%You know not what or who to trust on the matter, but a dead body bleeding out all over your boots tends to look bad no matter the circumstances. You hide the body, after happily stripping it the gear from it, of course. %anatomist% seems leery of %killer%. %They_anatomist% mentions that the killer on the run's tone of voice seemed to be one of immediately produced conjecture or, as the layman puts it, 'acting.' Seeing as how what's done is done, you simply tell %them_anatomist% to help carry the gear back to inventory.}"
        es = "[img]gfx/ui/events/event_12.png[/img]{Aceptas que %art_anatomist% anatomista y %art_dude% extrañ%o_dude% escriba tengan sus conversaciones, y te apuntas tú también. %Art_dude% %hombre_dude% te lleva a la entrada de un callejón de lo más sospechoso. Se da la vuelta con una sonrisa salvaje en la cara y empieza a sacar despacio una daga de la manga, y entonces, de repente, un cuchillo le atraviesa la cara y un destello de acero asoma en su boca. Mientras borbotea, otro cuchillo aparece y le corta el cuello de un tajo rápido. %killer%, %art_killer% supuest%o_killer% asesin%o_killer% en fuga, sale del callejón.%SPEECH_ON%Hola, capitán y, eh, ¿anatomista? ¿Funerari%o_anatomist%? %Ese_dude% de aquí era %un_dude% asesin%o_dude%. Y %un_dude% intrus%o_dude%, que se metía en mis... eh... asuntos.%SPEECH_OFF%Deja caer el cuerpo al suelo y empieza a quitarle la capa, dejando ver que %art_dude% supuest%o_dude% escriba iba en realidad bien armad%o_dude% y con buena armadura. %Art_killer% asesin%o_killer% le corta una oreja, se la mete en el bolsillo y asiente.%SPEECH_ON%Oye, parece que tenemos equipo gratis, ¿eh? Aunque deberíamos esconder el cuerpo. %Ese_dude% %hombre_dude% aparentaba mucha eminencia, y a alguien podría parecerle que su ausencia merece una investigación.%SPEECH_OFF%No sabes de qué ni de quién fiarte en este asunto, pero un cadáver desangrándose sobre tus botas suele quedar mal, sean cuales sean las circunstancias. Escondes el cuerpo, no sin antes despojarlo alegremente del equipo, por supuesto. %anatomist% parece desconfiar de %killer%. Comenta que el tono de voz de %killer% parecía el de una conjetura producida al instante o, como dirían los profanos, \"actuación\". Como lo hecho, hecho está, simplemente le dices que ayude a llevar el equipo al inventario.}"
    }
    // context: strange_scribe_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_31.png[/img]{You say the situation is far too suspicious to risk. %anatomist% says that all knowledge seems suspicious to the laity. You tell %them_anatomist% that this 'layman' knows enough to smell a rat and that is that. The anatomist is upset, but you'd rather %they_anatomist% be agitated than dead.}"
        es = "[img]gfx/ui/events/event_31.png[/img]{Dices que la situación es demasiado sospechosa como para arriesgarse. %anatomist% comenta que todo conocimiento parece sospechoso para los laicos. Le dices que este \"laico\" sabe lo suficiente como para oler algo raro, y punto. %Art_anatomist% anatomista está molest%o_anatomist%, pero prefieres que esté alterad%o_anatomist% a que esté muert%o_anatomist%.}"
    }
    // FILE: mod_legends\hooks\events\events\dogfighting_event.nut
    // en = "Alright, but I'm going with you."
    // en base_es
    // en = "That's not going to happen."
    // en base_es
    // context: dogfighting_event.o.create.s.Text
    {
        // corrige base: «un rápido puntapié los separas» debe ser «los separa»; «adelantense» sin tilde; «sacrifiquen a ese perro» malinterpreta «put that dog back down» (devolverlo a la arena para que siga la pelea); «sopla un silbato» y «cruje sus nudillos» son calcos.
        en = "[img]gfx/ui/events/event_20.png[/img]You throw your betting ticket into the dirt.%SPEECH_ON%Fark it.%SPEECH_OFF%With a quick leap you jump the fence and run into the arena. %doghandler% is right behind you. The two dogs are still at it, but a swift kick gets them separated. The houndmaster quickly grabs %wardog% and lifts him out of danger. The crowd boos and bottles and glasses start flying in. A man blows a whistle that silences them all. He steps into the arena.%SPEECH_ON%These people paid to see blood. If you are not going to give it to them, then you best find another way to pay. How about two hundred crowns? That or you just go ahead and put that dog back down.%SPEECH_OFF%The crowd is cracking their knuckles and drawing out knives, chains, and other crude weaponry."
        es = "[img]gfx/ui/events/event_20.png[/img]Tiras tu boleto de apuesta al suelo.%SPEECH_ON%Al diablo con esto.%SPEECH_OFF%De un salto rápido, saltas la valla y entras corriendo en la arena. %doghandler% está justo detrás de ti. Los dos perros siguen a lo suyo, pero una patada rápida los separa. %doghandler% agarra enseguida a %wardog% y lo pone a salvo. La multitud abuchea y empiezan a volar botellas y vasos. Un hombre toca un silbato que los hace callar a todos. Entra en la arena.%SPEECH_ON%Esta gente pagó para ver sangre. Si no se la van a dar, más vale que encuentren otra forma de pagar. ¿Qué tal doscientas coronas? Eso, o vuelvan a soltar a ese perro en la arena.%SPEECH_OFF%La multitud hace crujir los nudillos y saca cuchillos, cadenas y otras armas rudimentarias."
    }
    // FILE: mod_legends\hooks\events\events\drunkard_loses_stuff_event.nut
    // context: drunkard_loses_stuff_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]While taking inventory last night, %drunkard% had a little too much to drink and ended up losing %item%!\n\nYou've had the mercenary brought to you, and swaying while speaking, the drunkard still reeks of alcohol. %drunkard% hiccups while trying to explain what happened, but the best defense they can muster is collapsing to the ground in a drunken heap. %drunkard% laughs and laughs, but you see nothing funny about this. %otherguy% asks what you want to do with this mess."
        es = "[img]gfx/ui/events/event_05.png[/img]¡Anoche, mientras hacía inventario, %drunkard% bebió más de la cuenta y acabó perdiendo %item%!\n\nHas hecho que te traigan a %drunkard%, que se tambalea al hablar y todavía apesta a alcohol. Hipa mientras intenta explicar lo que pasó, pero lo mejor que consigue como defensa es desplomarse en el suelo, víctima de la borrachera. %drunkard% se ríe y se ríe, pero tú no le ves la gracia. %otherguy% te pregunta qué quieres hacer con este desastre."
    }
    // context: drunkard_loses_stuff_event.o.create.s.Options[2].Text
    {
        en = "If %drunkard% won't put down the drink I'll do it. Get the whip."
        es = "Si %drunkard% no suelta la bebida, se la haré soltar yo. Traigan el látigo."
    }
    // context: drunkard_loses_stuff_event.o.create.s.Options.push().Text
    {
        en = "Sober them up, we will talk it out"
        es = "Que se despeje y lo hablaremos"
    }
    // context: drunkard_loses_stuff_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]The drunkard falls on their back, staring aimlessly at the sky. You see tears in their eyes and %drunkard% covers their face, trying to hide the shame. There is something about their past that you do not know, perhaps something that led to the drink in the first place. You can't possibly punish someone for what they cannot control."
        es = "[img]gfx/ui/events/event_05.png[/img]%drunkard% cae de espaldas, mirando sin rumbo al cielo. Ves lágrimas en sus ojos y se cubre la cara, tratando de ocultar la vergüenza. Hay algo de su pasado que desconoces, tal vez algo que le hizo empezar a beber. No puedes castigar a nadie por lo que no puede controlar."
    }
    // context: drunkard_loses_stuff_event.o.create.s.Options[0].Text
    {
        en = "Get this drunkard out of my sight."
        es = "Quítenme de la vista a esta cuba."
    }
    // context: drunkard_loses_stuff_event.o.create.s.Text
    {
        // corrige base: «lana crujiente» por «crusty» (costrosa); «Le levantas la mano» por «You hold your hand up» (levantas la mano); en la súplica faltaba el «don't» («Yo -hic- no...»); «Crujiendo los nudillos» es calco (haciendo crujir).
        en = "[img]gfx/ui/events/event_05.png[/img]You grab a shovel, a bucket, and a crusty bit of wool wrapped around a stick.%SPEECH_ON%Latrine duty. One month.%SPEECH_OFF%The drunkard looks at you and with wide eyes makes something of a plead.%SPEECH_ON%Sir, please. I -hic- don't... the company, sir, they -hic-...%SPEECH_OFF%You hold your hand up, stopping the protestations. The mercenary sways and tries to stand straight. Cracking your knuckles, you explain the other option.%SPEECH_ON%If you do not wish to have these duties, then we can expedite your punishment by the whip. Which would you prefer?%SPEECH_OFF%Amazingly, the drunkard actually spends a few moments thinking it over, eyebrows rising and falling and a grimace passing from side of their mouth to the other with a stream of realizations that there's no way out of it. Finally, %drunkard% submits to the smellier of the two options. Quite shocked to see the choice even took any time at all, you begin to wonder just how bad the company's diet has gotten."
        es = "[img]gfx/ui/events/event_05.png[/img]Agarras una pala, un cubo y un pedazo de lana costrosa enrollado en un palo.%SPEECH_ON%Turno de letrinas. Un mes.%SPEECH_OFF%%drunkard% te mira y, con los ojos muy abiertos, te dirige algo parecido a una súplica.%SPEECH_ON%Señor, por favor. Yo -hic- no... la compañía, señor, ellos -hic-...%SPEECH_OFF%Levantas la mano y cortas sus protestas. Se tambalea mientras intenta enderezarse. Haciendo crujir los nudillos, le explicas la otra opción.%SPEECH_ON%Si no deseas cumplir con estas tareas, podemos abreviar tu castigo con el látigo. ¿Qué prefieres?%SPEECH_OFF%Asombrosamente, se toma de verdad unos momentos para pensarlo: las cejas suben y bajan, y una mueca le pasa de un lado de la boca al otro a medida que va comprendiendo que no tiene escapatoria. Al final, %drunkard% se somete a la más maloliente de las dos opciones. Te sorprende tanto que la elección le haya llevado algún tiempo que empiezas a preguntarte lo mala que se ha vuelto la dieta de la compañía."
    }
    // context: drunkard_loses_stuff_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_38.png[/img]The mercenary was driven to the drink, so you plan to drive it out of them. You order a flogging. A few battle brothers drag the drunk away, hiccupping and moaning, head bouncing aloll, seemingly unaware of what is going on. They string the drunkard up beneath a tree and shred the clothes off their back. After a few lashings, the drunkard wakes up to the punishment and begins crying out uncontrollably, beggin for mercy in a tongue blurred by drink and pain, like someone fighting for freedom from a nightmare. One thing is for certain: they'll never make this mistake again."
        es = "[img]gfx/ui/events/event_38.png[/img]Algo arrastró a la bebida a este miembro de la compañía, y tú piensas sacársela del cuerpo. Ordenas una flagelación. Unos cuantos hermanos de armas se llevan a rastras a quien ha bebido de más, que hipa y gime con la cabeza bamboleándose, al parecer sin enterarse de lo que ocurre. Le atan las muñecas a un árbol y le arrancan la ropa de la espalda. Tras unos cuantos latigazos, con el castigo se le pasa la borrachera de golpe y empieza a gritar sin control, suplicando clemencia con la lengua trabada por la bebida y el dolor, como quien lucha por librarse de una pesadilla. Una cosa es segura: no volverá a cometer este error."
    }
    // context: drunkard_loses_stuff_event.o.create.s.Options[0].Text
    {
        en = "That'll teach 'em."
        es = "Así aprenderá."
    }
    // en = "<addict:str> receives an injury"
    // en base_es
    // en = "<drunkard:str> is no longer a drunkard"
    // en base_es
    // en = "Was flogged on your orders"
    // en base_es
    // en = "Appalled by your order to have <addict:str> flogged"
    // en base_es
    // context: drunkard_loses_stuff_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_23.png[/img]The mercenary's drinking must be a result of something. You set out to find out what the cause was. You give some water and food to the drunkard and have them exercise until they sober up. You {walk a short way | sit for a time | wander around the camp perimeter | sit in your tent | sit around the fire after others fall asleep | walk a long time through the surrounding lands | stare at the sky together | gaze into the fire} and talk on the {issues | memories | concerns | worries | fears} that {plague | haunt | hunt | pursue | govern | tarry | gnaw at | consume} them, %drunkard% tells you their story of {family abuse | lost love | tyrantical injustice | infidelity | brutal employment | childhood neglect | a wartorn hometown | natural disaster | family tradgedy | a witch curse | the cruelty of the gods | a lost child | a backstabbing business parter | abandonment | loss | tragedy | brutality}. You talk for a time about not letting the past {influence | govern | control | infect | overcome | outweigh | shade | color | undo | replace | undermine} the future. Something stirs deep inside them, and they swear they'll never make this mistake again."
        es = "[img]gfx/ui/events/event_23.png[/img]Tanta bebida tiene que deberse a algo. Te propones averiguar la causa. Le das agua y comida y le haces hacer ejercicio hasta que se le pasa la borrachera. {Dan un breve paseo | Se sientan un rato | Recorren el perímetro del campamento | Se sientan en tu tienda | Se sientan junto al fuego cuando los demás ya duermen | Caminan largo rato por los alrededores | Se quedan mirando el cielo | Contemplan el fuego} y hablan de {los problemas | los recuerdos | las preocupaciones | las inquietudes | los miedos} que {atormentan su vida | rondan su mente | le dan caza | persiguen sus pasos | gobiernan sus actos | no se apartan de su lado | carcomen su alma | consumen sus días}; %drunkard% te cuenta su historia de {maltrato familiar | un amor perdido | una injusticia tiránica | infidelidad | un trabajo brutal | abandono en la infancia | un pueblo natal asolado por la guerra | un desastre natural | una tragedia familiar | una maldición de bruja | la crueldad de los dioses | un hijo perdido | un socio traicionero | abandono | pérdida | tragedia | brutalidad}. Hablan un rato de no dejar que el pasado {influya en | gobierne | controle | infecte | venza | pese más que | ensombrezca | tiña | deshaga | reemplace | socave} el futuro. Algo se remueve en lo más hondo de su ser, y jura que nunca volverá a cometer este error."
    }
    // context: drunkard_loses_stuff_event.o.create.m.Screens.push().Options.Text
    {
        en = "We may have found the cause"
        es = "Puede que hayamos dado con la causa"
    }
    // context: drunkard_loses_stuff_event.o.create.m.Screens.push().start.List.push().text
    {
        // text = _event.m.Drunkard.getName() + " is hungover"
        mode = "pattern"
        en = "<name:str> is hungover"
        es = "<name> tiene resaca"
    }
    // context: drunkard_loses_stuff_event.o.create.m.Screens.push().start._event.m.Drunkard.worsenMood()
    {
        en = "Relived the past and realised the error of their ways"
        es = "Revivió el pasado y se dio cuenta de sus errores"
    }
    // context: drunkard_loses_stuff_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_23.png[/img]The mercenary's drinking must be a result of something. You set out to find out what the cause was. You give some water and food to the drunkard and have them excercise until they sober up. You {walk a short way | sit for a time | wander around the camp perimeter | sit in your tent | sit around the fire after others fall asleep | walk a long time through the surrounding lands | stare at the sky together | gaze into the fire} and talk on the {issues | memories | concerns | worries | fears} that {plague | haunt | hunt | pursue | govern | tarry | gnaw at | consume} them, %drunkard% tells you their story of {family abuse | lost love | tyrantical injustice | infidelity | brutal employment | childhood neglect | a wartorn hometown | natural disaster | family tradgedy | a witch curse | the cruelty of the gods | a lost child | a backstabbing business parter | abandonment | loss | tragedy | brutality | hopelessness | tyrany | injustice | unrequited love | unfulfilled ambition}. You talk for a time about not letting the past {influence | govern | control | infect | overcome | outweigh | shade | color | undo | replace | undermine} the future. Despite the in depth conversation, you fear the issue is not yet resolved."
        es = "[img]gfx/ui/events/event_23.png[/img]Tanta bebida tiene que deberse a algo. Te propones averiguar la causa. Le das agua y comida y le haces hacer ejercicio hasta que se le pasa la borrachera. {Dan un breve paseo | Se sientan un rato | Recorren el perímetro del campamento | Se sientan en tu tienda | Se sientan junto al fuego cuando los demás ya duermen | Caminan largo rato por los alrededores | Se quedan mirando el cielo | Contemplan el fuego} y hablan de {los problemas | los recuerdos | las preocupaciones | las inquietudes | los miedos} que {atormentan su vida | rondan su mente | le dan caza | persiguen sus pasos | gobiernan sus actos | no se apartan de su lado | carcomen su alma | consumen sus días}; %drunkard% te cuenta su historia de {maltrato familiar | un amor perdido | una injusticia tiránica | infidelidad | un trabajo brutal | abandono en la infancia | un pueblo natal asolado por la guerra | un desastre natural | una tragedia familiar | una maldición de bruja | la crueldad de los dioses | un hijo perdido | un socio traicionero | abandono | pérdida | tragedia | brutalidad | desesperanza | tiranía | injusticia | un amor no correspondido | una ambición frustrada}. Hablan un rato de no dejar que el pasado {influya en | gobierne | controle | infecte | venza | pese más que | ensombrezca | tiña | deshaga | reemplace | socave} el futuro. Pese a lo profundo de la conversación, temes que el problema aún no esté resuelto."
    }
    // context: drunkard_loses_stuff_event.o.create.m.Screens.push().Options.Text
    {
        en = "This is not over."
        es = "Esto no ha terminado."
    }
    // context: drunkard_loses_stuff_event.o.create.m.Screens.push().start._event.m.Drunkard.worsenMood()
    {
        en = "Lost an item and relived the past"
        es = "Perdió un objeto y revivió el pasado"
    }
    // FILE: mod_legends\hooks\events\events\education_event.nut
    // context: education_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_15.png[/img]During your travels, %scholar% has taken some interest in %dumbguy%\'s intellectual shortcomings. %scholar_short% says that, with some time, %they_scholar% could teach the %person_dumbguy% a thing or two. %dumbguy_short% can put one foot in front of the other - and sometimes quite confidently - but you think that\'s about where %their_dumbguy% aptitude for all things comes to an end. Not only that, but %scholar_short% has gotten easily frustrated in the past. Teaching the dumb %sibling_dumbguy% might just be an exercise in self-inflating %their_scholar% own ego.";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_15.png[/img]During your travels, %scholar% has taken some interest in %dumbguy%'s intellectual shortcomings. %scholar_short% says that, with some time, %they_scholar% could teach the %person_dumbguy% a thing or two. %dumbguy_short% can put one foot in front of the other - and sometimes quite confidently - but you think that's about where %their_dumbguy% aptitude for all things comes to an end. Not only that, but %scholar_short% has gotten easily frustrated in the past. Teaching the dumb %sibling_dumbguy% might just be an exercise in self-inflating %their_scholar% own ego."
        es = "[img]gfx/ui/events/event_15.png[/img]Durante tus viajes, %scholar% se ha interesado por las carencias intelectuales de %dumbguy%. %scholar_short% dice que, con algo de tiempo, podría enseñarle un par de cosas %al_dumbguy% %hombre_dumbguy%. %dumbguy_short% sabe poner un pie delante del otro, y a veces con bastante aplomo, pero crees que ahí es más o menos donde se acaban sus aptitudes para todo lo demás. Y no solo eso: %scholar_short% se ha frustrado con facilidad en el pasado. Enseñar %al_dumbguy% herman%o_dumbguy% tont%o_dumbguy% bien podría no ser más que un ejercicio para inflar su propio ego."
    }
    // context: education_event.o.create.s.Options[0].Text
    {
        // corrige base: "que" es interrogativo indirecto y lleva tilde: "Veamos qué puedes enseñarle."
        en = "See what you can teach %them_dumbguy%."
        es = "Veamos qué puedes enseñarle."
    }
    // context: education_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_15.png[/img]{You come across %scholar% and %dumbguy% staring at a patch of dirt. Along the brown canvas you see that %scholar_short% has drawn geometric shapes, letters, numbers, and what looks like constellations. It appears that they\'ve been at this for hours now. \n\nA teaching stick in hand, %scholar% madly points at one of the star clusters and demands to know what it is. %dumbguy%, with a pained expression, guesses a sheep. %scholar% snaps the teaching stick in half and kicks dirt all over %their_scholar% drawings. It\'s a horse! A horse! %scholar% sighs heavily before marching off to the beat of endless profanity. Personally, you thought it was a crab. | You find %scholar% standing over %dumbguy%. Count the beetles, don\'t smash them, the learned %person_scholar% says with exasperation. %dumbguy% looks down at %their_dumbguy% beetle-juiced hands where {fragments of insect carapaces | carapaces of once-insects} dot %their_dumbguy% flesh. %They_dumbguy% nods, understandingly, and turns to pulling the beetles\' legs off instead. %scholar% lets out a string of swears you\'ve never heard in your life. | You find %scholar% and %dumbguy% yelling at one another. It appears they\'re at a very red-faced crossroads. %dumbguy_short% says %they_dumbguy% doesn\'t care if %they're_dumbguy% dumb, and the %scholar_short% argues that every man should be learned. Well it appears %dumbguy_short% would prefer to be left to %their_dumbguy% devices for %they_dumbguy% shows %scholar_short% %their_dumbguy% back as %they_dumbguy% walks away. Guess that\'s the end of the lesson for both of them. | You find %dumbguy% squatting beside a creek, staring at %themselves_dumbguy% in the shimmering reflection. %They_dumbguy% must have been at it for a while now for %they're_dumbguy% showing signs of sunburn. You ask if everything is alright, to which %they_dumbguy% explains that %they_dumbguy% is not \'getting it\' with %scholar%\'s teachings, and that %scholar% nearly went mad today before finally giving up on the venture. You explain that %dumbguy% doesn\'t have to be smart, %they_dumbguy% just needs to know how to swing a sword and shoot a bow. That\'s what you hired %them_dumbguy% for, after all. The %person_dumbguy% tries to hide a smile, but the running water betrays %them_dumbguy%. You take %them_dumbguy% back to camp where you then tell %scholar% to lay off for a while.}";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_15.png[/img]{You come across %scholar% and %dumbguy% staring at a patch of dirt. Along the brown canvas you see that %scholar_short% has drawn geometric shapes, letters, numbers, and what looks like constellations. It appears that they've been at this for hours now. \n\nA teaching stick in hand, %scholar% madly points at one of the star clusters and demands to know what it is. %dumbguy%, with a pained expression, guesses a sheep. %scholar% snaps the teaching stick in half and kicks dirt all over %their_scholar% drawings. It's a horse! A horse! %scholar% sighs heavily before marching off to the beat of endless profanity. Personally, you thought it was a crab. | You find %scholar% standing over %dumbguy%. Count the beetles, don't smash them, the learned %person_scholar% says with exasperation. %dumbguy% looks down at %their_dumbguy% beetle-juiced hands where {fragments of insect carapaces | carapaces of once-insects} dot %their_dumbguy% flesh. %They_dumbguy% nods, understandingly, and turns to pulling the beetles' legs off instead. %scholar% lets out a string of swears you've never heard in your life. | You find %scholar% and %dumbguy% yelling at one another. It appears they're at a very red-faced crossroads. %dumbguy_short% says %they_dumbguy% doesn't care if %they're_dumbguy% dumb, and the %scholar_short% argues that every man should be learned. Well it appears %dumbguy_short% would prefer to be left to %their_dumbguy% devices for %they_dumbguy% shows %scholar_short% %their_dumbguy% back as %they_dumbguy% walks away. Guess that's the end of the lesson for both of them. | You find %dumbguy% squatting beside a creek, staring at %themselves_dumbguy% in the shimmering reflection. %They_dumbguy% must have been at it for a while now for %they're_dumbguy% showing signs of sunburn. You ask if everything is alright, to which %they_dumbguy% explains that %they_dumbguy% is not 'getting it' with %scholar%'s teachings, and that %scholar% nearly went mad today before finally giving up on the venture. You explain that %dumbguy% doesn't have to be smart, %they_dumbguy% just needs to know how to swing a sword and shoot a bow. That's what you hired %them_dumbguy% for, after all. The %person_dumbguy% tries to hide a smile, but the running water betrays %them_dumbguy%. You take %them_dumbguy% back to camp where you then tell %scholar% to lay off for a while.}"
        es = "[img]gfx/ui/events/event_15.png[/img]{Te encuentras a %scholar% y a %dumbguy% mirando fijamente un trozo de tierra. Sobre ese lienzo pardo ves que %scholar_short% ha dibujado figuras geométricas, letras, números y lo que parecen constelaciones. Por lo visto llevan horas así. \n\nCon una vara de maestro en la mano, %scholar% señala con frenesí uno de los grupos de estrellas y exige saber qué es. %dumbguy%, con cara de sufrimiento, aventura que es una oveja. %scholar% parte la vara en dos y patea tierra sobre sus dibujos. ¡Es un caballo! ¡Un caballo! %scholar% suspira hondo antes de marcharse al compás de un sinfín de improperios. Tú, personalmente, creías que era un cangrejo. | Encuentras a %scholar% plantad%o_scholar% delante de %dumbguy%. Cuenta los escarabajos, no los aplastes, dice %art_scholar% erudit%o_scholar%, exasperad%o_scholar%. %dumbguy% se mira las manos pringadas de jugo de escarabajo, en las que {fragmentos de caparazones de insecto | caparazones de lo que antes eran insectos} le salpican la piel. Asiente, como si lo entendiera, y en lugar de eso se pone a arrancarles las patas a los escarabajos. %scholar% suelta una retahíla de palabrotas que no habías oído en tu vida. | Encuentras a %scholar% y a %dumbguy% gritándose mutuamente. Por lo visto han llegado a una encrucijada con las caras muy coloradas. %dumbguy_short% dice que le da igual ser tont%o_dumbguy%, y %scholar_short% sostiene que todo hombre debería ser instruido. Pues bien, parece que %dumbguy_short% prefiere que %lo_dumbguy% dejen a su aire, porque le da la espalda a %scholar_short% y se marcha. Supones que ahí se acaba la lección para los dos. | Encuentras a %dumbguy% en cuclillas junto a un arroyo, mirándose en el reflejo trémulo del agua. Debe de llevar un buen rato así, porque ya muestra señales de quemaduras de sol. Le preguntas si va todo bien, y te explica que no 'le entra' lo que %scholar% le enseña, y que %scholar% ha estado a punto de perder la cabeza hoy antes de rendirse por fin con la empresa. Le explicas que %dumbguy% no tiene por qué ser list%o_dumbguy%; solo necesita saber blandir una espada y disparar un arco. Para eso %lo_dumbguy% contrataste, al fin y al cabo. Intenta disimular una sonrisa, pero el agua que corre %lo_dumbguy% delata. %Lo_dumbguy% llevas de vuelta al campamento y luego le dices a %scholar% que afloje un tiempo.}"
    }
    // context: education_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_15.png[/img]{You come across %dumbguy% mulling over a set of coins on a table. You inquire as to what %they_dumbguy% is doing and %they_dumbguy% says %they're_dumbguy% trying to figure out how much to save for retirement. First off, you\'re surprised %they_dumbguy% even knows what the word retirement is. Second off, counting? Looks like you might owe %scholar% a pint. | You find %dumbguy% sitting on a stump as %they_dumbguy% writes across a scroll. When you ask what %they're_dumbguy% doing, %they_dumbguy% says %they're_dumbguy% writing a letter. When you ask to whom it is addressed, the %person_dumbguy% looks up with a sheepish grin and asks, does it matter? Just then, you spot %scholar% in the distance, arms crossed, a look of satisfaction on %their_scholar% face.}"
        mode = "pattern"
        en = "[img]gfx/ui/events/event_15.png[/img]{You come across %dumbguy% mulling over a set of coins on a table. You inquire as to what %they_dumbguy% is doing and %they_dumbguy% says %they're_dumbguy% trying to figure out how much to save for retirement. First off, you're surprised %they_dumbguy% even knows what the word retirement is. Second off, counting? Looks like you might owe %scholar% a pint. | You find %dumbguy% sitting on a stump as %they_dumbguy% writes across a scroll. When you ask what %they're_dumbguy% doing, %they_dumbguy% says %they're_dumbguy% writing a letter. When you ask to whom it is addressed, the %person_dumbguy% looks up with a sheepish grin and asks, does it matter? Just then, you spot %scholar% in the distance, arms crossed, a look of satisfaction on %their_scholar% face.}"
        es = "[img]gfx/ui/events/event_15.png[/img]{Te encuentras a %dumbguy% cavilando sobre un puñado de monedas encima de una mesa. Le preguntas qué está haciendo y dice que intenta calcular cuánto tiene que ahorrar para el retiro. Para empezar, te sorprende que sepa siquiera qué significa la palabra retiro. Y además, ¿contar? Parece que vas a deberle una pinta a %scholar%. | Encuentras a %dumbguy% sentad%o_dumbguy% en un tocón, escribiendo en un pergamino. Cuando le preguntas qué hace, dice que está escribiendo una carta. Cuando le preguntas a quién va dirigida, levanta la vista con una sonrisa avergonzada y pregunta: ¿acaso importa? Justo entonces divisas a %scholar% a lo lejos, de brazos cruzados y con cara de satisfacción.}"
    }
    // FILE: mod_legends\hooks\events\events\enter_friendly_town_event.nut
    // context: enter_friendly_town_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "appreciation for your business there" es aprecio por los negocios que haces allí, no "por tu compañía allí".
        // corrige base: "slams a few mugs down" es beberse de golpe unas jarras, no "golpea algunas jarras".
        // corrige base: falta "girlish" en la camarera ("menuda y aniñada").
        en = "[img]gfx/ui/events/event_85.png[/img]{Your arrival in %townname% seems to be cause for some celebration. One of the town's councilman greets you, offering refreshments. | %townname% shows its appreciation for your business there by handing you and your company a tray of refreshments. %randombrother% slams a few mugs down as a dainty, girlish server looks on in awe. %They_randombrother% wipes his mouth.%SPEECH_ON%Appreciated. More, please.%SPEECH_OFF% | Business in %townname% has been good and the people there seem to appreciate you more and more: on today's arrival they gave you {plenty of useless thanks | a storm of gratitude | flowers upon flowers which you have no use for | trinkets and other things that you throw away when the peasants aren't looking | a tray of ale which your men quickly consume | a cask of ale which your men tactlessly criticize as 'tasting wooden' | a few marriage proposals which you gracefully turn down | a few marriage proposals which you can't turn down fast enough | one marriage proposal from the town ugly. She has a face that could stop a sundial. You decline the offer | a quick celebration wherein a few people shouted incoherently. Their tone seemed cheery, anyway | a few slaps on the back. You reminded them that such a doing might leave them handless on the next go around | an offering of orphans. You've no idea what gave them the notion that you'd accept such a gift, but you return the children to their sad home, also known as the streets}.}"
        es = "[img]gfx/ui/events/event_85.png[/img]{Tu llegada a %townname% parece ser motivo de celebración. Uno de los concejales de la ciudad te saluda y te ofrece refrigerios. | %townname% muestra su aprecio por los negocios que haces allí entregándote a ti y a tu compañía una bandeja de refrigerios. %randombrother% se bebe de golpe unas cuantas jarras mientras una camarera menuda y aniñada %lo_randombrother% observa con asombro. Se limpia la boca.%SPEECH_ON%Se agradece. Más, por favor.%SPEECH_OFF% | Los negocios en %townname% han ido bien y la gente parece apreciarte cada vez más: a tu llegada de hoy te dieron {muchas gracias inútiles | una lluvia de gratitud | flores y más flores que no te sirven de nada | baratijas y otras cosas que tiras cuando los campesinos no están mirando | una bandeja de cerveza que tus hombres consumen rápidamente | un barril de cerveza que tus hombres critican sin tacto diciendo que tiene 'sabor a madera' | algunas propuestas de matrimonio que rechazas con elegancia | algunas propuestas de matrimonio que no puedes rechazar lo bastante rápido | una propuesta de matrimonio de la mujer más fea de la ciudad. Tiene una cara que podría detener un reloj de sol. Declinas la oferta | una rápida celebración en la que algunas personas gritaron de forma incoherente. De todos modos, parecían estar de buen humor | algunas palmadas en la espalda. Les recordaste que algo así podría dejarlos sin manos la próxima vez | una ofrenda de huérfanos. No tienes ni idea de qué les hizo pensar que aceptarías semejante regalo, pero devuelves a los niños a su triste hogar, también conocido como la calle}.}"
    }
    // FILE: mod_legends\hooks\events\events\farmer_old_tricks_event.nut
    // context: farmer_old_tricks_event.o.create.s.Text
    {
        // corrige base: el inglés va en presente y la 1.0 lo pasa a pretérito ("Encontraste", "Estaba"), mezclándolo luego con presente ("Observas").
        // corrige base: "to properly gut a man" se rebaja a "deshacerse adecuadamente de un hombre"; es destripar.
        // corrige base: "Where ya stab the hay and yank?" no pregunta por un lugar, sino por la parte de la técnica en que se clava y se tira.
        // corrige base: "Con mucho más gritos" no concuerda: "muchos más gritos".
        en = "[img]gfx/ui/events/event_82.png[/img]You find %farmhand% sitting beside the company wagon. Rolling some boomstraw between their teeth, gritting it here and there and spitting out the flakes. You ask what they're thinking about. The farmer shrugs.%SPEECH_ON%What my pa told me about baling hay. He had this method of turning the wrist at the catch and again at the release. Never could get the second part right.%SPEECH_OFF%The mercenary takes the straw out and flicks it. You ask.%SPEECH_ON%But you could get the first part right? Where ya stab the hay and yank?%SPEECH_OFF% They nod. You tell the mercenary they only need the first part of that technique to properly gut a man. You watch as their face glows with realization.%SPEECH_ON%Yeah... yeah that's right! Why didn't I think of that before? Yer a genius, sir! I'll try it our next go out! It'll just be like baling hay!%SPEECH_OFF%With a lot more screaming and bleeding, but sure."
        es = "[img]gfx/ui/events/event_82.png[/img]Encuentras a %farmhand% en el suelo junto al carro de la compañía, haciendo rodar una brizna de paja entre los dientes, mordisqueándola aquí y allá y escupiendo los trocitos. Le preguntas en qué está pensando. Se encoge de hombros.%SPEECH_ON%En lo que me contaba mi pa' sobre empacar heno. Tenía un método para girar la muñeca al clavar la horca y otra vez al soltar. Nunca me salió bien la segunda parte.%SPEECH_OFF%Se saca la paja de la boca y la tira de un capirotazo. Le preguntas.%SPEECH_ON%¿Pero la primera parte sí te salía bien? ¿Esa en la que clavas el heno y das el tirón?%SPEECH_OFF% Asiente. Le dices que solo le hace falta la primera parte de esa técnica para destripar a un hombre como es debido. Ves cómo se le ilumina la cara al caer en la cuenta.%SPEECH_ON%Sí... ¡sí, eso es! ¿Cómo no se me ocurrió antes? ¡Eres un genio, señor! ¡Lo probaré la próxima vez que salgamos! ¡Será como empacar heno!%SPEECH_OFF%Con muchos más gritos y mucha más sangre, pero, claro."
    }
    // FILE: mod_legends\hooks\events\events\fat_guy_gets_fit_event.nut
    // context: fat_guy_gets_fit_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_75.png[/img]%fatguy%, once a lumbering lump of belly fat on two legs, has lost a considerable amount of weight since enlisting with the company. No longer does the mere notion of a sparring fight leave them without breath. In fact, they've got more bounce in their step and is showing a sort of agility you've never seen from them before. Looks like all this walking about has done wonders."
        es = "[img]gfx/ui/events/event_75.png[/img]%fatguy%, que antes era una mole torpe de grasa abdominal sobre dos piernas, ha perdido una cantidad considerable de peso desde que se alistó en la compañía. La mera idea de un combate de entrenamiento ya no le quita el aliento. De hecho, camina con más brío y muestra una agilidad que nunca le habías visto. Parece que tanta caminata ha obrado maravillas."
    }
    // context: fat_guy_gets_fit_event.o.create.s.Options[0].Text
    {
        en = "They might make a good sellsword yet."
        es = "Quizá todavía sirva para este oficio."
    }
    // FILE: mod_legends\hooks\events\events\fell_down_well_event.nut
    // context: fell_down_well_event.o.create.s.Text
    {
        // corrige base: el juego de "in a bit of a pickle / being pickled" (estar en apuros / estar en remojo) se malinterpreta como "me está apurando el cuerpo"; se recupera con "con el agua al cuello".
        // corrige base: el chiste "wellhead / not well in the head" se pierde con "parte superior del pozo"; se usa "cabezal", como en el otro texto del evento, para jugar con "cabeza".
        // corrige base: "¡veinte!" es un añadido que el inglés no tiene, y "a scar" es una sola cicatriz.
        en = "[img]gfx/ui/events/event_91.png[/img]You decide it's worth your time and go and take a look. The old man was doing repairs on the wellhead, a wooden framework meant to cover its opening, when it broke apart and sent him plunging down. Staring into the well, you find the man staring back up. He gives a wave.%SPEECH_ON%Oy' there, fellas. I'm in a bit of a pickle. I'm actually being pickled, now that I think about it...%SPEECH_OFF%Eh, right. %otherbrother% throws down a rope and the old man ties it around himself. You and the sellsword pull the woman's grandfather up and back onto dry land. He shakes your hand and thanks you cordially.%SPEECH_ON%Farkin' hell, glad you came when you did, I was about to shit and piss like no other. Let me tell ya, this ain't my first time going down a well. Five years ago I'd done it while repairing the wellhead, because the wellhead breaks often, you see. And it's not really a wellhead, we just call it that cause we're lazy. Back in my day we called it a... well, heh well, I actually done forgot. I guess a 'wellhead' makes sense now, as I'm not well in the head! Ho! Still got it. I was quite the charmer in my days, you see, and it's not often I get to put the practice in. M'wife died ten years ago, and the one prior to her left me twenty winters ago! I say winters, because that's when she left me, in the winter. It was a brutal one and I had asked her to help chop the wood lest we all freeze. She said she wasn't doing that shit and taking care of the kids at the same time. I had kids with her as well as with the second wife. Five total. One died. Measles. Another disappeared, so he's probably dead. I try to be honest to myself about it, but you know, there's hope. If a random stranger can be found in the forest to save me in the nick of time, then maybe my son survived that battle with the greenskins. Ain't heard of him, though. I pray to the old gods and even that Davkul fella every now and again. Do you know of Davkul? I'm not sure what to make of it. One time this man came by with a scar on his forehead, said he'd show me the way of darkness. I said I see darkness everytime I nap. This scarred fella said one day I won't wake and I said good! Ha! So then this scarred bastard starts getting upset with me...%SPEECH_OFF%As he drones on, you look around for %otherbrother% only to find %them_other% stepping out of the woman's home, the lady herself carrying a bit of... obvious warmth on her face. You retrieve your sellsword and leave before the old man lops your head with the most longwinded and one-sided conversation ever."
        es = "[img]gfx/ui/events/event_91.png[/img]Decides que vale la pena dedicarle tu tiempo y vas a echar un vistazo. El anciano estaba reparando el cabezal del pozo, una estructura de madera que sirve para tapar la boca, cuando se rompió y lo hizo caer. Al asomarte al pozo, encuentras al hombre mirándote desde abajo. Te saluda con la mano.%SPEECH_ON%Oigan, amigos. Estoy con el agua al cuello. Y no es manera de hablar, ahora que lo pienso...%SPEECH_OFF%Eh, ya. %otherbrother% le tira una cuerda y el anciano se la ata alrededor del cuerpo. Con %art_other% mercenari%o_other%, subes al abuelo de la mujer y lo devuelves a tierra firme. Te estrecha la mano y te da las gracias cordialmente.%SPEECH_ON%Maldita sea, menos mal que llegaron a tiempo, estaba a punto de cagarme y mearme como nunca. Déjame decirte que no es la primera vez que me caigo a un pozo. Hace cinco años me pasó mientras reparaba el cabezal, porque el cabezal se rompe a menudo, ¿sabes? Y en realidad no es un cabezal, solo lo llamamos así porque somos perezosos. En mis tiempos lo llamábamos... bueno, je, bueno, se me ha olvidado. Supongo que ahora lo de 'cabezal' tiene sentido, ¡porque no ando bien de la cabeza! ¡Jo! Todavía conservo la gracia. En mis tiempos era todo un seductor, ¿sabes?, y no es frecuente que pueda practicar. Mi mujer murió hace diez años, ¡y la de antes me dejó hace veinte inviernos! Digo inviernos porque fue entonces cuando me dejó, en invierno. Fue uno brutal y le había pedido que me ayudara a cortar leña para que no nos congeláramos todos. Ella dijo que no iba a hacer esa mierda y cuidar de los niños al mismo tiempo. Tuve hijos con ella y también con la segunda esposa. Cinco en total. Uno murió. Sarampión. Otro desapareció, así que probablemente esté muerto. Intento ser honesto conmigo mismo al respecto, pero, ya sabes, hay esperanza. Si un desconocido cualquiera puede aparecer en el bosque para salvarme en el último momento, entonces quizá mi hijo sobrevivió a aquella batalla con los pieles verdes. Aunque no he tenido noticias de él. Rezo a los dioses antiguos e incluso a ese tal Davkul de vez en cuando. ¿Conoces a Davkul? No sé qué pensar de él. Una vez vino un hombre con una cicatriz en la frente y dijo que me mostraría el camino de la oscuridad. Le dije que veo oscuridad cada vez que me echo la siesta. El tipo de la cicatriz dijo que un día no despertaría y yo le dije ¡mejor! ¡Ja! Así que entonces el bastardo de la cicatriz empieza a enfadarse conmigo...%SPEECH_OFF%Mientras sigue con su cantinela, buscas a %otherbrother% con la mirada y %lo_other% encuentras saliendo de la casa de la mujer, y la propia dama lleva en el rostro un... evidente acaloramiento. Recoges a tu mercenari%o_other% y te marchas antes de que el anciano te corte la cabeza con la conversación más larga y unilateral de la historia."
    }
    // context: fell_down_well_event.o.create.s.Text
    {
        // corrige base: "goes bust" es romperse, no "se descompone".
        // corrige base: el "eh" de "muy poco, eh, animada" es un añadido que el inglés no tiene.
        en = "[img]gfx/ui/events/event_91.png[/img]The old man was doing repairs atop the wooden wellhead when it broke apart. Unfortunately, if you're standing atop a wellhead when it goes bust there's only one place to go: down. Very, very far down. As you look over the edge of the well, you can see the old man floating in a matter that is most unlively. %otherbrother% sidles up next to you and whispers, using a hand to keep %their_other% words from being heard.%SPEECH_ON%Uh, he's not moving.%SPEECH_OFF%An expertly observation, truly. You inform the lady of the man's passing. She purses her lips and asks that you remove the body anyway, explaning her reasoning rather succinctly.%SPEECH_ON%We can't be drinking his filth after all.%SPEECH_OFF%Fair enough. %otherbrother% manages to hook a rope-loop around the corpse and pull it up, its limbs dangling loosely like white washrags. %They_other% asks if she needs you to bury it, too. The woman wipes a tear and shakes her head.%SPEECH_ON%Nah. I'll bury that feller myself, weep over his grave tomorrow, and then get on with living.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_91.png[/img]El anciano estaba haciendo reparaciones encima del cabezal de madera del pozo cuando se rompió. Por desgracia, si estás encima de un cabezal cuando se viene abajo, solo hay un sitio al que ir: hacia abajo. Muy, muy abajo. Al asomarte por el borde del pozo, ves al anciano flotando de una manera de lo más inanimada. %otherbrother% se arrima a tu lado y susurra, tapándose la boca con la mano para que no se oigan sus palabras.%SPEECH_ON%Eh, no se mueve.%SPEECH_OFF%Una observación de experto, sin duda. Informas a la dama de la muerte del anciano. Ella aprieta los labios y te pide que saquen el cuerpo de todos modos, explicando sus razones de forma bastante sucinta.%SPEECH_ON%Al fin y al cabo, no vamos a bebernos su porquería.%SPEECH_OFF%Razonable. %otherbrother% logra pasarle un lazo de cuerda al cadáver y subirlo, con las extremidades colgando flojas como trapos blancos. Le pregunta si quiere que también lo entierren. La mujer se enjuga una lágrima y niega con la cabeza.%SPEECH_ON%No. A ese viejo lo enterraré yo misma, lloraré sobre su tumba mañana y luego seguiré con mi vida.%SPEECH_OFF%"
    }
    // context: fell_down_well_event.o.create.s.Text
    {
        // corrige base: el juego de "in a bit of a pickle / being pickled" se malinterpreta como "el cuerpo me está apurando"; se recupera con "con el agua al cuello".
        // s.Text = "[img]gfx/ui/events/event_91.png[/img]You decide it\'s worth your time and go and take a look. The wellhead, a wooden framework meant to cover its opening, has broken apart. Apparently, the old man was doing repairs atop it when this happened and so he plunged down into the well. He looks up at you.%SPEECH_ON%Oy\' there, fellas. I\'m in a bit of a pickle. I\'m actually being pickled now that I think about it...%SPEECH_OFF%Eh, right. %strongbrother% throws down a rope. The old man ties it around himself. You and the sellsword pull the woman\'s grandfather up and back onto dry land. He shakes your hand and thanks you cordially.%SPEECH_ON%Farkin\' hell, glad you came when you did, I was about to shit and piss like no other.%SPEECH_OFF%You talk with the old fella for a time, learning a lot about him. A while later, you realize %strongbrother% is nowhere in sight. Just as you think to start looking for %them_strong% %they_strong% steps out of the woman\'s home. She\'s glomming onto %their_strong% muscles and being rather touchy feely.";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_91.png[/img]You decide it's worth your time and go and take a look. The wellhead, a wooden framework meant to cover its opening, has broken apart. Apparently, the old man was doing repairs atop it when this happened and so he plunged down into the well. He looks up at you.%SPEECH_ON%Oy' there, fellas. I'm in a bit of a pickle. I'm actually being pickled now that I think about it...%SPEECH_OFF%Eh, right. %strongbrother% throws down a rope. The old man ties it around himself. You and the sellsword pull the woman's grandfather up and back onto dry land. He shakes your hand and thanks you cordially.%SPEECH_ON%Farkin' hell, glad you came when you did, I was about to shit and piss like no other.%SPEECH_OFF%You talk with the old fella for a time, learning a lot about him. A while later, you realize %strongbrother% is nowhere in sight. Just as you think to start looking for %them_strong% %they_strong% steps out of the woman's home. She's glomming onto %their_strong% muscles and being rather touchy feely."
        es = "[img]gfx/ui/events/event_91.png[/img]Decides que vale la pena echar un vistazo. El cabezal del pozo, una estructura de madera que sirve para tapar la boca, se ha roto. Por lo visto, el anciano estaba haciendo reparaciones encima cuando ocurrió, y cayó al fondo del pozo. Te mira desde abajo.%SPEECH_ON%Oigan, amigos. Estoy con el agua al cuello. Y no es manera de hablar, ahora que lo pienso...%SPEECH_OFF%Eh, ya. %strongbrother% le tira una cuerda. El anciano se la ata alrededor del cuerpo. Con %art_strong% mercenari%o_strong%, subes al abuelo de la mujer y lo devuelves a tierra firme. Te estrecha la mano y te da las gracias cordialmente.%SPEECH_ON%Maldita sea, menos mal que llegaron a tiempo, estaba a punto de cagarme y mearme como nunca.%SPEECH_OFF%Charlas un rato con el viejo y te enteras de muchas cosas sobre él. Al cabo de un rato, te das cuenta de que %strongbrother% no está a la vista. Justo cuando piensas en ir a buscar%lo_strong%, sale de la casa de la mujer. Ella va colgada de sus músculos y no le quita las manos de encima."
    }
    // FILE: mod_legends\hooks\events\events\flagellant_vs_monk_event.nut
    // context: flagellant_vs_monk_event.o.create.s.Text
    {
        // corrige base: "gives you both pause" se refiere al capitán y al monje; "los hace a ambos detenerse" deja fuera al capitán.
        // corrige base: "glorified gore-schedule" se rebaja a "itinerario glorificado de sufrimiento"; el inglés habla de sangre y carnicería.
        en = "[img]gfx/ui/events/event_05.png[/img]The campfire shines bright, twisting the company's faces in flowing orange as though they themselves were of burning stock.\n\n It is here you find %monk% and %flagellant% talking to one another. Their discussion is, at first, an easy one. The holy figure pleads with the flagellant to set aside his whip. While you don't necessarily wish to step in, you can't help but agree that destroying your own body on a glorified gore-schedule is not the best way to live. But then the flagellant retorts with something that gives you both pause. It is a phrase so well crafted that to think it might justify the man's personal habits has you pushing the notion out of your head as fast as possible. Disturbing, too, was the ease with which he said it. That such a soothing voice could be so warmly bundled in that scarred husk of flesh. What could muster it?\n\n The pious one stammers for a moment, but then puts hands to the flagellant's shoulders, holding him to keep their eyes on one another. Whispering words which tickle your ears, but don't pronounce themselves loud enough to have real meaning. You can only assume they are meant to, once again, persuade the flagellant to a better, less violent life.\n\n But, again, the flagellant begins to respond and so back and forth they continue to go."
        es = "[img]gfx/ui/events/event_05.png[/img]La hoguera brilla con fuerza y retuerce los rostros de la compañía en un naranja ondulante, como si fueran de leña ardiente.\n\n Es aquí donde encuentras a %monk% y a %flagellant% hablando entre sí. Su conversación, al principio, es tranquila. La figura religiosa le ruega al flagelante que deje a un lado su látigo. Aunque no te apetece especialmente intervenir, no puedes evitar estar de acuerdo en que destrozarse el propio cuerpo siguiendo un glorificado calendario de carnicería no es la mejor manera de vivir. Pero entonces el flagelante replica con algo que da que pensar tanto a ti como a la figura religiosa. Es una frase tan bien elaborada que solo pensar que pueda justificar los hábitos personales del hombre te hace sacarte la idea de la cabeza lo antes posible. También resultó perturbadora la facilidad con que lo dijo. Que una voz tan apacible pudiera ir tan cálidamente envuelta en esa carcasa de carne cicatrizada. ¿Qué podría sacar algo así?\n\n El alma piadosa balbucea un momento, pero luego le pone las manos en los hombros al flagelante y lo sujeta para que se miren a los ojos. Le susurra palabras que te hacen cosquillas en los oídos, pero que no suenan lo bastante alto como para cobrar un significado real. Solo puedes suponer que pretenden, una vez más, persuadir al flagelante de llevar una vida mejor y menos violenta.\n\n Pero, de nuevo, el flagelante empieza a responder, y así siguen, en un ir y venir."
    }
    // context: flagellant_vs_monk_event.o.create.s.Text
    {
        // corrige base: "murmuraban" rompe el presente del resto del texto, que el inglés mantiene.
        en = "[img]gfx/ui/events/event_05.png[/img]Deciding to let them talk, you step away for a time. When you return, you find them sitting together. The two saw back and forth on a log, their hands clasped in prayer as whispers of heavenly words part their lips. You've no urge to get closer to hear what they are saying for it is a comforting sight in and of itself. While you have no dog in what way is best to appease the gods, you can't help but feel a little better seeing the flagellant put down his tools of self-torture."
        es = "[img]gfx/ui/events/event_05.png[/img]Decides dejarlos hablar y te alejas un rato. Cuando vuelves, los encuentras sentados juntos. Los dos se mecen adelante y atrás sobre un tronco, con las manos unidas en oración mientras de sus labios brotan susurros de palabras celestiales. No sientes ningún deseo de acercarte a escuchar lo que dicen, porque la escena ya es reconfortante por sí misma. Aunque a ti no te va nada en cuál sea la mejor manera de aplacar a los dioses, no puedes evitar sentirte un poco mejor al ver al flagelante soltar sus herramientas de autotortura."
    }
    // en = "<flagellant:str> is now a Pacified Flagellant"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Resolve"
    // en base_es
    // context: flagellant_vs_monk_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]Deciding to let the men talk, you step away for a time.\n\nWhen you come back, the religious official is naked and bent over with teary eyes. With a craven shape, but face gutting as though this was always wanted. They straighten up with a gulp of air and a flicked wrist over the shoulder. The flagellant's whip is in hand and you hear the leather slap against the clean back. He pulls the tool away and the sound of glass and barbs tearing flesh causes a ringing in your ears. The flagellant himself says nothing. He has set himself down by the religious one's side. He stares out across the land, but there is hardly a shimmer of life in his eyes, though you certainly see the blood of his life leaving his backside as he treats himself to a beating.\n\nYou step away once more, but the grass beneath your feet doesn't have the same crunch to it and the air carries a copper scent. Little leather snickers follow you all the way back to your tent."
        es = "[img]gfx/ui/events/event_05.png[/img]Decides dejar que los hombres hablen y te alejas un rato.\n\nCuando vuelves, la figura religiosa está desnuda y encorvada, con lágrimas en los ojos. Su silueta se encoge con cobardía, pero su rostro se contrae como si esto fuera lo que siempre había deseado. Se endereza tomando una bocanada de aire y lanza la muñeca por encima del hombro. Tiene en la mano el látigo del flagelante y oyes el cuero restallar contra la espalda limpia. Aparta el látigo y el sonido del vidrio y las púas desgarrando la carne te deja un pitido en los oídos. El flagelante, por su parte, no dice nada. Se ha sentado junto a la figura religiosa. Mira a lo lejos, pero apenas hay un destello de vida en sus ojos, aunque desde luego ves que la sangre de su vida le corre por la espalda mientras se regala una paliza.\n\nTe alejas una vez más, pero la hierba bajo tus pies ya no cruje igual y el aire huele a cobre. Unas risitas de cuero te siguen todo el camino hasta tu tienda."
    }
    // en = "<monk:str> is now a Monk turned Flagellant"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Resolve"
    // en base_es
    // FILE: mod_legends\hooks\events\events\flagellants_wounds_heal_event.nut
    // context: flagellants_wounds_heal_event.o.create.s.Text
    {
        // corrige base: "until they say no more" es hasta que los dioses le digan basta, no "hasta que no digan nada más".
        // corrige base: "Preguntándote en voz alta, preguntas" es redundante; "Wondering aloud" es preguntarse en voz alta.
        en = "[img]gfx/ui/events/event_39.png[/img]%flagellant% the flagellant is found sitting cross-legged before a campfire. %They_flagellant%'s all alone save the millmoths fluttering dangerously close to the flames. Sensing your presence, %they_flagellant% calls you over. You take a seat beside %them_flagellant% and %they_flagellant% smiles at you.%SPEECH_ON%I've become a better %person_flagellant% since joining this company.%SPEECH_OFF%You nod as %they_flagellant% surely has. %They_flagellant% continues.%SPEECH_ON%I've bled for the gods a great deal, but my wounds... they are but scars now. I feel stronger than ever.%SPEECH_OFF%Again you nod, but then quickly ask if %they_flagellant% is going to stop hurting %themselves_flagellant%. The %person_flagellant%'s eyes stare into the red-brimming embers. %They_flagellant% shakes %their_flagellant% head no.%SPEECH_ON%I will bleed for the gods until they say no more.%SPEECH_OFF%Wondering aloud, you ask if the gods have spoken to %them_flagellant% at all. Without a pause the %person_flagellant% shakes %their_flagellant% head no again.%SPEECH_ON%They have not and so I shall bleed until their silence is broken or until I join them in the forever quiet.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_39.png[/img]Encuentras a %flagellant%, %art_flagellant% flagelante, sentad%o_flagellant% con las piernas cruzadas frente a una fogata. Está completamente sol%o_flagellant%, salvo por las polillas que revolotean peligrosamente cerca de las llamas. Al notar tu presencia, te llama. Te sientas a su lado y te sonríe.%SPEECH_ON%Me he convertido en mejor persona desde que me uní a esta compañía.%SPEECH_OFF%Asientes, porque sin duda lo es. Continúa.%SPEECH_ON%He sangrado mucho por los dioses, pero mis heridas... ya no son más que cicatrices. Me siento más fuerte que nunca.%SPEECH_OFF%Vuelves a asentir, pero enseguida le preguntas si va a dejar de hacerse daño. Los ojos %del_flagellant% %hombre_flagellant% se clavan en las brasas al rojo. Niega con la cabeza.%SPEECH_ON%Sangraré por los dioses hasta que me digan basta.%SPEECH_OFF%Te preguntas en voz alta si los dioses le han hablado alguna vez. Sin vacilar, %art_flagellant% %hombre_flagellant% vuelve a negar con la cabeza.%SPEECH_ON%No lo han hecho, así que sangraré hasta que rompan su silencio o hasta que me una a ellos en el silencio eterno.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\flagellation_event.nut
    // context: flagellation_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]%otherguy% approaches with a pained look on %their_otherguy% face. His helmet is in hand as he wipes %their_otherguy% brow.%SPEECH_ON%Sir, uh, you should come and see this.%SPEECH_OFF%You inquire as to what it is you are going to see.%SPEECH_ON%I don't have the words for it. You'd best come and see with your own eyes.%SPEECH_OFF%You look down at your work - plotting the march for the coming days - but, judging by the look on %their_otherguy% face, it can wait."
        es = "[img]gfx/ui/events/event_05.png[/img]%otherguy% se acerca con cara de dolor. Tiene el casco en la mano y se seca el sudor de la frente.%SPEECH_ON%Señor, eh... debería venir a ver esto.%SPEECH_OFF%Le preguntas qué es lo que vas a ver.%SPEECH_ON%No tengo palabras para describirlo. Será mejor que venga y lo vea con sus propios ojos.%SPEECH_OFF%Bajas la vista hacia tu trabajo (trazar la marcha de los próximos días), pero, a juzgar por la cara que pone, puede esperar."
    }
    // context: flagellation_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_38.png[/img]You get up and have %them_otherguy% lead you to whatever it is that's causing an issue. You come across a throng of brothers circled around something or someone. Breaking your way through the crowd, the company quiets as you come into the clearing to find %flagellant_short% the flagellant unconscious on the ground.\n\n%Their_flagellant% back is stripped raw and you think you can even see a rib or two. Thorns have broken off %their_flagellant% brutish whip, embedding themselves in %their_flagellant% flesh, and %their_flagellant% skin hangs in strands where it hangs at all. It is good %they_flagellant% has passed out. Not because %they_flagellant% would be horrible in pain, but because you think %they_flagellant% might not otherwise have stopped. You order the men to clean %them_flagellant% up, dress %their_flagellant% wounds, and hide %their_flagellant% tools of misery."
        es = "[img]gfx/ui/events/event_38.png[/img]Te levantas y le pides que te lleve hasta lo que sea que está causando el problema. Te topas con un corrillo de hermanos en círculo alrededor de algo o de alguien. Te abres paso entre la multitud y la compañía enmudece cuando llegas al claro y encuentras a %flagellant_short%, %art_flagellant% flagelante, inconsciente en el suelo.\n\nTiene la espalda en carne viva y te parece ver incluso una costilla o dos. Del brutal látigo se han desprendido espinas que se le han clavado en la carne, y la piel le cuelga en tiras allí donde aún le cuelga. Menos mal que se ha desmayado. No porque fuera a sufrir un dolor horrible, sino porque crees que, de lo contrario, no habría parado. Ordenas a los hombres que %lo_flagellant% limpien, le vendan las heridas y escondan sus herramientas de tormento."
    }
    // FILE: mod_legends\hooks\events\events\flagellation_horrifies_other_event.nut
    // context: flagellation_horrifies_other_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // _screen.Text = "[img]gfx/ui/events/event_38.png[/img]Flesh torn asunder. Parts of %person_flagellant% rendered unfamiliar. A copper stench in the air. These are the things you find when beckoned by a %sibling_flagellant%\'s call.\n\n %flagellant% the flagellant stooped over on a stump, %their_flagellant% whole body unmoving save for %their_flagellant% arm which flicks a glass and thorn-peppered whip against %their_flagellant% own back. A gargling belch draws your eyes to %weakbro% who is bent over in the tall grass losing %their_otherguy% lunch. Sensing that %they_flagellant% is disturbing the others, %flagellant% cracks something of a smile that doesn\'t falter an inch to the horror %they're_flagellant% committing to %their_flagellant% own hide.%SPEECH_ON%Fear not the reaper, %weakbro%, I shall bleed even more in favor of saving your soul.%SPEECH_OFF%";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_38.png[/img]Flesh torn asunder. Parts of %person_flagellant% rendered unfamiliar. A copper stench in the air. These are the things you find when beckoned by a %sibling_flagellant%'s call.\n\n %flagellant% the flagellant stooped over on a stump, %their_flagellant% whole body unmoving save for %their_flagellant% arm which flicks a glass and thorn-peppered whip against %their_flagellant% own back. A gargling belch draws your eyes to %weakbro% who is bent over in the tall grass losing %their_otherguy% lunch. Sensing that %they_flagellant% is disturbing the others, %flagellant% cracks something of a smile that doesn't falter an inch to the horror %they're_flagellant% committing to %their_flagellant% own hide.%SPEECH_ON%Fear not the reaper, %weakbro%, I shall bleed even more in favor of saving your soul.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_38.png[/img]Carne desgarrada. Partes de %un_flagellant% %hombre_flagellant% desfiguradas hasta lo irreconocible. Un hedor a cobre en el aire. Esto es lo que encuentras cuando acudes a la llamada de %un_flagellant% herman%o_flagellant%.\n\n %flagellant%, %art_flagellant% flagelante, está encorvad%o_flagellant% sobre un tocón, con todo el cuerpo inmóvil salvo el brazo, que descarga contra su propia espalda un látigo salpicado de vidrio y espinas. Un eructo gorgoteante te hace mirar a %weakbro%, que se ha inclinado entre la hierba alta para echar el almuerzo. Al notar que está perturbando a los demás, %flagellant% esboza algo parecido a una sonrisa que no flaquea ni un ápice ante el horror que inflige a su propio pellejo.%SPEECH_ON%No temas al segador, %weakbro%, sangraré todavía más para salvar tu alma.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\forestlover_event.nut
    // context: forestlover_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_25.png[/img] {%forestlover% looks up at the forest canopy, a hand playfully strumming through the lightfalls. Looking up at you.%SPEECH_ON%I used to play through these forests as a kid.%SPEECH_OFF%You nod, then wonder aloud.%SPEECH_ON%I thought you were born outside %randomtown%?%SPEECH_OFF%%forestlover%'s hand falls and he stares at the ground.%SPEECH_ON%Oh yeah, that's right. Well, we should get moving then, right?%SPEECH_OFF%Before you can say anything more, the red-faced mercenary marches on. | You find that %forestlover% appears to be in better spirits lately. As it turns out, these forests are familiar to the forester and a return to their greenery has the mercenary beaming with warm nostalgia. | Even though you've marched through plenty of forests, this one's viridscapes has you impressed. No doubt %forestlover% is loving a return to the trees' thick domain. | Trees, fat trunks and strong-limbed, rise above you. %forestlover% seems to be mesmerized by their towering. You find the mercenary smiling all the time lately, as though a return to the forest is a return to better times.}"
        es = "[img]gfx/ui/events/event_25.png[/img] {%forestlover% alza la vista hacia el dosel del bosque, con una mano jugueteando entre los haces de luz. Levanta la mirada hacia ti.%SPEECH_ON%En mi infancia jugaba por estos bosques.%SPEECH_OFF%Asientes y luego te preguntas en voz alta.%SPEECH_ON%¿No habías nacido a las afueras de %randomtown%?%SPEECH_OFF%La mano de %forestlover% cae y se queda mirando al suelo.%SPEECH_ON%Ah, sí, es verdad. Bueno, deberíamos ponernos en marcha, ¿no?%SPEECH_OFF%Antes de que puedas añadir nada, se adelanta con la cara colorada. | Te das cuenta de que %forestlover% parece estar de mejor ánimo últimamente. Resulta que estos bosques le resultan familiares, y volver a su verdor hace que irradie una cálida nostalgia. | A pesar de haber marchado por muchos bosques, los paisajes verdes de este te impresionan. Sin duda, a %forestlover% le encanta regresar al espeso dominio de los árboles. | Los árboles, de troncos gruesos y ramas fuertes, se alzan sobre ti. %forestlover% parece no poder apartar la vista de su imponente altura. Últimamente no deja de sonreír, como si volver al bosque fuera volver a tiempos mejores.}"
    }
    // en = "Good for you."
    // en base_es
    // FILE: mod_legends\hooks\events\events\gambler_vs_other_event.nut
    // context: gambler_vs_other_event.o.create.s.Text
    {
        // corrige base: "Entonces les preguntas qué demonios quieren de ti entonces" repite "entonces".
        // corrige base: se omite "table-flipping" (la partida acaba con la mesa volcada) y "sheepish" (incredulidad avergonzada).
        en = "[img]gfx/ui/events/event_06.png[/img]{%gambler% and %nongambler% walk up to mottled with bruises. It appears they've been in a bit of a scuffle. Seeing as how neither one is dead, you don't really care what it was over, but they tell you anyway.\n\nApparently the gambler took some money in a bit of sly cardsmanship. You ask either one if the company's money was involved. They say no. You ask what the hell they want from you then. | A game of cards comes to a table-flipping end when %nongambler% jumps off a stool and launches a tirade at %gambler%. The professional gambler looks around with sheepish incredulity. How could such a person come into so much money over a game of cards, the gambler asks, but when raising hands to feign confusion a few 'extra' cards slip out of the gambler's sleeves. The ensuing battle is amusing, but you put a stop to it before anyone gets hurt.}"
        es = "[img]gfx/ui/events/event_06.png[/img]{%gambler% y %nongambler% se te acercan con el cuerpo lleno de moretones. Parece que han tenido una pequeña trifulca. Como los dos siguen con vida, la verdad es que te da igual por qué fue, pero te lo cuentan de todos modos.\n\nPor lo visto, quien vive de las apuestas se llevó algo de dinero con una maña bastante sospechosa con las cartas. Les preguntas si había dinero de la compañía de por medio. Dicen que no. Entonces les preguntas qué demonios quieren de ti. | Una partida de cartas termina con la mesa volcada cuando %nongambler% salta de un taburete y le suelta una diatriba a %gambler%. Quien vive del juego mira a su alrededor con una incredulidad algo avergonzada. ¿Cómo iba alguien así a hacerse con tanto dinero en una partida de cartas?, pregunta; pero al levantar las manos para fingir desconcierto, se le escurren de las mangas unas cuantas cartas 'de más'. La pelea que sigue es divertida, pero le pones fin antes de que nadie salga herido.}"
    }
    // FILE: mod_legends\hooks\events\events\giant_tree_in_forest_event.nut
    // context: giant_tree_in_forest_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "enough shade above to lose time between the days and night" es perder la cuenta de los días y las noches, no "perder el tiempo".
        // corrige base: "Lo miras y a su postura particularmente restringida" es agramatical; "withheld posture" es una postura contenida.
        // corrige base: "godtree" es "árbol divino" aquí y "árbol de los dioses" en el registro de humor del mismo evento; se unifica en "árbol de los dioses".
        en = "[img]gfx/ui/events/event_25.png[/img]You pass through a wall of shrubs and find yourself stopped by quite a sight. To call it a tree would seem insulting. The trees about it are so low beneath their neighbor they appear to be bending at midtrunk, swearing fealty to that which is arboreally suzerain, a domain rippled with roots as thick as any man, and enough shade above to lose time between the days and night.\n\n You walk to the base of the enormity and run a hand along its bark, but then you stop, fearing that your flesh may have just trespassed upon holy ground like a child tumbling playfully into a church of one wholly quiet crowd. %monk% the monk comes to your side nodding and with %their_monk% hands firmly behind %their_monk% back.%SPEECH_ON%This is a godtree. The roots go through the earth and into the realm of the gods. It is said they once listened, but now... we are not so sure.%SPEECH_OFF%You stare at the %person_monk%, and %their_monk% particularly withheld posture, and ask if %they_monk% fears the tree. %They_monk% smiles at you and shakes %their_monk% head.%SPEECH_ON%I respect it like a man would the sea, for the waters of the oceans hold many things to fear and, yet, the sailor sails anyway. Were the ocean a docile beast, would man refer to it so lovingly?%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_25.png[/img]Atraviesas una pared de arbustos y te detiene en seco todo un espectáculo. Llamarlo árbol parecería un insulto. Los árboles que lo rodean quedan tan por debajo de su vecino que parecen inclinarse por la mitad del tronco, jurando lealtad a su soberano arbóreo, un dominio surcado de raíces tan gruesas como cualquier hombre y con tanta sombra en lo alto que uno pierde la cuenta de los días y las noches.\n\n Caminas hasta la base de esa enormidad y pasas la mano por la corteza, pero entonces te detienes, temiendo que tu carne acabe de profanar terreno sagrado, como un niño que irrumpe jugando en una iglesia llena de fieles en completo silencio. %monk% se acerca a tu lado asintiendo, con las manos firmemente a la espalda.%SPEECH_ON%Es un árbol de los dioses. Sus raíces atraviesan la tierra y llegan al reino de los dioses. Se dice que antaño escuchaban, pero ahora... no estamos tan seguros.%SPEECH_OFF%Observas %al_monk% %hombre_monk% y su postura especialmente contenida, y le preguntas si le teme al árbol. Te sonríe y niega con la cabeza.%SPEECH_ON%Lo respeto como un hombre respetaría el mar, porque las aguas de los océanos encierran muchas cosas que temer y, aun así, el marinero se hace a la mar. Si el océano fuera una bestia dócil, ¿hablaría el hombre de él con tanto cariño?%SPEECH_OFF%"
    }
    // context: giant_tree_in_forest_event.o.create.::Legends.Screens.hook()._screen.start._event.m.Monk.improveMood()
    {
        en = "Saw a godtree with their own eyes"
        es = "Vio un árbol de los dioses con sus propios ojos"
    }
    // FILE: mod_legends\hooks\events\events\glutton_eats_apple_event.nut
    // context: glutton_eats_apple_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "losing my gouerrrghhhh" (gourd, la cabeza) se deja en inglés y se pierde el chiste de la palabra cortada por la arcada; también "mis actos harrghh" separa la arcada de la palabra.
        // corrige base: "la boca todavía revuelta" no traduce "agargle" (gorgoteando), y "hasta que todo esté fuera de su sistema" es un calco de "out of his system".
        en = "[img]gfx/ui/events/event_18.png[/img]{You come to a commotion between %glutton% the glutton and a bucket. %They_glutton%'s heaving into it so hard %their_glutton% back lurches like a cat and %their_glutton% hurls sound like an undead cow giving birth. When he lifts %their_glutton% head %their_glutton% face looks like a gourd, cheeks ballooned, %their_glutton% mouth still all agargle. %otherbrother% comes over.%SPEECH_ON%%They_glutton% ate the witch's apple.%SPEECH_OFF%Raising an eyebrow, you ask the glutton why he would do such a thing. Vomit strings wriggle from %their_glutton% wrist as he wipes %their_glutton% eyes.%SPEECH_ON%{Cause I'm always hungr-hurgh, uh, hungregghhh! | I don't rightfully know sir can't I just be in pain without having to validate my actiiiherrrghh! | Would I have to explain myself if I wasn't losing my gouerrrghhhh! | Cause you told me to eat healthy and it was an apperrrghghh!}%SPEECH_OFF%%They_glutton% pitches %their_glutton% head back into the bucket like a man who dropped a million crowns down a well. You tell the mercenaries to keep an eye on %them_glutton% until it's all out of %their_glutton% system, that is if it ever will be.}"
        es = "[img]gfx/ui/events/event_18.png[/img]{Te encuentras con un alboroto entre %glutton%, de gula insaciable, y un cubo. Vomita en él con tanta fuerza que la espalda se le arquea como a un gato y sus arcadas suenan como una vaca no muerta pariendo. Cuando levanta la cabeza, su cara parece una calabaza, con los carrillos hinchados y la boca todavía gorgoteando. %otherbrother% se acerca.%SPEECH_ON%Se ha comido la manzana de la bruja.%SPEECH_OFF%Arqueando una ceja, le preguntas por qué haría algo así. Unos hilos de vómito le cuelgan de la muñeca mientras se limpia los ojos.%SPEECH_ON%{¡Porque siempre tengo hamb-hurgh, eh, hambreghhh! | No lo sé bien, señor, ¿no puedo sufrir sin más sin tener que justificar mis actooorrrghh? | ¿Tendría que dar explicaciones si no estuviera perdiendo la caberrrghhhh? | ¡Porque me dijiste que comiera sano y era una manzerrrghghh!}%SPEECH_OFF%Vuelve a meter la cabeza en el cubo como quien ha dejado caer un millón de coronas a un pozo. Les dices a los mercenarios que no %lo_glutton% pierdan de vista hasta que lo haya echado todo, si es que alguna vez lo echa.}"
    }
    // context: glutton_eats_apple_event.o.create.::Legends.Screens.hook()._screen.Options[0].Text
    {
        // corrige base: falta el signo de cierre "!".
        en = "Let this be a lesson for you."
        es = "Que esto te sirva de lección."
    }
    // context: glutton_eats_apple_event.o.create.::Legends.Screens.hook()._screen.start.List.push().text
    {
        // text = _event.m.Glutton.getName() + " is no longer a gluttonous"
        mode = "pattern"
        en = "<name:str> is no longer a gluttonous"
        es = "<name> ya no es Glotón"
    }
    // FILE: mod_legends\hooks\events\events\glutton_gets_fat_event.nut
    // context: glutton_gets_fat_event.o.create.s.Text
    {
        // corrige base: "slams his food down" es soltar la comida de golpe, no "golpea su comida".
        en = "[img]gfx/ui/events/event_14.png[/img] You find %glutton% helping %themselves_glutton% to a third helping of food. That's far too much and so you demand that it be %their_glutton% last. Another mercenary joins in, mocking the %person_glutton% for %their_glutton% habits. The glutton, enraged, slams %their_glutton% food down and stands up. %Their_glutton% stomach however, sways at a different pace than the rest of %them_glutton% and the rather fattened %person_glutton% goes down in a heap of flailing limbs. While the rest of the company has a laugh, you can't help but wonder if the sellsword really has gotten too fat."
        es = "[img]gfx/ui/events/event_14.png[/img] Encuentras a %glutton% sirviéndose una tercera ración de comida. Eso es demasiado, así que le exiges que sea la última. Otro mercenario se suma y se burla de %el_glutton% por sus hábitos. Enfurecid%o_glutton%, suelta la comida de golpe y se pone de pie. Sin embargo, su barriga se balancea a un ritmo distinto al del resto de su cuerpo, y %art_glutton% %hombre_glutton%, bastante entrad%o_glutton% en carnes, se viene abajo en un revoltijo de brazos y piernas. Mientras el resto de la compañía se ríe, no puedes evitar preguntarte si %art_glutton% mercenari%o_glutton% no se habrá puesto demasiado gord%o_glutton%."
    }
    // FILE: mod_legends\hooks\events\events\graverobber_finds_item_event.nut
    // context: graverobber_finds_item_event.o.create.s.Text
    {
        // corrige base: "¿Esa crueldad ineludible..." abre una interrogación que nunca se cierra; el inglés no pregunta ahí.
        // corrige base: "esa realización" es un calco de "realization"; en castellano es "esa revelación" o "darse cuenta".
        en = "[img]gfx/ui/events/event_33.png[/img]The weather is nice. A fine evening, if any, for the moon to be where it is: an orange rind of it slipping in and out of the clouds - clouds that pass by on the seemingly innocuous gesture that a light breeze can have. So bright is this rim of a moon you wonder if any flowers might bloom, mistaking the evening light for its brighter cousin. You wonder if the millmoths and flies and armor-backed beetles see the moon and dance toward it as they would any candle or torch. Do they have that quiet desperation? That inescapable cruelty of realizing that, when your stock is placed against the greater whole, you have and are nothing... and the hatred that realization can bring, and the jealousy...\n\nSuddenly, %graverobber% the graverobber appears by your side, %their_graverobber% smell skewering your thoughts with miasmic proficiency. %They_graverobber%'s hardly a %person_graverobber% at all, but a golem, mudslaked and grass-peppered with two white eyes peering out. Sighing, you ask what %they_graverobber% wants. %They_graverobber% thumbs over one shoulder, the other occupied by a shovel.%SPEECH_ON%Went digging through a grave or three. Found somethin' and I don't mean just what them graves are for. Wanna come take a look?%SPEECH_OFF%Of course you do..."
        es = "[img]gfx/ui/events/event_33.png[/img]Hace buen tiempo. Una noche estupenda, si es que alguna lo es, para que la luna esté donde está: una cáscara de naranja que entra y sale de entre las nubes, nubes que pasan con el gesto aparentemente inocuo que puede tener una brisa ligera. Tan brillante es este filo de luna que te preguntas si alguna flor llegará a abrirse, confundiendo la luz de la noche con su prima más luminosa. Te preguntas si las polillas de molino, las moscas y los escarabajos de lomo acorazado ven la luna y bailan hacia ella como lo harían hacia cualquier vela o antorcha. ¿Tendrán esa desesperación silenciosa? Esa crueldad ineludible de darse cuenta de que, cuando tu existencia se compara con el todo, no tienes ni eres nada... y el odio que puede traer esa revelación, y la envidia...\n\nDe repente, %graverobber%, que se gana la vida saqueando tumbas, aparece a tu lado, y su olor atraviesa tus pensamientos con pericia miasmática. Apenas parece %un_graverobber% %hombre_graverobber%; es más bien un gólem, embadurnado de barro y salpicado de hierba, del que asoman dos ojos blancos. Suspiras y le preguntas qué quiere. Señala con el pulgar por encima de un hombro; el otro lo tiene ocupado con una pala.%SPEECH_ON%Estuve escarbando en una tumba, o en tres. Encontré algo, y no me refiero solo a lo que suele haber en las tumbas. ¿Quieres venir a echar un vistazo?%SPEECH_OFF%Por supuesto que sí..."
    }
    // context: graverobber_finds_item_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_33.png[/img]%graverobber% brings you to a big hole in the ground. The top half of a skeleton is at the bottom, its arms loose over the earth as though it had bedded there for a night's rest. Empty eye sockets look up at you. The graverobber crouches and grabs something. %They_graverobber% wipes the mud and worms off it and hands it over.%SPEECH_ON%I think we can use that.%SPEECH_OFF%You nod, but tell the man to quickly fill the grave before anyone sees what %they_graverobber%'s done."
        es = "[img]gfx/ui/events/event_33.png[/img]%graverobber% te lleva hasta un gran agujero en el suelo. En el fondo yace la mitad superior de un esqueleto, con los brazos sueltos sobre la tierra como si se hubiera acostado allí a pasar la noche. Unas cuencas vacías te miran desde abajo. Se agacha y agarra algo. Le quita el barro y los gusanos y te lo entrega.%SPEECH_ON%Creo que podemos usar esto.%SPEECH_OFF%Asientes, pero le dices que tape la tumba rápido antes de que alguien vea lo que ha hecho."
    }
    // context: graverobber_finds_item_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_33.png[/img]While looking down at the goods, %historian% the rather astute scholar and historian sidles up next to you. %They_historian%'s rubbing %their_historian% chin and a faint hum ruminates deeply within %them_historian%.%SPEECH_ON%Yes, yes...%SPEECH_OFF%You turn to %them_historian% to ask what %they_historian%'s going on about. %They_historian% snaps %their_historian% fingers and points down at what the graverobber had found. %They_historian% explains that this isn't just any chest plate or weapon, but indeed the gear of a famous fighter, nobleman, and womanizer, %noblename%."
        es = "[img]gfx/ui/events/event_33.png[/img]Mientras contemplas el botín, %historian%, erudit%o_historian% de lo más perspicaz y estudios%o_historian% de la historia, se arrima a tu lado. Se frota la barbilla y en su interior rumia un leve murmullo.%SPEECH_ON%Sí, sí...%SPEECH_OFF%Te vuelves hacia %el_historian% para preguntarle a qué viene eso. Chasquea los dedos y señala el hallazgo de la tumba. Te explica que no se trata de un peto o un arma cualquiera, sino del equipo de un famoso luchador, noble y mujeriego: %noblename%."
    }
    // FILE: mod_legends\hooks\events\events\graverobber_heist_event.nut
    // en = "Found treasure while robbing a grave"
    // en base_es
    // FILE: mod_legends\hooks\events\events\greedy_demands_raise_event.nut
    // context: greedy_demands_raise_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "muy literal" es un añadido que el inglés no tiene.
        // corrige base: "Le preguntas qué quieres que hagas" confunde la persona: es qué quiere él que hagas tú.
        en = "[img]gfx/ui/events/event_64.png[/img]{%bro% enters your tent with a scroll at %their_greedy% side. %They_greedy% unfurls it, revealing a literal list of things %they_greedy% has killed. You inquire as to what %they_greedy% wants you to do with that. The scroll is tossed onto your desk and %they_greedy% responds.%SPEECH_ON%Compensate me. Higher pay starting right now. %newpay% crowns a day.%SPEECH_OFF% | %bro% apparently wants higher pay, %newpay% crowns a day instead of the %oldpay% crowns %they_greedy% earns now, stating that %they_greedy% has slain a great deal of enemies while in the company of the %companyname%.\n\nKilling lots of things is a good bargaining chip when that's the business you are in, you'll give %them_greedy% that much. | It appears that %bro% wants more pay on account of killing lots of, well, everything on your behalf. You tell %them_greedy% that none of it was on your personal behalf, just that you simply paid %them_greedy% to do it. %They_greedy% nods.%SPEECH_ON%Right. And now I want more pay. %newpay% crowns a day.%SPEECH_OFF% | %bro% feels as though %their_greedy% services for the company aren't being well compensated. %They're_greedy% asking for more pay, %newpay% crowns a day instead of the %oldpay% crowns %they_greedy% earns now, on account of how good %they_greedy% is at that whole mercenary business. | %bro% is demanding you pay %them_greedy% more, %newpay% crowns a day instead of the %oldpay% crowns %they_greedy% earned so far, now that %they_greedy% has proven %themselves_greedy% more than capable of fighting for the %companyname%.\n\n%They're_greedy% got a bit of a point, though you're not sure you're ready to hand the crowns over quite yet.}"
        es = "[img]gfx/ui/events/event_64.png[/img]{%bro% entra en tu tienda con un pergamino en la mano. Lo desenrolla y revela una lista, literal, de cosas que ha matado. Le preguntas qué quiere que hagas con eso. Arroja el pergamino sobre tu escritorio y responde.%SPEECH_ON%Compénsame. Un salario más alto a partir de ahora mismo. %newpay% coronas al día.%SPEECH_OFF% | Al parecer, %bro% quiere un salario más alto, %newpay% coronas al día en lugar de las %oldpay% coronas que gana ahora, alegando que ha matado a un montón de enemigos estando en %companyname%.\n\nMatar muchas cosas es una buena baza para negociar cuando ese es tu negocio; eso se lo concedes. | Parece que %bro% quiere más salario por haber matado a montones de, bueno, de todo, en tu nombre. Le dices que nada de eso fue en tu nombre personal, que simplemente le pagaste para que lo hiciera. Asiente.%SPEECH_ON%Ya. Y ahora quiero más salario. %newpay% coronas al día.%SPEECH_OFF% | %bro% siente que sus servicios a la compañía no están bien compensados. Pide más salario, %newpay% coronas al día en lugar de las %oldpay% coronas que gana ahora, por lo bien que se le da todo eso del oficio de mercenario. | %bro% te exige que le pagues más, %newpay% coronas al día en lugar de las %oldpay% coronas que ha ganado hasta ahora, ya que ha demostrado ser más que capaz de luchar por %companyname%.\n\nNo le falta algo de razón, aunque no sabes si estás listo para soltar las coronas todavía.}"
    }
    // context: greedy_demands_raise_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_64.png[/img]{You agree to %bro%'s terms. %They're_greedy% very unsurprisingly happy about it and you get on with your day. | %bro%'s demands aren't too much and you are happy to fork %them_greedy% a few extra crowns a day. %They_greedy% gives you a handshake. It's firm, but not too firm. | %bro% wavers on %their_greedy% feet as %they_greedy% readies for your answer. You tell %their_greedy% to relax as you've agreed to %their_greedy% terms. %They_greedy% finally sighs in relief.%SPEECH_ON%Thank you, sir. I thought I might have to, I dunno.%SPEECH_OFF%You raise an eyebrow.%SPEECH_ON%I hope that wasn't a threat.%SPEECH_OFF%The %person_greedy% awkwardly laughs and shakes %their_greedy% head.%SPEECH_ON%No, no of course not!%SPEECH_OFF% | You tell %bro% you'll increase %their_greedy% pay under one condition: he do a little dance.%SPEECH_ON%A victory dance?%SPEECH_OFF%You shrug.%SPEECH_ON%Any dance.%SPEECH_OFF%%They_greedy% raises %their_greedy% arms and swings them a little. You burst into laughter.%SPEECH_ON%No number of kills would amount to whatever that was.%SPEECH_OFF%The %person_greedy% snickers.%SPEECH_ON%Thank you, sir.%SPEECH_OFF% | You agree to give %bro% a higher wage.%SPEECH_ON%It would be my privilege.%SPEECH_OFF%The %person_greedy% raises an eyebrow.%SPEECH_ON%Spare me the ceremony. I'm here to kill, let's not dance around it.%SPEECH_OFF%You nod.}"
        es = "[img]gfx/ui/events/event_64.png[/img]{Aceptas las condiciones de %bro%. Como era de esperar, se pone muy content%o_greedy%, y sigues con tu día. | Lo que pide %bro% no es demasiado, y te alegra soltarle unas cuantas coronas más al día. Te da un apretón de manos. Firme, pero no demasiado. | %bro% se balancea, nervios%o_greedy%, mientras espera tu respuesta. Le dices que se relaje, porque aceptas sus condiciones. Por fin suspira aliviad%o_greedy%.%SPEECH_ON%Gracias, señor. Pensé que tendría que, no sé.%SPEECH_OFF%Arqueas una ceja.%SPEECH_ON%Espero que eso no fuera una amenaza.%SPEECH_OFF%%Art_greedy% %hombre_greedy% suelta una risa incómoda y niega con la cabeza.%SPEECH_ON%¡No, no, claro que no!%SPEECH_OFF% | Le dices a %bro% que le subirás la paga con una condición: que se marque un bailecito.%SPEECH_ON%¿Un baile de la victoria?%SPEECH_OFF%Te encoges de hombros.%SPEECH_ON%Cualquier baile.%SPEECH_OFF%Levanta los brazos y los mece un poco. Estallas en carcajadas.%SPEECH_ON%No hay muertes suficientes que compensen lo que sea que acabas de hacer.%SPEECH_OFF%%Art_greedy% %hombre_greedy% se ríe por lo bajo.%SPEECH_ON%Gracias, señor.%SPEECH_OFF% | Aceptas darle a %bro% un salario más alto.%SPEECH_ON%Será un privilegio.%SPEECH_OFF%%Art_greedy% %hombre_greedy% arquea una ceja.%SPEECH_ON%Ahórrate la ceremonia. Estoy aquí para matar, no le demos más vueltas.%SPEECH_OFF%Asientes.}"
    }
    // context: greedy_demands_raise_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "fark this shit" se rebaja a "al diablo con esto"; es "a la mierda con esto".
        en = "[img]gfx/ui/events/event_64.png[/img]{You decline %bro%'s request. %They_greedy% purses %their_greedy% lips, wrings %their_greedy% hands, then nods, turns and leaves. The silence is a bit harsh, but the message well received: %they_greedy% ain't a happy man. | Declining %bro%'s request leads to a sudden outburst.%SPEECH_ON%Well, fark this shit. I'll still fight fer ya, but don't expect the best out of me!%SPEECH_OFF%You nod, but tell %them_greedy% %they_greedy%'d be dead without putting forth %their_greedy% best, so you'll get what you want regardless. | %bro% winces when you decline the suggestion.%SPEECH_ON%Alright then, I see how this place is run. In we go, out we go. No matter to you, right? We're just the pawns you use to get what you want. That's fine. That's absolutely fine.%SPEECH_OFF%%They_greedy% turns and leaves. You get the feeling it is not at all 'fine.' | You tell %bro% that you do not agree with his estimations of how much %they_greedy% should get paid. %They_greedy% responds with a few swears with an estimated volume of 'loud.' When %they're_greedy% finished, %they_greedy% nods.%SPEECH_ON%But that's alright. I get the business. And I'm sure you understand that you get why I must look after the business that is myself, too.%SPEECH_OFF% | %bro% presses for more pay, but you put your foot down.%SPEECH_ON%You'll get what we agreed upon, no more.%SPEECH_OFF%%They_greedy% nods and then slowly backs out of the tent.%SPEECH_ON%As you say, sir.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_64.png[/img]{Rechazas la petición de %bro%. Aprieta los labios, se retuerce las manos, luego asiente, se da la vuelta y se va. El silencio es algo duro, pero el mensaje queda claro: no está nada content%o_greedy%. | Rechazar la petición de %bro% provoca un estallido repentino.%SPEECH_ON%Bueno, a la mierda con esto. Seguiré peleando por ti, ¡pero no esperes lo mejor de mí!%SPEECH_OFF%Asientes, pero le dices que sin dar lo mejor de sí ya estaría muert%o_greedy%, así que obtendrás lo que quieres de todos modos. | %bro% hace una mueca cuando rechazas la propuesta.%SPEECH_ON%Muy bien, ya veo cómo funciona esto. Entramos, salimos. A ti te da igual, ¿verdad? Solo somos los peones que usas para conseguir lo que quieres. Está bien. Está perfectamente bien.%SPEECH_OFF%Se da la vuelta y se va. Te da la sensación de que no está nada 'bien'. | Le dices a %bro% que no estás de acuerdo con sus cálculos de cuánto debería cobrar. Responde con unas cuantas palabrotas a un volumen estimado de 'alto'. Cuando termina, asiente.%SPEECH_ON%Pero está bien. Entiendo el negocio. Y seguro que entiendes por qué yo también tengo que cuidar del negocio que soy yo.%SPEECH_OFF% | %bro% insiste en cobrar más, pero te mantienes firme.%SPEECH_ON%Recibirás lo que acordamos, nada más.%SPEECH_OFF%Asiente y sale lentamente de la tienda, reculando.%SPEECH_ON%Como digas, señor.%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\hedge_knight_vs_raider_event.nut
    // context: hedge_knight_vs_raider_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_26.png[/img]%raider% is sitting out beside the campfire, eyes set deep into the flames. A few moments ago, a couple of the company were heard yelling. A past as a raider isn't winning the mercenary many friends. The hedge knight, %hedgeknight%, walks over and stands there beside. As the two exchange glances, you're suddenly worried a fight you can't stop is going to break out. Instead, the hedge knight takes a seat and speaks calmly, with a deep voice that is still soundly scary.%SPEECH_ON%You raided coasts, yes? Killed women and children? Stole from the clergy?%SPEECH_OFF%The raider nods.%SPEECH_ON%Aye, and worse.%SPEECH_OFF%%hedgeknight% picks up a chunk of smoldering wood from the fire. The knight crushes it in their hand, the flames hissing into ash and smoke, then lets it crumble out of a calloused palm.%SPEECH_ON%You shouldn't mind what others say, raider. This is a nasty, hungry world, and you mind its teeth well. Let the weak cry out and die. We can only armor ourselves by our very being, wreathed in the envy of the dead who would gladly crush an infant's skull for a mere sip of the breath our lungs draw.%SPEECH_OFF%The raider grabs his own chunk of firewood and grinds it up. They shake hands and say nothing more."
        es = "[img]gfx/ui/events/event_26.png[/img]%raider% está junto a la hoguera, con la mirada hundida en las llamas. Hace unos momentos se oyó gritar a un par de miembros de la compañía. Su pasado de saqueos no le está granjeando muchos amigos. %hedgeknight%, de la caballería errante, se acerca y se queda de pie a su lado. Mientras cruzan miradas, de pronto temes que estalle una pelea que no vas a poder detener. En lugar de eso, toma asiento y habla con calma, con una voz grave que aun así da bastante miedo.%SPEECH_ON%Saqueaste costas, ¿verdad? ¿Mataste a mujeres y niños? ¿Robaste al clero?%SPEECH_OFF%Asiente.%SPEECH_ON%Sí, y cosas peores.%SPEECH_OFF%%hedgeknight% recoge del fuego un trozo de leña humeante. Lo aplasta en la mano, las llamas sisean hasta volverse ceniza y humo, y luego deja que se desmorone de su palma encallecida.%SPEECH_ON%No deberías hacer caso de lo que digan los demás. Este es un mundo cruel y hambriento, y tú sabes guardarte bien de sus dientes. Que los débiles griten y mueran. Solo podemos acorazarnos con nuestro propio ser, ceñido por la envidia de los muertos, que aplastarían con gusto el cráneo de un recién nacido por un mero sorbo del aliento que respiran nuestros pulmones.%SPEECH_OFF%Como respuesta, agarra su propio trozo de leña y lo tritura. Se dan la mano y no dicen nada más."
    }
    // FILE: mod_legends\hooks\events\events\hedgeknight_vs_hedgeknight_event.nut
    // context: hedgeknight_vs_hedgeknight_event.o.create.s.Text
    {
        // corrige base: «casi derribando una de las estacas y echando todo abajo» da por hecho que la tienda se cae; el «nearly» del inglés rige las dos cosas.
        en = "[img]gfx/ui/events/event_05.png[/img]%nonhedgeknight% sprints into your tent, nearly taking out one of the stakes and bringing the whole thing down. Sweat flies off the intruder's face and onto your maps. You look at the mercenary with a stare that demands a good answer. The mercenary explains that the hedge knights %hedgeknight1% and %hedgeknight2% are getting into it. They've both picked up weapons and look about ready to kill each other. Having the two largest soldiers in the company do battle probably isn't best for the health of... well, everyone. You quickly rush to the scene."
        es = "[img]gfx/ui/events/event_05.png[/img]%nonhedgeknight% irrumpe corriendo en tu tienda; por poco arranca una de las estacas y lo echa todo abajo. El sudor le salta de la cara y cae sobre tus mapas. Le diriges una mirada que exige una buena explicación. Te explica que los caballeros errantes %hedgeknight1% y %hedgeknight2% están a punto de enfrentarse. Han tomado las armas y parecen a un paso de matarse entre sí. Que las dos moles más grandes de la compañía se enfrenten probablemente no sea lo mejor para la salud de... bueno, de nadie. Corres rápidamente hacia allí."
    }
    // context: hedgeknight_vs_hedgeknight_event.o.create.s.Text
    {
        // corrige base: «resolver una vieja disputa... según la vieja tradición del juicio por combate»: el inglés no dice que la disputa sea vieja y habla de combate a muerte, no de juicio por combate.
        en = "[img]gfx/ui/events/event_35.png[/img]You find %hedgeknight1% with a great sword in hand and %hedgeknight2% is twirling a giant axe around like a child would a stick. Most of the company have cleared out. %nonhedgeknight% explains that the two {have unfinished business from a jousting tournament | met before on the battlefield, on opposite sides, and now look to continue a battle long past | seek to end a dispute between them by the old tradition of mortal combat}. Another comrade steps forward, begging that the hedge knights put their differences aside, but %hedgeknight2% throws the mediator out of the way. Golems of might and terror that they are, perhaps it is wise to seek an end to this confrontation?"
        es = "[img]gfx/ui/events/event_35.png[/img]Encuentras a %hedgeknight1% con una gran espada en la mano, mientras %hedgeknight2% hace girar un hacha enorme como un niño haría girar un palo. Casi toda la compañía se ha apartado. %nonhedgeknight% explica que {tienen asuntos pendientes desde un torneo de justas | ya se enfrentaron en el campo de batalla, en bandos opuestos, y ahora quieren continuar una batalla de hace mucho tiempo | quieren zanjar una disputa según la vieja tradición del combate a muerte}. Otro camarada da un paso al frente y suplica a los caballeros errantes que dejen a un lado sus diferencias, pero %hedgeknight2% aparta de un empujón a quien intenta mediar. Gólems de fuerza y terror como son, ¿no sería prudente buscar la forma de poner fin a este enfrentamiento?"
    }
    // context: hedgeknight_vs_hedgeknight_event.o.create.s.Options[0].Text
    {
        en = "May the strongest win."
        es = "Que gane quien sea más fuerte."
    }
    // context: hedgeknight_vs_hedgeknight_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_35.png[/img]%nonhedgeknight% calls out to you, asking you to stop the fight. The two hedge knights look over, each breath heaving their massive chests. You throw a dismissive hand. The knights nod and charge one another. The clash is loud, metal-shattering, bone-crunching. Growls follow every attempt to kill, so sonorous become the weapon swings. The sword catches the shaft of the giant axe and the two blades snap against one another. The hedge knights exchange cruel stares over the crossing, then quickly disarm and pull daggers, stabbing each other repeatedly as they fall to the ground. Neither seems the least bit bothered by the wounds. They give up on the pitiful daggers and turn to using their own mitts, punching each other so fiercely you see teeth scattering amongst the bloodsprays.\n\nAgain, the company looks to you for guidance as it is becoming readily obvious that these two seek to fight to a finish."
        es = "[img]gfx/ui/events/event_35.png[/img]%nonhedgeknight% te llama y te pide que detengas la pelea. Los dos caballeros errantes miran hacia ti, con el enorme pecho agitado a cada respiración. Haces un gesto de desdén con la mano. Los caballeros asienten y se lanzan a la carga. El choque es estruendoso: metal que se hace añicos, huesos que crujen. A cada intento de matar le siguen gruñidos, tan sonoros se vuelven los tajos. La espada atrapa el asta del hacha gigante y las dos hojas se rompen al chocar entre sí. Los caballeros errantes cruzan miradas crueles por encima de las armas trabadas y, de inmediato, las sueltan, sacan dagas y se apuñalan una y otra vez mientras caen al suelo. Las heridas no parecen importarles lo más mínimo. Abandonan las miserables dagas y pasan a usar sus propios puños, golpeándose con tal fiereza que ves saltar dientes entre las salpicaduras de sangre.\n\nUna vez más, la compañía te mira en busca de una orden, pues cada vez es más evidente que esta pelea va a llegar hasta el final."
    }
    // context: hedgeknight_vs_hedgeknight_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_35.png[/img]The two hedge knights stand there, eyes only on their opponent and with no regard to your words, each breath heaving their massive chests. A short moment and they charge one another. The clash is loud, metal-shattering, bone-crunching. Growls follow every attempt to kill, so sonorous become the weapon swings. The sword catches the shaft of the giant axe and the two blades snap against one another. The hedge knights exchange cruel stares over the crossing, then quickly disarm and pull daggers, stabbing each other repeatedly as they fall to the ground. Neither man seems the least bit bothered by the wounds. They give up on the pitiful daggers and turn to using their own mitts, punching each other so fiercely you see teeth scattering amongst the bloodsprays.\n\nThe company looks to you for guidance as it is becoming readily obvious that these two seek to fight to a finish."
        es = "[img]gfx/ui/events/event_35.png[/img]Los dos caballeros errantes se quedan allí, con la vista fija solo en su oponente y sin hacer caso de tus palabras, el enorme pecho agitado a cada respiración. Un breve instante, y se lanzan a la carga. El choque es estruendoso: metal que se hace añicos, huesos que crujen. A cada intento de matar le siguen gruñidos, tan sonoros se vuelven los tajos. La espada atrapa el asta del hacha gigante y las dos hojas se rompen al chocar entre sí. Los caballeros errantes cruzan miradas crueles por encima de las armas trabadas y, de inmediato, las sueltan, sacan dagas y se apuñalan una y otra vez mientras caen al suelo. Las heridas no parecen importarles lo más mínimo. Abandonan las miserables dagas y pasan a usar sus propios puños, golpeándose con tal fiereza que ves saltar dientes entre las salpicaduras de sangre.\n\nLa compañía te mira en busca de una orden, pues cada vez es más evidente que esta pelea va a llegar hasta el final."
    }
    // context: hedgeknight_vs_hedgeknight_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_35.png[/img]%nonhedgeknight% calls out to you, asking you to stop the fight. The two hedge knights look over, each breath heaving their massive chests. You throw a dismissive hand. The knights nod and charge one another. The clash is loud, metal-shattering, bone-crunching. Growls follow every attempt to kill, so sonorous become the weapon swings. The sword catches the shaft of the giant axe and the two blades snap against one another. The hedge knights exchange cruel stares over the crossing, then quickly disarm and pull daggers, stabbing each other repeatedly as they fall to the ground. Neither man seems the least bit bothered by the wounds. They give up on the pitiful daggers and turn to using their own mitts, punching each other so fiercely you see teeth scattering amongst the bloodsprays.\n\nAgain, the company looks to you for guidance as it is becoming readily obvious that these two seek to fight to a finish."
        es = "[img]gfx/ui/events/event_35.png[/img]%nonhedgeknight% te llama y te pide que detengas la pelea. Los dos caballeros errantes miran hacia ti, con el enorme pecho agitado a cada respiración. Haces un gesto de desdén con la mano. Los caballeros asienten y se lanzan a la carga. El choque es estruendoso: metal que se hace añicos, huesos que crujen. A cada intento de matar le siguen gruñidos, tan sonoros se vuelven los tajos. La espada atrapa el asta del hacha gigante y las dos hojas se rompen al chocar entre sí. Los caballeros errantes cruzan miradas crueles por encima de las armas trabadas y, de inmediato, las sueltan, sacan dagas y se apuñalan una y otra vez mientras caen al suelo. Las heridas no parecen importarles lo más mínimo. Abandonan las miserables dagas y pasan a usar sus propios puños, golpeándose con tal fiereza que ves saltar dientes entre las salpicaduras de sangre.\n\nUna vez más, la compañía te mira en busca de una orden, pues cada vez es más evidente que esta pelea va a llegar hasta el final."
    }
    // context: hedgeknight_vs_hedgeknight_event.o.create.s.Text
    {
        // corrige base: «esto no se vuelva a repetir» es agramatical; debe ser «esto no se repite» o «que esto no vuelva a repetirse».
        en = "[img]gfx/ui/events/event_04.png[/img]You bring out a satchel heavy with coins. The two hedge knights look over, the sound of gold clinking against itself hard to miss.%SPEECH_ON%A thousand crowns to each of you, yeah?%SPEECH_OFF%The two exchange a glance. They shrug. You nod.%SPEECH_ON%Alright, but this isn't happening again, understand?%SPEECH_OFF%The men nod too, walking over and accepting the crowns with shameless ease. Some comrades look a little miffed that these mercenaries just got free money for essentially choosing not to fight. The hedge knights begrudgingly find peace amongst themselves, being more concerned with counting money than killing each other. You just hope they got an equal amount lest the 'festivities' resume."
        es = "[img]gfx/ui/events/event_04.png[/img]Sacas una bolsa cargada de monedas. Los dos caballeros errantes miran hacia ti; el tintineo del oro es difícil de pasar por alto.%SPEECH_ON%Mil coronas por cabeza, ¿eh?%SPEECH_OFF%Cruzan una mirada. Se encogen de hombros. Asientes.%SPEECH_ON%Muy bien, pero esto no se repite, ¿entendido?%SPEECH_OFF%También asienten, se acercan y aceptan las coronas con una soltura desvergonzada. Algunos camaradas parecen algo molestos porque ese par acaba de cobrar dinero gratis por, en esencia, decidir no pelear. Los caballeros errantes hacen las paces a regañadientes, más ocupados en contar el dinero que en matarse entre sí. Solo esperas que les haya tocado lo mismo, no sea que se reanuden las 'festividades'."
    }
    // en = "You lose <v:val_tag> Crowns"
    // en base_es
    // context: hedgeknight_vs_hedgeknight_event.o.create.s.start.bro.worsenMood()
    {
        en = "Angry about you bribing mercenaries to stop their fight"
        es = "Le enfurece que sobornes a mercenarios para que dejen de pelear"
    }
    // context: hedgeknight_vs_hedgeknight_event.o.create.s.start.bro.worsenMood()
    {
        en = "Concerned about you bribing mercenaries to stop their fight"
        es = "Le preocupa que sobornes a mercenarios para que dejen de pelear"
    }
    // context: hedgeknight_vs_hedgeknight_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_35.png[/img]Having seen enough, you order the company to intervene. They hesitate, but you quickly remind them of their contractual duties. The mercenaries grab great tarps of leather and blankets and some pots and pans and a few carry buckets. Their strategy is sound: buckets are slammed over the heads of the hedge knights, blinding them just long enough to throw everything else over them. As someone would wrestle a bull, the company tangle with the hedge knights, occasionally being thrown into the air, and one mercenary eats a kick to the face, suffering a black-gapped smile for the troubles. Another is swallowed up in the mass of blankets, being smashed in between the growling hedge knights like an amorphous blob of anger.\n\nEventually, the two knights cool down and the battle is over. They begrudgingly make peace, lest you have the rest of your company pick up real weapons to end the scuffle. The rest of the company recovers, picking themselves up as though a great tornado had just torn through the camp. You take account of the injuries and begin distributing aid."
        es = "[img]gfx/ui/events/event_35.png[/img]Ya has visto suficiente: ordenas a la compañía que intervenga. Dudan, pero enseguida les recuerdas sus obligaciones contractuales. Los mercenarios agarran grandes lonas de cuero y mantas, unas cuantas ollas y sartenes, y algunos llevan cubos. La estrategia es acertada: estampan los cubos sobre la cabeza de los caballeros errantes, cegándolos el tiempo justo para echarles encima todo lo demás. Como quien forcejea con un toro, la compañía se enzarza con los caballeros errantes; de vez en cuando alguien sale volando por los aires, y un mercenario se come una patada en la cara que le deja, como premio a su esfuerzo, una sonrisa negra y mellada. A otro se lo traga la masa de mantas y queda aplastado entre los caballeros errantes, que gruñen como una masa amorfa de rabia.\n\nAl final, los dos caballeros se calman y la batalla termina. Hacen las paces a regañadientes, no vaya a ser que ordenes al resto de la compañía tomar armas de verdad para acabar con la refriega. El resto de la compañía se recupera y se levanta del suelo como si un gran tornado acabara de arrasar el campamento. Haces recuento de las heridas y empiezas a repartir ayuda."
    }
    // context: hedgeknight_vs_hedgeknight_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_35.png[/img]You set yourself down on a stump and watch the rest of the fight. The two roll around on the ground, smashing each other in the face with punches that would kill a horse. Eventually, %hedgeknight1% squats on %hedgeknight2%'s shoulders. Seeing a rock nearby, %hedgeknight1% grabs it and cracks it over the opponent's skull. A bit of flesh is sheared off, revealing a slop of red and white beneath. The rock is brought down again. The brain pan splinters, shards of bone rupturing into fragments. %hedgeknight2% goes a bit limp, showing only a modicum of fight left in him. %hedgeknight1% punches a fist into the brainbox and rips out the namesake in one big gush of crimson. You gag at the sight, and a few of the company turn and vomit.\n\n%hedgeknight1% gets to his feet and throws the trophy into the tall grass. Wiping the forehead and saying only one word.%SPEECH_ON%Finished.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_35.png[/img]Te sientas en un tocón y contemplas el resto de la pelea. La pelea sigue por el suelo, entre revolcones y puñetazos a la cara que matarían a un caballo. Finalmente, %hedgeknight1% se pone en cuclillas sobre los hombros de %hedgeknight2%. Al ver una piedra cerca, %hedgeknight1% la agarra y la estrella contra el cráneo de su contrincante. Se desprende un trozo de carne y deja al descubierto un revoltijo rojo y blanco. La piedra vuelve a caer. La bóveda del cráneo se astilla y las esquirlas de hueso estallan en fragmentos. %hedgeknight2% se queda medio inerte, con apenas un resto de fuerzas para pelear. %hedgeknight1% hunde el puño en la caja de los sesos y arranca de cuajo lo que le da nombre en un gran chorro carmesí. Se te revuelve el estómago ante la escena, y unos cuantos de la compañía se apartan para vomitar.\n\n%hedgeknight1% se pone en pie y arroja el trofeo entre la hierba alta. Se limpia la frente y dice una sola palabra.%SPEECH_ON%Se acabó.%SPEECH_OFF%"
    }
    // en = "Killed in a duel by <hedgeknight1:str>"
    // en base_es
    // en = "<actor:str_tag> has died"
    // en base_es
    // en = "<bro:str> suffers <injury:str>"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Melee Skill"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Melee Defense"
    // en base_es
    // context: hedgeknight_vs_hedgeknight_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]The monk nods, stepping forward and calmly walking between the two fighters. With hands raised, the fingers trailing to and fro as they mimic the shapes of old religious rites. the holy one speaks of the gods and how they judge folks for what they are and what they do. Some gods might find this battle favorable, but most would not. Most of all, though, the holy one says that if they truly wish to fight, then there is plenty of room for that after they die. However, if they kill one another, the loser is given great prestige in the afterlife, and the winner will not, for this violence serves no purpose than to give the victor pride. Surprisingly, this oddity in religious rules calms the fighters down. The monk invites them to talk more and they do so, the three walking off, hands gesticulating, backs arching in bellowing laughter. As for the rest of the company, they just seem happy nobody got killed."
        es = "[img]gfx/ui/events/event_05.png[/img]La figura religiosa de la compañía asiente, da un paso al frente y camina con calma hasta interponerse entre los dos contendientes. Con las manos en alto y los dedos moviéndose de un lado a otro, imitando las formas de viejos ritos religiosos, el alma santa habla de los dioses y de cómo juzgan a la gente por lo que es y por lo que hace. Puede que a algunos dioses esta pelea les agrade, pero a la mayoría no. Y, sobre todo, el alma santa les dice que, si de verdad quieren pelear, ya tendrán ocasión de sobra después de morir. Sin embargo, si se matan entre sí, quien pierda recibirá un gran prestigio en el más allá, y quien gane no, pues esta violencia no sirve más que para alimentar el orgullo de quien vence. Sorprendentemente, esta rareza de las normas religiosas calma a los contendientes. La figura religiosa los invita a seguir hablando y lo hacen; se alejan los tres gesticulando con las manos y doblándose de la risa. En cuanto al resto de la compañía, parece que solo se alegra de que nadie haya muerto."
    }
    // en = "<actor:str> gains <v:val_tag> Resolve"
    // en base_es
    // FILE: mod_legends\hooks\events\events\herbs_along_the_way_event.nut
    // context: herbs_along_the_way_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «este individuo» suaviza «this fool»; es «este idiota».
        en = "%terrainImage%While heading toward your destination, %volunteer% runs up to you with a bundle of herbs in hand. Now you know this fool knows nothing about plants or wildlife, but %they_volunteer% seems rather persistent in wanting to try them out. Something about 'hearing' of magical powers to be found in the essence of herbs. This talk gets the attention of a few others in the company. Soon, a number of them are asking to try out the 'medicine' for the good of their brothers."
        es = "%terrainImage%De camino a tu destino, %volunteer% se te acerca corriendo con un manojo de hierbas en la mano. Ahora bien, eres consciente de que %ese_volunteer% idiota no entiende nada de plantas ni de la vida silvestre, pero insiste bastante en querer probarlas. Algo de haber 'oído' que en la esencia de las hierbas se encuentran poderes mágicos. La charla llama la atención de unos cuantos más en la compañía. Pronto, varios de ellos piden probar la 'medicina' por el bien de sus hermanos."
    }
    // context: herbs_along_the_way_event.o.create.::Legends.Screens.hook()._screen.start.Options.insert().Text
    {
        en = "{We actually have a herbalist, you know? | Let's ask %herbalist%.}"
        es = "{En realidad tenemos a alguien que entiende de hierbas, ¿no? | Preguntémosle a %herbalist%.}"
    }
    // context: herbs_along_the_way_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: añade al final «eh, contendido» (con errata por «contenido»), que el inglés no tiene.
        en = "[img]gfx/ui/events/event_18.png[/img]From one end comes vomit and from the other shite. It appears the herbs were not worth a try after all. %volunteer% bravely elected %themselves_volunteer% ready to chow down on the mystery plants and, suffice it to say, the proportions which you are seeing come out of %them_volunteer% are definitely mystical in that strange, 'can the body really hold that much?', sort of way."
        es = "[img]gfx/ui/events/event_18.png[/img]Por un extremo sale vómito y por el otro, mierda. Parece que, después de todo, no valía la pena probar las hierbas. %volunteer% se ofreció con valentía a zamparse las plantas misteriosas y baste decir que las cantidades que ves salir de su cuerpo son decididamente místicas, de esa forma extraña del '¿de verdad cabe tanto en un cuerpo?'."
    }
    // context: herbs_along_the_way_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_40.png[/img]%herbalist% steps forward and carefully examines the herbs separating them into separate stacks. %SPEECH_ON%These ones will give you the runs, these will swell your tongue and these give you a nasty rash in the nethers...%SPEECH_OFF% As %they_herbalist% drones on %volunteer% suddenly seems a lot less eager to test the herbs and quietly backs off. The herbalist finishes his work and hands you the stack of medicinal herbs."
        es = "[img]gfx/ui/events/event_40.png[/img]%herbalist% da un paso al frente, examina con cuidado las hierbas y las va separando en montones. %SPEECH_ON%Estas te darán diarrea, estas te hincharán la lengua y estas te dejarán un sarpullido asqueroso en tus partes...%SPEECH_OFF% Mientras sigue con su perorata, a %volunteer% se le quitan de pronto las ganas de probar las hierbas y se retira en silencio. %Art_herbalist% herbolari%o_herbalist% termina su trabajo y te entrega el montón de hierbas medicinales."
    }
    // context: herbs_along_the_way_event.o.create.m.Screens.push().Options.Text
    {
        en = "A right jester you are."
        es = "Qué gracia tienes."
    }
    // en = "You gain <amount:val_tag> Medical Supplies"
    // en base_es
    // context: herbs_along_the_way_event.o.create.m.Screens.push().start.List.extend().::Legends.EventList.changeMood()
    {
        en = "Was useful in finding medicine"
        es = "Fue útil para encontrar medicina"
    }
    // context: herbs_along_the_way_event.o.onPrepareVariables._vars.push()
    // en = "herbalist"  // nombre de la variable de evento (%herbalist%), no se muestra
    // FILE: mod_legends\hooks\events\events\hidden_cache_forest_event.nut
    // context: hidden_cache_forest_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «al tropezar con él por accidente» pierde el golpe en el dedo del pie, que es el remate del chiste final.
        en = "[img]gfx/ui/events/event_25.png[/img]The forest is no friend of man which is why men of ill-repute sure love to put their keepsakes there. And today you've stumbled across one: a cache that %otherbrother% found by way of stubbing %their_otherbrother% toe on the edge of it. Digging out the crate and cracking it open, you find an assortment of weapons, armor, and gold. You clap the sellsword on the shoulder and thank him for %their_otherbrother% 'hard work'. %They_otherbrother% wags %their_otherbrother% boot around.%SPEECH_ON%Yessir, I've got a toe like the nose of a bloodhound.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_25.png[/img]El bosque no es amigo del hombre, y por eso a los hombres de mala reputación les encanta esconder allí sus tesoros. Y hoy te has topado con uno: un escondite que %otherbrother% encontró al darse con el dedo del pie contra su borde. Al desenterrar la caja y abrirla, encuentras un surtido de armas, armaduras y oro. Le das una palmada en el hombro %al_otherbrother% mercenari%o_otherbrother% y le agradeces su 'duro trabajo'. Agita la bota de un lado a otro.%SPEECH_ON%Sí, señor, tengo un dedo del pie que es como el hocico de un sabueso.%SPEECH_OFF%"
    }
    // en = "You gain <v:val_tag> Crowns"
    // en base_es
    // FILE: mod_legends\hooks\events\events\houndmaster_tames_wolf_event.nut
    // context: houndmaster_tames_wolf_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_44.png[/img]While traversing the forests of the realm, %houndmaster% the houndmaster has come to befriend a creature that's been trailing beside the company's march: a wolf. The houndmaster frequently remained in the rearguard, crouched low, hands at %their_houndmaster% side, locking eyes with the lone wolf for minutes on end. But today, using a bit of leftover meat, %they_houndmaster% plied the beast right into the middle of the camp. Now %they_houndmaster% squats at its side, dwarfed by its prominent, muscled withers, its pointed and attentive ears, and a lapping maw lined with mankilling canines.\n\n The rest of the men stand behind their weapons. One yells at the houndmaster to stop what %they_houndmaster% is doing. Another says the wolf can smell fear. Yet another throws a rock at it. The wolf winces, but doesn't react. Laughing, the houndmaster makes a 'tssst!' noise and points. The wolf launches forward, picking up the stone and bringing it back to the %person_houndmaster%. %They_houndmaster% rubs the beast's mane.%SPEECH_ON%See, easily trained, just like any dog. Only bigger, faster, and stronger. Smarter, too.%SPEECH_OFF%Its eyes meet yours. The wolf lays low, almost like a man bowing. %houndmaster% laughs again.%SPEECH_ON%See? It already knows who is alpha of this pack.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_44.png[/img]Mientras la compañía recorría los bosques del reino, %houndmaster%, que tiene buena mano con los perros, se ha hecho amig%o_houndmaster% de una criatura que venía siguiendo la marcha del grupo: un lobo. A menudo se quedaba en la retaguardia, agachad%o_houndmaster%, con las manos a los costados, sosteniéndole la mirada al lobo solitario durante minutos enteros. Pero hoy, con un poco de carne sobrante, ha atraído a la bestia hasta el mismísimo centro del campamento. Ahora está en cuclillas a su lado, empequeñecid%o_houndmaster% por su cruz prominente y musculosa, sus orejas puntiagudas y atentas y unas fauces babeantes repletas de colmillos capaces de matar a un hombre.\n\n El resto de los hombres se parapetan tras sus armas. Uno le grita que deje de hacer lo que está haciendo. Otro dice que el lobo huele el miedo. Otro más le tira una piedra al animal. El lobo se estremece, pero no reacciona. Entre risas, %houndmaster% chasquea la lengua con un '¡tssst!' y señala. El lobo sale disparado, recoge la piedra y se la trae de vuelta. Le frota la melena a la bestia.%SPEECH_ON%¿Ven? Se adiestra fácil, como cualquier perro. Solo que más grande, más rápido y más fuerte. Y más listo, también.%SPEECH_OFF%Sus ojos se encuentran con los tuyos. El lobo se agacha, casi como un hombre que hace una reverencia. %houndmaster% vuelve a reír.%SPEECH_ON%¿Lo ves? Ya sabe quién es el alfa de esta manada.%SPEECH_OFF%"
    }
    // en = "Managed to tame a wolf"
    // en base_es
    // FILE: mod_legends\hooks\events\events\how_far_is_the_sun_event.nut
    // context: how_far_is_the_sun_event.o.create.s.Text
    {
        // corrige base: «su presunta suma precisa» traduce mal «summation», que aquí es su cálculo o conclusión, no una suma.
        en = "[img]gfx/ui/events/event_05.png[/img]While resting, the men start a conversation about how far away the sun is. %otherbrother% looks up at it, wincing and gritting %their_other% teeth as %they_other% just about blinds %themselves_other% in %their_other% measuring. Finally, %they_other% looks back down.%SPEECH_ON%I'd wager it's about ten to fifteen miles away.%SPEECH_OFF%%They_other% nods at %their_other% own presumably accurate summation.%SPEECH_ON%Aye, probably not even that far. I heard a story about an archer in a faraway land hitting it with an arrow.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_05.png[/img]Mientras descansan, los hombres se ponen a discutir a qué distancia está el sol. %otherbrother% lo mira, haciendo una mueca y apretando los dientes, y casi se queda cieg%o_other% al medirlo. Al final, vuelve a bajar la vista.%SPEECH_ON%Apostaría a que está a unas diez o quince millas.%SPEECH_OFF%Asiente ante su propio cálculo, presuntamente certero.%SPEECH_ON%Sí, puede que ni siquiera tan lejos. Oí una historia sobre un arquero de una tierra lejana que le dio con una flecha.%SPEECH_OFF%"
    }
    // context: how_far_is_the_sun_event.o.create.s.start.Options.insert().Text
    {
        en = "Our southern ascetic has lived %their_dervish% life under %their_dervish% Gilder's embrace, surely %they_dervish% have an idea"
        es = "Nuestr%o_dervish% asceta del sur ha vivido toda su vida en el abrazo del Dorado; seguro que tiene alguna idea"
    }
    // context: how_far_is_the_sun_event.o.create.s.start.Options.insert().getResult
    // en = "Dervish"  // identificador de pantalla del evento (getResult), no se muestra
    // context: how_far_is_the_sun_event.o.create.s.start.Options.insert().Text
    {
        // Text = "Our %southerner% from the learned south must surely have gleamed the truth of this?",
        mode = "pattern"
        en = "Our %southerner% from the learned south must surely have gleamed the truth of this?"
        es = "Seguro que %southerner%, que viene del docto sur, conoce la verdad de esto, ¿no?"
    }
    // context: how_far_is_the_sun_event.o.create.s.start.Options.insert().getResult
    // en = "Southerner"  // identificador de pantalla del evento (getResult), no se muestra
    // context: how_far_is_the_sun_event.o.create.s.Text
    {
        // corrige base: «comienza la conversación» traduce mal «starts in on» (se suma a ella); «cerebrito» no es «fool»; «Bastante absurdo» rebaja «Pretty dumb shite».
        en = "[img]gfx/ui/events/event_05.png[/img]%historian% the historian starts in on the conversation.%SPEECH_ON%I doubt the veracity of that claim about shooting it with a bow. Here's a much more truthful tale I've read of: there are men in the mountains of the east who have big spyglasses to stare up at the night sky. They think the sun is quite far away. At least ten thousand miles, even. They also think the nightlights are other suns and not the souls of dead heroes.%SPEECH_OFF%%otherbrother% gets up.%SPEECH_ON%Watch yer mouth, fool, and don't speak ill of our ancestors.%SPEECH_OFF%The historian nods.%SPEECH_ON%Of course! It was only an idea.%SPEECH_OFF%What hogwash. Pretty dumb shite for a supposed 'smart' %person_historian% like %historian%. A few of the brothers have a laugh at the historian's silly notions."
        es = "[img]gfx/ui/events/event_05.png[/img]%historian%, que sabe de historia, se suma a la conversación.%SPEECH_ON%Dudo de la veracidad de eso de que le dispararon con un arco. Aquí va un relato mucho más verídico que he leído: en las montañas del este hay hombres con grandes catalejos para contemplar el cielo nocturno. Creen que el sol está bastante lejos. A diez mil millas como poco, incluso. También creen que las luces de la noche son otros soles y no las almas de héroes muertos.%SPEECH_OFF%%otherbrother% se levanta.%SPEECH_ON%Cuidado con lo que dices, imbécil, y no hables mal de nuestros antepasados.%SPEECH_OFF%%Art_historian% erudit%o_historian% asiente.%SPEECH_ON%¡Claro! Solo era una idea.%SPEECH_OFF%Qué sarta de tonterías. Menuda mierda estúpida para alguien supuestamente 'list%o_historian%' como %historian%. Unos cuantos hermanos se ríen de las ideas absurdas %del_historian% erudit%o_historian%."
    }
    // en = "Entertained by <historian:str>'s silly notions about the sun"
    // en base_es
    // en = "Encouraged by <monk:str>'s preaching"
    // en base_es
    // context: how_far_is_the_sun_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]%cultist% the cultist gets up and looks at the sun. As %they_cultist% continues to stare at it, a shadow slowly emerges over %their_cultist% face, as though some entity were shielding %them_cultist% from the light. Suddenly, %they_cultist% raises a hand and starts drawing some aerial rites with %their_cultist% hand. You swear the darkness on %their_cultist% face is moving as though an imprint of %their_cultist% drawings, a sort of shifting tattoo. When %they're_cultist% finished, %they_cultist% takes a seat.%SPEECH_ON%The sun is dying.%SPEECH_OFF%The men look concerned. One interjects.%SPEECH_ON%Dying? What do you mean?%SPEECH_OFF%%cultist% stares at him.%SPEECH_ON%Davkul wills it that all may die.%SPEECH_OFF%One man asks if this supposed 'Davkul' will die too. The cultist nods.%SPEECH_ON%When there is nothing left to die, Davkul may finally rest. A crueler god would have departed already. It is by Davkul's good graces that he will go last, and for that we praise him.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_05.png[/img]%cultist%, %art_cultist% cultista, se levanta y mira al sol. Mientras sigue mirándolo fijamente, una sombra va cubriéndole poco a poco el rostro, como si alguna entidad %lo_cultist% protegiera de la luz. De pronto, alza una mano y empieza a trazar ritos en el aire. Jurarías que la oscuridad de su rostro se mueve como si fuera la huella de sus trazos, una especie de tatuaje cambiante. Cuando termina, toma asiento.%SPEECH_ON%El sol se está muriendo.%SPEECH_OFF%Los hombres parecen preocupados. Uno interviene.%SPEECH_ON%¿Muriendo? ¿Qué quieres decir?%SPEECH_OFF%%cultist% clava la mirada en él.%SPEECH_ON%Es voluntad de Davkul que todo muera.%SPEECH_OFF%Un hombre pregunta si ese supuesto 'Davkul' morirá también. %Art_cultist% cultista asiente.%SPEECH_ON%Cuando ya no quede nada por morir, Davkul por fin podrá descansar. Un dios más cruel ya se habría marchado. Por la gracia de Davkul, él se irá el último, y por eso lo alabamos.%SPEECH_OFF%"
    }
    // en = "Relished the opportunity to talk about the dying sun"
    // en base_es
    // en = "Relished <cultist:str>'s speech about the dying sun"
    // en base_es
    // en = "Angry about the heretical ramblings of <cultist:str>"
    // en base_es
    // en = "Terrified at the prospect of a dying sun"
    // en base_es
    // context: how_far_is_the_sun_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]%archer% takes the challenge, grabbing %their_archer% bow and a couple of arrows. %They_archer% licks %their_archer% finger and holds it up.%SPEECH_ON%Wind's right for a good star shootin'.%SPEECH_OFF%The archer nocks an arrow, draws, and takes aim. The blistering light is instantly blinding.%SPEECH_ON%Fark, I can't see shit.%SPEECH_OFF%%Their_archer% aim wobbles as dark spots take over %their_archer% vision. The arrow is loosed and sails wide of the sun. Real wide. %They_archer% looks at the company, eyes dimmed, hands out as %they_archer% tries to steady %themselves_archer% while %their_archer% sight returns.%SPEECH_ON%Did I hit it?%SPEECH_OFF%%otherbrother% hides %their_other% chuckling.%SPEECH_ON%Right on the button!%SPEECH_OFF%The men burst into laughter."
        es = "[img]gfx/ui/events/event_05.png[/img]%archer% acepta el reto y agarra su arco y un par de flechas. Se chupa el dedo y lo levanta.%SPEECH_ON%El viento sopla justo como para dispararle a una estrella.%SPEECH_OFF%%Art_archer% arquer%o_archer% encaja una flecha, tensa y apunta. La luz abrasadora %lo_archer% ciega al instante.%SPEECH_ON%Maldita sea, no veo una mierda.%SPEECH_OFF%La puntería se le tambalea mientras unas manchas oscuras le invaden la vista. Suelta la flecha, que pasa muy lejos del sol. Pero muy lejos. Mira a la compañía con los ojos nublados y las manos extendidas, intentando mantener el equilibrio mientras recupera la vista.%SPEECH_ON%¿Le di?%SPEECH_OFF%%otherbrother% disimula la risa.%SPEECH_ON%¡De lleno!%SPEECH_OFF%Los hombres estallan en carcajadas."
    }
    // context: how_far_is_the_sun_event.o.create.m.Screens.push().Text
    {
        // Text = "[img]gfx/ui/events/event_161.png[/img]%southerner% the southerner shakes %their_southerner% head and addresses the group. %SPEECH_ON%I\'m not sure on the specifics, but I have heard some varied ideas from the south. Apparently, learned men in their halls of wisdom know the exact distance, but greedily hoard it. Others claim the wise scholars lie, and that the sun cannot be measured. I don\'t really know, but I hear it can cause upset amongst the elite of the south. Street preachers claim that the sun is personal to those who view it, but I don\'t see how that can be true…%SPEECH_OFF%A few brothers grumble at such inconclusive answers, with one brother interrupting the southerner before they can continue.%SPEECH_ON%So, they don\'t have a farkin\' clue then?%SPEECH_OFF%The southerner ponders it for a moment, then agrees. Many of the company erupt into laughter and perhaps take pleasure in the fact that even the learned men of the south struggle over this age-old question. To their credit, the southerner joins in with the cheer, themselves likely having come to the blunt yet potent conclusion many times before: We don\'t have a farkin\' clue.",
        mode = "pattern"
        en = "[img]gfx/ui/events/event_161.png[/img]%southerner% the southerner shakes %their_southerner% head and addresses the group. %SPEECH_ON%I'm not sure on the specifics, but I have heard some varied ideas from the south. Apparently, learned men in their halls of wisdom know the exact distance, but greedily hoard it. Others claim the wise scholars lie, and that the sun cannot be measured. I don't really know, but I hear it can cause upset amongst the elite of the south. Street preachers claim that the sun is personal to those who view it, but I don't see how that can be true…%SPEECH_OFF%A few brothers grumble at such inconclusive answers, with one brother interrupting the southerner before they can continue.%SPEECH_ON%So, they don't have a farkin' clue then?%SPEECH_OFF%The southerner ponders it for a moment, then agrees. Many of the company erupt into laughter and perhaps take pleasure in the fact that even the learned men of the south struggle over this age-old question. To their credit, the southerner joins in with the cheer, themselves likely having come to the blunt yet potent conclusion many times before: We don't have a farkin' clue."
        es = "[img]gfx/ui/events/event_161.png[/img]%southerner%, %art_southerner% sureñ%o_southerner%, niega con la cabeza y se dirige al grupo. %SPEECH_ON%No conozco los detalles, pero he oído ideas muy variadas en el sur. Por lo visto, los hombres doctos, en sus salones del saber, conocen la distancia exacta, pero se la guardan con codicia. Otros dicen que esos sabios eruditos mienten y que el sol no se puede medir. No lo sé bien, pero he oído que el tema causa desazón entre la élite del sur. Los predicadores callejeros dicen que el sol es algo personal para quien lo mira, pero no veo cómo puede ser eso cierto…%SPEECH_OFF%Algunos hermanos refunfuñan ante respuestas tan poco concluyentes, y uno de ellos interrumpe %al_southerner% sureñ%o_southerner% antes de que pueda continuar.%SPEECH_ON%O sea, ¿que no tienen ni puta idea?%SPEECH_OFF%%Art_southerner% sureñ%o_southerner% lo medita un momento y luego le da la razón. Muchos en la compañía estallan en carcajadas y quizá disfrutan de que incluso los sabios del sur se rompan la cabeza con esta pregunta tan vieja como el mundo. Hay que reconocer que %art_southerner% sureñ%o_southerner% se suma a la juerga, seguramente porque ya ha llegado muchas veces a la misma conclusión, tan tosca como contundente: no tenemos ni puta idea."
    }
    // context: how_far_is_the_sun_event.o.create.m.Screens.push().Options.Text
    {
        en = "All those tomes, yet so few answers..."
        es = "Tantos libros y tan pocas respuestas..."
    }
    // context: how_far_is_the_sun_event.o.create.m.Screens.push().start.entry.::Legends.EventList.changeMood()
    {
        en = "Happy to share tales of southern beliefs"
        es = "Le alegró compartir historias de creencias sureñas"
    }
    // context: how_far_is_the_sun_event.o.create.m.Screens.push().start.entry.::Legends.EventList.changeMood()
    {
        en = "Amused by tales of southern indecision"
        es = "Le divirtieron las historias sobre la indecisión sureña"
    }
    // context: how_far_is_the_sun_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_161.png[/img]%Dervish% the dervish lets out a plain smile, as though %they_dervish% was waiting for such a question for some time. %They_dervish% places %themselves_dervish% before the rest of the company and opens %their_dervish% arms towards the sun, graciously absorbing its heat for %themselves_dervish%. Confidently, %they_dervish% proclaims.%SPEECH_ON%The answer you seek cannot come from others - only you can know how close you are to our guiding sun.%SPEECH_OFF%A few of the company look on visibly taken aback and confused. One brother manages to capture the mood perfectly with a loud 'huh?'. The ascetic, still basking in the sun, elaborates %their_dervish% point.%SPEECH_ON%The Gilder above grants us the sun, both as a reward and punishment - the same sun that warms your bones on a cold day can scorch your skin. How close the sun is depends on your relationship with the Gilder: if you serve him loyally and well, the sun reaches balance and offers sublime radiance. If you are wicked and resist the Gilder, the sun ebbs and flows between scorching heat and frigid cold.%SPEECH_OFF%A few brothers scoff at such a silly notion, a sun that is personal to everyone beneath it? Many quickly shrug it off and go back to their own theories, some pulling at their collars and wiping sweat from their brows. The dervish, pleased with %their_dervish% speech, returns to the company. You spot a faint smile, but notably not a single bead of sweat on %them_dervish% as %they_dervish% gleefully listens to the company bounce between %their_dervish% own theories, like a father listening to nonsense ramblings of his children."
        es = "[img]gfx/ui/events/event_161.png[/img]%Dervish%, %art_dervish% derviche, esboza una sonrisa sencilla, como si llevara tiempo esperando una pregunta así. Se planta ante el resto de la compañía y abre los brazos hacia el sol, absorbiendo con elegancia su calor. Con aplomo, proclama:%SPEECH_ON%La respuesta que buscan no puede venir de otros: solo ustedes pueden saber lo cerca que están de nuestro sol guía.%SPEECH_OFF%Algunos en la compañía miran con evidente desconcierto. Un hermano logra captar a la perfección el ambiente con un sonoro '¿eh?'. %Art_dervish% asceta, que sigue disfrutando del sol, desarrolla su idea.%SPEECH_ON%El Dorado nos concede desde lo alto el sol, como recompensa y como castigo: el mismo sol que te calienta los huesos en un día frío puede abrasarte la piel. Lo cerca que esté el sol depende de tu relación con el Dorado: si le sirves bien y con lealtad, el sol alcanza el equilibrio y ofrece un resplandor sublime. Si eres malvado y te resistes al Dorado, el sol oscila entre un calor abrasador y un frío glacial.%SPEECH_OFF%Algunos hermanos se burlan de una idea tan absurda: ¿un sol que es personal para todo el que está bajo él? Muchos se olvidan del asunto enseguida y vuelven a sus propias teorías; algunos se tiran del cuello de la camisa y se secan el sudor de la frente. %Art_dervish% derviche, satisfech%o_dervish% con su discurso, vuelve con la compañía. Distingues una leve sonrisa, pero, cosa notable, ni una sola gota de sudor en %el_dervish%, mientras escucha encantad%o_dervish% cómo la compañía salta de una teoría a otra, como quien escucha los disparates de sus hijos."
    }
    // context: how_far_is_the_sun_event.o.create.m.Screens.push().Options.Text
    {
        en = "It is a rather hot day, isn't it?"
        es = "Hace bastante calor hoy, ¿no?"
    }
    // context: how_far_is_the_sun_event.o.create.m.Screens.push().start.entry.::Legends.EventList.changeMood()
    {
        en = "Bathed in the Gilder's resplendent light"
        es = "Se bañó en la resplandeciente luz del Dorado"
    }
    // context: how_far_is_the_sun_event.o.onPrepareVariables._vars.push()
    // en = "dervish"  // nombre de la variable de evento (%dervish%), no se muestra
    // context: how_far_is_the_sun_event.o.onPrepareVariables._vars.push()
    // en = "southerner"  // nombre de la variable de evento (%southerner%), no se muestra
    // FILE: mod_legends\hooks\events\events\hunt_food_event.nut
    // context: hunt_food_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_10.png[/img]{As you help %otherguy% get their boot out of the mud, %hunter% comes out of the bushes with what must be nearly a dozen rabbits strung together, sets them down and starts to untie them. The little bunnies - eyes wide, horrified in the end - all look quite tasty. The hunter grabs one by its neck and twists its body in a circle before pushing all its guts out in one swift motion. The process is repeated until every rabbit has been slaughtered. As %hunter% wipes hands on %otherguy%'s cloak, the hunter points to the mound of emptied bunnies on the ground.%SPEECH_ON%That there is the eating pile.%SPEECH_OFF% Then points to the lump of rabbit guts.%SPEECH_ON%That there is not the eating pile. Got it? Good.%SPEECH_OFF%  | %hunter% ran on ahead of the party a few hours ago and just now you catch back up. The hunter is standing with a foot on a dead deer, its chest punctured by a single arrow. As you approach, the hunter grins, steps off and says if some of the company can help string it up, it can be skinned and prepared. | Forest birds chitter and chatter above the company's march. The sun winks between the canopy branches, a soft glint that peppers the ground with dots of light. You spot a squirrel resting in one of the sun beams, enjoying the warmth as it gnaws on an acorn. It stops, sensing you watching it, and then it suddenly jerks and a fleck of its blood meets your cheek. You wipe it away, turning back to see that the squirrel has been impaled by an arrow, every shrieking death throe quieter than the last as the volume of its life slowly turns down. %hunter% suddenly breaks through the bushes with a bow in hand and a grinning face. The hunter retrieves the kill and throws it in with a litter of others, a long hunter's line around which are tied all manner of critters foe and friend alike.}"
        es = "[img]gfx/ui/events/event_10.png[/img]{Mientras ayudas a %otherguy% a sacar la bota del barro, %hunter% sale de entre los arbustos con lo que deben de ser casi una docena de conejos atados en ristra, los deja en el suelo y empieza a desatarlos. Los conejitos, con los ojos muy abiertos y horrorizados al final, tienen todos una pinta de lo más sabrosa. Agarra uno por el cuello, le retuerce el cuerpo en círculo y le saca todas las tripas de un solo movimiento rápido. Repite el proceso hasta acabar con todos los conejos. Mientras se limpia las manos en la capa de %otherguy%, %hunter% señala el montón de conejos vaciados en el suelo.%SPEECH_ON%Ese es el montón de comer.%SPEECH_OFF% Luego señala el amasijo de tripas de conejo.%SPEECH_ON%Ese no es el montón de comer. ¿Entendido? Bien.%SPEECH_OFF%  | %hunter% se adelantó al grupo hace unas horas y justo ahora le das alcance. Está con un pie sobre un ciervo muerto, con el pecho atravesado por una sola flecha. Al acercarte, sonríe, se baja del ciervo y dice que, si algunos de la compañía ayudan a colgarlo, se podrá desollar y preparar. | Los pájaros del bosque gorjean y parlotean sobre la marcha de la compañía. El sol guiña entre las ramas del dosel, un destello suave que salpica el suelo de puntos de luz. Ves una ardilla descansando en uno de los rayos de sol, disfrutando del calor mientras roe una bellota. Se detiene, al notar que la observas, y de pronto da una sacudida y una gota de su sangre te salpica la mejilla. Te la limpias y te vuelves para ver que la ardilla ha quedado atravesada por una flecha; cada estertor chillón es más débil que el anterior, a medida que el volumen de su vida va bajando poco a poco. De repente, %hunter% irrumpe entre los arbustos con un arco en la mano y una sonrisa en la cara. Recoge la presa y la echa junto a otras muchas, en una larga cuerda de caza a la que hay atados bichos de toda clase, amigos y enemigos por igual.}"
    }
    // FILE: mod_legends\hooks\events\events\imprisoned_wildman_event.nut
    // context: imprisoned_wildman_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_100.png[/img]The animal tamer leads you to a carriage. You immediately see why his hired hands quit: a frenzied and mercurial feral human is sitting inside the cage. Raw wrists bleed against shackles, signs of attempted escapes. Half-starved, the wild human gnaws on sticks poking out from a tumbleweed of hair. Seeing this sad sight, you grab the stranger by his shirt and slam him against the wagon.%SPEECH_ON%Does that look like an animal to you?%SPEECH_OFF%The animal tamer grins, ivory for teeth. He explains himself.%SPEECH_ON%Cityfolk have gotten wind of the 'uncivilized' humans and wish to see them up close. I am only fulfilling this new demand as any businessman would. Now, all I need help with is to get that dead body out of the cage.%SPEECH_OFF%He points toward a corpse in the corner of the cage. The wildling rears back, snarling, and goes to protectively sit on the body. The animal tamer shakes his head.%SPEECH_ON%One of my helpers got too close and, well, yeah. I can't go into town with that mess in there so I thought maybe you could help me fish it out. I'll pay plenty, of course. A pouch of 250 crowns sound good to you? Just reach on in there and yank that garbage out.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_100.png[/img]El domador de animales te lleva hasta un carruaje. Enseguida ves por qué renunciaron sus empleados: dentro de la jaula hay un ser humano asilvestrado, frenético y voluble. Las muñecas en carne viva sangran contra los grilletes, señales de intentos de fuga. Muerta de hambre, la criatura salvaje mordisquea los palos que asoman de una maraña de pelo. Al ver tan triste escena, agarras al desconocido por la camisa y lo estampas contra la carreta.%SPEECH_ON%¿Te parece que eso es un animal?%SPEECH_OFF%El domador sonríe, con dientes de marfil. Se explica.%SPEECH_ON%A la gente de ciudad le ha llegado el rumor de los humanos 'incivilizados' y quiere verlos de cerca. Yo solo atiendo esta nueva demanda, como haría cualquier hombre de negocios. Ahora, lo único en lo que necesito ayuda es en sacar ese cadáver de la jaula.%SPEECH_OFF%Señala un cadáver en el rincón de la jaula. La criatura salvaje se echa hacia atrás, gruñendo, y se sienta sobre el cuerpo para protegerlo. El domador niega con la cabeza.%SPEECH_ON%Uno de mis ayudantes se acercó demasiado y, bueno, ya ves. No puedo entrar en el pueblo con ese desastre ahí dentro, así que pensé que quizá podrías ayudarme a sacarlo. Pagaré bien, por supuesto. ¿Qué te parece una bolsa de 250 coronas? Solo tienes que meter la mano y sacar esa basura de un tirón.%SPEECH_OFF%"
    }
    // en = "Alright, I'll send a man in."
    // en base_es
    // context: imprisoned_wildman_event.o.create.s.start.Options.push().Text
    {
        en = "We got our own wildling who could help."
        es = "Tenemos a alguien salvaje que puede ayudar."
    }
    // context: imprisoned_wildman_event.o.create.s.start.Options.push().Text
    {
        en = "Our holy one seems a little disturbed by this."
        es = "Esto parece perturbar un poco a nuestra alma santa."
    }
    // en = "I won't put the life of my men at risk for this."
    // en base_es
    // context: imprisoned_wildman_event.o.create.s.Text
    {
        // corrige base: «terrario lleno de cadáveres»: en la jaula hay un solo cadáver.
        // corrige base: «¡Fácil!» traduce mal «Easy!», que aquí pide calma.
        en = "[img]gfx/ui/events/event_100.png[/img]%taskedbro% is the one tasked with cleaning out the wildling's corpse-featured terrarium. %They_other% rolls up %their_other% sleeves and approaches the cage with both hands out.%SPEECH_ON%Whoa there, easy now. Easy!%SPEECH_OFF%The wildling gets up off the dead body and goes to the other side of its habitat. The sellsword easily grabs the boot of the corpse and drags it toward the bars. It slips through with sickening ease, already clumped up in the fashion of discarded wet clothes. Guts and limbs dribble off the edge of the wagon's platform. The animal tamer cheers happily.%SPEECH_ON%Thank you so much! And you made it look so easy, too!%SPEECH_OFF%%taskedbro% stares at the dead body with the realization that could have easily been %their_other% end.%SPEECH_ON%Yeah. You're welcome.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_100.png[/img]A %taskedbro% le toca limpiar el terrario, cadáver incluido, de la criatura salvaje. Se arremanga y se acerca a la jaula con las dos manos por delante.%SPEECH_ON%Eh, calma. Calma, ¿eh? ¡Calma!%SPEECH_OFF%La criatura salvaje se levanta del cadáver y se va al otro lado de su hábitat, lo que permite agarrar sin dificultad la bota del cadáver y arrastrarlo hasta los barrotes. Se cuela entre ellos con una facilidad repugnante, ya hecho un amasijo, como ropa mojada tirada en un rincón. Tripas y miembros chorrean por el borde de la plataforma de la carreta. El domador aplaude encantado.%SPEECH_ON%¡Muchísimas gracias! ¡Y encima hiciste que pareciera muy fácil!%SPEECH_OFF%%taskedbro% contempla el cadáver al darse cuenta de que ese podría haber sido su final.%SPEECH_ON%Sí. De nada.%SPEECH_OFF%"
    }
    // context: imprisoned_wildman_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_100.png[/img]%taskedbro% is tasked with getting the corpse out of the habitat.  Approaching the cage like a harlot streetwalking a particularly pious town. When geting close the bars, %taskedbro%  smiles like an old friend.%SPEECH_ON%Hey there buddy. That's a nice corpse you got there. A great corpse, truly one of the best I've ever seen. How about I just... take it... out...%SPEECH_OFF%When the mercenary reaches in, the wildling swipes out. It's too fast to even see. %taskedbro% slowly turns around. There's a black hole where one of %their_other% eyes used to be. The wildling squishes the eye between its teeth, a white goop bursting forth like a popped pustule, and it turns into a filmy paste as it chews. The animal tamer throws you a sack of crowns and runs off.%SPEECH_ON%Not liable! I am not liable!%SPEECH_OFF%%taskedbro% passes out as a few vengeful brothers stab the imprisoned wildling to death. All the caged beasts roar up as though you'd just slain their leader. You quickly order the mercenaries away from the caravan before one of its beasts gets free and causes more damage."
        es = "[img]gfx/ui/events/event_100.png[/img]A %taskedbro% le encargan sacar el cadáver del hábitat. Se acerca a la jaula como una ramera que hace la calle en un pueblo especialmente piadoso. Al llegar junto a los barrotes, %taskedbro% sonríe como si viera a un viejo amigo.%SPEECH_ON%Hola, amigo. Qué buen cadáver tienes ahí. Un cadáver estupendo, de verdad, de los mejores que he visto. ¿Qué tal si yo solo lo... saco... de ahí...?%SPEECH_OFF%Cuando mete la mano, la criatura salvaje lanza un zarpazo. Es demasiado rápido para verlo siquiera. %taskedbro% se da la vuelta despacio. Hay un agujero negro donde antes tenía un ojo. La criatura salvaje aplasta el ojo entre los dientes; un pringue blanco revienta como una pústula y se convierte en una pasta viscosa mientras mastica. El domador te lanza un saco de coronas y sale corriendo.%SPEECH_ON%¡No soy responsable! ¡Yo no soy responsable!%SPEECH_OFF%%taskedbro% se desmaya mientras unos cuantos hermanos sedientos de venganza matan a puñaladas a la criatura salvaje enjaulada. Todas las bestias de las jaulas rugen a la vez, como si acabaras de matar a su líder. Ordenas rápidamente a los mercenarios que se alejen de la caravana antes de que alguna de sus bestias se suelte y cause más daños."
    }
    // context: imprisoned_wildman_event.o.create.s.Text
    {
        // corrige base: «tapa con sus pulgares los ojos» no traduce «corks his thumbs into the man's eyes», que es hundirle los pulgares en los ojos.
        en = "[img]gfx/ui/events/event_100.png[/img]If anyone in the party could help talk the caged wildling down, it's probably %wildman%. Who goes to the cage and stares in. There's an exchange of hoots. Your wildling raps the bars with a knuckle, and the prisoner raps back and hoots somberly. Suddenly, %wildman% grabs the animal tamer by the head and drives him into the bars. You go to save the tamer, but the imprisoned wildling soars across the cage with atavistic terror in %they_wildman% eyes. Stepping back for your own safety, you can only watch as this bestial human sets upon the tamer. Both wildlings pull and drag on the man's face. The concussed man groggily yells.%SPEECH_ON%I thought we had an agreeeeeemeeeaahh!%SPEECH_OFF%%wildman% corks %their_wildman% thumbs into the man's eyes while the imprisoned wildling grips the tamer's mouth and pulls down. His head is literally ripped apart by the seams and sinews. A few men vomit as the tamer's brains falls out where his tongue should be, a truly awful way of speaking one's mind. The 'warden' taken care of, %wildman% looks at you and at the wildling with a sort of 'can we keep 'em?' gesture."
        es = "[img]gfx/ui/events/event_100.png[/img]Si alguien del grupo puede calmar a la criatura salvaje enjaulada, seguramente sea %wildman%, que se acerca a la jaula y mira dentro. Hay un intercambio de ululatos. Tu salvaje golpea los barrotes con un nudillo, y la criatura cautiva responde con otros golpes y ulula con tristeza. De pronto, %wildman% agarra al domador por la cabeza y lo estampa contra los barrotes. Vas a salvar al domador, pero la criatura enjaulada cruza la jaula de un salto con un terror atávico en los ojos. Retrocedes por tu propia seguridad y solo puedes mirar cómo ese ser bestial se ensaña con el domador. Ambas criaturas salvajes tiran de la cara del hombre y la desgarran. El hombre, conmocionado, grita aturdido.%SPEECH_ON%¡Creía que teníamos un acueeeerdoooaaah!%SPEECH_OFF%%wildman% le hunde los pulgares en los ojos mientras la criatura cautiva le agarra la boca y tira hacia abajo. La cabeza se le parte literalmente por las costuras y los tendones. Unos cuantos hombres vomitan cuando los sesos del domador se le caen por donde debería estar la lengua: una forma verdaderamente horrible de soltar lo que uno tiene en la cabeza. Despachado el 'carcelero', %wildman% te mira a ti y a la criatura salvaje con un gesto de '¿nos la quedamos?'."
    }
    // context: imprisoned_wildman_event.o.create.s.Options[0].Text
    {
        en = "Absolutely disgusting. It's perfect."
        es = "Absolutamente asqueroso. Es perfecto."
    }
    // context: imprisoned_wildman_event.o.create.s.Options[1].Text
    {
        en = "No, it's clearly far too dangerous."
        es = "No, está claro que es demasiado peligroso."
    }
    // context: imprisoned_wildman_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_100.png[/img]An outstanding capacity for violence is well-suited to a mercenary band. You agree to take the imprisoned wildling on."
        es = "[img]gfx/ui/events/event_100.png[/img]Una capacidad para la violencia fuera de lo común le viene como anillo al dedo a una banda de mercenarios. Aceptas acoger a la criatura salvaje que estaba enjaulada."
    }
    // en = "the Animal"
    // en base_es
    // context: imprisoned_wildman_event.o.create.s.start._event.m.Dude.getBackground().m.RawDescription
    {
        en = "%name% was 'saved' by you during a confrontation with an animal tamer-turned-enslaver. A sense of gratitude and debt overcomes any language barriers: the once imprisoned wildling serves the company loyally for the rescue."
        es = "Tú 'salvaste' a %name% durante un enfrentamiento con un domador de animales metido a esclavista. Un sentimiento de gratitud y de deuda supera cualquier barrera del idioma: tras su cautiverio, sirve con lealtad a la compañía en pago por el rescate."
    }
    // context: imprisoned_wildman_event.o.create.s.Text
    {
        // corrige base: añade «se gira a ti» y «desaparecer», que el inglés no tiene.
        en = "[img]gfx/ui/events/event_100.png[/img]You don't think the imprisoned wildling would fit in with the company, but you do set it free nonetheless. It shoots out the cage like a banshee and runs for the tree line. There it stands at a distance hooting and hollering until it runs off again."
        es = "[img]gfx/ui/events/event_100.png[/img]No crees que la criatura salvaje enjaulada encaje en la compañía, pero aun así la liberas. Sale disparada de la jaula como una banshee y corre hacia la linde del bosque. Allí se queda, a cierta distancia, ululando y chillando, hasta que vuelve a salir corriendo."
    }
    // context: imprisoned_wildman_event.o.create.s.Options[0].Text
    {
        // corrige base: falta «su»: es su manera de dar las gracias, no una manera en general.
        en = "I guess that's its way of saying thanks."
        es = "Supongo que es su manera de dar las gracias."
    }
    // context: imprisoned_wildman_event.o.create.s.Text
    {
        // corrige base: «la cabeza prestada hacia adelante» calca la errata «borrowed» del inglés; es «bowed», la cabeza inclinada.
        en = "[img]gfx/ui/events/event_100.png[/img]%monk% the monk steps forth, hands clasped, head bowed forward. The embodiment of a sermon, the posture of good morals, or misguided ones. %They_monk% pulls the tamer aside.%SPEECH_ON%The old gods would frown upon what you have done here.%SPEECH_OFF%The animal tamer laughs and leans against the cage, smugly crossing his arms. He states that in the south they consider slavery a part of the natural order. The monk continues.%SPEECH_ON%True, but neither you nor this wildman are kin to their way of life. You wish to enslave due to being an outsider. They do not understand the relationship which makes it especially grievous and improper. My suggestion is to have employ the wildman and learn from you. Foster friendship and you will have a friend for life-%SPEECH_OFF%The imprisoned wildman's hands dart through the bars and his fingers dig into the tamer's eyeballs. His face is ripped apart like a loaf of old bread, a couple of coathangers for a jawbone, a tongue lolling like an uprooted snake. %monk% vomits as his face is doused in blood. %otherbrother% shakes %their_other% head.%SPEECH_ON%I'd say we have a new recruit...%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_100.png[/img]%monk%, %art_monk% religios%o_monk%, da un paso al frente, con las manos juntas y la cabeza inclinada. La encarnación de un sermón, la postura de la buena moral, o de una moral equivocada. Se lleva aparte al domador.%SPEECH_ON%Los viejos dioses desaprobarían lo que has hecho aquí.%SPEECH_OFF%El domador se ríe y se apoya en la jaula, cruzándose de brazos con suficiencia. Afirma que en el sur consideran la esclavitud parte del orden natural. %Art_monk% religios%o_monk% continúa.%SPEECH_ON%Cierto, pero ni tú ni quien está en esa jaula pertenecen a esa forma de vida. Quieres esclavizar a alguien por ser de fuera. No comprende la relación, y eso lo hace especialmente grave e indebido. Mi consejo es que le des trabajo y que aprenda de ti. Cultiva su amistad y tendrás una amistad para toda la vida-%SPEECH_OFF%De pronto, unas manos salen disparadas entre los barrotes y los dedos se hunden en los globos oculares del domador. La cara se le desgarra como una hogaza de pan duro: un par de perchas por mandíbula, una lengua colgando como una serpiente arrancada de raíz. %monk% vomita con la cara empapada de sangre. %otherbrother% niega con la cabeza.%SPEECH_ON%Yo diría que tenemos un nuevo recluta...%SPEECH_OFF%"
    }
    // context: imprisoned_wildman_event.o.create.s.start._event.m.Monk.worsenMood()
    {
        en = "Shaken by the violence they witnessed"
        es = "Le impactó la violencia que presenció"
    }
    // FILE: mod_legends\hooks\events\events\jousting_tournament_event.nut
    // context: jousting_tournament_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]%jouster% comes to you with a paper in hand. Slamming it on your table and saying they wish to enter. You pick up the scroll, unfurling it to show that a local town is hosting a jousting tournament. The mercenary crosses arms, awaiting your response."
        es = "[img]gfx/ui/events/event_05.png[/img]%jouster% se te acerca con un papel en la mano. Lo estampa sobre tu mesa y te dice que quiere participar. Tomas el pergamino y, al desenrollarlo, ves que en una ciudad cercana se celebra un torneo de justas. Se cruza de brazos y espera tu respuesta."
    }
    // context: jousting_tournament_event.o.create.s.Text
    {
        // corrige base: «Pajes» traduce «Squires», cuyo término fijado es «Escuderos».
        // corrige base: «Le preguntas por qué» traduce mal «You ask what for»: se pregunta sobre qué es la apuesta.
        en = "[img]gfx/ui/events/event_96.png[/img]You agree to let %jouster% go to the tournament and, wanting to see it for yourself, you go along, too.\n\nThe jousting tourney crackles with energy as you near it. Squires hurry to and fro, carrying great armfulls of armor and weapons, and some step slowly about with enormous lances hefted over their shoulders. Other men brush very regal looking horses, many of which wear breastplates decorated with sigils. In the distance, you listen to brief gallops, heavy hooves stamping roughshod and lumbering and then there's a snapping twang of wood on metal and cheers erupt.\n\nAs you look about the festivities, a nobleman walks up and stops you. Weighing a purse in one hand and twisting a piece of broomstraw about the corner of his mouth with the other, he asks if you'd like to make a wager. You ask what for. He nods, pointing toward %jouster% who is across the mustering point signing themself into the tourney. Apparently he is to face this nobleman's own rider, a man by the name of %opponent%.%SPEECH_ON%A little bit of gamesmanship never hurt, no? How does %bet% crowns sound to you? Winner take all, of course.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_96.png[/img]Aceptas dejar que %jouster% vaya al torneo y, con ganas de verlo con tus propios ojos, también vas.\n\nEl torneo de justas bulle de energía a medida que te acercas. Los escuderos corren de un lado a otro, cargados con grandes brazadas de armaduras y armas, y algunos caminan despacio con enormes lanzas al hombro. Otros hombres cepillan caballos de aspecto muy regio, muchos de los cuales llevan petos adornados con blasones. A lo lejos oyes breves galopes, pesados cascos que golpean el suelo con estrépito, y luego un chasquido seco de madera contra metal, y estallan los vítores.\n\nMientras recorres los festejos, un noble se te acerca y te detiene. Sopesando una bolsa en una mano y haciendo girar con la otra una brizna de paja de escoba en la comisura de la boca, te pregunta si te gustaría hacer una apuesta. Le preguntas sobre qué. Asiente y señala a %jouster%, que al otro lado del punto de reunión se está inscribiendo en el torneo. Por lo visto, le toca enfrentarse al jinete del propio noble, un tal %opponent%.%SPEECH_ON%Un poco de picardía nunca hizo daño, ¿no? ¿Qué te parecen %bet% coronas? El ganador se lo lleva todo, claro.%SPEECH_OFF%"
    }
    // context: jousting_tournament_event.o.create.s.Text
    {
        // corrige base: «en el próximo reino» calca «next realm», que aquí es el otro mundo, el más allá.
        en = "[img]gfx/ui/events/event_96.png[/img]You take a seat amongst commoners and noblemen alike. Only the local lord has any separation from the riff-raff, sitting on a heightened row with the likes of his sons, daughters, and various royalty from around the land.\n\n%jouster% is up next, a squire helping lead the horse to one of the jousting lanes. Down the battleline, %opponent% rides onto the field, his horse black, his armor a vibrant purple with gold trimmings and tassels here and there. Both he and %jouster% take up their lances and slap down the faceplates of their helmets.\n\nA barker shouts their names from the royal-box, and then a clergyman says a few words about how this was ordained by the gods and, were anybody here to die today, they'd sit amongst the greatest of men in the next realm, and be remembered with them in this one. All that said, the two jousters lower their lances and charge before either the barker or priest can even take a seat."
        es = "[img]gfx/ui/events/event_96.png[/img]Tomas asiento entre plebeyos y nobles por igual. Solo el señor local se mantiene apartado de la chusma, sentado en una grada elevada junto a sus hijos, sus hijas y diversos miembros de la realeza de toda la comarca.\n\nAhora le toca a %jouster%; un escudero ayuda a llevar el caballo hasta una de las pistas de justa. Al otro extremo de la liza, %opponent% entra a caballo en el campo; su caballo es negro y su armadura, de un morado vibrante con ribetes dorados y borlas aquí y allá. Tanto él como %jouster% toman sus lanzas y se bajan de golpe la visera del yelmo.\n\nUn pregonero grita sus nombres desde el palco real, y luego un clérigo pronuncia unas palabras sobre cómo esto lo han dispuesto los dioses y sobre cómo, si alguien muriera hoy aquí, se sentaría entre los más grandes de los hombres en el otro mundo y sería recordado junto a ellos en este. Dicho todo esto, los dos justadores bajan las lanzas y cargan antes de que el pregonero o el sacerdote puedan siquiera sentarse."
    }
    // context: jousting_tournament_event.o.create.s.Text
    {
        // corrige base: «Nunca has estado en un evento así, y aún así» invierte la causa: no puedes evitar contener el aliento precisamente porque nunca has estado en algo así.
        en = "[img]gfx/ui/events/event_96.png[/img]Having never been to such an event, you can't help but hold your breath as the two riders barrel down the lanes toward each other. The horses are majestic, their legs in rhythm, their hooves tearing up great clods of earth, their armors glinting sundots across the crowds as they run, altogether leaving in their wake streams of giddy observers and shouting kids and drunks spilling their raised mugs and young princesses gripping their dresses and wantingly brave princes clapping their hands and, not knowing how it even came to be, you yourself are standing and shouting.\n\n %opponent% struggles to keep his aim steady, his lance bobbing up and down, the point of it wobbling in search of a true target.\n\n They don't find it."
        es = "[img]gfx/ui/events/event_96.png[/img]Como nunca has estado en un evento así, no puedes evitar contener el aliento mientras los dos jinetes se lanzan a toda velocidad, uno contra otro, por las pistas. Los caballos son majestuosos, las patas acompasadas, los cascos arrancando grandes terrones, las armaduras lanzando destellos de sol sobre la multitud mientras corren, y dejan a su paso oleadas de espectadores entusiasmados y niños que gritan y borrachos que derraman las jarras alzadas y jóvenes princesas que se aferran a sus vestidos y príncipes deseosos de ser valientes que aplauden y, sin saber siquiera cómo ha ocurrido, tú mismo estás de pie y gritando.\n\n %opponent% lucha por mantener firme la puntería; la lanza sube y baja, y la punta se tambalea en busca de un blanco certero.\n\n No lo encuentra."
    }
    // context: jousting_tournament_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_96.png[/img]%jouster%'s lance shatters on their opponent's chest, a proverbial explosion of sawdust and splinters through which rides a horse with no rider, the jouster having been driven back over his cantle and clear of his saddle altogether, coming facedown on the battleground with nary a move or breath. A roar bursts from the crowd, an uncorked tempest which you are quick to join, drowning your ears in a blistering cacophony, swept up in a time and place you will never forget."
        es = "[img]gfx/ui/events/event_96.png[/img]La lanza de %jouster% se hace añicos contra el pecho del rival: una auténtica explosión de aserrín y astillas entre la que pasa al galope un caballo sin jinete, pues el justador ha salido despedido hacia atrás por encima del arzón y fuera de la silla por completo, y ha caído de bruces sobre el campo sin moverse ni respirar. Un rugido estalla entre la multitud, una tempestad descorchada a la que te sumas enseguida, ahogando tus oídos en una cacofonía ensordecedora, arrastrado por un momento y un lugar que nunca olvidarás."
    }
    // context: jousting_tournament_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_96.png[/img]%jouster%'s lance shatters on their opponent's chest, a proverbial explosion of sawdust and splinters through which rides a horse with no rider, the jouster having been driven back over his cantle and clear of his saddle altogether, coming facedown on the battleground with nary a move or breath. A roar bursts from the crowd, an uncorked tempest which you are quick to join, drowning your ears in a blistering cacophony, swept up in a time and place you will never forget.\n\nWhile still celebrating, the nobleman you made a wager with comes over and places a purse into your hand. You wish to say a few words, but before you can he angrily turns and walks off."
        es = "[img]gfx/ui/events/event_96.png[/img]La lanza de %jouster% se hace añicos contra el pecho del rival: una auténtica explosión de aserrín y astillas entre la que pasa al galope un caballo sin jinete, pues el justador ha salido despedido hacia atrás por encima del arzón y fuera de la silla por completo, y ha caído de bruces sobre el campo sin moverse ni respirar. Un rugido estalla entre la multitud, una tempestad descorchada a la que te sumas enseguida, ahogando tus oídos en una cacofonía ensordecedora, arrastrado por un momento y un lugar que nunca olvidarás.\n\nMientras aún lo celebras, el noble con quien apostaste se acerca y te pone una bolsa en la mano. Quieres decirle unas palabras, pero antes de que puedas, se da la vuelta, furioso, y se va."
    }
    // context: jousting_tournament_event.o.create.s.Text
    {
        // corrige base: «Nunca has estado en un evento así, y aún así» invierte la causa: no puedes evitar contener el aliento precisamente porque nunca has estado en algo así.
        en = "[img]gfx/ui/events/event_96.png[/img]Having never been to such an event, you can't help but hold your breath as the two riders barrel down the lanes toward each other. The horses are majestic, their legs in rhythm, their hooves tearing up great clods of earth, their armors glinting sundots across the crowds as they run, altogether leaving in their wake streams of giddy observers and shouting kids and drunks spilling their raised mugs and young princesses gripping their dresses and wantingly brave princes clapping their hands and, not knowing how it even came to be, you yourself are standing and shouting.\n\n%jouster% struggles to keep their aim steady, lance bobbing up and down, the point of it wobbling in search of a true target.\n\n They don't find it."
        es = "[img]gfx/ui/events/event_96.png[/img]Como nunca has estado en un evento así, no puedes evitar contener el aliento mientras los dos jinetes se lanzan a toda velocidad, uno contra otro, por las pistas. Los caballos son majestuosos, las patas acompasadas, los cascos arrancando grandes terrones, las armaduras lanzando destellos de sol sobre la multitud mientras corren, y dejan a su paso oleadas de espectadores entusiasmados y niños que gritan y borrachos que derraman las jarras alzadas y jóvenes princesas que se aferran a sus vestidos y príncipes deseosos de ser valientes que aplauden y, sin saber siquiera cómo ha ocurrido, tú mismo estás de pie y gritando.\n\n%jouster% lucha por mantener firme la puntería; la lanza sube y baja, y la punta se tambalea en busca de un blanco certero.\n\n No lo encuentra."
    }
    // context: jousting_tournament_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_96.png[/img]%opponent%'s lance explodes as it lands square on %jouster%'s chest. Bent back in the saddle, a cloud of spinning splinters and powdered wood swirling in its wake. %jouster% reaches desperately for the reins. Finding them, you think they've recovered, but the bridlebit breaks off and the reins slip free. %jouster% falls backward, tumbling over the mount's hindquarters and landing feet first. Standing may be impressive, but %jouster% has lost.\n\nThe crowd erupts, clapping fervently to both winner and loser. Rolling their shoulder in a bit of pain, %jouster% clears the field. You find them back at the mustering grounds. %jouster% He says something was off about the lance, and you mention that the horse's bridlebit came loose. Just then, the winner walks by, a retinue of adoring women behind him and a squire leading a rather pompous looking horse. To your surprise, %opponent% and %jouster% shake hands and bid each other congratulations on a well-fought match."
        es = "[img]gfx/ui/events/event_96.png[/img]La lanza de %opponent% estalla al impactar de lleno en el pecho de %jouster%, que queda con el cuerpo doblado hacia atrás sobre la silla, entre una nube de astillas que giran y polvo de madera que se arremolina a su paso. Busca las riendas desesperadamente. Al encontrarlas, crees que se ha recuperado, pero el bocado se rompe y las riendas se escapan. %jouster% cae hacia atrás, rueda por encima de la grupa de la montura y aterriza de pie. Quedar en pie tendrá su mérito, pero %jouster% ha perdido.\n\nLa multitud estalla y aplaude con fervor tanto a quien gana como a quien pierde. Moviendo en círculos un hombro dolorido, %jouster% abandona el campo. Vuelves a encontrarte con %jouster% en la zona de reunión. Dice que a la lanza le pasaba algo raro, y tú comentas que se soltó el bocado del caballo. Justo entonces pasa el ganador, con un séquito de mujeres que lo adoran detrás y un escudero que lleva de las riendas un caballo de aspecto bastante pomposo. Para tu sorpresa, %opponent% y %jouster% se estrechan la mano y se felicitan mutuamente por un combate bien disputado."
    }
    // context: jousting_tournament_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_96.png[/img]%opponent%'s lance explodes as it lands square on %jouster%'s chest. The mercenary is bent back in his saddle, a cloud of spinning splinters and powdered wood swirling in its wake. %jouster% reaches desperately for the reins. Finding them, you think they've recovered, but the bridlebit breaks off and the reins slip free. %jouster% falls backward, tumbling over the mount's hindquarters and landing feet first. Standing may be impressive, but %jouster% has lost.\n\n The crowd erupts, clapping fervently to both winner and loser. Rolling their shoulder in a bit of pain, %jouster% clears the field. You find them back at the mustering grounds. %jouster% says something was off about the lance, and you mention that the horse's bridlebit came loose. Just then, the winner walks by, a retinue of adoring women behind him and a squire leading a rather pompous looking horse. To your surprise, %opponent% and %jouster% shake hands and bid each other congratulations on a well-fought match. \n\n The nobleman you made a wager with isn't so keen on good sportsmanship. He comes to you rubbing his hands beneath a cheap grin. You begrudgingly pay the man what he is owed."
        es = "[img]gfx/ui/events/event_96.png[/img]La lanza de %opponent% estalla al impactar de lleno en el pecho de %jouster%, que queda con el cuerpo doblado hacia atrás sobre la silla, entre una nube de astillas que giran y polvo de madera que se arremolina a su paso. Busca las riendas desesperadamente. Al encontrarlas, crees que se ha recuperado, pero el bocado se rompe y las riendas se escapan. %jouster% cae hacia atrás, rueda por encima de la grupa de la montura y aterriza de pie. Quedar en pie tendrá su mérito, pero %jouster% ha perdido.\n\n La multitud estalla y aplaude con fervor tanto a quien gana como a quien pierde. Moviendo en círculos un hombro dolorido, %jouster% abandona el campo. Vuelves a encontrarte con %jouster% en la zona de reunión. Dice que a la lanza le pasaba algo raro, y tú comentas que se soltó el bocado del caballo. Justo entonces pasa el ganador, con un séquito de mujeres que lo adoran detrás y un escudero que lleva de las riendas un caballo de aspecto bastante pomposo. Para tu sorpresa, %opponent% y %jouster% se estrechan la mano y se felicitan mutuamente por un combate bien disputado. \n\n Al noble con quien apostaste no le va tanto la deportividad. Se te acerca frotándose las manos tras una sonrisa barata. A regañadientes, le pagas lo que se le debe."
    }
    // context: jousting_tournament_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_64.png[/img]Telling %jouster% no does not go over well. The mercenary goes on a great deal about how much money they could have made at the tournament and how you are robbing them of those crowns. All very interesting complaints, sure, until they turn to you and demands %compensation% crowns, compensation for claimed lost earnings."
        es = "[img]gfx/ui/events/event_64.png[/img]A %jouster% no le sienta nada bien la negativa. Se queja largo y tendido de cuánto dinero podría haber ganado en el torneo y de cómo le estás robando esas coronas. Quejas todas muy interesantes, sin duda, hasta que se vuelve hacia ti y exige %compensation% coronas como compensación por lo que asegura que son ganancias perdidas."
    }
    // context: jousting_tournament_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_64.png[/img]You stand up and pat %jouster% on the shoulder.%SPEECH_ON%I've no doubt that a mercenary of your skill and prowess would have run clean through the tournament. But I need you here, at camp. You need not prove any lost earnings, I will compensate you for them simply enough.%SPEECH_OFF%The rather diplomatic words calm them down. The mercenary nods and briefly looks as though it would be dishonorable to accept the payment. Not wanting the sellsword to test their resolve any further, or perhaps look a fool or of low honor, you order them to take it."
        es = "[img]gfx/ui/events/event_64.png[/img]Te levantas y le das una palmada en el hombro a %jouster%.%SPEECH_ON%No me cabe duda de que alguien con tu habilidad y tu destreza habría arrasado en el torneo. Pero te necesito aquí, en el campamento. No hace falta que demuestres ninguna ganancia perdida; te las compensaré sin más.%SPEECH_OFF%Las palabras, bastante diplomáticas, consiguen calmar los ánimos. Asiente y, por un momento, parece pensar que sería deshonroso aceptar el pago. Para no poner más a prueba su determinación, o quizá para que no quede en ridículo ni como alguien de poco honor, le ordenas que lo acepte."
    }
    // FILE: mod_legends\hooks\events\events\kids_and_dead_merchant_event.nut
    // context: kids_and_dead_merchant_event.o.create.s.Text
    {
        // corrige base: «más como un gato moribundo huyendo de un halcón en picada» cambia el sentido: el grito parece más de gato moribundo que de halcón en picada.
        // corrige base: omite el símil del trilero que desliza su cubilete sobre la bolita.
        en = "[img]gfx/ui/events/event_97.png[/img]Despite the miniature military force arrayed before you, the goods are ordered to be taken. The little tyke in charge of this operation screams a warcry more dying cat than diving hawk.%SPEECH_ON%Take them down! Throw! Throw! Throooowww!%SPEECH_OFF%On his command, the mob of children start hurling stones from the treeline. The sellswords band together, holding shields up in a formation akin to a tortoise, and slowly move forward. It's a strange effort, like a shell-game artist sliding his cup over the ball, but the company manages to grab the merchant's goods and slide away out of the field, all the while being pelted from every which way. The little leader kid shakes his fist at you. You give him the finger and start back onto the path where you take a good look at the merchant's goods. %randombrother% stares at the rewards while rubbing a welt on %their_randombrother% forehead.%SPEECH_ON%Goddam, man. I've seen armies not nearly so fierce. I weep for the future men who have to cross swords with those lads and lasses.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_97.png[/img]A pesar de la fuerza militar en miniatura desplegada ante ti, ordenas que se lleven las mercancías. El chiquillo al mando de la operación suelta un grito de guerra más propio de un gato moribundo que de un halcón en picada.%SPEECH_ON%¡Derríbenlos! ¡Tiren! ¡Tiren! ¡Tiiireeen!%SPEECH_OFF%A su orden, la turba de niños empieza a lanzar piedras desde la linde del bosque. Los mercenarios se agrupan, alzan los escudos en una formación parecida a una tortuga y avanzan despacio. Es un esfuerzo extraño, como el de un tahúr que desliza su cubilete sobre la bolita, pero la compañía consigue hacerse con las mercancías del comerciante y escabullirse del campo, recibiendo pedradas por todos lados. El pequeño cabecilla te amenaza con el puño. Le muestras el dedo medio y vuelves al camino, donde examinas bien las mercancías del comerciante. %randombrother% contempla el botín mientras se frota un chichón en la frente.%SPEECH_ON%Maldita sea, hombre. He visto ejércitos que no eran ni la mitad de feroces. Lloro por los hombres que en el futuro tengan que cruzar espadas con esos chicos y chicas.%SPEECH_OFF%"
    }
    // context: kids_and_dead_merchant_event.o.create.s.Text
    {
        // corrige base: «caballero andante» no es el término fijado para «hedge knight», que es «caballero errante».
        // corrige base: rebaja la crudeza: omite «some such shit» y «destrozaré sus cráneos» suaviza «smash their farkin' heads in».
        en = "[img]gfx/ui/events/event_35.png[/img]%hedgeknight% steps forward and heaves a weapon to the fore, waving it at all the kids.%SPEECH_ON%Ah, so you want to be little bandits or heroes or some such shit? Well, that's good. That's fine. But I'll be watching to see who throws the first stone. He, or she, who does so will find out what happens when I get angry. And then after the rest of you have watched, I'll kill the lot of you. And I'll follow your little footprints all the way home, find your kin, and smash their farkin' heads in.%SPEECH_OFF%The hedge knight pauses to glare about.%SPEECH_ON%So, which of you shall throw the first stone?%SPEECH_OFF%The tyke in charge of this miniature army raises his hand and speaks.%SPEECH_ON%Let them go. We've better things to do than quarrel with these travelers.%SPEECH_OFF%Hey, that's a wise move. With pride-swallowing smarts like that the red-headed bugger might someday lead a company to great fortunes. But this day is yours. You take the merchant's goods and make your leave."
        es = "[img]gfx/ui/events/event_35.png[/img]%hedgeknight% da un paso al frente, alza un arma y la agita ante todos los niños.%SPEECH_ON%Ah, ¿así que quieren ser pequeños bandidos o héroes o alguna mierda por el estilo? Bueno, eso está bien. Me parece bien. Pero voy a fijarme en quién tira la primera piedra. Quien lo haga, sea él o ella, descubrirá lo que pasa cuando me enojo. Y luego, cuando el resto lo haya visto, los mataré a todos. Y seguiré sus huellitas hasta su casa, encontraré a su familia y les reventaré la puta cabeza.%SPEECH_OFF%Hace una pausa y lanza miradas furibundas a su alrededor.%SPEECH_ON%Y bien, ¿quién de ustedes tirará la primera piedra?%SPEECH_OFF%El chiquillo al mando de este ejército en miniatura levanta la mano y habla.%SPEECH_ON%Déjenlos ir. Tenemos cosas mejores que hacer que pelearnos con estos viajeros.%SPEECH_OFF%Vaya, qué decisión tan sensata. Con esa astucia capaz de tragarse el orgullo, puede que algún día el bribón pelirrojo lleve a una compañía a grandes fortunas. Pero este día es tuyo. Tomas las mercancías del comerciante y te marchas."
    }
    // FILE: mod_legends\hooks\events\events\killer_vs_others_event.nut
    // context: killer_vs_others_event.o.create.s.Text
    {
        // corrige base: «manga de un pergamino» calca «scroll's sleeve»; es la funda o el estuche del pergamino
        // corrige base: «De hecho» calca «Indeed»; aquí es «En efecto»
        en = "[img]gfx/ui/events/event_06.png[/img]While you attempt to study some poorly drawn maps, the sound of blades being drawn pierces your ears. You roll up your work and put it into a scroll's sleeve before making way to the disturbance.\n\n%killerontherun% is being held down by one mercenary's knee, while %otherguy1% and %otherguy2% look about ready to chop a head off. Seeing your arrival, the mercenaries calm down for a moment. They explain that the killer tried to slay one of them. Indeed, the speaker has a nick on the neck. A little bit deeper and something other than words would be coming out right about now. The company demand %killerontherun% be hanged for this attempted murder."
        es = "[img]gfx/ui/events/event_06.png[/img]Mientras intentas estudiar unos mapas mal dibujados, el sonido de hojas desenvainándose te perfora los oídos. Enrollas tu trabajo y lo guardas en la funda de un pergamino antes de dirigirte hacia el alboroto.\n\nAlguien de la compañía mantiene a %killerontherun% contra el suelo con la rodilla, mientras %otherguy1% y %otherguy2% parecen a punto de cortar una cabeza. Al verte llegar, los mercenarios se calman por un momento. Explican que quien está en el suelo intentó matar a uno de ellos. En efecto, quien habla tiene un corte en el cuello. Un poco más hondo y ahora mismo estaría saliendo de ahí algo más que palabras. La compañía exige que ahorquen a %killerontherun% por este intento de asesinato."
    }
    // context: killer_vs_others_event.o.create.s.Options[0].Text
    {
        en = "Have the knave flogged for this."
        es = "Que azoten a esa rata por esto."
    }
    // context: killer_vs_others_event.o.create.s.Options[1].Text
    {
        en = "Have the villain hanged for this."
        es = "Que cuelguen a esa alimaña por esto."
    }
    // context: killer_vs_others_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_38.png[/img]You order the %person_killer% flogged. %killer% spits on your name as the brothers tie %them_killer% up to a tree. You say do that again and you'll add more lashings. They rip %their_killer% shirt off and take turns with the whip as you stand by the side, counting. On the first lash a straight line of skin is stripped from %their_killer% back. The man flinches and you hear the ropes that bind %them_killer% draw taut as %their_killer% hands clench into fists. By the fifth lashing %they_killer% is no longer standing. By the tenth %they_killer% is no longer awake. After five more you call it and order the men to take %them_killer% down and tend %their_killer% wounds."
        es = "[img]gfx/ui/events/event_38.png[/img]Ordenas que azoten %al_killer% asesin%o_killer%. %killer% escupe sobre tu nombre mientras los hermanos %lo_killer% atan a un árbol. Le dices que, si lo vuelve a hacer, añadirás más latigazos. Le arrancan la camisa y se turnan con el látigo mientras tú, a un lado, cuentas. Con el primer latigazo se le desprende de la espalda una tira recta de piel. %Art_killer% asesin%o_killer% se estremece y oyes tensarse las cuerdas que %lo_killer% sujetan mientras aprieta los puños. Al quinto latigazo ya no se tiene en pie. Al décimo ya ha perdido el conocimiento. Tras cinco más, das por terminado el castigo y ordenas a los hombres que %lo_killer% desaten y le curen las heridas."
    }
    // context: killer_vs_others_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_02.png[/img]You order the %person_killer% hanged. Half the company cheers and %killerontherun% screams a shriek rather suitable for seeing death ordered to %their_killer% side. They drag the killer beneath a tree. Ropes are thrown up over the branches, again and again, looping and drawing taut. One sellsword ties a noose while the others cheer and clap and drink beer. A stool is placed and the condemned is forced to stand on it. As %killerontherun%'s head is put into the noose, %they_killer% says %they_killer% has a word for all of you, but whatever %they_killer% has to say is cut off when %otherguy1% kicks the stool out from beneath %them_killer%.\n\nThis is not a good way to die. It is by an executioner's hand or means. Ordinarily being dropped from a platform breaks the neck, or is even decapitated. This one hangs choking and kicking. You hear some screams in %their_killer% lungs, but they struggle to get past %their_killer% throat. A few minutes pass and %they_killer% is still fighting. %otherguy2% steps over to the dying person, grabbing one of %their_killer% jerking feet to keep %them_killer% still, and with %their_otherguy2% free hand %they_otherguy2% stabs %killerontherun% in the heart. And that was that.\n\n{Surprisingly, the mercenaries agree to cut the %them_killer% down and bury %them_killer%. | %They_killer% is left hanging there when the company's march begins anew.}"
        es = "[img]gfx/ui/events/event_02.png[/img]Ordenas que ahorquen %al_killer% asesin%o_killer%. La mitad de la compañía lo celebra y %killerontherun% suelta un alarido muy propio de quien ve cómo mandan llamar a la muerte a su lado. %Lo_killer% arrastran bajo un árbol. Lanzan cuerdas por encima de las ramas, una y otra vez, que se enroscan y se tensan. Un mercenario anuda una soga mientras los demás vitorean, aplauden y beben cerveza. Colocan un taburete y obligan %al_killer% condenad%o_killer% a subirse. Cuando le meten la cabeza a %killerontherun% en el lazo, dice que tiene unas palabras para todos ustedes, pero lo que sea que quiera decir queda cortado cuando %otherguy1% le quita el taburete de una patada.\n\nNo es una buena forma de morir. No es obra de la mano ni del oficio de un verdugo. Lo normal es que la caída desde un cadalso rompa el cuello, o incluso arranque la cabeza. Aquí, en cambio, queda colgando, asfixiándose y pataleando. Oyes gritos en sus pulmones, pero les cuesta pasar de la garganta. Pasan unos minutos y aún forcejea. %otherguy2% se acerca %al_killer% moribund%o_killer%, le agarra uno de los pies, que no paran de sacudirse, para mantener%lo_killer% quiet%o_killer%, y con la mano libre apuñala a %killerontherun% en el corazón. Y ahí terminó todo.\n\n{Sorprendentemente, los mercenarios aceptan descolgar%lo_killer% y enterrar%lo_killer%. | Cuando la compañía reanuda la marcha, queda allí colgad%o_killer%.}"
    }
    // en = "<actor:str_tag> has died"
    // en base_es
    // context: killer_vs_others_event.o.create.s.start.::Legends.addFallen()
    {
        en = "Hanged for attempted murder"
        es = "Murió en la horca por intento de asesinato"
    }
    // en = "Got satisfaction with <killer:str>'s hanging"
    // en base_es
    // context: killer_vs_others_event.o.create.s.Text
    {
        // corrige base: «jurando» traduce mal «swearing», que aquí es maldecir
        // corrige base: «cuello cortado» exagera «nicked neck», que es un pequeño corte en el cuello
        en = "[img]gfx/ui/events/event_64.png[/img]While you try to bring peace between a party of misfits, your attempts for neutrality only seem to anger a few of them. In particular, the one with the nicked neck is seething, swearing and kicking things over. A few of the others worry aloud about a lack of discipline."
        es = "[img]gfx/ui/events/event_64.png[/img]Mientras intentas poner paz en un grupo de inadaptados, tus intentos de neutralidad solo parecen enfurecer a algunos. En particular, quien tiene el corte en el cuello está que echa chispas: maldice y vuelca cosas a patadas. Algunos de los demás expresan en voz alta su preocupación por la falta de disciplina."
    }
    // context: killer_vs_others_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_64.png[/img]The call for cooler heads to prevail seems to have failed as %killerontherun%'s body is found dead anyway. {It appears someone stabbed the killer in the back. | Someone garroted the killer with a line of strong linen. | %killerontherun% was nearly chopped in half, the work of a truly angry person. | %killerontherun%'s head was found resting next to %their_killer% chest, hands placed in such a manner as to be holding it. | Emphasis on the word 'body', as the head was nowhere to be found. | Someone had slit %killerontherun% 's throat in the night. | Bruises on the body and cuts on the hands suggests a fight, but whoever it was managed to gut the killer anyway.} You have a good guess as to who did it, but none of the mercenaries seem all that upset about the killer's death and certain proof would elude any kind of investigation. While all of that may be true, you still order the suspected mercenary to help bury the dead."
        es = "[img]gfx/ui/events/event_64.png[/img]El llamamiento a la calma parece haber fracasado, porque el cuerpo de %killerontherun% aparece sin vida de todos modos. {Parece que alguien apuñaló por la espalda %al_killer% asesin%o_killer%. | Alguien estranguló %al_killer% asesin%o_killer% con un cordel de lino resistente. | A %killerontherun% casi %lo_killer% parten por la mitad, obra de alguien verdaderamente furioso. | La cabeza de %killerontherun% apareció junto a su pecho, con las manos colocadas como si la sostuvieran. | Y hay que subrayar lo de 'cuerpo', porque la cabeza no aparece por ningún lado. | Alguien le había rajado el cuello a %killerontherun% durante la noche. | Las magulladuras del cuerpo y los cortes de las manos sugieren que hubo pelea, pero quienquiera que fuese logró destripar %al_killer% asesin%o_killer% de todos modos.} Te haces una buena idea de quién fue, pero ninguno de los mercenarios parece muy afectado por la muerte %del_killer% asesin%o_killer%, y cualquier investigación se quedaría sin pruebas concluyentes. Aun así, ordenas a quien crees culpable que ayude a enterrar el cuerpo."
    }
    // context: killer_vs_others_event.o.create.s.start.::Legends.addFallen()
    {
        en = "Murdered by his fellow comrades"
        es = "Murió a manos de sus camaradas"
    }
    // en = "Concerned about lack of discipline"
    // en base_es
    // context: killer_vs_others_event.o.create.s.Text
    {
        // corrige base: «incumplir sus órdenes» cambia de dueño las órdenes; «your orders» son las del capitán («tus órdenes»)
        // corrige base: «si continúa» cambia el sujeto; «if you continue» es «si continúas»
        en = "Well, %killerontherun% isn't dead, but %they_killer% stands before you broken and beaten. It looks like vengeful justice found %them_killer% out anyway. %They_killer% demands that some suspected brothers be punished for going around your orders. You consider this, but then ask the %person_killer% what will happen if you continue this cycle of violence. It's hard to see the %person_killer%'s face as it is puffed up in blacks and purples, and %their_killer% eyes are lost behind puckered lids, but %they_killer% nods gingerly. You are right, %they_killer% says. It is best to let this whole thing die down lest it get out of control."
        es = "Bueno, %killerontherun% no está muert%o_killer%, pero se presenta ante ti destrozad%o_killer% y apalead%o_killer%. Parece que la justicia vengativa %lo_killer% alcanzó de todos modos. Exige que se castigue a algunos hermanos sospechosos por saltarse tus órdenes. Lo consideras, pero luego le preguntas qué pasará si continúas con este ciclo de violencia. Cuesta verle la cara, hinchada de negros y morados, y sus ojos se pierden tras unos párpados abultados, pero asiente con cuidado. Tienes razón, dice. Es mejor dejar que todo esto se apague antes de que se descontrole."
    }
    // FILE: mod_legends\hooks\events\events\lawmen_after_criminal_event.nut
    // context: lawmen_after_criminal_event.o.create.s.Text
    {
        // corrige base: errata «Dicho hombre está en contigo»
        // corrige base: «cervices» no traduce «withers», que es la cruz del caballo
        // corrige base: «montura» por «pommel», que es la perilla de la silla
        // corrige base: «liberar a este criminal ante mí» calca «release to me»; es entregármelo
        en = "[img]gfx/ui/events/event_90.png[/img]Riders crest a nearby hill, their silhouettes dark and oddly shaped on its rim like a reef of rippling black. Not wholly able to see who they are, you order a few of your company to hide away. An ambush might be needed to defend yourself otherwise you stand no chance against such a mounted force. As the selected mercenaries dip into the bushes, the horsemen begin heading down the hill. The thunder of the hooves grows louder, but you stand resolute, hoping to give your men a good show of bravery.\n\nYou see that the bannerman is carrying a sigil of %noblehousename%. Behind him another horseman is dragging a travois with a few shackled men for cargo. When the men arrive, their leader stands up between the withers of his horse and points at you before talking.%SPEECH_ON%Mercenary! We have by the lord's authority the right to claim the - shackled! - hands of a %criminal%. This wretch is within your midst and must pay for past crimes. Hand the criminal over immediately and you will be rewarded.%SPEECH_OFF%You turn your head and spit. You nod at the lawman before asking him a question.%SPEECH_ON%And whose authority do you have? There are a lot of lords in these lands and not all of them pay me well.%SPEECH_OFF%The lawmen's captain sits back down in his saddle. His hands cross over his pommel, resting there with armored authority. He does not look the least bit amused and voices his displeasure as such.%SPEECH_ON%The punishment for willfully harboring a fugitive is death. You've but one more chance to release this criminal to me or you shall face a fate well suited for a sword-selling dog.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_90.png[/img]Unos jinetes coronan una colina cercana, con siluetas oscuras y de formas extrañas recortadas sobre la cresta, como un arrecife de negro ondulante. Como no alcanzas a ver bien quiénes son, ordenas a algunos de los tuyos que se escondan. Puede que haga falta una emboscada para defenderte; de lo contrario, no tendrías ninguna oportunidad contra una fuerza montada así. Mientras los mercenarios elegidos se agazapan entre los arbustos, los jinetes empiezan a bajar la colina. El estruendo de los cascos se hace más fuerte, pero te mantienes firme, con la esperanza de dar a tus hombres una buena muestra de valentía.\n\nVes que el abanderado lleva un emblema de %noblehousename%. Detrás de él, otro jinete arrastra una rastra con unos cuantos hombres encadenados como carga. Cuando llegan, su líder se incorpora sobre la cruz de su caballo y te señala antes de hablar.%SPEECH_ON%¡Mercenario! Por la autoridad de nuestro señor, tenemos derecho a reclamar las manos (¡encadenadas!) de %criminal%. Esa escoria está entre los tuyos y debe pagar por sus crímenes pasados. Entréganosla de inmediato y serás recompensado.%SPEECH_OFF%Giras la cabeza y escupes. Le haces un gesto con la cabeza al oficial de la ley antes de hacerle una pregunta.%SPEECH_ON%¿Y en nombre de qué autoridad hablas? Hay muchos señores en estas tierras y no todos me pagan bien.%SPEECH_OFF%El capitán de los hombres de la ley vuelve a sentarse en la silla. Cruza las manos sobre la perilla y las deja allí con acorazada autoridad. No parece hacerle ni pizca de gracia, y así lo manifiesta.%SPEECH_ON%El castigo por dar cobijo a sabiendas a un fugitivo es la muerte. Tienes una última oportunidad de entregarme a esa sabandija o correrás la suerte que merece un perro que vende su espada.%SPEECH_OFF%"
    }
    // context: lawmen_after_criminal_event.o.create.s.Options[0].Text
    {
        en = "The company would only suffer if we fought over this. The fugitive is yours."
        es = "La compañía solo sufriría si peleáramos por esto. Llévate a quien buscas."
    }
    // context: lawmen_after_criminal_event.o.create.s.Options[1].Text
    {
        // corrige base: «give him up» es entregarlo, no abandonarlo
        en = "We'll not give up our own."
        es = "No entregamos a los nuestros."
    }
    // context: lawmen_after_criminal_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_53.png[/img]You stand no chance against these men. Although it pains you mightily, you hand %criminal% over. Your former comrade barks curses at you as the lawmen lay on chains, and swears your name into the mud as they throw the fugitive in with the rest of the bound captives. The captain of the lawmen trots his horse over to you. He sneers at you before throwing a purse of coins to the ground. His body is close and there's an opening in his armor. You could fit a knife in there, right between the ribs, lead the blade right to his heart. It'd be quick. But you wouldn't last much long after, and all of your company would be quickly slain.\n\nInstead, you lean over and pick up the coins, swallow you pride, and say your thanks. The lawmen waste little time returning from whence they came."
        es = "[img]gfx/ui/events/event_53.png[/img]No tienes ninguna oportunidad contra estos hombres. Aunque te duele en el alma, entregas a %criminal%. Quien fue tu camarada te ladra maldiciones mientras los hombres de la ley le ponen las cadenas, y arrastra tu nombre por el barro cuando va a parar junto al resto de cautivos maniatados. El capitán de los hombres de la ley se acerca a ti al trote. Te mira con desprecio antes de arrojar al suelo una bolsa de monedas. Lo tienes cerca y hay una abertura en su armadura. Podrías meter un cuchillo ahí, justo entre las costillas, y llevar la hoja directa al corazón. Sería rápido. Pero no durarías mucho después, y toda tu compañía caería enseguida.\n\nEn vez de eso, te agachas, recoges las monedas, te tragas el orgullo y le das las gracias. Los hombres de la ley no tardan en volver por donde vinieron."
    }
    // context: lawmen_after_criminal_event.o.create.s.start.::Legends.addFallen()
    {
        en = "Handed over to authorities"
        es = "Quedó en manos de las autoridades"
    }
    // context: lawmen_after_criminal_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_78.png[/img]The captain hands you a scroll with %criminal%'s face on it. True, the resemblance is there. But the figutive has been in your company long enough to gain a scar or two. Maybe they won't recognise the image? You ask the criminal to step forward, who nervously, does as told. You look to the captain.%SPEECH_ON%Is this the one you are after? I can see why you might think this is similar, but look at these scars. The face in the drawing has none. And look at the hair! The one in the drawing is straight, and this head nest is clearly matted and curly.%SPEECH_OFF%You stop because judging by the faces of your audience this isn't even coming close to working. The captain draws his sword.%SPEECH_ON%Do you take me for a fool? Kill them all.%SPEECH_OFF%Well, so much for that. Before the lawmen can charge you whistle as loud as you can. Half the company surges forth from the bushes, whooping and hollering like banshees. The sudden fright drives the horses wild, pitching their riders into the dirt and the travois-puller even runs off altogether, carrying with it a couple of very confused criminals.\n\n%randombrother% comes charging across the field of mayhem with a spear in hand, and plunges it deep into the captain's steed, bringing both man and beast crashing to the ground. The lawmen, what's left of them, gather around their captain. Seemingly growling, the man wipes blood from his face and spits out a tooth. He grins a gapped smile before ordering his men to charge."
        es = "[img]gfx/ui/events/event_78.png[/img]El capitán te entrega un pergamino con el rostro de %criminal%. Es cierto, el parecido está ahí. Pero ha pasado en tu compañía tiempo suficiente para ganarse una cicatriz o dos. ¿Quizá no reconozcan el retrato? Pides a quien buscan que dé un paso al frente, y obedece con nerviosismo. Miras al capitán.%SPEECH_ON%¿Es a quien buscas? Entiendo que te parezca que se parece, pero mira estas cicatrices. La cara del dibujo no tiene ninguna. ¡Y mira el pelo! El del dibujo es lacio, y esta maraña está a todas luces apelmazada y rizada.%SPEECH_OFF%Te detienes porque, a juzgar por las caras de tu público, esto no se acerca ni de lejos a funcionar. El capitán desenvaina la espada.%SPEECH_ON%¿Me tomas por idiota? Mátenlos a todos.%SPEECH_OFF%Bueno, hasta ahí llegó eso. Antes de que los hombres de la ley puedan cargar, silbas tan fuerte como puedes. La mitad de la compañía surge de los arbustos, chillando y aullando como almas en pena. El susto repentino enloquece a los caballos, que arrojan a sus jinetes al suelo, y el que tiraba de la rastra incluso sale huyendo, llevándose consigo a un par de criminales muy desconcertados.\n\n%randombrother% cruza a la carga el campo del caos, lanza en mano, y la hunde a fondo en la montura del capitán, y hombre y bestia se estrellan contra el suelo. Los hombres de la ley, lo que queda de ellos, se reúnen en torno a su capitán. Casi gruñendo, se limpia la sangre de la cara y escupe un diente. Esboza una sonrisa mellada antes de ordenar a sus hombres que carguen."
    }
    // context: lawmen_after_criminal_event.o.create.s.Text
    {
        // corrige base: «pómeles» no existe; «pommels» son las perillas de la silla
        // corrige base: «Hacer tu mejor esfuerzo para no reír» es agramatical
        // corrige base: «lleno de mentiras» rebaja «full of shit»
        // corrige base: «que se escucha hasta la noche» es un añadido que el inglés no tiene
        en = "[img]gfx/ui/events/event_12.png[/img]You walk directly toward the captain, stopping halfway between your men and his. With your fists to your hips, you call out to the captain's lawmen, asking if they know the name of the %companyname%. You see a few of the riders shift up on their saddles, balancing tented arms on their pommels as they stare intently at your banner. They quickly sit back down and hushed whispers trickle down and back up their battle line.\n\nOne man calls out, asking if it's true that you shorn the noses of those you slay. It is not true, but you've no reason to spill the truth. Another man asks if %randombrother% is in your ranks, and has a necklace of ears and eats bonemeal for breakfast. You stifle the urge to laugh, only nodding in return. Quite naturally, the rumors overtake your opponents and they begin to cry out that this fight is not theirs to have.\n\nThe captain tells them that you're full of shit and to charge, but none follow his orders. Eventually, the captain is forced to turn back, heading after his men who are now in retreat.\n\nThe supposed cannibal walks up, scratching their head.%SPEECH_ON%Bonemeal for breakfast?%SPEECH_OFF%A crackle of laughter rips through the company and soon a chant of 'don't eat me!' is to be had."
        es = "[img]gfx/ui/events/event_12.png[/img]Caminas directamente hacia el capitán y te detienes a medio camino entre tus hombres y los suyos. Con los puños en las caderas, les gritas a los hombres de la ley del capitán y les preguntas si conocen el nombre de %companyname%. Ves que algunos jinetes se incorporan en la silla, apoyando los brazos flexionados sobre la perilla mientras miran fijamente tu estandarte. Enseguida vuelven a sentarse y unos susurros apagados recorren su línea de batalla de un extremo a otro.\n\nUn hombre grita para preguntar si es cierto que les cortas la nariz a quienes matas. No es cierto, pero no tienes motivo para revelar la verdad. Otro pregunta si %randombrother% está en tus filas y si lleva un collar de orejas y desayuna harina de huesos. Contienes las ganas de reír y te limitas a asentir. Como era de esperar, los rumores se apoderan de tus oponentes y empiezan a gritar que esta pelea no les corresponde.\n\nEl capitán les dice que no dices más que mierdas y que carguen, pero ninguno sigue sus órdenes. Al final, el capitán se ve obligado a dar media vuelta y salir tras sus hombres, que ya están en retirada.\n\nQuien supuestamente es caníbal se acerca, rascándose la cabeza.%SPEECH_ON%¿Harina de huesos para desayunar?%SPEECH_OFF%Un estallido de carcajadas recorre la compañía y pronto se arma un cántico de '¡no me comas!'."
    }
    // FILE: mod_legends\hooks\events\events\lend_men_to_build_event.nut
    // context: lend_men_to_build_event.o.create.s.Options[1].Text
    {
        en = "Alright, I can spare a hand or few."
        es = "De acuerdo, puedo prestarte unas cuantas manos."
    }
    // context: lend_men_to_build_event.o.create.s.Options[0].Text
    {
        en = "Don't get too used to this kind of work, mercenaries."
        es = "No se acostumbren demasiado a este tipo de trabajo, mercenarios."
    }
    // context: lend_men_to_build_event.o.create.s.start.World.FactionManager.getFaction(_event.m.Town.getFactions()[0]).addPlayerRelation()
    {
        en = "You lend some help to build a mill"
        es = "Prestaste ayuda para construir un molino"
    }
    // en = "You gain <v:val_tag> Crowns"
    // en base_es
    // en = "Helped build a mill"
    // en base_es
    // context: lend_men_to_build_event.o.create.s.Text
    {
        // corrige base: «con TUS coronas» es un añadido; el inglés solo dice que le pagará las coronas al barón
        // corrige base: «El hombre local» calca «The local man»; es «El lugareño»
        en = "[img]gfx/ui/events/event_79.png[/img]You agree to help the man. Unfortunately, it appears as though he didn't plan things out too well. The rooftop collapses the second one of your 'laborers' steps foot on it, sending them through a sinkhole of shingles. Another mercenary hammers a nail into place only for the wooden support to splinter right in two, catching them in the face with shards of wood. Loose bricks find freedom, wet mud has them slipping, and all manner of workplace hazards ends the whole project in disaster.\n\n The local man apologizes profusely in between biting his nails and wondering how he's going to deal with the baron. Snapping his fingers, he exclaims that he'll just pay him the crowns."
        es = "[img]gfx/ui/events/event_79.png[/img]Aceptas ayudar al hombre. Por desgracia, parece que no planeó muy bien las cosas. El tejado se derrumba en cuanto uno de tus 'trabajadores' pone un pie encima, y acaba colándose por un sumidero de tejas. Otro mercenario clava un clavo, pero el soporte de madera se parte en dos y le estalla en la cara una lluvia de astillas. Los ladrillos sueltos encuentran la libertad, el barro mojado hace resbalar a todo el mundo y toda clase de peligros laborales acaban convirtiendo el proyecto en un desastre.\n\nEl lugareño se deshace en disculpas entre mordisco y mordisco a las uñas, mientras se pregunta cómo va a arreglárselas con el barón. Chasquea los dedos y exclama que, sin más, le pagará las coronas."
    }
    // en = "Helped build a mill without getting paid"
    // en base_es
    // FILE: mod_legends\hooks\events\events\location\abandoned_village_enter_event.nut
    // context: abandoned_village_enter_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «espadachín» por «sellsword»; el término fijado es «mercenario»
        // corrige base: «Al fondo del libro» calca «At the back of the book»; es «Al final del libro»
        en = "[img]gfx/ui/events/event_178.png[/img]{You stand over one of the...things you just fought. %randombrother% curls a blade underneath the goop and holds it up. A great mop of flesh elongates in stitched segments, arms spindling out like they were the branches of a tree, fat chunks sliding down the appendages like sap. The rest are incongruencies left and right: here a foot hanging from a torso like a doorhandle, there a face spreading apart as if melting into a river of sinews and ligaments. When your sellsword lets it slide off %their_randombrother% blade, the fleshbag slops into the ground, the bones rattling like a collapsing rope ladder. %randombrother2% walks up with a quiver of arrows and a small book.%SPEECH_ON%Got this quiver of, uh, interesting arrows. Looks like some sort of reservoir in the bottom of it is for dipping the arrowheads. The old gods know what that material is. I also found this here book tethered to one of their heads. Seems important.%SPEECH_OFF%Opening the book, you find lists of villages with lines crossing them out one by one, and beside each is a simple number. Fifty. Sixty. Seventy. At the back of the book you find a map to another location, what appears to be some sort of estate.}"
        es = "[img]gfx/ui/events/event_178.png[/img]{Te detienes sobre uno de los... bichos que acabas de derrotar. %randombrother% desliza una hoja bajo la baba y la levanta. Un enorme amasijo de carne se estira en tramos cosidos, con brazos que se ramifican como si fuesen las ramas de un árbol, y trozos gruesos que resbalan por los miembros como savia. El resto son incongruencias por todas partes: aquí un pie que cuelga de un torso como el tirador de una puerta, allí un rostro que se abre como si se derritiera en un río de tendones y ligamentos. Cuando tu mercenari%o_randombrother% lo deja resbalar de la hoja, el saco de carne cae al suelo con un chapoteo, y los huesos repiquetean como una escalera de cuerda desplomándose. %randombrother2% se acerca con un carcaj de flechas y un pequeño libro.%SPEECH_ON%Encontré este carcaj de, eh, flechas interesantes. Parece que tiene una especie de depósito en la base para mojar las puntas. Solo los antiguos dioses saben de qué material es. También encontré este libro atado a una de sus cabezas. Parece importante.%SPEECH_OFF%Al abrir el libro, encuentras listas de aldeas tachadas una a una, y junto a cada una un simple número. Cincuenta. Sesenta. Setenta. Al final del libro encuentras un mapa que lleva a otro lugar, lo que parece ser algún tipo de finca.}"
    }
    // FILE: mod_legends\hooks\events\events\location\artifact_reliquary_enter_event.nut
    // context: artifact_reliquary_enter_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: añade un salto de párrafo antes de «La compañía» que el inglés no tiene
        en = "[img]gfx/ui/events/event_182.png[/img]{The estate towers over the area with pure cut stoneworks and colored roofing tiles. It has something most royalty cannot afford, which is a sense of taste. With grass trimmed low, the lawn seemed almost like a footprint unto an unkept land. Statues of people dot the landscape, capturing poses both regaling and regretful. Amidst the crowd of sculptures are hedges cut into the shapes of animals and fountains with clear water in them. The company stands outside a black fence, idling and staring through the bars like farm animals. %randombrother% shakes %their_randombrother% head and spits.%SPEECH_ON%Yeah, it's all quite pretty and all, but no deep pocket fark is just gonna leave the front gate open like this for no reason, ya know? I think either somebody has already ran through the place, or something awful is inside and it don't mind the occasional innocent passerby.%SPEECH_OFF%You agree. When looking further in, you can see the path leads to a bowled out decline, as if the gods had knuckled a bit of the earth itself with overhangs and escarpments encircling the area. If you're going to explore such a place, you know in your heart that you might not make it back. You could still leave now and return later...}"
        es = "[img]gfx/ui/events/event_182.png[/img]{La hacienda se alza sobre la zona con obras de piedra perfectamente labradas y tejados de tejas coloridas. Posee algo que ni siquiera muchos miembros de la realeza pueden permitirse: buen gusto. Con el césped cortado al ras, el jardín parece casi una huella sobre una tierra descuidada. Estatuas de personas salpican el paisaje, capturando poses tanto majestuosas como melancólicas. Entre la multitud de esculturas hay setos recortados con forma de animales y fuentes con agua cristalina. La compañía se encuentra fuera de una verja negra, holgazaneando y mirando a través de los barrotes como animales de corral. %randombrother% niega con la cabeza y escupe.%SPEECH_ON%Sí, todo muy bonito y eso, pero ningún ricachón de mierda deja la puerta principal abierta así porque sí, ¿sabes? Yo creo que o alguien ya se abrió paso por aquí, o hay algo espantoso dentro al que no le molesta que de vez en cuando entre algún inocente.%SPEECH_OFF%Estás de acuerdo. Al mirar más a fondo, puedes ver que el sendero conduce a una depresión excavada, como si los dioses hubieran hundido un nudillo en la tierra misma, con salientes y escarpas que rodean el lugar. Si vas a explorar ese sitio, sabes en tu interior que podrías no volver. Aún puedes marcharte ahora y regresar más tarde...}"
    }
    // context: artifact_reliquary_enter_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «se desliza tras una estatua» invierte el sentido; «swings himself around a statue» es que aparece rodeándola, no que se esconde
        en = "[img]gfx/ui/events/event_182.png[/img]{You order the company into the moon-like escarpment. Suddenly, a man wearing a tall black helm swings himself around a statue. He wields an unusual staff, a trail of green mist wafting behind its glassy top.%SPEECH_ON%Welcome! Have you come to understand my work? It is in the warmth of mothering that one finds the primal instincts, the flashes of intellect which all creatures, from the feeblest worms to the most soaring birds, understand, and without which man shall never have supremacy over all things. I, a man, am mother now. I, a man, have broken the order, and on this instinct native to all creatures, I shall rise, wombless, ascending above the architecture of nature herself, and become nurturer to all! I, the Grand Diviner, the one who shall moisten this dry earth with manifestations...%SPEECH_OFF%Monologuing madmen wielding strange staffs rarely have good intentions. You draw your sword and, seeing your blade, the Grand Diviner goes quiet. He nods and swings his arms wide, a flash of green sparking from his staff. Creatures like those you've seen before - gelatinous, bulbous assemblages of vague appendages - all start shuffling out from behind the statues. More yet encircle the entire company, occupying spaces on high, saddling themselves onto the lip of the escarpments like visitors in a coliseum, ever-ready to watch a good fight. The Grand Diviner grins and points his staff at you.%SPEECH_ON%Smile, sellsword, for when you die I shall mother you back into this world, and you shall find nurture in the bosom of my power!%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_182.png[/img]{Ordenas a la compañía que avance hacia la escarpa, parecida a un cráter lunar. De repente, un hombre con un alto yelmo negro asoma de un giro desde detrás de una estatua. Empuña un extraño bastón, cuya punta vidriosa deja tras de sí un rastro de niebla verde.%SPEECH_ON%¡Bienvenidos! ¿Han venido a comprender mi obra? Es en el calor del amamantamiento donde se hallan los instintos primarios, los destellos de intelecto que toda criatura, desde los más débiles gusanos hasta las aves más altivas, entiende, y sin los cuales el hombre jamás alcanzará la supremacía sobre todas las cosas. Yo, un hombre, soy madre ahora. Yo, un hombre, he quebrado el orden, y sobre este instinto nativo a todo ser me alzaré, sin útero, por encima de la arquitectura de la naturaleza misma, ¡y me volveré el nutridor de todos! Yo, el Gran Adivino, aquel que humedecerá esta tierra árida con manifestaciones...%SPEECH_OFF%Los locos que monologan con extraños báculos rara vez tienen buenas intenciones. Desenvainas la espada y, al verla, el Gran Adivino guarda silencio. Asiente y extiende los brazos, soltando un destello verde desde su bastón. Criaturas como las que ya has visto (gelatinosas, bulbosas, montajes de apéndices vagamente definidos) comienzan a salir tambaleándose desde detrás de las estatuas. Aún más emergen para rodear a toda la compañía, tomando posiciones en lo alto, apostándose sobre el borde de la escarpa como espectadores en un coliseo, siempre listos para presenciar una buena pelea. El Gran Adivino sonríe y apunta su bastón hacia ti.%SPEECH_ON%¡Sonríe, mercenario, porque cuando mueras te amamantaré de nuevo a este mundo, y hallarás sustento en el seno de mi poder!%SPEECH_OFF%}"
    }
    // context: artifact_reliquary_enter_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_182.png[/img]{The Diviner is found in the mire of his creatures, a wounded man strewn across the afterbirth of his own manifestations. His heavy helmet guards his neck, but you simply crouch down and lever the point of your sword under it, like lifting a bucket with a dagger. He coughs and says.%SPEECH_ON%You can truly kill me no more than you can kill mother nature.%SPEECH_OFF%You nod and drive the steel through his chin until you hear its tip touch the top of his helm. Blood spews over the neckguard. Standing, you say,%SPEECH_ON%I am mother nature.%SPEECH_OFF%%randombrother% laughs.%SPEECH_ON%Nice line, captain. Sorta dumb if you think about it too much but-%SPEECH_OFF%You cut the sellsword off and tell %them_randombrother% and the rest of the men to loot the place. Surely the gothic estate has some valuables that will have made this venture worthwhile. As for the Diviner's curious staff still yet swirling with a faint green glow, you have it taken to inventory. As you prepare to leave, a report comes in that a number of the 'flesh golems' ran out of the gothic estate and fled into the wild. Their progenitor is dead, but it seems you may still yet continue to find his creations.}"
        es = "[img]gfx/ui/events/event_182.png[/img]{Encuentras al Adivino en el lodazal de sus criaturas, un hombre herido tendido sobre la placenta de sus propias manifestaciones. Su pesado yelmo le protege el cuello, pero te limitas a agacharte y meter la punta de la espada por debajo para hacer palanca, como quien levanta un cubo con una daga. Tose y dice:%SPEECH_ON%No puedes matarme de verdad, igual que no puedes matar a la madre naturaleza.%SPEECH_OFF%Asientes y le hundes el acero por la barbilla hasta que oyes la punta tocar lo alto del yelmo. La sangre brota a borbotones sobre la gola. Al ponerte en pie, dices:%SPEECH_ON%Yo soy la madre naturaleza.%SPEECH_OFF%%randombrother% se ríe.%SPEECH_ON%Buena frase, capitán. Medio tonta si lo piensas mucho, pero-%SPEECH_OFF%Cortas en seco %al_randombrother% mercenari%o_randombrother% y les dices a %el_randombrother% y al resto de los hombres que saqueen el lugar. Seguro que la hacienda gótica guarda objetos de valor que harán que esta aventura haya merecido la pena. En cuanto al curioso bastón del Adivino, en el que aún se arremolina un tenue resplandor verde, mandas guardarlo en el inventario. Mientras te preparas para partir, te llega el aviso de que varios de los 'gólems de carne' salieron corriendo de la hacienda gótica y huyeron a tierras salvajes. Su progenitor ha muerto, pero parece que aún seguirás encontrando sus creaciones.}"
    }
    // FILE: mod_legends\hooks\events\events\mason_vs_thief_event.nut
    // context: mason_vs_thief_event.o.create.s.Text
    {
        // corrige base: «delito de arenque» pierde el juego de palabras («herring offense» por «hanging offense»); se adapta como «pescado capital» por «pecado capital»
        // corrige base: «ladrón de peces» por «fish thief»; lo robado es pescado
        // corrige base: «vaults» son cámaras acorazadas, no bóvedas, y «primero lo más fácil eran las bóvedas» queda trabado
        en = "[img]gfx/ui/events/event_26.png[/img]%mason% the mason is stoking the campfire with %thief% standing nearby. The thief is mulling a question over.%SPEECH_ON%Hmm, what was the hardest to break into? Well, vaults were the easiest, let's get that out of the way first. I once stole so much from a vault that they tried to hang the locksmith for being so easily defeated by a common thief. They couldn't find the locksmith, for you see I'm no common thief, for the locksmith was me. Ha-ha! To answer your question, a tower is the hardest to break into, especially a tower standing alone.%SPEECH_OFF%Sitting back on their laurels, the mason nods.%SPEECH_ON%Aye, thought you might say so. Towers be built for prisoners of import or items of peculiar fancy. Little more than cages in the sky for creatures with no wings. But one time, a prisoner, some notorious fish thief, did manage an escape. He spent years upon years pulling out strands of his own hair and tying them together until the 'rope' was long enough for him to throw it out and climb down. They caught him a day later, unfortunately. He did the same trick again a few years later, but that time he roped it half-as-long and simply hanged himself instead.%SPEECH_OFF%%thief% laughs.%SPEECH_ON%That's interesting and all, but I'm a true thief, mason, not a mere robber of fishmongers. My question is how do I get -into- the tower.%SPEECH_OFF%The mason nods.%SPEECH_ON%Simple. Commit a... herring offense.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_26.png[/img]%mason%, de oficio albañil, aviva el fuego del campamento mientras %thief%, de pie a su lado, le da vueltas a una pregunta.%SPEECH_ON%Mmm, ¿qué fue lo más difícil de asaltar? Bueno, las cámaras acorazadas eran lo más fácil, quitemos eso de en medio primero. Una vez robé tanto de una cámara acorazada que intentaron ahorcar a quien había fabricado la cerradura por dejarse burlar tan fácilmente por un ladrón cualquiera. No lograron dar con quien la había fabricado porque, verás, lo mío no es el robo vulgar: la cerradura era obra mía. ¡Ja, ja! Para responder a tu pregunta, lo más difícil de asaltar es una torre, sobre todo una torre aislada.%SPEECH_OFF%Con aire de suficiencia, su oyente asiente.%SPEECH_ON%Sí, ya pensaba que dirías eso. Las torres se construyen para prisioneros importantes o para objetos de capricho singular. Poco más que jaulas en el cielo para criaturas sin alas. Pero una vez un prisionero, un ladrón de pescado de mala fama, sí que logró escapar. Pasó años y años arrancándose mechones de su propio pelo y atándolos entre sí hasta que la 'cuerda' fue lo bastante larga para lanzarla afuera y bajar por ella. Por desgracia, lo atraparon al día siguiente. Unos años después repitió el truco, pero esa vez la hizo la mitad de larga y, sin más, se ahorcó con ella.%SPEECH_OFF%%thief% se ríe.%SPEECH_ON%Muy interesante y todo eso, pero lo mío es robar de verdad, albañil, no desvalijar pescaderías. Lo que pregunto es cómo -entro- en la torre.%SPEECH_OFF%La respuesta llega con un asentimiento.%SPEECH_ON%Sencillo. Comete un... pescado capital.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\master_no_use_apprentice_event.nut
    // context: master_no_use_apprentice_event.o.create.s.Text
    {
        en = "%townImage% While walking about %townname%, you run into an old man dragging a youthful %person_dude% by the ear.%SPEECH_ON%You want to be a master, it takes time! Blood! Sweat! Tears if yer of the cryin' sort and there's no shame in that if ya are. Here, look! A sellsword! If you want to fight so bad, why not go to him?%SPEECH_OFF%You hold your hands out and ask for an explanation before getting offloaded some annoying git. The elderly man calms himself and lets the kid's ear go.%SPEECH_ON%Aye, I suppose you are owed more of an explanation. I'm the fencing master of this town, but I teach discipline and patience before anyone so much can touch a sword! And this damned student of mine has neither! So I told %them_dude%, if you want to fight so bad, get the hell out!%SPEECH_OFF%You look at the kid. %They're_dude% got a fresh face, but there is in fact some impatient eagerness in %their_dude% eyes. You ask %them_dude% if what the swordmaster says is true. The kid nods.%SPEECH_ON%Yessir. And I'd be more than happy to fight for you, too.%SPEECH_OFF%"
        es = "%townImage% Mientras paseas por %townname%, te cruzas con un anciano que arrastra de la oreja a %un_dude% joven.%SPEECH_ON%¡Para ser maestr%o_dude% hace falta tiempo! ¡Sangre! ¡Sudor! Lágrimas, si eres de llanto fácil, y no hay vergüenza en ello si lo eres. ¡Mira, aquí! ¡Un mercenario! Si tantas ganas tienes de pelear, ¿por qué no te vas con él?%SPEECH_OFF%Levantas las manos y pides una explicación antes de que te endosen un incordio. El anciano se calma y suelta la oreja %del_dude% chic%o_dude%.%SPEECH_ON%Sí, supongo que te debo una explicación mejor. Soy el maestro de esgrima de este pueblo, ¡pero enseño disciplina y paciencia antes de que nadie toque siquiera una espada! ¡Y %ese_dude% condenad%o_dude% alumn%o_dude% no tiene ni lo uno ni lo otro! Así que le dije: si tantas ganas tienes de pelear, ¡lárgate de una vez!%SPEECH_OFF%Miras %al_dude% chic%o_dude%. Tiene el rostro lozano, pero en sus ojos hay, en efecto, cierto afán impaciente. Le preguntas si es cierto lo que dice el maestro de esgrima. %Art_dude% chic%o_dude% asiente.%SPEECH_ON%Sí, señor. Y estaría más que encantad%o_dude% de pelear por usted.%SPEECH_OFF%"
    }
    // context: master_no_use_apprentice_event.o.create.s.Options[0].Text
    {
        en = "Alright, we'll take %them_dude%."
        es = "Muy bien, %lo_dude% aceptamos."
    }
    // context: master_no_use_apprentice_event.o.create.s.Options[1].Text
    {
        en = "No, thanks. %They're_dude% all yours."
        es = "No, gracias. Es asunto tuyo."
    }
    // context: master_no_use_apprentice_event.o.create.s.start._event.m.Dude.getBackground().m.RawDescription
    {
        en = "An impatient student of a Swordmaster, %name% didn't have the mental aptitude to stick with the trials and tribulations of becoming a master of the blade %themselves%. But what %they% lacks in mental fortitude %they% more than makes up for in effort. You 'hired' %them% simply by taking %them% off the old man's hands."
        es = "%Un% estudiante impaciente de un maestro espadachín, %name% no tenía la aptitud mental para soportar las pruebas y tribulaciones de convertirse en maestr%o% de la espada. Pero lo que le falta en fortaleza mental lo compensa con creces con esfuerzo. %Lo% 'contrataste' simplemente quitándo%lo% de las manos del anciano."
    }
    // FILE: mod_legends\hooks\events\events\melon_thief_event.nut
    // en = "the Melon Mugger"
    // en base_es
    // en = "%name% is just a regular melon thief - is what you tell people who ask."
    // en base_es
    // en = "Satisfied his needs with a melon"
    // en base_es
    // en = "Almost got tarred and feathered"
    // en base_es
    // FILE: mod_legends\hooks\events\events\minstrel_outsmarts_gambler_event.nut
    // context: minstrel_outsmarts_gambler_event.o.create.s.Text
    {
        // corrige base: «se remanga las mangas» es redundante
        // corrige base: «la tercera logra dar vueltas alrededor del aro»; en este juego la herradura gira alrededor de la estaca
        en = "[img]gfx/ui/events/event_26.png[/img] %gambler%, the mercenary with a gambling problem, has apparently gone around camp asking folk to play a game of horseshoes - with a few crowns on the line, of course. It appears that %minstrel%, the wily minstrel, has obliged and taken the bet. The musician claims to be pretty good at the game to which the gambler claims to be the best. \n\n The two heave horseshoes until their arms tire and the sun wanes. Nobody is the winner as the game can't move off of a tie. After another indecisive round, %minstrel% calls for a double-or-nothing round if they go left-handed. %gambler% agrees and goes first, throwing three horseshoes. The first two go haywire, but the third manages to spin around the ring. The gambler grins and wishes the minstrel good luck. %minstrel% nods and rolls up their sleeves, sticks out their tongue out and slims the eyes, lining up the shot. The minstrel's feet do a little tap-dance and just before throwing looks back and says,%SPEECH_ON%I should probably let you know that I *am* left-handed.%SPEECH_OFF%Without even looking forward, the minstrel lets loose a horseshoe. The throw is perfect, landing dead center about the stake, and the next two are tossed so quickly and so seamlessly that anybody watching erupts in hooting laughter. The gambler's mouth can only drop in disbelief."
        es = "[img]gfx/ui/events/event_26.png[/img] Al parecer, %gambler%, a quien le puede el vicio del juego, ha ido por el campamento pidiendo a la gente que juegue a las herraduras, con unas cuantas coronas de por medio, por supuesto. Por lo visto, %minstrel%, con toda la picardía de quien vive de entretener, le ha dado el gusto y ha aceptado la apuesta. Presume de que se le da bastante bien, a lo que su contrincante replica que nadie lo hace mejor. \n\n Ambos lanzan herraduras hasta que se les cansan los brazos y el sol declina. No hay ganador, porque la partida no sale del empate. Tras otra ronda sin desenlace, %minstrel% propone una ronda a doble o nada si lanzan con la izquierda. %gambler% acepta y empieza, lanzando tres herraduras. Las dos primeras salen desviadas, pero la tercera consigue girar alrededor de la estaca. Con una sonrisa, le desea buena suerte a su rival. %minstrel% asiente, se remanga, saca la lengua y entrecierra los ojos para afinar la puntería. Sus pies se marcan un pequeño zapateado y, justo antes de lanzar, se gira y dice:%SPEECH_ON%Probablemente debería avisarte de que la izquierda *es* mi mano buena.%SPEECH_OFF%Sin mirar siquiera al frente, suelta la herradura. El lanzamiento es perfecto y cae justo alrededor de la estaca, y las dos siguientes salen tan rápidas y fluidas que todo el que mira estalla en carcajadas y silbidos. A quien propuso la apuesta solo se le descuelga la mandíbula de incredulidad."
    }
    // FILE: mod_legends\hooks\events\events\minstrel_regals_refugee_event.nut
    // context: minstrel_regals_refugee_event.o.create.s.Text
    {
        // corrige base: «¡Oíd!» usa vosotros; el corpus usa ustedes
        // corrige base: «extraña sonrisa» traduce mal «rare smile», que es una sonrisa poco habitual
        // corrige base: «a montones» es un añadido que el inglés no tiene
        en = "[img]gfx/ui/events/event_26.png[/img] The company sits around a fire when %minstrel% the minstrel notices the refugee, %refugee%, sitting solemnly alone. Within but a moment, the minstrel is up, standing high on a stump, and waving arms wide.%SPEECH_ON%Lo', the town of %refugee% was small, its place quaint, and its food, well, a little on the 'eh' side. But ho'! Were its people big! For here sits amongst our company one of its kin, the world after their spirit, death on their heels, yet here they be, and we've but only thanks - and crowns! - to offer! Such is the price of this company, and such we are willing to give.%SPEECH_OFF%The minstrel sits back down and bows to the refugee. All of the %companyname% stands up and cheers, bringing a rare smile to %refugee%'s face."
        es = "[img]gfx/ui/events/event_26.png[/img] La compañía está sentada alrededor de una fogata cuando %minstrel%, con alma de juglar, se fija en %refugee%, que lo perdió todo y ahora permanece aparte, en solemne soledad. En un instante, se pone en pie, se sube bien alto a un tocón y agita los brazos de par en par.%SPEECH_ON%¡Atiendan! El pueblo de %refugee% era pequeño, su lugar pintoresco y su comida, bueno, tirando a 'psé'. ¡Pero, ay! ¡Qué grande era su gente! Porque aquí, entre nuestra compañía, se sienta alguien de su sangre, con el mundo a la caza de su espíritu y la muerte pisándole los talones, y aun así aquí está, ¡y no tenemos más que gracias (¡y coronas!) que ofrecer! Tal es el precio de esta compañía, y tal estamos dispuestos a pagar.%SPEECH_OFF%Vuelve a sentarse y se inclina ante quien inspiró su copla. Toda %companyname% se pone en pie y aclama, arrancando una sonrisa poco habitual del rostro de %refugee%."
    }
    // FILE: mod_legends\hooks\events\events\minstrel_teases_deserter_event.nut
    // context: minstrel_teases_deserter_event.o.create.s.Text
    {
        // corrige base: errata «tocon» por «tocón»
        en = "[img]gfx/ui/events/event_26.png[/img] As the campfire crackles, %minstrel% the minstrel gets up and stands high on a stump. Beating their chest and pointing to %deserter%.%SPEECH_ON%Yo, yee man of such fleeting feet, feet that flee before you've been beat! The deserter! Oh, the deserter! A dessert for the deserter! His courage he did curdle, his honor he did hurdle, his manliness he did murder! The deserter!%SPEECH_OFF%In one swift motion the minstrel claps hands and drops back down onto the seat. %minstrel%'s only there for a moment before %deserter%'s hands are around their neck. The company is an uproar, stuck somewhere between separating the two and succumbing to fits of manic laughter."
        es = "[img]gfx/ui/events/event_26.png[/img] Mientras crepita la hoguera, %minstrel%, con alma de juglar, se levanta y se sube bien alto a un tocón. Se golpea el pecho y señala a %deserter%.%SPEECH_ON%¡Eh, tú, hombre de pies tan fugaces, pies que huyen antes de ser vencidos! ¡El desertor! ¡Oh, el desertor! ¡Un flan dejado atrás, un desertor que no encuentra paz! Su valentía se cuajó, su honor lo abandonó, ¡su hombría la asesinó! ¡Oh, el desertor!%SPEECH_OFF%En un único y rápido movimiento, da una palmada y se deja caer de nuevo en el asiento. %minstrel% apenas lleva allí un instante cuando las manos de %deserter% ya le rodean el cuello. La compañía es un alboroto, a medio camino entre separar a los dos y sucumbir a ataques de risa histérica."
    }
    // FILE: mod_legends\hooks\events\events\minstrel_writes_song_event.nut
    // context: minstrel_writes_song_event.o.create.s.Text
    {
        // corrige base: añade una séptima variante (la canción del carnicero) que el inglés no tiene; aquí se omite porque el número de variantes debe coincidir con el inglés; revisar en la 1.0 si es un guiño que conservar
        // corrige base: cierra «¡Al demonio con esta mierda!» con %SPEECH_ON% en vez de %SPEECH_OFF%
        // corrige base: «nunca en tu jodida vida» y «(ni muerta)» son añadidos que el inglés no tiene
        // corrige base: «aparentemente» abriendo cláusula por «apparently»; es «por lo visto»
        en = "[img]gfx/ui/events/event_26.png[/img]{%minstrel% the minstrel picks up a lute. You've no clue where the instrument came from, but within a few strokes it has drawn the attention of the rest of the company. The mercenary's head picks up, eyes closed, and begins to sing.%SPEECH_ON%I... -strum- joined a band of mercenaries, my coffers all gone... -strum-... they wanted a fighter, but all I had were songs. The end.%SPEECH_OFF%The company laughs as the fool throws the lute over his shoulder. | %minstrel% the minstrel produces a lute seeming out of thin air like a magician would a rabbit, gives it a practiced strum, then breaks into song.%SPEECH_ON%There once was a monster that terrorized fair Riggabong... -strum-... They called it, if I recall, a real problem... -strum strum-...\n\nThis beast could only feast on the ladies, but just the virgins oh yeah it had great taste!...-plucky strum-... but obviously that was not, for man or woman, a desired fate!...-sketchy strum, a new one-...\n\n So they hired Sir Galicock, the greatest sword-swinger in the land...-playful strum-...and so he went door to door, and vanquished every virgin a good swordsman can!...-a lingering, sad strum-... and the monster starved to death. The end.%SPEECH_OFF% | As a fire crackles and the men begin to get weary eyed in front of its flame, %minstrel% the minstrel clears their throat in a manner best described as 'everybody listen.' Standing up, too, and raising a hand as though it carried a glass with which to toast.%SPEECH_ON%Aye, you are some of the finest men I've ever met. I say that because I never knew my father and I spent all my years with the womenfolk.%SPEECH_OFF%He stares longingly into the distance.%SPEECH_ON%Damn, have I been with a lot of women.%SPEECH_OFF%And then he sits down. A moment of silence lingers in the air before it's broken with uproarious laughter. | %minstrel% the minstrel is looking for a lute. Upon not to being able to find it, they resort to an 'air lute' instead, plucking playfully with a thumb.%SPEECH_ON%Hold on, that didn't sound quite right, lemme tune it.%SPEECH_OFF%Raising a hand and twisting his finger, then goes for another strum.%SPEECH_ON%The hell? That was worse than the first. Just a sec, I'll get it, I promise.%SPEECH_OFF%He tries again, but apparently this 'strum' wasn't any good either.%SPEECH_ON%To hell with this piece of shite!%SPEECH_OFF%The minstrel jumps to their feet and repeatedly smashes the invisible lute against the ground before heaving it into the tall grass. He sweeps the sweat from his brow.%SPEECH_ON%You were right, dear father, I should have been a blacksmith.%SPEECH_OFF%And then %minstrel% storms off, confused laughter from the company crackling behind him. | While throwing dirt into the fire, %minstrel% the minstrel begins to speak, to whom nobody can be sure.%SPEECH_ON%The old gods said let there be light, did they not? 'Tis the first thing they did, so clearly light must be important.%SPEECH_OFF%He picks up a piece of dirt and seems to analyze it.%SPEECH_ON%So why is there so much pleasure to be found where a woman is darkest?%SPEECH_OFF%The initially confused onlookers burst into laughter. | %minstrel% the minstrel stands up and clacks their boots together.%SPEECH_ON%Shall I show you fools how to dance?%SPEECH_OFF%A few men look up and shake their heads.%SPEECH_ON%Oh come on. It's simple. Watch.%SPEECH_OFF%The minstrel raises a leg, it goes into an angle no human's leg should before planting back on the ground. %minstrel% twirls, arms up high. Then fans both arms out as if to fly. It's actually quite beautiful, though you'd never admit as much to any living soul. You watch as the minstrel continues, leaning forward when suddenly rips a horrendous fart right into %otherbrother%'s face.\n\n %minstrel% straightens up in an instant, as though the gas had fixed a bad back and then sought the immediate use of it.%SPEECH_ON%I, uh... well, that's all folks! So hopefully you got the moves down pat!%SPEECH_OFF% %minstrel% runs off, a particularly slighted and smelly man on his heels. The rest of the men bowl over with laughter.}"
        es = "[img]gfx/ui/events/event_26.png[/img]{%minstrel%, con alma de juglar, toma un laúd. No tienes ni idea de dónde ha salido el instrumento, pero en pocos rasgueos ha atraído la atención del resto de la compañía. Levanta la cabeza, con los ojos cerrados, y empieza a cantar.%SPEECH_ON%Me... -rasgueo- uní a una banda de mercenarios, con las arcas vacías... -rasgueo-... querían a alguien que luchara, pero yo solo tenía canciones. Fin.%SPEECH_OFF%La compañía se ríe mientras el laúd sale volando por encima de su hombro. | %minstrel%, con alma de juglar, saca un laúd como de la nada, igual que un mago sacaría un conejo, le da un rasgueo experto y rompe a cantar.%SPEECH_ON%Había una vez un monstruo que aterrorizaba a la bella Riggabong... -rasgueo-... Lo llamaban, si no recuerdo mal, un verdadero problemón... -rasgueo rasgueo-...\n\nEsta bestia solo podía darse un festín con damas, pero solo con las doncellas, ¡ay, sí, qué buen gusto tenía!...-rasgueo pizpireto-... ¡pero, como es obvio, ni hombre ni mujer deseaba semejante suerte!...-rasgueo vacilante, uno nuevo-...\n\n Así que contrataron a Sir Galicock, el mejor blandidor de espadas de la comarca...-rasgueo juguetón-... ¡y fue de puerta en puerta, y desfloró a cuanta doncella puede desflorar un buen espadachín!...-un rasgueo largo y triste-... y el monstruo murió de hambre. Fin.%SPEECH_OFF% | Mientras el fuego crepita y a los hombres empiezan a pesarles los párpados frente a las llamas, %minstrel%, con alma de juglar, se aclara la garganta de un modo que solo puede describirse como 'escuchen todos'. Se pone también en pie y alza una mano como si sostuviera una copa para brindar.%SPEECH_ON%Sí, son de los mejores hombres que he conocido. Lo digo porque nunca conocí a mi padre y pasé todos mis años entre mujeres.%SPEECH_OFF%Se queda mirando a lo lejos con añoranza.%SPEECH_ON%Maldita sea, con cuántas mujeres he estado.%SPEECH_OFF%Y entonces se sienta. Un momento de silencio queda suspendido en el aire antes de romperse en carcajadas estruendosas. | %minstrel%, con alma de juglar, busca un laúd. Al no encontrarlo, recurre a un 'laúd de aire', punteando con el pulgar de forma juguetona.%SPEECH_ON%Esperen, eso no sonó del todo bien, déjenme afinarlo.%SPEECH_OFF%Levanta una mano, gira un dedo y prueba otro rasgueo.%SPEECH_ON%¿Qué demonios? Eso fue peor que el primero. Un segundo, ya me sale, lo prometo.%SPEECH_OFF%Lo intenta de nuevo, pero, por lo visto, este 'rasgueo' tampoco sirve.%SPEECH_ON%¡Al diablo con este pedazo de mierda!%SPEECH_OFF%Se levanta de un salto y estrella una y otra vez el laúd invisible contra el suelo antes de arrojarlo a la hierba alta. Se seca el sudor de la frente.%SPEECH_ON%Tenías razón, querido padre, debí dedicarme a la herrería.%SPEECH_OFF%Y entonces %minstrel% se marcha dando zancadas, entre las risas desconcertadas que crepitan a su espalda. | Mientras echa tierra al fuego, %minstrel%, con alma de juglar, empieza a hablar, aunque nadie sabe muy bien a quién.%SPEECH_ON%Los antiguos dioses dijeron 'hágase la luz', ¿no? Es lo primero que hicieron, así que está claro que la luz debe de ser importante.%SPEECH_OFF%Toma un puñado de tierra y parece analizarlo.%SPEECH_ON%Entonces, ¿por qué se encuentra tanto placer allí donde una mujer es más oscura?%SPEECH_OFF%Los presentes, confundidos al principio, estallan en carcajadas. | %minstrel%, con alma de juglar, se pone en pie y hace chocar las botas.%SPEECH_ON%¿Quieren que les enseñe a bailar, tontos?%SPEECH_OFF%Unos cuantos hombres levantan la vista y niegan con la cabeza.%SPEECH_ON%Ay, vamos. Es fácil. Miren.%SPEECH_OFF%Levanta una pierna, que adopta un ángulo que ninguna pierna humana debería adoptar, antes de volver a plantarla en el suelo. %minstrel% da una vuelta con los brazos en alto. Luego abre los brazos como si fuera a echar a volar. La verdad es que resulta bastante hermoso, aunque jamás lo admitirías ante alma viviente. Observas cómo continúa, inclinándose hacia adelante, cuando de pronto suelta un pedo espantoso justo en la cara de %otherbrother%.\n\n %minstrel% se endereza al instante, como si el gas le hubiera curado una espalda maltrecha y quisiera aprovecharla en el acto.%SPEECH_ON%Eh... bueno, ¡eso es todo, amigos! ¡Espero que hayan aprendido los pasos a la perfección!%SPEECH_OFF% %minstrel% sale corriendo, con un hombre especialmente ofendido y apestoso pisándole los talones. Los demás se doblan de risa.}"
    }
    // FILE: mod_legends\hooks\events\events\monk_vs_monk_event.nut
    // context: monk_vs_monk_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img] Ah, the campfire is brimming with talk and chatter. The mercenaries are enjoying some beer and food when rather suddenly the shouts of two in particular get everyone else to quiet down, not because they yell louder than the rest, but because it's rather out of character for the both of them: the holy folk %monk1% and %monk2% are screaming-deep in a theological debate.\n\nYou've not the education to understand the intricacies nor complexities of what they are arguing, but you do understand that getting into another person's face and pointing furiously, or at a holy book, is probably asking for trouble one way or another."
        es = "[img]gfx/ui/events/event_05.png[/img] Ah, la hoguera rebosa de charlas y conversaciones. Los mercenarios disfrutan de cerveza y comida cuando, de repente, los gritos de un par en particular hacen callar a todos los demás, no porque griten más fuerte que el resto, sino porque desentona por completo con su carácter: dos almas piadosas, %monk1% y %monk2%, están enfrascadas a gritos en un debate teológico.\n\nNo tienes la educación para entender los entresijos ni las complejidades de lo que discuten, pero sí entiendes que plantarse delante de la cara de otra persona y señalarla furiosamente, o señalar un libro sagrado, probablemente es buscarse problemas de una forma u otra."
    }
    // context: monk_vs_monk_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img] For a moment, you think to stop the debate before it gets out of hand and into fists, but then you remember that this isn't the first time you've seen two holy men exchanging rather heatedly. It's just what they do. So you decide to let them hash it out. In time, their voices lower in volume, and their faces lower together into a book. They quietly peruse it, bumping heads as they draw their eyes over the pages. Finally, %monk1% raises up, pointing to some sentence.%SPEECH_ON%There! Right there! 'Man from mud', not 'man from blood'. Man can't be from blood, he is blood! Man can't be from himself, see? Now does it make sense?%SPEECH_OFF%Scratching his chin, %monk2% nods, but then wonders aloud.%SPEECH_ON%What if...%SPEECH_OFF%Before the thought is finished %monk1% slaps the book closed with hands thrown into the air."
        es = "[img]gfx/ui/events/event_05.png[/img] Por un momento, piensas en detener el debate antes de que se salga de control y acabe a puñetazos, pero luego recuerdas que no es la primera vez que ves a dos hombres santos discutir acaloradamente. Es simplemente lo que hacen. Así que decides dejar que lo resuelvan. Con el tiempo, sus voces bajan de volumen y sus rostros se inclinan juntos sobre un libro. Lo hojean en silencio, chocando las cabezas mientras recorren las páginas con la mirada. Finalmente, %monk1% se incorpora, señalando una frase.%SPEECH_ON%¡Ahí! ¡Justo ahí! 'Hombre de barro', no 'hombre de sangre'. El hombre no puede venir de la sangre, ¡él es sangre! El hombre no puede venir de sí mismo, ¿ves? ¿Ahora tiene sentido?%SPEECH_OFF%Rascándose la barbilla, %monk2% asiente, pero luego se pregunta en voz alta.%SPEECH_ON%¿Y si...?%SPEECH_OFF%Antes de que termine la idea, %monk1% cierra el libro de golpe y alza las manos al aire."
    }
    // context: monk_vs_monk_event.o.create.s.Options[0].Text
    {
        en = "The holy avert another crisis."
        es = "Las almas piadosas evitan otra crisis."
    }
    // context: monk_vs_monk_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_06.png[/img]Now, this isn't the first time you've seen two religious types squabbling. The last time it happened the debaters hashed it out right quick. So naturally you think these two will do the same. Alas, it isn't to be. Their voices grow louder and louder. You never knew the pious could be so sharp-tongued. Fierceness and lewdness don't even begin to describe the insults being thrown back and forth. It isn't but a few seconds later that they are on the ground, wrestling and punching until you order %otherguy% to put an end to it.\n\nThe company of sellswords and their bloody daywork, it seems, have left a mark on the once peaceful demeanor of the two."
        es = "[img]gfx/ui/events/event_06.png[/img]No es la primera vez que ves a dos almas devotas riñendo. La última vez que pasó, quienes debatían lo resolvieron bien rápido. Así que, naturalmente, piensas que estas dos harán lo mismo. Pero, por desgracia, no será así. Sus voces suben más y más. Nunca imaginaste que la gente piadosa pudiera tener una lengua tan afilada. Ferocidad y obscenidad no alcanzan ni a describir los insultos que se lanzan de un lado a otro. A los pocos segundos ya están en el suelo, forcejeando y dándose puñetazos hasta que ordenas a %otherguy% que ponga fin a aquello.\n\nAl parecer, la compañía de mercenarios y su sangrienta jornada han dejado huella en el talante, antes pacífico, de esas dos almas."
    }
    // context: monk_vs_monk_event.o.create.s.start.List.push().text
    {
        // text = _event.m.Monk1.getName() + " and " + _event.m.Monk2.getName() + " grow distant"
        mode = "pattern"
        en = "<monk1:str> and <monk2:str> grow distant"
        es = "<monk1> y <monk2> se distancian"
    }
    // en = "<actor:str> gains <v:val_tag> Resolve"
    // en base_es
    // en = "Lost composure and resorted to violence"
    // en base_es
    // en = "<student:str> suffers light wounds"
    // en base_es
    // en = "<bro:str> suffers <injury:str>"
    // en base_es
    // FILE: mod_legends\hooks\events\events\more_action_event.nut
    // context: more_action_event.o.create.s.Text
    {
        // corrige base: «casi literalmente» contradice «quite literally», que es literal del todo
        en = "[img]gfx/ui/events/event_64.png[/img]You're sitting in your tent enjoying the peace and quiet which, like some increasable quantity, seemingly has accrued in such a way that each day is more enjoyable than the last. Suddenly, %combatbro1% and %combatbro2% enter. They demand you have a talk. You oblige, fanning your hands across your table and inviting them to sit. They do and quickly state that it has been a long while since they last saw combat. Taken aback, you quite literally lean back in your chair.%SPEECH_ON%Isn't that a good thing?%SPEECH_OFF%%combatbro1%'s head shakes and cuts a determined hand through the air.%SPEECH_ON%No. We were hired to fight, and fighting is what we want. We want battles, we want carnage, and we want the glory that comes with both.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_64.png[/img]Estás sentado en tu tienda disfrutando de la paz y la tranquilidad que, como una cantidad que no deja de crecer, parece haberse acumulado de tal manera que cada día es más agradable que el anterior. De repente, entran %combatbro1% y %combatbro2%. Exigen hablar contigo. Accedes, extiendes las manos sobre la mesa y les ofreces asiento. Se sientan y enseguida dicen que hace mucho que no entran en combate. Desconcertado, te echas hacia atrás en la silla, literalmente.%SPEECH_ON%¿Y eso no es bueno?%SPEECH_OFF%%combatbro1% niega con la cabeza y corta el aire con una mano decidida.%SPEECH_ON%No. Nos contrataron para luchar, y luchar es lo que queremos. Queremos batallas, queremos carnicería y queremos la gloria que viene con ambas.%SPEECH_OFF%"
    }
    // context: more_action_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_64.png[/img]You nod.%SPEECH_ON%I understand. You are two battle-earnest mercenaries. You even remind me of myself though, with your skills, I can assure you that only I come out looking better by such a comparison. You are fine warriors, but is it not true that you will be paid the same regardless of this battle or that? Why be so worried about battles? They will come. I've not paid you to sit. I've paid you to be ready to stand.%SPEECH_OFF%The mercenaries exchange a glance and then shrug and nod. They stand up in unison.%SPEECH_ON%You are right, sir. And, when the time comes, we will be ready to stand and fight for you!%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_64.png[/img]Asientes.%SPEECH_ON%Lo entiendo. Les arde la sangre por combatir. Hasta me recuerdan a mí mismo aunque, con sus habilidades, les aseguro que solo yo salgo ganando con semejante comparación. Saben pelear como pocos, pero ¿no es cierto que cobrarán lo mismo, haya esta batalla o aquella? ¿Por qué preocuparse tanto por las batallas? Ya llegarán. No les pago para estar de brazos cruzados. Les pago para que, llegado el momento, se pongan en pie.%SPEECH_OFF%Cruzan una mirada, se encogen de hombros y asienten. Se levantan al unísono.%SPEECH_ON%Tiene razón, señor. Y, cuando llegue el momento, ¡nos pondremos en pie y lucharemos por usted!%SPEECH_OFF%"
    }
    // context: more_action_event.o.create.s.Options[0].Text
    {
        en = "Good to have the company burn for battle like this."
        es = "Es bueno que la compañía arda así por la batalla."
    }
    // context: more_action_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_64.png[/img]You try and explain to the mercenaries that, regardless of whether or not they're fighting, they are going to be getting paid. But money is not their primary concern. They truly wish to fight and you words have little effect on their rather earnest attitudes."
        es = "[img]gfx/ui/events/event_64.png[/img]Intentas explicarles que, luchen o no, van a cobrar igualmente. Pero el dinero no es lo que más les preocupa. De verdad quieren pelear, y tus palabras apenas hacen mella en su vehemencia."
    }
    // context: more_action_event.o.create.s.Text
    {
        // corrige base: «golpeas la mesa» no traduce «flatten your knuckles on the table», que es apoyar los nudillos
        // corrige base: «enemigo más cercano a quien derrotar» rebaja «nearest ass to kick»
        en = "[img]gfx/ui/events/event_64.png[/img]You stand up and flatten your knuckles on the table.%SPEECH_ON%Is it fighting you want?%SPEECH_OFF%The mercenaries exchange a glance then quickly nod at you.%SPEECH_ON%Then it is fighting you shall have! Fear not the sheathed sword, mercenaries. I will find you a good battle in due time!%SPEECH_OFF%Rising to their feet, the mercenaries shake your hand. They thank you as they leave the tent. Once they're gone, you go to your maps and look for the nearest ass to kick."
        es = "[img]gfx/ui/events/event_64.png[/img]Te pones de pie y apoyas los nudillos sobre la mesa.%SPEECH_ON%¿Es pelea lo que quieren?%SPEECH_OFF%Cruzan una mirada y enseguida asienten.%SPEECH_ON%¡Pues pelea tendrán! No teman a la espada envainada, mercenarios. ¡Les encontraré una buena batalla a su debido tiempo!%SPEECH_OFF%Se ponen en pie y te estrechan la mano. Te dan las gracias al salir de la tienda. En cuanto se van, acudes a tus mapas en busca del culo más cercano al que patear."
    }
    // FILE: mod_legends\hooks\events\events\more_men_event.nut
    // context: more_men_event.o.create.s.Text
    {
        // corrige base: «si me lo preguntas» cambia la voz del narrador; «if you say so yourself» es «como tú mismo dirías»
        en = "[img]gfx/ui/events/event_05.png[/img]The entire company - a motley little crew if you say so yourself - enters your tent all at once. A troupe of sellswords appearing in such a fashion is not the friendliest of sights and so for a split-second you think to reach for your sword. But then you notice that none of them have their weapons out nor do they carry the faces of mercenaries about to commit a murder. While they don't seem to be forming a mutiny to take your head, you keep the thought in mind nonetheless.\n\n You are only further relieved when they don't immediately start talking, instead waiting for your words to come first. This is a show of respect, and so the thought of reaching for your sword grows more distant. Crossing your arms over the table, you ask them what is on their minds.\n\n They explain that the company is too thin. Everywhere they go there is danger and they are now concerned that every new battle shall be their last. Finally, they state their wants outright: if they are going to survive, they're going to need more sellswords by their side."
        es = "[img]gfx/ui/events/event_05.png[/img]Toda la compañía (un grupito variopinto, como tú mismo dirías) entra en tu tienda a la vez. Una tropa de mercenarios que aparece de esa manera no es precisamente una visión amistosa, así que durante una fracción de segundo piensas en echar mano a la espada. Pero luego te fijas en que ninguno lleva el arma desenvainada ni tiene cara de estar a punto de cometer un asesinato. Aunque no parece que estén tramando un motín para cortarte la cabeza, no descartas la idea de todos modos.\n\n Te sientes aún más aliviado cuando no empiezan a hablar de inmediato, sino que esperan a que hables tú primero. Es una muestra de respeto, así que la idea de echar mano a la espada se aleja. Cruzando los brazos sobre la mesa, les preguntas qué tienen en mente.\n\n Explican que la compañía anda muy corta de gente. Vayan donde vayan hay peligro, y ahora temen que cada nueva batalla sea la última. Por fin, dicen sin rodeos lo que quieren: si van a sobrevivir, van a necesitar más mercenarios a su lado."
    }
    // context: more_men_event.o.create.s.Options.Text
    {
        // corrige base: «si solo pudiéramos» calca «if only»; es «si pudiéramos»
        en = "I'd hire more if only we could afford it."
        es = "Contrataría a más si pudiéramos permitírnoslo."
    }
    // context: more_men_event.o.create.s.Options.Text
    {
        // corrige base: «tienes mi palabra»; habla a toda la compañía, es «tienen mi palabra»
        en = "We'll reinforce the company with new recruits soon - you have my word."
        es = "Pronto reforzaremos la compañía con nuevos reclutas; tienen mi palabra."
    }
    // context: more_men_event.o.create.s.Options.Text
    {
        // corrige base: «estamos haciendo bien así» calca «we're doing fine»
        en = "There is no need to hire more, we're doing fine this way."
        es = "No hace falta contratar a más; así nos va bien."
    }
    // context: more_men_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]You immediately stand up and rap the table with your knuckles.%SPEECH_ON%The best of minds truly must think alike for I have already set aside some crowns for hiring new comrades!%SPEECH_OFF%The anxious, almost sad faces on the mercenaries slowly begin to change. They smile and nod and say things like 'alright' and 'that's good.' When they turn to leave, you notice they've got daggers sheathed behind their backs."
        es = "[img]gfx/ui/events/event_05.png[/img]Te pones de pie de inmediato y golpeas la mesa con los nudillos.%SPEECH_ON%Está visto que las grandes mentes piensan igual, ¡porque ya he apartado unas cuantas coronas para contratar nuevos camaradas!%SPEECH_OFF%Las caras ansiosas, casi tristes, de los mercenarios empiezan a cambiar poco a poco. Sonríen, asienten y dicen cosas como 'bien' y 'eso está bien'. Cuando se dan la vuelta para irse, te fijas en que llevan dagas envainadas a la espalda."
    }
    // context: more_men_event.o.create.s.Options[0].Text
    {
        en = "Time to hire new recruits."
        es = "Hora de contratar nuevos reclutas."
    }
    // context: more_men_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]Unfortunately, you just don't agree.%SPEECH_ON%You are some of the finest soldiers I've ever seen. I don't think you have anything to fear. Our enemies fear for their own lives when they see you!%SPEECH_OFF%But your words don't go over well. One mercanary leans forward with an arm behind his back, but another claps a hand on the shoulder and quickly shakes their head. They only looks at you and say.%SPEECH_ON%This is most concerning news, sir, but we shall carry on.%SPEECH_OFF%When they turn to leave, you notice the clasp on one man's sheathed dagger has been unlatched."
        es = "[img]gfx/ui/events/event_05.png[/img]Por desgracia, no estás de acuerdo.%SPEECH_ON%Son de los mejores soldados que he visto nunca. No creo que tengan nada que temer. ¡Nuestros enemigos temen por sus vidas cuando los ven!%SPEECH_OFF%Pero tus palabras no caen bien. Uno de los mercenarios se inclina hacia adelante con un brazo a la espalda, pero otro le pone una mano en el hombro y niega rápidamente con la cabeza. Se limita a mirarte y decir:%SPEECH_ON%Es una noticia muy preocupante, señor, pero seguiremos adelante.%SPEECH_OFF%Cuando se dan la vuelta para irse, te fijas en que el broche de la daga envainada de uno de los hombres está desabrochado."
    }
    // context: more_men_event.o.create.s.Text
    {
        // corrige base: «alcanza detrás de su espalda» calca «reaches behind his back»; es llevarse la mano a la espalda
        en = "[img]gfx/ui/events/event_05.png[/img]Fanning your arms out and pressing forth a smile that couldn't sell water to a thirsty man, you lie.%SPEECH_ON%We've simply not the coffers to take on more trainees.%SPEECH_OFF%The mercenaries don't take it well. One immediately turns around and exits the tent, a wake of curses and swears in the wake of his leaving. Another momentarily reaches behind their back. You glance at your sword again. Seeing you doing this, the mercenary puts hands back where you can see them. Finally, nodding, they state. %SPEECH_ON%We'll do as told, sir. For now.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_05.png[/img]Abriendo los brazos y forzando una sonrisa que no le vendería agua ni a un sediento, mientes.%SPEECH_ON%Sencillamente no tenemos fondos para admitir más aprendices.%SPEECH_OFF%A los mercenarios no les sienta bien. Uno se da la vuelta de inmediato y sale de la tienda, dejando tras de sí un reguero de maldiciones y juramentos. Alguien más se lleva por un momento la mano a la espalda. Vuelves a echar un vistazo a tu espada. Al verte hacerlo, vuelve a poner las manos donde puedas verlas. Por fin, asiente y declara: %SPEECH_ON%Haremos lo que se nos diga, señor. Por ahora.%SPEECH_OFF%"
    }
    // context: more_men_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]When you let the mercenaries know that you've not enough crowns on hand to hire more recruits, they nod.%SPEECH_ON%We thought you might say that. So here's our suggestion, and we don't say this lightly, but each of us will give you part of what we saved up for retirement so that you may hire others. And you'll pay us back with our wages.%SPEECH_OFF%You quickly glance up, the suggestion seemingly coming out of nowhere."
        es = "[img]gfx/ui/events/event_05.png[/img]Cuando les haces saber a los mercenarios que no tienes suficientes coronas a mano para contratar más reclutas, asienten.%SPEECH_ON%Pensamos que dirías eso. Así que aquí va nuestra propuesta, y no la hacemos a la ligera: cada uno de nosotros te dará parte de lo que ha ahorrado para el retiro para que puedas contratar a otros. Y nos lo devolverás con nuestras pagas.%SPEECH_OFF%Levantas la vista de golpe; la propuesta parece haber salido de la nada."
    }
    // context: more_men_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]You let the mercenaries know that you've not the crowns to take on more sellswords. They collectively sigh and nod.%SPEECH_ON%That's alright, sir. T'was only a suggestion. As always, we shall march on your orders.%SPEECH_OFF%The warriors turn and leave, a little slouched over and quieter than before."
        es = "[img]gfx/ui/events/event_05.png[/img]Les haces saber a los mercenarios que no tienes coronas para admitir más mercenarios. Suspiran a la vez y asienten.%SPEECH_ON%No pasa nada, señor. Solo era una sugerencia. Como siempre, marcharemos según sus órdenes.%SPEECH_OFF%Los guerreros se dan la vuelta y se van, algo encorvados y más callados que antes."
    }
    // context: more_men_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]You get up and shake the hands of each mercenary. While you loudly state that you wish it didn't come to this, you are secretly beaming at the fact you now have more crowns at your disposal."
        es = "[img]gfx/ui/events/event_05.png[/img]Te levantas y estrechas la mano de cada mercenario. Mientras dices en voz alta que ojalá no se hubiera llegado a esto, en secreto estás radiante porque ahora tienes más coronas a tu disposición."
    }
    // context: more_men_event.o.create.s.Options[0].Text
    {
        // corrige base: errata «para compañía» por «para la compañía»
        en = "Let's go hire some more comrades for the company!"
        es = "¡Vamos a contratar más camaradas para la compañía!"
    }
    // context: more_men_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]You look the mercenaries over. They are solemn creatures, not the ones you last saw grinning and laughing over their latest victory or triumph. While you can't yet afford to get them more recruits, there really is no need to cut their pay.%SPEECH_ON%I appreciate the selflessness and bravery it must've took to suggest such a thing, but I cannot possibly consider myself a leader of honor and grant you this request. Your savings shall remain untouched.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_05.png[/img]Observas detenidamente a los mercenarios. Son criaturas solemnes, no las mismas que viste por última vez sonriendo y riendo por su última victoria o triunfo. Aunque todavía no puedes permitirte conseguirles más reclutas, de verdad no hace falta recortarles la paga.%SPEECH_ON%Agradezco la abnegación y la valentía que debe de haber hecho falta para sugerir algo así, pero no podría considerarme un líder de honor si accediera a esta petición. Sus ahorros quedarán intactos.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\no_food_variety_event.nut
    // context: no_food_variety_event.o.create.s.Text
    {
        // corrige base: "shite" es "mierda", no "porquería" (rebaja la crudeza); además falta la exclamación de esa frase
        en = "[img]gfx/ui/events/event_52.png[/img]{You find the mercenaries circled around a campfire, except they've no real food to put over the flames. One throws %their_randombrother% bowl of soup down. It is such a sludge that it barely moves to spill which is, honestly, quite disgusting. %randombrother% looks at you.%SPEECH_ON%Sir, please, let us get some meat! Or something beyond this shite!%SPEECH_OFF%A bit of variety wouldn't hurt, you agree. | %randombrother% comes to you and slams a spoon on your desk. There's something on the spoon, but what exactly you can't tell. The mercenary leans back, thumbs jacked into %their_randombrother% beltline, %their_randombrother% chest growing with breath. Then %they_randombrother% sighs, for %they_randombrother% knows not to behave in such ill-manner in your presence. But %they_randombrother% does explain %themselves_randombrother%.%SPEECH_ON%Sir, the men are complaining about the food. I think it'd be great for company morale if perhaps we picked up some meats and other goods in the next town. Only a suggestion, of course.%SPEECH_OFF%%They_randombrother% quickly leaves. You pick up the spoon and look at whatever is in the scoop of it. That... that can't really be what they're eating out there, can it? Perhaps some variety wouldn't hurt... | %randombrother% approaches with a bowl in hand. %They_randombrother% tilts it forward, showing the contents which are colorless and slide ever so slowly down the rim of the bowl. The mercenary shakes %their_randombrother% head.%SPEECH_ON%The men are unhappy sir, and myself too, about the dinners we've been eating. A man can only eat the same contents day after day for so long, especially when %they_randombrother% knows %they_randombrother% can afford so much more. It is only a suggestion, sir, from myself and from all the men, that perhaps we liven up our food stocks so that not every meal is... well, this.%SPEECH_OFF%%They_randombrother% sets the bowl down and walks off. | A few of your mercenaries are complaining around a campfire. You stay within earshot, carefully listening as they might say things they wouldn't in your presence. Thankfully, it's not a mutiny in motion, but instead a series of cooking criticisms. There simply is not enough variety in the company's food stocks. They're tired of eating the same thing over and over. Perhaps this could be remedied in the next town the %companyname% visits?}"
        es = "[img]gfx/ui/events/event_52.png[/img]{Encuentras a los mercenarios reunidos alrededor de una fogata, pero no tienen comida de verdad que poner sobre las llamas. Uno de ellos tira al suelo su tazón de sopa. Es un engrudo tan espeso que apenas se mueve al derramarse, lo cual es, sinceramente, bastante repugnante. %randombrother% te mira.%SPEECH_ON%Señor, por favor, ¡permítanos conseguir algo de carne! ¡O algo que no sea esta mierda!%SPEECH_OFF%Estás de acuerdo en que un poco de variedad no haría daño. | %randombrother% se acerca y estampa una cuchara contra tu escritorio. Hay algo en la cuchara, pero no sabrías decir qué es exactamente. %Art_randombrother% mercenari%o_randombrother% se echa hacia atrás, con los pulgares metidos en el cinturón y el pecho hinchándose de aire. Luego suspira, porque sabe que no debe comportarse con tan malos modales en tu presencia. Pero sí se explica.%SPEECH_ON%Señor, los hombres se quejan de la comida. Creo que le vendría de maravilla a la moral de la compañía que compráramos carne y otros víveres en el próximo pueblo. Solo es una sugerencia, claro.%SPEECH_OFF%Se va rápidamente. Recoges la cuchara y miras lo que sea que hay en ella. Eso... eso no puede ser de verdad lo que están comiendo ahí fuera, ¿no? Quizá un poco de variedad no estaría mal... | %randombrother% se acerca con un tazón en la mano. Lo inclina hacia delante y te muestra el contenido, incoloro, que se desliza con suma lentitud por el borde del tazón. %Art_randombrother% mercenari%o_randombrother% niega con la cabeza.%SPEECH_ON%Los hombres no están contentos, señor, y yo tampoco, con las cenas que hemos estado comiendo. Un hombre solo puede comer lo mismo día tras día durante un tiempo, sobre todo cuando sabe que puede permitirse mucho más. Es solo una sugerencia, señor, mía y de todos los hombres: quizá podríamos animar un poco nuestras provisiones para que no todas las comidas sean... bueno, esto.%SPEECH_OFF%Deja el tazón y se marcha. | Algunos de tus mercenarios se quejan alrededor de una fogata. Te quedas al alcance del oído, escuchando con atención, ya que podrían decir cosas que no dirían en tu presencia. Por suerte, no se trata de un motín en marcha, sino de una serie de críticas culinarias. Sencillamente, no hay suficiente variedad en las provisiones de comida de la compañía. Están cansados de comer lo mismo una y otra vez. ¿Quizá podría remediarse en el próximo pueblo que visite %companyname%?}"
    }
    // FILE: mod_legends\hooks\events\events\noble_more_pay_lowborn_event.nut
    // context: noble_more_pay_lowborn_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_64.png[/img] %noble% suddenly enters your tent. %They're_noble% attired in armor and %their_noble% weapon is at %their_noble% side. It almost seems as if %they_noble% dressed up for this occasion, and %they_noble% does indeed stand upright and proper. You ask what it is %they_noble% wants, and %they_noble% speaks with %their_noble% head held high and %their_noble% eyes looking straight ahead.%SPEECH_ON%It has come to my attention that %lowborn% is paid more than I. While I've no issue with the %person_lowborn% personally, I do want to point out that %they_lowborn% is a %person_lowborn% with no birthright to anything but %their_lowborn% own two feet. You can't possibly have a lowborn being paid more than a %person_noble% of the purple. We nobles deserve more.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_64.png[/img] %noble% entra de repente en tu tienda. Va vestid%o_noble% con armadura y lleva el arma al costado. Casi parece que se hubiera arreglado para la ocasión, y en efecto se mantiene erguid%o_noble% y con un porte impecable. Le preguntas qué quiere y te habla con la cabeza bien alta y la mirada fija al frente.%SPEECH_ON%Ha llegado a mi conocimiento que a %lowborn% se le paga más que a mí. Aunque no tengo nada personal contra %ese_lowborn% %hombre_lowborn%, sí quiero señalar que es %un_lowborn% %hombre_lowborn% sin más derecho de nacimiento que sus propios dos pies. No puedes permitir que alguien de baja cuna cobre más que %un_noble% %hombre_noble% nacid%o_noble% en la púrpura. Los nobles merecemos más.%SPEECH_OFF%"
    }
    // context: noble_more_pay_lowborn_event.o.create.::Legends.Screens.hook()._screen.Options[0].Text
    {
        en = "I will see to it you are paid no less than %them_lowborn%."
        es = "Me aseguraré de que se te pague al menos lo mismo que a %el_lowborn%."
    }
    // context: noble_more_pay_lowborn_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_64.png[/img]You don't necessarily agree with %them_noble%, but at the same time you can see that denying this request may cause some heretofore unseen problems. With a few dashes of your quill pen across the roster scroll, you assign %noble% a higher salary and tell %them_noble% to expect a heavier purse come next payday. The %person_noble% finally looks at you and bows from the waist.%SPEECH_ON%You've made the good and proper decision.%SPEECH_OFF%%They_noble% turns on %their_noble% heels and marches back out with as much gusto as %they_noble% did coming in."
        es = "[img]gfx/ui/events/event_64.png[/img]No es que estés del todo de acuerdo con %el_noble%, pero a la vez ves que negarle esta petición podría causar problemas hasta ahora imprevistos. Con unos cuantos trazos de pluma sobre el rollo de la plantilla, le asignas a %noble% un salario más alto y le dices que espere una bolsa más pesada el próximo día de paga. %Art_noble% noble por fin te mira y se inclina desde la cintura.%SPEECH_ON%Has tomado la decisión buena y correcta.%SPEECH_OFF%Gira sobre sus talones y sale marchando con tanto brío como entró."
    }
    // context: noble_more_pay_lowborn_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "o un jodido duque" no está en el inglés (añadido)
        // corrige base: "seniority and veterancy" es "antigüedad y veteranía", no "veteranía y experiencia"
        // corrige base: errata "a mi respecta" por "a mí respecta"
        // corrige base: "jowls" son los carrillos o la papada, no el mentón
        en = "[img]gfx/ui/events/event_64.png[/img]You tell the %person_noble% to look at you. %They_noble% slowly shifts %their_noble% eyes to yours. Having %their_noble% attention, you explain how it is around here.%SPEECH_ON%I pay on seniority and veterancy, not who you were before you signed the dotted line. You could be a goatfarmer for all I care, if you can swing a sword you'll get paid, and if you can swing it better than the next man then I'll be damned, you'll be getting paid more than the next man! Anything in that you don't understand?%SPEECH_OFF%%noble%'s jowls quiver as %they_noble% bottles a sudden spurt of rage. %They_noble% speaks through clenched teeth.%SPEECH_ON%No, sir.%SPEECH_OFF%With a flick of a wrist, you tell %them_noble% to get out of your sight. %They_noble% leaves in a hurry, %their_noble% upright stance falling into a seething slouch."
        es = "[img]gfx/ui/events/event_64.png[/img]Le dices %al_noble% noble que te mire. Despacio, desplaza la mirada hasta la tuya. Con su atención puesta en ti, le explicas cómo funcionan las cosas por aquí.%SPEECH_ON%Pago por antigüedad y veteranía, no por quién eras antes de firmar en la línea de puntos. Por mí, como si criaras cabras: si sabes blandir una espada, cobrarás, y si la blandes mejor que el de al lado, ¡que me lleve el diablo si no cobras más que el de al lado! ¿Hay algo de esto que no entiendas?%SPEECH_OFF%Los carrillos de %noble% tiemblan mientras contiene un repentino arrebato de ira. Habla con los dientes apretados.%SPEECH_ON%No, señor.%SPEECH_OFF%Con un gesto de la muñeca, le dices que se quite de tu vista. Se marcha a toda prisa, y su porte erguido se hunde en una postura encorvada y rabiosa."
    }
    // context: noble_more_pay_lowborn_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "puto" y el silabeo "re-du-ci-do" no están en el inglés (añadidos)
        // corrige base: "born with a silver spoon" es el modismo "nacer en cuna de oro", no "con una cuna de plata"
        // corrige base: errata "¿o si?" por "¿o sí?"
        en = "[img]gfx/ui/events/event_64.png[/img]You stand up out of your chair and yell at the %person_noble% to look at you. %They_noble% does as told and so you explain what is going to happen.%SPEECH_ON%%lowborn% made it through this world by dragging %themselves_lowborn% out of the mud. You were born with a silver spoon, but this isn't where you were born now is it? So from today consider your pay effectively lowered. You want the right to a higher salary? Earn it.%SPEECH_OFF%The noble's stance falters. %They_noble% opens %their_noble% mouth, but you quickly raise your hand.%SPEECH_ON%No more words. Get out of my sight.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_64.png[/img]Te levantas de la silla y le gritas %al_noble% noble que te mire. Obedece, así que le explicas lo que va a pasar.%SPEECH_ON%%lowborn% se abrió camino en este mundo arrastrándose fuera del barro. Tú naciste en cuna de oro, pero aquí no es donde naciste, ¿o sí? Así que, desde hoy, considera tu paga rebajada. ¿Quieres derecho a un salario más alto? Gánatelo.%SPEECH_OFF%La postura %del_noble% noble flaquea. Abre la boca, pero alzas rápidamente la mano.%SPEECH_ON%Ni una palabra más. Fuera de mi vista.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\noble_vs_lowborn_event.nut
    // context: noble_vs_lowborn_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_64.png[/img] You find the %noble_noble% %nobleman_short% and the rather ragged-looking %lowborn% quarreling over the last piece of food on a spit. Apparently the lowborn got %their_lowborn% fork to it first, but the %noble_noble% claimed that %their_noble% high stature granted %them_noble% the right to the meat."
        es = "[img]gfx/ui/events/event_64.png[/img] Encuentras %al_noble% noble %nobleman_short% y a %lowborn%, de aspecto bastante desaliñado, discutiendo por el último trozo de comida de un espetón. Al parecer, %art_lowborn% de baja cuna llegó primero con el tenedor, pero %art_noble% noble alegó que su alta alcurnia le daba derecho a la carne."
    }
    // context: noble_vs_lowborn_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: omite el arranque (los dos te miran buscando orientación, te cruzas de brazos y te encoges de hombros, vuelven a encararse y los demás se levantan y retroceden) y lo resume en otra frase
        // corrige base: lo que sale despedido es el espetón ("the spit"), no la comida; "Amenazan y escupen el uno al otro" es "se amenazan y se escupen"
        en = "[img]gfx/ui/events/event_06.png[/img] As the they look to you for guidance, you fold your arms and shrug. They slowly turn back to one another. The other people in the camp stand up and step back, giving room to what is coming. The lowborn draws %their_lowborn% dagger first. It is a simple thing with a wooden handle and jagged, unnaturally serrated edges. The %noble_noble% pulls %their_noble% blade in return, brandishing a metal that curves with the care of a blacksmith's mastery. Two golden snakes curl up the handle to bite the pommel. Its wielder grins, saying the riff-raff should learn their place. The lowborn grins like a %person_lowborn% who has had no practice doing it.\n\nSurprisingly, both then chuck the daggers into the stumps upon which they sat and close rank with fists raised, the most equal of fighting grounds. In the ensuing battle the spit is immediately knocked aside and flames fan upward, raining wild embers and the felled food is now flavored with ash and soot.\n\nSeeing their meal ruined, the rest of the company finally puts an end to the combat, pulling the two apart. They threaten and spit at one another, but after a few minutes everything settles down."
        es = "[img]gfx/ui/events/event_06.png[/img] Mientras te miran en busca de orientación, te cruzas de brazos y te encoges de hombros. Poco a poco vuelven a encararse. Los demás en el campamento se levantan y retroceden, dejando sitio a lo que se avecina. %Art_lowborn% de baja cuna saca primero su daga. Es una cosa sencilla, con mango de madera y filos mellados y dentados de forma antinatural. %Art_noble% noble desenvaina a su vez su hoja, blandiendo un metal que se curva con el esmero de un herrero maestro. Dos serpientes doradas se enroscan por el mango hasta morder el pomo. Quien la empuña sonríe y dice que la chusma debería aprender cuál es su sitio. %Art_lowborn% de baja cuna sonríe como quien nunca ha practicado hacerlo.\n\nSorprendentemente, los dos clavan entonces las dagas en los tocones que les servían de asiento y se encaran con los puños en alto, el más igualado de los terrenos de pelea. En la refriega que sigue, el espetón sale despedido de inmediato y las llamas se avivan, lanzando una lluvia de ascuas; la comida caída queda ahora aderezada con ceniza y hollín.\n\nAl ver su cena arruinada, el resto de la compañía acaba por fin con el combate y separa a la pareja de contendientes. Se amenazan y se escupen, pero al cabo de unos minutos todo se calma."
    }
    // context: noble_vs_lowborn_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_64.png[/img]%nobleman% looks aghast. %They_noble% slowly lifts %their_noble% fork from the spit and %lowborn% immediately shovels the last bit of meat into %their_lowborn% mouth. The %noble_noble% gets up and heads your way. %They_noble% straightens before you, bumping %their_noble% chest into yours as you lock eyes. A few of the people put their hands on their pommels.%SPEECH_ON%{Siding with the lowborn, huh? I fancied you would, being lowborn yourself. Don't ever expect to become one of us. You're a sellsword for life. Remember that. | You expect to get a piece of land when all this is said and done, yeah? I hope you do, because then I'll come and knock and show you how nobles really treat one another.}%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_64.png[/img]%nobleman% se queda horrorizad%o_noble%. Retira despacio el tenedor del espetón y %lowborn% se mete de inmediato el último trozo de carne en la boca. %Art_noble% noble se levanta y se dirige hacia ti. Se planta erguid%o_noble% ante ti y choca su pecho contra el tuyo mientras se miran fijamente a los ojos. Algunos de los presentes llevan la mano al pomo.%SPEECH_ON%{Te pones del lado %del_lowborn% de baja cuna, ¿eh? Ya me imaginaba que lo harías, siendo tú también de baja cuna. Ni se te ocurra esperar llegar a ser uno de nosotros. Serás un mercenario de por vida. Recuérdalo. | Esperas que te den un pedazo de tierra cuando todo esto acabe, ¿no? Ojalá te lo den, porque entonces iré a llamar a tu puerta y te enseñaré cómo se tratan de verdad los nobles entre sí.}%SPEECH_OFF%"
    }
    // context: noble_vs_lowborn_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_64.png[/img]%nobleman% grins as he knocks %lowborn%'s fork out of the way. The %noble_noble% takes the food for himself as the lowborn gets up and storms toward you. As %they_lowborn% nears, some sellswords look ready to draw swords, but you hold a hand out, calming them.%SPEECH_ON%I thought you were one of us, but I guess not. I suppose you think someday you'll be one of them, huh? Keep dreaming. As that man would say to me, 'Know your place'.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_64.png[/img]%nobleman% sonríe mientras aparta de un golpe el tenedor de %lowborn%. %Art_noble% noble se queda con la comida mientras %art_lowborn% de baja cuna se levanta y se dirige furios%o_lowborn% hacia ti. Mientras se acerca, algunos mercenarios parecen dispuestos a desenvainar, pero extiendes una mano para calmarlos.%SPEECH_ON%Pensé que eras uno de nosotros, pero supongo que no. Supongo que crees que algún día serás uno de ellos, ¿eh? Sigue soñando. Como me diría %ese_noble% noble: 'Aprende cuál es tu sitio'.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\peddler_deal_event.nut
    // context: peddler_deal_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]%peddler% comes to you, rubbing the back of their neck and nervously pulling on their shirt front. %peddler%  proposes a plan to go into town with a handful of goods to peddle around, as they've done so often in the past.\n\nOnly problem is that %peddler%  doesn't yet have the goods -  those will need to be bought from some local in the nearby hinterlands. All %peddler% needs now is a bit of money to get started and help purchase the goods. A sum of 500 crowns all in all. Naturally, as a partner, you will get a cut of the profits once it's all said and done."
        es = "[img]gfx/ui/events/event_05.png[/img]%peddler% se te acerca frotándose la nuca y tirando nerviosamente de la pechera de la camisa. %peddler% te propone ir al pueblo con un puñado de mercancías para venderlas por ahí, como tantas veces ha hecho en el pasado.\n\nEl único problema es que %peddler% aún no tiene la mercancía: habrá que comprársela a algún lugareño de las tierras cercanas. Lo único que necesita %peddler% ahora es un poco de dinero para empezar y ayudar a comprar el género. Una suma de 500 coronas en total. Naturalmente, como socio, te llevarás una parte de las ganancias cuando todo esté dicho y hecho."
    }
    // context: peddler_deal_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_04.png[/img]You hand %peddler% the crowns and send them off.\n\nA few hours later, the peddler comes running up with a small lockbox in hand. The wily grin on %peddler%'s face is undeniable, unwittingly fistpumping while gliding to you. When %peddler%  tries to speak, but is seized by gasps of breath. You hold your hand out, telling %peddler%  to take their time. Settling down, the mercenary hands over a heavy purse of coins, stating that it is your cut of the profits.\n\nBefore you can even say anything, the peddler wheels on their heels and jumps away, giddy with success."
        es = "[img]gfx/ui/events/event_04.png[/img]Le das las coronas a %peddler% y le dices que se ponga en marcha.\n\nUnas horas más tarde, vuelve a la carrera con un cofrecito en la mano. La sonrisa pícara en el rostro de %peddler% es innegable, y se acerca casi flotando mientras agita el puño sin darse cuenta. %peddler% intenta hablar, pero se ahoga entre jadeos. Extiendes la mano y le dices a %peddler% que se tome su tiempo. Cuando se calma, te entrega una pesada bolsa de monedas y te dice que es tu parte de las ganancias.\n\nAntes de que puedas decir nada, gira sobre sus talones y se aleja dando saltos, rebosante de euforia por el éxito."
    }
    // context: peddler_deal_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]%peddler% makes off and you tend to other business for the day.\n\nAs you step out of your tent hours later, you see a slumped shape in the distance, steadily heading your way. It appears to be the peddler, carrying nothing but a frown. As %peddler% gets closer, you begin to see the bruises that dot their body. %peddler% explains that while managing to purchase the goods from the source, the actual townspeople weren't particularly warm to the selling tactics.\n\nWhat money was invested has been lost and %peddler% heads to a tent to nurse those wounds."
        es = "[img]gfx/ui/events/event_05.png[/img]%peddler% se marcha y tú te ocupas de otros asuntos durante el día.\n\nCuando sales de tu tienda horas después, ves a lo lejos una figura encorvada que se dirige hacia ti a paso constante. Parece ser %peddler%, que no trae más que el ceño fruncido. Cuando %peddler% se acerca, empiezas a ver los moratones que le salpican el cuerpo. %peddler% explica que, aunque logró comprar la mercancía en origen, la gente del pueblo no recibió con mucho agrado sus técnicas de venta.\n\nEl dinero invertido se ha perdido y %peddler% se va a una tienda a curarse las heridas."
    }
    // en = "You lose <v:val_tag> Crowns"
    // en base_es
    // en = "<student:str> suffers light wounds"
    // en base_es
    // context: peddler_deal_event.o.create.s.start._event.m.Peddler.worsenMood()
    {
        en = "Failed in a plan and lost a large amount of money"
        es = "Fracasó en un plan y perdió mucho dinero"
    }
    // FILE: mod_legends\hooks\events\events\peddler_sells_rat_event.nut
    // context: peddler_sells_rat_event.o.create.s.Text
    {
        // corrige base: omite "skeevy" (de dudosa calaña)
        // corrige base: signos desparejados en "¡Eres un cazador de ratas, ¿por qué comprarías una?" y en "¡Ah, ¿un pez dorado entonces?"
        // corrige base: "Pet rats" son ratas de compañía, no mascotas en general
        en = "[img]gfx/ui/events/event_05.png[/img]%SPEECH_ON%For the last time, no, I won't buy a rat.%SPEECH_OFF%You see %ratcatcher% the ratcatcher turn a corner with the skeevy peddler %peddler% in pursuit. The salesman throws another pitch.%SPEECH_ON%'Course you won't buy one! You're a ratcatcher, why would you buy one? But what if...%SPEECH_OFF%The ratcatcher stops and turns, planting a firm finger into the peddler's chest.%SPEECH_ON%Pet rats don't go grow on trees, %peddler%! They're born of a different stock! If I need a rat by my side I'll find it myself! Now, if you got a rat you need killin', that's a different matter.%SPEECH_OFF%%peddler%'s eyes fall to the ground, thinking for a moment. Suddenly, their gaze lifts along with their spirits and a pointing finger.%SPEECH_ON%Ah, a goldfish then? Would you buy a goldfish?%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_05.png[/img]%SPEECH_ON%Por última vez: no, no voy a comprar una rata.%SPEECH_OFF%Ves a %ratcatcher%, de oficio cazarratas, doblar una esquina con %peddler%, comerciante de dudosa calaña, pisándole los talones. Llega otro intento de venta.%SPEECH_ON%¡Claro que no vas a comprar una! Eres cazarratas, ¿para qué ibas a comprar una? Pero ¿y si...?%SPEECH_OFF%La víctima de tanta insistencia se detiene, se gira y planta un dedo firme en el pecho de quien la persigue.%SPEECH_ON%¡Las ratas de compañía no crecen en los árboles, %peddler%! ¡Son de otra estirpe! ¡Si necesito una rata a mi lado, la encontraré por mi cuenta! Ahora, si tienes una rata que haya que matar, eso ya es otro asunto.%SPEECH_OFF%Los ojos de %peddler% bajan al suelo mientras piensa un momento. De repente, la mirada se le levanta junto con el ánimo y un dedo que señala.%SPEECH_ON%¡Ah! ¿Y un pez dorado, entonces? ¿Comprarías un pez dorado?%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\pessimist_won_battle_event.nut
    // context: pessimist_won_battle_event.o.create.s.Text
    {
        // corrige base: "prick" es un insulto ("imbécil"), no "pesado" (rebaja la crudeza)
        en = "[img]gfx/ui/events/event_64.png[/img]Ever the downer, %pessimist% mopes around, wallowing in victory as good as any pissy pessimist could. %They_pessimist% throws a dismissive hand out.%SPEECH_ON%We have tasted victory and what of it? Our victory was their defeat, so it very well may be that one day someone else's victory is going to come at our expense, don't you see? Let us not put the cart in front of the horse lest the shadows of morrow sneak upon us whilst we bask in this supposedly glorious light.%SPEECH_OFF%A few sellswords tell %them_pessimist% to stop being such a prick, but %their_pessimist% brunt realism tempers the zeal of others."
        es = "[img]gfx/ui/events/event_64.png[/img]Aguafiestas como siempre, %pessimist% anda alicaíd%o_pessimist% de aquí para allá, regodeándose en la victoria como solo sabría hacerlo cualquier pesimista cascarrabias. Hace un gesto desdeñoso con la mano.%SPEECH_ON%Hemos saboreado la victoria, ¿y qué? Nuestra victoria fue su derrota, así que bien puede ser que un día la victoria de otros llegue a costa nuestra, ¿no lo ves? No pongamos el carro delante de los bueyes, no sea que las sombras del mañana nos sorprendan mientras disfrutamos de esta luz supuestamente gloriosa.%SPEECH_OFF%Algunos mercenarios le dicen que deje de ser tan imbécil, pero su crudo realismo templa el fervor de otros."
    }
    // FILE: mod_legends\hooks\events\events\pimp_vs_harlot_event.nut
    // context: pimp_vs_harlot_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_92.png[/img]With a parental appeal you take the pimp by the shoulder.%SPEECH_ON%You can take the woman out of a whore, but you can't take the whore out of a woman.%SPEECH_OFF%The pimp thinks it over. You do, too, as you were never one for logic. The pimp looks at you.%SPEECH_ON%What?%SPEECH_OFF%The lady steps forward, taking the pimp by the other shoulder.%SPEECH_ON%I think he's saying to cut me loose.%SPEECH_OFF%When the pimp raises an eyebrow, the woman clarifies.%SPEECH_ON%Figuratively speaking.%SPEECH_OFF%The pimp sighs.%SPEECH_ON%I don't understand what the hell you two are saying, but alright. I thought maybe I could get a business going here. A woman here, a woman there, peddle their gooches and mooches, make some crowns, retire early. Oh well, back to grinding wheat into flour until I keel over and die.%SPEECH_OFF%The man walks off, his nose sniffling."
        es = "[img]gfx/ui/events/event_92.png[/img]Con aire paternal, tomas al proxeneta por el hombro.%SPEECH_ON%Puedes sacar a la mujer de la puta, pero no puedes sacar a la puta de la mujer.%SPEECH_OFF%El proxeneta le da vueltas. Tú también, porque la lógica nunca fue lo tuyo. El proxeneta te mira.%SPEECH_ON%¿Qué?%SPEECH_OFF%La dama da un paso al frente y toma al proxeneta por el otro hombro.%SPEECH_ON%Creo que te está diciendo que me sueltes.%SPEECH_OFF%Cuando el proxeneta arquea una ceja, la mujer aclara:%SPEECH_ON%En sentido figurado.%SPEECH_OFF%El proxeneta suspira.%SPEECH_ON%No entiendo qué demonios están diciendo ustedes dos, pero bueno. Pensé que a lo mejor podía montar un negocio aquí. Una mujer por aquí, otra por allá, alquilarles los bajos y lo que haga falta, ganar unas coronas y retirarme pronto. En fin, a volver a moler trigo hasta caer muerto.%SPEECH_OFF%El hombre se marcha sorbiéndose los mocos."
    }
    // context: pimp_vs_harlot_event.o.create.s.Text
    {
        // corrige base: "minge" es "coño", no "perra" (cambia el sentido)
        // corrige base: "his cock and balls" rebajado a "su miembro viril"
        // corrige base: "You roll yours" es "pones los ojos en blanco", no "revuelves los ojos" (calco)
        // corrige base: "not a business of one holy-oh, ohhh!" es un gorgorito cantado que se corta, no "una única santa"
        en = "[img]gfx/ui/events/event_92.png[/img]%minstrel% the minstrel glides forward.%SPEECH_ON%Ahoy, what is this but a tale of a dullard and tail of a whore? With one look I know what you need to do my friend: profess your undying love to this minge!%SPEECH_OFF%The woman crosses her arms and creases her eyebrows.%SPEECH_ON%Just what are you on abou--%SPEECH_OFF%The minstrel bats her out of the way and raises an arm and a singly voice with it.%SPEECH_ON%Ahoyyy! Love, yes, love is in the air! Best let it flare! - and I'm not just talking about his cock and balls. He loves you, my dear, can't you see? Why else would he make a harlot out of only thee? A pimp needs a diverse portfolio, not a business of one holy-oh, ohhh!%SPEECH_OFF%The pimp drops his head, face red and embarrassed. He admits it's true, all of it. The woman looks over, her face flushed. They lock eyes. You roll yours. They embrace and make off all lovey-dovey. %minstrel% scratches their chin.%SPEECH_ON%I'm a poet and I didn't even... realize it.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_92.png[/img]Con su gracia de juglar, %minstrel% se adelanta deslizándose.%SPEECH_ON%¡Ahoy! ¿Qué tenemos aquí sino el cuento de un zopenco y el culo de una puta? Con una sola mirada sé lo que debes hacer, amigo mío: ¡profesar tu amor eterno a este coño!%SPEECH_OFF%La mujer se cruza de brazos y frunce el ceño.%SPEECH_ON%¿Se puede saber de qué estás habl--%SPEECH_OFF%La aparta de un manotazo y alza un brazo y, con él, una voz cantarina.%SPEECH_ON%¡Ahoyyy! ¡El amor, sí, el amor está en el aire! ¡Mejor dejarlo arder! - y no hablo solo de su verga y sus pelotas. Te ama, querida, ¿no lo ves? ¿Por qué si no te haría ramera solo a ti? ¡Un proxeneta necesita una cartera variada, no un negocio de una sola... oh, ohhh!%SPEECH_OFF%El proxeneta agacha la cabeza, con la cara roja de vergüenza. Admite que es verdad, todo. La mujer lo mira, con el rostro encendido. Se miran a los ojos. Tú pones los tuyos en blanco. Se abrazan y se van de lo más acaramelados. %minstrel% se rasca la barbilla.%SPEECH_ON%Soy poeta y ni siquiera... me había dado cuenta.%SPEECH_OFF%"
    }
    // context: pimp_vs_harlot_event.o.create.s.start._event.m.Minstrel.improveMood()
    {
        en = "Enchanted by their own poetry"
        es = "Le encantó su propia poesía"
    }
    // context: pimp_vs_harlot_event.o.create.s.Text
    {
        // corrige base: "whores" y "whore's coin" rebajados a "prostitutas"
        // corrige base: "I daresay" es "me atrevería a decir", no "osarías decir" (cambia la persona y el sentido)
        // corrige base: "lackadaisical" es "desganado", no "desinteresado"
        // corrige base: "crowns" son coronas, no "monedas de oro"
        en = "[img]gfx/ui/events/event_92.png[/img]'Tsk, tsk, tsk.' %tailor% the tailor struts on up shaking their head and running a finger along the prostitute's dress. %tailor% remarks that whores are supposed to be pretty. The pimp raises his hand.%SPEECH_ON%That's my property you're spittin' on.%SPEECH_OFF%%tailor% bows.%SPEECH_ON%Apologies, sir, but I do believe you have already spit on her yourself dressing her in such a manner. I'd not know she's looking for a whore's coin had you not yelled at her with a pimp's, hm, lackadaisical sense of economics.%SPEECH_OFF%The pimp draws a dagger out and attacks. The tailor pirouettes, spinning beneath the blade's strike then springing back upright and jamming a thick pair of scissors to the pimp's throat.%SPEECH_ON%Mmm, what a quaint position to be in. I daresay you have but two ways out, and one is much shinier than the other. Yes, that's right, you get it don't you? Pay up or I'll cut yer throat and clip your nuts and the order which I do it just might surprise you.%SPEECH_OFF%The pimp hastily forks over some crowns to spare his life. The tailor 'snips' his scissors closed and pockets them.%SPEECH_ON%Good. Now for some advice. You can find linens for cheap down the street yonder. The man who works the shop there is, hm, particularly good at outfitting women... and men. Tata now.%SPEECH_OFF%%tailor% turns to you with a grin and asks for permission to go and visit some shops to spend the newly found gold."
        es = "[img]gfx/ui/events/event_92.png[/img]'Tsk, tsk, tsk.' %tailor%, sastre de oficio, se acerca pavoneándose, negando con la cabeza y pasando un dedo por el vestido de la prostituta. %tailor% comenta que se supone que las putas tienen que ser bonitas. El proxeneta levanta la mano.%SPEECH_ON%Estás escupiendo sobre mi propiedad.%SPEECH_OFF%%tailor% hace una reverencia.%SPEECH_ON%Mis disculpas, señor, pero creo que ya la escupiste tú mismo al vestirla de esa manera. No sabría que busca la moneda de una puta si no le hubieras gritado con ese, hm, desganado sentido de la economía propio de un proxeneta.%SPEECH_OFF%El proxeneta saca una daga y ataca. Su rival responde con una pirueta: gira por debajo del tajo de la hoja, se yergue de un salto y le planta unas gruesas tijeras en la garganta al proxeneta.%SPEECH_ON%Mmm, qué posición tan pintoresca. Me atrevería a decir que solo tienes dos salidas, y una brilla mucho más que la otra. Sí, eso es, lo entiendes, ¿verdad? Paga o te rajo el cuello y te corto los huevos, y el orden en que lo haga quizá te sorprenda.%SPEECH_OFF%El proxeneta suelta a toda prisa unas coronas para salvar la vida. Las tijeras se cierran con un 'chas' y desaparecen en un bolsillo.%SPEECH_ON%Bien. Ahora, un consejo. Puedes encontrar telas baratas calle abajo, por allí. El hombre que lleva esa tienda es, hm, especialmente bueno vistiendo a mujeres... y a hombres. Adiosito.%SPEECH_OFF%%tailor% se vuelve hacia ti con una sonrisa y te pide permiso para ir a visitar algunas tiendas y gastarse el oro recién conseguido."
    }
    // context: pimp_vs_harlot_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_92.png[/img]%monk% the monk steps forward, taking the pimp by the hands. Were you to do that, the pimp would no doubt shrink back or strike you. But the holy figure does it with such grace and humility that the pimp simply stares. The holy one smiles warmly.%SPEECH_ON%This is not the path for you, that much is clear. You have not the means to handle this woman, and this is but one woman, when a pimp really needs many. The old gods tell me you are meant for a different path, one which is for hardier men. I daresay you are fit for a mercenary company. Leave the women-wrangling to the snake handlers.%SPEECH_OFF%The pimp thinks for a time, but you can tell the words have gotten to him. He asks if you'd accept him into your company."
        es = "[img]gfx/ui/events/event_92.png[/img]%monk%, que ha consagrado su vida a los dioses, da un paso al frente y toma al proxeneta de las manos. Si tú hicieras eso, sin duda el proxeneta retrocedería o te golpearía. Pero esa figura santa lo hace con tanta gracia y humildad que el proxeneta se limita a quedarse mirando. La santa figura sonríe con calidez.%SPEECH_ON%Este no es el camino para ti, eso está claro. No tienes los medios para manejar a esta mujer, y es solo una mujer, cuando un proxeneta de verdad necesita muchas. Los viejos dioses me dicen que estás destinado a otro camino, uno para hombres más curtidos. Me atrevo a decir que eres apto para una compañía de mercenarios. Deja lo de arrear mujeres a los encantadores de serpientes.%SPEECH_OFF%El proxeneta lo piensa un rato, pero notas que las palabras le han calado. Pregunta si lo aceptarías en tu compañía."
    }
    // en = "Led a man back onto the path of rightenousness"
    // en base_es
    // en = "the Pimp"
    // en base_es
    // en = "While visiting <town:str>, you found %name% quarreling with his only harlot. <monk:str> persuaded him to join the company and you agreed to take him along. Hopefully, he's better fighting in the shield wall than he is wrangling whores."
    // en base_es
    // FILE: mod_legends\hooks\events\events\player_plays_dice_event.nut
    // context: player_plays_dice_event.o.create.s.Text
    {
        // corrige base: el "cup" de los dados es un cubilete, no una taza
        en = "[img]gfx/ui/events/event_62.png[/img]While relaxing after the day's walk, %gambler% comes up to you with a pair of dice and a cup in hand and asks if you wish to have a little game. The rules are quite simple: you roll the dice from the cup, whoever has the highest numbers wins. It's pure chance! The wager will be a hundred crowns per dice roll."
        es = "[img]gfx/ui/events/event_62.png[/img]Mientras descansas tras la caminata del día, %gambler% se te acerca con un par de dados y un cubilete en la mano y te pregunta si quieres echar una partidita. Las reglas son bastante simples: tiras los dados desde el cubilete y gana quien saque los números más altos. ¡Es pura suerte! La apuesta será de cien coronas por tirada."
    }
    // context: player_plays_dice_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_62.png[/img]You roll the dice, landing a total of %playerdice%.\n\n%gambler% goes next, rolling a total of %gamblerdice%.\n\n{Well, you lost. The gambler snatches the dice back up - as well as your hundred crowns - and aks if you wish to have another go. | The dice were not in your favor and the gambler takes the earnings and looks up to you, grinning.%SPEECH_ON%Wish to have another go?%SPEECH_OFF% | The numbers are counted up and, alas, you have lost. The gambler asks if you wish to go again. | Lost! But maybe if you roll again... | You lose! A simple roll of the dice, and simple loss. But this one hurts a lot less than which you've seen on the fields of battle. The gambler asks if you wish to have another go. | The gods have shunned you and your silly dice. Losing the game is a minor setback, but your pride costs a little more than a hundred crowns. Should you roll again? | The odds have betrayed you for a measly hundred crowns. Maybe if you roll again you can win them back? | You watch your dice tumble, seeing for but a moment the winning numbers before it tilts and falls to another side, revealing a losing total. The gambler laughs and asks if you wish to throw again. | Your throw was perfect! How could you lose? The gambler needed just those numbers to win! Shaking your head, you wonder if you should roll again.}"
        es = "[img]gfx/ui/events/event_62.png[/img]Tiras los dados y sacas un total de %playerdice%.\n\n%gambler% tira a continuación y saca un total de %gamblerdice%.\n\n{Bueno, has perdido. Tu rival recoge los dados, junto con tus cien coronas, y te pregunta si quieres intentarlo otra vez. | Los dados no te han sido favorables y tu rival se lleva las ganancias y levanta la vista hacia ti, sonriendo.%SPEECH_ON%¿Otra ronda?%SPEECH_OFF% | Se cuentan los números y, ay, has perdido. Tu rival te pregunta si quieres volver a jugar. | ¡Perdiste! Pero quizá si vuelves a tirar... | ¡Pierdes! Una simple tirada de dados, una simple derrota. Pero esta duele mucho menos que las que has visto en los campos de batalla. Tu rival te pregunta si quieres intentarlo otra vez. | Los dioses te han dado la espalda a ti y a tus tontos dados. Perder la partida es un contratiempo menor, pero tu orgullo cuesta algo más de cien coronas. ¿Deberías volver a tirar? | Las probabilidades te han traicionado por unas míseras cien coronas. ¿Quizá si vuelves a tirar puedas recuperarlas? | Ves rodar tus dados y, por un instante, distingues los números ganadores antes de que uno se incline y caiga sobre otra cara, mostrando un total perdedor. Tu rival se ríe y te pregunta si quieres tirar otra vez. | ¡Tu tirada era perfecta! ¿Cómo has podido perder? ¡A tu rival le bastaban justo esos números para ganar! Negando con la cabeza, te preguntas si deberías volver a tirar.}"
    }
    // en = "You lose <v:val_tag> Crowns"
    // en base_es
    // context: player_plays_dice_event.o.create.s.Text
    {
        // corrige base: la última variante ("Tickle m'anus with a rosebush and call me Sally Siegfried") se sustituyó por otra sin crudeza ("Por los viejos, nuevos y actuales dioses")
        // corrige base: "As damned as a nun on her back" es una monja tumbada boca arriba, no "en su espalda" (calco)
        // corrige base: "carajo" no está en el inglés y es léxico regional
        // corrige base: "¿Pensé que todo era cuestión de suerte?" es agramatical; es "¿No decías que todo era suerte?"
        en = "[img]gfx/ui/events/event_62.png[/img]You roll the dice, landing a total of %playerdice%.\n\n%gambler% goes next, rolling a total of %gamblerdice%.\n\n{You won! The gambler claps hands.%SPEECH_ON%Beginner's luck!%SPEECH_OFF%You cross your arms.%SPEECH_ON%I thought it was all luck?%SPEECH_OFF%The gambler laughs and asks if you wish to test that theory. | The gambler leans back.%SPEECH_ON%Well I'll be damned. Let's throw again!%SPEECH_OFF% | The gambler leans back.%SPEECH_ON%{Well I'll be a horse's fartin' arse | I'll be damned if the gods haven't turned their backs on me | Now that right there is a poor showin' of lady luck | I'd bedded a lady by the name of Luck, what good it's done me though | That right there is a misfortune, for me that is | Oy, that's a winning roll | I'll be a ragamuffin | Son of a gelded horse | Shits on a wet a pig | As damned as a nun on her back | The throw of a master I say | Yer a robber with such a throw and yeah | May %randomtown% join the orcs | And they say a blind squirrel can't find a nut | Tickle m'anus with a rosebush and call me Sally Siegfried}, ya won! Let's roll again!%SPEECH_OFF% | You've won! Laughing, you take your earnings and the gambler asks if you wish to have another throw.}"
        es = "[img]gfx/ui/events/event_62.png[/img]Tiras los dados y sacas un total de %playerdice%.\n\n%gambler% tira a continuación y saca un total de %gamblerdice%.\n\n{¡Has ganado! Tu rival aplaude.%SPEECH_ON%¡Suerte de principiante!%SPEECH_OFF%Te cruzas de brazos.%SPEECH_ON%¿No decías que todo era suerte?%SPEECH_OFF%Tu rival se ríe y te pregunta si quieres poner a prueba esa teoría. | Tu rival se echa hacia atrás.%SPEECH_ON%Vaya, que me aspen. ¡Tiremos otra vez!%SPEECH_OFF% | Tu rival se echa hacia atrás.%SPEECH_ON%¡{Que me convierta en el culo pedorro de un caballo | Que me lleve el diablo si los dioses no me han dado la espalda | Eso de ahí es una pobre actuación de la dama Fortuna | Me acosté con una dama llamada Suerte, y para lo que me ha servido | Eso de ahí es una desgracia, para mí, claro | Oye, esa es una tirada ganadora | Que me quede en harapos | Hijo de un caballo capado | Mierda en un cerdo mojado | Esto está más condenado que una monja boca arriba | Tirada de maestro, digo yo | Con esa tirada eres un ladrón, sí señor | Que %randomtown% se una a los orcos | Y dicen que una ardilla ciega no encuentra nueces | Que me hagan cosquillas en el ojete con un rosal y me llamen Sally Siegfried}, has ganado! ¡Tiremos otra vez!%SPEECH_OFF% | ¡Has ganado! Entre risas, recoges tus ganancias y tu rival te pregunta si quieres tirar otra vez.}"
    }
    // en = "You win <v:val_tag> Crowns"
    // en base_es
    // FILE: mod_legends\hooks\events\events\poacher_vs_thief_event.nut
    // context: poacher_vs_thief_event.o.create.s.Text
    {
        // corrige base: "interrumpiros" usa vosotros; el corpus usa ustedes
        // corrige base: "waves him off" es quitarle importancia con un gesto, no "lo palmea con la mano"
        en = "[img]gfx/ui/events/event_26.png[/img]You walk out of your tent to see %poacher% and %thief% regaling one another with stories. You're not sure what a poacher and a thief would have in common, but they seem to be having a good time. Laughing, %poacher% gives another story.%SPEECH_ON%One time, I was out in this pithy nobleman's lands hunting this buck. Shooting the damned deer was the easy part. In the middle of field dressing it, I hear hooves beating over the earth. So run a rope up a tree, tie the carcass to it, and haul that sucker up there. No more than a minute later, badda-badda-badda, there's the nobleman with the constable and a retinue of lawmen.%SPEECH_OFF%%thief% raises an eyebrow.%SPEECH_ON%That's a tight spot, sir.%SPEECH_OFF%The poacher nods.%SPEECH_ON%Tighter than a cross-legged virgin it was. So this nobleman comes wandering just underneath me and sees all the blood. He starts barking that I come out and turn myself in. I had no intention of doing that, but unfortunately, the goddam buck starts slipping. I reach out for it and I suppose the branch couldn't take no more and snapped. The nobleman looks up just in time to get splattered by the belly of this deer, meanwhile I'm falling to certain death until the damned rope snags my foot and hangs me upside down before my makers. I give a bit of a wave, 'hey fellas, don't mean to barge in like this.'%SPEECH_OFF%The thief laughs, but with a concerned face. %poacher% waves it off.%SPEECH_ON%Oh, they had a sense of humor about it, thank the old gods. I spent a short six months in a dark pit. Nothing too bad, really.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_26.png[/img]Sales de tu tienda y ves a %poacher% y %thief% deleitándose mutuamente con historias. No sabes muy bien qué tendrán en común la caza furtiva y el robo, pero parecen estar pasándolo bien. Entre risas, %poacher% cuenta otra historia.%SPEECH_ON%Una vez estaba en las tierras de un noble de poca monta, cazando un venado. Abatir al maldito ciervo fue lo fácil. En plena faena de destriparlo, oigo cascos golpeando la tierra. Así que paso una cuerda por un árbol, ato el cadáver y subo al bicho allá arriba. No pasa ni un minuto y, badda-badda-badda, ahí está el noble con el alguacil y un séquito de hombres de la ley.%SPEECH_OFF%%thief% levanta una ceja.%SPEECH_ON%Eso es un buen aprieto, señor.%SPEECH_OFF%La respuesta llega con un asentimiento.%SPEECH_ON%Más apretado que una virgen con las piernas cruzadas, ya lo creo. Así que el noble viene paseando justo debajo de mí y ve toda la sangre. Empieza a ladrar que salga y me entregue. No tenía intención de hacerlo, pero, por desgracia, el puto venado empieza a resbalar. Alargo la mano para agarrarlo y supongo que la rama no aguantó más y se partió. El noble levanta la vista justo a tiempo para que le salpiquen las tripas del ciervo, mientras yo caigo hacia una muerte segura hasta que la maldita cuerda se me engancha en el pie y me deja colgando boca abajo ante mis perseguidores. Saludo un poco con la mano: 'Hola, muchachos, no pretendía irrumpir así'.%SPEECH_OFF%Al otro lado del fuego hay una risa, pero también un gesto de preocupación. %poacher% le quita importancia con la mano.%SPEECH_ON%Oh, se lo tomaron con humor, gracias a los viejos dioses. Pasé unos cortos seis meses en un pozo oscuro. Nada muy grave, la verdad.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\refugee_vs_raider_event.nut
    // context: refugee_vs_raider_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_06.png[/img]%refugee%, a mercenary who once forced onto the roads as a refugee, stares blankly at %raider%. The raider, sensing being stared at, lowers their plate of food.%SPEECH_ON%Whatcha farkin' looking at, huh?%SPEECH_OFF%The refugee points a dripping spoon.%SPEECH_ON%Yer a raider, right?%SPEECH_OFF%%raider% nods.%SPEECH_ON%Was. Might be again someday. What's it to you?%SPEECH_OFF%Standing up, %refugee% points.%SPEECH_ON%It were brutes like you who forced good people out of their homes. Good people to drag their whole lives onto the damned road.%SPEECH_OFF%Laughing, %raider% stands suddenly.%SPEECH_ON%Oh, is that right? And what made them so good? That they couldn't swing a sword or protect themselves? Do you believe for one moment that were the boot on the other foot they wouldn't do the same to me? Or to you, too? Folk are only as good as their options.%SPEECH_OFF%The spate's getting wild and some of the other mercenaries get to their feet. Nobody can stop the initial scuffle, the two sellswords exchanging blows and curses as good as any tavern brawl you've seen. Thankfully, nothing too serious comes of the fight."
        es = "[img]gfx/ui/events/event_06.png[/img]%refugee%, que en su día se vio en los caminos huyendo de su hogar, clava una mirada vacía en %raider%, que, al notarla, baja el plato de comida.%SPEECH_ON%¿Qué mierda estás mirando, eh?%SPEECH_OFF%Desde enfrente le apuntan con una cuchara que gotea.%SPEECH_ON%Tú te dedicabas a saquear, ¿no?%SPEECH_OFF%%raider% asiente.%SPEECH_ON%Me dedicaba. Puede que vuelva a hacerlo algún día. ¿A ti qué te importa?%SPEECH_OFF%%refugee% se pone en pie y señala.%SPEECH_ON%Fue gentuza como tú la que echó a gente buena de sus casas. Gente buena que tuvo que arrastrar su vida entera por el maldito camino.%SPEECH_OFF%Riendo, %raider% se levanta de golpe.%SPEECH_ON%Ah, ¿sí? ¿Y qué los hacía tan buenos? ¿Que no supieran blandir una espada ni defenderse? ¿De verdad crees que, si las tornas cambiaran, no me harían lo mismo a mí? ¿O a ti también? La gente es tan buena como sus opciones.%SPEECH_OFF%La riña se descontrola y algunos de los otros mercenarios se ponen en pie. Nadie puede impedir el primer forcejeo: ambas partes intercambian golpes y maldiciones como en la mejor pelea de taberna que hayas visto. Por suerte, la pelea no pasa a mayores."
    }
    // FILE: mod_legends\hooks\events\events\religious_peasants_event.nut
    // context: religious_peasants_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_59.png[/img]The forests have always been a refuge for people - the wilds from whence we came, to the wilds where we always wish to return. And here you find a great number of people, a tribe of the lost, unconcerned with their departed civilizations, draped in religious habits, and carrying great sigils of faith, and tomes of truth. They're impoverished almost to the point of being decadently fashionable, like great kings looking to fit in with commoners. You sit and watch this shuffle by, clinking, clanging, hollow wooden beads rattling, whispers under their breath, raspy and dry. And so they go on, hardly even bothering to look at you."
        es = "[img]gfx/ui/events/event_59.png[/img]Los bosques siempre han sido un refugio para la gente: de la espesura venimos y a la espesura siempre deseamos volver. Y aquí encuentras a una gran multitud, una tribu de perdidos, indiferente a las civilizaciones que dejó atrás, envuelta en hábitos religiosos y cargando grandes emblemas de fe y tomos de verdad. Su pobreza es tal que casi resulta de una elegancia decadente, como grandes reyes que intentaran mezclarse con la plebe. Te sientas y los ves pasar arrastrando los pies, entre tintineos y repiqueteos, con el traqueteo de cuentas huecas de madera y susurros entre dientes, ásperos y secos. Y así siguen su camino, sin molestarse apenas en mirarte."
    }
    // context: religious_peasants_event.o.create.s.Text
    {
        // corrige base: errata "domino" por "dominó"; además el inglés no menciona el dominó ni que el chal le envuelva la cabeza
        en = "[img]gfx/ui/events/event_03.png[/img]Curious, you call out to the procession to ask where they are going. The man in front slowly turns to you, his eyes peering out from the dark of a wrapped shawl. He slowly draws the cloak back, revealing a head scarred in a pattern of religious rites. All the followers behind him slowly follow suit, like a row of cards falling by the brush of a chaotic and mad wind.%SPEECH_ON%Davkul shall see you in the next world!%SPEECH_OFF%One of them shouts and they charge."
        es = "[img]gfx/ui/events/event_03.png[/img]Con curiosidad, llamas a la procesión para preguntar adónde se dirigen. El hombre que va delante se vuelve despacio hacia ti, con los ojos asomando desde la oscuridad de un chal que lo envuelve. Poco a poco se retira el manto y deja ver una cabeza marcada con cicatrices según un patrón de ritos religiosos. Todos los seguidores que van tras él lo imitan lentamente, como una hilera de naipes que caen al roce de un viento caótico y enloquecido.%SPEECH_ON%¡Davkul te verá en el otro mundo!%SPEECH_OFF%Grita uno de ellos, y se lanzan a la carga."
    }
    // context: religious_peasants_event.o.create.s.Text
    {
        // corrige base: "parece haber roto aparentemente" es redundante
        // corrige base: "insane" es "dementes"; "insanos" es falso amigo (insalubres)
        // corrige base: "bolts upright" es erguirse de golpe, no "ponerse de pie" (ya estaban de pie, caminando)
        en = "[img]gfx/ui/events/event_12.png[/img]{Obviously, this isn't an ordinary sight for you so, curious, you call out to the weary travelers. Words barely leave your lips before the entire line of men stops in an instant and bolts upright. Their cloaks unravel and droop from their heads, and their tomes and sticks and religious imports fall aside in a uniform clatter. The people look around, wide eyes more alive than ever. One screams. Then another. And soon they are all screaming, and some crumple to the ground, clutching their ears as though to silence the horrid howls their mouths had to give, while others wheel in circles, arms out, begging for answers.\n\n Your mere utterance has seemingly broken a spell that was so long over their heads it had brought them here, impoverished, hungry, and insane. Step by step, they were governed by a malicious higher power, and step by step they felt the control in their lives slip away, and with it the sanity all men require to be themselves. Unfortunately, you can hardly ask them what or who did this to them, for some fall over dead while others make naked sprints into the forest. | A curious sight such as this begs questioning, but the second a word leaves your lips the entire troop of religious men bolt upright, the sudden shuffle of clothes and gear clattering in such uniformity it as if a door was slammed shut. The men drop their things and begin screaming. It is a raspy chorus. They all begin to collapse, either buckling on bony knees or clutching their stomachs in pained hunger.\n\n %randombrother% comes up, shaking his head.%SPEECH_ON%Were they cursed? What could have done this?%SPEECH_OFF%You won't ever get an answer for a minute later every single one is dead, looking no better than corpses having recently been thawed out of the mountains. The spell must have forcibly piloted their pilgrimage here, straining the human body while keeping it alive by the mere strand of ethereal malevolence. Although they are all dead, you do not regret freeing them of such a horrid curse.}"
        es = "[img]gfx/ui/events/event_12.png[/img]{Obviamente, no es algo que veas todos los días, así que, por curiosidad, llamas a los cansados viajeros. Apenas te salen las palabras de los labios cuando toda la fila de hombres se detiene en el acto y se yergue de golpe. Las capas se les deshacen y les caen de la cabeza, y sus tomos, bastones y enseres religiosos caen a un lado con un estrépito al unísono. La gente mira a su alrededor, con los ojos muy abiertos y más vivos que nunca. Uno grita. Luego otro. Y pronto gritan todos, y algunos se desploman en el suelo tapándose los oídos como para acallar los horribles aullidos que les salían de la boca, mientras otros giran en círculos, con los brazos extendidos, suplicando respuestas.\n\n Tus simples palabras parecen haber roto un hechizo que pesaba sobre ellos desde hacía tanto que los había traído hasta aquí, empobrecidos, hambrientos y dementes. Paso a paso, los gobernaba un poder superior malicioso, y paso a paso sintieron cómo se les escapaba el control de sus vidas, y con él la cordura que todos los hombres necesitan para ser ellos mismos. Por desgracia, apenas puedes preguntarles qué o quién les hizo esto, pues algunos caen muertos mientras otros echan a correr desnudos hacia el bosque. | Algo tan curioso como esto pide a gritos preguntar, pero en cuanto te sale una palabra de los labios, toda la tropa de religiosos se yergue de golpe, y el súbito roce de ropas y equipo resuena con tal uniformidad que parece un portazo. Los hombres sueltan sus cosas y empiezan a gritar. Es un coro ronco. Todos empiezan a desplomarse, ya sea doblándose sobre rodillas huesudas o agarrándose el estómago, presas de un hambre dolorosa.\n\n %randombrother% se acerca negando con la cabeza.%SPEECH_ON%¿Estaban malditos? ¿Qué pudo haberles hecho esto?%SPEECH_OFF%Nunca obtendrás respuesta, porque un minuto después todos y cada uno están muertos, con un aspecto no mejor que el de cadáveres recién descongelados de las montañas. El hechizo debió de conducirlos a la fuerza en su peregrinación hasta aquí, forzando el cuerpo humano mientras lo mantenía con vida por un mero hilo de malevolencia etérea. Aunque todos están muertos, no te arrepientes de haberlos liberado de una maldición tan horrenda.}"
    }
    // context: religious_peasants_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_59.png[/img]Curious as to where these people are going, you open your mouth, but %monk% the holy one steps forward, cutting you off and going to the man in front of the troop and has quiet counsel with him. There is plenty of nodding, hrrumphing, and other gesticulations of those who dwell long on things well beyond the human realm. Eventually, the monk comes back.%SPEECH_ON%They're on a pilgrimage and now our name travels with them. Many shall hear of it.%SPEECH_OFF%You thank the monk for a job well done."
        es = "[img]gfx/ui/events/event_59.png[/img]Con curiosidad por saber adónde va esta gente, abres la boca, pero %monk%, siempre del lado de los dioses, da un paso al frente, te interrumpe y se acerca al hombre que encabeza la tropa para hablar con él en voz baja. Hay muchos asentimientos, carraspeos y otros gestos propios de quienes se detienen largo tiempo en cosas que están muy por encima del reino humano. Al final, vuelve contigo.%SPEECH_ON%Están de peregrinación y ahora nuestro nombre viaja con ellos. Muchos oirán hablar de él.%SPEECH_OFF%Le das las gracias por un trabajo bien hecho."
    }
    // FILE: mod_legends\hooks\events\events\rookie_gets_hurt_event.nut
    // context: rookie_gets_hurt_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_22.png[/img]After the battle is over, you find %noncombat% on their knees, body swaying back and forth, nursing a wound. You hear muffled cries in between all-too-loud moans. Approaching, you ask the if everything is alright. %noncombat%'s head shakes and explains that this was the first taste of real, vicious combat. %SPEECH_ON%It was not what I expected and I am not sure if I can continue.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_22.png[/img]Después de la batalla, encuentras a %noncombat% de rodillas, con el cuerpo balanceándose adelante y atrás mientras se cuida una herida. Oyes sollozos ahogados entre gemidos demasiado fuertes. Te acercas y preguntas si va todo bien. %noncombat% niega con la cabeza y explica que ha sido su primer contacto con un combate de verdad, despiadado. %SPEECH_ON%No era lo que esperaba y no sé si podré seguir.%SPEECH_OFF%"
    }
    // context: rookie_gets_hurt_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_22.png[/img]You tell the mercenary to harden up. When %noncombat% pauses, stifling a cry, you repeat it again. This time, %noncombat% brings a leg out and plants a foot, steadying. With true grit, the mercenary manages to get standing again. Shirt is bloodslaked, face covered in mud and crimson and other viscera battle makes of the living. But %noncombat%'s eyes show a sign of resolve they did not before, the sellsword nods at you before walking back to join the rest of the men."
        es = "[img]gfx/ui/events/event_22.png[/img]Le dices que se endurezca. Cuando %noncombat% se detiene, ahogando un sollozo, se lo repites. Esta vez, %noncombat% adelanta una pierna y planta el pie para afianzarse. Con verdadero coraje, logra ponerse de nuevo en pie. Tiene la camisa empapada de sangre y la cara cubierta de barro, de carmesí y de las demás vísceras que la batalla saca de los vivos. Pero los ojos de %noncombat% muestran un atisbo de resolución que antes no tenían; te hace un gesto con la cabeza antes de volver a reunirse con el resto de los hombres."
    }
    // context: rookie_gets_hurt_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_22.png[/img]Unfortunately, telling the mercenary to 'suck it up' gets nowhere. %noncombat% turns to you, face covered in the blood and gore of battle, but before any words can come out, their lip quivers and they keel over again. You ask if %noncombat% wishes to be cut from the company, but the response comes back with a shaken head and a forceful no. I'll get better, he explains. You nod and walk off, but there's little doubt that this poor show of resolve has hurt the mercenary's pride."
        es = "[img]gfx/ui/events/event_22.png[/img]Por desgracia, decirle que 'se aguante' no lleva a ninguna parte. %noncombat% se vuelve hacia ti, con la cara cubierta de la sangre y las vísceras de la batalla, pero antes de que pueda decir nada, le tiembla el labio y vuelve a desplomarse. Preguntas si %noncombat% quiere dejar la compañía, pero la respuesta llega con un movimiento de cabeza y un no rotundo. Ya mejoraré, explica. Asientes y te marchas, pero no cabe duda de que esta pobre muestra de resolución le ha herido el orgullo."
    }
    // context: rookie_gets_hurt_event.o.create.s.Options[0].Text
    {
        en = "We will be steeled by combat, or we will be killed by it."
        es = "El combate nos templará o nos matará."
    }
    // context: rookie_gets_hurt_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_22.png[/img]The mercenary looks around, at the bodies, at the land, at the sky. %noncombat% nods and gets to their feet. Before heading back to camp, thanking you for your words.%SPEECH_ON%Thankee, captain. I'll do a better job of hiding my fears.%SPEECH_OFF%You nod back with a terse smile before putting your fist to your chest.%SPEECH_ON%Bottle it all up right here and don't let anybody else see it. Half of any battle is convincing your opponent that you're crazier than they are. Being fearless is impossible, but faking it for a time is not.%SPEECH_OFF%The sellsword nods again and heads back to camp with head held a little bit higher."
        es = "[img]gfx/ui/events/event_22.png[/img]Mira a su alrededor: los cuerpos, la tierra, el cielo. %noncombat% asiente y se pone en pie. Antes de volver al campamento, te agradece tus palabras.%SPEECH_ON%Se agradece, capitán. Sabré esconder mejor mis miedos.%SPEECH_OFF%Le devuelves el gesto con una sonrisa seca y te llevas el puño al pecho.%SPEECH_ON%Guárdatelo todo aquí dentro y no dejes que nadie más lo vea. La mitad de cualquier batalla consiste en convencer a tu rival de que te faltan más tornillos que a él. No tener miedo es imposible, pero fingirlo un rato no lo es.%SPEECH_OFF%Asiente de nuevo y vuelve al campamento con la cabeza un poco más alta."
    }
    // context: rookie_gets_hurt_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_22.png[/img]The mercenary turns to you, tears cutting through the crusts of bloody cheeks. %noncombat%'s head is shaking and asking %SPEECH_ON%How is it that I'm the only one out here crying?%SPEECH_OFF% You shrug and ask if the mercenary wishes to leave the company. %noncombat%'s head shakes again.%SPEECH_ON%I'll get better. I just.. I just need some time to do it, that's all.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_22.png[/img]Se vuelve hacia ti, con las lágrimas abriéndose paso entre las costras de sangre de las mejillas. %noncombat% niega con la cabeza y pregunta: %SPEECH_ON%¿Cómo es que nadie más que yo llora aquí?%SPEECH_OFF% Te encoges de hombros y preguntas si quiere dejar la compañía. %noncombat% vuelve a negar con la cabeza.%SPEECH_ON%Ya mejoraré. Es solo que... solo necesito algo de tiempo, nada más.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\running_around_event.nut
    // context: running_around_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "%terrainImage%{Walking, running, fighting, fucking, all good for a man's heart. The time spent traveling the land has improved the vitality and vigor of the mercenaries. You even caught one of the cheekier mercenaries flexing into pondwater, admiring %their_dude% own reflection like some a vain noble. | All this running about the land has increased the stamina of the mercenaries. One runs in place, holding a finger to %their_dude% neck. %They_dude% remarks that %their_dude% heart rate isn't going up at all. Another brother remarks that the sellsword doesn't even know how to count. The running %person_dude% pauses.%SPEECH_ON%Oh. That's right.%SPEECH_OFF%}"
        es = "%terrainImage%{Caminar, correr, pelear, joder: todo es bueno para el corazón de un hombre. El tiempo pasado recorriendo estas tierras ha mejorado la vitalidad y el vigor de los mercenarios. Hasta sorprendiste a %un_dude% mercenari%o_dude% de lo más descarad%o_dude% sacando músculo ante el agua de una charca, admirando su propio reflejo como un noble vanidoso. | Tanto correr por estas tierras ha aumentado el aguante de los mercenarios. %Un_dude% mercenari%o_dude% corre sin moverse del sitio, con un dedo en el cuello, y comenta que el pulso no le sube nada. Otro hermano señala que %ese_dude% mercenari%o_dude% ni siquiera sabe contar. %Art_dude% que corre se detiene.%SPEECH_ON%Oh. Es verdad.%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\events\events\sacrificed_man_event.nut
    // en = "the Sacrifice"
    // en base_es
    // en = "You found this man as a sacrifice, but he arose from his fate to be a servant of Davkul. He asked to fight for you, and you, for some reason, actually agreed."
    // en base_es
    // FILE: mod_legends\hooks\events\events\scenario\lone_wolf_intro_event.nut
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_62.png[/img]{It occurs to you that before you embark on this journey of self discovery, you should probably arm yourself a little better - a lance is pointless without a horse. Your armour is old and you can trade it in for a fair price in exchange for a new set\n\n Visiting the local weaponsmith you spot an array of killing instruments, each carefully dressed and arranged like a breadmaker's stall. You only have enough crowns for one set, so you better choose wisely.}"
        es = "[img]gfx/ui/events/event_62.png[/img]{Se te ocurre que, antes de embarcarte en este viaje de autodescubrimiento, deberías armarte un poco mejor: una lanza no sirve de nada sin caballo. Tu armadura es vieja y puedes entregarla por un precio justo a cambio de un equipo nuevo.\n\n Al visitar al armero del lugar, ves un surtido de instrumentos de matar, cada uno cuidadosamente presentado y dispuesto como el puesto de un panadero. Solo te alcanzan las coronas para un equipo, así que más te vale elegir bien.}"
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Options.Text
    {
        en = "A longsword and medium armour has never failed me."
        es = "Una espada larga y una armadura media nunca me han fallado."
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Options.Text
    {
        en = "A strong hammer, a sturdy shield and medium armour can weather anything."
        es = "Un martillo fuerte, un escudo robusto y una armadura media aguantan lo que sea."
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Options.Text
    {
        en = "An axe and buckler with light armour is the best choice."
        es = "Un hacha y una rodela con armadura ligera son la mejor opción."
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Options.Text
    {
        en = "I always was a good shot - I'll take the crossbow, a sword and light armour."
        es = "Siempre tuve buena puntería: me quedo con la ballesta, una espada y armadura ligera."
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Options.Text
    {
        en = "I'm a little rusty, but a bow and dagger with some nice cloth armour is the proper choice."
        es = "Me falta práctica, pero un arco y una daga con una buena armadura de tela es lo adecuado."
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Options.Text
    {
        en = "I'll stick to what I know - a pike is almost a jousting lance, right?"
        es = "Me quedo con lo que conozco: una pica es casi una lanza de justa, ¿no?"
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_01.png[/img]{You pick up the longsword from the weapon rack - while not expertly made it has good balance and reach to win almost any fight.}"
        es = "[img]gfx/ui/events/event_01.png[/img]{Tomas la espada larga del estante de armas: aunque no es obra de un maestro, tiene buen equilibrio y alcance para ganar casi cualquier pelea.}"
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Options.Text
    {
        en = "{Well balanced and fast. | Versatile and strong.}"
        es = "{Equilibrada y rápida. | Versátil y fuerte.}"
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_01.png[/img]{You take a heater shield and a sturdy pick from the table, the weight of the pick feels good in your hand and balances out the weight of the shield nicely.}"
        es = "[img]gfx/ui/events/event_01.png[/img]{Tomas de la mesa un escudo triangular y un pico robusto; el peso del pico se siente bien en la mano y compensa a la perfección el del escudo.}"
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Options.Text
    {
        en = "{No knight will stand before me! | Nothing is getting past this shield...}"
        es = "{¡Ningún caballero me hará frente! | Nada va a pasar de este escudo...}"
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_01.png[/img]{Always wanting to break convention - you take a heavy fighting axe and what remains of your crowns is spent on a light buckler.}"
        es = "[img]gfx/ui/events/event_01.png[/img]{Siempre con ganas de romper las convenciones, tomas un hacha de combate pesada y gastas lo que te queda de coronas en una rodela ligera.}"
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Options.Text
    {
        en = "{Heavy hitting and light on my feet.}"
        es = "{Golpes pesados y pies ligeros.}"
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_01.png[/img]{You grab the crossbow and arming sword from the rack. You look down the sights and wonder how hard it could be to get back into firing one again since your younger days hunting rabbits.}"
        es = "[img]gfx/ui/events/event_01.png[/img]{Tomas del estante la ballesta y la espada recta. Apuntas a lo largo del arma y te preguntas cuánto te costará volver a dispararla después de tanto tiempo, desde tus días de juventud cazando conejos.}"
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Options.Text
    {
        en = "{Well, if a peasant can use it... | If all else fails, I still have the sword.}"
        es = "{Bueno, si un campesino sabe usarla... | Si todo lo demás falla, siempre me queda la espada.}"
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_01.png[/img]{You test the string on the hunting bow. Pulling it back reminds you of all the archery tournaments you won in the past and how hard it would be to hit a living, breathing and possible very angry target.\n\nEither way - you still have a nice, sharp dagger if they get close.}"
        es = "[img]gfx/ui/events/event_01.png[/img]{Pruebas la cuerda del arco de caza. Al tensarla recuerdas todos los torneos de tiro con arco que ganaste en el pasado y lo difícil que sería acertar a un blanco vivo, que respira y que posiblemente esté muy furioso.\n\nEn cualquier caso, aún tienes una buena daga bien afilada si se acercan demasiado.}"
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Options.Text
    {
        en = "{I wonder how far the arrow goes... | It's better than a servant's knife I guess...}"
        es = "{Me pregunto hasta dónde llegará la flecha... | Supongo que es mejor que el cuchillo de un criado...}"
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_01.png[/img]{Perhaps it's best to stick to what you are familiar with - a long pike that is much like a jousting lance in function and handling.}"
        es = "[img]gfx/ui/events/event_01.png[/img]{Quizá lo mejor sea quedarte con lo que conoces: una pica larga, muy parecida a una lanza de justa en función y manejo.}"
    }
    // context: lone_wolf_intro_event.o.create.m.Screens.push().Options.Text
    {
        en = "{I'm about to ruin somebody's day with this... | Can't be much harder than using a lance...}"
        es = "{Con esto le voy a arruinar el día a alguien... | No puede ser mucho más difícil que usar una lanza...}"
    }
    // FILE: mod_legends\hooks\events\events\scenario\trader_intro_event.nut
    // context: trader_intro_event.o.create.s.Text
    {
        // corrige base: "Algunos" no está en el inglés ("The corpses", todos los cadáveres)
        // corrige base: "by the hour" es "a cada hora", no "cada día"
        en = "[img]gfx/ui/events/event_95.png[/img]The corpses are abuzz with flies and %ch1% stands amidst the swarm like they built the deathly totem which brought their presence. They turn to you.%SPEECH_ON%Greenskins did this one. No man can hew a head in half like that, and no sane man would stack them in such a manner. And there's goblin poison on them arrow tips.%SPEECH_OFF% %ch2% nods.%SPEECH_ON%Yesterday we find that merchant hanged by brigands, now this. The roads are getting too dangerous for a wagon carrying shine. Now, I ain't saying my swordhand ain't worth its weight in salt, but with just the two of us on duty we're throwing dice by the hour. Sir, you should look into hiring more guards.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_95.png[/img]Los cadáveres zumban llenos de moscas y %ch1% está en medio del enjambre como si hubiera erigido el tótem mortuorio que las atrajo. Se vuelve hacia ti.%SPEECH_ON%Pieles verdes hicieron esto. Ningún hombre puede partir una cabeza por la mitad así, y ningún hombre cuerdo las apilaría de esta manera. Y hay veneno de goblin en las puntas de esas flechas.%SPEECH_OFF% %ch2% asiente.%SPEECH_ON%Ayer encontramos a ese mercader ahorcado por bandidos, y ahora esto. Los caminos se están volviendo demasiado peligrosos para un carro que lleva licor. No digo que mi mano con la espada no valga su peso en sal, pero con solo nosotros dos de guardia nos la estamos jugando a los dados a cada hora. Señor, debería pensar en contratar más guardias.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\sellsword_gets_better_deal_event.nut
    // context: sellsword_gets_better_deal_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_05.png[/img]While counting inventory, %sellsword% joins your side, mindlessly picking at this sword or that shield. You set your quill pen down and ask what\'s up for the hired blade sure as shit isn\'t here to count anything. The sellsword explains that another company wishes to use the mercenary\'s swordhand - and they\'re willing to pay more. You ask how much and the sellsword holds up hands to count.%SPEECH_ON%They\'re talking %newpay% crowns a day.%SPEECH_OFF% %sellsword%\'s earning %pay% crowns a day with you.";
        // corrige base: "sure as shit" rebajado a "está claro"
        mode = "pattern"
        en = "[img]gfx/ui/events/event_05.png[/img]While counting inventory, %sellsword% joins your side, mindlessly picking at this sword or that shield. You set your quill pen down and ask what's up for the hired blade sure as shit isn't here to count anything. The sellsword explains that another company wishes to use the mercenary's swordhand - and they're willing to pay more. You ask how much and the sellsword holds up hands to count.%SPEECH_ON%They're talking %newpay% crowns a day.%SPEECH_OFF% %sellsword%'s earning %pay% crowns a day with you."
        es = "[img]gfx/ui/events/event_05.png[/img]Mientras haces inventario, %sellsword% se pone a tu lado, toqueteando distraídamente esta espada o aquel escudo. Dejas la pluma y preguntas qué pasa, porque, joder, está clarísimo que no ha venido a contar nada. Te explica que otra compañía quiere contratar su brazo con la espada, y está dispuesta a pagar más. Preguntas cuánto y levanta las manos para contar.%SPEECH_ON%Hablan de %newpay% coronas al día.%SPEECH_OFF% %sellsword% gana %pay% coronas al día contigo."
    }
    // en = "I see, time to part ways then."
    // en base_es
    // context: sellsword_gets_better_deal_event.o.create.s.Options[0].getResult.::Legends.addFallen()
    {
        en = "Got a better paying offer"
        es = "Recibió una oferta mejor pagada"
    }
    // context: sellsword_gets_better_deal_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_05.png[/img] You turn around, crossing your arms and jacking a boot against a crate. Staring out across the land, you tell %sellsword% that the company has been through a lot together and everyone, yourself especially, would hate to say farewell. There is a second family here with the %companyname% and that\'s a rare treat in the mercenary world. In other companies there is no guarantee of what may be found. You know, because you\'ve been there. You\'ve been in the sellsword's very shoes, and you took those shoes and walked. And regretted it.\n\nThe sellsword looks at the ground, thinking your words over. Finally the hired blade nods and agrees to stay. You reaffirm that it is definately the right choice. The mercenary turns and taps a quiver of arrows while walking away.%SPEECH_ON%Might want to refill that.%SPEECH_OFF%";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_05.png[/img] You turn around, crossing your arms and jacking a boot against a crate. Staring out across the land, you tell %sellsword% that the company has been through a lot together and everyone, yourself especially, would hate to say farewell. There is a second family here with the %companyname% and that's a rare treat in the mercenary world. In other companies there is no guarantee of what may be found. You know, because you've been there. You've been in the sellsword's very shoes, and you took those shoes and walked. And regretted it.\n\nThe sellsword looks at the ground, thinking your words over. Finally the hired blade nods and agrees to stay. You reaffirm that it is definately the right choice. The mercenary turns and taps a quiver of arrows while walking away.%SPEECH_ON%Might want to refill that.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_05.png[/img] Te das la vuelta, cruzándote de brazos y apoyando una bota contra una caja. Con la mirada perdida en el horizonte, le dices a %sellsword% que la compañía ha pasado por mucho y que a todos, y a ti en especial, les dolería despedirse. Aquí, con %companyname%, hay una segunda familia, y eso es un lujo poco común en el mundo mercenario. En otras compañías no hay garantía de lo que uno pueda encontrarse. Lo sabes porque has estado ahí. Has llevado sus mismos zapatos, y con ellos echaste a andar. Y te arrepentiste.\n\nBaja la mirada al suelo, sopesando tus palabras. Al final asiente y accede a quedarse. Le reafirmas que es, sin duda, la decisión correcta. Al marcharse, se vuelve y da unos golpecitos a un carcaj de flechas.%SPEECH_ON%Igual convendría rellenar eso.%SPEECH_OFF%"
    }
    // context: sellsword_gets_better_deal_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_16.png[/img] You turn around, crossing your arms and jacking a boot against a crate. Staring out across the land, you tell %sellsword% that the company has been through a lot together and everyone, yourself especially, would hate to say farewell. There is a second family here with the  %companyname% and that\'s a rare treat in the mercenary world. In other companies there is no guarantee of what may be found. You know, because you\'ve been there. You\'ve been in the sellsword's very shoes, and you took those shoes and walked. And regretted it.\n\n The sellsword looks at the ground, thinking your words over. Finally the hired blade's head shakes slowly, with pursed lips and a look of \'sorry\'. You argue that it is the wrong choice, but %sellsword%\'s having none of it. The mercenary turns and taps a quiver of arrows while walking away.%SPEECH_ON%Might want to refill that.%SPEECH_OFF%The arrows are a little low, but all you can think about is figuring out how to replace such a good swordhand";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_16.png[/img] You turn around, crossing your arms and jacking a boot against a crate. Staring out across the land, you tell %sellsword% that the company has been through a lot together and everyone, yourself especially, would hate to say farewell. There is a second family here with the  %companyname% and that's a rare treat in the mercenary world. In other companies there is no guarantee of what may be found. You know, because you've been there. You've been in the sellsword's very shoes, and you took those shoes and walked. And regretted it.\n\n The sellsword looks at the ground, thinking your words over. Finally the hired blade's head shakes slowly, with pursed lips and a look of 'sorry'. You argue that it is the wrong choice, but %sellsword%'s having none of it. The mercenary turns and taps a quiver of arrows while walking away.%SPEECH_ON%Might want to refill that.%SPEECH_OFF%The arrows are a little low, but all you can think about is figuring out how to replace such a good swordhand"
        es = "[img]gfx/ui/events/event_16.png[/img] Te das la vuelta, cruzándote de brazos y apoyando una bota contra una caja. Con la mirada perdida en el horizonte, le dices a %sellsword% que la compañía ha pasado por mucho y que a todos, y a ti en especial, les dolería despedirse. Aquí, con %companyname%, hay una segunda familia, y eso es un lujo poco común en el mundo mercenario. En otras compañías no hay garantía de lo que uno pueda encontrarse. Lo sabes porque has estado ahí. Has llevado sus mismos zapatos, y con ellos echaste a andar. Y te arrepentiste.\n\n Baja la mirada al suelo, sopesando tus palabras. Al final niega despacio con la cabeza, con los labios apretados y una mirada de 'lo siento'. Le insistes en que es la decisión equivocada, pero %sellsword% no quiere ni oír hablar de ello. Al marcharse, se vuelve y da unos golpecitos a un carcaj de flechas.%SPEECH_ON%Igual convendría rellenar eso.%SPEECH_OFF%Las flechas andan algo escasas, pero en lo único que puedes pensar es en cómo sustituir a alguien tan bueno con la espada."
    }
    // en = "<bastard:str> leaves the <assets:str>"
    // en base_es
    // context: sellsword_gets_better_deal_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_04.png[/img] You sigh. %sellsword% nods and starts to leave, but you stop the mercenary. You\'ll pay the amount to stay the move. The %companyname% simply cannot afford to lose a blade like that.";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_04.png[/img] You sigh. %sellsword% nods and starts to leave, but you stop the mercenary. You'll pay the amount to stay the move. The %companyname% simply cannot afford to lose a blade like that."
        es = "[img]gfx/ui/events/event_04.png[/img] Suspiras. %sellsword% asiente y empieza a irse, pero le cortas el paso. Pagarás esa cantidad para que no se vaya. %companyname% sencillamente no puede permitirse perder una espada así."
    }
    // context: sellsword_gets_better_deal_event.o.create.s.Options[0].Text
    {
        en = "A good sword doesn't come cheap."
        es = "Una buena espada no sale barata."
    }
    // FILE: mod_legends\hooks\events\events\sellsword_vs_raider_event.nut
    // context: sellsword_vs_raider_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_82.png[/img]The raider, %raider%, is sharpening a weapon beside the campfire, telling stories of days raiding coasts and making off with piles of loot, a crooked smile grinning in the blade\'s sharpened sheen. %sellsword% the sellsword listens for a time then gets up laughing.%SPEECH_ON%Oh, friend, them quite the stories you tell. Here\'s mine: I earned my keep killing folk, whether in their homes or in battle, but folk nonetheless. You run about in yer boats, waitin\' for the menfolk to be gone, then ya scamper across the beaches to kick the little lads, rape the lasses, and steal from old friars. You got nothing to boast of, raider.%SPEECH_OFF%%raider% lowers the blade.%SPEECH_ON%We islanders at least have honor amongst us, whereas you\'d stab the %companyname% in the back for an extra crown in your purse. Speak ill of my past again, sellsword, and I\'ll have that mouth of yours gnawing dirt.%SPEECH_OFF%An exchange of fightin\' words leads to just that: a fight. Blades flash and blood is spilled. The rest of the company jumps in before too much damage can be done.";
        // corrige base: "them quite the stories you tell" es "menudas historias cuentas", no "son bastantes las historias que cuentas"
        mode = "pattern"
        en = "[img]gfx/ui/events/event_82.png[/img]The raider, %raider%, is sharpening a weapon beside the campfire, telling stories of days raiding coasts and making off with piles of loot, a crooked smile grinning in the blade's sharpened sheen. %sellsword% the sellsword listens for a time then gets up laughing.%SPEECH_ON%Oh, friend, them quite the stories you tell. Here's mine: I earned my keep killing folk, whether in their homes or in battle, but folk nonetheless. You run about in yer boats, waitin' for the menfolk to be gone, then ya scamper across the beaches to kick the little lads, rape the lasses, and steal from old friars. You got nothing to boast of, raider.%SPEECH_OFF%%raider% lowers the blade.%SPEECH_ON%We islanders at least have honor amongst us, whereas you'd stab the %companyname% in the back for an extra crown in your purse. Speak ill of my past again, sellsword, and I'll have that mouth of yours gnawing dirt.%SPEECH_OFF%An exchange of fightin' words leads to just that: a fight. Blades flash and blood is spilled. The rest of the company jumps in before too much damage can be done."
        es = "[img]gfx/ui/events/event_82.png[/img]Junto a la fogata, %raider% afila un arma mientras cuenta historias de sus días de saqueo por las costas, cuando se llevaba montones de botín, con una sonrisa torcida reflejada en el brillo de la hoja afilada. %sellsword%, que vende su espada al mejor postor, escucha un rato y luego se levanta riendo.%SPEECH_ON%Vaya, vaya, menudas historias cuentas. Aquí va la mía: me gané el pan matando gente, ya fuera en sus casas o en batalla, pero gente al fin y al cabo. Tú andas por ahí en tus barcas, esperando a que los hombres se vayan, y luego cruzas las playas a la carrera para patear a los chiquillos, violar a las muchachas y robar a los viejos frailes. No tienes nada de qué presumir con tus saqueos.%SPEECH_OFF%%raider% baja la hoja.%SPEECH_ON%Los isleños al menos tenemos honor entre nosotros, mientras que tú apuñalarías por la espalda a %companyname% por una corona más en la bolsa. Vuelve a hablar mal de mi pasado, espada de alquiler, y haré que esa boca tuya muerda el polvo.%SPEECH_OFF%Las palabras de pelea acaban en justo eso: una pelea. Destellan las hojas y se derrama sangre. El resto de la compañía interviene antes de que el daño vaya a más."
    }
    // FILE: mod_legends\hooks\events\events\shady_character_offers_map_event.nut
    // context: shady_character_offers_map_event.o.create.s.Text
    {
        // corrige base: «se rasca la barba» traduce «scratches his chin» (es la barbilla); además quita los signos de exclamación de «can see a deal!» y «a good deal!» y se come uno de los dos «sir».
        en = "[img]gfx/ui/events/event_41.png[/img]%peddler% the peddler steps forward, hands out just like the traveling merchant's had been. Apparently this is a common tactic amongst honest thieves.%SPEECH_ON%Sir, sir, please. Come on. That price is outrageous.%SPEECH_OFF%The merchant's face sours.%SPEECH_ON%There is nothing outrageous about it, I promise you.%SPEECH_OFF%But your peddler persists.%SPEECH_ON%Clearly there is something outrageous, because I just said so, did I not?%SPEECH_OFF%The merchant nods. The peddler continues.%SPEECH_ON%So we've decided to not purchase it at your original asking price. That much is clear. So, friend, I think we will purchase it for %newcost%. That is fair to all parties involved, and surely a fine businessman such as yourself can see a deal! We're hardly businessmen ourselves, but we know that's a good deal!%SPEECH_OFF%The merchant scratches his chin, then nods.%SPEECH_ON%Alright, that price is fair.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_41.png[/img]%peddler%, que conoce bien el oficio de la venta ambulante, da un paso al frente con las manos extendidas, igual que había hecho el comerciante ambulante. Al parecer, esta es una táctica común entre los ladrones honestos.%SPEECH_ON%Señor, señor, por favor. Vamos. Ese precio es exorbitante.%SPEECH_OFF%La cara del comerciante se agria.%SPEECH_ON%No tiene nada de exorbitante, te lo prometo.%SPEECH_OFF%Pero %peddler% insiste.%SPEECH_ON%Claramente hay algo exorbitante, porque lo acabo de decir, ¿o no?%SPEECH_OFF%El comerciante asiente. %peddler% continúa.%SPEECH_ON%Así que hemos decidido no comprarlo al precio que pedías al principio. Eso está claro. Así que, amigo, creo que lo compraremos por %newcost%. Es justo para todas las partes, ¡y seguro que un buen hombre de negocios como tú sabe reconocer un trato! Nosotros no somos precisamente hombres de negocios, ¡pero sabemos que es un buen trato!%SPEECH_OFF%El comerciante se rasca la barbilla y luego asiente.%SPEECH_ON%Está bien, ese precio es justo.%SPEECH_OFF%"
    }
    // context: shady_character_offers_map_event.o.create.s.Text
    {
        // corrige base: «Echas un vistazo y luego otro» pierde que es el ladrón quien te mira primero, y el juego de miradas sale al revés (miras al vendedor y luego al ladrón, no al revés); «Oh, que torpe soy» lleva delante un signo de porcentaje suelto, añade un «Oh» que el inglés no tiene y a «qué» le falta la tilde; «te presenta el mapa» calca «presents you with».
        en = "[img]gfx/ui/events/event_41.png[/img]While you're talking to the merchant, %thief% the thief sidles up next to you, appearing rather interested in the conversation. %thief% glances at you. You do a double take. %thief% grins and nods. You quickly eye the salesman then glance back at the thief and nod. The merchant is in the middle of his sales pitch and sees none of this. He keeps talking, but you hear little of it. You just know to keep nodding for a merchant such as he only tells you things you want to hear anyway.\n\n The thief slips around the back and drops a weapon into the mud.%SPEECH_ON%Clumsy me.%SPEECH_OFF% %thief% bends down, pauses, there's a motion you can hardly detect, and then %thief%'s upright again. %thief% gives you a wink. You tell the merchant you appreciate the offer, but you'll have to pass. When he's gone, %thief% presents you with the map and grins.%SPEECH_ON%They say the best things in life are free.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_41.png[/img]Mientras hablas con el comerciante, %thief%, que vive del robo, se te arrima sigilosamente y muestra bastante interés en la conversación. %thief% te echa una mirada. Vuelves a mirar, sin dar crédito. %thief% sonríe y asiente. Echas un rápido vistazo al vendedor, vuelves la mirada hacia %thief% y asientes. El comerciante está en plena labia de vendedor y no ve nada de esto. Sigue hablando, pero apenas oyes lo que dice. Solo sabes que tienes que seguir asintiendo, porque un comerciante como él solo te dice lo que quieres oír de todos modos.\n\n%thief% se escabulle por detrás y deja caer un arma en el barro.%SPEECH_ON%Qué torpeza la mía.%SPEECH_OFF%%thief% se agacha, se detiene, hay un movimiento que apenas alcanzas a ver, y vuelve a estar de pie. %thief% te guiña un ojo. Le dices al comerciante que agradeces la oferta, pero que tendrás que rechazarla. Cuando se ha ido, %thief% te entrega el mapa con una sonrisa.%SPEECH_ON%Dicen que las mejores cosas de la vida son gratis.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\shooting_contest_event.nut
    // context: shooting_contest_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_10.png[/img] You throw your hands up and tell the company to do what they must before retiring back to your tent. Outside comes the twang of released arrows quickly followed by the thwap of them finding their targets. Again and again. The din of mercenaries grows louder as what you can only assume what is a throng of observers grows. Finally, the contest is at some sort of end - indicated by a refreshing silence - and you get back to work."
        es = "[img]gfx/ui/events/event_10.png[/img] Alzas las manos con resignación y le dices a la compañía que haga lo que tenga que hacer antes de retirarte a tu tienda. Desde fuera llega el chasquido de las flechas al soltarse, seguido enseguida del golpe seco al dar en el blanco. Una y otra vez. El bullicio de los mercenarios crece a medida que aumenta lo que solo puedes suponer que es una multitud de mirones. Por fin, el concurso llega a algún tipo de final (lo anuncia un silencio que se agradece) y vuelves al trabajo."
    }
    // context: shooting_contest_event.o.create.s.Text
    {
        // corrige base: «colocadad» es errata; «La cosas ya era ruidosa, pero pronto se puso 'aún' más» no traduce el «thwang»/«thwap» del inglés; «cada otro disparo» calca «every other shot» (uno de cada dos).
        en = "[img]gfx/ui/events/event_10.png[/img]Feeling as though their arguments will never end, you give them the go-ahead to have their little competition before retiring back to your tent. Soon thereafter you hear the arrows nocking, releasing, and finding targets. Things which go 'thwang' soon go 'thwap' and the air is slowly filled with the din of a watching crowd. As you try to focus, you notice that the mercenaries have been shooting fervently for quite some time now. You step back out of your tent to find the two archers bickering some more, each one pointing a finger at the other before picking up an arrow and angrily launching it downrange. Their targets aren't even targets anymore, but small bushes of arrow shafts upon which break every other shot that lands upon them.\n\nShaking your head, you order the two to stop at once before they use up every last arrow the company has."
        es = "[img]gfx/ui/events/event_10.png[/img]Con la sensación de que sus discusiones no van a terminar nunca, les das luz verde para su pequeña competencia antes de retirarte a tu tienda. Poco después oyes cómo montan las flechas en la cuerda, las sueltan y dan en los blancos. Lo que hace 'zuum' pronto hace 'chac', y el aire se llena poco a poco con el bullicio de una multitud que mira. Mientras intentas concentrarte, te das cuenta de que los mercenarios llevan bastante tiempo disparando con fervor. Sales de nuevo de tu tienda y encuentras a los dos arqueros discutiendo un poco más, cada uno señalando al otro antes de tomar una flecha y lanzarla con rabia hacia el campo de tiro. Sus blancos ya ni siquiera son blancos, sino pequeños arbustos de astiles en los que se rompe uno de cada dos disparos que les acierta.\n\nNegando con la cabeza, ordenas a los dos que paren de inmediato antes de que gasten hasta la última flecha de la compañía."
    }
    // context: shooting_contest_event.o.create.s.Text
    {
        en = "You shake your head no for supplies are far too low to enage in such behavior. The mercenaries sigh and walk away, continuing to argue with one another long and loud into the distance."
        es = "Niegas con la cabeza, porque los suministros están demasiado escasos para permitirse algo así. Los mercenarios suspiran y se alejan sin dejar de discutir entre ellos, largo y a voz en grito, mientras se pierden en la distancia."
    }
    // FILE: mod_legends\hooks\events\events\shortsighted_shoots_bro_event.nut
    // context: shortsighted_shoots_bro_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // _screen.Text = "[img]gfx/ui/events/event_10.png[/img] You take a good, long look at the mercenaries, a gaze that flickers from one to the other and then back again, all the while shaking your head. %shortsightedtarget% is holding %their_otherguy% head, a rather large lump cresting at the hairline. %They_otherguy% looks at %shortsighted% then to you. Both sellswords shrug. You ask %shortsighted% what happened. %They_shortsighted% explains.%SPEECH_ON%Thought I saw somethin\' that wasn\'t there.%SPEECH_OFF%Incredulously, %shortsightedtarget% throws %their_otherguy% hand out.%SPEECH_ON%I said, \'Hey, it\'s me\' and you clocked me anyway.%SPEECH_OFF%Throwing out %their_shortsighted% own hands, %shortsighted% defends %themselves_shortsighted%.%SPEECH_ON%\'Hey it\'s me\' aren\'t words beholden to ya! Anyone can say them words! I reckon anyone ill-willed would say them very words before putting me to the sword, I bet ya!%SPEECH_OFF%It appears that %shortsighted%\'s poor eyesight has led to something of an accident.";
        // corrige base: «no son palabras que te deban nada» malinterpreta «aren't words beholden to ya» (no son palabras que solo puedas decir tú).
        mode = "pattern"
        en = "[img]gfx/ui/events/event_10.png[/img] You take a good, long look at the mercenaries, a gaze that flickers from one to the other and then back again, all the while shaking your head. %shortsightedtarget% is holding %their_otherguy% head, a rather large lump cresting at the hairline. %They_otherguy% looks at %shortsighted% then to you. Both sellswords shrug. You ask %shortsighted% what happened. %They_shortsighted% explains.%SPEECH_ON%Thought I saw somethin' that wasn't there.%SPEECH_OFF%Incredulously, %shortsightedtarget% throws %their_otherguy% hand out.%SPEECH_ON%I said, 'Hey, it's me' and you clocked me anyway.%SPEECH_OFF%Throwing out %their_shortsighted% own hands, %shortsighted% defends %themselves_shortsighted%.%SPEECH_ON%'Hey it's me' aren't words beholden to ya! Anyone can say them words! I reckon anyone ill-willed would say them very words before putting me to the sword, I bet ya!%SPEECH_OFF%It appears that %shortsighted%'s poor eyesight has led to something of an accident."
        es = "[img]gfx/ui/events/event_10.png[/img] Miras largo y tendido a los mercenarios, con una mirada que salta de uno a otro y vuelve otra vez, sin dejar de negar con la cabeza. %shortsightedtarget% se sujeta la cabeza, en la que asoma un chichón bastante grande junto al nacimiento del pelo. Mira a %shortsighted% y luego a ti. Ambos se encogen de hombros. Le preguntas a %shortsighted% qué ha pasado, y te lo explica.%SPEECH_ON%Creí ver algo que no estaba ahí.%SPEECH_OFF%Sin dar crédito, %shortsightedtarget% extiende la mano.%SPEECH_ON%Te dije: 'Oye, soy yo', y aun así me diste un golpe.%SPEECH_OFF%Extendiendo también las manos, %shortsighted% se defiende.%SPEECH_ON%¡'Oye, soy yo' no son palabras que solo puedas decir tú! ¡Cualquiera puede decirlas! Diría que cualquiera con malas intenciones diría esas mismas palabras antes de atravesarme con la espada, ¡te lo apuesto!%SPEECH_OFF%Parece que la mala vista de %shortsighted% ha provocado una especie de accidente."
    }
    // FILE: mod_legends\hooks\events\events\spartan_should_eat_more_event.nut
    // context: spartan_should_eat_more_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_05.png[/img] %spartan% has always been a bit tight with how much %they_spartan% eats. You\'re not sure if it\'s part of some religious rite, a sense of duty, or %they_spartan%\'s just not a big eater. Regardless, the lack of food has weakened the %person_spartan% and you find %them_spartan% barely able to sit upright on a log. You\'ve got a bowl of meat and corn in hand, wondering if maybe you should offer it to %them_spartan%.";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_05.png[/img] %spartan% has always been a bit tight with how much %they_spartan% eats. You're not sure if it's part of some religious rite, a sense of duty, or %they_spartan%'s just not a big eater. Regardless, the lack of food has weakened the %person_spartan% and you find %them_spartan% barely able to sit upright on a log. You've got a bowl of meat and corn in hand, wondering if maybe you should offer it to %them_spartan%."
        es = "[img]gfx/ui/events/event_05.png[/img] %spartan% siempre se ha medido mucho con lo que come. No sabes si es parte de algún rito religioso, de un sentido del deber o si simplemente no es de mucho comer. Sea como sea, la falta de comida %lo_spartan% ha debilitado y %lo_spartan% encuentras apenas capaz de mantenerse sentad%o_spartan% en un tronco. Tienes un tazón de carne y maíz en la mano y te preguntas si no deberías ofrecérselo."
    }
    // context: spartan_should_eat_more_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img] You decide that the %person_spartan% has probably been through this before and decide to leave %them_spartan% be. A few moments later, you catch %them_spartan% walking and talking just fine. In fact, %they_spartan% gets around pretty well for a %person_spartan% who eats so lightly!"
        es = "[img]gfx/ui/events/event_05.png[/img] Llegas a la conclusión de que %ese_spartan% %hombre_spartan% probablemente ya ha pasado por esto antes y decides dejar%lo_spartan% en paz. Unos momentos después, %lo_spartan% ves caminando y hablando sin ningún problema. De hecho, ¡se las arregla bastante bien para ser %un_spartan% %hombre_spartan% que come tan poco!"
    }
    // context: spartan_should_eat_more_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img] The %person_spartan%'s done this before, %they_spartan% can do it again. You turn around to go eat your meal elsewhere, only to hear the %person_spartan% crumple to the ground. %They_spartan%'s completely passed out and appears to have hit %their_spartan% head on the way down."
        es = "[img]gfx/ui/events/event_05.png[/img] %Art_spartan% %hombre_spartan% ya lo ha hecho antes; puede volver a hacerlo. Te das la vuelta para ir a comer a otra parte, solo para oír cómo se desploma en el suelo. Ha perdido el conocimiento por completo y parece que se ha golpeado la cabeza al caer."
    }
    // context: spartan_should_eat_more_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img] You order the %person_spartan% to eat. %They_spartan% resists, but you remind %them_spartan% that it is an 'order', not a request. The sellsword does as told, eating rather gingerly from your bowl. %They_spartan% complains that %they_spartan% does not wish to eat anymore, but you order %them_spartan% to finish the meal. In time, whatever ailed %them_spartan% seems lifted. Energy returns to %their_spartan% eyes and %they_spartan% gets up with a good spring in %their_spartan% step. Unfortunately, %they_spartan% does not care for being told to break %their_spartan% personal codes."
        es = "[img]gfx/ui/events/event_05.png[/img] Le ordenas que coma. Se resiste, pero le recuerdas que es una 'orden', no una petición. %Art_spartan% mercenari%o_spartan% obedece y come de tu tazón con bastante cautela. Se queja de que ya no quiere comer más, pero le ordenas que termine la comida. Con el tiempo, lo que fuera que le aquejaba parece disiparse. La energía vuelve a sus ojos y se levanta con paso enérgico. Por desgracia, no le gusta nada que le ordenen romper sus principios personales."
    }
    // context: spartan_should_eat_more_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img] Ordering the %person_spartan% to eat, the %person_spartan% does as told. At first, %they_spartan% seems rather reluctant, but after a few bites %they_spartan% dives into the bowl, engorging %themselves_spartan% in juices and flecks of corn dot %their_spartan% cheeks. %They_spartan% is almost mad with delight. You've reminded %them_spartan% of just how good food can be. Personally, you thought the meat was a little overcooked."
        es = "[img]gfx/ui/events/event_05.png[/img] Le ordenas que coma, y obedece. Al principio parece bastante reaci%o_spartan%, pero tras unos bocados se lanza sobre el tazón y se atiborra de jugos, con motas de maíz salpicándole las mejillas. Está casi loc%o_spartan% de placer. Le has recordado lo buena que puede ser la comida. Personalmente, la carne te pareció un poco pasada."
    }
    // FILE: mod_legends\hooks\events\events\special\desertion_event.nut
    // context: desertion_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: «cada vez que daba la orden» debe ser «dabas» (la orden la da el capitán); «comida grosera» por «coarse food» (es comida basta); «la comida regular» calca «regular fare»; «aparentemente» por «apparently» (por lo visto); «Al haberlo extrañado» por «having missed him» (echarlo en falta); faltan varios de los saltos de párrafo del inglés.
        en = "[img]gfx/ui/events/event_64.png[/img]{%desertedbrother% has deserted the %companyname%. When the days seem endless and the road longer, a different sort of quality is challenged in men. You've discovered that even those who are fearless in battle sometimes don't have the stamina for the hardships of the mercenary life. Then there are men who are both cowards and layabouts. You can only hope you don't waste too much coin on that sort before finding them out.\n\n%otherbrother% steps up to you.%SPEECH_ON%Never mind about %desertedbrother%, sir. Never liked the look of %them_deserter%. Without the %companyname% to take care of %them_deserter%, I wager in a fortnight's time %they_deserter%'ll be swinging from the gibbet.%SPEECH_OFF% | Bellyaching is a time honored tradition among mercenaries, and among people in general, but you were quickly growing tired of %desertedbrother%'s endless complaints.\n\nIf the rations were stale, the beer too bitter, or the meat tough, %they_deserter% was the first to let you know about it, repeatedly. %They_deserter% would say the same regarding sore feet, bad weather, brittle shields, chafing armor, the caravan moving too slow, the caravan moving too fast, blunt blades, getting first watch, moldy bread, low pay, general boredom, and night owls keeping %them_deserter% awake after dark. This isn't the complete list of %their_deserter% grievances, but they are all you can recall at the moment.\n\n%desertedbrother%'s complaints are unfortunately the regular fare of the traveling mercenary troop, and mostly unavoidable. So you're not exactly surpised when you find %desertedbrother% has left for a less cumbersome life. | %desertedbrother% has not been putting %their_deserter% heart into racing towards certain death and crushing the enemy before %them_deserter% for several days now. Having missed %them_deserter% around camp today, you are told by the other men that %they_deserter% went to find firewood. Since this job doesn't typically take twelve hours, it seems %desertedbrother% has finally decided to take %their_deserter% discontent on the road and try %their_deserter% luck elsewhere. You doubt you'll see %them_deserter% again. | In your recent travels, the company has unfortunately faced a series of mishaps. This has hit %desertedbrother% harder than the others. %They're_deserter% been sleeping late, starting fights, and acting insubordinate. That is, when you can find %them_deserter% at all. None of this endears %them_deserter% to you or %their_deserter% comrades, and it didn't help matters when %otherbrother% chucked %desertedbrother%'s bedroll into the shallow ditch the brothers had been using for a latrine.\n\nIt is usually best to let the men vent their unhappiness, and since the company has been having a run of raw luck you've been tolerant. When this morning you found %them_deserter% gone, it wasn't much of a surprise. %desertedbrother% has deserted the %companyname%. | You are troubled to learn that %desertedbrother% seems to have disappeared during the night. After questioning the others and ensuring %they_deserter% hadn't simply stepped behind a nearby boulder to relieve %their_deserter% bowels, you call out a search. Thinking that perhaps %desertedbrother% had been taken by treachery, kidnapped for ransom, or fallen afoul of some beast, you and the brothers spent several hours searching the area and calling %their_deserter% name.\n\nThen %otherbrother% finally suggests that %desertedbrother% is not missing at all, but has deserted you all.%SPEECH_ON%%They're_deserter% been griping about the company lately, but I guess %they_deserter% hid it from you, sir, so %they_deserter%'d have a chance to slip away unseen.%SPEECH_OFF%Restraining the urge to give the bearer of bad news a solid box about the ears, you ask why %they_deserter% didn't come forward earlier, but the brother has no answer. | You never figured %desertedbrother% for the type to desert, but when the dawn comes and he's nowhere to be seen you realize you were being naive. On every march %they_deserter% had been falling farther and farther behind, and every time you gave the order to break camp, %they_deserter% was last to gather %their_deserter% gear and start walking. %Their_deserter% equipment had also begun to look ratty. Though %they_deserter% kept %their_deserter% thoughts to %themselves_deserter%, in retrospect %their_deserter% sour looks and disinterest in %their_deserter% comrades made it obvious %they_deserter% wasn't happy with the direction the company has been heading in lately.\n\nYou sound out the other men and discover discontent is on the rise generally. Keep the men well fed and watered like any beast, and make sure they get paid on time, and hopefully %desertedbrother% will be the last to flee in the night. | You do not know if it was the low pay, the threat of dismemberment, the forced marches in icy rain, the foul language and coarse food, the abuse at the hands of %their_deserter% brothers, the small children throwing stones, the cold wind or the sleepless nights, but %desertedbrother% has grown more and more unhappy this last while until apparently %they_deserter% gave up on the mercenary life altogether.%SPEECH_ON%Don't know what %they_deserter% has to complain about. Everything seems right normal to me.%SPEECH_OFF%%otherbrother% says when hearing about the whole thing. %desertedbrother% has chosen the open road over the %companyname%. At least %they_deserter% had the decency to tell you in person that %they_deserter% decided to leave - although, thinking about it, perhaps it was just to collect his remaining pay in person. | Lately, %desertedbrother% had begun to take long walks in the evening when the day's work was done. Though %their_deserter% habit of wandering off alone wasn't exactly safe, you could think of no reason to stop %them_deserter% when %they_deserter% wasn't needed in camp. However, the more hardships the company faced, the longer these walks became, until one morning %desertedbrother% did not return at all.\n\n%desertedbrother% has deserted the %companyname%. It's probably for the best. | %desertedbrother% has been especially moody of late, spending all %their_deserter% off hours fondling an old throwing knife, a blade in such poor condition it more closely resembled a bit of scrap iron than a proper weapon. %They_deserter% spent the previous evening throwing it at the bole of a dead tree, each time rising with a groan to retrieve it and walking back several yards to squat down and throw it again, well into the night.\n\nClearly %they_deserter% was unhappy with the recent setbacks the company has faced and this morning %they_deserter% mustered the courage to enter your tent and explain that %they_deserter%'ll be leaving the company to seek %their_deserter% fortune elsewhere.}"
        es = "[img]gfx/ui/events/event_64.png[/img]{%desertedbrother% ha desertado de %companyname%. Cuando los días parecen interminables y el camino aún más largo, se pone a prueba en los hombres una cualidad distinta. Has descubierto que incluso quienes no conocen el miedo en la batalla a veces no tienen el aguante necesario para las penurias de la vida de mercenario. Luego están los hombres que son a la vez cobardes y holgazanes. Solo puedes esperar no malgastar demasiadas monedas en esa clase de gente antes de descubrirlos.\n\n%otherbrother% se te acerca.%SPEECH_ON%No te preocupes por %desertedbrother%, señor. Nunca me gustó su pinta. Sin %companyname% para cuidar de %el_deserter%, apuesto a que en quince días estará colgando de la horca.%SPEECH_OFF% | Quejarse es una tradición venerable entre los mercenarios, y entre la gente en general, pero te estabas hartando muy deprisa de las quejas interminables de %desertedbrother%.\n\nSi las raciones estaban rancias, la cerveza demasiado amarga o la carne dura, era el primero en hacértelo saber, una y otra vez. Decía lo mismo de los pies doloridos, el mal tiempo, los escudos quebradizos, la armadura que rozaba, la caravana que iba demasiado lenta, la caravana que iba demasiado rápida, las hojas romas, que le tocara la primera guardia, el pan mohoso, la paga escasa, el aburrimiento en general y los trasnochadores que no %lo_deserter% dejaban dormir por la noche. No es la lista completa de sus agravios, pero es todo lo que alcanzas a recordar ahora mismo.\n\nPor desgracia, las quejas de %desertedbrother% son el pan de cada día de toda tropa de mercenarios itinerante, y casi siempre inevitables. Así que no te sorprende demasiado descubrir que %desertedbrother% se ha marchado en busca de una vida menos penosa. | %desertedbrother% lleva ya varios días sin poner el corazón en correr hacia una muerte segura y aplastar al enemigo que tiene delante. Hoy %lo_deserter% has echado en falta por el campamento, y los demás hombres te dicen que fue a buscar leña. Dado que esa tarea no suele llevar doce horas, parece que %desertedbrother% por fin ha decidido llevarse su descontento al camino y probar suerte en otra parte. Dudas que vuelvas a ver%lo_deserter%. | En tus últimos viajes, la compañía ha sufrido por desgracia una serie de contratiempos. Esto ha afectado a %desertedbrother% más que a los demás. Ha estado durmiendo hasta tarde, empezando peleas y mostrándose insubordinad%o_deserter%. Eso, cuando consigues encontrar%lo_deserter%. Nada de esto le gana tu simpatía ni la de sus camaradas, y no ayudó precisamente que %otherbrother% tirara el petate de %desertedbrother% a la zanja poco profunda que los hermanos usaban de letrina.\n\nPor lo general, lo mejor es dejar que los hombres desahoguen su descontento, y como la compañía ha tenido una racha de mala suerte, has sido tolerante. Cuando esta mañana descubriste que se había ido, no te sorprendió mucho. %desertedbrother% ha desertado de %companyname%. | Te inquieta enterarte de que %desertedbrother% parece haber desaparecido durante la noche. Tras interrogar a los demás y asegurarte de que no se había metido sin más detrás de una roca cercana a hacer de vientre, ordenas una búsqueda. Pensando que quizá %desertedbrother% había sido víctima de una traición, que %lo_deserter% habían secuestrado para pedir rescate o que había sufrido el ataque de alguna bestia, pasaste varias horas con los hermanos rastreando la zona y gritando su nombre.\n\nEntonces %otherbrother% sugiere por fin que %desertedbrother% no ha desaparecido en absoluto, sino que los ha abandonado a todos.%SPEECH_ON%Últimamente se ha estado quejando de la compañía, pero supongo que te lo ocultó, señor, para tener ocasión de escabullirse sin que nadie %lo_deserter% viera.%SPEECH_OFF%Conteniendo las ganas de darle al portador de malas noticias un buen tirón de orejas, le preguntas por qué no lo dijo antes, pero el hermano no tiene respuesta. | Nunca imaginaste que %desertedbrother% fuera de los que desertan, pero cuando llega el alba y no se %lo_deserter% ve por ninguna parte, te das cuenta de tu ingenuidad. En cada marcha se había ido quedando cada vez más atrás, y cada vez que dabas la orden de levantar el campamento, era %art_deserter% últim%o_deserter% en recoger su equipo y echar a andar. Su equipo también había empezado a verse raído. Aunque se guardaba sus pensamientos para sí, en retrospectiva, sus miradas agrias y su desinterés por sus camaradas dejaban claro que no estaba content%o_deserter% con el rumbo que había tomado la compañía últimamente.\n\nTanteas a los demás hombres y descubres que el descontento va en aumento en general. Mantén a los hombres bien alimentados y bien abrevados, como a cualquier bestia, asegúrate de que cobren a tiempo y, con suerte, %desertedbrother% será %art_deserter% últim%o_deserter% en huir de noche. | No sabes si fue la paga escasa, la amenaza de perder algún miembro, las marchas forzadas bajo la lluvia helada, el lenguaje soez y la comida basta, los abusos a manos de sus hermanos, los niños pequeños que tiran piedras, el viento frío o las noches en vela, pero %desertedbrother% ha estado cada vez más descontent%o_deserter% últimamente hasta que, por lo visto, ha renunciado del todo a la vida de mercenario.%SPEECH_ON%No sé de qué tiene que quejarse. A mí todo me parece de lo más normal.%SPEECH_OFF%Eso dice %otherbrother% al enterarse de todo el asunto. %desertedbrother% ha preferido el camino abierto antes que %companyname%. Al menos tuvo la decencia de decirte en persona que había decidido irse, aunque, pensándolo bien, quizá solo fue para cobrar en persona lo que le quedaba de paga. | Últimamente, %desertedbrother% había empezado a dar largos paseos al anochecer, cuando terminaba el trabajo del día. Aunque su costumbre de alejarse a solas no era precisamente segura, no se te ocurría ninguna razón para impedírselo cuando no hacía falta en el campamento. Sin embargo, cuantas más penurias sufría la compañía, más largos se volvían esos paseos, hasta que una mañana %desertedbrother% no volvió.\n\n%desertedbrother% ha desertado de %companyname%. Probablemente sea lo mejor. | %desertedbrother% ha estado especialmente de mal humor últimamente, y se pasa todas sus horas libres manoseando un viejo cuchillo arrojadizo, una hoja en tan mal estado que se parece más a un trozo de chatarra que a un arma de verdad. Pasó la tarde anterior lanzándolo contra el tronco de un árbol muerto; cada vez se levantaba con un gruñido para recogerlo, retrocedía varios metros, se agachaba y volvía a lanzarlo, hasta bien entrada la noche.\n\nEstaba claro que no estaba content%o_deserter% con los recientes reveses de la compañía, y esta mañana ha reunido el valor para entrar en tu tienda y explicarte que deja la compañía para buscar fortuna en otra parte.}"
    }
    // context: desertion_event.o.create.::Legends.Screens.hook()._screen.Options.Text
    {
        en = "{I can hardly force any of %them_deserter% to remain with the company... | Bad news, indeed. | A momentary setback. | I can not let something like this happen again. | This will impact the bottom line.}"
        es = "{No puedo obligar a nadie a quedarse en la compañía... | Malas noticias, sin duda. | Un contratiempo pasajero. | No puedo permitir que algo así vuelva a suceder. | Esto se notará en las cuentas.}"
    }
    // context: desertion_event.o.create.::Legends.Screens.hook()._screen.Options.getResult.::Legends.addFallen()
    {
        en = "Deserted the company"
        es = "Desertó de la compañía"
    }
    // FILE: mod_legends\hooks\events\events\special\retinue_slot_event.nut
    // context: retinue_slot_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_26.png[/img]{The prestige and renown of the %companyname% is growing. Everywhere you go, people are looking to join - and not just sellswords, but followers who may be of other use! | With every battle your sellswords fight, the renown of the company grows. As this fame rises, more people, and not just sellswords, will be looking to join the %companyname%. Perhaps it is time the company invests in some special equipment? | Followers of the %companyname% need tools to fill their roles, and said tools would prove helpful to the survival of those around them...}"
        es = "[img]gfx/ui/events/event_26.png[/img]{El prestigio y el renombre de %companyname% no paran de crecer. Allá donde vas, hay gente que quiere unirse, ¡y no solo mercenarios, sino seguidores que pueden resultar útiles de otras maneras! | Con cada batalla que libran tus mercenarios, crece el renombre de la compañía. A medida que aumenta esa fama, más gente, y no solo mercenarios, querrá unirse a %companyname%. ¿Quizá sea hora de que la compañía invierta en algún equipo especial? | Los seguidores de %companyname% necesitan herramientas para desempeñar sus funciones, y esas herramientas serían de gran ayuda para la supervivencia de quienes los rodean...}"
    }
    // FILE: mod_legends\hooks\events\events\supposed_witch_event.nut
    // en = "Alright, we'll take you."
    // en base_es
    // en = "I hope she finds somewhere safe to be."
    // en base_es
    // context: supposed_witch_event.o.create.s.start._event.m.Dude.setTitle()
    {
        en = "the Roasted"
        es = "de la Hoguera"
    }
    // context: supposed_witch_event.o.create.s.start._event.m.Dude.getBackground().m.RawDescription
    {
        en = "While visiting the local village you found %name% tied to a stake and set %them% free, now %they% fights with you and for %their% freedom"
        es = "Mientras visitabas una aldea encontraste a %name% atad%o% a una estaca y %lo% liberaste; ahora lucha a tu lado y por su libertad"
    }
    // en = "<bro:str> suffers <injury:str>"
    // en base_es
    // en = "<student:str> suffers light wounds"
    // en base_es
    // en = "You saved a woman from being burned at the stake"
    // en base_es
    // en = "Killed an evil spirit"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Resolve"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Initiative"
    // en base_es
    // en = "Saw an evil spirit meet its end"
    // en base_es
    // context: supposed_witch_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_79.png[/img]The holy one, %monk%, sits with the town's own friar and talks for a time. When they are done, a nod is given to the torchman who sets the wooden pallets aflame. The woman screams for mercy, but the flames have none for her, slowly working up feet first. It is a horrific sight and only when the smoke is a choking cloud does the dying woman go silent. The fire consumes her entirely as the rest of the town claps and cheers. %monk% states that she was clearly a witch and had to be done away with. You're not sure. All you saw was a woman burned alive, but you trust that they know more than you about the war between the old gods and the evils of sorcery."
        es = "[img]gfx/ui/events/event_79.png[/img]%monk%, con toda su santidad, se sienta un rato a hablar con el fraile del pueblo. Cuando terminan, le hacen una señal con la cabeza al de la antorcha, que prende fuego a las tarimas de madera. La mujer grita pidiendo piedad, pero las llamas no tienen ninguna con ella y suben despacio, empezando por los pies. Es una visión espantosa, y solo cuando el humo se ha vuelto una nube asfixiante la moribunda guarda silencio. El fuego la consume por completo mientras el resto del pueblo aplaude y vitorea. %monk% asegura que estaba claro que era una bruja y que había que acabar con ella. Tú no lo tienes tan claro. Lo único que viste fue a una mujer quemada viva, pero confías en que ellos sepan más que tú de la guerra entre los antiguos dioses y los males de la hechicería."
    }
    // en = "Had a witch burned"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Resolve"
    // en base_es
    // en = "Saw a witch burning at the stake"
    // en base_es
    // context: supposed_witch_event.o.create.s.Text
    {
        // corrige base: «a la vuelta de la esquina» por «on your doorstep» cambia el sentido (Davkul ya está a su puerta, no cerca en el tiempo); «es enviada a correr por su propia seguridad» calca el inglés.
        en = "[img]gfx/ui/events/event_79.png[/img]%cultist% steps forward and looks the villagers up and down, with a slowing shaking head.%SPEECH_ON%You all should kill yourselves.%SPEECH_OFF%The town monk rustles up his cloak.%SPEECH_ON%E-excuse me?%SPEECH_OFF%The cultist starts to cut the woman down. A few of your mercenaries step forward to stop anyone from protesting. When she's free and sent running for her own safety, %cultist% speaks again.%SPEECH_ON%Kill yourselves. Each of you. Tonight. You've angered Davkul and his rage is a debt you'd do best to pay yourself.%SPEECH_OFF%The monk opens his mouth to say something, but his nose cracks as though indented by an invisible stone. He lurches, blood spewing from his nostrils. %cultist% nods.%SPEECH_ON%Hmm, he is angrier than I had thought. Davkul awaits us all, but he is now on your doorstep.%SPEECH_OFF%Screaming, the monk falls to the ground as his jaw sickeningly cracks open, his mouth left permanently ajar. The villagers scream and disperse like rabbits beneath the shadow of a hawk."
        es = "[img]gfx/ui/events/event_79.png[/img]%cultist% da un paso al frente y mira a los aldeanos de arriba abajo, negando lentamente con la cabeza.%SPEECH_ON%Todos ustedes deberían matarse.%SPEECH_OFF%El monje del pueblo se recoge la capa.%SPEECH_ON%¿D-disculpe?%SPEECH_OFF%%cultist% empieza a desatar a la mujer. Algunos de tus mercenarios dan un paso al frente para impedir que nadie proteste. Cuando queda libre y sale corriendo para ponerse a salvo, %cultist% vuelve a hablar.%SPEECH_ON%Mátense. Todos y cada uno de ustedes. Esta noche. Han enojado a Davkul, y su ira es una deuda que más les vale pagar ustedes mismos.%SPEECH_OFF%El monje abre la boca para decir algo, pero su nariz cruje como si la hubiera hundido una piedra invisible. Se tambalea, con la sangre brotándole a chorros de las fosas nasales. %cultist% asiente.%SPEECH_ON%Hmm, está más enojado de lo que pensaba. Davkul nos espera a todos, pero ahora está a su puerta.%SPEECH_OFF%Entre gritos, el monje cae al suelo mientras la mandíbula se le abre con un crujido repugnante, y la boca le queda abierta para siempre. Los aldeanos gritan y se dispersan como conejos bajo la sombra de un halcón."
    }
    // en = "Witnessed Davkul's power"
    // en base_es
    // en = "<actor:str> gains <v:val_tag> Resolve"
    // en base_es
    // en = "<cultist:str> freed a witch"
    // en base_es
    // FILE: mod_legends\hooks\events\events\surefooted_saves_damsel_event.nut
    // context: surefooted_saves_damsel_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_85.png[/img]A few mercenaries come back to you with the most curious of stories. Apparently %surefooted%, the ever surefooted sellsword, managed to make a bit of a name for himself in %townname%.\n\n While carousing with ladies on a tavern staircase, the bannister broke and a damsel went careening downward. With a horn of ale in one hand and a wench wrapped in the tender grip of the other, the mercenary stuck his foot out and managed to catch the falling mistress on the toe of his boot, quite literally bringing her to heel much to the roaring applause of the inebriated crowd below. You ask where he is now. The mercenaries laugh.%SPEECH_ON%Dropping trou with the easily impressed, what else?%SPEECH_OFF%";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_85.png[/img]A few mercenaries come back to you with the most curious of stories. Apparently %surefooted%, the ever surefooted sellsword, managed to make a bit of a name for himself in %townname%.\n\n While carousing with ladies on a tavern staircase, the bannister broke and a damsel went careening downward. With a horn of ale in one hand and a wench wrapped in the tender grip of the other, the mercenary stuck his foot out and managed to catch the falling mistress on the toe of his boot, quite literally bringing her to heel much to the roaring applause of the inebriated crowd below. You ask where he is now. The mercenaries laugh.%SPEECH_ON%Dropping trou with the easily impressed, what else?%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_85.png[/img]Unos cuantos mercenarios vuelven con la más curiosa de las historias. Por lo visto, %surefooted%, que nunca pierde pie, se ha labrado cierta fama en %townname%.\n\nMientras andaba de juerga con unas damas en la escalera de una taberna, la barandilla se rompió y una doncella salió despedida hacia abajo. Con un cuerno de cerveza en una mano y una moza bien sujeta con la otra, %surefooted% sacó el pie y logró atrapar a la dama en plena caída con la punta de la bota, poniéndola a sus pies, y nunca mejor dicho, entre los estruendosos aplausos de la multitud ebria de abajo. Preguntas dónde está ahora. Los mercenarios se ríen.%SPEECH_ON%Bajándose los calzones con quien se deje impresionar, ¿dónde si no?%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\swordmaster_teaches_event.nut
    // context: swordmaster_teaches_event.o.create.s.Text
    {
        // s.Text = "[img]gfx/ui/events/event_17.png[/img]An old mercenary\'s voice is heard quietly issuing orders.%SPEECH_ON%The foot leads, the body follows. Again.%SPEECH_OFF%You find %swordmaster% the swordmaster and %swordstudent% practicing in a field. The elder\'s head shakes at the most recent display of swordsmanship.%SPEECH_ON%The foot leads, the body follows. Again!%SPEECH_OFF%The student practices what is taught. Nodding, the swordmaster barks another order.%SPEECH_ON%Now do it in reverse. The foot retreats, the body follows. Do not retreat with your mind. Let your feet do the thinking for you. Instinct is survival! Thinking is death! Move as though the world demanded it. If a wind blows are you faster than the leaves which hear its call? I see. Good... you are learning. Now... again.%SPEECH_OFF%";
        mode = "pattern"
        en = "[img]gfx/ui/events/event_17.png[/img]An old mercenary's voice is heard quietly issuing orders.%SPEECH_ON%The foot leads, the body follows. Again.%SPEECH_OFF%You find %swordmaster% the swordmaster and %swordstudent% practicing in a field. The elder's head shakes at the most recent display of swordsmanship.%SPEECH_ON%The foot leads, the body follows. Again!%SPEECH_OFF%The student practices what is taught. Nodding, the swordmaster barks another order.%SPEECH_ON%Now do it in reverse. The foot retreats, the body follows. Do not retreat with your mind. Let your feet do the thinking for you. Instinct is survival! Thinking is death! Move as though the world demanded it. If a wind blows are you faster than the leaves which hear its call? I see. Good... you are learning. Now... again.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_17.png[/img]Se oye una voz veterana dando órdenes en voz baja.%SPEECH_ON%El pie guía, el cuerpo sigue. Otra vez.%SPEECH_OFF%Encuentras a %swordmaster%, con toda su maestría en la espada, y a %swordstudent% practicando en un campo. %swordmaster% niega con la cabeza ante la última demostración de esgrima.%SPEECH_ON%El pie guía, el cuerpo sigue. ¡Otra vez!%SPEECH_OFF%%swordstudent% practica lo que se le enseña. Con un gesto de aprobación, %swordmaster% suelta otra orden.%SPEECH_ON%Ahora hazlo al revés. El pie retrocede, el cuerpo sigue. No retrocedas con la mente. Deja que tus pies piensen por ti. ¡El instinto es supervivencia! ¡Pensar es la muerte! Muévete como si el mundo lo exigiera. Si sopla el viento, ¿te mueves antes que las hojas que oyen su llamada? Ya veo. Bien... estás aprendiendo. Ahora... otra vez.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\the_horseman_event.nut
    // context: the_horseman_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: narra en pasado («Sacaste», «cortaste», «Se derrumbó») lo que el inglés cuenta en presente; «Eso es una maldita tontería» rebaja «fucking horseshit»; se pierde la exclamación final del dueño.
        en = "%terrainImage%You take out your blade and cut the man down. He crumples onto his shoulders and splays out, his lashed back in the dirt. The soil may as well have been salt judging by his wailing. One of the whippers stands up.%SPEECH_ON%Hey, just what do you think you're doing? We ain't finished here!%SPEECH_OFF%%randombrother% draws %their_randombrother% weapon and the man backs off. The horse owner spits and shakes his head.%SPEECH_ON%Are you really going to defend this piece of work? Ain't that some fucking horseshit. I guess now I can say I've seen it all which is exactly what I said when I caught this bastard porkin' my dead horse!%SPEECH_OFF%The man catches his breath then points at the recently rescued.%SPEECH_ON%I hope you die on your first day out ya filly fiddling bastard.%SPEECH_OFF%"
        es = "%terrainImage%Sacas tu espada y desatas al hombre de un tajo. Se desploma sobre los hombros y queda tendido, con la espalda azotada contra el suelo. A juzgar por sus alaridos, la tierra bien podría haber sido sal. Uno de los azotadores se levanta.%SPEECH_ON%Oye, ¿qué demonios crees que estás haciendo? ¡No hemos terminado aquí!%SPEECH_OFF%%randombrother% desenvaina su arma y el hombre retrocede. El dueño del caballo escupe y niega con la cabeza.%SPEECH_ON%¿De verdad vas a defender a esta joya? Esto es una puta mierda de caballo. ¡Supongo que ahora puedo decir que lo he visto todo, que es justo lo que dije cuando atrapé a este bastardo tirándose a mi caballo muerto!%SPEECH_OFF%El hombre recupera el aliento y luego señala al recién rescatado.%SPEECH_ON%Espero que mueras en tu primer día fuera, bastardo manoseayeguas.%SPEECH_OFF%"
    }
    // en = "the Filly Fiddler"
    // en base_es
    // en = "You found %name% being whipped for 'involving' himself with a dead horse. Hopefully that past is, er, behind him now."
    // en base_es
    // en = "Satisfied his needs with a dead horse"
    // en base_es
    // en = "Got whipped"
    // en base_es
    // FILE: mod_legends\hooks\events\events\thief_caught_event.nut
    // context: thief_caught_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_33.png[/img]During a short rest, your company managed to catch a thief that tried to make off with some of your supplies. The villain's clothes are but rags and looks more skeleton than human. What are you going to do with the crook?"
        es = "[img]gfx/ui/events/event_33.png[/img]Durante un breve descanso, tu compañía logró atrapar a alguien que intentaba llevarse parte de tus suministros. Su ropa no es más que harapos y parece más esqueleto que persona. ¿Qué piensas hacer con quien intentó robarte?"
    }
    // context: thief_caught_event.o.create.s.Options[0].Text
    {
        // corrige base: «Dadle» es de vosotros; el corpus usa «ustedes» («Denle»).
        en = "Give that poor soul some food and water."
        es = "Denle a esa pobre alma algo de comida y agua."
    }
    // context: thief_caught_event.o.create.s.Options[1].Text
    {
        en = "Give the rotter a good beating."
        es = "Denle una buena paliza a esa sabandija."
    }
    // context: thief_caught_event.o.create.s.Options[2].Text
    {
        en = "Put that thief to the sword."
        es = "Pasen a espada a esa rata ladrona."
    }
    // context: thief_caught_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_33.png[/img]Under the cloak of night some thief managed to nick some of your supplies. Supplies that will probably be offered back to you in the next settlement..."
        es = "[img]gfx/ui/events/event_33.png[/img]Bajo el manto de la noche, algún ladrón logró birlarte parte de tus suministros. Suministros que probablemente te ofrecerán de vuelta en el próximo asentamiento..."
    }
    // context: thief_caught_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_33.png[/img]%randombrother% gives the thief a proper beating with a short cane. The shaft lands viciously hard and you can hear the sound of the blows passing through the theif's almost hollow frame. The beaten culprit wilts and turns and tries hard to get away, but the sellsword is persistent in meting out the punishment. When it's all said and done, you leave the beaten thief behind, wimpering and clutching the dirt between frail fingers."
        es = "[img]gfx/ui/events/event_33.png[/img]%randombrother% muele a palos con un bastón corto a quien intentó robarles. La vara cae con una dureza brutal y puedes oír los golpes atravesando ese cuerpo casi hueco. La víctima de la paliza se encoge, se retuerce y se esfuerza por escapar, pero %randombrother% no ceja en impartir el castigo. Cuando todo termina, dejas atrás a esa figura apaleada, que gimotea y aferra la tierra entre sus frágiles dedos."
    }
    // context: thief_caught_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_33.png[/img]Feeling bad for the feeble cutpurse, you decide to offer some water and food. The withered person almost snatches the meal away from you and drives a famished face into it. The thief thanks you between every bite."
        es = "[img]gfx/ui/events/event_33.png[/img]Sintiendo lástima por esa alma enclenque que vive de cortar bolsas, decides ofrecerle algo de agua y comida. Esa figura consumida casi te arranca la comida de las manos y hunde en ella su cara famélica. Te da las gracias entre bocado y bocado."
    }
    // context: thief_caught_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_33.png[/img] You tell the mercenaries to get back to marching. The thief uses a thin arm to wipe their mouth and stands up, wobbling on weak legs to take a few steps after you and asks if maybe they could join the company. %SPEECH_ON%I'll give my life for you, if I must, just anything to not have to steal anymore.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_33.png[/img] Les dices a los mercenarios que vuelvan a la marcha. Tras limpiarse la boca con un brazo flaco, quien intentó robarles se pone en pie, da unos pasos tras de ti tambaleándose sobre unas piernas débiles y pregunta si podría unirse a la compañía.%SPEECH_ON%Daré mi vida por ti si hace falta, lo que sea con tal de no tener que robar más.%SPEECH_OFF%"
    }
    // context: thief_caught_event.o.create.s.Options[1].Text
    {
        en = "We need warriors, not underfed thieves."
        es = "Necesitamos guerreros, no ladrones muertos de hambre."
    }
    // context: thief_caught_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_33.png[/img]As you draw your sword, the thief cowers, beggin for mercy as their mirrored face ripples over the blade's fuller and edges. You raise the weapon. The theif screams out that %SPEECH_ON% I'll work for you, I'll work for free, anything to spare my life.%SPEECH_OFF% You hesitate, your sword still lingering in the air."
        es = "[img]gfx/ui/events/event_33.png[/img]Cuando desenvainas la espada, quien intentó robarles se encoge suplicando piedad, mientras su rostro reflejado ondula sobre la acanaladura y los filos de la hoja. Alzas el arma. Entre gritos, te suplica:%SPEECH_ON%Trabajaré para ti, trabajaré gratis, ¡lo que sea con tal de salvar la vida!%SPEECH_OFF%Dudas, con la espada aún suspendida en el aire."
    }
    // context: thief_caught_event.o.create.s.Text
    {
        // corrige base: «Hundos» es errata de «Hundes»; «en la esquina de tu codo» calca «nook of your elbow» (es el pliegue del codo).
        en = "[img]gfx/ui/events/event_33.png[/img]%SPEECH_ON%The punishment for thievery is death.%SPEECH_OFF%You plunge the sword down, cutting off the thief's last words with a quick stab into their chest. The body seizes up, speechless save for the scratching of thin hands grabbing the killing implement, and then the face falls back, dead within moment. You retrieve your weapon and clean it off in the nook of your elbow. The dead head turns to a side as blood pools quietly beneath."
        es = "[img]gfx/ui/events/event_33.png[/img]%SPEECH_ON%El castigo por robar es la muerte.%SPEECH_OFF%Hundes la espada y cortas en seco sus últimas palabras con una rápida estocada en el pecho. El cuerpo se agarrota, sin más sonido que el roce de unas manos flacas aferrando el acero que lo mata, y luego la cabeza cae hacia atrás, sin vida en un instante. Recuperas tu arma y la limpias en el pliegue del codo. La cabeza muerta se ladea mientras la sangre se encharca en silencio debajo."
    }
    // context: thief_caught_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]You lower your weapon and the theif crawls to you and hugs your legs, kissing your feet until you draw away.\n\nTo get things straight, you give a long list of orders and how it is to work in the company. You also give a contract which is then signed with a jagged 'x'. A few of the company then spend the rest of the day teaching the ropes and introducing the new sellsword to the rest of the company. By night's end, it seems like the new blood is already beginning to fit in. By next morning, you wake to see a great number of supplies are missing and the new recruit is nowhere in sight. It appears that, although you stayed the thief's execution, they went on ahead and stole things anyway. Let that be a lesson to you."
        es = "[img]gfx/ui/events/event_05.png[/img]Bajas el arma y quien intentó robarles se arrastra hasta ti, se abraza a tus piernas y te besa los pies hasta que te apartas.\n\nPara dejar las cosas claras, le das una larga lista de órdenes y le explicas cómo se trabaja en la compañía. También le das un contrato, que firma con una 'x' torcida. Luego, varios miembros de la compañía pasan el resto del día enseñándole el oficio y presentando a la nueva incorporación al resto del grupo. Al final de la noche, parece que la sangre nueva ya empieza a encajar. A la mañana siguiente, te despiertas y ves que faltan muchísimos suministros y que de la nueva incorporación no hay ni rastro. Por lo visto, aunque le perdonaste la vida, ha seguido a lo suyo y ha robado de todos modos. Que te sirva de lección."
    }
    // FILE: mod_legends\hooks\events\events\training_accident_event.nut
    // context: training_accident_event.o.create.::Legends.Screens.hook()._screen.Options[0].Text
    {
        en = "At least %they_clumsyguy% didn't kill %themselves_clumsyguy%"
        es = "Al menos no se ha matado"
    }
    // context: training_accident_event.o.create.::Legends.Screens.hook()._screen.start.Text
    {
        // corrige base: sobra la «y» de «y logró», que deja la frase sin verbo principal, y mezcla tiempos («entrenaban», «logró») donde el inglés va en presente.
        en = "[img]gfx/ui/events/event_19.png[/img]While training, %clumsyguy%, not being the most dexterous fellow, manages to hurt %themselves_clumsyguy% with %their_clumsyguy% own weapon."
        es = "[img]gfx/ui/events/event_19.png[/img]Durante el entrenamiento, %clumsyguy%, que no es precisamente %art_clumsyguy% más hábil del grupo, se las arregla para herirse con su propia arma."
    }
    // en = "<bro:str> suffers <injury:str>"
    // en base_es
    // context: training_accident_event.o.create.::Legends.Screens.hook()._screen.start.Text
    {
        // corrige base: «contrataque» es errata de «contraataque» y falta la coma detrás; «logró clavarse en el pie» deja sin decir qué se clava.
        en = "[img]gfx/ui/events/event_34.png[/img]Traveling, you like to keep your men fresh with the occasional training exercise. Unfortunately, while practicing a riposte, %clumsyguy% managed to stick %themselves_clumsyguy% in the foot. The %person_clumsyguy% appears even more hurt by the embarrassment."
        es = "[img]gfx/ui/events/event_34.png[/img]Durante los viajes, te gusta mantener en forma a tus hombres con algún ejercicio de entrenamiento de vez en cuando. Por desgracia, mientras practicaba un contraataque, %clumsyguy% se clavó el arma en el pie. Parece aún más dolid%o_clumsyguy% por la vergüenza."
    }
    // en = "<student:str> suffers light wounds"
    // en base_es
    // context: training_accident_event.o.create.::Legends.Screens.hook()._screen.start.Text
    {
        // corrige base: «cojín de alfileres» calca «pincushion» (en castellano, alfiletero); mezcla pasado y presente donde el inglés va en presente.
        en = "[img]gfx/ui/events/event_34.png[/img]While doing inventory, you ask %clumsyguy% to carry over a quiver of arrows. The short, simple journey ends with the %person_clumsyguy% tripping over a rock and turning %themselves_clumsyguy% into a pincushion."
        es = "[img]gfx/ui/events/event_34.png[/img]Mientras haces inventario, le pides a %clumsyguy% que te traiga un carcaj de flechas. El trayecto, corto y sencillo, termina con %art_clumsyguy% %hombre_clumsyguy% tropezando con una piedra y convirtiéndose en un alfiletero."
    }
    // context: training_accident_event.o.create.::Legends.Screens.hook()._screen.start.Text
    {
        en = "[img]gfx/ui/events/event_34.png[/img]You find a rather drunk %clumsyguy% nursing the side of %their_clumsyguy% face. %otherguy1% explains that the idiot tried to dance over a series of rocks, only to fall and bash %themselves_clumsyguy% in the face. Great."
        es = "[img]gfx/ui/events/event_34.png[/img]Encuentras a %clumsyguy% bastante borrach%o_clumsyguy%, frotándose un lado de la cara. %otherguy1% explica que %art_clumsyguy% idiota intentó bailar sobre una hilera de rocas, solo para caerse y darse de bruces. Genial."
    }
    // context: training_accident_event.o.create.::Legends.Screens.hook()._screen.start.Text
    {
        en = "[img]gfx/ui/events/event_34.png[/img]While %otherguy1% and %otherguy2% train, %clumsyguy% comes in between them, lecturing on how to do it properly while at the same time not watching where %they're_clumsyguy% going. A wayward wooden sword crosses paths with %their_clumsyguy% face and a moment later the idiot is unconscious."
        es = "[img]gfx/ui/events/event_34.png[/img]Mientras %otherguy1% y %otherguy2% entrenan, %clumsyguy% se mete entre ellos para sermonearlos sobre cómo hacerlo bien, sin mirar por dónde va. Una espada de madera descarriada se cruza con su cara y, un instante después, %art_clumsyguy% idiota está inconsciente."
    }
    // context: training_accident_event.o.create.::Legends.Screens.hook()._screen.start.Text
    {
        en = "[img]gfx/ui/events/event_34.png[/img]It appears %clumsyguy% got a little too much to drink before partaking in today's sparring. As the story was explained to you, the drunkard mistook a tree for an enemy combatant. %They_clumsyguy% then, again as the story goes, proceeded to charge said tree, knocking %themselves_clumsyguy% out in the process."
        es = "[img]gfx/ui/events/event_34.png[/img]Parece que %clumsyguy% bebió un poco de más antes de participar en los combates de práctica de hoy. Según te contaron, %art_clumsyguy% borrach%o_clumsyguy% confundió un árbol con un combatiente enemigo. Luego, siempre según la historia, cargó contra dicho árbol y se dejó sin sentido en el intento."
    }
    // FILE: mod_legends\hooks\events\events\traveling_troupe_event.nut
    // context: traveling_troupe_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_26.png[/img]%entertainer% steps forward and picks up some of the troupe's tools of trade.  %entertainer% tests them out, impressing the entertainers with how well the mercenary is able to use their own equipment. The mime asks if perhaps they could play a couple of tunes together.  Joining the entertainers with a nod, putting on a show that's for the ages. When it's all over, the troupe is so impressed that they try and recruit the mercenary. You tell them that ain't happening and %entertainer% nods.%SPEECH_ON%My time is with the %companyname% now, but I appreciate the compliment.%SPEECH_OFF%You ask how much for the show, but the troupe leader shakes his head.%SPEECH_ON%No need. It was a pleasure playing. We've not put on a show like that in some time and the practice will do us well.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_26.png[/img]%entertainer% da un paso al frente y toma algunas de las herramientas de trabajo del grupo. %entertainer% las prueba y deja a los artistas impresionados con lo bien que maneja su propio equipo. El mimo pregunta si quizá podrían tocar juntos un par de melodías. Con un gesto de asentimiento, %entertainer% se une a los artistas y montan un espectáculo para el recuerdo. Cuando termina, el grupo está tan impresionado que intenta llevarse a %entertainer% con ellos. Les dices que eso no va a pasar y %entertainer% asiente.%SPEECH_ON%Ahora mi lugar está con %companyname%, pero agradezco el cumplido.%SPEECH_OFF%Preguntas cuánto cuesta el espectáculo, pero el jefe del grupo niega con la cabeza.%SPEECH_ON%No hace falta. Ha sido un placer tocar. Hacía tiempo que no dábamos un espectáculo así, y la práctica nos vendrá bien.%SPEECH_OFF%"
    }
    // context: traveling_troupe_event.o.create.s.Text
    {
        // corrige base: se quita la frase de Kaltenborn que la 1.0 añadió y el inglés no tiene
        en = "[img]gfx/ui/events/event_26.png[/img]Before the troupe can start, %nobleman% the noble gets up and asks if they know of a particular song from their days in the court.%SPEECH_ON%They used to sing it when I was a little child. It's been years since I've heard it.%SPEECH_OFF%The mime, again breaking character, grins and loudly proclaims that they know it. He snaps his fingers and the musicians of the group pick up their instruments. When they start, the tune is instantly catchy. It's a stringed and horn orchestration, played alongside a large woman singing from both heart and belly. She is a tempest of a singer, bringing both the quiet and ferocity of a large storm's coming and going, and her lyrics are that of incredible heroism of yore.\n\n After the troupe finishes, you ask how much you owe them. The mime shakes his head.%SPEECH_ON%No, sir, payment is not necessary. It's been awhile since that got requested and it was a pleasure to play it for you.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_26.png[/img]Antes de que el grupo empiece, %nobleman%, de noble cuna, se levanta y pregunta si conocen una canción en particular de sus días en la corte.%SPEECH_ON%Solían cantarla en mi infancia. Hace años que no la oigo.%SPEECH_OFF%El mimo, saliéndose otra vez de su papel, sonríe y proclama en voz alta que la conocen. Chasquea los dedos y los músicos del grupo toman sus instrumentos. En cuanto empiezan, la melodía se te pega al instante. Es una orquestación de cuerdas y vientos, acompañada por una mujer corpulenta que canta con todo el corazón y a pleno pulmón. Es una cantante tempestuosa, que trae tanto la calma como la furia de una gran tormenta que llega y se va, y sus letras hablan de increíbles hazañas heroicas de antaño.\n\nCuando el grupo termina, preguntas cuánto les debes. El mimo niega con la cabeza.%SPEECH_ON%No, señor, no hace falta pagar. Hacía tiempo que nadie la pedía, y ha sido un placer tocarla para usted.%SPEECH_OFF%"
    }
    // en = "You gain <v:val_tag> Crowns"
    // en base_es
    // en = "Enjoyed beating up a traveling troupe"
    // en base_es
    // FILE: mod_legends\hooks\events\events\troublemakers_bully_peasants_event.nut
    // context: troublemakers_bully_peasants_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "%townImage%Entering %townname%, it isn't long until %troublemaker% is bothering the locals. %They_troublemaker%'s slapping buckets out of their hands and kicking women into the mud. When an old man confronts %them_troublemaker%, the sellsword draws out %their_troublemaker% weapon. Other peasants beg that you put a stop to this at once."
        es = "%townImage%Al entrar en %townname%, %troublemaker% no tarda en molestar a los lugareños. Les tira los cubos de las manos de un manotazo y tira a las mujeres al barro a patadas. Cuando un anciano %lo_troublemaker% encara, %art_troublemaker% mercenari%o_troublemaker% desenvaina su arma. Otros campesinos te suplican que le pongas fin a esto de inmediato."
    }
    // en = "%peacekeeperfull%, see if you can calm %troublemaker% with your wisdom."
    // en base_es
    // context: troublemakers_bully_peasants_event.o.create.::Legends.Screens.hook()._screen.start.f.addPlayerRelation()
    {
        en = "One of your company caused havoc in town"
        es = "Alguien de tu compañía causó estragos en el pueblo"
    }
    // context: troublemakers_bully_peasants_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "%townImage%You shrug. %troublemaker% doesn't run the old man through, but %they_troublemaker% does threaten to, raising the weapon on high. When the old man cowers, the sellsword delivers a punch that knocks the elderly right out, his teeth peppering the muck like spits of white rain. This brings a few jeers from the villagers, but they know not to contest your presence any further.\n\nA few men drag the elder away while children boo and women hiss. One child even runs up to the sellsword, pointing at him as he yells '%they_troublemaker%'s a bad %person_troublemaker%.' %troublemaker% shrugs as %they_troublemaker% sheathes %their_troublemaker% weapon.%SPEECH_ON%And yet the bad %person_troublemaker% still stands. Would you also like a taste of the mud, little one?%SPEECH_OFF%The kid quickly runs off."
        es = "%townImage%Te encoges de hombros. %troublemaker% no atraviesa al anciano, pero sí amenaza con hacerlo, alzando el arma bien alto. Cuando el anciano se acobarda, %art_troublemaker% mercenari%o_troublemaker% le suelta un puñetazo que lo deja inconsciente en el acto, y sus dientes salpican el fango como gotas de lluvia blanca. Esto provoca algunos abucheos entre los aldeanos, pero saben que no deben desafiar más tu presencia.\n\nUnos cuantos hombres se llevan a rastras al anciano mientras los niños abuchean y las mujeres sisean. Un niño incluso se acerca corriendo %al_troublemaker% mercenari%o_troublemaker% y, señalándo%lo_troublemaker%, grita: 'es %un_troublemaker% %hombre_troublemaker% mal%o_troublemaker%'. %troublemaker% se encoge de hombros mientras envaina su arma.%SPEECH_ON%Y sin embargo, %art_troublemaker% %hombre_troublemaker% mal%o_troublemaker% sigue en pie. ¿Tú también quieres probar el barro, pequeño?%SPEECH_OFF%El crío sale corriendo."
    }
    // en = "Bullied the peasantfolk"
    // en base_es
    // context: troublemakers_bully_peasants_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "%townImage%As %troublemaker% raises %their_troublemaker% weapon on high, you grab %them_troublemaker% by the forearm and bring it back down. %They_troublemaker% swings around, looking at you sternly. The cowering old man backs off, soon collected by caretakers that shuttle %them_troublemaker% back inside before %they_troublemaker% gets himself hurt.\n\nA few other peasants linger around, watching with keen interest. You tell the sellsword to back down. %They_troublemaker%'s paid to fight who you deem %they_troublemaker% should fight, not a bunch of peasants who are minding their own.\n\n As %troublemaker% glances around, you realize you've left %them_troublemaker% no 'out' that will save face. In %their_troublemaker% eyes, there is a look that says %they_troublemaker%'s about to kill you. It'd be the end of %them_troublemaker%, but %they_troublemaker%'d go out with %their_troublemaker% suicidal pride intact. But the look fades, and embarrassment and humiliation take its place. %They_troublemaker% sheathes %their_troublemaker% weapon, spits, and remarks that %they_troublemaker% was only having some fun."
        es = "%townImage%Cuando %troublemaker% alza el arma bien alto, %lo_troublemaker% agarras del antebrazo y se lo bajas. Se da la vuelta y te mira con severidad. El anciano, acobardado, retrocede, y enseguida lo recogen sus cuidadores, que lo llevan de vuelta adentro antes de que salga herido.\n\nUnos cuantos campesinos más se quedan por allí, mirando con mucho interés. Le dices %al_troublemaker% mercenari%o_troublemaker% que se eche atrás. Le pagan para luchar contra quien tú decidas, no contra un puñado de campesinos que se ocupan de sus asuntos.\n\nMientras %troublemaker% mira a su alrededor, te das cuenta de que no le has dejado ninguna 'salida' para salvar las apariencias. En sus ojos hay una mirada que dice que está a punto de matarte. Sería su fin, pero se iría con su orgullo suicida intacto. Pero la mirada se desvanece, y la vergüenza y la humillación ocupan su lugar. Envaina el arma, escupe y comenta que solo se estaba divirtiendo un poco."
    }
    // context: troublemakers_bully_peasants_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "[img]gfx/ui/events/event_30.png[/img]You look at the peasant who hailed you down.%SPEECH_ON%Who are you, peasant, to tell me or my company what to do?%SPEECH_OFF%The man takes a step back, stammering something about 'only trying to help.' Laughing, you tell your mercenaries to take what they want. If this village has no respect for the authority of armed warriors, then you will have to teach them that respect.\n\nWomen scream and bundle up their children as the order leaves your tongue. They run off and a few men join them. Other men stay behind, protecting their homes, but the %companyname% makes quick work of their modest defenses. Your mercenaries are soon pillaging each and every home, taking what they can with roaring laughter. Today is a good day."
        es = "[img]gfx/ui/events/event_30.png[/img]Miras al campesino que te ha parado.%SPEECH_ON%¿Quién eres tú, campesino, para decirme a mí o a mi compañía lo que tenemos que hacer?%SPEECH_OFF%El hombre da un paso atrás, balbuceando algo de que 'solo intentaba ayudar'. Entre risas, les dices a tus mercenarios que tomen lo que quieran. Si este pueblo no respeta la autoridad de unos guerreros armados, tendrás que enseñarles ese respeto.\n\nLas mujeres gritan y recogen a sus hijos en cuanto la orden sale de tu boca. Huyen, y algunos hombres se van con ellas. Otros se quedan para proteger sus hogares, pero %companyname% acaba enseguida con sus modestas defensas. Tus mercenarios no tardan en saquear todas y cada una de las casas, llevándose lo que pueden entre carcajadas. Hoy es un buen día."
    }
    // en = "You pillaged the town"
    // en base_es
    // en = "Enjoyed raiding and pillaging"
    // en base_es
    // en = "Was appalled by the company's conduct"
    // en base_es
    // context: troublemakers_bully_peasants_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "%townImage%%peacekeeperfull% places %themselves_peacekeeper% between %troublemaker% and the old man. %They_peacekeeper% shakes %their_peacekeeper% head 'no' in a very modest fashion, but you can't help but notice that %their_peacekeeper% swordhand is also on the pommel of %their_peacekeeper% weapon. The troublemaking sellsword briefly seems to consider cutting the %person_peacekeeper% down, but then a smile snaps across %their_troublemaker% face. %They_troublemaker% laughs as %they_troublemaker% sheathes %their_troublemaker% weapon.%SPEECH_ON%Only having a bit of fun, my friend.%SPEECH_OFF%The peasants slowly start going about their business again, but they are wary and stare side-eyed at your men for the rest of your duration in %townname%."
        es = "%townImage%%peacekeeperfull% se interpone entre %troublemaker% y el anciano. Niega con la cabeza con mucha discreción, pero no puedes evitar fijarte en que también tiene la mano de la espada en el pomo del arma. %troublemaker%, siempre buscando pelea, parece plantearse por un instante derribar%lo_peacekeeper% de un tajo, pero de pronto se le dibuja una sonrisa en la cara. Se ríe mientras envaina el arma.%SPEECH_ON%Solo me estaba divirtiendo un poco, amig%o_peacekeeper%.%SPEECH_OFF%Los campesinos vuelven poco a poco a sus quehaceres, pero siguen recelosos y miran de reojo a tus hombres durante el resto de tu estancia en %townname%."
    }
    // context: troublemakers_bully_peasants_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "%townImage%%peacekeeperfull% steps in between %troublemaker% and the old man. The troublemaking sellsword laughs and sheathes %their_troublemaker% weapon. %They_troublemaker% turns back to the rest of the company, grinning and shaking %their_troublemaker% head, but you notice that this smile quickly fades. Before you can say anything, %troublemaker% wheels a fist back around and knocks %peacekeeper% out cold.\n\n Well, that's one way to mollify a mercenary."
        es = "%townImage%%peacekeeperfull% se interpone entre %troublemaker% y el anciano. %Art_troublemaker% mercenari%o_troublemaker% problemátic%o_troublemaker% se ríe y envaina su arma. Se vuelve hacia el resto de la compañía, sonriendo y negando con la cabeza, pero notas que esa sonrisa se desvanece enseguida. Antes de que puedas decir nada, %troublemaker% se gira de golpe con el puño por delante y deja a %peacekeeper% inconsciente.\n\nBueno, esa es una manera de aplacar a un mercenario."
    }
    // context: troublemakers_bully_peasants_event.o.create.::Legends.Screens.hook()._screen.start.List.push().text
    {
        // text = _event.m.Troublemaker.getName() + " and " + _event.m.Peacekeeper.getName() + " grow distant"
        mode = "pattern"
        en = "<troublemaker:str> and <peacekeeper:str> grow distant"
        es = "<troublemaker> y <peacekeeper> se distancian"
    }
    // en = "<bro:str> suffers <injury:str>"
    // en base_es
    // en = "Was humiliated in front of the company"
    // en base_es
    // FILE: mod_legends\hooks\events\events\uber_courageous_event.nut
    // context: uber_courageous_event.o.create.s.Text
    {
        // corrige base: «porta una marca de valentía» calca «carries a brand of courage» (aquí brand es 'clase', no 'marca').
        en = "[img]gfx/ui/events/event_50.png[/img]%juggernaut% carries a brand of courage one part fearless, one part craziness. %They_juggernaut% urgency to throw himself against %they_juggernaut% enemies is inspirational, if no doubt foolish to a mind of reason and rationality. But this is the %companyname%, a band of men who are drawn to the simple life of sword and coin. %juggernaut%'s indomitable nature in this struggle of kill or be killed has rubbed off on a few of the sellswords."
        es = "[img]gfx/ui/events/event_50.png[/img]%juggernaut% tiene una clase de valor hecha a partes iguales de intrepidez y de locura. Su afán por lanzarse contra sus enemigos resulta inspirador, aunque sin duda insensato para una mente lógica y racional. Pero esto es %companyname%, una banda de hombres a los que atrae la vida sencilla de la espada y la moneda. La naturaleza indomable de %juggernaut% en esta lucha de matar o morir se les ha contagiado a algunos de los mercenarios."
    }
    // FILE: mod_legends\hooks\events\events\walkers_bond_event.nut
    // context: walkers_bond_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_16.png[/img]{Folk of the road, %walker1% and %walker2% share stories of their travels with one another. You don't really understand what's so rich about walking about, but the two do bond over their tales and that's good enough for you. | %walker1% and %walker2% have seen much of the world. They've spent years on the road, and now they're telling tales of those years to one another.\n\nTheir appreciation for each other rises, and your appreciation for not listening to boring travel stories also increases. | Most people find the task of walking about to be pretty simple, but those who do little else but walk about find more interest in the affair. Unsurprisingly, %walker1% and %walker2% have come to bond of their tales of... walking around.}"
        es = "[img]gfx/ui/events/event_16.png[/img]{Gente de camino, %walker1% y %walker2% comparten historias de sus viajes. No acabas de entender qué tiene de interesante andar de un lado a otro, pero los dos estrechan lazos con sus relatos, y con eso te basta. | %walker1% y %walker2% han visto mucho mundo. Han pasado años en el camino, y ahora se cuentan historias de esos años.\n\nSu aprecio mutuo crece, y también crece tu aprecio por no tener que escuchar aburridas historias de viajes. | A la mayoría de la gente la tarea de andar de un lado a otro le parece bastante simple, pero quienes apenas hacen otra cosa que andar le encuentran más interés al asunto. Como era de esperar, %walker1% y %walker2% han estrechado lazos con sus historias de... andar por ahí.}"
    }
    // FILE: mod_legends\hooks\events\events\wildman_causes_havoc_event.nut
    // context: wildman_causes_havoc_event.o.create.::Legends.Screens.hook()._screen.start.Text
    {
        // corrige base: «lanzamiento de excrementos» rebaja «shite throwing»; «está en tu cara» calca «is in your face».
        en = "%townImage%Civilization is no place for a %person_wildman% like %wildman% and %they_wildman% quickly proves it.\n\nApparently, the damned %person_wildman% went crazy while in a shop and trashed the whole place. As the story goes, %they_wildman% just walked in and started taking things, not quite understanding the social norms of paying for goods. The shop owner then came after %them_wildman% with a broom, trying to shoo the %person_wildman% out of his store. Believing the broom a monster, the %person_wildman% proceeded to go completely crazy. Judging by the reports, it was quite the commotion, up to and including shite throwing.\n\nNow the shop owner is in your face demanding compensation for the damage done. Apparently he's wanting %compensation% crowns. Behind him, a few town militia stand with very watchful eyes."
        es = "%townImage%La civilización no es lugar para %un_wildman% salvaje como %wildman%, y no tarda en demostrarlo.\n\nPor lo visto, %art_wildman% maldit%o_wildman% salvaje se volvió loc%o_wildman% en una tienda y destrozó el local entero. Según cuentan, entró sin más y empezó a llevarse cosas, sin entender del todo esa norma social de pagar por los productos. El dueño de la tienda fue entonces tras %el_wildman% con una escoba, intentando echar%lo_wildman% de su tienda. Creyendo que la escoba era un monstruo, %art_wildman% salvaje perdió la cabeza por completo. A juzgar por los informes, se armó una buena, que llegó a incluir el lanzamiento de mierda.\n\nAhora el dueño de la tienda te planta cara exigiendo una compensación por los daños causados. Por lo visto, quiere %compensation% coronas. Detrás de él, unos cuantos milicianos del pueblo observan con mucha atención."
    }
    // context: wildman_causes_havoc_event.o.create.::Legends.Screens.hook()._screen.start.Text
    {
        en = "%townImage%Civilization is no place for a %person_berserker% like %berserker% and %they_berserker% quickly proves it.\n\nApparently, the damned %person_berserker% went crazy while in a shop and trashed the whole place. As the story goes, %they_berserker% just walked in and started taking things, not quite understanding the social norms of paying for goods. The shop owner then came after %them_berserker% with a broom, trying to shoo the %person_berserker% out of his store. Believing the broom a monster, the %person_berserker% proceeded to go completely crazy. Judging by the reports, it was quite the commotion, up to and including shite throwing.\n\nNow the shop owner is in your face demanding compensation for the damage done. Apparently he's wanting %compensation% crowns. Behind him, a few town militia stand with very watchful eyes."
        es = "%townImage%La civilización no es lugar para %un_berserker% berserker como %berserker%, y no tarda en demostrarlo.\n\nPor lo visto, %art_berserker% maldit%o_berserker% berserker se volvió loc%o_berserker% en una tienda y destrozó el local entero. Según cuentan, entró sin más y empezó a llevarse cosas, sin entender del todo esa norma social de pagar por los productos. El dueño de la tienda fue entonces tras %el_berserker% con una escoba, intentando echar%lo_berserker% de su tienda. Creyendo que la escoba era un monstruo, %art_berserker% berserker perdió la cabeza por completo. A juzgar por los informes, se armó una buena, que llegó a incluir el lanzamiento de mierda.\n\nAhora el dueño de la tienda te planta cara exigiendo una compensación por los daños causados. Por lo visto, quiere %compensation% coronas. Detrás de él, unos cuantos milicianos del pueblo observan con mucha atención."
    }
    // en = "This ain't our problem."
    // en base_es
    // en = "Fine, the company will cover the damages - but %wildman% will work it off."
    // en base_es
    // context: wildman_causes_havoc_event.o.create.::Legends.Screens.hook()._screen.start.Options.push().Text
    {
        // corrige base: «se encargará de solucionarlos» no traduce «will work it off» (lo pagará trabajando).
        en = "Fine, the company will cover the damages - but %berserker% will work it off."
        es = "Está bien, la compañía cubrirá los daños, pero %berserker% lo pagará con su trabajo."
    }
    // context: wildman_causes_havoc_event.o.create.::Legends.Screens.hook()._screen.start.Options.push().getResult
    // en = "X"
    // identificador de pantalla
    // en = "Fine, the company will cover the damages."
    // en base_es
    // context: wildman_causes_havoc_event.o.create.::Legends.Screens.hook()._screen.start.Options.push().Text
    {
        en = "Fine, the company will cover the damages. But %trader% will assess compensation."
        es = "Está bien, la compañía cubrirá los daños. Pero %trader% tasará la compensación."
    }
    // context: wildman_causes_havoc_event.o.create.::Legends.Screens.hook()._screen.start.Options.push().getResult
    // en = "T"
    // identificador de pantalla
    // en = "To hell with your shop."
    // en base_es
    // context: wildman_causes_havoc_event.o.create.::Legends.Screens.hook()._screen.start.World.FactionManager.getFaction(_event.m.Town.getFactions()[0]).addPlayerRelation()
    {
        en = "You refused to pay for damages caused by one of your mercenaries"
        es = "Te negaste a pagar los daños causados por uno de tus mercenarios"
    }
    // en = "Charity through destruction?"
    // en base_es
    // context: wildman_causes_havoc_event.o.create.::Legends.Screens.hook()._screen.start.Text
    {
        en = "[img]gfx/ui/events/event_01.png[/img]You go and see the shop. The wild%person_wildman% truly did a number on the place. And it reeks of %their_wildman%... scent. It would be a bad look for the company to not handle this issue with great care. You agree to pay for the damages, something most mercenary bands would not have done. This act of kindness does not slip the townspeople by."
        es = "[img]gfx/ui/events/event_01.png[/img]Vas a ver la tienda. %Art_wildman% salvaje sí que dejó el local hecho un desastre. Y apesta a su... aroma. Daría muy mala imagen que la compañía no tratara este asunto con sumo cuidado. Aceptas pagar los daños, algo que la mayoría de las bandas de mercenarios no habría hecho. Este acto de bondad no pasa desapercibido para la gente del pueblo."
    }
    // context: wildman_causes_havoc_event.o.create.::Legends.Screens.hook()._screen.start.Text
    {
        en = "[img]gfx/ui/events/event_01.png[/img]You go and see the shop. The berserker truly did a number on the place. And it reeks of %their_berserker%... scent. It would be a bad look for the company to not handle this issue with great care. You agree to pay for the damages, something most mercenary bands would not have done. This act of kindness does not slip the townspeople by."
        es = "[img]gfx/ui/events/event_01.png[/img]Vas a ver la tienda. %Art_berserker% berserker sí que dejó el local hecho un desastre. Y apesta a su... aroma. Daría muy mala imagen que la compañía no tratara este asunto con sumo cuidado. Aceptas pagar los daños, algo que la mayoría de las bandas de mercenarios no habría hecho. Este acto de bondad no pasa desapercibido para la gente del pueblo."
    }
    // en = "You spend <v:str_tag> Crowns"
    // en base_es
    // context: wildman_causes_havoc_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        en = "%townImage%Surveying the damage, you agree to compensate the businessman. But this isn't your fault, it's the wild%person_wildman%'s. You dock %their_wildman% pay: for some time to come, the mercenary's earnings will be halved. Furthermore, you take what earnings %they_wildman%'s made and hand them over to the shop owner. It doesn't even begin to cover the damages, but it's a start. One man is left happy, and another quite disgruntled.\n\nYou tell the wild cretin that now %they_wildman%'ll think twice about smearing shit all over someone else's walls. But the wild%person_wildman% doesn't seem to understand you. %They_wildman% just understands that the gold %they_wildman% once owned has been given to someone else, and %they_wildman% eyes its departure with sadness and bottled anger."
        es = "%townImage%Tras examinar los daños, aceptas compensar al comerciante. Pero la culpa no es tuya, sino %del_wildman% salvaje. Le recortas la paga: durante un tiempo, lo que gane %art_wildman% mercenari%o_wildman% se reducirá a la mitad. Además, tomas lo que ha ganado hasta ahora y se lo entregas al dueño de la tienda. No alcanza ni de lejos para cubrir los daños, pero es un comienzo. Uno queda contento, y %art_wildman% otr%o_wildman%, bastante molest%o_wildman%.\n\nLe dices %al_wildman% cretin%o_wildman% salvaje que ahora se lo pensará dos veces antes de embadurnar de mierda las paredes ajenas. Pero %art_wildman% salvaje no parece entenderte. Solo entiende que el oro que antes tenía ha ido a parar a otras manos, y lo ve marcharse con tristeza y una rabia contenida."
    }
    // context: wildman_causes_havoc_event.o.create.::Legends.Screens.hook()._screen.start.World.FactionManager.getFaction(_event.m.Town.getFactions()[0]).addPlayerRelation()
    {
        en = "One of your mercenaries caused havoc in town"
        es = "Uno de tus mercenarios causó estragos en el pueblo"
    }
    // en = "<actor:str> is now paid <n:int> crowns a day"
    // en base_es
    // en = "Got a pay cut"
    // en base_es
    // en = "A shame it had to come to this."
    // en base_es
    // en = "You killed some of the militia"
    // en base_es
    // en = "Fine. I did not wake up this morning looking to slaughter innocents."
    // en base_es
    // en = "The company backed down from a fight"
    // en base_es
    // context: wildman_causes_havoc_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_20.png[/img]Surveying the damage, you agree to compensate the businessman. But this isn't your fault, it's the wildling's. You dock %their_berserker% pay: for some time to come, the mercenary's earnings will be halved. %berserker% doesn't take this information lightly, and as %their_berserker% face starts to contort in anger, you question whether it was good idea to discipline such a volatile brute. %berserker% quickly reaches the limit of %their_berserker% restraint and jumps at you, fists eager to smash your face! You almost faint before rest of %companyname% manages to restrain %berserker%. This time compensation for damage caused by wildlings of %companyname% was paid both with crowns and blood of your men."
        es = "[img]gfx/ui/events/event_20.png[/img]Tras examinar los daños, aceptas compensar al comerciante. Pero la culpa no es tuya, sino de esa bestia salvaje. Le recortas la paga: durante un tiempo, lo que gane %art_berserker% mercenari%o_berserker% se reducirá a la mitad. %berserker% no se toma nada bien la noticia, y mientras su cara empieza a contraerse de ira, te preguntas si ha sido buena idea disciplinar a una bestia tan imprevisible. %berserker% no tarda en llegar al límite de su contención y se abalanza sobre ti, ¡con los puños deseando partirte la cara! Estás a punto de perder el sentido antes de que el resto de %companyname% logre reducir a %berserker%. Esta vez, la compensación por los daños que causan los salvajes de %companyname% se pagó tanto con coronas como con la sangre de tus hombres."
    }
    // context: wildman_causes_havoc_event.o.create.m.Screens.push().Options.Text
    {
        en = "That was not a good idea..."
        es = "No fue buena idea..."
    }
    // en = "<actor:str> is now paid <n:int> crowns a day"
    // en base_es
    // context: wildman_causes_havoc_event.o.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_01.png[/img]%trader% goes and sees the shop. The wildling truly did a number on the place. %trader% demands a list for all caused by %vandal%. The shop owner hands it over... reluctantly. Your trader engages into heated discussion about proper evaluation of compensation for this act of vandalism. Looks like the shop owner wanted to earn extra coins on your account. Numbers on his list were so exaggerated, he could afford three new shops if you paid it. After proper evaluation of necessary compensation by %trader%,  you agree to pay for the damages, something most mercenary bands would not have done. This act of kindness does not slip the townspeople by."
        es = "[img]gfx/ui/events/event_01.png[/img]%trader% va a ver la tienda. El local ha quedado hecho un desastre de verdad. %trader% exige una lista de todo lo que ha causado %vandal%. El dueño de la tienda la entrega... a regañadientes. %trader% se enzarza en una acalorada discusión sobre cómo valorar como es debido la compensación por este acto de vandalismo. Parece que el dueño quería sacarse unas monedas extra a tu costa. Las cifras de su lista estaban tan infladas que, si las pagabas, podría permitirse tres tiendas nuevas. Una vez que %trader% ha valorado como es debido la compensación necesaria, aceptas pagar los daños, algo que la mayoría de las bandas de mercenarios no habría hecho. Este acto de bondad no pasa desapercibido para la gente del pueblo."
    }
    // context: wildman_causes_havoc_event.o.onPrepareVariables._vars.push()
    // en = "trader"  // nombre de variable de onPrepareVariables (clave del token), no se muestra
    // context: wildman_causes_havoc_event.o.onPrepareVariables._vars.push()
    // en = "berserker"  // nombre de variable de onPrepareVariables (clave del token), no se muestra
    // context: wildman_causes_havoc_event.o.onPrepareVariables._vars.push()
    // en = "vandal"  // nombre de variable de onPrepareVariables (clave del token), no se muestra
    // en = "compensation"
    // FILE: mod_legends\hooks\events\events\wildman_finds_something_event.nut
    // context: wildman_finds_something_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_25.png[/img]While trying not to lose your temper at just how many low-hanging branches are catching you in the face, %otherguy% hurries to your side and says %wildman% the wildling has run off. You turn round to see the rest of the company looking as confused as you are. Holding your fist up to quiet the company, the forest returns your order of silence with muted chirps of distant birds and the buzz of a bee or wasp somewhere unseen. Shaking your head, you decide to continue the march.\n\nA few hours later, the wildling jumps out of a bush you were about to cleave with a machete. %wildman% has got an armful of random items in hand. Where these things came from, you've no idea, but you have the mercenaries sift through the findings. %wildman% returns to rank as though nothing happened at all. You glance at the wildling who's staring at their finger where a butterfly has landed. When you glance again, the butterfly is gone and the wildling is swallowing something. %otherguy% gives you a report on what was brought."
        es = "[img]gfx/ui/events/event_25.png[/img]Mientras intentas no perder los nervios por la cantidad de ramas bajas que te dan en la cara, %otherguy% se apresura a tu lado y te dice que %wildman%, salvaje como es, se ha largado. Te das la vuelta y ves al resto de la compañía tan desconcertado como tú. Levantas el puño para que la compañía guarde silencio, y el bosque responde a tu orden con el piar apagado de pájaros lejanos y el zumbido de una abeja o una avispa en algún lugar que no ves. Negando con la cabeza, decides seguir la marcha.\n\nUnas horas más tarde, una figura salvaje sale de un salto de un arbusto que estabas a punto de abrir con el machete. %wildman% trae los brazos cargados de objetos de lo más variopinto. De dónde han salido estas cosas, no tienes ni idea, pero haces que los mercenarios revisen el hallazgo. %wildman% vuelve a su puesto en la fila como si no hubiera pasado nada. Echas un vistazo a %wildman%, que tiene la mirada fija en su dedo, donde se ha posado una mariposa. Cuando vuelves a mirar, la mariposa ha desaparecido y está tragándose algo. %otherguy% te informa de lo que ha traído."
    }
    // context: wildman_finds_something_event.o.create.s.Options[0].Text
    {
        en = "Where did these come from?"
        es = "¿De dónde ha salido todo esto?"
    }
    // FILE: mod_legends\hooks\events\events\wildman_offers_mushrooms_event.nut
    // context: wildman_offers_mushrooms_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_25.png[/img]You take a rest at the base of an enormous tree. Somehow, the sun manages to sear a path through the forest canopy and blind your eyes. Getting up to move, you run into %wildman% the wildling, who is offering you a handful of various questionables: mushrooms, flower petals, berries. With a grunt, they are ushered toward your face."
        es = "[img]gfx/ui/events/event_25.png[/img]Descansas al pie de un árbol enorme. De algún modo, el sol logra abrirse paso a través del dosel del bosque y te ciega. Al levantarte para seguir camino, te topas con %wildman%, salvaje como siempre, que te ofrece un puñado de cosas de lo más dudosas: hongos, pétalos de flores, bayas. Con un gruñido, te las acerca a la cara."
    }
    // context: wildman_offers_mushrooms_event.o.create.s.Text
    {
        // corrige base: normaliza las faltas y tartamudeos deliberados del delirio («teh weeldman fore», «hyyy», «noww braanches», «leenguage», «innn.. innn...», «yer»), que son parte del chiste; «La oscuridad se cierne» por «Blackness comes» y añade puntos suspensivos que el inglés no tiene.
        en = "[img]gfx/ui/events/event_25.png[/img]Surprisingly, the bits of forest foods are actually quite good. Sweet, but not too sweet, and with a hint of oak. You thank teh weeldlung fore the gift, who rises hyyy into the skies, the skies of all things, shaking what are noww braanches you had earlier mistakenly assumed were human arms of humane purposes. Cats rain from his mouth as he speaks. Their tongue is a leenguage of marbled letters, floating before those lips innn.. innn... in great sighs for sentences. Feeling good about their graces, you give a weave, a wave of yer hand, but find yer fingers are also hands, something you had not noticed in the befores. A shock to your beliefs, yer memories of childhood flooded with fleeting feet rocking yer crib, yer domain, yer castle. All lies. All of it! Blackness comes. The darkness smiles.\n\nYou awake on the ground, %otherguy% gently dabbing a rag of water over your forehead.%SPEECH_ON%Boss is back! You alright?%SPEECH_OFF%You can't quite remember what happened, but your mind is desperately telling you not to ask. You simply nod in response and get the company back to marching."
        es = "[img]gfx/ui/events/event_25.png[/img]Sorprendentemente, los trocitos de comida del bosque están bastante buenos. Dulces, pero no demasiado, y con un toque a roble. Le das laz grasias al zalvahe porr el regalo, y se eleva altooo hacia los cielos, los cielos de todas las cosas, agitando lo que ahooora son raamas que antes habías tomado por error por brazos humanos de propósitos humanitarios. De su boca llueven gatos mientras habla. Su lengua es un leenguaje de letras marmoladas que flotan ante esos labios ennn.. ennn... en grandes suspiros a modo de frases. Con el corazón contento por sus gracias, haces un vaivén, un saludo con tuz manos, pero descubres que tuz dedos también son manos, algo en lo que no te habías fijado en los antes. Un golpe a tus creencias, tuz recuerdos de infancia inundados de pies fugaces que mecen tuz cuna, tuz dominio, tuz castillo. Mentiras. ¡Todo! Llega la negrura. La oscuridad sonríe.\n\nDespiertas en el suelo; %otherguy% te pasa con suavidad un trapo mojado por la frente.%SPEECH_ON%¡El jefe ha vuelto! ¿Estás bien?%SPEECH_OFF%No consigues recordar del todo lo que pasó, pero tu mente te pide desesperadamente que no preguntes. Te limitas a asentir y haces que la compañía retome la marcha."
    }
    // FILE: mod_legends\hooks\events\events\wildman_testing_money_event.nut
    // context: wildman_testing_money_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_04.png[/img]You find %wildman% the wildling stacking crowns into towers. %wildman% leans back from these moneyed manifestations with a wide grin, but then suddenly launches forward, knocking the towers over like a child would their blocks. %wildman% laughs maniacally as the coins scatter, seeing someone playing with money like this is a curious sight. Perhaps the wildling has no real conception of what crowns are good for? If so, maybe... maybe you could take them back?"
        es = "[img]gfx/ui/events/event_04.png[/img]Encuentras a %wildman%, la criatura salvaje, apilando coronas en torres. %wildman% se echa hacia atrás para contemplar estas manifestaciones de riqueza con una amplia sonrisa, pero de repente se lanza hacia adelante y derriba las torres como haría un niño con sus bloques. %wildman% ríe de forma maníaca mientras las monedas se dispersan; ver a alguien jugar así con el dinero es un espectáculo curioso. ¿Quizá esa criatura salvaje no tiene una idea real de para qué sirven las coronas? Si es así, quizá... ¿quizá podrías recuperarlas?"
    }
    // context: wildman_testing_money_event.o.create.s.Options[0].Text
    {
        en = "Let's see if %wildman% will trade it all away for something else."
        es = "Veamos si %wildman% lo cambia todo por otra cosa."
    }
    // context: wildman_testing_money_event.o.create.s.Options[1].Text
    {
        en = "Better to leave the wildling crowns alone."
        es = "Mejor dejar en paz las coronas de la criatura salvaje."
    }
    // context: wildman_testing_money_event.o.create.s.Text
    {
        // corrige base: "te mira con desdén" por "te fulmina con la mirada": "glares" es una mirada de enojo, no de desdén.
        // corrige base: "Hola %wildman%" por "Hola, %wildman%": falta la coma del vocativo.
        en = "[img]gfx/ui/events/event_04.png[/img]You crouch down.%SPEECH_ON%Hey there %wildman%. Mind if I take one of these?%SPEECH_OFF%Carefully, you pick up a coin and measure the wildling's reaction. %wildman% shrugs and grunts as if to say 'it's yours'. You take another crown. And then another. The wildling glares at you, but you slowly produce a stick with a frilly bow tied to the top. Its whirly nature captures the wildling's eye. When %wildman% reaches out for it, you draw it back and shake your head. You then point at the crowns, and then at the stick.%SPEECH_ON%One for the other, yes?%SPEECH_OFF%The wildman looks at the crowns, mulling them over like an accountant, but you know their thoughts are far more chaotic than that. Suddenly, %wildman% growls and pushes the crowns forward and takes the stick away from you. Looks like the trade is done."
        es = "[img]gfx/ui/events/event_04.png[/img]Te agachas.%SPEECH_ON%Hola, %wildman%. ¿Te importa si tomo una de estas?%SPEECH_OFF%Con cuidado, recoges una moneda y observas la reacción de la criatura salvaje. %wildman% se encoge de hombros y gruñe como si dijera 'es tuya'. Tomas otra corona. Y luego otra. La criatura salvaje te fulmina con la mirada, pero lentamente sacas un palo con un lazo fruncido atado en la parte superior. Su naturaleza giratoria captura la atención de la criatura. Cuando %wildman% extiende la mano para tomarlo, lo retiras y niegas con la cabeza. Luego señalas las coronas y luego el palo.%SPEECH_ON%¿Una por la otra, sí?%SPEECH_OFF%La criatura salvaje mira las coronas, sopesándolas como un contador, pero sabes que sus pensamientos son mucho más caóticos que eso. De repente, %wildman% gruñe, empuja las coronas hacia adelante y te quita el palo. Parece que el trueque está hecho."
    }
    // context: wildman_testing_money_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_06.png[/img]You crouch down and look at the mess of crowns.%SPEECH_ON%Those are real shiny, huh?%SPEECH_OFF%The wildling grunts and tries to shoo you away. Resisting, you pick up a crown. %wildman%'s hands drop and head jerks up, glaring at you. Slowly, you put the coin down and then produce a stick with a string wrapped around its top. %wildman% stare slackens, the sturdy stick a slick treat to the unkempt wildling. You motion that you'll give it in exchange for the crowns. %wildman% takes the stick. You take the crowns.\n\n But when the wildling plays with the string, it falls off and blows away in the wind. %wildman% cries out, then stares murderously at you, yourself standing there with both arms barreled to try and hold all the crowns. The wildling screams. You drop the crowns and run as fast as you can. There is all manner of chaos going on behind you - tools and weapons being broke, mercenaries running for their lives, and the absolute bedlam of a bunch of confused people beset by a wildling - but you dare not look."
        es = "[img]gfx/ui/events/event_06.png[/img]Te agachas y miras el revoltijo de coronas.%SPEECH_ON%Brillan de verdad, ¿eh?%SPEECH_OFF%La criatura salvaje gruñe e intenta espantarte. Sin hacer caso, tomas una corona. Las manos de %wildman% caen y su cabeza se alza de golpe para fulminarte con la mirada. Despacio, vuelves a dejar la moneda y sacas un palo con un cordel enrollado en la punta. La mirada de %wildman% se afloja: para esa criatura desgreñada, el robusto palo es todo un capricho. Le indicas con gestos que se lo darás a cambio de las coronas. %wildman% toma el palo. Tú tomas las coronas.\n\n Pero cuando la criatura salvaje juega con el cordel, este se suelta y se lo lleva el viento. %wildman% grita y luego te clava una mirada asesina, mientras tú sigues ahí con los brazos en aro, intentando sujetar todas las coronas. La criatura salvaje chilla. Sueltas las coronas y corres tan rápido como puedes. A tus espaldas se desata toda clase de caos: herramientas y armas rotas, mercenarios corriendo para salvar la vida y el alboroto más absoluto de un montón de gente desconcertada a merced de una criatura salvaje. Pero no te atreves a mirar."
    }
    // FILE: mod_legends\hooks\events\events\witch_being_burned_event.nut
    // context: witch_being_burned_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "un cuerpo humeante salir de la estaca" por "desplomarse hacia adelante desde la estaca": "keel forward" es caer hacia adelante, no salir.
        // corrige base: "señala las quemaduras" por "señala a los que arden": "the burnings" son las personas en la hoguera, no heridas por quemadura.
        // corrige base: "morirán con nosotros" por "perecerán a su vez": el inglés no dice "con nosotros", dice que perecerán ellos mismos.
        // corrige base: "No olvidarás este momento pronto" por "en mucho tiempo": calco de "anytime soon" que en castellano no se entiende.
        en = "[img]gfx/ui/events/event_79.png[/img]{You stroll into %townname% just in time to see a smoldering body keel forward from the blackened stake onto which they were tied. A few citizens pass you, cheering the death of a witch. Curious as to whether or not this was true, your very own witchhunter, %witchhunter%, goes to the body and examines it. With a sigh, %they_witchhunter% looks back at you and shakes %their_witchhunter% head. | %townname% welcomes you with horrifying screams. Three of its citizens are in the town center being burned alive. The fires grow beneath them until the flames come licking their feet, then crawling up their legs, drawing them to cry out for mercy to which the crowds responds by throwing rocks.\n\nYou about draw your sword to end this injustice when %witchhunter_short% the witchhunter stays your hand. %They_witchhunter% shakes %their_witchhunter% head and points at the burnings. Soon enough, the begging stops and all three victims open their mouths, issuing forth a rumbling that silences the crowd and even the crackle of fire beneath them. They speak in a guttural, uniform voice.%SPEECH_ON%Ye who watches us perish, shall perish themselves!%SPEECH_OFF%The bodies suddenly slump forward as though instantly made dead and the cooking of their flesh resumes with a steady popping. The witchhunter orders your men to look away, which you quickly do, and behind you comes renewed screams, but this time from the townspeople themselves. You shant forget this moment anytime soon.}"
        es = "[img]gfx/ui/events/event_79.png[/img]{Entras en %townname% justo a tiempo para ver un cuerpo humeante desplomarse hacia adelante desde la estaca ennegrecida a la que estaba atado. Unos cuantos ciudadanos pasan junto a ti, vitoreando la muerte de una bruja. Con curiosidad por saber si esto era cierto o no, %witchhunter%, que en tu propia compañía se dedica a cazar brujas, va hasta el cuerpo y lo examina. Con un suspiro, te mira y niega con la cabeza. | %townname% te recibe con gritos horribles. Tres de sus ciudadanos se encuentran en el centro de la ciudad siendo quemados vivos. Las llamas crecen debajo de ellos hasta que el fuego les lame los pies y luego les trepa por las piernas, haciéndolos gritar pidiendo misericordia, a lo que la multitud responde arrojando piedras.\n\nEstás a punto de desenvainar tu espada para poner fin a esta injusticia cuando %witchhunter_short%, que caza brujas, te detiene la mano. Niega con la cabeza y señala a los que arden. Muy pronto, las súplicas cesan y las tres víctimas abren la boca, emitiendo un estruendo que silencia a la multitud e incluso el crepitar del fuego bajo ellas. Hablan con una voz gutural y uniforme.%SPEECH_ON%¡Quienes nos ven perecer, perecerán a su vez!%SPEECH_OFF%De repente, los cuerpos se desploman hacia adelante como si hubieran muerto en el acto, y la cocción de su carne se reanuda con un chisporroteo constante. Tu especialista en brujas ordena a tus hombres que aparten la mirada, lo que tú haces rápidamente, y detrás de ti se oyen nuevos gritos, pero esta vez de la propia gente del pueblo. No olvidarás este momento en mucho tiempo.}"
    }
    // FILE: mod_legends\hooks\events\events\witchhunter_ghoul_teeth_event.nut
    // context: witchhunter_ghoul_teeth_event.o.create.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: sobra el espacio antes de los dos %SPEECH_ON%, que el inglés no lleva.
        // corrige base: "Anti-veneno" por "Antiveneno": el prefijo va soldado.
        en = "[img]gfx/ui/events/event_05.png[/img]%witchhunter% the witch hunter comes to you with a vial of unknown liquid.%SPEECH_ON%Anti-poison.%SPEECH_OFF%%They_witchhunter% explains. %They_witchhunter% pops the cork off and gives you a smell. There's a strong scent of piss. %They_witchhunter% nods.%SPEECH_ON%Aye, it's wretched, but you need the wretched to fight the wretched, and a goblin's poison is a real wretched matter to contend with. But this will help.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_05.png[/img]%witchhunter%, que caza brujas, se acerca a ti con un vial de un líquido desconocido.%SPEECH_ON%Antiveneno.%SPEECH_OFF%Te lo explica. Saca el corcho y te lo da a oler. Huele fuertemente a orina. Asiente.%SPEECH_ON%Sí, es repugnante, pero hace falta lo repugnante para combatir lo repugnante, y el veneno de un goblin es un asunto de lo más repugnante. Pero esto ayudará.%SPEECH_OFF%"
    }
    // FILE: mod_legends\hooks\events\events\wound_gets_infected_event.nut
    // context: wound_gets_infected_event.o.create.s.Text
    {
        en = "[img]gfx/ui/events/event_34.png[/img]{You discover %woundedbrother% passed out in the grass and there's no mead or ale beside %them_injured% as a sort of coma culprit. Crouching down, you see that %their_injured% eyes are dimmed and %they_injured% does not respond to questions. %Their_injured% chest rises and falls to uneven breathing. You peel back the dressings over %their_injured% %wound% to reveal green, sickly flesh. | %woundedbrother% is laughing with the rest of the men when %they_injured% suddenly falls over with %their_injured% eyes going to the back of %their_injured% head. The rest of the men rush to %their_injured% aid.%SPEECH_ON%Sir, %their_injured% wound's beyond sore.%SPEECH_OFF%The flesh around %their_injured% %wound% has gotten pulpy, slathered with dead skin and the pulsing viridian of infections ready to be sloughed off. | %woundedbrother%'s %wound% has gotten infected. The flesh around the injury is black and that which has color is green, both very bad signs. | Infection is settling into %woundedbrother%'s %wound%. There's no saying if he'll survive or not, but either way %they_injured%'s going to be in bad shape for a time. | You come to find %woundedbrother% leaning against a tree. He's shaking and saliva is dropping from %their_injured% lips.%SPEECH_ON%I'm alright, sir. My %wound%'s just... a little infected. Give me time, I'll get better.%SPEECH_OFF%You purse your lips. Perhaps %they_injured%'ll get better on %their_injured% own, but %they_injured%'ll be hardly in fighting shape if %they_injured% goes without care. | %woundedbrother% is no longer in sound fighting shape. %Their_injured% wounds have gotten infected. Without immediate care, it may take some time for %them_injured% to get back into fighting shape. | %woundedbrother% stumbles into your tent. %They_injured% coughs into the crook of %their_injured% elbow and a stringy bit of saliva trails between it and %their_injured% lips.%SPEECH_ON%Ah shit, sorry sir. I'm uh, I think I'm a little sick.%SPEECH_OFF%Taking a look at %them_injured%, you surmise that %their_injured% wounds have gotten infected. %They_injured% may still be able to fight, but you probably shouldn't risk that until %they_injured% gets better. | While the company eats around a campfire, %woundedbrother% suddenly vomits. You see that there's sweat all over %their_injured% brow and %their_injured% eyes are a bit dazed. %otherbrother% shakes %their_other% head.%SPEECH_ON%Sir, %their_injured% wounds have gotten infected.%SPEECH_OFF%The wounded brother sails back into the grass, arms pawing the air.%SPEECH_ON%I'm fine, ya gits. I'll fight the lot of you.%SPEECH_OFF%%their_injured% balled fists pedal back and forth before %they_injured% slides into a deep sleep. Yeah, %they_injured%'s probably not gonna be battle ready for awhile. | Battles take a toll on men, and sometimes they survive wounds that come back to get them. %woundedbrother% is such a %person_injured% - infection from injuries has spread about %their_injured% body. He's very sick and should not fight unless absolutely necessary. | With each battle, a mercenary risks death. With each injury, %they_injured% risks infection. %woundedbrother% has received the latter and it just may preempt the former. %their_injured% wounds have become black and where they aren't black they are green. He's able to walk, but should probably be kept out of the frontlines until %they_injured% gets better. | A man may survive a battle with terrible wounds, but it only starts another battle against infection. %woundedbrother%'s injuries have gotten worse and may need time to heal. Unless absolutely necessary, %they_injured% should be kept out of the frontlines. | %woundedbrother%'s injuries have gotten worse, possibly infected. Some suggest maggots to help clear out the infection, while others hint at amputations and more drastic measures. As far as you're concerned, you simply need to give it time. That said, the mercenary should probably be kept out of the fights until %they_injured% gets better.}"
        es = "[img]gfx/ui/events/event_34.png[/img]{Descubres a %woundedbrother% desmayad%o_injured% sobre la hierba, y no hay a su lado hidromiel ni cerveza que expliquen semejante sopor. Al agacharte, ves que tiene la mirada apagada y no responde a las preguntas. Su pecho sube y baja con una respiración irregular. Retiras las vendas de su %wound% y descubres una carne verdosa y enfermiza. | %woundedbrother% se está riendo con el resto de los hombres cuando de repente se desploma con los ojos en blanco. Los demás corren a socorrer%lo_injured%.%SPEECH_ON%Señor, esa herida ya no es un simple dolor.%SPEECH_OFF%La carne alrededor de su %wound% se ha vuelto pulposa, cubierta de piel muerta y del verde palpitante de las infecciones a punto de desprenderse. | A %woundedbrother% se le ha infectado su %wound%. La carne alrededor de la lesión está negra, y la que conserva algo de color está verde; ambas, muy malas señales. | La infección está arraigando en su %wound%. No hay forma de saber si %woundedbrother% sobrevivirá o no, pero en cualquier caso va a estar en mal estado durante un tiempo. | Encuentras a %woundedbrother% apoyad%o_injured% contra un árbol. Está temblando y le cae saliva de los labios.%SPEECH_ON%Estoy bien, señor. Es solo que mi %wound% se ha... infectado un poco. Dame tiempo y me pondré mejor.%SPEECH_OFF%Aprietas los labios. Quizá se recupere por sí mism%o_injured%, pero difícilmente estará en condiciones de luchar si no recibe cuidados. | %woundedbrother% ya no está en condiciones de luchar. Sus heridas se han infectado. Sin cuidados inmediatos, puede que tarde un tiempo en volver a estar en forma para el combate. | %woundedbrother% entra tambaleándose en tu tienda. Tose en el pliegue del codo y un hilillo de saliva queda colgando entre este y sus labios.%SPEECH_ON%Ah, mierda, perdón, señor. Creo que estoy, eh... un poco enferm%o_injured%.%SPEECH_OFF%Al examinar%lo_injured%, deduces que sus heridas se han infectado. Puede que aún sea capaz de luchar, pero probablemente no deberías arriesgarte hasta que mejore. | Mientras la compañía come alrededor de una fogata, %woundedbrother% vomita de repente. Ves que tiene la frente empapada de sudor y los ojos algo aturdidos. %otherbrother% niega con la cabeza.%SPEECH_ON%Señor, sus heridas se han infectado.%SPEECH_OFF%%Art_injured% herid%o_injured% se deja caer de espaldas sobre la hierba, manoteando el aire.%SPEECH_ON%Estoy bien, imbéciles. Puedo con todos ustedes.%SPEECH_OFF%Sus puños cerrados pedalean adelante y atrás antes de que caiga en un sueño profundo. Sí, probablemente no estará list%o_injured% para la batalla en un buen tiempo. | Las batallas pasan factura a los hombres, y a veces sobreviven a heridas que luego regresan para atormentarlos. %woundedbrother% es %un_injured% %hombre_injured% así: la infección de sus heridas se ha extendido por todo su cuerpo. Está muy enferm%o_injured% y no debería luchar a menos que sea absolutamente necesario. | Con cada batalla, un mercenario arriesga la muerte. Con cada herida, arriesga una infección. %woundedbrother% ha sufrido lo segundo, y puede que eso se adelante a lo primero. Sus heridas se han vuelto negras, y donde no están negras están verdes. Puede caminar, pero probablemente convenga mantener%lo_injured% fuera de primera línea hasta que mejore. | Un hombre puede sobrevivir a una batalla con heridas terribles, pero eso solo da comienzo a otra batalla contra la infección. Las heridas de %woundedbrother% han empeorado y puede que necesiten tiempo para sanar. A menos que sea absolutamente necesario, habría que mantener%lo_injured% fuera de primera línea. | Las heridas de %woundedbrother% han empeorado; puede que se hayan infectado. Algunos sugieren gusanos para ayudar a limpiar la infección, mientras que otros insinúan amputaciones y medidas más drásticas. Por lo que a ti respecta, simplemente hay que darle tiempo. Dicho esto, probablemente convenga mantener %al_injured% mercenari%o_injured% fuera de los combates hasta que mejore.}"
    }
    // FILE: mod_legends\hooks\events\events\wound_heals_event.nut
    // context: wound_heals_event.o.create.s.start.Text
    {
        // corrige base: "Las heridas aparentemente han sanado" por "Por lo visto, las heridas han sanado": "apparently" aquí es "por lo visto", no "aparentemente".
        // corrige base: "va ser que mi madre" por "va a ser que mi madre": errata, falta la preposición.
        // corrige base: sobra el espacio tras %SPEECH_OFF% en "%SPEECH_OFF% La lesión" y "%SPEECH_OFF% Preguntas".
        en = "[img]gfx/ui/events/event_34.png[/img]{You go to check on %hurtbrother% - they'd suffered a terrible wound not long ago and sometimes it can lift a someone's spirits just to know others care. Thinking you'll find the mercenary nursing injuries, you instead are surprised to see %hurtbrother% in good health. The wounds have apparently healed in such speedy fashion that others might call it a miracle. | %hurtbrother% was injured in battle and you figure it'd be best to go see how they are doing. Surprisingly, they're doing quite well. Wounds have healed in such quick fashion you almost want to believe some dark arts must have been consulted while no one was looking. There are no signs of black magics around, just one sturdy and hard to kill mercenary of flesh and blood. | %hurtbrother% enters your tent and flashes the wound - or what's left of it. The garish thing has seemingly healed entirely. The mercenary looks at you with a giddy smile.%SPEECH_ON%They'll have to try harder to take me out of this world, captain.%SPEECH_OFF% | %hurtbrother% comes into your tent and shows off an old wound, speaking excitedly.%SPEECH_ON%Is that a miracle or what?%SPEECH_OFF%The injury has healed almost completely. You say the mercenary is made of hardier things and the gods had nothing to do with it. %hurtbrother%'s head shakes at you.%SPEECH_ON%You need to have more faith.%SPEECH_OFF% | You go looking for %hurtbrother% - the mercenary had taken quite the injury last you saw. The mercenary, however, is in high spirits. Turning to you, taking a break from sharpening some steel.%SPEECH_ON%Need something, sir?%SPEECH_OFF%You inquire about the injury and are greeted with a shrug.%SPEECH_ON%I don't die easy. {I ate a lot of them pointy orange things when I was young. | I ate a lot of lettuce growing up. One might say I'm hard to... kale.}%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_34.png[/img]{Vas a ver cómo está %hurtbrother%, que sufrió una herida terrible no hace mucho, y a veces basta con saber que a otros les importa para levantarle el ánimo a alguien. Esperas encontrar a %hurtbrother% curándose las heridas, pero te sorprende descubrir que goza de buena salud. Por lo visto, las heridas han sanado tan deprisa que otros lo llamarían un milagro. | %hurtbrother% sufrió heridas en la batalla y crees que lo mejor sería ir a ver cómo está. Sorprendentemente, está bastante bien. Las heridas han sanado tan deprisa que casi quieres creer que alguien recurrió a las artes oscuras cuando nadie miraba. No hay rastro de magia negra por ninguna parte, solo una persona de carne y hueso, recia y difícil de matar. | %hurtbrother% entra en tu tienda y te enseña la herida, o lo que queda de ella. Esa cosa espantosa parece haber sanado por completo. Te mira con una sonrisa eufórica.%SPEECH_ON%Tendrán que esforzarse más para sacarme de este mundo, capitán.%SPEECH_OFF% | %hurtbrother% entra en tu tienda y enseña una herida antigua, hablando con entusiasmo.%SPEECH_ON%¿Esto es un milagro o qué?%SPEECH_OFF%La lesión ha sanado casi por completo. Le dices que es de una madera más resistente y que los dioses no tuvieron nada que ver. %hurtbrother% niega con la cabeza.%SPEECH_ON%Tienes que tener más fe.%SPEECH_OFF% | Vas en busca de %hurtbrother%, que tenía una herida bastante seria la última vez que se vieron. Sin embargo, está de muy buen humor y se vuelve hacia ti, dejando un momento de afilar un arma.%SPEECH_ON%¿Necesitas algo, señor?%SPEECH_OFF%Preguntas por la herida y recibes un encogimiento de hombros por respuesta.%SPEECH_ON%No muero fácilmente. {Comí muchas de esas cosas puntiagudas y naranjas cuando era joven. | Comí mucha lechuga en mi infancia. Al final va a ser que mi madre tenía razón al hacerme comer verduras.}%SPEECH_OFF%}"
    }
    // context: wound_heals_event.o.create.s.start.Text
    {
        // corrige base: "Las heridas aparentemente han sanado" por "Por lo visto, las heridas han sanado": "apparently" aquí es "por lo visto", no "aparentemente".
        // corrige base: "va ser que mi madre" por "va a ser que mi madre": errata, falta la preposición.
        // corrige base: sobra el espacio tras %SPEECH_OFF% en "%SPEECH_OFF% La lesión" y "%SPEECH_OFF% Preguntas".
        en = "[img]gfx/ui/events/event_34.png[/img]{You go to check on %hurtbrother% - they'd suffered a terrible wound not long ago and sometimes it can lift a someone's spirits just to know others care. Thinking you'll find the mercenary nursing injuries, you instead are surprised to see %hurtbrother% in good health. The wounds have apparently healed in such speedy fashion that others might call it a miracle. | %hurtbrother% was injured in battle and you figure it'd be best to go see how they are doing. Surprisingly, they're doing quite well. Wounds have healed in such quick fashion you almost want to believe some dark arts must have been consulted while no one was looking. There are no signs of black magics around, just one sturdy and hard to kill mercenary of flesh and blood. | %hurtbrother% enters your tent and flashes the wound - or what's left of it. The garish thing has seemingly healed entirely. The mercenary looks at you with a giddy smile.%SPEECH_ON%They'll have to try harder to take me out of this world, captain.%SPEECH_OFF% | %hurtbrother% comes into your tent and shows off an old wound, speaking excitedly.%SPEECH_ON%Is that a miracle or what?%SPEECH_OFF%The injury has healed almost completely. You say the mercenary is made of hardier things and the gods had nothing to do with it. Nodding, the reply comes.%SPEECH_ON%Yeah, I know. But it'd be nice if they were looking out for me, too. Just in case...%SPEECH_OFF% | You go looking for %hurtbrother% - the mercenary had taken quite the injury last you saw. The mercenary, however, is in high spirits. Turning to you, taking a break from sharpening some steel.%SPEECH_ON%Need something, sir?%SPEECH_OFF%You inquire about the injury and are greeted with a shrug.%SPEECH_ON%I don't die easy. {I ate a lot of them pointy orange things when I was young. | I ate a lot of lettuce growing up. One might say I'm hard to... kale.}%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_34.png[/img]{Vas a ver cómo está %hurtbrother%, que sufrió una herida terrible no hace mucho, y a veces basta con saber que a otros les importa para levantarle el ánimo a alguien. Esperas encontrar a %hurtbrother% curándose las heridas, pero te sorprende descubrir que goza de buena salud. Por lo visto, las heridas han sanado tan deprisa que otros lo llamarían un milagro. | %hurtbrother% sufrió heridas en la batalla y crees que lo mejor sería ir a ver cómo está. Sorprendentemente, está bastante bien. Las heridas han sanado tan deprisa que casi quieres creer que alguien recurrió a las artes oscuras cuando nadie miraba. No hay rastro de magia negra por ninguna parte, solo una persona de carne y hueso, recia y difícil de matar. | %hurtbrother% entra en tu tienda y te enseña la herida, o lo que queda de ella. Esa cosa espantosa parece haber sanado por completo. Te mira con una sonrisa eufórica.%SPEECH_ON%Tendrán que esforzarse más para sacarme de este mundo, capitán.%SPEECH_OFF% | %hurtbrother% entra en tu tienda y enseña una herida antigua, hablando con entusiasmo.%SPEECH_ON%¿Esto es un milagro o qué?%SPEECH_OFF%La lesión ha sanado casi por completo. Le dices que es de una madera más resistente y que los dioses no tuvieron nada que ver. Asiente y responde.%SPEECH_ON%Sí, lo sé. Pero estaría bien que ellos también cuidaran de mí. Por si acaso...%SPEECH_OFF% | Vas en busca de %hurtbrother%, que tenía una herida bastante seria la última vez que se vieron. Sin embargo, está de muy buen humor y se vuelve hacia ti, dejando un momento de afilar un arma.%SPEECH_ON%¿Necesitas algo, señor?%SPEECH_OFF%Preguntas por la herida y recibes un encogimiento de hombros por respuesta.%SPEECH_ON%No muero fácilmente. {Comí muchas de esas cosas puntiagudas y naranjas cuando era joven. | Comí mucha lechuga en mi infancia. Al final va a ser que mi madre tenía razón al hacerme comer verduras.}%SPEECH_OFF%}"
    }
