    // FILE: scripts\entity\world\camp\buildings\commander_building.nut
    // context: commander_building.create.m.Name
    {
        en = "Commanders Tent"
        es = "Tienda del comandante"
    }
    // context: commander_building.create.m.Description
    {
        en = "Assign company members to different tasks while encamped"
        es = "Asigna distintas tareas a los miembros de la compañía mientras acampan"
    }
    // context: commander_building.getLevel
    // en = "full"  // nivel interno del edificio (getLevel), no se muestra
    // context: commander_building.getDescription
    {
        // @composicion: desc += ... (8 trozos).
        // La suma llega entera a Rosetta; los trozos de abajo no llegan nunca solos.
        en = "The camp system allows your company to be more self sufficient while out on campaign. Injuries treated, equipment repaired, tools salvaged from old equipment, hunt for food, gather medicine, training, crafting, restock ammo supplies... Inside the commanders, each brother can be assigned to a tent to perform the task. Need food? Assign a couple brothers to hunt. Need more ammo, assign to fletchers tent. In general, the currency of camping is time. It requires time to perform all the actions. The more brothers assigned to the task, the less time it'll take to perform it.While all backgrounds can perform any task, some backgrounds are more suited to the task. Hunters will be better at hunting than the tailors.\n\nCompany starts out only knowing how to do repairs and rest. Visiting settlements that perform the analogous task will unlock it in the camp. All camp activities can be upgraded by purchasing an upgraded tent variant from a settlement marketplace. Upgraded tents increase performance and many come with significant bonuses."
        es = "El sistema de campamento permite que tu compañía sea más autosuficiente durante la campaña. Tratar heridas, reparar equipo, recuperar herramientas del equipo viejo, cazar para conseguir comida, recolectar medicina, entrenar, fabricar, reponer munición... En la tienda del comandante puedes asignar a cada hermano a una tienda para que realice su tarea. ¿Necesitas comida? Asigna a un par de hermanos a la caza. ¿Necesitas más munición? Asígnalos a la tienda del flechero. En general, la moneda del campamento es el tiempo. Todas las acciones requieren tiempo. Cuantos más hermanos haya asignados a una tarea, menos tiempo llevará realizarla. Aunque cualquier trasfondo puede realizar cualquier tarea, algunos se adaptan mejor a ciertas tareas. Los cazadores cazarán mejor que los sastres.\n\nAl principio, la compañía solo sabe reparar y descansar. Visitar asentamientos que realicen la tarea equivalente la desbloqueará en el campamento. Todas las actividades del campamento pueden mejorarse comprando una versión mejorada de la tienda en el mercado de un asentamiento. Las tiendas mejoradas aumentan el rendimiento y muchas ofrecen bonificaciones considerables."
    }
    // context: commander_building.getDescription
    {
        en = "The camp system allows your company to be more self sufficient while out on campaign. "
        es = "El sistema de campamento permite que tu compañía sea más autosuficiente durante la campaña. "
    }
    // context: commander_building.getDescription
    {
        en = "Injuries treated, equipment repaired, tools salvaged from old equipment, hunt for food, gather medicine, training, crafting, restock ammo supplies... "
        es = "Tratar heridas, reparar equipo, recuperar herramientas del equipo viejo, cazar para conseguir comida, recolectar medicina, entrenar, fabricar, reponer munición... "
    }
    // context: commander_building.getDescription
    {
        en = "Inside the commanders, each brother can be assigned to a tent to perform the task. Need food? Assign a couple brothers to hunt. Need more ammo, assign to fletchers tent. "
        es = "En la tienda del comandante puedes asignar a cada hermano a una tienda para que realice su tarea. ¿Necesitas comida? Asigna a un par de hermanos a la caza. ¿Necesitas más munición? Asígnalos a la tienda del flechero. "
    }
    // context: commander_building.getDescription
    {
        en = "In general, the currency of camping is time. It requires time to perform all the actions. The more brothers assigned to the task, the less time it'll take to perform it."
        es = "En general, la moneda del campamento es el tiempo. Todas las acciones requieren tiempo. Cuantos más hermanos haya asignados a una tarea, menos tiempo llevará realizarla."
    }
    // context: commander_building.getDescription
    {
        en = "While all backgrounds can perform any task, some backgrounds are more suited to the task. Hunters will be better at hunting than the tailors."
        es = "Aunque cualquier trasfondo puede realizar cualquier tarea, algunos se adaptan mejor a ciertas tareas. Los cazadores cazarán mejor que los sastres."
    }
    // context: commander_building.getDescription
    {
        en = "Company starts out only knowing how to do repairs and rest. Visiting settlements that perform the analogous task will unlock it in the camp. All camp activities can be upgraded "
        es = "Al principio, la compañía solo sabe reparar y descansar. Visitar asentamientos que realicen la tarea equivalente la desbloqueará en el campamento. Todas las actividades del campamento pueden mejorarse "
    }
    // context: commander_building.getDescription
    {
        en = "by purchasing an upgraded tent variant from a settlement marketplace. Upgraded tents increase performance and many come with significant bonuses."
        es = "comprando una versión mejorada de la tienda en el mercado de un asentamiento. Las tiendas mejoradas aumentan el rendimiento y muchas ofrecen bonificaciones considerables."
    }
    // FILE: scripts\entity\world\camp\buildings\crafting_building.nut
    // context: crafting_building.create.m.Slot
    // en = "craft"  // identificador de ranura del edificio (m.Slot), no se muestra
    // context: crafting_building.create.m.Description
    {
        en = "Craft items"
        es = "Fabrica objetos"
    }
    // context: crafting_building.getTitle
    {
        // return this.m.Name + " *Upgraded*";
        mode = "pattern"
        en = "<name:str> *Upgraded*"
        es = "<name:t> *Con mejora*"
    }
    // context: crafting_building.getTitle
    {
        // return this.m.Name +  " *Not Upgraded*";
        mode = "pattern"
        en = "<name:str> *Not Upgraded*"
        es = "<name:t> *Sin mejora*"
    }
    // context: crafting_building.getDescription
    {
        // @composicion: desc += ... (5 trozos).
        // La suma llega entera a Rosetta; los trozos de abajo no llegan nunca solos.
        en = "Come here to craft potions, trophies and other useful items. Recipes added to the crafting queue will be worked on by anyone assigned to this tent. Crafting only occurs while encamped. Progress is saved, so items do not have to be crafted in a single session. The more people assigned to the tent, the quicker items will be crafted.\n\nThe crafting tent can be upgraded by purchasing a crafting cart from a settlement merchant. An upgraded tent has a 15% increase in crafting speed."
        es = "Ven aquí para fabricar pociones, trofeos y otros objetos útiles. En las recetas que se añadan a la cola de fabricación trabajará cualquiera que esté asignado a esta tienda. Solo se fabrica mientras la compañía está acampada. El progreso se guarda, así que los objetos no tienen que fabricarse en una sola sesión. Cuanta más gente haya asignada a la tienda, más rápido se fabricarán los objetos.\n\nLa tienda de fabricación puede mejorarse comprando un carro de fabricación a un mercader de un asentamiento. Una tienda mejorada fabrica un 15% más rápido."
    }
    // context: crafting_building.getDescription
    {
        en = "Come here to craft potions, trophies and other useful items. Recipes added to the crafting queue will be worked on by anyone "
        es = "Ven aquí para fabricar pociones, trofeos y otros objetos útiles. En las recetas que se añadan a la cola de fabricación trabajará cualquiera que esté "
    }
    // context: crafting_building.getDescription
    {
        en = "assigned to this tent. Crafting only occurs while encamped. Progress is saved, so items do not have to be crafted in "
        es = "asignado a esta tienda. Solo se fabrica mientras la compañía está acampada. El progreso se guarda, así que los objetos no tienen que fabricarse en "
    }
    // context: crafting_building.getDescription
    {
        en = "a single session. The more people assigned to the tent, the quicker items will be crafted."
        es = "una sola sesión. Cuanta más gente haya asignada a la tienda, más rápido se fabricarán los objetos."
    }
    // context: crafting_building.getDescription
    {
        en = "The crafting tent can be upgraded by purchasing a crafting cart from a settlement merchant. An upgraded tent has a 15% increase in crafting speed."
        es = "La tienda de fabricación puede mejorarse comprando un carro de fabricación a un mercader de un asentamiento. Una tienda mejorada fabrica un 15% más rápido."
    }
    // context: crafting_building.getModifierToolip.ret.text
    {
        // text = "There are [color=%positive%]" + this.m.Queue.len() + "[/color] items in the crafting queue."
        mode = "pattern"
        en = "There are [color=%positive%]<count:int>[/color] items in the crafting queue."
        es = "Hay [color=%positive%]<count>[/color] objetos en la cola de fabricación."
    }
    // context: crafting_building.getModifierToolip.ret.text
    {
        // text = "It will take [color=%positive%]" + this.getRequiredTime() + "[/color] hours to craft all items."
        mode = "pattern"
        en = "It will take [color=%positive%]<hours:str>[/color] hours to craft all items."
        es = "Se tardarán [color=%positive%]<hours>[/color] horas en fabricar todos los objetos."
    }
    // context: crafting_building.getModifierToolip.ret.text
    {
        // text = "Total crafting modifier is [color=%positive%]" + mod.Craft + "[/color] units per hour."
        mode = "pattern"
        en = "Total crafting modifier is [color=%positive%]<rate:str>[/color] units per hour."
        es = "El modificador total de fabricación es de [color=%positive%]<rate>[/color] unidades por hora."
    }
    // context: crafting_building.getModifierToolip.ret.push().text
    {
        // text = "[color=%positive%]" + bro[0] + "[/color] units/hour " + bro[1] + " (" + bro[2] + ")"
        mode = "pattern"
        en = "[color=%positive%]<rate:str>[/color] units/hour <name:str> (<bg:str>)"
        es = "[color=%positive%]<rate>[/color] unidades/hora <name> (<bg>)"
    }
    // en = "dude"
    // context: crafting_building.getLevel.pro
    // en = "tent"  // nivel interno del edificio (getLevel), no se muestra
    // context: crafting_building.getLevel.sub
    // en = "empty"  // nivel interno del edificio (getLevel), no se muestra
    // context: crafting_building.getResults.res.push().text
    {
        // text = "Crafting completed: " + b.getName()
        mode = "pattern"
        en = "Crafting completed: <item:str>"
        es = "Fabricación completada: <item>"
    }
    // context: crafting_building.getUpdateText
