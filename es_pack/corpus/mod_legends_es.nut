    }
    // context: legend_parrying_dagger.getTooltip.result.insert().text
    {
        // text = "Damage of [color=%damage%]" + this.m.RegularDamage + "[/color] - [color=%damage%]" + this.m.RegularDamageMax + "[/color]"
        mode = "pattern"
        en = "Damage of [color=%damage%]<this.m.RegularDamage>[/color] - [color=%damage%]<this.m.RegularDamageMax>[/color]"
        es = ""
    }
    // context: legend_parrying_dagger.getTooltip.result.insert().text
    {
        // text = "[color=%damage%]" + this.Math.floor((this.m.DirectDamageMult + this.m.DirectDamageAdd) * 100) + "%[/color] of damage ignores armor"
        mode = "pattern"
        en = "[color=%damage%]<this.Math.floor(this.m.DirectDamageMult + this.m.DirectDamageAdd*100)>%[/color] of damage ignores armor"
        es = ""
    }
    // context: legend_parrying_dagger.getTooltip.result.insert().text
