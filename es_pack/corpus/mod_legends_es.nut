    // FILE: scripts\skills\actives\legend_en_garde_skill.nut
    // context: legend_en_garde_skill.create.m.Description
    {
        en = "Block your enemy's weapons in a way that leaves them open to counter attack. Applies the Vulnerable effect to an enemy, lowering their melee and ranged defenses by 10."
        es = "Bloquea las armas de tu enemigo de manera que quede expuesto a un contraataque. Aplica el efecto Vulnerable a un enemigo, lo que reduce en [color=#8f1e1e]10[/color] su defensa cuerpo a cuerpo y a distancia."
    }
    // context: legend_en_garde_skill.getTooltip.ret.push().text
    {
        en = "On successful Parry, inflicts [color=%negative%]Vulnerable[/color] ([color=%damage%]-10[/color] melee and ranged defense)"
        es = "Si logra contrarrestar, inflige [color=%negative%]Vulnerable[/color] ([color=%damage%]-10[/color] a la defensa cuerpo a cuerpo y a distancia)"
    }
    // context: legend_en_garde_skill.getTooltip.ret.push().text
    {
        en = "Has a [color=%positive%]100%[/color] chance to Parry on a hit thanks to Dagger Mastery. Enemies who are immune to being disarmed cannot be Parried"
        es = "Tiene un [color=%positive%]100%[/color] de probabilidad de contrarrestar al acertar gracias al Dominio de la Daga. Los enemigos inmunes al desarme no pueden ser contrarrestados"
    }
    // context: legend_en_garde_skill.getTooltip.ret.push().text
    {
        // text = "Has a [color=%positive%]" + this.m.StunChance + "%[/color] chance to Parry on a hit due to not having Dagger Mastery. Enemies who are immune to being disarmed cannot be Parried"
        mode = "pattern"
        en = "Has a [color=%positive%]<chance:int>%[/color] chance to Parry on a hit due to not having Dagger Mastery. Enemies who are immune to being disarmed cannot be Parried"
        es = "Tiene un [color=%positive%]<chance>%[/color] de probabilidad de contrarrestar al acertar por no tener Dominio de la Daga. Los enemigos inmunes al desarme no pueden ser contrarrestados"
    }
    // context: legend_en_garde_skill.onUse.Tactical.EventLog.log()
