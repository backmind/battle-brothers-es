    // FILE: scripts\skills\effects\legend_flourish_effect.nut
    // context: legend_flourish_effect.getDescription
    {
        en = "This character is prepared to do exhausting and flashy moves which will both scare the opponent and penetrate their defenses in a display of remarkable swordsmanship."
        es = "Este personaje está preparado para ejecutar movimientos agotadores y vistosos que asustarán al oponente y atravesarán sus defensas en una muestra de notable esgrima."
    }
    // context: legend_flourish_effect.onBeforeTargetHit.Tactical.EventLog.logEx()
