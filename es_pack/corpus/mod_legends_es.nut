        en = "A large rusty patch of mail that can be added to any armor to protect the arms and the shoulders."
        es = "Un gran parche de malla oxidada que se puede agregar a cualquier armadura para proteger los brazos y los hombros."
    }
    // context: legend_armor_rusted_mail_patch_upgrade.create.m.ArmorDescription
    {
        en = "Includes a large rusty patch of mail worn on the shoulders."
        es = "Incluye un gran parche de malla oxidada que se lleva sobre los hombros."
    }
    // FILE: scripts\items\legend_armor\armor_upgrades\legend_armor_sacred_shield_upgrade.nut
    // context: legend_armor_sacred_shield_upgrade.create.m.Name
    {
        en = "Sacred Shield"
        es = "Escudo sagrado"
    }
    // context: legend_armor_sacred_shield_upgrade.create.m.Description
    {
        en = "A holy relic shield to be strapped to the shoulder, it protects the wearer both physically and spiritually. Primarily of benefit to the strong of mind."
        es = "Un escudo que es una reliquia sagrada y se sujeta al hombro; protege a su portador tanto en lo físico como en lo espiritual. Beneficia sobre todo a los de mente fuerte."
    }
    // context: legend_armor_sacred_shield_upgrade.create.m.ArmorDescription
    {
        en = "Includes a holy relic shield."
        es = "Incluye un escudo que es una reliquia sagrada."
    }
    // context: legend_armor_sacred_shield_upgrade.updateTooltip._tooltip.push().text
