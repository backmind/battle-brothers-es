        es = "[color=%positive%]+2[/color] de Defensa cuerpo a cuerpo."
    }
    // FILE: scripts\items\accessory\legend_apothecary_mushrooms_item.nut
    // context: legend_apothecary_mushrooms_item.create.m.Name
    {
        en = "Apothecary Mushrooms"
        es = "Hongos del boticario"
    }
    // context: legend_apothecary_mushrooms_item.create.m.Description
    {
        // corrige base: «hacen que cualquiera los mastique entre... no sienten... exhiben» es agramatical (falta el relativo y no concuerda el número): «hacen que quien los mastique entre... no siente... muestra»; «agresión» → «agresividad» (rasgo, no acto).
        en = "Strange mushrooms that have anyone chewing them enter a trance-like state where they don't feel any pain and exhibit significantly decreased aggression. May result in sickness. Eat responsibly."
        es = "Hongos extraños que hacen que quien los mastique entre en un estado parecido a un trance en el que no siente ningún dolor y muestra una agresividad mucho menor. Pueden provocar enfermedad. Consúmase con responsabilidad."
    }
    // FILE: scripts\items\accessory\legend_armored_sighthound_item.nut
    // context: legend_armored_sighthound_item.create.m.Description
    {
        // corrige base: sobra «aunque es un poco más lento que sus hermanos del sur más ágiles», que el inglés no tiene; falta «routing» (enemigos en desbandada); «unleashed» es «soltar», no «utilizar».
        en = "A strong and loyal southern hound bred for war. Can be unleashed in battle for scouting, tracking or running down routing enemies. This one wears a leather coat for protection against cutting wounds."
        es = "Un sabueso del sur fuerte y leal criado para la guerra. Se puede soltar en la batalla para explorar, rastrear o perseguir a los enemigos en desbandada. Este lleva un abrigo de cuero para protegerse de las heridas cortantes."
    }
