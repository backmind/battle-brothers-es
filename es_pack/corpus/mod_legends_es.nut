    // en base_es
    // en = "\x7bYou'll get | You are to receive | You'll be paid | It's\x7d %reward_count% crowns per head you arrive with, \x7bfor up to %maxcount% heads | and I'll pay for up to %maxcount% heads | %maxcount% heads at most\x7d.%SPEECH_OFF%"
    // en base_es
    // en = "\x7bYou'll get | You are to receive | You'll be paid | It's\x7d %reward_advance% crowns in advance, and another %reward_count% crowns per head you arrive with, \x7bfor up to %maxcount% heads | and I'll pay for up to %maxcount% heads | %maxcount% heads at most\x7d.%SPEECH_OFF%"
    // en base_es
    // en = "\x7bYou'll get | You are to receive | You'll be paid | It's\x7d %reward_count% crowns per head you arrive with, \x7bfor up to %maxcount% heads | and I'll pay for up to %maxcount% heads | %maxcount% heads at most\x7d, and another %reward_completion% when the job is done.%SPEECH_OFF%"
    // en base_es
