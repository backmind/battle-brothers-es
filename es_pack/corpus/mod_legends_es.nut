    // en = "You can only have one contract active at a time. Contract offers will remain while you fulfill your current contract, as long as the problem doesn't go away in the meantime."
    // en base_es
    // en = "Contracts locked"
    // en base_es
    // en = "Only contracts by the noble house owning this fortification are available here, but they don't recognize you as worthy of their attention. Increase your renown and fulfill the ambition of noble houses to take notice of the company in order to unlock new contracts!"
    // en base_es
    // en = "Hire"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Hire new mercenaries for your company. The quality and quantity of volunteers depends on the size and type of settlement, as well as your reputation here. Every few days, new people will arrive, and others will travel on."
        es = "Contrata nuevos mercenarios para tu compañía. La calidad y la cantidad de voluntarios dependen del tamaño y el tipo de asentamiento, así como de tu reputación aquí. Cada pocos días llega gente nueva y otros siguen su camino."
    }
    // en = "Tavern"
    // en base_es
    // en = "A large tavern filled with patrons from all over the lands, offering beverages, food and a lively atmosphere in which to share news and rumors."
    // en base_es
    // en = "A refuge from the harsh world outside. You can seek healing here for your wounded and pray for salvation of your eternal soul."
    // en base_es
    // en = "Training Hall"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "A meeting point for those of the fighting profession. Have your mercenaries train with and learn from experienced fighters here, so you can mold them faster into hardened mercenaries."
        es = "Un punto de encuentro para los profesionales de la lucha. Haz que tus mercenarios entrenen y aprendan de luchadores experimentados aquí, para que puedas convertirlos más rápido en mercenarios endurecidos."
    }
    // en = "Taxidermist"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "For the right price, a taxidermist can create useful items from all kinds of trophies you bring them."
        es = "Por el precio justo, un taxidermista puede crear objetos útiles a partir de todo tipo de trofeos que le lleves."
    }
    // en = "Kennel"
    // en base_es
    // en = "A kennel where strong and fast dogs are bred for war."
    // en base_es
    // en = "Barber"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        // corrige base: «Córtate el pelo, recorta la barba» se dirige al jugador; el inglés habla del pelo y la barba de los hombres ("Have their hair cut and their beards trimmed").
        en = "Customize the appearance of your mercenaries at the barber. Have their hair cut and their beards trimmed or buy dubious potions to change their appearance."
        es = "Personaliza la apariencia de tus mercenarios en la barbería. Haz que les corten el pelo y les recorten la barba, o compra dudosas pociones para cambiar su apariencia."
    }
    // en = "A fletcher offering all kinds of expertly crafted ranged weaponry."
    // en base_es
    // en = "Alchemist"
    // en base_es
    // en = "An alchemist offering exotic and quite dangerous contraptions for a tidy sum."
    // en base_es
