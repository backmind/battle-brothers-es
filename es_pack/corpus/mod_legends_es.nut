        es = "Hasta un [color=%positive%]+50%[/color] de probabilidad de acierto, que aumenta según la fatiga del objetivo y alcanza el máximo si el objetivo está agotado."
    }
    // context: puncture.o.getTooltip.tooltip.extend().text
