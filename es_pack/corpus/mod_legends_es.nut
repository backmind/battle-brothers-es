        es = "[color=%negative%]-10%[/color] de Habilidad a distancia"
    }
    // context: addict_trait.o.getTooltip.ret.push().text
    {
        en = "[color=%negative%]-10%[/color] Melee Defense"
        es = "[color=%negative%]-10%[/color] de Defensa cuerpo a cuerpo"
    }
    // context: addict_trait.o.getTooltip.ret.push().text
    {
        en = "[color=%negative%]-10%[/color] Ranged Defense"
        es = "[color=%negative%]-10%[/color] de Defensa a distancia"
    }
    // en = "Currently no effect because drugs were consumed within the last 5 days"
    // en base_es
    // FILE: mod_legends\hooks\skills\traits\arena_fighter_trait.nut
    // context: arena_fighter_trait.o.create.m.Description
    {
        en = "This character has just dipped %their% toes into the brutal profession of arena fighting and did so without dying."
        es = "Este personaje acaba de dar sus primeros pasos en la brutal profesión de las peleas en la arena y lo ha hecho sin morir."
    }
    // FILE: mod_legends\hooks\skills\traits\athletic_trait.nut
    // context: athletic_trait.o.getTooltip.text
    {
        en = "The first tile of movement each turn costs no Action Points and refunds used Fatigue (capped at your current Fatigue)"
        es = "La primera casilla de movimiento de cada turno no cuesta Puntos de acción y devuelve la Fatiga gastada (hasta tu Fatiga actual)"
    }
    // FILE: mod_legends\hooks\skills\traits\bloodthirsty_trait.nut
    // en = "This character is prone to excessive violence and cruelty towards his enemies. An opponent isn't good enough dead, his head needs to be on a spike!"
    // en base_es
    // FILE: mod_legends\hooks\skills\traits\bright_trait.nut
    // context: bright_trait.o.getTooltip.ret.push().text
    {
        en = "Doesn't get as irritated while reading"
        es = "No se irrita tanto al leer"
    }
    // FILE: mod_legends\hooks\skills\traits\clumsy_trait.nut
    // context: clumsy_trait.o.create.m.Description
    {
        en = "This character can be as dangerous to themself as to his opponent."
        es = "Este personaje puede ser tan peligroso para sí mismo como para su oponente."
    }
    // FILE: mod_legends\hooks\skills\traits\craven_trait.nut
    // context: craven_trait.o.create.m.Description
    {
        en = "Run for your lives! This character is a craven and will run at the slightest sign of the odds turning against them."
        es = "¡Corran por sus vidas! Este personaje es un cobarde y huirá ante la menor señal de que las probabilidades se vuelven en su contra."
    }
    // context: craven_trait.o.getTooltip.ret.push().text
    {
        en = "[color=%positive%]+5[/color] Ranged Defense"
        es = "[color=%positive%]+5[/color] de Defensa a distancia"
    }
    // FILE: mod_legends\hooks\skills\traits\cultist_acolyte_trait.nut
    // context: cultist_acolyte_trait.o.create.m.Description
    {
        en = "This character is an acolyte of Davkul, an individual with intimate knowledge of the teachings about the elder god. They embrace physical pain and peril as bringing them closer to salvation."
        es = "Este personaje es un acólito de Davkul, un individuo con un conocimiento íntimo de las enseñanzas sobre el dios antiguo. Acepta el dolor físico y el peligro como si lo acercaran a la salvación."
    }
    // FILE: mod_legends\hooks\skills\traits\cultist_chosen_trait.nut
    // context: cultist_chosen_trait.o.create.m.Description
    {
        en = "This character feels chosen by Davkul, something not many in this world can claim. They embrace physical pain and peril as bringing them closer to salvation, and they believe that their god will protect, so they can act on behest of their god."
        es = "Este personaje se siente elegido por Davkul, algo que pocos en este mundo pueden decir. Acepta el dolor físico y el peligro como si lo acercaran a la salvación, y cree que su dios lo protegerá, así que puede actuar en nombre de su dios."
    }
    // FILE: mod_legends\hooks\skills\traits\cultist_disciple_trait.nut
    // context: cultist_disciple_trait.o.create.m.Description
    {
        en = "This character is a disciple of Davkul, an individual with unquestionable loyalty to the elder god. They embrace physical pain and peril as bringing them closer to salvation."
        es = "Este personaje es discípulo de Davkul, un individuo con una lealtad incuestionable al ancestral dios. Acepta el dolor físico y el peligro como si lo acercaran a la salvación."
    }
    // FILE: mod_legends\hooks\skills\traits\cultist_fanatic_trait.nut
    // context: cultist_fanatic_trait.o.create.m.Description
    {
        en = "This character is a fanatic follower of Davkul, believing that Davkul embraces all in death."
        es = "Este personaje es un seguidor fanático de Davkul y cree que Davkul abraza a todos en la muerte."
    }
    // FILE: mod_legends\hooks\skills\traits\cultist_prophet_trait.nut
    // context: cultist_prophet_trait.o.create.m.Description
    {
        en = "This character is a prophet of Davkul, the fleshen conduit of his will and the earthen voice speaking his truth. Other believers listen to every word and feel compelled to go above and beyond their physical limits at the behest of this character."
        es = "Este personaje es un profeta de Davkul, el conducto carnal de su voluntad y la voz terrenal que dice su verdad. Otros creyentes escuchan cada palabra que pronuncia y se sienten obligados a ir más allá de sus límites físicos por orden de este personaje."
    }
    // FILE: mod_legends\hooks\skills\traits\cultist_zealot_trait.nut
    // context: cultist_zealot_trait.o.create.m.Description
    {
        en = "This character is a zealous follower of Davkul, so much so that they have come to embrace physical pain as bringing them closer to salvation."
        es = "Este personaje es un celoso seguidor de Davkul, hasta el punto de que ha llegado a aceptar el dolor físico como algo que lo acerca a la salvación."
    }
    // FILE: mod_legends\hooks\skills\traits\dastard_trait.nut
    // context: dastard_trait.o.create.m.Description
    {
        en = "This character will turn tail on the first possible occasion. Better have an eye on them!"
        es = "Este personaje dará media vuelta en la primera ocasión posible. ¡Será mejor que le eches un ojo!"
    }
    // FILE: mod_legends\hooks\skills\traits\deathwish_trait.nut
    // context: deathwish_trait.o.getTooltip.ret.extend().text
    {
        en = "Does not protect from effects that target morale directly, like Fearsome"
        es = "No protege de los efectos que afectan directamente a la moral, como Temible"
    }
    // context: deathwish_trait.o.getTooltip.ret.extend().text
    {
        en = "[color=%negative%]-3[/color] Melee Defense"
        es = "[color=%negative%]-3[/color] de Defensa cuerpo a cuerpo"
    }
    // FILE: mod_legends\hooks\skills\traits\dexterous_trait.nut
    // context: dexterous_trait.o.create.m.Description
    {
        en = "A dexterous character has an easier time hitting an opponent in melee."
        es = "A un personaje diestro le resulta más fácil golpear a un oponente cuerpo a cuerpo."
    }
    // FILE: mod_legends\hooks\skills\traits\disloyal_trait.nut
    // context: disloyal_trait.o.getTooltip.ret.push().text
    {
        en = "[color=%positive%]+10[/color] Melee Defense while retreating"
        es = "[color=%positive%]+10[/color] de Defensa cuerpo a cuerpo al retirarse"
    }
    // FILE: mod_legends\hooks\skills\traits\drunkard_trait.nut
    // context: drunkard_trait.o.create.m.Description
    {
        // corrige base: «Esperate» va sin tilde y no traduce bien «Expect him to» (cuenta con que); falta la preposición en «No hay duda en qué» (de en qué)
        en = "There's no question what this character spends their crowns on. Expect them to drink heavily before any battle, in secret if need be. "
        es = "No hay duda de en qué gasta sus coronas este personaje. Cuenta con que beba mucho antes de cualquier batalla, a escondidas si hace falta. "
    }
    // FILE: mod_legends\hooks\skills\traits\dumb_trait.nut
    // context: dumb_trait.o.create.m.Description
    {
        // corrige base: «adherirse a él» calca «stick with him» (que se le queden grabados); falta la coma de «Umm, what?»
        en = "Umm, what? This character isn't the brightest, and new concepts take a while to really stick with them."
        es = "¿Umm, qué? Este personaje no es el más brillante, y los conceptos nuevos tardan un tiempo en quedársele grabados."
    }
    // FILE: mod_legends\hooks\skills\traits\eagle_eyes_trait.nut
    // context: eagle_eyes_trait.o.getTooltip.text
    {
        // text = "[color=%positive%]+" + this.m.Vision + "[/color] Vision"
        mode = "pattern"
        en = "[color=%positive%]+<vision:int>[/color] Vision"
        es = "[color=%positive%]+<vision>[/color] de Visión"
    }
    // FILE: mod_legends\hooks\skills\traits\fat_trait.nut
    // context: fat_trait.o.getTooltip.ret.push().text
    {
        en = "Builds up [color=%negative%]2[/color] more fatigue for each tile travelled"
        es = "Acumula [color=%negative%]2[/color] de fatiga adicional por cada casilla recorrida"
    }
    // FILE: mod_legends\hooks\skills\traits\fear_beasts_trait.nut
    // context: fear_beasts_trait.o.create.m.Description
    {
        en = "Some past event or particularly convincing story in this character's life has left them scared of what the monstrous beasts of the wild are capable of, making this character less reliable when facing beasts on the battlefield."
        es = "Algún evento pasado o historia particularmente convincente en la vida de este personaje le ha hecho temer aquello de lo que son capaces las monstruosas bestias salvajes, lo que le resta fiabilidad al enfrentarse a bestias en el campo de batalla."
    }
    // FILE: mod_legends\hooks\skills\traits\fear_greenskins_trait.nut
    // context: fear_greenskins_trait.o.create.m.Description
    {
        en = "Some past event or particularly convincing story in this character's life has left them scared of what greenskins are capable of, making this character less reliable when facing greenskins on the battlefield."
        es = "Algún evento pasado o historia particularmente convincente en la vida de este personaje le ha hecho temer aquello de lo que son capaces los pieles verdes, lo que le resta fiabilidad al enfrentarse a pieles verdes en el campo de batalla."
    }
    // context: fear_greenskins_trait.o.getTooltip.ret.extend().text
    {
        en = "[color=%negative%]-5%[/color] Melee Skill when in battle with greenskins"
        es = "[color=%negative%]-5%[/color] de Habilidad cuerpo a cuerpo en combate contra pieles verdes"
    }
    // context: fear_greenskins_trait.o.getTooltip.ret.extend().text
    {
        en = "[color=%negative%]-5%[/color] Ranged Skill when in battle with greenskins"
        es = "[color=%negative%]-5%[/color] de Habilidad a distancia en combate contra pieles verdes"
    }
    // FILE: mod_legends\hooks\skills\traits\fear_undead_trait.nut
    // context: fear_undead_trait.o.create.m.Description
    {
        en = "Some past event or particularly convincing story in this character's life has left them scared of what the walking dead are capable of, making this character less reliable when facing the undead on the battlefield."
        es = "Algún evento pasado o historia particularmente convincente en la vida de este personaje le ha hecho temer aquello de lo que son capaces los muertos vivientes, lo que le resta fiabilidad al enfrentarse a los no muertos en el campo de batalla."
    }
    // context: fear_undead_trait.o.getTooltip.ret.extend().text
    {
        en = "[color=%negative%]-5%[/color] Melee Skill when in battle with undead"
        es = "[color=%negative%]-5%[/color] de Habilidad cuerpo a cuerpo en combate contra no muertos"
    }
    // context: fear_undead_trait.o.getTooltip.ret.extend().text
    {
        en = "[color=%negative%]-5%[/color] Ranged Skill when in battle with undead"
        es = "[color=%negative%]-5%[/color] de Habilidad a distancia en combate contra no muertos"
    }
    // FILE: mod_legends\hooks\skills\traits\fragile_trait.nut
    // context: fragile_trait.o.create.m.Description
    {
        en = "With a physique like an eggshell, this character is not the natural born brawler."
        es = "Con un físico resistente como una cáscara de huevo, este personaje no ha nacido para pelear."
    }
    // FILE: mod_legends\hooks\skills\traits\glorious_endurance_trait.nut
    // context: glorious_endurance_trait.o.create.m.Description
    {
        en = "Forged in the arenas of the south, this character has fought many a battle, and every blow will only strengthen their indomitable will and endurance. This fabulous lifestyle demands high pay, but they'll never desert you and can't be dismissed. If all three original members should die, your campaign ends."
        es = "Tras forjarse en las arenas del sur, este personaje ha librado muchas batallas, y cada golpe solo fortalecerá su voluntad y resistencia indomables. Su fabuloso estilo de vida exige un salario alto, pero nunca te abandonará y no se le puede despedir. Si los tres miembros originales mueren, tu campaña termina."
    }
    // FILE: mod_legends\hooks\skills\traits\glorious_quickness_trait.nut
    // context: glorious_quickness_trait.o.create.m.Description
    {
        en = "Forged in the arenas of the south, this character has fought many a battle, and is an expert in dispatching multiple opponents in a row. This fabulous lifestyle demands high pay, but they'll never desert you  and can't be dismissed. If all three original members should die, your campaign ends."
        es = "Tras forjarse en las arenas del sur, este personaje ha librado muchas batallas y domina el arte de eliminar a múltiples oponentes seguidos. Su fabuloso estilo de vida exige un salario alto, pero nunca te abandonará y no se le puede despedir. Si los tres miembros originales mueren, tu campaña termina."
    }
    // FILE: mod_legends\hooks\skills\traits\glorious_resolve_trait.nut
    // context: glorious_resolve_trait.o.create.m.Description
    {
        en = "Forged in the arenas of the south, this character has fought man and beast alike, and it takes a lot to break their resolve. This fabulous lifestyle demands high pay, but they'll never desert you  and can't be dismissed. If all three original members should die, your campaign ends."
        es = "Tras forjarse en las arenas del sur, este personaje ha luchado contra hombres y bestias por igual, y se necesita mucho para romper su determinación. Su fabuloso estilo de vida exige un salario alto, pero nunca te abandonará y no se le puede despedir. Si los tres miembros originales mueren, tu campaña termina."
    }
    // FILE: mod_legends\hooks\skills\traits\greedy_trait.nut
    // context: greedy_trait.o.create.m.Description
    {
        en = "I want more! This character is greedy and will demand a higher daily payment than others with a similar background, as well as being fast to leave you if you ever run out of crowns. On the flip side, ever eager for danger pay, this character performs better the higher the wage. The bonus has diminishing returns."
        es = "¡Quiero más! Este personaje es codicioso y exigirá una paga diaria mayor que otros con un trasfondo similar, además de abandonarte enseguida si alguna vez te quedas sin coronas. Por otro lado, siempre con ganas de cobrar un plus por peligrosidad, este personaje rinde mejor cuanto mayor es su salario. La bonificación tiene rendimientos decrecientes."
    }
    // context: greedy_trait.o.getTooltip.text
    {
        // text = "[color=%positive%]" + this.m.Bonus + "[/color] to every attribute"
        mode = "pattern"
        en = "[color=%positive%]<bonus:int>[/color] to every attribute"
        es = "[color=%positive%]<bonus>[/color] a todos los atributos"
    }
    // FILE: mod_legends\hooks\skills\traits\hate_beasts_trait.nut
    // context: hate_beasts_trait.o.getTooltip.ret.extend().text
    {
        en = "[color=%positive%]+5%[/color] Melee Skill when in battle with beasts"
        es = "[color=%positive%]+5%[/color] de Habilidad cuerpo a cuerpo en combate contra bestias"
    }
    // context: hate_beasts_trait.o.getTooltip.ret.extend().text
    {
        en = "[color=%positive%]+5%[/color] Ranged Skill when in battle with beasts"
        es = "[color=%positive%]+5%[/color] de Habilidad a distancia en combate contra bestias"
    }
    // FILE: mod_legends\hooks\skills\traits\hate_greenskins_trait.nut
    // context: hate_greenskins_trait.o.getTooltip.ret.extend().text
    {
        en = "[color=%positive%]+5%[/color] Melee Skill when in battle with greenskins"
        es = "[color=%positive%]+5%[/color] de Habilidad cuerpo a cuerpo en combate contra pieles verdes"
    }
    // context: hate_greenskins_trait.o.getTooltip.ret.extend().text
    {
        en = "[color=%positive%]+5%[/color] Ranged Skill when in battle with greenskins"
        es = "[color=%positive%]+5%[/color] de Habilidad a distancia en combate contra pieles verdes"
    }
    // FILE: mod_legends\hooks\skills\traits\hate_undead_trait.nut
    // context: hate_undead_trait.o.getTooltip.ret.extend().text
    {
        en = "[color=%positive%]+5%[/color] Melee Skill when in battle with undead"
        es = "[color=%positive%]+5%[/color] de Habilidad cuerpo a cuerpo en combate contra no muertos"
    }
    // context: hate_undead_trait.o.getTooltip.ret.extend().text
    {
        en = "[color=%positive%]+5%[/color] Ranged Skill when in battle with undead"
        es = "[color=%positive%]+5%[/color] de Habilidad a distancia en combate contra no muertos"
    }
    // FILE: mod_legends\hooks\skills\traits\hesitant_trait.nut
    // context: hesitant_trait.o.getTooltip.text
    {
        // text = "Acts last in turn order, but can be faster under the effect of [color=%status%]Adrenaline[/color]"
        mode = "pattern"
        en = "Acts last in turn order, but can be faster under the effect of [color=%status%]Adrenaline[/color]"
        es = "Actúa en último lugar en el orden de turnos, pero puede actuar antes bajo el efecto de [color=%status%]Adrenalina[/color]"
    }
    // FILE: mod_legends\hooks\skills\traits\huge_trait.nut
    // context: huge_trait.o.create.m.Description
    {
        en = "Being particularly huge and burly, this character's strikes hurt plenty, but they're also a bigger target than most."
        es = "Dada su enorme corpulencia, los golpes de este personaje duelen más, pero también es un objetivo más grande que los demás."
    }
    // context: huge_trait.o.getTooltip.text
    {
        en = "[color=%positive%]5%[/color] Melee Damage increase"
        es = "[color=%positive%]5%[/color] más de daño cuerpo a cuerpo"
    }
    // context: huge_trait.o.getTooltip.text
    {
        en = "[color=%positive%]5%[/color] Ranged Damage increase"
        es = "[color=%positive%]5%[/color] más de daño a distancia"
    }
    // context: huge_trait.o.getTooltip.text
    {
        en = "[color=%negative%]-5[/color] Melee Defense"
        es = "[color=%negative%]-5[/color] de Defensa cuerpo a cuerpo"
    }
    // context: huge_trait.o.getTooltip.text
    {
        en = "[color=%negative%]-5[/color] Ranged Defense"
        es = "[color=%negative%]-5[/color] de Defensa a distancia"
    }
    // FILE: mod_legends\hooks\skills\traits\impatient_trait.nut
    // context: impatient_trait.o.getTooltip.text
    {
        // text = "Acts first in turn order, but slower than characters under the effect of [color=%status%]Adrenaline[/color]"
        mode = "pattern"
        en = "Acts first in turn order, but slower than characters under the effect of [color=%status%]Adrenaline[/color]"
        es = "Actúa primero en el orden de turnos, pero después de los personajes bajo el efecto de [color=%status%]Adrenalina[/color]"
    }
    // context: impatient_trait.o.getTooltip.text
    {
        en = "Is unable to use wait in combat"
        es = "No puede usar Esperar en combate"
    }
    // FILE: mod_legends\hooks\skills\traits\insecure_trait.nut
    // context: insecure_trait.o.create.m.Description
    {
        en = "I can't do it! This character cowers, dodges and could use a bit more self confidence."
        es = "¡No puedo hacerlo! Este personaje se acobarda, esquiva y le vendría bien un poco más de autoconfianza."
    }
    // context: insecure_trait.o.getTooltip.ret.extend().text
    {
        en = "[color=%positive%]+5%[/color] Melee Defense"
        es = "[color=%positive%]+5%[/color] de Defensa cuerpo a cuerpo"
    }
    // context: insecure_trait.o.getTooltip.ret.extend().text
    {
        en = "[color=%positive%]+5%[/color] Ranged Defense"
        es = "[color=%positive%]+5%[/color] de Defensa a distancia"
    }
    // FILE: mod_legends\hooks\skills\traits\iron_jaw_trait.nut
    // context: iron_jaw_trait.o.create.m.Description
    {
        // corrige base: «se sacude de golpes» lleva una «de» que sobra; «sacudirse» es transitivo («se sacude golpes»).
        en = "This character shakes off hits that would cripple a lesser character."
        es = "Este personaje se sacude golpes que lisiarían a alguien más débil."
    }
    // FILE: mod_legends\hooks\skills\traits\loyal_trait.nut
    // context: loyal_trait.o.create.m.Description
    {
        en = "I'm with you! This character is loyal to the end and much less likely to leave you even if you run out of crowns and provisions. This character cannot be charmed."
        es = "¡Estoy contigo! Este personaje es leal hasta el final y es mucho menos probable que te deje incluso si te quedas sin coronas y provisiones. Además, es inmune a los efectos de encantamiento."
    }
    // FILE: mod_legends\hooks\skills\traits\mad_trait.nut
    // context: mad_trait.o.create.m.Description
    {
        en = "This character has gazed into the abyss, and the abyss has gazed right back at them, turning them quite mad. This character often rambles unintelligibly, and their cryptic mind has become inaccessible both to peers and to the enemy."
        es = "Este personaje ha mirado directamente al abismo, y el abismo le ha devuelto la mirada, haciéndole perder por completo la cordura. A menudo divaga ininteligiblemente y su mente críptica se ha vuelto inaccesible tanto para sus compañeros como para el enemigo."
    }
    // FILE: mod_legends\hooks\skills\traits\night_blind_trait.nut
    // context: night_blind_trait.o.create.m.Description
    {
        en = "During nighttime this character has to be tied to a flock, because they won't be able to see even their own nose."
        es = "Durante la noche este personaje tiene que estar atado a su grupo, porque no podrá ver ni siquiera su propia nariz."
    }
    // FILE: mod_legends\hooks\skills\traits\night_owl_trait.nut
    // context: night_owl_trait.o.create.m.Description
    {
        en = "Some characters adapt to low light conditions better than others, and this individual is especially good at it. Halves the usual night penalties"
        es = "Algunos personajes se adaptan mejor que otros a condiciones de poca luz, y este individuo es especialmente bueno en eso. Reduce a la mitad las penalizaciones nocturnas habituales"
    }
    // context: night_owl_trait.o.getTooltip.text
    {
        en = "[color=%positive%]+1[/color] Vision during Night time"
        es = "[color=%positive%]+1[/color] de Visión durante la noche"
    }
    // context: night_owl_trait.o.getTooltip.text
    {
        en = "[color=%positive%]+15%[/color] Ranged Skill during Night time"
        es = "[color=%positive%]+15%[/color] de Habilidad a distancia durante la noche"
    }
    // context: night_owl_trait.o.getTooltip.text
    {
        en = "[color=%positive%]+15%[/color] Ranged Defense during Night time"
        es = "[color=%positive%]+15%[/color] de Defensa a distancia durante la noche"
    }
    // FILE: mod_legends\hooks\skills\traits\player_character_trait.nut
    // context: player_character_trait.o.create.m.Description
    {
        en = "This is your player character, or in other words, yourself. If they die, your campaign ends. You can't dismiss them, they're immune to charm effects, and they'll never desert you."
        es = "Este es tu personaje jugador, o en otras palabras, tú. Si muere, tu campaña termina. No se le puede despedir, es inmune a los efectos de encantamiento y nunca te abandonará."
    }
    // context: player_character_trait.o.getTooltip.text
    {
        en = "[color=%positive%]+10[/color] Resolve."
        es = "[color=%positive%]+10[/color] de Resolución."
    }
    // context: player_character_trait.o.getTooltip.text
    {
        en = "[color=%positive%]Immune to charm effects.[/color]"
        es = "[color=%positive%]Inmune a los efectos de encantamiento.[/color]"
    }
    // context: player_character_trait.o.getTooltip.text
    {
        en = "[color=%positive%]Will never desert the company.[/color]"
        es = "[color=%positive%]Nunca abandonará la compañía.[/color]"
    }
    // FILE: mod_legends\hooks\skills\traits\quick_trait.nut
    // context: quick_trait.o.create.m.Description
    {
        en = "Already there! This character is quick to act, often before opponents do."
        es = "¡Ya estoy ahí! Este personaje actúa rápidamente, a menudo antes que sus oponentes."
    }
    // FILE: mod_legends\hooks\skills\traits\strong_trait.nut
    // context: strong_trait.o.create.m.Description
    {
        en = "This character is exceptionally muscled and capable of impressive feats of strength"
        es = "Este personaje es excepcionalmente musculoso y capaz de impresionantes proezas de fuerza"
    }
    // FILE: mod_legends\hooks\skills\traits\superstitious_trait.nut
    // context: superstitious_trait.o.create.m.Description
    {
        en = "It's cursed! This character is highly superstitious and therefore more vulnerable to skills that directly attack their Resolve."
        es = "¡Está maldito! Este personaje es muy supersticioso y por lo tanto más vulnerable a habilidades que atacan directamente su Resolución."
    }
    // FILE: mod_legends\hooks\skills\traits\survivor_trait.nut
    // context: survivor_trait.o.create.m.Description
    {
        en = "Why won't you just stay dead? This character is a survivor and will outlive most of their peers."
        es = "¿Por qué no te mueres de una vez? Este personaje tiene madera de superviviente y sobrevivirá a la mayoría de sus compañeros."
    }
    // FILE: mod_legends\hooks\skills\traits\teamplayer_trait.nut
    // context: teamplayer_trait.o.create.m.Description
    {
        // corrige base: «nunca se calla» rebaja la crudeza de «he'll never shut the hell up»; pasa a «nunca cierra la maldita boca».
        en = "This character makes sure to always announce their intentions to his brothers-in-arms. In fact, they'll never shut the hell up. At least it reduces the chance of accidents happening and they feel better when near brothers."
        es = "Este personaje se asegura de anunciar siempre sus intenciones a sus compañeros de armas. De hecho, nunca cierra la maldita boca. Al menos reduce la posibilidad de que ocurran accidentes, y se siente mejor cuando tiene hermanos cerca."
    }
    // context: teamplayer_trait.o.getTooltip.ret.push().text
    {
        // text = "[color=%skill%]Knock Back[/color], [color=%skill%]Repel[/color] and [color=%skill%]Hook[/color] skills have [color=%positive%]100%[/color] chance to hit when targeting an allied character and will not apply negative effects or damage when used on an ally"
        mode = "pattern"
        en = "[color=%skill%]Knock Back[/color], [color=%skill%]Repel[/color] and [color=%skill%]Hook[/color] skills have [color=%positive%]100%[/color] chance to hit when targeting an allied character and will not apply negative effects or damage when used on an ally"
        es = "Las habilidades [color=%skill%]Golpe de escudo[/color], [color=%skill%]Repeler[/color] y [color=%skill%]Enganchar[/color] tienen un [color=%positive%]100%[/color] de probabilidad de acierto al apuntar a un personaje aliado y no aplican efectos negativos ni daño cuando se usan sobre un aliado"
    }
    // context: teamplayer_trait.o.getTooltip.ret.extend().text
    {
        en = "[color=%positive%]+5%[/color] Melee Skill"
        es = "[color=%positive%]+5%[/color] de Habilidad cuerpo a cuerpo"
