    // en base_es
    // en = "And we also have hurled our javelins"
    // en base_es
    // en = "The heron seeks high places"
    // en base_es
    // en = "Disdained for their ruthlessness, brutality and greed, house %noblehousename% has little interaction with other noble families. Their captains and soldiers are known for raiding trade caravans, outlying farms and small settlements from their fortress of %factionfortressname%. A life is not worth much in the realm of house %noblehousename% and many a mercenary on the look for a quick coin only found a quick end here."
    // en base_es
    // en = "Whatever grows perishes in ashes"
    // en base_es
    // en = "We trample it under our feet"
    // en base_es
    // en = "For me and for mine"
    // en base_es
    // en = "The eagle catches not flies"
    // en base_es
    // en = "Deeds not words"
    // en base_es
    // en = "The gods feed the ravens"
    // en base_es
    // en = "Always thirsty"
    // en base_es
    // en = "Sons of hounds come here and get flesh"
    // en base_es
    // en = "Not without booty"
    // en base_es
    // context: ::Const.FactionArchetypes.extend().Description
    {
        en = "The house of %noblehousename% always has their eyes on the horizon. Always chasing riches from foreign lands, and willing to take them by force.  Missions are launched from %factionfortressname% out to claim a world they believe to be rightfully theirs."
        es = "La casa %noblehousename% siempre tiene la vista puesta en el horizonte. Siempre persigue las riquezas de tierras extranjeras y está dispuesta a tomarlas por la fuerza. Desde %factionfortressname% parten expediciones para reclamar un mundo que creen suyo por derecho."
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Seize it"
        es = "Tómalo"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "The thrill of the hunt"
        es = "La emoción de la caza"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "The endless hunt"
        es = "La caza sin fin"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "The horizon calls"
        es = "El horizonte llama"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Find it and own it"
        es = "Encuéntralo y hazlo tuyo"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "All that we see, we own"
        es = "Todo lo que vemos es nuestro"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Never stop hunting"
        es = "Nunca dejes de cazar"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Take it all"
        es = "Tómalo todo"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "All belongs to us"
        es = "Todo nos pertenece"
    }
    // context: ::Const.FactionArchetypes.extend().Description
    {
        en = "The noble house of %noblehousename% is a proud and unrelenting family with a long and bloodstained history of total control. Seated in their fortress of %factionfortressname%, their people offer up a tithe consider theirs by birthright. Though their rule is cruel, the people adore them for their staunchness."
        es = "La casa noble %noblehousename% es una familia orgullosa e implacable, con una larga y sangrienta historia de control absoluto. Desde su fortaleza de %factionfortressname%, su pueblo les paga un diezmo que consideran suyo por derecho de nacimiento. Aunque su gobierno es cruel, el pueblo los adora por su firmeza."
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Love thy betters"
        es = "Ama a tus superiores"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Born to rule, destined for brutality"
        es = "Nacidos para gobernar, destinados a la brutalidad"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "For the Duke, kill them all"
        es = "Por el duque, mátenlos a todos"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "In his name, let none stand"
        es = "En su nombre, que nadie quede en pie"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "The Duke protects with fury"
        es = "El duque protege con furia"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Tough love"
        es = "Amor severo"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Hard lines provide good lives"
        es = "Mano dura, buena vida"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Rest in his iron grip"
        es = "Descansa en su puño de hierro"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Beg for his mercy, love his justice"
        es = "Implora su piedad, ama su justicia"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "The shepard's sacrifices to save the flock"
        es = "El pastor sacrifica para salvar al rebaño"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Take heart, and take hearts"
        es = "Ten corazón y arranca corazones"
    }
    // context: ::Const.FactionArchetypes.extend().Description
    {
        en = "House %noblehousename% works in the dark to protect its lands. The agents of %noblehousename%  have eyes in every shady corner and ears in every wall, inside and outside their borders. Peace is maintained through their lands, because %noblehousename% is always watching."
        es = "La casa %noblehousename% trabaja en la sombra para proteger sus tierras. Los agentes de %noblehousename% tienen ojos en cada rincón oscuro y oídos en cada pared, dentro y fuera de sus fronteras. En sus tierras reina la paz, porque %noblehousename% siempre está vigilando."
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Eyes on all"
        es = "Ojos sobre todos"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Security through surveillance"
        es = "Seguridad mediante vigilancia"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Total information awareness"
        es = "Conocimiento total de la información"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Report thy neighbour, to protect him"
        es = "Denuncia a tu vecino, para protegerlo"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "All seeing"
        es = "Todo lo vemos"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Knowledge is safety"
        es = "Saber es seguridad"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Shadows guard"
        es = "Las sombras vigilan"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Loose lips sink ships"
        es = "En boca cerrada no entran moscas"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Need to know only"
        es = "Solo quien deba saberlo"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Protected by secrecy"
        es = "Bajo protección del secreto"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "The grand plan"
        es = "El gran plan"
    }
    // context: ::Const.FactionArchetypes.extend().Description
    {
        en = "The house of %noblehousename% is well known for its jealously guarded horde of treasures. The hoarded treasures of %noblehousename% are whispered through the lands, and still they crave more."
        es = "La casa %noblehousename% es bien conocida por el tesoro que guarda con celo. De los tesoros acumulados por %noblehousename% se habla en susurros por todas las tierras, y aun así ansían más."
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "One of everything"
        es = "Uno de cada cosa"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "To the zoo"
        es = "A la casa de fieras"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "For the collection"
        es = "Para la colección"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Everything in its place"
        es = "Cada cosa en su lugar"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "A place for every thing"
        es = "Un lugar para cada cosa"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "It all comes home"
        es = "Todo vuelve a casa"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "One for me, and one for me"
        es = "Uno para mí, y otro para mí"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "We collect"
        es = "Coleccionamos"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "The Horde's hoard"
        es = "El botín de la Horda"
    }
    // context: ::Const.FactionArchetypes.extend().Description
    {
        en = "The house of %noblehousename% subtly manipulates events for the greater good. From their home in %factionfortressname%, they strategise to bring wellbeing to the common man. In a brutal world they are a faint glimmer of a better world."
        es = "La casa %noblehousename% manipula los acontecimientos con sutileza por el bien común. Desde su hogar en %factionfortressname%, traza estrategias para llevar bienestar al hombre común. En un mundo brutal, son un tenue destello de un mundo mejor."
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Plan for the future"
        es = "Planear para el futuro"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Nurture with foresight"
        es = "Cultivar con previsión"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Towards a higher purpose"
        es = "Hacia un propósito más alto"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Plan together"
        es = "Planear juntos"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "For the greater good"
        es = "Por el bien común"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "The stars align in hope"
        es = "Las estrellas se alinean en la esperanza"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Seeing beyond the pain"
        es = "Ver más allá del dolor"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "A brighter morning"
        es = "Una mañana más luminosa"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "A harvest sown"
        es = "Una cosecha sembrada"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Seeds are planted for children"
        es = "Las semillas se plantan para los hijos"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Building for tomorrow"
        es = "Construir para el mañana"
    }
    // context: ::Const.FactionArchetypes.extend().Description
    {
        en = "Lauded as providers for their people %noblehousename% creates bounty by raiding their enemies. Their captains and soldiers are known for raiding trade caravans, outlying farms and small settlements from their fortress of %factionfortressname%. They bring supplies back home, to share the bounty among their people."
        es = "Alabada como proveedora de su pueblo, la casa %noblehousename% obtiene abundancia saqueando a sus enemigos. Sus capitanes y soldados son conocidos por asaltar caravanas comerciales, granjas apartadas y pequeños asentamientos desde su fortaleza de %factionfortressname%. Llevan los suministros de vuelta a casa para repartir el botín entre su gente."
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Our own first"
        es = "Los nuestros primero"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "We are the chosen"
        es = "Somos los elegidos"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "The heathens shall fall"
        es = "Los paganos caerán"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "What's yours is ours"
        es = "Lo tuyo es nuestro"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Anything for our people"
        es = "Todo por nuestro pueblo"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Blood for my people"
        es = "Sangre por mi pueblo"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Bringing it home"
        es = "Lo traemos a casa"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Better us than them"
        es = "Mejor nosotros que ellos"
    }
    // context: ::Const.FactionArchetypes.extend().Mottos
    {
        en = "Our folk are all"
        es = "Nuestra gente lo es todo"
    }
    // en = "Trading and haggling can be just as fierce as fighting a war, and the house of %noblehousename% is a true master of cunning bargains. Rumor has it that many a profitable deal made by house %noblehousename% is not only based on honest trading but also bribery, extortion and deception. The family resides in the pompous region capitol of %factionfortressname%, but despite their unmeasurable riches they are known to be notoriously close-fisted."
    // en base_es
    // en = "To live without a wish concealed"
    // en base_es
    // en = "Fortune favours the bold"
    // en base_es
    // en = "The world does not suffice"
    // en base_es
    // en = "Separate the honest from the useful"
    // en base_es
    // en = "Our harvest will also arrive"
    // en base_es
    // en = "I gain by hazard"
    // en base_es
    // en = "House %noblehousename% claims to have roots in the time when man first claimed this land, and the first king ruled all men. They are but one of many noble houses now, but proud of their long history and with ambitions to continue writing history. As their renown and their resources dwindle in the now, they are said to finance expeditions in an attempt to unearth long lost treasures from the past, in sunken cities and places long forgotten."
    // en base_es
    // en = "He lives twice who lives well"
    // en base_es
    // en = "Wealth to him who knows how to use it"
    // en base_es
    // en = "Things locked up are safe"
    // en base_es
    // en = "Once and always"
    // en base_es
    // en = "Gauge and measure"
    // en base_es
    // en = "Safe on the waves"
    // en base_es
    // en = "Each his share"
    // en base_es
    // en = "With sail and oars"
    // en base_es
    // en = "Among the first"
    // en base_es
    // context: ::Const.FactionArchetypes.extend().Description
    {
        en = "Most members of the house of %noblehousename% live secluded behind thick doors and barred windows and some of them have not been seen for years. Rumor has it that their noble blood is plagued with madness and insanity but no ordinary man dares to utter such claims in fear of their vengeance. Other noble houses mainly avoid contact with house %noblehousename% as guests may be greeted with open arms as well as crossbow bolts."
        es = "La mayoría de los miembros de la casa %noblehousename% viven recluidos detrás de gruesas puertas y ventanas con barrotes, y algunos de ellos no han sido vistos en años. Se rumorea que su noble sangre está plagada de locura y demencia, pero ningún hombre común se atreve a pronunciar tales afirmaciones por temor a su venganza. Otras casas nobles evitan en su mayoría el contacto con la casa %noblehousename%, ya que los invitados pueden ser recibidos con los brazos abiertos, o con saetas de ballesta."
    }
