    // FILE: scripts\skills\actives\legend_donkey_kick_skill.nut
    // context: legend_donkey_kick_skill.create.m.Description
    {
        en = "The main attack of a donkey, more for defense than attack. Maximum damage is the average of your hitpoints and initiative minus 90."
        es = "El ataque principal de un burro, más defensivo que ofensivo. El daño máximo es la media de tus Puntos de vida y tu Iniciativa, menos 90."
    }
    // context: legend_donkey_kick_skill.create.m.KilledString
    {
        en = "Kicked to death"
