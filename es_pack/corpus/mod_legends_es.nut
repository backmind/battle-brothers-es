    // FILE: scripts\items\misc\legend_prosthetic_foot_item.nut
    // context: legend_prosthetic_foot_item.create.m.Name
    {
        en = "Prosthetic Foot"
        es = ""
    }
    // context: legend_prosthetic_foot_item.create.m.Description
    {
        en = "It's more than a prosthetic foot, it's a foundation! Or so it's creator says, but this contraption looks like hell to walk with. Crafted out of wood, metal and various leather straps, it manages to mimic foot movement well enough and will allow the wearer to at least recover a part of their dexterity."
        es = ""
    }
    // context: legend_prosthetic_foot_item.getTooltip.result.extend().text
    {
        en = "Removes the [color=%negative%]1[/color] Additional Action Point per tile moved penalty from Maimed Foot Injury"
        es = ""
    }
    // context: legend_prosthetic_foot_item.getTooltip.result.extend().text
    {
        en = "Reduces the penalty of Missing Foot to [color=%negative%]-10%[/color] Initiative"
        es = ""
    }
    // context: legend_prosthetic_foot_item.getTooltip.result.extend().text
    {
        en = "Builds up [color=%negative%]3[/color] more fatigue for each tile travelled"
        es = ""
    }
    // context: legend_prosthetic_foot_item.getTooltip.result.extend().text
    {
        en = "Can only be used if this character has a maimed foot"
        es = ""
    }
    // FILE: scripts\items\misc\legend_prosthetic_forearm_item.nut
    // context: legend_prosthetic_forearm_item.create.m.Name
    {
        en = "Prosthetic Forearm"
        es = ""
    }
    // context: legend_prosthetic_forearm_item.create.m.Description
    {
        en = "According to the inventor, this contraption is almost like the real thing. If the real thing had no feeling and control in their forearm, of course. It can hold a weapon, even if the fingers need to be adjusted with the other hand. Mercenaries particularly enjoy setting their new hand to give the one finger salute."
        es = ""
    }
    // context: legend_prosthetic_forearm_item.getTooltip.result.extend().text
    {
        en = "Reduces the penalty of Broken Elbow Joint to [color=%negative%]-10%[/color] Melee Skill"
        es = ""
    }
    // context: legend_prosthetic_forearm_item.getTooltip.result.extend().text
    {
        en = "Reduces the penalty of Broken Elbow Joint to [color=%negative%]-10%[/color] Ranged Skill"
        es = ""
    }
    // context: legend_prosthetic_forearm_item.getTooltip.result.extend().text
    {
        en = "Reduces the penalty of Broken Elbow Joint to [color=%negative%]-15%[/color] Melee Defense"
        es = ""
    }
    // context: legend_prosthetic_forearm_item.getTooltip.result.extend().text
    {
        en = "Can only be used if this character has a broken elbow joint"
        es = ""
    }
