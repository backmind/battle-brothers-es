        en = "[color=%negative%]This character isn't nude.[/color]"
        es = "[color=%negative%]Este personaje lleva ropa.[/color]"
    }
    // FILE: scripts\skills\perks\perk_legend_vala_chant_disharmony.nut
    // context: perk_legend_vala_chant_disharmony.getDescription
    {
        en = "A very disagreeable and cacophonous chant can makes it almost impossible for enemies to focus and concentrate properly."
        es = "Un canto muy desagradable y cacofónico puede hacer que a los enemigos les resulte casi imposible centrarse y concentrarse como es debido."
    }
    // context: perk_legend_vala_chant_disharmony.getTooltip.ret.push().text
    {
        en = "Until the start of her next turn, enemies within 3 tiles of the Vala will receive a reduction to Initiative. Being closer to the Vala increases the strength of the Chant"
        es = "Hasta el inicio de su siguiente turno, los enemigos a 3 casillas o menos de la Vala sufrirán una reducción de Iniciativa. Cuanto más cerca estén de la Vala, más fuerte será el Canto"
    }
    // context: perk_legend_vala_chant_disharmony.getTooltip.ret.push().text
    {
        en = "[color=%negative%]Requires the Vala's staff[/color]"
        es = "[color=%negative%]Requiere el bastón de la Vala[/color]"
    }
    // context: perk_legend_vala_chant_disharmony.getTooltip.ret.push().text
    {
        en = "[color=%negative%]Already chanting[/color]"
        es = "[color=%negative%]Ya está cantando[/color]"
    }
    // FILE: scripts\skills\perks\perk_legend_vala_chant_fury.nut
    // context: perk_legend_vala_chant_fury.getDescription
    {
        en = "A chant that gets the blood boiling, making your allies eager to fight."
        es = "Un canto que hace hervir la sangre y llena a tus aliados de ganas de luchar."
    }
    // context: perk_legend_vala_chant_fury.getTooltip.ret.push().text
    {
        en = "Until the start of her next turn all allies within 3 tiles of the Vala receive a bonus to their damage output and a chance to retaliate against attackers that hit them in melee range. Being closer to the Vala increases bonus amount and retaliation chance."
        es = "Hasta el inicio de su siguiente turno, todos los aliados a 3 casillas o menos de la Vala reciben una bonificación al daño que infligen y la posibilidad de contraatacar a quienes los golpeen cuerpo a cuerpo. Cuanto más cerca estén de la Vala, mayor será la bonificación y la probabilidad de contraatacar."
    }
    // context: perk_legend_vala_chant_fury.getTooltip.ret.push().text
    {
        en = "[color=%negative%]Requires the Vala's staff.[/color]"
        es = "[color=%negative%]Requiere el bastón de la Vala.[/color]"
    }
    // context: perk_legend_vala_chant_fury.getTooltip.ret.push().text
    {
        en = "[color=%negative%]Already chanting.[/color]"
        es = "[color=%negative%]Ya está cantando.[/color]"
    }
