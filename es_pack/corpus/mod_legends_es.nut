        mode = "pattern"
        en = "Has [color=%positive%]<ammo:int>[/color] arrows left"
        es = "Le quedan [color=%positive%]<ammo>[/color] flechas"
    }
    // context: aimed_shot.o.getTooltip.tooltip.push().text
    {
        en = "[color=%negative%]Needs a non-empty quiver of arrows equipped[/color]"
        es = "[color=%negative%]Necesita tener equipado un carcaj de flechas que no esté vacío[/color]"
    }
    // context: aimed_shot.o.getTooltip.tooltip.push().text
    {
        en = "[color=%negative%]Can not be used because this character is engaged in melee[/color]"
        es = "[color=%negative%]No se puede usar porque este personaje está en combate cuerpo a cuerpo[/color]"
    }
    // FILE: mod_legends\hooks\skills\actives\bandage_ally_skill.nut
    // context: bandage_ally_skill.o.create.m.Description
    {
        en = "Save yourself or another character from bleeding to death by applying pressure and provisional bandaging to any such wound. Does not heal hitpoints. Neither the character using this skill nor the patient may be engaged in melee, unless the character using this skill has Bandage Mastery."
        es = "Sálvate a ti mismo o a otro personaje de morir desangrado aplicando presión y vendando provisionalmente cualquier herida. No cura los puntos de vida. Ni el personaje que usa esta habilidad ni el paciente pueden estar en combate cuerpo a cuerpo, a menos que el personaje que usa esta habilidad tenga Dominio del Vendaje."
    }
    // context: bandage_ally_skill.o.getTooltip.tooltip.text
    {
        // corrige base: «'Sangrado'» por «'Sangrando'»: el estado Bleeding se llama «Sangrando» en el base
        en = "Removes the Bleeding and Grazed status effect"
        es = "Elimina los efectos de estado 'Sangrando' y 'Rozado'"
    }
    // en = "Removes fresh Cut Artery, Cut Neck Vein and Grazed Neck injuries"
