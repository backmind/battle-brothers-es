    // context: legend_ardent_admirer_event.onPrepareVariables._vars.push()
    // en = "gunner"  // clave de variable para los tokens de género (_gunner), no se muestra
    // FILE: scripts\events\events\legends\legend_barbarian_vs_shieldmaiden.nut
    // context: legend_barbarian_vs_shieldmaiden.create.m.Screens.push().Text
    {
        // Text = "[img]gfx/ui/events/event_06.png[/img]You find %barbarian% and %shieldmaiden% arguing with one another. The Barbarian\'s voice is raised.%SPEECH_ON%The best defence is the good offence! That\'s why I rush to a battle first!%SPEECH_OFF%Also raising her voice, and clenching a shield at her side, the Shieldmaiden shakes her head.%SPEECH_ON%Why are you even talking to me? I have no desire to get to know someone who is only going to get killed by rushing into battle before thinking!%SPEECH_OFF%The fighting words kick off a scuffle.\n\n",
        mode = "pattern"
        en = "[img]gfx/ui/events/event_06.png[/img]You find %barbarian% and %shieldmaiden% arguing with one another. The Barbarian's voice is raised.%SPEECH_ON%The best defence is the good offence! That's why I rush to a battle first!%SPEECH_OFF%Also raising her voice, and clenching a shield at her side, the Shieldmaiden shakes her head.%SPEECH_ON%Why are you even talking to me? I have no desire to get to know someone who is only going to get killed by rushing into battle before thinking!%SPEECH_OFF%The fighting words kick off a scuffle.\n\n"
        es = "[img]gfx/ui/events/event_06.png[/img]Encuentras a %barbarian% y a %shieldmaiden% discutiendo. %barbarian% levanta la voz.%SPEECH_ON%¡La mejor defensa es un buen ataque! ¡Por eso me lanzo a la batalla antes que nadie!%SPEECH_OFF%Alzando también la voz y aferrando un escudo a su costado, la doncella escudera niega con la cabeza.%SPEECH_ON%¿Por qué me hablas siquiera? ¡No tengo ningún interés en conocer a alguien a quien van a matar por lanzarse a la batalla sin pensar!%SPEECH_OFF%Esas palabras bastan para desatar una pelea.\n\n"
    }
    // context: legend_barbarian_vs_shieldmaiden.create.m.Screens.push().Options.Text
    {
        en = "Are you both done?"
        es = "¿Ya terminaron los dos?"
    }
    // context: legend_barbarian_vs_shieldmaiden.create.m.Screens.push().start.Text
    {
        // this.Text = this.Text + " %barbarian% rushes at %shieldmaiden% with a full swing of a weapon, as if trying to cut her in half, but she raises her shield to deftly deflect the blow and immedietly counters with a quick jab of her shield that stuns and knocks %barbarian% back.%SPEECH_ON%See I told you! you rush without thinking and now you are laying on the ground...%SPEECH_OFF%";
        mode = "pattern"
        en = "<text:str> %barbarian% rushes at %shieldmaiden% with a full swing of a weapon, as if trying to cut her in half, but she raises her shield to deftly deflect the blow and immedietly counters with a quick jab of her shield that stuns and knocks %barbarian% back.%SPEECH_ON%See I told you! you rush without thinking and now you are laying on the ground...%SPEECH_OFF%"
        es = "<text> %barbarian% carga contra %shieldmaiden% lanzando un tajo con todas sus fuerzas, como si quisiera partirla en dos, pero ella alza el escudo, desvía el golpe con destreza y contraataca al instante con un rápido golpe de escudo que aturde y hace retroceder a %barbarian%.%SPEECH_ON%¡Ves, te lo dije! Te lanzas sin pensar y ahora mírate, en el suelo...%SPEECH_OFF%"
    }
    // context: legend_barbarian_vs_shieldmaiden.create.m.Screens.push().start._event.m.Shieldmaiden.improveMood()
    {
        en = "victorious in a brawl"
        es = "victoriosa en una pelea"
    }
    // context: legend_barbarian_vs_shieldmaiden.create.m.Screens.push().start._event.m.Barbarian.worsenMood()
    {
        // _event.m.Barbarian.worsenMood(0.5, "Overpowered by " + _event.m.Shieldmaiden.getName());
