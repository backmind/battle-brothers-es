    // FILE: scripts\skills\perks\perk_legend_specialist_poacher.nut
    // context: perk_legend_specialist_poacher.onAnySkillUsed.::Legends.S.patternIsInText()
    // en = "Piercing"  // patrón de búsqueda interno de patternIsInText; no se muestra y traducirlo rompería la comprobación
    // context: perk_legend_specialist_poacher.onAnySkillUsed.::Legends.S.patternIsInText()
    // en = "Broad Head"  // patrón de búsqueda interno de patternIsInText; no se muestra y traducirlo rompería la comprobación
    // FILE: scripts\skills\perks\perk_legend_specialist_shield_skill.nut
    // context: perk_legend_specialist_shield_skill.getDescription
    {
        en = "This character has mastered the use of a shield. Even when they are hit, they are able to partially deflect the impact and reduce the damage. Their dedicated practice has made forming a shieldwall as natural as breathing for them."
        es = "Este personaje domina el uso del escudo. Incluso cuando recibe un golpe, es capaz de desviar parcialmente el impacto y reducir el daño. Su práctica constante ha hecho que formar un Muro de escudos le resulte tan natural como respirar."
    }
    // context: perk_legend_specialist_shield_skill.getTooltip.ret.push().text
    {
        // text = "[color=%positive%]"+ this.m.TurnsLeft + "[/color] instances of auto shieldwall on turn end left"
        mode = "pattern"
        en = "[color=%positive%]<turns:int>[/color] instances of auto shieldwall on turn end left"
        es = "Quedan [color=%positive%]<turns>[/color] usos de Muro de escudos automático al final del turno"
    }
    // context: perk_legend_specialist_shield_skill.getTooltip.ret.push().text
    {
        en = "[color=%positive%]+10%[/color] damage reduction while using a shield"
        es = "[color=%positive%]+10%[/color] de reducción de daño al usar un escudo"
    }
    // FILE: scripts\skills\perks\perk_legend_swagger.nut
    // context: perk_legend_swagger.getTooltip.ret.extend().text
    {
        // text = "[color=%positive%]+" + this.Math.floor(bonus) + "[/color] armor condition added at start of combat"
