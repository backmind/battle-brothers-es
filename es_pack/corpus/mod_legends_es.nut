    // FILE: scripts\skills\traits\legend_aggressive_trait.nut
    // context: legend_aggressive_trait.create.m.Description
    {
        en = "This character is pretty aggressive, even to their own detriment."
        es = "Este personaje es bastante agresivo, incluso en su propio perjuicio."
    }
    // context: legend_aggressive_trait.create.m.Titles
    {
        en = "the Boar"
        es = "el Jabalí"
    }
    // context: legend_aggressive_trait.create.m.Titles
