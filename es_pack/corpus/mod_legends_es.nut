    {
        en = "\nThis item has the power of the rune sigil of Poison:\n[color=%positive%]%bonus1%[/color] turn(s) of poison applied on attacks with this weapon, with a strength of [color=%damage%]%bonus2%[/color]. Lowers action points and initiative.\n	"
        es = "\nEste objeto posee el poder del sello rúnico de Veneno:\nLos ataques con esta arma aplican [color=%positive%]%bonus1%[/color] turno(s) de veneno, con una potencia de [color=%damage%]%bonus2%[/color]. Reduce los Puntos de acción y la Iniciativa.\n	"
    }
    // context: ::Legends.Rune.LegendRswPoison.::Legends.Runes.add().RuneTooltip
    {
        en = "\nThis item has the power of the rune sigil of Poison:\n[color=%positive%]1 to %max1%[/color] turn(s) of poison applied on attacks with this weapon, with a strength of [color=%damage%]3 to %max2%[/color]. Lowers action points and initiative.\n	"
        es = "\nEste objeto posee el poder del sello rúnico de Veneno:\nLos ataques con esta arma aplican [color=%positive%]1 a %max1%[/color] turno(s) de veneno, con una potencia de [color=%damage%]3 a %max2%[/color]. Reduce los Puntos de acción y la Iniciativa.\n	"
    }
