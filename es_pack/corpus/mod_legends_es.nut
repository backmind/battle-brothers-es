    }
    // context: legend_oms_amphora_skill.::inherit().onUse.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(_user) + " lets " + this.Const.UI.getColorizedEntityName(user) + " drink from Amphora");
        mode = "pattern"
        en = "<giver:str> lets <drinker:str> drink from Amphora"
        es = "<giver> deja que <drinker> beba del ánfora"
    }
    // FILE: scripts\skills\actives\legend_pass_skill.nut
    // context: legend_pass_skill.create.m.Description
    {
        en = "Give the first item in your bag to an adjacent ally. Can not be used while engaged in melee, and anyone receiving the item needs to have a free main hand, off hand or bag slot."
        es = "Da el primer objeto de tu bolsa a un aliado adyacente. No se puede usar mientras se está en combate cuerpo a cuerpo, y quien reciba el objeto necesita tener libre la mano principal, la mano secundaria o un hueco de la bolsa."
    }
    // context: legend_pass_skill.getTooltip.ret.text
    {
        en = "Passes the first item in your bag to an ally"
        es = "Pasa el primer objeto de tu bolsa a un aliado"
    }
    // context: legend_pass_skill.getTooltip.ret.text
    {
        en = "If passing a main hand or off hand item, will try to place the item in the relevant slot instead of the ally's bag if said slot is free"
        es = "Si pasas un objeto de mano principal o secundaria, intentará colocarlo en la ranura correspondiente en lugar de en la bolsa del aliado, si esa ranura está libre"
    }
    // context: legend_pass_skill.onUse.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(_user) + " gives " + itemName + " to " + this.Const.UI.getColorizedEntityName(target));
        mode = "pattern"
        en = "<user:str_tag> gives <item:str> to <target:str_tag>"
        es = "<user> da <item> a <target>"
    }
    // FILE: scripts\skills\actives\legend_piercing_bolt_skill.nut
    // context: legend_piercing_bolt_skill.::inherit().create.m.Description
    {
        en = "A shot with so much force that it passes straight through the target to whoever is behind them."
        es = "Un disparo con tanta fuerza que atraviesa al objetivo y alcanza a quien esté detrás."
    }
    // context: legend_piercing_bolt_skill.::inherit().getTooltip.ret.insert().text
    {
        en = "If the bolt hits its target, it will continue through and damage any target behind, dealing 50% damage."
        es = "Si el virote acierta, seguirá su trayectoria y dañará a cualquier objetivo que haya detrás, infligiendo un [color=#135213]50%[/color] del daño."
    }
    // context: legend_piercing_bolt_skill.::inherit().onScheduledTargetHit.::Tactical.EventLog.logEx().format()
    {
        // ::Tactical.EventLog.logEx(format("%s pierces %s but %s\'s corporeal form is unscathed", _info.Skill.getName(), targetName, ::Const.UI.getColorizedEntityName(forwardTile.getEntity())));
        mode = "pattern"
        en = "<skill:str> pierces <target:str> but <behind:str>'s corporeal form is unscathed"
        es = "<skill> atraviesa a <target>, pero la forma corpórea de <behind> sale ilesa"
    }
    // context: legend_piercing_bolt_skill.::inherit().onScheduledTargetHit.::Tactical.EventLog.logEx().format()
    {
        // ::Tactical.EventLog.logEx(format("%s pierces %s and hits %s", _info.Skill.getName(), targetName, ::Const.UI.getColorizedEntityName(forwardTile.getEntity())));
        mode = "pattern"
        en = "<skill:str> pierces <target:str> and hits <behind:str>"
        es = "<skill> atraviesa a <target> y alcanza a <behind>"
    }
    // FILE: scripts\skills\actives\legend_piercing_shot_skill.nut
    // context: legend_piercing_shot_skill.::inherit().getTooltip.ret.insert().text
    {
        en = "If the arrow hits its target, it will continue through and damage any target behind, dealing 50% damage."
        es = "Si la flecha acierta, seguirá su trayectoria y dañará a cualquier objetivo que haya detrás, infligiendo un [color=#135213]50%[/color] del daño."
    }
    // FILE: scripts\skills\actives\legend_poison_weapon_skill.nut
    // context: legend_poison_weapon_skill.getTooltip.ret.text
    {
        en = "The next [color=%positive%]4[/color] attacks will apply the Poisoned status effect."
        es = "Los próximos [color=%positive%]4[/color] ataques aplicarán el estado Envenenado."
    }
    // FILE: scripts\skills\actives\legend_prayer_of_faith_skill.nut
    // context: legend_prayer_of_faith_skill.create.m.Description
    {
        en = "Grant defense to your allies with your chant of holy scripture, granting +20% of your resolve as melee and ranged defense. Adjacent undead and cultists are Baffled."
        es = "Protege a tus aliados con tu cántico de las sagradas escrituras: ganan un [color=#135213]+20%[/color] de tu Resolución como Defensa cuerpo a cuerpo y a distancia. Los no muertos y cultistas adyacentes quedan Desconcertados."
    }
    // FILE: scripts\skills\actives\legend_prayer_of_life_skill.nut
    // context: legend_prayer_of_life_skill.create.m.Description
    {
        en = "Push allies on with your chant of holy scripture, restoring the health of all allies within 1 tile by 20% of your resolve. Does not work on cultists. Inflicts a disintegrating ailment on each adjacent undead."
        es = "Alienta a tus aliados con tu cántico de las sagradas escrituras y restaura la salud de todos los aliados a [color=#135213]1[/color] casilla en un [color=#135213]20%[/color] de tu Resolución. No funciona con cultistas. Inflige una dolencia desintegradora a cada no muerto adyacente."
    }
    // FILE: scripts\skills\actives\legend_prepare_bleed_skill.nut
    // context: legend_prepare_bleed_skill.create.m.Description
    {
        en = "Evaluate your enemy, preparing your next attack to leave them bleeding."
        es = "Evalúa a tu enemigo y prepara tu siguiente ataque para dejarlo sangrando."
    }
    // context: legend_prepare_bleed_skill.getTooltip.ret.text
    {
        en = "The next attack will apply the Bleeding status effect."
        es = "El siguiente ataque aplicará el estado Sangrando."
    }
    // FILE: scripts\skills\actives\legend_prepare_graze_skill.nut
    // context: legend_prepare_graze_skill.create.m.Description
    {
        en = "Evaluate your enemy, preparing your next attack to leave them bleeding from multiple grazes."
        es = "Evalúa a tu enemigo y prepara tu siguiente ataque para dejarlo sangrando por múltiples roces."
    }
    // context: legend_prepare_graze_skill.getTooltip.ret.text
    {
        en = "The next attack will apply the Grazed bleeding status effect."
        es = "El siguiente ataque aplicará el estado de sangrado Rozado."
    }
    // FILE: scripts\skills\actives\legend_protect_target_skill.nut
    // context: legend_protect_target_skill.create.m.Description
    {
        en = "Order your pets to protect a target."
        es = "Ordena a tus mascotas que protejan a un objetivo."
    }
    // context: legend_protect_target_skill.getTooltip.ret.text
    {
        en = "Give your pet an order to prioritize protecting target"
        es = "Ordena a tu mascota que dé prioridad a proteger al objetivo"
    }
    // context: legend_protect_target_skill.getTooltip.ret.push().text
    {
        en = "[color=%negative%]This character does not have any unleashed pets[/color]"
        es = "[color=%negative%]Este personaje no tiene ninguna mascota liberada[/color]"
    }
    // context: legend_protect_target_skill.setTarget.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(pet) + " is now protecting " + this.Const.UI.getColorizedEntityName(_t));
        mode = "pattern"
        en = "<pet:str> is now protecting <target:str>"
        es = "<pet> protege ahora a <target>"
    }
    // FILE: scripts\skills\actives\legend_pry_armor_skill.nut
    // context: legend_pry_armor_skill.create.m.Description
    {
        en = "Tear a weak spot in your opponent's armor to reveal a weakspot. Will apply Compromised Armor on every successful hit, which increases damage ignoring armor and armor damage by 20%."
        es = "Abre una brecha en la armadura de tu oponente para dejar al descubierto un punto débil. Aplica Armadura comprometida con cada golpe acertado, lo que aumenta en un [color=#135213]20%[/color] el daño que ignora la armadura y el daño a la armadura."
    }
    // context: legend_pry_armor_skill.create.m.KilledString
    {
        en = "Torn Apart"
        es = "Despedazado"
    }
    // context: legend_pry_armor_skill.setItem.m.Description
    {
        en = "Tear a weak spot in your opponent's armor to reveal a weakspot. Will apply Compromised Armor on every successful hit, which increases damage ignoring armor and armor damage by 20%. Can cover the distance of 2 tiles and can be used from behind the frontline, outside the range of most melee weapons."
        es = "Abre una brecha en la armadura de tu oponente para dejar al descubierto un punto débil. Aplica Armadura comprometida con cada golpe acertado, lo que aumenta en un [color=#135213]20%[/color] el daño que ignora la armadura y el daño a la armadura. Alcanza una distancia de [color=#135213]2[/color] casillas y puede usarse desde detrás de la primera línea, fuera del alcance de la mayoría de las armas cuerpo a cuerpo."
    }
    // context: legend_pry_armor_skill.getTooltip.ret.extend().text
    {
        // text = "Applies [color=%status%]Compromised Armor[/color] on successful hits"
        mode = "pattern"
        en = "Applies [color=%status%]Compromised Armor[/color] on successful hits"
        es = "Aplica [color=%status%]Armadura comprometida[/color] con cada golpe acertado"
    }
    // FILE: scripts\skills\actives\legend_puncture_parry_dagger_skill.nut
    // en = "A well-placed attack at the opponent armor's weakspots. Ignores all armor but is harder to hit with and can not land critical hits for additional damage, nor inflict additional damage with double grip."
    // en base_es
    // en = "Stabbed"
    // en base_es
    // context: legend_puncture_parry_dagger_skill.getTooltip.ret.extend().text
    {
        en = "Hit chance determined by your targets fatigue, 0% if they are fresh and 100% if they are exhausted. If your target is dazed or parried hitchance is increased by +10%.  If they are stunned or netted you gain +25%. If they are grappled or sleeping you gain +50%. Dagger mastery doubles your chance to hit. These bonuses stack up to 100%.  "
        es = "La probabilidad de acierto depende de la Fatiga de tu objetivo: 0% si está fresco y 100% si está agotado. Si tu objetivo está atontado o contrarrestado, la probabilidad de acierto aumenta un [color=#135213]+10%[/color].  Si está aturdido o atrapado en una red, ganas un [color=#135213]+25%[/color]. Si está agarrado o dormido, ganas un [color=#135213]+50%[/color]. El Dominio de la Daga duplica tu probabilidad de acierto. Estas bonificaciones se acumulan hasta el 100%.  "
    }
    // en = "Completely ignores armor"
    // en base_es
    // FILE: scripts\skills\actives\legend_push_forward_skill.nut
    // context: legend_push_forward_skill.create.m.Description
    {
        en = "Advance as one, increasing melee effectiveness of allies nearby."
        es = "Avanza al unísono con los tuyos, aumentando la eficacia cuerpo a cuerpo de los aliados cercanos."
    }
    // context: legend_push_forward_skill.getTooltip.text
    {
        en = "[color=%positive%]+10[/color] melee skill to all allies within [color=%positive%]4[/color] tiles for one turn"
        es = "[color=%positive%]+10[/color] de Habilidad cuerpo a cuerpo para todos los aliados en un radio de [color=%positive%]4[/color] casillas durante un turno"
    }
    // context: legend_push_forward_skill.getTooltip.text
    {
        en = "[color=%positive%]+3[/color] melee defence to all allies within [color=%positive%]4[/color] tiles for one turn"
        es = "[color=%positive%]+3[/color] de Defensa cuerpo a cuerpo para todos los aliados en un radio de [color=%positive%]4[/color] casillas durante un turno"
    }
    // FILE: scripts\skills\actives\legend_push_skill.nut
    // context: legend_push_skill.create.m.Description
    {
        en = "Concoct a mixture of smells so fetid and noxious, you force your target to retreat just so they can breathe. Targets hit will receive fatigue and may take damage if they are pushed down several levels of height. Shieldwall, Spearwall and Riposte will be canceled for a target that is successfully knocked back. A rooted target can not be knocked back. Uses Ranged Skill."
        es = "Prepara una mezcla de olores tan fétida y nociva que obligas a tu objetivo a retroceder solo para poder respirar. Los objetivos alcanzados reciben Fatiga y pueden sufrir daño si son empujados varios niveles de altura hacia abajo. Muro de escudos, Muro de lanzas y Contraataque se cancelan en un objetivo que sea repelido con éxito. Un objetivo enraizado no puede ser repelido. Usa la Habilidad a distancia."
    }
    // en = "<user:str_tag> has knocked back <target:str_tag>"
    // en base_es
    // FILE: scripts\skills\actives\legend_quick_step_skill.nut
    // context: legend_quick_step_skill.create.m.Description
    {
        en = "Exert yourself to move one tile at an unusually quick speed. Can only be used once per turn while outside of zone of control."
        es = "Esfuérzate para moverte una casilla a una velocidad inusualmente rápida. Solo puede usarse una vez por turno y fuera de una zona de control."
    }
    // context: legend_quick_step_skill.getTooltip.ret.push().text
    {
        en = "[color=%negative%]Can only be used when outside an opponent's Zone of Control[/color]"
        es = "[color=%negative%]Solo puede usarse fuera de la Zona de control de un oponente[/color]"
    }
    // context: legend_quick_step_skill.getTooltip.ret.push().text
    {
        en = "[color=%negative%]Can only be used once per turn[/color]"
        es = "[color=%negative%]Solo puede usarse una vez por turno[/color]"
    }
    // FILE: scripts\skills\actives\legend_raise_undead_skill.nut
    // en = "<actor:str_tag> uses Raise Undead"
    // en base_es
    // FILE: scripts\skills\actives\legend_ranged_flail_skill.nut
    // en = "Flailing at an opponent. Somewhat unpredictable in damage, but able to strike over or around shield cover."
    // en base_es
    // en = "Smashed"
    // en base_es
    // FILE: scripts\skills\actives\legend_ranged_lash_skill.nut
    // en = "Aim for an opponent's head. Somewhat unpredictable in damage, but able to strike over or around shield cover with a bit of luck."
    // en base_es
    // FILE: scripts\skills\actives\legend_rat_bite_skill.nut
    // context: legend_rat_bite_skill.create.m.Description
    {
        en = "A vicious bite with a 15% increased chance to hit the head and 100% chance to infect."
        es = "Un mordisco feroz con un [color=#135213]15%[/color] más de probabilidad de alcanzar la cabeza y un [color=#135213]100%[/color] de probabilidad de infectar."
    }
    // context: legend_rat_bite_skill.create.m.KilledString
    {
        en = "Gnawed"
        es = "Roído"
    }
    // FILE: scripts\skills\actives\legend_rat_claws_skill.nut
    // context: legend_rat_claws_skill.create.m.Description
    {
        en = "Tear into flesh with short, sharp claws."
        es = "Desgarra la carne con garras cortas y afiladas."
    }
    // FILE: scripts\skills\actives\legend_read_omens_trance_skill.nut
    // context: legend_read_omens_trance_skill.create.m.Description
    {
        en = "Toggle Read Omens On (+15% reroll on hit)"
        es = "Activa Leer presagios ([color=#135213]+15%[/color] de probabilidad de repetir la tirada de acierto)"
    }
    // context: legend_read_omens_trance_skill.create.m.ToggleOffDescription
    {
        en = "Toggle Read Omens Off"
        es = "Desactiva Leer presagios"
    }
    // FILE: scripts\skills\actives\legend_redback_puncture_skill.nut
    // context: legend_redback_puncture_skill.create.m.Description
    {
        en = "A well-placed attack at the opponent armor's weakspots with redback poison. Ignores all armor and injects the target with poison but is harder to hit with and can not land critical hits for additional damage, nor inflict additional damage with double grip. Poison does not work on undead and you must deal enough damage for the poison to enter the system."
        es = "Un ataque certero a los puntos débiles de la armadura del oponente con veneno de espalda roja. Ignora toda la armadura e inyecta veneno al objetivo, pero es más difícil acertar con él y no puede asestar golpes críticos para infligir daño adicional, ni infligir daño adicional con doble empuñadura. El veneno no funciona con los no muertos y debes infligir daño suficiente para que el veneno entre en el organismo."
    }
    // context: legend_redback_puncture_skill.create.m.KilledString
    {
        en = "Punctured"
        es = "Perforado"
    }
    // context: legend_redback_puncture_skill.getTooltip.ret.extend().text
    {
        en = "Completely ignores armor and applies redback poison, dealing 55 damage over 10 turns. Damage doubled vs targets in a web "
        es = "Ignora totalmente la armadura y aplica veneno de espalda roja, que inflige [color=#135213]55[/color] de daño a lo largo de [color=#135213]10[/color] turnos. Daño doble contra objetivos atrapados en una telaraña "
    }
    // FILE: scripts\skills\actives\legend_relax_skill.nut
    // context: legend_relax_skill.create.m.Description
    {
        en = "You imbue an ally with calm and focus, reducing their fatigue."
        es = "Infundes calma y concentración a un aliado, reduciendo su Fatiga."
    }
    // context: legend_relax_skill.getTooltip.ret.text
    {
        en = "Halves the fatigue of your target"
        es = "Reduce a la mitad la Fatiga de tu objetivo"
    }
    // FILE: scripts\skills\actives\legend_revolt_skill.nut
    // context: legend_revolt_skill.getTooltip.ret.push().text
    {
        en = "Has [color=%negative%]-15%[/color] chance to hit targets directly adjacent, unless specialised in staves"
        es = "Tiene un [color=%negative%]-15%[/color] de probabilidad de acertar a objetivos directamente adyacentes, salvo con especialización en bastones"
    }
    // FILE: scripts\skills\actives\legend_root_skill.nut
    // context: legend_root_skill.create.m.Description
    {
        en = "Unleash roots from the ground to ensnare your target to prevent them from moving or defending themself effectively. Will always hit if the enemy isn't immune. This spell is easier to cast when it's raining."
        es = "Haz brotar raíces del suelo para atrapar a tu objetivo e impedir que se mueva o se defienda con eficacia. Siempre acierta si el enemigo no es inmune. Este hechizo es más fácil de lanzar cuando llueve."
    }
    // FILE: scripts\skills\actives\legend_run_through_skill.nut
    // context: legend_run_through_skill.create.m.Description
    {
        en = "A full forced thrust attack meant to pierce two targets in a straight line."
        es = "Una estocada con toda la fuerza pensada para atravesar a dos objetivos en línea recta."
    }
    // en = "Impaled"
    // en base_es
    // FILE: scripts\skills\actives\legend_rust_skill.nut
    // context: legend_rust_skill.create.m.Description
    {
        en = "Tarnish leather and metal with rapid age, thereby undermining the solidity of the armor worn by your target. Damaged done is based off current initiative.\nHitchcance is determined by Ranged Skill."
        es = "Desgasta el cuero y el metal con un envejecimiento acelerado, debilitando así la solidez de la armadura que lleva tu objetivo. El daño infligido depende de la Iniciativa actual.\nLa probabilidad de acierto depende de la Habilidad a distancia."
    }
    // context: legend_rust_skill.create.m.Overlay
    // en = "rust"  // identificador de la imagen de overlay, no se muestra
    // context: legend_rust_skill.getTooltip.ret.push().text
    {
        // text = "Inflicts [color=%damage%]" + 10 + "[/color] damage to hitpoints that ignores armor"
        mode = "pattern"
        en = "Inflicts [color=%damage%]<damage:int>[/color] damage to hitpoints that ignores armor"
        es = "Inflige [color=%damage%]<damage>[/color] de daño a los Puntos de vida que ignora la armadura"
    }
    // FILE: scripts\skills\actives\legend_safeguard_skill.nut
    // context: legend_safeguard_skill.create.m.Description
    {
        en = "Use your shield to protect an ally, leaving yourself exposed."
        es = "Usa tu escudo para proteger a un aliado, dejándote al descubierto."
    }
    // context: legend_safeguard_skill.getTooltip.ret.push().text
    {
        en = "Applies Safeguard to someone, and will take the next hit instead of them"
        es = "Aplica Salvaguardia a alguien y recibirás el siguiente golpe en su lugar"
    }
    // context: legend_safeguard_skill.getTooltip.ret.push().text
    {
        en = "Reduces your own defenses by [color=%negative%]-10[/color]"
        es = "Reduce tus propias defensas en [color=%negative%]-10[/color]"
    }
    // context: legend_safeguard_skill.onUse.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(_user) + " is safeguarding " + this.Const.UI.getColorizedEntityName(target) + " for one turn");
        mode = "pattern"
        en = "<user:str> is safeguarding <target:str> for one turn"
        es = "<user> protege a <target> durante un turno"
    }
    // FILE: scripts\skills\actives\legend_scry_skill.nut
    // context: legend_scry_skill.create.m.Description
    {
        en = "Gain vision of the surrounding 12 tiles for the duration of the current round."
        es = "Obtén visión de las [color=#135213]12[/color] casillas circundantes durante la ronda actual."
    }
    // context: legend_scry_skill.create.m.Overlay
    // en = "scry"  // identificador de la imagen de overlay, no se muestra
    // FILE: scripts\skills\actives\legend_scry_trance_skill.nut
    // context: legend_scry_trance_skill.create.m.Description
    {
        en = "Toggle Scry Trance On (12 Tile Scry at the beginning of turn until cancelled)"
        es = "Activa Trance de escrutar (Escrutar [color=#135213]12[/color] casillas al inicio de cada turno hasta cancelarlo)"
    }
    // context: legend_scry_trance_skill.create.m.ToggleOffDescription
    {
        en = "Toggle Scry Trance Off"
        es = "Desactiva Trance de escrutar"
    }
    // FILE: scripts\skills\actives\legend_second_wind_skill.nut
    // context: legend_second_wind_skill.create.m.Description
    {
        en = "'I'm not out yet'. Fully refresh your Fatigue, and grant [color=%positive%]+5[/color] Fatigue Recovery for 3 turns. Additionally, remove any [color=#731f39]Stun[/color], [color=#731f39]Daze[/color], [color=#731f39]Stagger[/color], [color=#731f39]Baffle[/color], [color=#731f39]Charmed[/color] or [color=#731f39]Sleeping[/color] status. Can only be used once per combat and is only usable if accumulated fatigue is more than 50% of the maximum."
        es = "'Todavía sigo en pie'. Recupera por completo tu Fatiga y obtén [color=%positive%]+5[/color] de Recuperación de fatiga durante [color=%positive%]3[/color] turnos. Además, elimina cualquier estado [color=#731f39]Aturdido[/color], [color=#731f39]Atontado[/color], [color=#731f39]Tambaleante[/color], [color=#731f39]Desconcertado[/color], [color=#731f39]Encantado[/color] o [color=#731f39]Durmiendo[/color]. Solo puede usarse una vez por combate y solo si la Fatiga acumulada supera el 50% del máximo."
    }
    // context: legend_second_wind_skill.getTooltip.ret.extend().text
    {
        en = "Fully refresh Fatigue"
        es = "Recupera por completo la Fatiga"
    }
    // context: legend_second_wind_skill.getTooltip.ret.extend().text
    {
        en = "[color=%positive%]+5[/color] Fatigue Recovery per turn for [color=%positive%]3[/color] turns"
        es = "[color=%positive%]+5[/color] de Recuperación de fatiga por turno durante [color=%positive%]3[/color] turnos"
    }
    // context: legend_second_wind_skill.getTooltip.ret.extend().text
    {
        en = "Remove [color=#731f39]Stun[/color], [color=#731f39]Daze[/color], [color=#731f39]Stagger[/color], [color=#731f39]Baffle[/color]"
        es = "Elimina [color=#731f39]Aturdido[/color], [color=#731f39]Atontado[/color], [color=#731f39]Tambaleante[/color], [color=#731f39]Desconcertado[/color]"
    }
    // FILE: scripts\skills\actives\legend_shoot_dart_skill.nut
    // context: legend_shoot_dart_skill.create.m.Description
    {
        en = "A quick puff of air to propel a dart. A hit to the head will put the target to sleep, a hit to the body has a 50% chance to daze the target."
        es = "Un soplido rápido para propulsar un dardo. Un impacto en la cabeza dormirá al objetivo; uno en el cuerpo tiene un [color=#135213]50%[/color] de probabilidad de atontarlo."
    }
    // context: legend_shoot_dart_skill.create.m.KilledString
    {
        en = "Darted"
        es = "Alcanzado por un dardo"
    }
    // context: legend_shoot_dart_skill.onTargetHit.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(user) + " struck a hit to the head that leaves " + this.Const.UI.getColorizedEntityName(_targetEntity) + " sleeping");
        mode = "pattern"
        en = "<user:str> struck a hit to the head that leaves <target:str> sleeping"
        es = "<user> acierta en la cabeza y duerme a <target>"
    }
    // context: legend_shoot_dart_skill.onTargetHit.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(user) + " struck a hit to the body that leaves " + this.Const.UI.getColorizedEntityName(_targetEntity) + " dazed");
        mode = "pattern"
        en = "<user:str> struck a hit to the body that leaves <target:str> dazed"
        es = "<user> acierta en el cuerpo y atonta a <target>"
    }
    // FILE: scripts\skills\actives\legend_shoot_precise_stone_skill.nut
    // context: legend_shoot_precise_stone_skill.create.m.Description
    {
        en = "Make an effort to aim for the head with a singluar, precise shot. Can't be used while engaged in melee."
        es = "Esfuérzate por apuntar a la cabeza con un único disparo preciso. No se puede usar mientras se está en combate cuerpo a cuerpo."
    }
    // en = "Stoned"
    // en base_es
    // en = "<user:str_tag> struck a hit that leaves <targetentity:str_tag> dazed"
    // en base_es
    // FILE: scripts\skills\actives\legend_shoot_stone_skill.nut
    // context: legend_shoot_stone_skill.create.m.Description
    {
        en = "Pull back and loose a stone at a target. Can't be used while engaged in melee."
        es = "Tensa y suelta una piedra contra un objetivo. No se puede usar mientras se está en combate cuerpo a cuerpo."
    }
    // context: legend_shoot_stone_skill.onTargetHit.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(user) + " struck a hit that leaves " + this.Const.UI.getColorizedEntityName(_targetEntity) + " confused");
        mode = "pattern"
        en = "<user:str> struck a hit that leaves <target:str> confused"
        es = "<user> asesta un golpe que confunde a <target>"
    }
    // FILE: scripts\skills\actives\legend_siphon_skill.nut
    // context: legend_siphon_skill.create.m.Description
    {
        en = "Siphon the life force from your foe to yourself - replenishing your health and diminishing theirs.\n\nIt will never kill your victim and you can't draw more health than you are missing. Damage drops off over distance and uses Melee Skill to hit."
        es = "Absorbe la fuerza vital de tu enemigo hacia ti: repone tu salud y merma la suya.\n\nNunca matará a tu víctima y no puedes absorber más salud de la que te falta. El daño disminuye con la distancia y usa la Habilidad cuerpo a cuerpo para acertar."
    }
    // context: legend_siphon_skill.getTooltip.text
    {
        en = "Siphons up to [color=%damage%]30%[/color] of targets health to you. Drops by [color=%negative%]5%[/color] for each tile distance."
        es = "Absorbe hasta un [color=%damage%]30%[/color] de la salud del objetivo para ti. Disminuye un [color=%negative%]5%[/color] por cada casilla de distancia."
    }
    // FILE: scripts\skills\actives\legend_skin_ghoul_swallow_whole_skill.nut
    // en = "<user:str_tag> devours <entity:str_tag>"
    // en base_es
    // FILE: scripts\skills\actives\legend_sling_heavy_stone_skill.nut
    // context: legend_sling_heavy_stone_skill.create.m.Description
    {
        en = "Hurl a stone towards a target with your sling. Hard to aim and very unwieldy, but stones are everywhere so you never run out of ammunition. Can not be used while engaged in melee."
        es = "Lanza una piedra contra un objetivo con tu honda. Difícil de apuntar y muy aparatosa, pero hay piedras por todas partes, así que nunca te quedarás sin munición. No se puede usar mientras se está en combate cuerpo a cuerpo."
    }
    // context: legend_sling_heavy_stone_skill.getTooltip.ret.push().text
    {
        en = "Has a [color=%negative%]100%[/color] chance to stun and daze target on a hit to the head if not immune and always staggers the target"
        es = "Tiene un [color=%positive%]100%[/color] de probabilidad de aturdir y atontar al objetivo con un impacto en la cabeza si no es inmune, y siempre lo hace tambalearse"
    }
    // context: legend_sling_heavy_stone_skill.getTooltip.ret.push().text
    {
        en = "Has a [color=%negative%]100%[/color] chance to daze a target on a hit to the head and always staggers the target"
        es = "Tiene un [color=%positive%]100%[/color] de probabilidad de atontar al objetivo con un impacto en la cabeza, y siempre lo hace tambalearse"
    }
    // FILE: scripts\skills\actives\legend_slingstaff_bash_skill.nut
    // context: legend_slingstaff_bash_skill.create.m.Description
