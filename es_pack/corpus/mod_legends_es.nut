    // context: ::Legends.Rune.LegendRsaResilience.::Legends.Runes.add().Tooltip
    {
        en = "\n[color=%negative%]This rune is not supposed to drop, if you see this, post bug report.[/color]\n\nThis item has the power of the rune sigil of Resilience:\n[color=%positive%]Immune[/color] to stuns, knockbacks and grabs.\n	"
        es = "\n[color=%negative%]Esta runa no debería aparecer como botín; si la ves, envía un informe de error.[/color]\n\nEste objeto posee el poder del sello rúnico de Resiliencia:\n[color=%positive%]Inmune[/color] a aturdimientos, empujones y agarres.\n	"
    }
