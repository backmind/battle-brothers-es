    // FILE: scripts\items\misc\legend_witch_leader_hair_item.nut
    // context: legend_witch_leader_hair_item.create.m.Name
    {
        en = "Witch Leader Hair"
        es = "Cabello de bruja líder"
    }
    // context: legend_witch_leader_hair_item.create.m.Description
    {
        en = "Long and brittle strands of glowing hair taken from a Hexe Leader. Their hair is said to have powerful properties in creating potions and elixirs. But then again, it's also said that Hexen keep the genitals of their victims as pets, so information attained from the peasantry might not be especially reliable."
        es = "Mechones largos y quebradizos de cabello resplandeciente tomados de una Hexe líder. Se dice que su cabello tiene poderosas propiedades para crear pociones y elixires. Pero claro, también se dice que las Hexen mantienen los genitales de sus víctimas como mascotas, por lo que la información obtenida del campesinado podría no ser especialmente confiable."
    }
    // FILE: scripts\items\misc\legend_wolfsbane_item.nut
    // context: legend_wolfsbane_item.create.m.Name
    {
        en = "Wolfsbane"
        es = "Acónito"
    }
    // context: legend_wolfsbane_item.create.m.Description
