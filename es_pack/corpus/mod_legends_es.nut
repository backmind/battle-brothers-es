        // text = "Company Strength: " + this.World.State.getPlayer().getStrength()
        mode = "pattern"
        en = "Company Strength: <strength:str>"
        es = "Fuerza de la compañía: <strength>"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.push().text
    {
        // text = "L" + bro.Level + "  " + bro.Name + " (" + bro.Background + ")"
        mode = "pattern"
        en = "L<level:int>  <name:str> (<bg:str>)"
        es = "N<level>  <name> (<bg>)"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.push().text
    {
        // text = "... and " + (data.Brothers.len() - brothersLimit) + " others."
        mode = "pattern"
