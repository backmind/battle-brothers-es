        es = ""
    }
    // context: legend_parrying_dagger.getTooltip.result.insert().text
    {
        // text = "Chance to hit head [color=%positive%]+" + this.m.ChanceToHitHead + "%[/color]"
        mode = "pattern"
        en = "Chance to hit head [color=%positive%]+<this.m.ChanceToHitHead>%[/color]"
        es = ""
    }
