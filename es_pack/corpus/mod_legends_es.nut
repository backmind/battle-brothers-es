    }
    // FILE: scripts\skills\traits\legend_appetite_donkey.nut
    // context: legend_appetite_donkey.create.m.Name
    {
        en = "Appetite of a donkey"
        es = "Apetito de burro"
    }
    // context: legend_appetite_donkey.create.m.Description
    {
        en = "This character has a huge appetite and will eat anything. Better bring extra provisions when traveling with this character and expect them to leave fast if you ever run out of provisions entirely."
        es = "Este personaje tiene un apetito enorme y se come cualquier cosa. Más vale llevar provisiones de sobra cuando viajes con este personaje, y cuenta con que se marchará enseguida si alguna vez te quedas sin provisiones por completo."
    }
    // context: legend_appetite_donkey.create.m.Titles
    {
        en = "the Ass"
        es = "el Asno"
    }
    // context: legend_appetite_donkey.create.m.Titles
    {
        en = "the Donkey"
        es = "el Burro"
    }
    // context: legend_appetite_donkey.create.m.Titles
    {
        en = "the Jackass"
        es = "el Borrico"
    }
    // FILE: scripts\skills\traits\legend_arena_champion_trait.nut
    // context: legend_arena_champion_trait.create.m.Name
    {
        en = "Arena Champion"
        es = "Campeón de la Arena"
    }
    // context: legend_arena_champion_trait.create.m.Description
    {
        en = "Every man and woman in the area stand secretly wants to be %fullname%, children play in streets dressed and fighting like %they% does. As they should."
        es = "Todos los hombres y mujeres de las gradas desean en secreto ser %fullname%, y los niños juegan en las calles a vestirse y pelear como %el%. Como debe ser."
    }
    // en = "all"
    // en base_es
    // en = "<description:str> So far, this character has fought in <matches:int> matches and won <won:int> of them."
    // en base_es
    // context: legend_arena_champion_trait.getTooltip.text
    {
        en = "[color=%positive%]+15[/color] Resolve"
        es = "[color=%positive%]+15[/color] Resolución"
    }
    // context: legend_arena_champion_trait.getTooltip.text
    {
        en = "[color=%positive%]+5[/color] Hitpoints"
        es = "[color=%positive%]+5[/color] Puntos de vida"
    }
    // context: legend_arena_champion_trait.getTooltip.text
    {
        en = "[color=%positive%]+5%[/color] Damage"
        es = "[color=%positive%]+5%[/color] Daño"
    }
    // context: legend_arena_champion_trait.getTooltip.text
    {
        en = "Has a [color=%positive%]50%[/color] chance to survive if struck down and not killed by a fatality"
        es = "Tiene un [color=%positive%]50%[/color] de probabilidad de sobrevivir si cae en combate y no muere por un golpe fatal"
    }
    // FILE: scripts\skills\traits\legend_arena_invictus_trait.nut
    // context: legend_arena_invictus_trait.create.m.Name
    {
        en = "Invictus"
        es = "Invictus"
    }
    // context: legend_arena_invictus_trait.create.m.Description
    {
        en = "With a single fist raised, %fullname% stops the crowd cheering. With both raised, they shout %their% name from the stands. Gladiators rather wrestle a Lindwurm than fight %them% in the arena."
        es = "Con un solo puño en alto, %fullname% acalla los vítores del público. Con los dos en alto, la multitud corea su nombre desde las gradas. Los Gladiadores prefieren pelear a brazo partido con un Lindwurm antes que enfrentarse a %el% en la arena."
    }
    // context: legend_arena_invictus_trait.getTooltip.ret.text
    {
        en = "[color=%positive%]+18[/color] Resolve"
        es = "[color=%positive%]+18[/color] Resolución"
    }
    // context: legend_arena_invictus_trait.getTooltip.ret.text
    {
        en = "[color=%positive%]+10[/color] Hitpoints"
        es = "[color=%positive%]+10[/color] Puntos de vida"
    }
    // context: legend_arena_invictus_trait.getTooltip.ret.push().text
    {
        en = "Increases the penalty to the morale check from fearsome by [color=%positive%]10%[/color] of your arena wins"
        es = "Aumenta la penalización de Temible a la tirada de moral en un [color=%positive%]10%[/color] de tus victorias en la arena"
    }
    // context: legend_arena_invictus_trait.getTooltip.ret.push().text
    {
        en = "Any attack that inflicts at least 1 point of damage to hitpoints triggers a morale check for the opponent with a penalty equal to [color=%positive%]10%[/color] of your arena wins"
        es = "Cualquier ataque que inflija al menos 1 punto de daño a los Puntos de vida provoca una tirada de moral al rival con una penalización igual al [color=%positive%]10%[/color] de tus victorias en la arena"
    }
    // FILE: scripts\skills\traits\legend_beastslayers_trait.nut
    // context: legend_beastslayers_trait.create.m.Name
    {
        en = "Natural Order"
        es = "Orden natural"
    }
    // context: legend_beastslayers_trait.create.m.Description
    {
        en = "Nature is not for the faint of heart — those that dwell on the fringes of society not only thrive in the danger, but know the natural order of things will eat them alive. Quite literally."
        es = "La naturaleza no es para los pusilánimes: quienes viven en los márgenes de la sociedad no solo prosperan en el peligro, sino que saben que el orden natural de las cosas los devorará vivos. Literalmente."
    }
    // context: legend_beastslayers_trait.getTooltip.text
    {
        en = "[color=%positive%]+5[/color] Resolve when in battle with beasts"
        es = "[color=%positive%]+5[/color] Resolución en combate contra bestias"
    }
    // context: legend_beastslayers_trait.getTooltip.text
    {
        en = "[color=%positive%]+10%[/color] Melee damage when in battle with beasts"
        es = "[color=%positive%]+10%[/color] Daño cuerpo a cuerpo en combate contra bestias"
    }
    // context: legend_beastslayers_trait.getTooltip.text
    {
        en = "[color=%positive%]+10%[/color] Ranged damage when in battle with beasts"
        es = "[color=%positive%]+10%[/color] Daño a distancia en combate contra bestias"
    }
    // FILE: scripts\skills\traits\legend_brothers_in_chains_trait.nut
    // context: legend_brothers_in_chains_trait.create.m.Name
    {
        en = "United in Chains"
        es = "Unidos en cadenas"
    }
    // context: legend_brothers_in_chains_trait.create.m.Description
    {
        en = "This character has formed a bond with other former slaves. For every other Indebted on the field, this character gets [color=%positive%]+1[/color] Melee Skill, Ranged Skill, Melee Defense, Ranged Defense, and Resolve."
        es = "Este personaje ha forjado un vínculo con otros antiguos esclavos. Por cada Endeudado más en el campo de batalla, este personaje obtiene [color=%positive%]+1[/color] a Habilidad cuerpo a cuerpo, Habilidad a distancia, Defensa cuerpo a cuerpo, Defensa a distancia y Resolución."
    }
    // FILE: scripts\skills\traits\legend_cannibalistic.nut
    // context: legend_cannibalistic.create.m.Name
    {
        en = "Cannibalistic"
        es = "Caníbal"
    }
    // context: legend_cannibalistic.create.m.Description
    {
        en = "This character has tasted forbidden meat and has since developed a craving for it."
        es = "Este personaje ha probado la carne prohibida y desde entonces la ansía."
    }
    // FILE: scripts\skills\traits\legend_deathly_spectre_trait.nut
    // context: legend_deathly_spectre_trait.create.m.Name
    {
        en = "Deathly spectre"
        es = "Espectro mortal"
    }
    // context: legend_deathly_spectre_trait.create.m.Description
    {
        en = "The shadow of undeath follows this character due to having a necromancer nearby, they will probably be resurrected after death but retain any injuries sustained."
        es = "La sombra de la no muerte persigue a este personaje por tener cerca a un nigromante; probablemente resucitará tras morir, pero conservará las heridas sufridas."
    }
    // context: legend_deathly_spectre_trait.create.m.Titles
    {
        en = "the Forsaken"
        es = "el Desamparado"
    }
    // context: legend_deathly_spectre_trait.create.m.Titles
    {
        en = "the Dying"
        es = "el Moribundo"
    }
    // context: legend_deathly_spectre_trait.getTooltip.text
    {
        en = "Has a [color=%positive%]66%[/color] chance to be resurrected as undead when killed, any injuries will be retained"
        es = "Tiene un [color=%positive%]66%[/color] de probabilidad de resucitar como no muerto al morir; conservará todas las heridas"
    }
    // FILE: scripts\skills\traits\legend_double_tongued_trait.nut
    // context: legend_double_tongued_trait.create.m.Name
    {
        en = "Double tongued"
        es = "Lengua bífida"
    }
    // context: legend_double_tongued_trait.create.m.Description
    {
        en = "The nature of humanity brings out the destructive side in many, however this one appears to be worse than the usual."
        es = "La naturaleza humana saca a relucir el lado destructivo de muchos, pero en este personaje parece peor de lo habitual."
    }
    // context: legend_double_tongued_trait.getTooltip.text
    {
        en = "Has a [color=%negative%]5%[/color] chance to start ranting about the inevitability of entropy and depress company morale at the start of a combat"
        es = "Tiene un [color=%negative%]5%[/color] de probabilidad de ponerse a despotricar sobre la inevitabilidad de la entropía y hundir la moral de la compañía al inicio de un combate"
    }
    // context: legend_double_tongued_trait.getTooltip.text
    {
        en = "Mercenaries who are Pessimistic, Superstitious, Paranoid, Traumatized, or have a Deathwish are strangely inspired by these dark speeches and gain [color=%positive%]+2[/color] Action Points"
        es = "Los mercenarios Pesimistas, Supersticiosos, Paranoicos, Traumatizados o Temerarios se sienten extrañamente inspirados por estos discursos sombríos y obtienen [color=%positive%]+2[/color] Puntos de acción"
    }
    // context: legend_double_tongued_trait.getTooltip.text
    {
        en = "Considers death unavoidable, experiences no morale check when allies die"
        es = "Considera que la muerte es inevitable; no hace tiradas de moral cuando mueren aliados"
    }
    // FILE: scripts\skills\traits\legend_fear_dark_trait.nut
    // context: legend_fear_dark_trait.create.m.Name
    {
        en = "Nyctophobia"
        es = "Nictofobia"
    }
    // context: legend_fear_dark_trait.create.m.Description
    {
        en = "A dislike of the dark can be a childish fear for some, but with what's been running around in the wilds lately, maybe it isn't as odd anymore..."
        es = "Para algunos, la aversión a la oscuridad puede ser un miedo infantil, pero con lo que anda suelto últimamente por las tierras salvajes, quizá ya no sea tan raro..."
    }
    // context: legend_fear_dark_trait.getTooltip.text
    {
        en = "[color=%negative%]-10[/color] Resolve during Nighttime"
        es = "[color=%negative%]-10[/color] Resolución de noche"
    }
    // context: legend_fear_dark_trait.getTooltip.text
    {
        en = "[color=%negative%]-20[/color] Resolve when attacked by mental effects during Nighttime"
        es = "[color=%negative%]-20[/color] Resolución frente a ataques con efectos mentales de noche"
    }
    // context: legend_fear_dark_trait.getTooltip.text
    {
        en = "[color=%positive%]+5[/color] Resolve during daytime"
        es = "[color=%positive%]+5[/color] Resolución de día"
    }
    // FILE: scripts\skills\traits\legend_fear_nobles_trait.nut
    // context: legend_fear_nobles_trait.create.m.Name
    {
        en = "Fear of Nobles"
        es = "Miedo a los Nobles"
    }
    // context: legend_fear_nobles_trait.create.m.Description
    {
        en = "Some past event or particularly convincing story in this character's life has left them scared of what nobles are capable of, making this character less reliable when facing nobles on the battlefield."
        es = "Algún evento pasado o historia particularmente convincente en la vida de este personaje le ha infundido miedo a lo que los nobles son capaces de hacer, lo que vuelve a este personaje menos confiable al enfrentarse a nobles en el campo de batalla."
    }
    // context: legend_fear_nobles_trait.getTooltip.text
    {
        en = "[color=%negative%]-10[/color] Resolve when in battle with nobles"
        es = "[color=%negative%]-10[/color] Resolución en combate contra nobles"
    }
    // context: legend_fear_nobles_trait.getTooltip.text
    {
        en = "[color=%negative%]-5%[/color] Melee Skill when in battle with nobles"
        es = "[color=%negative%]-5%[/color] Habilidad cuerpo a cuerpo en combate contra nobles"
    }
    // context: legend_fear_nobles_trait.getTooltip.text
    {
        en = "[color=%negative%]-5%[/color] Ranged Skill when in battle with nobles"
        es = "[color=%negative%]-5%[/color] Habilidad a distancia en combate contra nobles"
    }
    // FILE: scripts\skills\traits\legend_fleshless_trait.nut
    // context: legend_fleshless_trait.create.m.Name
    {
        en = "Fleshless"
        es = "Descarnado"
    }
    // context: legend_fleshless_trait.create.m.Description
    {
        en = "Only bones remain, with all skin rotten or torn away."
        es = "Solo quedan los huesos; toda la piel se ha podrido o ha sido arrancada."
    }
    // context: legend_fleshless_trait.getTooltip.ret.text
    {
        en = "Immune to Bleeding, poison and most fresh injuries."
        es = "Inmune al sangrado, al veneno y a la mayoría de las heridas recientes."
    }
    // context: legend_fleshless_trait.getTooltip.ret.text
    {
        en = "Recovers hitpoints at only 20% of the normal rate. Requires no food and has resistance to piercing type attacks."
        es = "Recupera Puntos de vida a solo un 20% del ritmo normal. No necesita comida y es resistente a los ataques perforantes."
    }
    // context: legend_fleshless_trait.getTooltip.ret.text
    {
        en = "Effected by fatigue at 10% normal rate."
        es = "La Fatiga le afecta a un 10% del ritmo normal."
    }
    // context: legend_fleshless_trait.getTooltip.ret.text
    {
        en = "Not affected by morale checks or allies fleeing or dying."
        es = "No le afectan las pruebas de moral ni que sus aliados huyan o mueran."
    }
    // en = "Not affected by nighttime penalties"
    // en base_es
    // FILE: scripts\skills\traits\legend_gift_of_people_trait.nut
    // context: legend_gift_of_people_trait.create.m.Name
    {
        en = "Charming"
        es = "Carismático"
    }
    // context: legend_gift_of_people_trait.create.m.Description
    {
        en = "Some say you can get almost anywhere with a trustworthy demenor and a warm smile."
        es = "Hay quien dice que con un porte digno de confianza y una sonrisa cálida se puede llegar casi a cualquier parte."
    }
    // context: legend_gift_of_people_trait.getTooltip.text
    {
        en = "Has a [color=%positive%]10%[/color] chance to boost up company morale at the start of a combat"
        es = "Tiene un [color=%positive%]10%[/color] de probabilidad de levantar la moral de la compañía al inicio de un combate"
    }
    // FILE: scripts\skills\traits\legend_hate_nobles_trait.nut
    // context: legend_hate_nobles_trait.create.m.Name
    {
        en = "Hate for Nobles"
        es = "Odio por los Nobles"
    }
    // context: legend_hate_nobles_trait.create.m.Description
    {
        en = "Some past event in this character's life has fueled a burning hatred for all things upper class"
        es = "Algún evento pasado en la vida de este personaje ha alimentado un odio ardiente por todo lo que huela a clase alta"
    }
    // context: legend_hate_nobles_trait.getTooltip.text
    {
        en = "[color=%positive%]+10[/color] Resolve when in a battle against nobles"
        es = "[color=%positive%]+10[/color] Resolución en combate contra nobles"
    }
    // context: legend_hate_nobles_trait.getTooltip.text
    {
        en = "[color=%positive%]+5%[/color] Melee Skill when in a battle against nobles"
        es = "[color=%positive%]+5%[/color] Habilidad cuerpo a cuerpo en combate contra nobles"
    }
    // context: legend_hate_nobles_trait.getTooltip.text
    {
        en = "[color=%positive%]+5%[/color] Ranged Skill when in a battle against nobles"
        es = "[color=%positive%]+5%[/color] Habilidad a distancia en combate contra nobles"
    }
    // FILE: scripts\skills\traits\legend_heavy_trait.nut
    // context: legend_heavy_trait.create.m.Name
    {
        en = "Lumbering"
        es = "Pesado"
    }
    // context: legend_heavy_trait.create.m.Description
    {
        en = "Being exceptionally purposeful, this character's strikes hurt plenty, but they're also slower."
        es = "Este personaje golpea con una determinación excepcional: sus golpes duelen mucho, pero también son más lentos."
    }
    // en = "the Ox"
    // en base_es
    // context: legend_heavy_trait.create.m.Titles
    {
        en = "the Iron"
        es = "el Férreo"
    }
    // en = "the Tower"
    // en base_es
    // en = "the Bull"
    // en base_es
    // context: legend_heavy_trait.getTooltip.text
    {
        en = "[color=%negative%]-20[/color] Initiative"
        es = "[color=%negative%]-20[/color] Iniciativa"
    }
    // FILE: scripts\skills\traits\legend_horse_trait.nut
    // context: legend_horse_trait.create.m.Description
    {
        en = "A horse eats more than humans, can't wear human armor, moves much better on flat terrain, but worse on rough terrain"
        es = "Un caballo come más que un humano, no puede llevar armadura humana y se mueve mucho mejor en terreno llano, pero peor en terreno accidentado"
    }
    // context: legend_horse_trait.create.m.Titles
    {
        en = "the Horse"
        es = "el Caballo"
    }
    // en = "the Stallion"
    // en base_es
    // context: legend_horse_trait.create.m.Titles
    {
        en = "the Mare"
        es = "la Yegua"
    }
    // FILE: scripts\skills\traits\legend_inquisition_disciple_trait.nut
    // context: legend_inquisition_disciple_trait.create.m.Name
    {
        en = "Disciple of the Inquisition"
        es = "Discípulo de la Inquisición"
    }
    // context: legend_inquisition_disciple_trait.create.m.Description
    {
        // corrige base: «Acepta» rebaja «embraces» (es «Abraza») y «como si lo acercaran» añade una duda que el inglés no tiene («as bringing him closer»: los ve como lo que lo acerca a la salvación)
        en = "This character is a disciple of the Old Gods, an individual with unquestionable loyalty to the faith. They embrace physical pain and peril as bringing them closer to salvation."
        es = "Este personaje sigue las enseñanzas de los Viejos Dioses; es un individuo con una lealtad incuestionable a la fe. Abraza el dolor físico y el peligro como pasos hacia la salvación."
    }
    // context: legend_inquisition_disciple_trait.getTooltip.text
    {
        en = "[color=%positive%]+20[/color] Hitpoints"
        es = "[color=%positive%]+20[/color] Puntos de vida"
    }
    // en = "Is not affected by fresh injuries sustained during the current battle"
    // en base_es
    // FILE: scripts\skills\traits\legend_intensive_training_trait.nut
    // context: legend_intensive_training_trait.create.m.Name
    {
        en = "Training progress"
        es = "Progreso del entrenamiento"
    }
    // context: legend_intensive_training_trait.create.m.Description
    {
        en = "This character has some military training but will take time to find their feet.\n Place them in the training camp to hone their skills. Training progress points will be earned over time.\n At 15 points, this character will gain a perk point and one positive trait relevant to their combat style.\n\n [color=%negative%]You can only gain training progress points with the upgraded training tent in your stash![/color]"
        es = "Este personaje tiene algo de instrucción militar, pero necesitará tiempo para adaptarse.\n Asígnale la tienda de entrenamiento del campamento para que pula sus habilidades. Con el tiempo irá ganando puntos de progreso del entrenamiento.\n Al llegar a 15 puntos, este personaje obtendrá un punto de ventaja y un rasgo positivo acorde con su estilo de combate.\n\n [color=%negative%]¡Solo puedes ganar puntos de progreso del entrenamiento si tienes la tienda de entrenamiento mejorada en tu alijo![/color]"
    }
    // context: legend_intensive_training_trait.finishedTraining.m.Description
