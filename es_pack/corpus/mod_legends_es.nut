    // FILE: scripts\skills\actives\legend_cat_bite_skill.nut
    // en = "Mangled"
    // en base_es
    // FILE: scripts\skills\actives\legend_catapult_boulder_skill.nut
    // context: legend_catapult_boulder_skill.create.m.Description
    {
        en = "Hurl a boulder towards a target with your catapult. Hard to aim and very unwieldy, but boulders are everywhere so you never run out of ammunition. Can not be used while engaged in melee."
        es = "Lanza una roca contra un objetivo con tu catapulta. Es difícil de apuntar y muy aparatosa, pero hay rocas por todas partes, así que nunca te quedas sin munición. No se puede usar mientras se está trabado en combate cuerpo a cuerpo."
    }
    // en = "Crushed"
    // en base_es
    // en = "<actor:str_tag> struck a blow that leaves <victim:str_tag> dazed"
    // en base_es
    // FILE: scripts\skills\actives\legend_chain_lightning_skill.nut
    // context: legend_chain_lightning_skill.create.m.Description
    {
        en = "Unleash an arcing barrage that strikes an opponent, sending sparks from opponent to opponent. Fatigue and action costs from staff mastery. "
        es = "Desata una descarga en arco que golpea a un oponente y salta en chispas de un oponente a otro. Costes de Fatiga y de acción según la maestría con bastón. "
    }
    // en = "Electrocuted"
    // en base_es
    // context: legend_chain_lightning_skill.getTooltip.rangeBonus
