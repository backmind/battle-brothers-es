        es = "Llevará [color=%positive%]<hours>[/color] horas tratar todas las heridas en cola."
    }
    // context: healer_building.getModifierToolip.ret.text
    {
        // text = "It will take [color=%positive%]" + this.Math.ceil(this.m.PointsNeeded / this.getRate()) + "[/color] hours to heal all healthpoints."
        mode = "pattern"
        en = "It will take [color=%positive%]<hours:int>[/color] hours to heal all healthpoints."
        es = "Llevará [color=%positive%]<hours>[/color] horas recuperar todos los puntos de vida."
    }
    // context: healer_building.getModifierToolip.ret.text
    {
        // text = "Total healing modifier is [color=%positive%]" + this.m.Rate * 100.0 + "%[/color]."
        mode = "pattern"
