        es = "[img]gfx/ui/icons/fatigue_va11.png[/img] <fat_min> a <fat_max>&nbsp;&nbsp;&nbsp;[img]gfx/ui/icons/ranged_skill_va11.png[/img] <rskill_min> a <rskill_max>"
