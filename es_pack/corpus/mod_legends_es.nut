        en = "Usable up to two tiles away if the middle tiles are empty (height difference up to 1 allowed)"
        es = "Se puede usar hasta a dos casillas de distancia si las casillas intermedias están vacías (se permite una diferencia de altura de hasta 1)"
    }
    // context: legend_enraged_hyena_bite_skill.getTooltip.tooltip.push().text
    {
        en = "On hit: retreats and drags the target away, immobilizing them"
        es = "Al acertar: retrocede y arrastra al objetivo, inmovilizándolo"
    }
    // context: legend_enraged_hyena_bite_skill.getTooltip.tooltip.push().text
    {
        en = "Target defenses are halved while held"
        es = "Las defensas del objetivo se reducen a la mitad mientras está atrapado"
    }
    // context: legend_enraged_hyena_bite_skill.getTooltip.tooltip.push().text
    {
        en = "A melee hit on the hyena frees the victim"
        es = "Un golpe cuerpo a cuerpo a la hiena libera a la víctima"
    }
