    {
        en = "Every man and woman in the area stand secretly wants to be them, children play in streets dressed and fighting like they do. As they should."
        es = "Todos los hombres y mujeres de las gradas desean en secreto estar en su lugar, y los niños juegan en las calles imitando su forma de vestir y de pelear. Como debe ser."
    }
    // context: tooltip_events.o.onQueryUIElementTooltipData.desc
    {
        en = "With a single fist raised, the stops crowd cheering. With both raised, they shout their name from the stands. Gladiators rather wrestle a Lindwurm than fight them in the arena."
        es = "Con un solo puño en alto, el público deja de vitorear. Con los dos en alto, corean su nombre desde las gradas. Los gladiadores preferirían luchar contra un Lindwurm antes que vérselas con semejante rival en la arena."
    }
