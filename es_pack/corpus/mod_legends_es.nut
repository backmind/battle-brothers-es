    // FILE: scripts\entity\world\camp\buildings\hunter_building.nut
    // context: hunter_building.create.m.Slot
    // en = "hunt"  // identificador interno de la casilla del edificio en el campamento, no se muestra
    // context: hunter_building.create.m.Name
    {
        en = "Camp Kitchen"
        es = "Cocina del campamento"
    }
    // context: hunter_building.create.m.Description
    {
        en = "A kitchen tent with supplies for hunting, preparing and cooking food"
        es = "Una tienda de cocina con suministros para cazar, preparar y cocinar alimentos"
    }
    // context: hunter_building.setMode._m
    // en = "integer"  // resultado de typeof en una comprobación de tipo, no se muestra
    // context: hunter_building.getDescription
    {
        en = "Hunting parties can only be sent out while encamped. The more people assigned, the more food foraged or hunted. "
        es = "Las partidas de caza solo pueden salir mientras se está acampado. Cuantas más personas asignadas, más comida se recolecta o se caza. "
    }
    // context: hunter_building.getDescription
    {
        en = "Returns different food items depending on the current biome. Some items require the knowledge of specific backgrounds to be obtainable."
        es = "Proporciona distintos alimentos según el bioma actual. Algunos solo se pueden obtener con los conocimientos de trasfondos concretos."
    }
    // context: hunter_building.getDescription
    {
        // @composicion: getDescription suma literales y format() con getColorized(t, c) = "[color=" + c + "]" + t + "[/color]";
        // Rosetta ve la suma entera. La lista de trasfondos la une arrayToText con "and" y sale en ingles.
        mode = "pattern"
        en = "Hunting parties can only be sent out while encamped. The more people assigned, the more food foraged or hunted. Returns different food items depending on the current biome. Some items require the knowledge of specific backgrounds to be obtainable.\n\nAssigning mercenaries with [color=<c1:str>]Expert Hunter[/color] backgrounds increases the [color=<c2:str>]Hunt Tier[/color] (based on each character's level), which allows the hunting party to hunt rarer or more dangerous prey.\nAssigning mercenaries with the [color=<c3:str>]Meal Preparation[/color] perk gives a chance to yield [color=<c4:str>]improved versions[/color] of the obtained food items.\nAssigning mercenaries with the [color=<c5:str>]Alcohol Brewing[/color] perk gives a chance to yield [color=<c6:str>]wine and beer[/color]. \n\nUpgrading this tent grants the following effects:\n- Increases foraging / hunting speed by [color=<c7:str>]15%[/color]\n- Unlock the [color=<c8:str>]Hunting Mode[/color] button, allowing you to customize the priorities of the hunting party\n- Increases the chance to obtain bonus loot, improved food items, and brewed items\n- Assigning [color=<c9:str>]Expert Hunter[/color] backgrounds increases the [color=<c10:str>]Hunt Tier[/color] at a much greater rate\n- [color=<c11:str>]Expert Hunters[/color] have a chance to obtain [color=<c12:str>]bonus loot[/color] from hunting, such as trophies or crafting ingredients\n- Assigning [color=<c13:str>]cooking backgrounds[/color] slightly increases the chance to yield [color=<c14:str>]improved versions[/color] of obtained food items even without the Meal Preparation perk\n- Assigning [color=<c15:str>]cooking backgrounds[/color] slightly increases the chance to yield [color=<c16:str>]brewed items[/color] even without the Alcohol Brewing perk\n- [color=<c17:str>]Brewers[/color] can also produce [color=<c18:str>]mead[/color]\n- Advanced food can also be made using spices in the [color=<c19:str>]crafting[/color] tent\n\nExpert Hunter backgrounds: <bgs:str>\n\nCooking backgrounds: Miller / Baker, Butcher / Fishmonger, Servant, Cannibal"
        es = "Las partidas de caza solo pueden salir mientras se está acampado. Cuantas más personas asignadas, más comida se recolecta o se caza. Proporciona distintos alimentos según el bioma actual. Algunos solo se pueden obtener con los conocimientos de trasfondos concretos.\n\nAsignar mercenarios con trasfondos de [color=<c1>]Cazador experto[/color] aumenta el [color=<c2>]Nivel de caza[/color] (según el nivel de cada personaje), lo que permite a la partida de caza perseguir presas más raras o peligrosas.\nAsignar mercenarios con la ventaja [color=<c3>]Preparación de comidas[/color] da la posibilidad de obtener [color=<c4>]versiones mejoradas[/color] de los alimentos conseguidos.\nAsignar mercenarios con la ventaja [color=<c5>]Destilación de alcohol[/color] da la posibilidad de obtener [color=<c6>]vino y cerveza[/color]. \n\nMejorar esta tienda otorga los siguientes efectos:\n- Aumenta un [color=<c7>]15%[/color] la velocidad de recolección / caza\n- Desbloquea el botón [color=<c8>]Modo de caza[/color], que permite ajustar las prioridades de la partida de caza\n- Aumenta la probabilidad de obtener botín extra, alimentos mejorados y bebidas elaboradas\n- Asignar trasfondos de [color=<c9>]Cazador experto[/color] aumenta el [color=<c10>]Nivel de caza[/color] mucho más deprisa\n- Los [color=<c11>]Cazadores expertos[/color] pueden obtener [color=<c12>]botín extra[/color] al cazar, como trofeos o ingredientes de fabricación\n- Asignar [color=<c13>]trasfondos de cocina[/color] aumenta un poco la probabilidad de obtener [color=<c14>]versiones mejoradas[/color] de los alimentos conseguidos, incluso sin la ventaja Preparación de comidas\n- Asignar [color=<c15>]trasfondos de cocina[/color] aumenta un poco la probabilidad de obtener [color=<c16>]bebidas elaboradas[/color], incluso sin la ventaja Destilación de alcohol\n- Los [color=<c17>]Destiladores[/color] también pueden producir [color=<c18>]hidromiel[/color]\n- Con especias también se puede preparar comida avanzada en la tienda de [color=<c19>]fabricación[/color]\n\nTrasfondos de Cazador experto: <bgs>\n\nTrasfondos de cocina: Molinero / Panadero, Carnicero / Pescadero, Sirviente, Caníbal"
    }
    // context: hunter_building.getDescription
    {
        // Respaldo de la regla anterior: si la lista de trasfondos no tiene par, el :t falla
        // y Rosetta pasa a esta, que deja la lista en inglés y traduce el resto.
        mode = "pattern"
        en = "Hunting parties can only be sent out while encamped. The more people assigned, the more food foraged or hunted. Returns different food items depending on the current biome. Some items require the knowledge of specific backgrounds to be obtainable.\n\nAssigning mercenaries with [color=<c1:str>]Expert Hunter[/color] backgrounds increases the [color=<c2:str>]Hunt Tier[/color] (based on each character's level), which allows the hunting party to hunt rarer or more dangerous prey.\nAssigning mercenaries with the [color=<c3:str>]Meal Preparation[/color] perk gives a chance to yield [color=<c4:str>]improved versions[/color] of the obtained food items.\nAssigning mercenaries with the [color=<c5:str>]Alcohol Brewing[/color] perk gives a chance to yield [color=<c6:str>]wine and beer[/color]. \n\nUpgrading this tent grants the following effects:\n- Increases foraging / hunting speed by [color=<c7:str>]15%[/color]\n- Unlock the [color=<c8:str>]Hunting Mode[/color] button, allowing you to customize the priorities of the hunting party\n- Increases the chance to obtain bonus loot, improved food items, and brewed items\n- Assigning [color=<c9:str>]Expert Hunter[/color] backgrounds increases the [color=<c10:str>]Hunt Tier[/color] at a much greater rate\n- [color=<c11:str>]Expert Hunters[/color] have a chance to obtain [color=<c12:str>]bonus loot[/color] from hunting, such as trophies or crafting ingredients\n- Assigning [color=<c13:str>]cooking backgrounds[/color] slightly increases the chance to yield [color=<c14:str>]improved versions[/color] of obtained food items even without the Meal Preparation perk\n- Assigning [color=<c15:str>]cooking backgrounds[/color] slightly increases the chance to yield [color=<c16:str>]brewed items[/color] even without the Alcohol Brewing perk\n- [color=<c17:str>]Brewers[/color] can also produce [color=<c18:str>]mead[/color]\n- Advanced food can also be made using spices in the [color=<c19:str>]crafting[/color] tent\n\nExpert Hunter backgrounds: <lista:str>\n\nCooking backgrounds: Miller / Baker, Butcher / Fishmonger, Servant, Cannibal"
        es = "Las partidas de caza solo pueden salir mientras se está acampado. Cuantas más personas asignadas, más comida se recolecta o se caza. Proporciona distintos alimentos según el bioma actual. Algunos solo se pueden obtener con los conocimientos de trasfondos concretos.\n\nAsignar mercenarios con trasfondos de [color=<c1>]Cazador experto[/color] aumenta el [color=<c2>]Nivel de caza[/color] (según el nivel de cada personaje), lo que permite a la partida de caza perseguir presas más raras o peligrosas.\nAsignar mercenarios con la ventaja [color=<c3>]Preparación de comidas[/color] da la posibilidad de obtener [color=<c4>]versiones mejoradas[/color] de los alimentos conseguidos.\nAsignar mercenarios con la ventaja [color=<c5>]Destilación de alcohol[/color] da la posibilidad de obtener [color=<c6>]vino y cerveza[/color]. \n\nMejorar esta tienda otorga los siguientes efectos:\n- Aumenta un [color=<c7>]15%[/color] la velocidad de recolección / caza\n- Desbloquea el botón [color=<c8>]Modo de caza[/color], que permite ajustar las prioridades de la partida de caza\n- Aumenta la probabilidad de obtener botín extra, alimentos mejorados y bebidas elaboradas\n- Asignar trasfondos de [color=<c9>]Cazador experto[/color] aumenta el [color=<c10>]Nivel de caza[/color] mucho más deprisa\n- Los [color=<c11>]Cazadores expertos[/color] pueden obtener [color=<c12>]botín extra[/color] al cazar, como trofeos o ingredientes de fabricación\n- Asignar [color=<c13>]trasfondos de cocina[/color] aumenta un poco la probabilidad de obtener [color=<c14>]versiones mejoradas[/color] de los alimentos conseguidos, incluso sin la ventaja Preparación de comidas\n- Asignar [color=<c15>]trasfondos de cocina[/color] aumenta un poco la probabilidad de obtener [color=<c16>]bebidas elaboradas[/color], incluso sin la ventaja Destilación de alcohol\n- Los [color=<c17>]Destiladores[/color] también pueden producir [color=<c18>]hidromiel[/color]\n- Con especias también se puede preparar comida avanzada en la tienda de [color=<c19>]fabricación[/color]\n\nTrasfondos de Cazador experto: <lista>\n\nTrasfondos de cocina: Molinero / Panadero, Carnicero / Pescadero, Sirviente, Caníbal"
    }
    // context: hunter_building.getDescription
    {
        en = "Upgrading this tent grants the following effects:\n"
        es = "Mejorar esta tienda otorga los siguientes efectos:\n"
    }
    // context: hunter_building.getDescription.format()
    {
        // desc += format(
        //    "- Increases foraging / hunting speed by %s\n",
        //    ::Const.UI.getColorized("15%",::Const.UI.Color.PositiveValue)
        mode = "pattern"
        en = "- Increases foraging / hunting speed by <pct:str>\n"
