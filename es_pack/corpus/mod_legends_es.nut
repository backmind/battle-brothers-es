        mode = "pattern"
        en = "<::Const.LegendMod.Language.arrayToText(poachers, and, ::Const.UI.Color.getHighlightDarkBackgroundValue()) + ::Const.LegendMod.Language.pluralize(poachers.len(),  leaves,  leave)> your party"
        es = ""
