    // FILE: scripts\skills\backgrounds\legend_berserker_background.nut
    // context: legend_berserker_background.create.m.BackgroundDescription
    {
        en = "Hailing from the north, berserkers are often feared even among the wildmen and the barbarians. Incredibly hardy and often maddened from the overuse of mushrooms, they almost rival orcs in raw strength."
        es = "Originarios del norte, los berserkers son temidos a menudo incluso entre los salvajes y los bárbaros. Increíblemente resistentes y a menudo enloquecidos por el abuso de setas, casi rivalizan con los orcos en fuerza bruta."
    }
    // en = "the Berserker"
    // en base_es
    // context: legend_berserker_background.create.m.Titles
    {
        en = "the Crazed"
        es = "el Enloquecido"
    }
    // context: legend_berserker_background.create.m.Titles
    {
        en = "the Uncontrollable"
        es = "el Incontrolable"
    }
    // context: legend_berserker_background.create.m.Titles
    {
        en = "the Frenzied"
        es = "el Frenético"
    }
    // FILE: scripts\skills\backgrounds\legend_berserker_commander_background.nut
    // context: legend_berserker_commander_background.onAdded.actor.setTitle()
    {
        en = "The Berserker"
        es = "El Berserker"
    }
    // FILE: scripts\skills\backgrounds\legend_blacksmith_background.nut
    // context: legend_blacksmith_background.create.m.BackgroundDescription
    {
        en = "Blacksmiths tend to be strong and are skilled at repairing equipment."
        es = "Los herreros suelen ser fuertes y hábiles reparando equipo."
    }
    // context: legend_blacksmith_background.create.m.GoodEnding
    {
        en = "Perhaps one of the strongest men you've ever met, %name% the blacksmith was a vital asset in the %companyname%, repairing both their own equipment and that of their comrades with practiced hands. With plenty of crowns stored, he retired from fighting and blacksmithing both. Last you heard he was living out their years comfortably on the coast."
        es = "Quizá uno de los hombres más fuertes que hayas conocido, %name% el herrero fue una pieza fundamental de %companyname%: reparaba con manos expertas tanto su propio equipo como el de sus camaradas. Con muchas coronas ahorradas, se retiró del combate y también de la herrería. Lo último que supiste es que vivía cómodamente sus años en la costa."
    }
    // context: legend_blacksmith_background.create.m.BadEnding
    {
        en = "%name% the blacksmith was a strong and capable sellsword in the %companyname%. He held out until the bitter end, sticking with the company as it lurched from one disaster to the next. Perhaps, had he been born in a different time he would have gone on to do great things, making legendary weapons for regal kings. Instead, many wars, invasions, and plagues spreading across the land ultimately ensured %name% and many other talented men went to total waste."
        es = "%name% el herrero fue un mercenario fuerte y capaz de %companyname%. Aguantó hasta el amargo final, fiel a la compañía mientras esta se tambaleaba de un desastre al siguiente. Quizá, de haber nacido en otra época, habría llegado a hacer grandes cosas, forjando armas legendarias para reyes majestuosos. En cambio, las muchas guerras, invasiones y plagas que se extendieron por estas tierras acabaron por echar a perder del todo a %name% y a muchos otros hombres de talento."
    }
    // context: legend_blacksmith_background.create.m.Titles
    {
        en = "Iron-arm"
        es = "Brazo de Hierro"
    }
    // context: legend_blacksmith_background.create.m.Titles
    {
        en = "the Blacksmith"
        es = "el Herrero"
    }
    // context: legend_blacksmith_background.create.m.Titles
    {
        en = "the Bladesmith"
        es = "el Espadero"
    }
    // context: legend_blacksmith_background.create.m.Titles
    {
        en = "the Armorer"
        es = "el Armero"
    }
    // en = "the Hammer"
    // en base_es
    // context: legend_blacksmith_background.create.m.Titles
    {
        en = "the Burly"
        es = "el Fornido"
    }
    // context: legend_blacksmith_background.create.m.Titles
    {
        en = "the Smith"
        es = "el Forjador"
    }
    // context: legend_blacksmith_background.create.m.Titles
    {
        en = "the Metalsmith"
        es = "el Forjametales"
    }
    // context: legend_blacksmith_background.setGender.m.Name
    {
        en = "Farrier"
        es = "Herrador"
    }
    // context: legend_blacksmith_background.setGender.m.BackgroundDescription
    {
        en = "Everyone needs shoes — and the same applies to four legs, not just two."
        es = "Todo el mundo necesita zapatos, y eso vale también para quien anda a cuatro patas, no solo a dos."
    }
    // context: legend_blacksmith_background.setGender.m.GoodEnding
    {
        en = "Perhaps one of the strongest women you've ever met, %name% the blacksmith was a vital asset in the %companyname%, repairing both their own equipment and that of their comrades with practiced hands. With plenty of crowns stored, she retired from fighting and blacksmithing both. Last you heard she was living out their years comfortably on the coast."
        es = "Quizá una de las mujeres más fuertes que hayas conocido, %name% la herrera fue una pieza fundamental de %companyname%: reparaba con manos expertas tanto su propio equipo como el de sus camaradas. Con muchas coronas ahorradas, se retiró del combate y también de la herrería. Lo último que supiste es que vivía cómodamente sus años en la costa."
    }
    // context: legend_blacksmith_background.setGender.m.BadEnding
    {
        en = "%name% the blacksmith was a strong and capable sellsword in the %companyname%. She held out until the bitter end, sticking with the company as it lurched from one disaster to the next. Perhaps, had she been born in a different time she would have gone on to do great things, making legendary weapons for regal kings. Instead, many wars, invasions, and plagues spreading across the land ultimately ensured %name% and many other talented women went to total waste."
        es = "%name% la herrera fue una mercenaria fuerte y capaz de %companyname%. Aguantó hasta el amargo final, fiel a la compañía mientras esta se tambaleaba de un desastre al siguiente. Quizá, de haber nacido en otra época, habría llegado a hacer grandes cosas, forjando armas legendarias para reyes majestuosos. En cambio, las muchas guerras, invasiones y plagas que se extendieron por estas tierras acabaron por echar a perder del todo a %name% y a muchas otras mujeres de talento."
    }
    // context: legend_blacksmith_background.onBuildDescription
    {
        en = "{Most every town has a resident blacksmith, | The local blacksmith is always an important person in the village, | Key to the success of any town is the skills of its resident blacksmith,} {%name% needed to repair tools of every kind and the equipment of the local militia. | Vital to the maintenance of sword and plow alike. | relied upon by the whole village for tools of every sort, from horseshoes to axes.} {%name%, learning from %their% father, was the resident blacksmith of %townname%. | Understanding this, %name% took up an apprenticeship in %randomtown% and, once having mastered the craft, settled down as the blacksmith of %townname%. | The son of one such blacksmith, %name% was forced into the profession by %their% overzealous father, though %they% cared little for it. | Hastily trained during a greenskin incursion, %name% eventually settled down as one such blacksmith, in %townname%. | %name% was one such blacksmith.} {Unfortunately, %name%'s partner was killed in a freak accident. Unable to remain in %townname% any longer, %name% sold all they had and left, wandering aimlessly. Eventually they found %themselves% in the company of sellswords, where %their% strong arms and hammer accustomed hands drew great interest. | Feeling %their% years wear away, %name% was overcome by restlessness, and they decided to set out as a mercenary, where %their% strong arms could be of different use. | After many years %name% was nearly killed by greenskin raiders, escaping only by blind chance. Thoroughly shaken, %name% quit %their% job at the village, determined to learn all they could of warfare and battlecraft so that greenskins would never menace them again.}"
        es = "{Casi todos los pueblos tienen su propio herrero, | El herrero local siempre es una persona importante en la aldea, | La clave del éxito de cualquier pueblo está en la destreza de su herrero,} {y %name% tenía que reparar herramientas de todo tipo y el equipo de la milicia local. | vital para el mantenimiento tanto de la espada como del arado. | pues toda la aldea depende de él para herramientas de todo tipo, desde herraduras hasta hachas.} {%name%, que aprendió de su padre, era %art% herrer%o% de %townname%. | Consciente de ello, %name% entró de aprendiz en %randomtown% y, una vez dominado el oficio, se estableció como herrer%o% de %townname%. | Hij%o% de uno de esos herreros, %name% se vio obligad%o% a ejercer el oficio por un padre demasiado entusiasta, aunque a %el% le importaba poco. | Formad%o% a toda prisa durante una incursión de pieles verdes, %name% acabó estableciéndose como herrer%o% en %townname%. | %name% era precisamente herrer%o%.} {Por desgracia, la pareja de %name% murió en un accidente absurdo. Incapaz de seguir en %townname%, %name% vendió todo lo que tenía y se marchó a vagar sin rumbo. Con el tiempo acabó entre mercenarios, donde sus brazos fuertes y sus manos hechas al martillo despertaron gran interés. | Al sentir el paso de los años, %name% se vio dominad%o% por la inquietud y decidió hacerse mercenari%o%, donde sus fuertes brazos tendrían otro uso. | Tras muchos años, unos saqueadores pieles verdes estuvieron a punto de matar a %name%, que escapó por pura suerte. Profundamente afectad%o%, %name% dejó su trabajo en la aldea, decidid%o% a aprender todo lo posible sobre la guerra y el arte del combate para que los pieles verdes no volvieran a amenazar%lo% jamás.}"
    }
    // FILE: scripts\skills\backgrounds\legend_bladedancer_background.nut
    // en = "Bladedancer"
    // en base_es
    // context: legend_bladedancer_background.create.m.BackgroundDescription
    {
        en = "A skilled nomadic fighter of the south who prefers speed and reach over raw power."
        es = "Hábil combatiente nómada del sur que prefiere la velocidad y el alcance a la fuerza bruta."
    }
    // context: legend_bladedancer_background.create.m.GoodEnding
    {
        en = "%name% found themselves in the possession of more crowns they their family had accumulated across six generations. Despite this, the bladedancer returned to the desert and used their wealth to train the next generation of bladedancers as their tutor did before them."
        es = "%name% se encontró con más coronas de las que su familia había acumulado en seis generaciones. Aun así, volvió al desierto y empleó su fortuna en formar a la siguiente generación de danzantes de espadas, como antes había hecho su maestro."
    }
    // context: legend_bladedancer_background.create.m.BadEnding
    {
        en = "The pride and glory went to the head of %name% after you left. Last you heard they broke from the company and travelled alone challenging champions in crownling companies to single combat. You never heard from them ever again."
        es = "El orgullo y la gloria se le subieron a la cabeza a %name% después de que te marcharas. Lo último que supiste es que dejó la compañía y viajó en solitario, desafiando a combate singular a los campeones de las compañías de cuentacoronas. Nunca más volviste a saber de %name%."
    }
    // context: legend_bladedancer_background.create.m.Titles
    {
        en = "the Desert Devil"
        es = "el Diablo del Desierto"
    }
    // context: legend_bladedancer_background.create.m.Titles
    {
        en = "Dunestalker"
        es = "Acechadunas"
    }
    // context: legend_bladedancer_background.create.m.Titles
    {
        en = "the Chosen One"
        es = "el Elegido"
    }
    // context: legend_bladedancer_background.onBuildDescription
    {
        en = "{The South is brimming with slaves, and those not among their ranks should be considered lucky. Outside of the walls of southern society %name% was born into a nameless nomadic tribe and made a living off the land. Every year the natural bounty of nature becomes slimmer and the walls of the city states expand further into their homeland.}"
        es = "{El sur rebosa de esclavos, y quienes no se cuentan entre ellos deberían considerarse afortunados. Fuera de las murallas de la sociedad sureña, %name% nació en una tribu nómada sin nombre y se ganó la vida con lo que daba la tierra. Cada año la generosidad de la naturaleza es más escasa y las murallas de las ciudades-estado se adentran más en su tierra natal.}"
    }
    // FILE: scripts\skills\backgrounds\legend_bounty_hunter_background.nut
    // en = "Bounty Hunter"
    // en base_es
    // context: legend_bounty_hunter_background.create.m.BackgroundDescription
    {
        en = "Bounty Hunters are solitary in nature who prefer more direct means to that of assassins. Anyone who is brave enough to walk the roads and take coin alone is either a fool or has more than meets the eye to them"
        es = "Los cazarrecompensas son solitarios por naturaleza y prefieren métodos más directos que los de los asesinos. Quien tiene el valor de recorrer los caminos y cobrar en solitario o es un necio o esconde más de lo que aparenta"
    }
    // context: legend_bounty_hunter_background.create.m.GoodEnding
    {
        en = "%name% stayed with the company a while longer after you left, eventually retiring to a quieter life. %They% settled in the mountains and discovered a hidden talent for raising wolves. %They% lived a long life separated from those %they% once hunted, surrounded by a new family of %their% own."
        es = "%name% siguió un tiempo más con la compañía después de que te marcharas y acabó retirándose a una vida más tranquila. Se estableció en las montañas y descubrió un talento oculto para criar lobos. Vivió una larga vida alejad%o% de aquellos a quienes antes cazaba, rodead%o% de una nueva familia propia."
    }
    // context: legend_bounty_hunter_background.create.m.BadEnding
    {
        en = "Like the shifting sands, %name% quickly moved elsewhere after the company collapsed. %They% found it difficult to return to %their% craft after making so many enemies in both the north and the south. Standing alone once again, one too many killers sent in the night eventually wore %them% down. Like %their% past, %they% simply vanished into the background."
        es = "Como las dunas que el viento cambia de sitio, %name% se marchó enseguida a otra parte tras el hundimiento de la compañía. Le costó volver a su oficio después de haberse ganado tantos enemigos en el norte y en el sur. De nuevo en solitario, a la larga los asesinos enviados de noche fueron demasiados y acabaron por desgastar%lo%. Como su pasado, simplemente se desvaneció en el olvido."
    }
    // context: legend_bounty_hunter_background.onBuildDescription
    {
        en = "{The growing number of thieves, outlaws and miscreants creates steady work for those who wish to put their lives on the line. | From the noble houses to the gilded southern states, everyone wants someone else dead or missing at the end of the day. | A profession attempted by many but mastered by few — bounty hunters have made a living on catching dangerous people. | The steady growth of cities always makes way for new work, and the work involved in catching those who do not wish to be found has been perfected into an art form by %name%.} {Their profession transcends that of the manhunters, who have become weak catching those who cannot fight back. | Ever curious, %name% is more of a walking toolkit than a person — %their% knives, vials, ropes and other assorted implements mark that of a character who veers between paranoid and well prepared. | %They% bears scars of past contracts but assures you that nobody has escaped %them% yet. | Surprisingly educated, %name% is adept at identifying what direction the wind is blowing, when the next rain will fall and how many steps it would take before an average man collapses from exhaustion.} {Mercenary work for %them% is what %they% do normally, but perhaps with more distractions and shorter marches. | While tough, %name% is calm and reserved enough to make anyone feel uneasy. | While %their% past is a mystery, %their% skill set is impossible to ignore. Having %them% on the payroll is a small price to pay to avoid meeting %them% as an adversary down the line. | %name% treads a fine line between upholding a contract at all costs and hunting down even the lowliest nomad or beggar for coin. | Many see bounty hunters as no better than manhunters. The difference being that nobody would admit it openly to a bounty hunter.}"
        es = "{El número creciente de ladrones, forajidos y malhechores da trabajo constante a quienes están dispuestos a jugarse la vida. | Desde las casas nobles hasta los dorados estados del sur, todo el mundo quiere a alguien muerto o desaparecido al final del día. | Una profesión que muchos intentan pero pocos dominan: los cazarrecompensas se ganan la vida atrapando a gente peligrosa. | El crecimiento constante de las ciudades siempre abre paso a nuevos trabajos, y %name% ha convertido en arte el de atrapar a quienes no quieren ser encontrados.} {Su oficio está por encima del de los cazadores de hombres, que se han vuelto débiles atrapando a quienes no pueden defenderse. | Siempre curios%o%, %name% es más una caja de herramientas andante que una persona: sus cuchillos, frascos, cuerdas y demás utensilios delatan a alguien que oscila entre la paranoia y la buena preparación. | Lleva las cicatrices de contratos pasados, pero te asegura que nadie se le ha escapado todavía. | Sorprendentemente cult%o%, %name% sabe determinar hacia dónde sopla el viento, cuándo caerá la próxima lluvia y cuántos pasos daría un hombre corriente antes de desplomarse de agotamiento.} {Para %el%, el trabajo de mercenario es lo que hace normalmente, aunque quizá con más distracciones y marchas más cortas. | Aunque es dur%o%, %name% tiene una calma y una reserva capaces de inquietar a cualquiera. | Aunque su pasado es un misterio, sus habilidades son imposibles de ignorar. Tener%lo% en nómina es un precio pequeño por no encontrárte%lo% como adversari%o% más adelante. | %name% camina por la delgada línea entre cumplir un contrato a toda costa y dar caza por unas monedas hasta al nómada o al mendigo más humilde. | Muchos ven a los cazarrecompensas como poco mejores que los cazadores de hombres. La diferencia es que nadie se atrevería a decírselo abiertamente a un cazarrecompensas.}"
    }
    // FILE: scripts\skills\backgrounds\legend_cannibal_background.nut
    // context: legend_cannibal_background.create.m.BackgroundDescription
    {
        en = "Cannibals have a thing for human flesh."
        es = "Los caníbales sienten debilidad por la carne humana."
    }
    // context: legend_cannibal_background.create.m.Titles
    {
        en = "the Cannibal"
        es = "el Caníbal"
    }
    // context: legend_cannibal_background.getTooltip.ret.push().text
    {
        en = "Cannibals provide Human Parts after a fight, likes hanging out with butchers, may try to eat others. Increased results when assigned to hunting in camp."
        es = "Los caníbales proporcionan Despojos humanos tras un combate, les gusta pasar el rato con carniceros y puede que intenten comerse a otros. Mejores resultados al asignarlos a cazar en el campamento."
    }
    // context: legend_cannibal_background.onBuildDescription
    {
        en = "{An odd man, %name% looks at your men oddly, as if an animal eyeing its next meal. | While speaking to him, %name% politely offers you some jerky, which you rapidly decline. | %name% is avoided by everyone else in the town, and he licks his lips hungrily as you approach. | %name% is a known name in the world, for they say wherever he goes, children seem to go missing. | Some men are murderers, some are monsters, %name% is a terrifying mix of both. | As you speak to %name%, a passing monk makes the sign of evil and holds his cross tight. | %name% claims to have exquisite tastes, taste in what, however, he does not say. | %name% is perhaps one of the friendliest people you've ever met, yet you almost feel as if he is buttering you up. | You found %name% licking his fingers and pointedly not mentioning what meal was so delicious. | Many killers have excuses, but %name% can not bring up a single one when you realize what he is. | A sad creature, %name% seems perpetually hungry, yet refuses all of your food.} { %name% claims he simply wishes to serve man. | %name% assures you that your company will find no trouble from him. | %name% tells you one of the funniest jokes you've ever heard, but even you find the subject matter too disturbing to justify laughter. | He loudly laughs at the mention of Gods, claiming that no living God would allow something like him to walk this world. | You hear the clattering of bones from within one of his pouch, to which he tells you are for the memories. | His downright pleasant nature disturbs you, for there is nothing pleasant about what this man is. | The other brothers caution you about bringing him into the company, but he assures you that he will never harm his brothers. Unless ordered, at least. | You threaten to skewer him when he mentions how healthy you look, to which he quickly claims was just a passing compliment.} { Despite it all, %name% is good with a sword, and claims he rarely goes hungry. | A butcher like him will no doubt have little trouble carving the living. | %name% has doubtless had some experience butchering the living before. | Desperate times call for desperate measures, but how desperate are you to hire someone like this? | While some of his… skills… may be tempting, you know if you hire him you'll never sleep soundly as long as he lives. | The fact that creatures such as this exist makes you want to wretch, but would many not say the same of you? | He eyes you queerly, as if he knows some secret joke that you never will. | When you are done speaking with him, he keeps talking. Quietly. To himself. You do not like what you hear.}"
        es = "{Hombre raro, %name% mira a tus hombres de un modo extraño, como un animal que le echa el ojo a su próxima comida. | Mientras hablas con él, %name% te ofrece amablemente un poco de cecina, que rechazas al instante. | Todo el mundo en el pueblo evita a %name%, que se relame con hambre cuando te acercas. | El nombre de %name% es conocido en el mundo, pues dicen que allá donde va parecen desaparecer niños. | Algunos hombres son asesinos, otros son monstruos; %name% es una mezcla aterradora de ambas cosas. | Mientras hablas con %name%, un monje que pasa hace la señal contra el mal y aprieta con fuerza su cruz. | %name% afirma tener gustos exquisitos; gustos en qué, eso no lo dice. | %name% es quizá una de las personas más amables que hayas conocido, pero casi tienes la sensación de que te está engatusando. | Encontraste a %name% chupándose los dedos y evitando con cuidado mencionar qué comida estaba tan deliciosa. | Muchos asesinos tienen excusas, pero %name% no es capaz de dar ni una sola cuando te das cuenta de lo que es. | Una criatura lamentable: %name% parece tener hambre siempre, pero rechaza toda tu comida.} { %name% asegura que solo desea servir al hombre. | %name% te asegura que tu compañía no tendrá ningún problema con él. | %name% te cuenta uno de los chistes más graciosos que hayas oído, pero hasta a ti el tema te resulta demasiado perturbador para justificar una carcajada. | Se ríe a carcajadas cuando se mencionan los dioses y asegura que ningún dios vivo permitiría que algo como él caminara por este mundo. | Oyes un traqueteo de huesos dentro de una de sus bolsas; según él, son para los recuerdos. | Su carácter francamente agradable te inquieta, porque no hay nada agradable en lo que es este hombre. | Los demás hermanos te advierten de que no lo metas en la compañía, pero él asegura que nunca hará daño a sus hermanos. Salvo que se lo ordenen, claro. | Amenazas con ensartarlo cuando comenta lo sano que pareces, y él se apresura a decir que solo era un cumplido.} { Pese a todo, %name% maneja bien la espada y asegura que rara vez pasa hambre. | No cabe duda de que a un carnicero como él no le costará mucho trinchar a los vivos. | Sin duda, %name% ya tiene algo de experiencia descuartizando a los vivos. | A grandes males, grandes remedios, pero ¿hasta qué punto estás desesperado como para contratar a alguien así? | Aunque algunas de sus… habilidades… puedan resultar tentadoras, sabes que si lo contratas no volverás a dormir tranquilo mientras viva. | El hecho de que existan criaturas así te da ganas de vomitar, pero ¿no dirían muchos lo mismo de ti? | Te mira de forma rara, como si conociera un chiste secreto que tú nunca entenderás. | Cuando terminas de hablar con él, sigue hablando. En voz baja. Consigo mismo. No te gusta lo que oyes.}"
    }
    // FILE: scripts\skills\backgrounds\legend_companion_melee_background.nut
    // context: legend_companion_melee_background.create.m.BackgroundDescription
    {
        en = "This one has lost all interest in glory and gold. With nothing else to prove but to themselves."
        es = "Ha perdido todo interés por la gloria y el oro. Ya no tiene nada que demostrarle a nadie más que a su propia persona."
    }
    // context: legend_companion_melee_background.create.m.GoodEnding
    {
        en = "After {not much  more time | much more time later | a lifetime adrift | a short while | a few more months} after your retirement, %name% found {interest | their calling with | some hope with | work with} a {preacher | thief | vagabond | wildman | wise woman | crusader | odd trio of kids | haughty nobleman | ranger | people's militia | cultist band | northern raiding party | group of escaped slaves | hunting party of manhunters}, their time with you taught them {everything | most of what | all | a bit of what} they needed to survive in their new employment. They never spoke your name, but {their memory of you never faded | they go on to greater things in your memory}."
        es = "{Poco tiempo después de | Mucho tiempo después de | Tras toda una vida a la deriva desde | Al poco de | Unos meses después de} tu retiro, %name% encontró {interés en | su vocación con | algo de esperanza con | trabajo con} {un predicador | un ladrón | un vagabundo | un salvaje | una curandera | un cruzado | un extraño trío de críos | un noble altivo | un guardabosques | una milicia popular | una banda de cultistas | una partida de saqueadores del norte | un grupo de esclavos fugados | una partida de caza de cazadores de hombres}; el tiempo que pasó contigo le enseñó {todo lo que | casi todo lo que | todo cuanto | algo de lo que} necesitaba para sobrevivir en su nuevo empleo. Nunca pronunció tu nombre, pero {su recuerdo de ti nunca se desvaneció | llegó a hacer cosas más grandes en memoria tuya}."
    }
    // context: legend_companion_melee_background.create.m.BadEnding
    {
        en = "Does it matter what happens to a single man or woman? As skilled as %name% was, they never made their mark with your early departure from %companyname%."
        es = "¿Importa lo que le ocurra a un solo hombre o a una sola mujer? Por mucha destreza que tuviera %name%, nunca llegó a dejar huella tras tu temprana marcha de %companyname%."
    }
    // context: legend_companion_melee_background.onBuildDescription
    {
        en = "{Unnaturally skilled, | Born almost a master already, | Skilled enough to be considered supernatural,} {%name% has worked hard to refine their natural talent. | %name% has managed to stay above ground by honing their natural skill. | %name% claims their skill is as natural as yours.} {Eitherway, %they% demonstrates a honed mind and body to match. | They twirl a blade with an ease that would take years for you to learn yourself. | Hailing from %randomtown%, they have gone far and wide to test their skills. | Urged by %their% parents to stay away from knights and mercenaries, they took time to travel and see the world. | One thing has led to another, %they% can barely recall what led them here in the first place.} {With no interest in work for crowns, %name% has found it fitting to join you on your journey. | Likely to be used as fodder, bait or a shield made of flesh by any mercenary company, %name% decided to stick with you instead. | %name% has much more to learn still, and your journey through the lands is the best way to test their skills.}"
        es = "{Con una destreza antinatural, | Nacid%o% casi maestr%o%, | Con tanta destreza que podría considerarse sobrenatural,} {%name% ha trabajado duro para pulir su talento natural. | %name% ha logrado seguir con vida perfeccionando su destreza natural. | %name% asegura que su destreza es tan natural como la tuya.} {En cualquier caso, demuestra una mente y un cuerpo igual de templados. | Hace girar una espada con una soltura que a ti te llevaría años aprender. | Natural de %randomtown%, ha recorrido tierras lejanas para poner a prueba su destreza. | Aunque sus padres le insistieron en que se mantuviera alejad%o% de caballeros y mercenarios, se tomó su tiempo para viajar y ver mundo. | Una cosa llevó a la otra, y apenas recuerda qué %lo% trajo aquí en un principio.} {Sin interés por trabajar a cambio de coronas, %name% ha creído oportuno acompañarte en tu viaje. | Como cualquier compañía de mercenarios %lo% usaría de carne de cañón, de cebo o de escudo de carne, %name% ha decidido quedarse contigo. | A %name% le queda mucho por aprender, y tu viaje por estas tierras es la mejor forma de poner a prueba su destreza.}"
    }
    // FILE: scripts\skills\backgrounds\legend_companion_ranged_background.nut
    // context: legend_companion_ranged_background.onBuildDescription
    {
        en = "{Unnaturally skilled, | Born almost a master already, | Skilled enough to be considered supernatural,} {%name% has worked hard to refine their natural talent. | %name% has managed to stay above ground by honing their natural skill. | %name% claims their skill is as natural as yours.} {Eitherway, %they% demonstrates a honed mind and body to match. | They pull and notch their bowstring with an ease that would take years for you to learn yourself. | Hailing from %randomtown%, they have gone far and wide to test their skills. | Urged by %their% parents to stay away from knights and mercenaries, they took time to travel and see the world. | One thing has led to another, %they% can barely recall what led them here in the first place.} {With no interest in work for crowns, %name% has found it fitting to join you on your journey. | Likely to be used as fodder, bait or a shield made of flesh by any mercenary company, %name% decided to stick with you instead. | %name% has much more to learn still, and your journey through the lands is the best way to test their skills.}"
        es = "{Con una destreza antinatural, | Nacid%o% casi maestr%o%, | Con tanta destreza que podría considerarse sobrenatural,} {%name% ha trabajado duro para pulir su talento natural. | %name% ha logrado seguir con vida perfeccionando su destreza natural. | %name% asegura que su destreza es tan natural como la tuya.} {En cualquier caso, demuestra una mente y un cuerpo igual de templados. | Tensa la cuerda y encoca la flecha con una soltura que a ti te llevaría años aprender. | Natural de %randomtown%, ha recorrido tierras lejanas para poner a prueba su destreza. | Aunque sus padres le insistieron en que se mantuviera alejad%o% de caballeros y mercenarios, se tomó su tiempo para viajar y ver mundo. | Una cosa llevó a la otra, y apenas recuerda qué %lo% trajo aquí en un principio.} {Sin interés por trabajar a cambio de coronas, %name% ha creído oportuno acompañarte en tu viaje. | Como cualquier compañía de mercenarios %lo% usaría de carne de cañón, de cebo o de escudo de carne, %name% ha decidido quedarse contigo. | A %name% le queda mucho por aprender, y tu viaje por estas tierras es la mejor forma de poner a prueba su destreza.}"
    }
    // FILE: scripts\skills\backgrounds\legend_conjurer_background.nut
    // context: legend_conjurer_background.create.m.Name
    {
        en = "Conjurer"
        es = "Conjurador"
    }
    // context: legend_conjurer_background.create.m.Titles
    {
        en = "the Creator"
        es = "el Creador"
    }
    // context: legend_conjurer_background.create.m.Titles
    {
        en = "Beastfriend"
        es = "Amigo de las Bestias"
    }
    // context: legend_conjurer_background.create.m.Titles
    {
        en = "Wolfspeaker"
        es = "Hablalobos"
    }
    // context: legend_conjurer_background.create.m.Titles
    {
        en = "Birdsong"
        es = "Canto de Pájaro"
    }
    // context: legend_conjurer_background.create.m.Titles
    {
        en = "Beastfolk"
        es = "Pueblo Bestia"
    }
    // context: legend_conjurer_background.create.m.Titles
    {
        en = "The wild"
        es = "el Salvaje"
    }
    // context: legend_conjurer_background.onBuildDescription
    {
        en = "{ %name% is a practicioner of the dark arts. |  %name% carries a slumped posture, as if weighted by otherworldly knowledge. | %name%'s face is transformed from its natural withered form | Not much is known about %name%, but strange rumors of sorcery and dark arts follow. | Wherever animals mysteriously begin to die, %name% makes an appearance. | The brooches on %name%'s cloak seem to swirl and dance like midnight in a jug. | %name%'s hands are rare to see, only coming out as if to portray the feelings of a face which lies hidden deep in its hood. | %name%'s eyes could be mistaken for a cat's one day and for a blind man's the next.} {Little is known of their history | their past i but a mystery to most. | Some say they traveled deep into the northern foothills, returning with unspoken knowledge. | Ostensibly, the dark arts are their heritage, or so it seems. | Their past is kept from all. Maybe it's just uninteresting, or maybe just the opposite. | One rumor  says she traveled the land as a spellweaver. | Rumors of magic surround the woman, though some incredulous cynics are hardly impressed. | One rumor is that she was a conman, and another is that she's a sorcerer. You're not sure which you prefer. | With rumors of dark arts being practiced once more, the woman's magical proclamation just might be true. | Some say she eats toads for breakfast and black cats for dinner.} {You ask %name% a lot of questions, but through some handwaves and nods, you realize you have forgotten her answers. Or did you ask the questions at all? | %name% produces a dove from her sleeve. An old trick that fancies no one - until it turns in the air, returning to her as a crow. | %name% has shown the ability to shoot smoke from her mouth. It's not fire, but it's close, and has people talking in hushed tones. | %name% floats a gold coin into the air. An amazing display that leaves the woman too tired to attempt it again. | Predictions of the weather are common, but %name% is unusually accurate with her own. | %name% asks to read your palms. You decline. Her presence alone is as close as you're willing to go. | %name% suggests that the stars are a roadmap to another world. She seems to know a lot about the heavens above. | %name% suggests that the heavens above are in fact just endless streams of beings, continuing on for eons. What a jest! | %name% points to one star in the sky and seems to suggest that is where she came from. You don't ask for a clarification on the matter.}"
        es = "{ %name% practica las artes oscuras. | %name% camina encorvada, como si la agobiara un saber de otro mundo. | El rostro de %name% se ha transformado y ya no tiene su aspecto natural, marchito. | No se sabe mucho de %name%, pero la siguen extraños rumores de brujería y artes oscuras. | Allí donde los animales empiezan a morir misteriosamente, aparece %name%. | Los broches de la capa de %name% parecen arremolinarse y danzar como la medianoche en una jarra. | Rara vez se ven las manos de %name%, que solo asoman como para expresar los sentimientos de un rostro oculto en lo hondo de su capucha. | Los ojos de %name% podrían pasar por los de un gato un día y por los de un ciego al siguiente.} {Poco se sabe de su historia. | Su pasado es un misterio para casi todos. | Hay quien dice que se adentró en las estribaciones del norte y regresó con conocimientos indecibles. | Supuestamente, las artes oscuras le vienen de familia, o eso parece. | Su pasado es un secreto para todos. Quizá sea simplemente aburrido, o quizá todo lo contrario. | Según un rumor, recorrió estas tierras como tejedora de hechizos. | La rodean rumores de magia, aunque a algunos cínicos incrédulos no les impresionan en absoluto. | Un rumor dice que era una estafadora, y otro, que es una hechicera. No sabes cuál prefieres. | Con los rumores de que vuelven a practicarse las artes oscuras, puede que las proclamas mágicas de esta mujer sean ciertas. | Dicen que desayuna sapos y cena gatos negros.} {Le haces a %name% muchas preguntas, pero entre gestos de la mano y asentimientos te das cuenta de que has olvidado sus respuestas. ¿O acaso llegaste a preguntar? | %name% saca una paloma de la manga. Un viejo truco que no impresiona a nadie... hasta que da la vuelta en el aire y regresa a ella convertida en cuervo. | %name% ha demostrado que es capaz de echar humo por la boca. No es fuego, pero se le acerca, y la gente lo comenta en voz baja. | %name% hace flotar una moneda de oro en el aire. Una exhibición asombrosa que deja a la mujer demasiado agotada para intentarla de nuevo. | Las predicciones del tiempo son comunes, pero las de %name% son inusualmente certeras. | %name% pide leerte las palmas de las manos. Te niegas. Con su mera presencia ya tienes bastante cercanía. | %name% sugiere que las estrellas son un mapa de caminos hacia otro mundo. Parece saber mucho de los cielos. | %name% sugiere que los cielos son en realidad interminables corrientes de seres que se suceden durante eones. ¡Qué ocurrencia! | %name% señala una estrella del cielo y parece dar a entender que viene de allí. No le pides que lo aclare.}"
    }
    // context: legend_conjurer_background.onBuildDescription
    {
        en = "{ %name% is a practicioner of the dark arts. |  %name% carries a slumped posture, as if weighted by otherworldly knowledge. | %name%'s face is transformed from its natural withered form | Not much is known about %name%, but strange rumors of sorcery and dark arts follow. | Wherever animals mysteriously begin to die, %name% makes an appearance. | The brooches on %name%'s cloak seem to swirl and dance like midnight in a jug. | %name%'s hands are rare to see, only coming out as if to portray the feelings of a face which lies hidden deep in its hood. | %name%'s eyes could be mistaken for a cat's one day and for a blind man's the next.} {Little is known of their history | their past i but a mystery to most. | Some say they traveled deep into the northern foothills, returning with unspoken knowledge. | Ostensibly, the dark arts are their heritage, or so it seems. | Their past is kept from all. Maybe it's just uninteresting, or maybe just the opposite. | One rumor  says he traveled the land as a spellweaver. | Rumors of magic surround the man, though some incredulous cynics are hardly impressed. | One rumor is that he was a conman, and another is that he's a sorcerer. You're not sure which you prefer. | With rumors of dark arts being practiced once more, the man's magical proclamation just might be true. | Some say he eats toads for breakfast and black cats for dinner.} {You ask %name% a lot of questions, but through some handwaves and nods, you realize you have forgotten his answers. Or did you ask the questions at all? | %name% produces a dove from his sleeve. An old trick that fancies no one - until it turns in the air, returning to him as a crow. | %name% has shown the ability to shoot smoke from his mouth. It's not fire, but it's close, and has people talking in hushed tones. | %name% floats a gold coin into the air. An amazing display that leaves the man too tired to attempt it again. | Predictions of the weather are common, but %name% is unusually accurate with his own. | %name% asks to read your palms. You decline. His presence alone is as close as you're willing to go. | %name% suggests that the stars are a roadmap to another world. He seems to know a lot about the heavens above. | %name% suggests that the heavens above are in fact just endless streams of beings, continuing on for eons. What a jest! | %name% points to one star in the sky and seems to suggest that is where he came from. You don't ask for a clarification on the matter.}"
        es = "{ %name% practica las artes oscuras. | %name% camina encorvado, como si lo agobiara un saber de otro mundo. | El rostro de %name% se ha transformado y ya no tiene su aspecto natural, marchito. | No se sabe mucho de %name%, pero lo siguen extraños rumores de brujería y artes oscuras. | Allí donde los animales empiezan a morir misteriosamente, aparece %name%. | Los broches de la capa de %name% parecen arremolinarse y danzar como la medianoche en una jarra. | Rara vez se ven las manos de %name%, que solo asoman como para expresar los sentimientos de un rostro oculto en lo hondo de su capucha. | Los ojos de %name% podrían pasar por los de un gato un día y por los de un ciego al siguiente.} {Poco se sabe de su historia. | Su pasado es un misterio para casi todos. | Hay quien dice que se adentró en las estribaciones del norte y regresó con conocimientos indecibles. | Supuestamente, las artes oscuras le vienen de familia, o eso parece. | Su pasado es un secreto para todos. Quizá sea simplemente aburrido, o quizá todo lo contrario. | Según un rumor, recorrió estas tierras como tejedor de hechizos. | Lo rodean rumores de magia, aunque a algunos cínicos incrédulos no les impresionan en absoluto. | Un rumor dice que era un estafador, y otro, que es un hechicero. No sabes cuál prefieres. | Con los rumores de que vuelven a practicarse las artes oscuras, puede que las proclamas mágicas de este hombre sean ciertas. | Dicen que desayuna sapos y cena gatos negros.} {Le haces a %name% muchas preguntas, pero entre gestos de la mano y asentimientos te das cuenta de que has olvidado sus respuestas. ¿O acaso llegaste a preguntar? | %name% saca una paloma de la manga. Un viejo truco que no impresiona a nadie... hasta que da la vuelta en el aire y regresa a él convertida en cuervo. | %name% ha demostrado que es capaz de echar humo por la boca. No es fuego, pero se le acerca, y la gente lo comenta en voz baja. | %name% hace flotar una moneda de oro en el aire. Una exhibición asombrosa que lo deja demasiado agotado para intentarla de nuevo. | Las predicciones del tiempo son comunes, pero las de %name% son inusualmente certeras. | %name% pide leerte las palmas de las manos. Te niegas. Con su mera presencia ya tienes bastante cercanía. | %name% sugiere que las estrellas son un mapa de caminos hacia otro mundo. Parece saber mucho de los cielos. | %name% sugiere que los cielos son en realidad interminables corrientes de seres que se suceden durante eones. ¡Qué ocurrencia! | %name% señala una estrella del cielo y parece dar a entender que viene de allí. No le pides que lo aclare.}"
    }
    // FILE: scripts\skills\backgrounds\legend_conscript_background.nut
    // en = "Conscript"
    // en base_es
    // context: legend_conscript_background.create.m.BackgroundDescription
    {
        en = "Better trained and equipped than northern militia, conscripts are the rank and file of the southern military."
        es = "Mejor entrenados y equipados que la milicia del norte, los conscriptos son la tropa del ejército del sur."
    }
    // en = "The nomad %name% left the %companyname% a few months after yourself. He apparently traveled south and now leads what they're calling the 'City on Legs,' a huge band of peoples that roam the deserts. It is apparently so rich and successful a society that the Viziers worry their own people will flock to it."
    // en base_es
    // en = "You learned that %name% the nomad departed the company with the hope of finding new plains to roam. Apparently, he got the idea in his head that he would travel far to the north and land cozily with the barbarians there. To his credit, the barbarians and nomads share a similar lifestyle, culture, language, religion, laws, struggles, conflicts, and general appearances aside. The nomad was butchered almost instantly upon entrance to a barbarian encampment and his remains eaten in a warrior ritual."
    // en base_es
    // en = "the Conscript"
    // en base_es
    // context: legend_conscript_background.onBuildDescription
    {
        en = "{Like many southerners, %name% is someone who grew up in the desert, however they were destined to not stray far from the city walls. | Born into a military family, %name% took up the tradiation of service to the Vizier from an early age. | %name% family has had a foothold in this area for some time — begging, trading and eventually carving out a life for their children on the backs of their own toil. | Nomads often wander, while conscripts like %name% wanted the adventure without the walking. | %name% rarely speaks of their time under the banner, but you get the impression that they find much of the work required of them below their expectations.} {Politics are differant here in the south, and you find %name% always treats you with respect and reverence — even if you suspect it is not sincere. | %name% had a recent falling out with their commanding officer — something about a mortar, a goat and a half dozen buckets of rice. | %name% narrowly avoided execution when they were found with several bottles of wine in their tent. The life of a conscript has not appealed to them since. | %name% always carries a set of 'lucky' dice around — which have not been working correctly so far, based on how many questions they asked you about their pay. | After a greenskin ambush, %name% managed to survive by hiding in the barrel of a mortar, gently cooking themselves in the desert heat until they were found and warned for their cowardice.} {Mounting debts has caused them to seek a new path — either to escape their debtors or to earn enough coin to buy their way out of trouble. | While better trained and drilled than other militia, %name% does have some rough edges that could be rounded off — assuming you can get them away from the bottle. | A life of steel, gunpowder and searing heat is enough for anyone to want a change, and %name% intends to do just that. | %name% thought about running with some nomads for a while, but given the strength of the Vizier's army in which they saw first hand has made them reconsider and seek more legitimate employment. | While not as experienced as a professional soldier, %name% can stand alone and tall against almost any threat.}"
        es = "{Como tanta gente del sur, %name% creció en el desierto, aunque su destino era no alejarse mucho de las murallas de la ciudad. | En el seno de una familia militar, %name% asumió desde muy temprano la tradición de servir al Visir. | La familia de %name% lleva tiempo afincada en esta zona: mendigando, comerciando y, al final, labrando una vida para sus hijos a costa de su propio esfuerzo. | Los nómadas suelen vagar, mientras que los conscriptos como %name% querían aventura sin tener que caminar. | %name% rara vez habla de su tiempo bajo el estandarte, pero te da la impresión de que gran parte del trabajo que se le exigía estaba por debajo de lo que esperaba.} {Aquí en el sur la política es distinta, y ves que %name% siempre te trata con respeto y reverencia, aunque sospeches que no lo hace con sinceridad. | %name% tuvo hace poco un desencuentro con su oficial al mando, algo relacionado con un mortero, una cabra y media docena de cubos de arroz. | %name% se libró por poco de la ejecución cuando le encontraron varias botellas de vino en su tienda. Desde entonces, la vida militar ha dejado de atraerle. | %name% siempre lleva encima unos dados 'de la suerte', que de momento no le están funcionando, a juzgar por cuántas preguntas te ha hecho sobre su paga. | Tras una emboscada de pieles verdes, %name% logró sobrevivir escondiéndose en el tubo de un mortero, cociéndose a fuego lento bajo el calor del desierto hasta que dieron con su escondite y recibió una amonestación por su cobardía.} {Sus crecientes deudas le han hecho buscar un nuevo camino: o bien escapar de sus acreedores, o bien ganar suficientes monedas para salir de los problemas pagando. | Aunque cuenta con mejor instrucción que otras milicias, %name% tiene algunas asperezas que podrían limarse, siempre que consigas que deje la botella. | Una vida de acero, pólvora y calor abrasador basta para que cualquiera quiera un cambio, y eso es justo lo que %name% pretende hacer. | %name% pensó en unirse durante un tiempo a unos nómadas, pero la fuerza del ejército del Visir, que vio con sus propios ojos, le hizo reconsiderarlo y buscar un empleo más legítimo. | Aunque no tiene la experiencia de un soldado profesional, %name% es capaz de mantenerse firme y sin ayuda frente a casi cualquier amenaza.}"
    }
    // FILE: scripts\skills\backgrounds\legend_conscript_ranged_background.nut
    // context: legend_conscript_ranged_background.create.m.Name
    {
        en = "Conscript Gunner"
        es = "Recluta cañonero"
    }
    // FILE: scripts\skills\backgrounds\legend_crusader_background.nut
    // context: legend_crusader_background.create.m.Name
    {
        en = "Holy Crusader"
        es = "Cruzado santo"
    }
    // context: legend_crusader_background.onBuildDescription
    {
        en = "%name% lives to fight the undead scourge. Little is known about %them% and %they% almost never talks save for the occasional grunt while swinging %their% sword. %Their% language seems to be codified into one simple structure: killing creatures of evil."
        es = "%name% vive para combatir el azote de los no muertos. Poco se sabe de %el%, y casi nunca habla, salvo algún gruñido ocasional mientras blande su espada. Su lenguaje parece reducido a una única y simple estructura: matar criaturas del mal."
    }
    // context: legend_crusader_background.onAdded.actor.setTitle()
    {
        en = "the Holy Avenger"
        es = "el Vengador Sagrado"
    }
    // FILE: scripts\skills\backgrounds\legend_death_summoner_background.nut
    // context: legend_death_summoner_background.create.m.Name
    {
        en = "Weidermancer"
        es = "Weidermante"
    }
    // FILE: scripts\skills\backgrounds\legend_dervish_background.nut
    // context: legend_dervish_background.create.m.Name
    {
        // El extractor lo dejó solo como clave o ID interno, que Rosetta no toca.
        en = "Dervish"
        es = "Derviche"
    }
    // context: legend_dervish_background.create.m.BackgroundDescription
    {
        en = "The dervish is a religious background that enters an almost trance-like state in combat."
        es = "El derviche es un trasfondo religioso que entra en combate en un estado casi de trance."
    }
    // context: legend_dervish_background.create.m.GoodEnding
    {
        en = "Although the life of excess was not the way of the dervish, %name% took the money given to them and set it aside, accumulating a Vizier's fortune of crowns. %name% donated this money to local widows and shelters for the poor before selling what they were wearing and wandering back into the streets, just as they were found."
        es = "Aunque la vida de excesos no era el camino de un derviche, %name% tomó el dinero que le daban y lo fue apartando, hasta reunir una fortuna en coronas digna de un visir. %name% donó ese dinero a las viudas del lugar y a los albergues para pobres antes de vender lo que llevaba puesto y volver a vagar por las calles, de donde había salido."
    }
    // context: legend_dervish_background.create.m.BadEnding
    {
        en = "The life of a mercenary sated the brutal needs of %name%, but allowed their spiritual nature to become corrupt and twisted. %name% turned to a life of mercenary work fully, becoming greedy and dining on the pleasures of excess. In turn they made many enemies and disgusted their former peers. Through unknown methods %name% was found poisoned a few seasons later."
        es = "La vida de mercenario sació las necesidades brutales de %name%, pero dejó que su naturaleza espiritual se corrompiera y se retorciera. %name% se entregó por completo a la vida mercenaria, cayó en la codicia y se dio a los placeres del exceso. A cambio, se ganó muchos enemigos y les causó asco a sus antiguos compañeros. Unas cuantas estaciones después, apareció el cuerpo envenenado de %name%, sin que nadie supiera cómo."
    }
    // context: legend_dervish_background.onAdded.actor.setTitle()
    {
        en = "the Dervish"
        es = "el Derviche"
    }
    // context: legend_dervish_background.onBuildDescription
    {
        en = "{%name% is a mixed character - you have never seen someone so violent yet so calm at the same time. | %name% says it is down to years of training and prayer that steadies the commitment of a person - however you suspect that the reason is more animalistic and simple than %they% let on.} {The dedication and aggression from %name% dwarfs that of the monks in the north. | %name% sleeps under the overhang of a market stall and walks the city during the daytime, often in bare feet and dressed in little more than rags. | This spartan martial lifestyle has left %name% with a strong body and a stronger mind. | %Their% sanity is still up for debate however. } {When you first heard of %name% %they% sounded like your typical mercenary - loud, strong and with an unhealthy interest in all things that could kill a man. | Upon closer inspection %they% seem more alike a zealous beggar than anything else - dressed in shabby clothing and preaching wherever they go. } {%name% speaks, acts, eats, sleeps and a manner of other things as any religious southerner would do. | However %their% demeanour changes significantly whenever you put a weapon in %their% hand, showing a combination of ornate flourishes that seem more like a dance than a practical combat style. | While it would take the eye out of any man or creature close enough, %their% resolve is above and beyond %their% peers.}"
        es = "{%name% tiene un carácter contradictorio: nunca has visto a nadie tan violent%o% y, al mismo tiempo, tan tranquil%o%. | %name% dice que son los años de entrenamiento y oración los que afianzan el compromiso de una persona, aunque sospechas que la razón es más animal y más sencilla de lo que deja ver.} {La entrega y la agresividad de %name% dejan pequeñas las de los monjes del norte. | %name% duerme bajo el toldo de un puesto del mercado y recorre la ciudad de día, a menudo descalz%o% y vestid%o% con poco más que harapos. | Este estilo de vida marcial y espartano le ha dado a %name% un cuerpo fuerte y una mente aún más fuerte. | Aun así, su cordura sigue estando en entredicho. } {Cuando oíste hablar de %name% por primera vez, parecía %un% mercenari%o% de lo más típic%o%: ruidos%o%, fuerte y con un interés malsano por todo lo que pudiera matar a un hombre. | Vist%o% más de cerca, parece más bien %un% mendig%o% fanátic%o% que otra cosa: viste ropa raída y predica allá adonde va. } {%name% habla, actúa, come, duerme y hace muchas otras cosas como lo haría cualquier sureño devoto. | Sin embargo, su actitud cambia por completo cada vez que le pones un arma en la mano, y despliega una combinación de florituras ornamentadas que se parece más a una danza que a un estilo de combate práctico. | Aunque eso le sacaría un ojo a cualquier hombre o criatura que se acercara demasiado, su resolución está muy por encima de la de sus iguales.}"
    }
    // FILE: scripts\skills\backgrounds\legend_diviner_background.nut
    // context: legend_diviner_background.create.m.Name
    {
        en = "Diviner"
        es = "Adivino"
    }
    // context: legend_diviner_background.create.m.Titles
    {
        en = "the Enthralling"
        es = "el Cautivador"
    }
    // context: legend_diviner_background.create.m.Titles
    {
        en = "the Fascinating"
        es = "el Fascinante"
    }
    // context: legend_diviner_background.create.m.Titles
    {
        en = "the Dreamer"
        es = "el Soñador"
    }
    // context: legend_diviner_background.create.m.Titles
    {
        en = "the Clairvoyant"
        es = "el Clarividente"
    }
    // context: legend_diviner_background.create.m.Titles
    {
        en = "the Diviner"
        es = "el Adivino"
    }
    // FILE: scripts\skills\backgrounds\legend_donkey_background.nut
    // context: legend_donkey_background.create.m.BackgroundDescription
    {
        en = "Donkeys are generally patient and deliberate in their actions."
        es = "Los burros suelen ser pacientes y pausados en lo que hacen."
    }
    // context: legend_donkey_background.create.m.GoodEnding
    {
        en = "%name% the donkey retired to a lovely green paddock. They spend their days loafing about and eating carrots fed to them by local children."
        es = "Los días de bestia de carga de %name% terminaron en un precioso prado verde, donde ahora pasa el tiempo holgazaneando y comiendo las zanahorias que le dan los niños del lugar."
    }
    // context: legend_donkey_background.create.m.BadEnding
    {
        en = "%name% the donkey was sold to a foul-tempered trader who did not spare the rod. Their caravan was attacked by orcs and the remains of %name% were never found."
        es = "Vendieron a %name% como bestia de carga a un comerciante de mal genio que no escatimaba los palos. Unos orcos atacaron su caravana y nunca se encontraron los restos de %name%."
    }
    // context: legend_donkey_background.getTooltip.ret.push().text
    {
        // text = "Donkeys provide [color=%positive%]+" + stashModifier + "[/color] stash space, [color=%positive%]+" + this.m.Modifiers.Ammo + "[/color] maximum ammunition storage, [color=%positive%]+" + this.m.Modifiers.Meds + "[/color] maximum medicine capacity,  [color=%positive%]+" + this.m.Modifiers.ArmorParts + "[/color] maximum armor parts. These can be increased with perks (may take a moment for the increases to register). "
        mode = "pattern"
        en = "Donkeys provide [color=%positive%]+<stash:int>[/color] stash space, [color=%positive%]+<ammo:int>[/color] maximum ammunition storage, [color=%positive%]+<meds:int>[/color] maximum medicine capacity,  [color=%positive%]+<parts:int>[/color] maximum armor parts. These can be increased with perks (may take a moment for the increases to register). "
        es = "Los burros dan [color=%positive%]+<stash>[/color] espacios de inventario, [color=%positive%]+<ammo>[/color] de capacidad máxima de munición, [color=%positive%]+<meds>[/color] de capacidad máxima de medicina y [color=%positive%]+<parts>[/color] de capacidad máxima de herramientas. Se pueden aumentar con ventajas (los aumentos pueden tardar un momento en registrarse). "
    }
    // context: legend_donkey_background.onBuildDescription
    {
        en = "{%name% was raised to pull plows on a farm, but was eventually sold to a wandering trader. |  %name% was reared from young days by a traveling merchant. | A donkey's life is tough and %name% has been used for hauling many wares. | Though the work is dangerous, being a caravan donkey allowed %name% to see the world. | When her former owner died, %name% was put up for sale and bought for caravan work. | Hardy and resolute, %name% was the pick of the bunch when local merchants needed new beasts of burden. | Sold from owner to owner, %name% has worked for more caravans than most traders.} {Unfortunately, her most recent owner turned out to be abusive, nary a whip away from being a slave driver. A kindly farmer bought %name% to free her, but when feed became too costly, she was sold once again. | One day, valuable goods went missing. Unfairly blamed for ruining the cargo her her time with the caravan has come to an abrupt end. | The caravans need protection, as an ambush by the hill brigands proved. Amidst the chaos of the attack, %name% barely made it out alive. | Years on the road went without a hitch until a new caravan master died on the road and %name% was left tied to a wagon without food until rescued by a passerby. | Trading caravans are frequent targets for brigands, and in one such raid, as the caravan hands fell, %name% fled into the night. | Sadly, an expanding destroyed local trade routes. With profits drying up, %name% was sold off as the merchants retired their wagons. | After witnessing a terrifying attack of direwolves on their caravan, %name% bolted on her way to in search of a new owner. | When war deprived the merchants of stock, the caravan drivers took to selling the pack animals.  %name% was among the last to be auctioned off. | Tragically, her handlers turned to selling human chattel. While the profits were enormous, it drew the ire of a local militia - and their pitchforks soon followed. After a successful ambush, %name% was running for her life.} {A donkey like %name% is no stranger to danger, making her a good fit for any mercenary group. | With her caravan days behind her, working for a sellsword is just another avenue for oats. | In %name%'s mind, accompanying mercenaries is a lot like hauling goods a for caravanners with more carrots as a kicker. | Well versed in long-distance traveling, %name% is a natural fit for the hardships of mercenary life. | Years of road travel have molded %name% into a durable pack animal, which any company would be lucky to have.}"
        es = "{Criaron a %name% para tirar del arado en una granja, pero acabaron vendiéndola a un comerciante ambulante. | Un mercader itinerante crió a %name% desde muy joven. | La vida de un burro es dura, y a %name% la han usado para acarrear todo tipo de mercancías. | Aunque el trabajo es peligroso, trabajar para una caravana le permitió a %name% ver mundo. | Cuando murió su antiguo dueño, pusieron a %name% a la venta y la compraron para trabajar en una caravana. | Dura y resuelta, %name% era la mejor del lote cuando los mercaderes de la zona necesitaban nuevas bestias de carga. | Vendida de dueño en dueño, %name% ha trabajado para más caravanas que la mayoría de los comerciantes.} {Por desgracia, su último dueño resultó ser un maltratador, a un látigo de distancia de ser un negrero. Un granjero bondadoso compró a %name% para liberarla, pero cuando el pienso se encareció demasiado, volvió a venderla. | Un día desaparecieron unas mercancías valiosas. La culparon injustamente de echar a perder la carga, y su tiempo en la caravana terminó de golpe. | Las caravanas necesitan protección, como demostró una emboscada de los bandidos de las colinas. En medio del caos del ataque, %name% salió con vida por los pelos. | Pasó años en el camino sin contratiempos, hasta que un nuevo jefe de caravana murió durante el viaje y dejó a %name% atada a un carro y sin comida hasta que un transeúnte la rescató. | Las caravanas comerciales son blanco frecuente de los bandidos, y en una de esas incursiones, mientras caían los caravaneros, %name% huyó en la noche. | Por desgracia, una guerra cada vez más extensa destrozó las rutas comerciales de la zona. Con los beneficios agotándose, vendieron a %name% cuando los mercaderes retiraron sus carros. | Tras presenciar un ataque aterrador de huargos contra su caravana, %name% salió disparada en busca de un nuevo dueño. | Cuando la guerra dejó a los mercaderes sin existencias, los caravaneros se pusieron a vender a los animales de carga. %name% fue de las últimas en salir a subasta. | Por desgracia, sus cuidadores se pasaron a traficar con ganado humano. Aunque las ganancias eran enormes, se ganaron la ira de una milicia local, y sus horcas no tardaron en llegar. Tras una emboscada que salió bien, %name% huía para salvar la vida.} {Una burra como %name% no es ajena al peligro, lo que la hace idónea para cualquier grupo de mercenarios. | Con sus días de caravana atrás, trabajar para un mercenario no es más que otra forma de conseguir avena. | Para %name%, acompañar a mercenarios se parece mucho a acarrear mercancías para caravaneros, con más zanahorias como aliciente. | Curtida en los viajes largos, %name% encaja de forma natural en las penurias de la vida mercenaria. | Años de caminos han hecho de %name% una bestia de carga resistente que cualquier compañía tendría la suerte de tener.}"
    }
    // FILE: scripts\skills\backgrounds\legend_druid_background.nut
    // context: legend_druid_background.create.m.BackgroundDescription
    {
        en = "Druids are from the wild lands and are ardent defenders of nature."
        es = "Los druidas vienen de las tierras salvajes y son fervientes defensores de la naturaleza."
    }
    // context: legend_druid_background.create.m.GoodEnding
    {
        en = "Eventually, being away from the woods became too much for %name%, they eventually found their way back home with tales from the world outside and beyond the trees. The throws of nature were not healed, but they were mending - which is sometimes all one person can do to make a difference."
        es = "Con el tiempo, estar lejos de los bosques se le hizo insoportable a %name%, que acabó encontrando el camino de vuelta a casa con historias del mundo de fuera, más allá de los árboles. Los males de la naturaleza no habían sanado, pero iban cicatrizando, y a veces eso es todo lo que una persona puede hacer para cambiar las cosas."
    }
    // context: legend_druid_background.create.m.BadEnding
    {
        en = "%name% eventually became disillusioned with the world you brought %them% into - seeking home shortly after your departure from %companyname%, they found themselves terrified by what met them. Something had swept through the forest in their absence and stripped the resources from the land. Animals were burnt in piles and trees had been burnt, destroyed or smashed down. %name% never did find home, or another place like it."
        es = "Con el tiempo, %name% acabó desencantad%o% con el mundo al que %lo% llevaste. Poco después de que dejaras %companyname%, quiso volver a casa, y lo que encontró %lo% aterró. Algo había arrasado el bosque en su ausencia y había despojado la tierra de sus recursos. Habían quemado a los animales en montones, y los árboles estaban quemados, destrozados o derribados. %name% nunca encontró su hogar, ni otro lugar como aquel."
    }
    // context: legend_druid_background.create.m.Titles
    {
        en = "the Green thumb"
        es = "Mano Verde"
    }
    // context: legend_druid_background.create.m.Titles
    {
        en = "Oakheart"
        es = "Corazón de Roble"
    }
    // context: legend_druid_background.create.m.Titles
    {
        en = "Treebeard"
        es = "Bárbol"
    }
    // context: legend_druid_background.create.m.Titles
    {
        en = "the flower"
        es = "la flor"
    }
    // context: legend_druid_background.create.m.Titles
    {
        en = "the Pollenator"
        es = "el Polinizador"
    }
    // context: legend_druid_background.create.m.Titles
    {
        en = "Nature's Wrath"
        es = "Ira de la Naturaleza"
    }
    // context: legend_druid_background.create.m.Titles
    {
        en = "the Sapling"
        es = "el Retoño"
    }
    // context: legend_druid_background.onBuildDescription
    {
        // corrige base: «reproduce una de sus artes carnales en el cielo» por «traza en el cielo uno de los dibujos de su piel»: «fleshen arts» son las marcas de la piel, y «carnales» sugiere sexo
        // corrige base: «luchando con ferocidad en la naturaleza» por «luchando contra algo feroz en la espesura»: el inglés dice «fighting something fierce»
        // corrige base: «lo persiguieron en los bosques han vuelto a perseguirlo para sacarlo» por «lo empujaron a los bosques han vuelto para sacarlo de ellos»: «chased him into the forests» es hasta dentro de los bosques
        // corrige base: «algunas monedas» por «unas cuantas coronas»: el inglés dice «crowns»
        // corrige base: «Juzgando por» por «A juzgar por» (calco); «Otros se detienen» por «Otras» (concuerda con «personas»); «Años como un recluso» por «Años de recluso»
        en = "{For some, the wild is a refuge. | It is said that woman is born with the wilderness in her, and that she does wrong by turning her back on it. | Civilization is a stain, one prolonged arming of every next-generation to better battle the ultimate enemy: Mother Nature herself. | In a time of war, it's not surprising that many once again seek refuge in the wild. | Some people flee from town to town. Others stop in between, disappearing into the tranquil forests.} {%name% once found a safe register amongst the trees, but that time is over. | Once a mysterious figure to hunters - the famed masskewatsthat - %name% now returns to civilization for reasons unknown. | %name%'s got the hands of a blacksmith, but the hygiene of a pigsty. | Maybe it was spurned love, or maybe just war, but %name% has spent the last decade far from the rest of mankind. | Possibly a poacher who settled where she hunted, %name%'s lived amongst the trees for untold years. | With cleverly stitched garb, %name%'s atavistic appearance perhaps belies a past as a tailor or tanner.} {There is an obvious language barrier with the druid, but for some reason she seems very willing to fight. Let's hope his newfound 'calling' doesn't have a darker purpose behind it. | Colorful and permanent ritual rites circle about her body. When asked why she wishes to join a band of mercenaries, she hoots and, with a crooked finger, replicates one of her fleshen arts across the sky. | Wounds, old and fresh, dot her already mottled body. And they are not superficial - this woman had been fighting something fierce in the wild. | One has to wonder if the calamities which chased her into the forests have come to chase her back out. | Judging by her wild grunting, it's doubtful she's here to rejoin civilization. | Years as a recluse haven't made the woman forget what a few crowns can get you. The question is, why did she come back? | She has the strength to wrestle a boar - and her many scars makes you wonder if perhaps she did.}"
        es = "{Para algunos, lo salvaje es un refugio. | Se dice que la mujer nace con lo salvaje en ella y que comete un error al darle la espalda. | La civilización es una mancha, un largo adiestramiento de cada generación para luchar mejor contra el enemigo definitivo: la Madre Naturaleza misma. | En tiempos de guerra, no es sorprendente que muchos busquen refugio en lo salvaje una vez más. | Algunas personas huyen de pueblo en pueblo. Otras se detienen en el camino, desapareciendo en los bosques tranquilos.} {%name% una vez encontró un refugio seguro entre los árboles, pero ese tiempo ha terminado. | Una vez una figura misteriosa para los cazadores, la famosa masskewatsthat, %name% ahora vuelve a la civilización por razones desconocidas. | %name% tiene las manos de un herrero, pero la higiene de un chiquero. | Tal vez fue un amor despechado, o tal vez solo la guerra, pero %name% ha pasado la última década lejos del resto de la humanidad. | Posiblemente una cazadora furtiva que se estableció donde cazaba, %name% ha vivido entre los árboles durante años incontables. | Con ropa ingeniosamente cosida, la apariencia atávica de %name% quizás oculta un pasado como sastra o curtidora.} {Hay una barrera de idioma obvia con la druida, pero por alguna razón parece muy dispuesta a luchar. Esperemos que su recién descubierto 'llamado' no tenga un propósito más oscuro detrás. | Rituales coloridos y permanentes rodean su cuerpo. Cuando se le pregunta por qué desea unirse a una banda de mercenarios, aúlla y, con un dedo torcido, traza en el cielo uno de los dibujos de su piel. | Heridas, antiguas y frescas, salpican su cuerpo ya de por sí moteado. Y no son superficiales; esta mujer ha estado luchando contra algo feroz en la espesura. | Uno tiene que preguntarse si las calamidades que la empujaron a los bosques han vuelto para sacarla de ellos. | A juzgar por sus gruñidos salvajes, es dudoso que esté aquí para volver a unirse a la civilización. | Años de reclusa no han hecho que la mujer olvide lo que pueden conseguir unas cuantas coronas. La pregunta es, ¿por qué volvió? | Tiene la fuerza para luchar con un jabalí, y sus numerosas cicatrices te hacen preguntarte si tal vez lo hizo.}"
    }
    // context: legend_druid_background.onBuildDescription
    {
        // corrige base: «reproduce una de sus artes carnales en el cielo» por «traza en el cielo uno de los dibujos de su piel»: «fleshen arts» son las marcas de la piel, y «carnales» sugiere sexo
        // corrige base: «luchando con ferocidad en la naturaleza» por «luchando contra algo feroz en la espesura»: el inglés dice «fighting something fierce»
        // corrige base: «lo persiguieron en los bosques han vuelto a perseguirlo para sacarlo» por «lo empujaron a los bosques han vuelto para sacarlo de ellos»: «chased him into the forests» es hasta dentro de los bosques
        // corrige base: «algunas monedas» por «unas cuantas coronas»: el inglés dice «crowns»
        // corrige base: «Juzgando por» por «A juzgar por» (calco); «Otros se detienen» por «Otras» (concuerda con «personas»); «Años como un recluso» por «Años de recluso»
        en = "{For some, the wild is a refuge. | It is said that man is born with the wilderness in him, and that he does wrong by turning his back on it. | Civilization is a stain, one prolonged arming of every next-generation to better battle the ultimate enemy: Mother Nature herself. | In a time of war, it's not surprising that many once again seek refuge in the wild. | Some people flee from town to town. Others stop in between, disappearing into the tranquil forests.} {%name% once found a safe register amongst the trees, but that time is over. | Once a mysterious figure to hunters - the famed masskewatsthat - %name% now returns to civilization for reasons unknown. | %name%'s got the hands of a blacksmith, but the hygiene of a pigsty. | Maybe it was spurned love, or maybe just war, but %name% has spent the last decade far from the rest of mankind. | Possibly a poacher who settled where he hunted, %name%'s lived amongst the trees for untold years. | With cleverly stitched garb, %name%'s atavistic appearance perhaps belies a past as a tailor or tanner.} {There is an obvious language barrier with the druid, but for some reason he seems very willing to fight. Let's hope his newfound 'calling' doesn't have a darker purpose behind it. | Colorful and permanent ritual rites circle about his body. When asked why he wishes to join a band of mercenaries, he hoots and, with a crooked finger, replicates one of his fleshen arts across the sky. | Wounds, old and fresh, dot his already mottled body. And they are not superficial - this man had been fighting something fierce in the wild. | One has to wonder if the calamities which chased him into the forests have come to chase him back out. | Judging by his wild grunting, it's doubtful he's here to rejoin civilization. | Years as a recluse haven't made the man forget what a few crowns can get you. The question is, why did he come back? | He has the strength to wrestle a boar - and his many scars makes you wonder if perhaps he did.}"
        es = "{Para algunos, lo salvaje es un refugio. | Se dice que el hombre nace con lo salvaje en él y que comete un error al darle la espalda. | La civilización es una mancha, un largo adiestramiento de cada generación para luchar mejor contra el enemigo definitivo: la Madre Naturaleza misma. | En tiempos de guerra, no es sorprendente que muchos busquen refugio en lo salvaje una vez más. | Algunas personas huyen de pueblo en pueblo. Otras se detienen en el camino, desapareciendo en los bosques tranquilos.} {%name% una vez encontró un refugio seguro entre los árboles, pero ese tiempo ha terminado. | Una vez una figura misteriosa para los cazadores, el famoso masskewatsthat, %name% ahora vuelve a la civilización por razones desconocidas. | %name% tiene las manos de un herrero, pero la higiene de un chiquero. | Tal vez fue un amor despechado, o tal vez solo la guerra, pero %name% ha pasado la última década lejos del resto de la humanidad. | Posiblemente un cazador furtivo que se estableció donde cazaba, %name% ha vivido entre los árboles durante años incontables. | Con ropa ingeniosamente cosida, la apariencia atávica de %name% quizás oculta un pasado como sastre o curtidor.} {Hay una barrera de idioma obvia con el druida, pero por alguna razón parece muy dispuesto a luchar. Esperemos que su recién descubierto 'llamado' no tenga un propósito más oscuro detrás. | Rituales coloridos y permanentes rodean su cuerpo. Cuando se le pregunta por qué desea unirse a una banda de mercenarios, aúlla y, con un dedo torcido, traza en el cielo uno de los dibujos de su piel. | Heridas, antiguas y frescas, salpican su cuerpo ya de por sí moteado. Y no son superficiales; este hombre ha estado luchando contra algo feroz en la espesura. | Uno tiene que preguntarse si las calamidades que lo empujaron a los bosques han vuelto para sacarlo de ellos. | A juzgar por sus gruñidos salvajes, es dudoso que esté aquí para volver a unirse a la civilización. | Años de recluso no han hecho que el hombre olvide lo que pueden conseguir unas cuantas coronas. La pregunta es, ¿por qué volvió? | Tiene la fuerza para luchar con un jabalí, y sus numerosas cicatrices te hacen preguntarte si tal vez lo hizo.}"
    }
    // FILE: scripts\skills\backgrounds\legend_druid_commander_background.nut
    // context: legend_druid_commander_background.create.m.GoodEnding
    {
        en = "While the %companyname% visited a settlement in the far north %name% bit off more than they could chew with an Unhold contract. Dazed and injured they were taken by a particularly large Unhold for unknown purposes. Months later %name% was found eating, sleeping and even fighting with the giants to defend their home. Sellswords today still joke about the 'giant farker' in the woods, but who is the pet and who is the master is quite the mystery to this day."
        es = "Mientras %companyname% visitaba un asentamiento del lejano norte, %name% se metió en un contrato de troles que le venía grande. Entre heridas y atontamiento, un trol especialmente grande se llevó a %name% con fines desconocidos. Meses después encontraron a %name% comiendo, durmiendo e incluso luchando junto a los gigantes para defender su hogar. Los mercenarios todavía bromean sobre el 'jodegigantes' del bosque, pero quién es la mascota y quién el amo sigue siendo todo un misterio a día de hoy."
    }
    // context: legend_druid_commander_background.create.m.BadEnding
    {
        en = "%name% stayed for a little while longer with the company after your departure, then without notice they simply vanished from the company records entirely. Some say they were tired of what the company had become - obsessed with gold and trinkets and straying too far from what it was founded on."
        es = "%name% se quedó un tiempo más en la compañía después de tu marcha y luego, sin avisar, desapareció por completo de sus registros. Hay quien dice que se había hartado de aquello en lo que se había convertido la compañía: obsesionada con el oro y las baratijas, y demasiado alejada de aquello sobre lo que se fundó."
    }
    // FILE: scripts\skills\backgrounds\legend_enchanter_background.nut
    // context: legend_enchanter_background.create.m.Titles
    {
        en = "the Enchanter"
        es = "el Encantador"
    }
    // context: legend_enchanter_background.create.m.Titles
    {
        en = "the Cacophanous"
        es = "el Cacofónico"
    }
    // context: legend_enchanter_background.create.m.Titles
    {
        en = "the Harmonist"
        es = "el Armonista"
    }
    // context: legend_enchanter_background.create.m.Titles
    {
        en = "Star Singer"
        es = "Cantaestrellas"
    }
    // context: legend_enchanter_background.create.m.Titles
    {
        en = "the Hum"
        es = "el Zumbido"
    }
    // context: legend_enchanter_background.create.m.Titles
    {
        en = "of Tongues"
        es = "de las Lenguas"
    }
    // context: legend_enchanter_background.onBuildDescription
    {
        en = "{%name% appears to be mumbling beneath their breath constantly, secret mantras that roil and boil in your mind. At times the repeated words rise to a cacophany that seems to distort reality itself, instilling meaning into all those who hear.  It appears this one has trained with the northern enchanters.}"
        es = "{%name% parece murmurar sin parar entre dientes mantras secretos que se revuelven y bullen en tu mente. A veces las palabras repetidas se alzan en una cacofonía que parece deformar la realidad misma e infunde sentido a todo el que las oye. Por lo visto, se ha formado con los encantadores del norte.}"
    }
    // FILE: scripts\skills\backgrounds\legend_entrancer_background.nut
    // context: legend_entrancer_background.create.m.Name
    {
        en = "Entrancer"
        es = "Embelesador"
    }
    // context: legend_entrancer_background.create.m.Titles
    {
        en = "Glass Eyed"
        es = "Ojos de Vidrio"
    }
    // context: legend_entrancer_background.create.m.Titles
    {
        en = "the Distant"
        es = "de Mirada Perdida"
    }
    // context: legend_entrancer_background.create.m.Titles
    {
        en = "Dream Walker"
        es = "Caminasueños"
    }
    // context: legend_entrancer_background.create.m.Titles
    {
        en = "the Possessed"
        es = "el Poseído"
    }
    // context: legend_entrancer_background.create.m.Titles
    {
        en = "the Haunted"
        es = "el Embrujado"
    }
    // context: legend_entrancer_background.onBuildDescription
    {
        en = "{%name% appears distant, barely concious of the outside world. There is a whole universe unfolding behind those eyes, and at times the trance drives limbs to move and utterances to spill forth.  It can be unerving, but at times the serenity of it all soothes you and draws you into the trance state. }"
        es = "{%name% parece distante, apenas consciente del mundo exterior. Tras esos ojos se despliega todo un universo, y a veces el trance le mueve las extremidades y le arranca palabras sueltas. Puede resultar inquietante, pero a veces la serenidad de todo ello te calma y te arrastra a ese mismo estado de trance. }"
    }
    // FILE: scripts\skills\backgrounds\legend_gladiator_prizefighter_background.nut
    // context: legend_gladiator_prizefighter_background.create.m.Name
    {
        en = "Gladiator Prizefighter"
        es = "Gladiador profesional"
    }
    // context: legend_gladiator_prizefighter_background.create.m.BackgroundDescription
    {
        en = "Gladiator Prizefighters cost a lot of coin, but their time exchanging punches in the arena has made them tough as nails and fit as a butcher's dog."
        es = "Los gladiadores campeones cuestan mucho dinero, pero el tiempo que han pasado intercambiando golpes en la arena los ha dejado duros como una piedra y fuertes como un roble."
    }
    // FILE: scripts\skills\backgrounds\legend_guildmaster_background.nut
    // context: legend_guildmaster_background.create.m.Name
    {
        en = "Guild Master"
        es = "Maestro del gremio"
    }
    // context: legend_guildmaster_background.create.m.BackgroundDescription
    {
        en = "An aging master slayer of a local guild, time has taken their youth but their skills still surpass those they train."
        es = "Lleva muchos años al frente de un gremio local de cazadores de bestias; el tiempo le ha robado la juventud, pero su destreza aún supera la de quienes entrena."
    }
    // context: legend_guildmaster_background.getTooltip.ret.push().text
    {
        en = "Provides [color=%positive%]+10%[/color] enchanting speed when assigned to the enchanter's tent."
        es = "Otorga [color=%positive%]+10%[/color] de velocidad de encantamiento cuando se le asigna a la tienda del encantador."
    }
    // context: legend_guildmaster_background.onBuildDescription
    {
        en = "{Old age has finally caught up with %name% | Once a proficient slayer, %name% has slowly withered to old age. | %name% has a long list of stories to tell, but is old enough to tell them with honesty. | %name%'s reputation preceeds them, but they are much weaker in person that in the tales you were told as a child.} {Many battles and minor injuries have work down %name%'s health to the point where they were forced into retirement. | %name% kept their village safe as a child, but as the expectations of her grew, he quickly found herself burnt out. | %name% was a pathfinder during the battle of many names, on the eve of a battle a messenger advised a noble not much younger than her to not send calvary into the swamp against the greenskins. The noble declined, and the massacre that ensued has haunted her ever since. | Her last contract involved hunting a beast that stole and slaughtered sheep near %randomtown%, only to find that the wolves were starving refugees who left her with a nasty scar. | %name% turned to teaching how to slay monsters, but found her students more eager to slay each other. | %name% was a famous slayer, killing all manner of beasts across the realm. However they found themselves in the middle of a riot and were run through by a boy with a pitchfork, leaving a gruesome scar on their back. | Others may not feel it, but there is something strange in the woods - something far worse than the wolves, giants and spiders %name% is used to. | She pledged herself to keep commonfolk safe and the wilds tame, but time has made her realise that they have more in common with what she kills than what she protects. | %name% does not feel she has much longer in this world, and wants to pass on as much as she can before it's too late. | People are becoming more desperate, irrational even. Those on the fringes of society are always the first to be targeted, which would explain why %name% is seeking the safety of like-minded slayers. | Despite all the trophies she has gathered, %name% never had time for a family. Now her family are those she can fight beside - you can't tell if she can see the tragedy in that yet. | All of her past students lay dead or missing - and it's something she rather you not dredge up in the future.}"
        es = "{Por fin la vejez ha alcanzado a %name%. | En otro tiempo una cazadora de bestias experta, %name% se ha ido marchitando con la vejez. | %name% tiene un sinfín de historias que contar, y ya es lo bastante mayor para contarlas con honestidad. | La fama de %name% la precede, pero en persona es mucho más débil que en los cuentos que te contaban en tu infancia.} {Muchas batallas y heridas menores han desgastado la salud de %name% hasta obligarla a retirarse. | %name% mantuvo a salvo su aldea desde niña, pero a medida que crecían las expectativas puestas en ella, no tardó en quemarse. | %name% fue exploradora durante la Batalla de los Muchos Nombres. La víspera de la batalla, un mensajero aconsejó a un noble no mucho más joven que ella que no enviara la caballería al pantano contra los pieles verdes. El noble no le hizo caso, y la masacre que siguió la atormenta desde entonces. | Su último contrato consistió en cazar a una bestia que robaba y masacraba ovejas cerca de %randomtown%, pero resultó que los lobos eran refugiados hambrientos, que le dejaron una cicatriz fea. | %name% se dedicó a enseñar a matar monstruos, pero descubrió que sus alumnos estaban más deseosos de matarse entre ellos. | %name% fue una cazadora de bestias famosa que mató todo tipo de criaturas por todo el reino. Sin embargo, se vio en medio de una revuelta y un chico la atravesó con una horca, lo que le dejó una cicatriz espantosa en la espalda. | Puede que otros no lo noten, pero hay algo extraño en los bosques, algo mucho peor que los lobos, los gigantes y las arañas a los que está acostumbrada %name%. | Juró mantener a salvo a la gente común y domados los parajes salvajes, pero el tiempo le ha hecho ver que tienen más en común con lo que mata que con lo que protege. | %name% no cree que le quede mucho en este mundo, y quiere transmitir todo lo que pueda antes de que sea demasiado tarde. | La gente está cada vez más desesperada, incluso irracional. Los que viven al margen de la sociedad son siempre los primeros en sufrir los ataques, lo que explicaría por qué %name% busca la seguridad de otros cazadores afines. | Pese a todos los trofeos que ha reunido, %name% nunca tuvo tiempo para formar una familia. Ahora su familia son quienes luchan a su lado; no sabrías decir si ya ve la tragedia que hay en eso. | Todos sus antiguos alumnos están muertos o desaparecidos, y preferiría que no sacaras el tema en el futuro.}"
    }
    // context: legend_guildmaster_background.onBuildDescription
    {
        en = "{Old age has finally caught up with %name% | Once a proficient slayer, %name% has slowly withered to old age. | %name% has a long list of stories to tell, but is old enough to tell them with honesty. | %name%'s reputation preceeds them, but they are much weaker in person that in the tales you were told as a child.} {Many battles and minor injuries have work down %name%'s health to the point where they were forced into retirement. | %name% kept their village safe as a child, but as the expectations of him grew, he quickly found himself burnt out. | %name% was a pathfinder during the battle of many names, on the eve of a battle a messenger advised a noble not much younger than him to not send calvary into the swamp against the greenskins. The noble declined, and the massacre that ensued has haunted him ever since. | His last contract involved hunting a beast that stole and slaughtered sheep near %randomtown%, only to find that the wolves were starving refugees who left him with a nasty scar. | %name% turned to teaching how to slay monsters, but found his students more eager to slay each other. | %name% was a famous slayer, killing all manner of beasts across the realm. However they found themselves in the middle of a riot and were run through by a boy with a pitchfork, leaving a gruesome scar on their back. | Others may not feel it, but there is something strange in the woods - something far worse than the wolves, giants and spiders %name% is used to. | He pledged himself to keep commonfolk safe and the wilds tame, but time has made him realise that they have more in common with what he kills than what he protects. | %name% does not feel he has much longer in this world, and wants to pass on as much as he can before it's too late. | People are becoming more desperate, irrational even. Those on the fringes of society are always the first to be targeted, which would explain why %name% is seeking the safety of like-minded slayers. | Despite all the trophies he has gathered, %name% never had time for a family. Now his family are those he can fight beside - you can't tell if he can see the tragedy in that yet. | All of his past students lay dead or missing - and it's something he rather you not dredge up in the future.}"
        es = "{Por fin la vejez ha alcanzado a %name%. | En otro tiempo un cazador de bestias experto, %name% se ha ido marchitando con la vejez. | %name% tiene un sinfín de historias que contar, y ya es lo bastante mayor para contarlas con honestidad. | La fama de %name% lo precede, pero en persona es mucho más débil que en los cuentos que te contaban en tu infancia.} {Muchas batallas y heridas menores han desgastado la salud de %name% hasta obligarlo a retirarse. | %name% mantuvo a salvo su aldea desde niño, pero a medida que crecían las expectativas puestas en él, no tardó en quemarse. | %name% fue explorador durante la Batalla de los Muchos Nombres. La víspera de la batalla, un mensajero aconsejó a un noble no mucho más joven que él que no enviara la caballería al pantano contra los pieles verdes. El noble no le hizo caso, y la masacre que siguió lo atormenta desde entonces. | Su último contrato consistió en cazar a una bestia que robaba y masacraba ovejas cerca de %randomtown%, pero resultó que los lobos eran refugiados hambrientos, que le dejaron una cicatriz fea. | %name% se dedicó a enseñar a matar monstruos, pero descubrió que sus alumnos estaban más deseosos de matarse entre ellos. | %name% fue un cazador de bestias famoso que mató todo tipo de criaturas por todo el reino. Sin embargo, se vio en medio de una revuelta y un chico lo atravesó con una horca, lo que le dejó una cicatriz espantosa en la espalda. | Puede que otros no lo noten, pero hay algo extraño en los bosques, algo mucho peor que los lobos, los gigantes y las arañas a los que está acostumbrado %name%. | Juró mantener a salvo a la gente común y domados los parajes salvajes, pero el tiempo le ha hecho ver que tienen más en común con lo que mata que con lo que protege. | %name% no cree que le quede mucho en este mundo, y quiere transmitir todo lo que pueda antes de que sea demasiado tarde. | La gente está cada vez más desesperada, incluso irracional. Los que viven al margen de la sociedad son siempre los primeros en sufrir los ataques, lo que explicaría por qué %name% busca la seguridad de otros cazadores afines. | Pese a todos los trofeos que ha reunido, %name% nunca tuvo tiempo para formar una familia. Ahora su familia son quienes luchan a su lado; no sabrías decir si ya ve la tragedia que hay en eso. | Todos sus antiguos alumnos están muertos o desaparecidos, y preferiría que no sacaras el tema en el futuro.}"
    }
    // FILE: scripts\skills\backgrounds\legend_healer_background.nut
    // context: legend_healer_background.create.m.Name
    {
        en = "Healer"
        es = "Sanador"
    }
    // context: legend_healer_background.create.m.Name
    {
        en = "Doctor"
        es = "Médico"
    }
    // context: legend_healer_background.create.m.Name
    {
        en = "Nurse"
        es = "Enfermero"
    }
    // context: legend_healer_background.create.m.Name
    {
        en = "Surgeon"
        es = "Cirujano"
    }
    // context: legend_healer_background.create.m.Titles
    {
        en = "soft hands"
        es = "manos suaves"
    }
    // context: legend_healer_background.create.m.Titles
    {
        en = "of the light"
        es = "de la luz"
    }
    // context: legend_healer_background.create.m.Titles
    {
        en = "the caring"
        es = "de buen corazón"
    }
    // context: legend_healer_background.create.m.Titles
    {
        en = "of grace"
        es = "de la gracia"
    }
    // context: legend_healer_background.create.m.Titles
    {
        en = "the benevolent"
        es = "el benevolente"
    }
    // context: legend_healer_background.create.m.Titles
    {
        en = "the reliever"
        es = "el aliviador"
    }
    // context: legend_healer_background.onBuildDescription
    {
        en = "{ %name% is a practicioner of the dark arts. |  %name% carries a slumped posture, as if weighted by otherworldly knowledge. | %name%'s face is transformed from its natural withered form | Not much is known about %name%, but strange rumors of sorcery and dark arts follow. | Wherever animals mysteriously begin to die, %name% makes an appearance. | The brooches on %name%'s cloak seem to swirl and dance like midnight in a jug. | %name%'s hands are rare to see, only coming out as if to portray the feelings of a face which lies hidden deep in its hood. | %name%'s eyes could be mistaken for a cat's one day and for a blind man's the next.} {Little is known of their history | their past i but a mystery to most. | Some say they traveled deep into the northern foothills, returning with unspoken knowledge. | Ostensibly, the dark arts are their heritage, or so it seems. | Their past is kept from all. Maybe it's just uninteresting, or maybe just the opposite. | One rumor  says he traveled the land as a spellweaver. | Rumors of magic surround the man, though some incredulous cynics are hardly impressed. | One rumor is that he was a conman, and another is that he's a sorcerer. You're not sure which you prefer. | With rumors of dark arts being practiced once more, the woman's magical proclamation just might be true. | Some say she eats toads for breakfast and black cats for dinner.} {You ask %name% a lot of questions, but through some handwaves and nods, you realize you have forgotten her answers. Or did you ask the questions at all? | %name% produces a dove from his sleeve. An old trick that fancies no one - until it turns in the air, returning to her as a crow. | %name% has shown the ability to shoot smoke from her mouth. It's not fire, but it's close, and has people talking in hushed tones. | %name% floats a gold coin into the air. An amazing display that leaves the woman too tired to attempt it again. | Predictions of the weather are common, but %name% is unusually accurate with her own. | %name% asks to read your palms. You decline. His presence alone is as close as you're willing to go. | %name% suggests that the stars are a roadmap to another world. She seems to know a lot about the heavens above. | %name% suggests that the heavens above are in fact just endless streams of beings, continuing on for eons. What a jest! | %name% points to one star in the sky and seems to suggest that is where she came from. You don't ask for a clarification on the matter.}"
        es = "{%name% practica las artes oscuras. | %name% va siempre con la espalda encorvada, como si cargara con el peso de un saber de otro mundo. | El rostro de %name% se ha transformado y ya no tiene su aspecto marchito natural. | No se sabe mucho de %name%, pero a su paso corren extraños rumores de brujería y artes oscuras. | Allá donde los animales empiezan a morir de forma misteriosa, aparece %name%. | Los broches de la capa de %name% parecen girar y danzar como la medianoche en una jarra. | Rara vez se ven las manos de %name%, que solo asoman como para expresar los sentimientos de un rostro oculto en lo hondo de la capucha. | Un día podrías confundir los ojos de %name% con los de un gato y, al siguiente, con los de un ciego.} {Poco se sabe de su historia. | Su pasado es un misterio para casi todos. | Hay quien dice que se adentró en las estribaciones del norte y regresó con saberes que no se pronuncian. | Según dicen, las artes oscuras le vienen de familia, o eso parece. | Oculta su pasado a todo el mundo. Quizá sea simplemente aburrido, o quizá todo lo contrario. | Un rumor dice que recorrió estas tierras tejiendo hechizos. | Corren rumores de magia en torno a su figura, aunque a algunos cínicos incrédulos apenas les impresionan. | Según un rumor, se dedicaba a estafar; según otro, a la hechicería. No sabes cuál prefieres. | Ahora que vuelven a correr rumores de que se practican las artes oscuras, puede que sus proclamas mágicas sean ciertas. | Hay quien dice que desayuna sapos y cena gatos negros.} {Le haces a %name% muchas preguntas, pero entre gestos con las manos y asentimientos, te das cuenta de que has olvidado sus respuestas. ¿O acaso llegaste a hacerle las preguntas? | %name% saca una paloma de la manga. Un truco viejo que no impresiona a nadie, hasta que da una vuelta en el aire y vuelve a su mano convertida en cuervo. | %name% ha demostrado que puede echar humo por la boca. No es fuego, pero se le acerca, y hace que la gente hable en susurros. | %name% hace flotar una moneda de oro en el aire. Una demostración asombrosa tras la cual no le quedan fuerzas para intentarlo de nuevo. | Predecir el tiempo es algo común, pero %name% acierta con sus predicciones de forma inusual. | %name% pide leerte las palmas de las manos. Te niegas. Su sola presencia ya es todo lo cerca que estás dispuesto a llegar. | %name% sugiere que las estrellas son un mapa de caminos hacia otro mundo. Parece saber mucho de los cielos. | %name% sugiere que los cielos no son más que corrientes infinitas de seres que se prolongan durante eones. ¡Menuda broma! | %name% señala una estrella del cielo y parece dar a entender que viene de allí. No le pides que te lo aclare.}"
    }
    // FILE: scripts\skills\backgrounds\legend_herbalist_background.nut
    // context: legend_herbalist_background.create.m.Name
    {
        en = "Herbalist / Apothecaries"
        es = "Herbolario / Boticario"
    }
    // context: legend_herbalist_background.create.m.BackgroundDescription
    {
        en = "Herbalists and Apothecaries are skilled with a sickle, harvesting herbs for use in medicine"
        es = "Los herbolarios y los boticarios manejan bien la hoz, con la que recogen hierbas para hacer medicinas"
    }
    // context: legend_herbalist_background.create.m.GoodEnding
    {
        en = "%name% the herbalist left to start an Apothecary in the wetlands, business is good and remedies abound. Last you heard %name% had discovered a cure for bunions and people traveled from far and wide to try the soup"
        es = "%name% se marchó a abrir una botica en los humedales; el negocio va bien y los remedios abundan. Lo último que supiste es que %name% había descubierto un remedio para los juanetes y que la gente venía de todas partes a probar la sopa"
    }
    // context: legend_herbalist_background.create.m.BadEnding
    {
        en = "%name% went off to become a herbalist again, but the cures didn't work and they soon got a reputation as a quack. Looking for more potent cures, %name% poisoned %themselves% and never recovered."
        es = "%name% se marchó para volver a ser herbolari%o%, pero sus remedios no funcionaban y pronto se ganó fama de matasanos. En busca de remedios más potentes, %name% acabó envenenándose y nunca se recuperó."
    }
    // context: legend_herbalist_background.create.m.Titles
    {
        en = "the Gentle"
        es = "el Apacible"
    }
    // context: legend_herbalist_background.create.m.Titles
    {
        en = "the Soothsayer"
        es = "el Vidente"
    }
    // context: legend_herbalist_background.create.m.Titles
    {
        en = "the Healer"
        es = "el Sanador"
    }
    // context: legend_herbalist_background.create.m.Titles
    {
        en = "the Apothecary"
        es = "el Boticario"
    }
    // context: legend_herbalist_background.onBuildDescription
    {
        en = "{After raiders murdered %their% family, %name% retreated into the swamp and became a herbalist. | Rarely traveling, %name% preferred the company of the birds. | %name%, has searched far and wide for curative ingredients. | A wandering herbalist, %name% used to traverse the wild landscapes near %randomtown%. | Abandoned to a river, %name% grew up in the wildlands, and learned how to make use of natural ingredients. | Trying to heal a land of ruin, %name% became a herbalist. | Always an unruly child, %name%'s parents let %them% run wild in the woods where %they% eventually learned to love the plants more than humans.} {Unfortunately, %their% master's liking for youth and fleshen things led to a terrible scandal. %name% fled to preserve %their% life. | But %their% faith was irreversibly damaged as a hellacious attack by raiders left men castrated, women raped, and children skewered on spits. | Though a believer in the old gods, the herbalist could not stand the world of men. The herbalist eventually left to seek spirituality on %their% own terms. | As the world's suffering grew, %name%'s abbot requested that %they% go out and heal the people of the earth - or kill those who did them wrong. | Cults of death, beasts of nightmare, and men of cruelty. %name% left the halls of %their% temple to purify them all. | But seeing the horrible things humans wrought, %name% abandoned the city, seeking out survival by other means. | Unfortunately, %their% herbs could not save others from slaughter. %name% realized that %their% herbs were better invested in looking out for oneself than muttering to some so-called god. | Always fiery, %name% left the safety of the wetlands to go out and heal the world. | One of the few literate men around, %name% abandoned %their% ascetic life to learn more of the world and, hopefully, to cure that which sickened it. | But one night a woman %they% bedded convinced %them% to consider the plight of others,  and they never returned to the swamp. | But %they% used %their% trusted position for ill-gotten gains, stealing from the apothecary's treasury. It didn't take long for the scandal to drive %them% out. | Unfortunately, there were accusations of witchcraft. Nobody knows the truth behind the story, but %name% did not last much longer at the church. | One night, witnessing a terrible event in the beloved wetlands. Not long after, %name% quickly left the swamp, never quite saying what was discovered.} {The herbalist hardly knows a thing about fighting, but is very skilled at slicing mushrooms quickly and accurately. | Years of solitude and prayer have left %name% out of shape, but it is %their% quick hands that is of most value. | Perhaps never really content with %their% life, it's difficult to entirely know why someone like %name% would join a band of mercenaries. | Maybe there are too many illnesses in the world, or too many inside, but you don't question why %name% wishes to join a band of sellswords. | Medicine won't cleave a greenskin, but a sickle might. | %name%'s stated desire to rid the world of 'the sickness' is almost scary in its determination. | While %name%'s knowledge of secret things is to be commended, the constant mutterings to the old gods are a bit annoying. | While %name% may not be used to armor and shields, few mercenaries have the skill with a blade. | A bundle of herbs in hand, %name% has sought the company of sellswords. | The pestle %they% carries is thick enough to be used as a shield, but %name% looks absolutely horrified when you say as much out loud. | Perhaps with a romantic view of mercenaries in need of a a remedy, %name% seeks to accompany sellswords. | Once having read of warrior priests, %name% now wishes to emulate those brave, unwavering soldiers of faith. | You get the feeling %name% wants release from this sickened world. If that's the truth then this is the right place.}"
        es = "{Después de que unos saqueadores asesinaran a su familia, %name% se refugió en el pantano y se hizo herbolari%o%. | %name% rara vez viajaba y prefería la compañía de los pájaros. | %name% ha buscado ingredientes curativos por todas partes. | Como herbolari%o% errante, %name% solía recorrer los parajes salvajes cerca de %randomtown%. | Abandonad%o% en un río, %name% creció en las tierras salvajes y aprendió a aprovechar los ingredientes naturales. | Con la intención de sanar una tierra en ruinas, %name% se hizo herbolari%o%. | %name% siempre fue %un% niñ%o% revoltos%o%, y sus padres %lo% dejaban corretear a sus anchas por el bosque, donde acabó queriendo más a las plantas que a las personas.} {Por desgracia, la afición de su maestro por la juventud y las cosas de la carne desembocó en un escándalo terrible. %name% huyó para salvar la vida. | Pero su fe quedó dañada sin remedio cuando un ataque infernal de saqueadores dejó hombres castrados, mujeres violadas y niños ensartados en espetones. | Aunque creía en los viejos dioses, no soportaba el mundo de los hombres. Al final se marchó en busca de la espiritualidad a su manera. | A medida que crecía el sufrimiento del mundo, el abad de %name% le pidió que saliera a sanar a las gentes de la tierra, o a matar a quienes les hacían daño. | Cultos de la muerte, bestias de pesadilla y hombres crueles. %name% dejó los salones de su templo para purificarlos a todos. | Pero al ver las cosas horribles que forjaban los humanos, %name% abandonó la ciudad y buscó sobrevivir por otros medios. | Por desgracia, sus hierbas no pudieron salvar a otros de la matanza. %name% se dio cuenta de que sus hierbas servían más para cuidar de uno mismo que para musitarle a algún supuesto dios. | De carácter siempre ardiente, %name% dejó la seguridad de los humedales para salir a sanar el mundo. | Una de las pocas personas de la zona que sabían leer, %name% abandonó su vida ascética para saber más del mundo y, con suerte, curar lo que lo enfermaba. | Pero una noche, una mujer con la que se acostó %lo% convenció de pensar en las penurias ajenas, y nunca volvió al pantano. | Pero aprovechó su puesto de confianza para enriquecerse de mala manera, robando del tesoro de la botica. El escándalo no tardó en echar%lo%. | Por desgracia, hubo acusaciones de brujería. Nadie sabe qué hay de cierto en la historia, pero %name% no duró mucho más en la iglesia. | Una noche presenció algo terrible en sus queridos humedales. Poco después, %name% se marchó a toda prisa del pantano, sin llegar a contar nunca qué había descubierto.} {%Art% herbolari%o% apenas sabe nada de combate, pero corta setas con gran rapidez y precisión. | Años de soledad y oración han dejado a %name% en baja forma, pero lo más valioso son sus manos rápidas. | Quizá nunca estuvo del todo content%o% con su vida; cuesta saber por qué alguien como %name% se uniría a una banda de mercenarios. | Quizá haya demasiadas enfermedades en el mundo, o demasiadas por dentro, pero no preguntas por qué %name% quiere unirse a una banda de mercenarios. | La medicina no parte en dos a un piel verde, pero una hoz puede que sí. | El deseo declarado de %name% de librar al mundo de 'la enfermedad' casi da miedo por su determinación. | Aunque los conocimientos de %name% sobre cosas secretas son dignos de elogio, sus constantes murmullos a los viejos dioses resultan un poco molestos. | Puede que %name% no esté acostumbrad%o% a armaduras y escudos, pero pocos mercenarios manejan así una hoja. | Con un manojo de hierbas en la mano, %name% ha buscado la compañía de mercenarios. | La mano de mortero que lleva es lo bastante gruesa para usarla de escudo, pero %name% pone cara de auténtico horror cuando lo dices en voz alta. | Quizá por una visión romántica de unos mercenarios necesitados de remedios, %name% busca acompañarlos. | Tras haber leído sobre sacerdotes guerreros, %name% quiere ahora emular a esos soldados de la fe, valientes e inquebrantables. | Tienes la sensación de que %name% quiere liberarse de este mundo enfermo. Si es así, está en el lugar adecuado.}"
    }
    // FILE: scripts\skills\backgrounds\legend_horse.nut
    // context: legend_horse.create.m.BackgroundDescription
    {
        en = "Horses are used to long and exhausting travels."
        es = "Los caballos están acostumbrados a viajes largos y agotadores."
    }
    // context: legend_horse.create.m.GoodEnding
    {
        en = "%name% the horse was retired to a lovely paddock and spent the days eating and carousing with other horses."
        es = "Retiraron a %name% a un precioso prado, donde pasó los días comiendo y retozando con otros caballos."
    }
    // context: legend_horse.create.m.BadEnding
    {
        en = "%name% the horse was sold to a trader, their caravan was attacked by orcs and the remains of %name% were never found"
        es = "Vendieron a %name% a un comerciante. Unos orcos atacaron su caravana y nunca se encontraron los restos de %name%"
    }
    // context: legend_horse.onBuildDescription
    {
        en = "{  %name% was raised to pull plows on a farm. |  %name% was reared by a traveling merchant. | A horses's life is tough %name% has been used for many things. | Though the work is dangerous, being a caravan horse allowed %name% to see the world. | When her former owner died, %name% was put up for sale. | Hardy and resolute, %name% was the pick of the bunch. | Sold from owner to owner %name% has worked for more caravans than most traders.} {But the trader she worked for turned out to be abusive, nary a whip away from being a slave driver. A farmer bought %name% to free her, but eventually the cost got too great and she was sold again. | One day, goods went missing and she was blamed for it, promptly ending her time with the caravan. | But a caravan needs protection for a reason, and an ambush by brigands proved why. %name% barely made it out alive. | Years on the road went without a hitch until a new caravan master died on the road and %name% was left tied to a wagon without food until rescued. | Caravans are frequently attacked, and in one battle as the caravan hands fell %name% ran into the night. | Sadly, with the expanding war the caravan's profits were marginal. %name% was let go as the merchants retired their wagons. | After seeing the foul work of beasts on a their caravan, it didn't take long for %name% to find a new owner. | But war deprived the caravan of stock and soon its driver took to selling the donkeys.  %name% was among the last to be sold. | Sadly, her caravan began to sell human chattel. While the profits were enormous, it garnered the attention of a local militia - and their pitchforks. One ambush later and %name% was running for her life.} {Now %name% is being sold by a farmer for being too stubborn  | A horse like %name% is no stranger to danger, making her a good fit for any mercenary group. | With her caravan days behind her, working for a sellsword was just another avenue for oats. | In %name%'s mind, being a mercenary is a lot like being a caravanner. Just more carrots. | Well versed to traveling, %name% seems like a natural fit to the tasks already befit for a mercenary. | Years of road travel have molded %name% into quite the durable figure. Any group of mercenaries could use more horses like her.}"
        es = "{Criaron a %name% para tirar del arado en una granja. | Un mercader itinerante crió a %name%. | La vida de un caballo es dura, y a %name% la han usado para muchas cosas. | Aunque el trabajo es peligroso, tirar de una caravana le permitió a %name% ver mundo. | Cuando murió su antiguo dueño, pusieron a %name% a la venta. | Dura y resuelta, %name% era la mejor del lote. | Vendida de dueño en dueño, %name% ha trabajado para más caravanas que la mayoría de los comerciantes.} {Pero el comerciante para el que trabajaba resultó ser un maltratador, a un látigo de distancia de ser un negrero. Un granjero compró a %name% para liberarla, pero al final el coste fue demasiado y volvió a venderla. | Un día desaparecieron unas mercancías y le echaron la culpa, lo que puso fin de inmediato a su tiempo en la caravana. | Pero por algo las caravanas necesitan protección, y una emboscada de bandidos lo demostró. %name% salió con vida por los pelos. | Pasó años en el camino sin contratiempos, hasta que un nuevo jefe de caravana murió durante el viaje y dejó a %name% atada a un carro y sin comida hasta que la rescataron. | Las caravanas sufren ataques con frecuencia, y en una de esas batallas, mientras caían los caravaneros, %name% huyó en la noche. | Por desgracia, con la guerra cada vez más extendida, las ganancias de la caravana eran mínimas. Los mercaderes retiraron sus carros y se deshicieron de %name%. | Después de ver la obra inmunda de las bestias en su caravana, %name% no tardó en encontrar un nuevo dueño. | Pero la guerra dejó la caravana sin existencias y su conductor no tardó en ponerse a vender los burros. %name% fue de las últimas en venderse. | Por desgracia, su caravana empezó a traficar con ganado humano. Aunque las ganancias eran enormes, atrajo la atención de una milicia local, y de sus horcas. Una emboscada después, %name% corría para salvar la vida.} {Ahora un granjero vende a %name% por ser demasiado terca. | Una yegua como %name% no es ajena al peligro, lo que la hace idónea para cualquier grupo de mercenarios. | Con sus días de caravana atrás, trabajar para un mercenario no era más que otra forma de conseguir avena. | Para %name%, la vida de mercenario se parece mucho a la de caravana. Solo que con más zanahorias. | Muy hecha a los viajes, %name% parece encajar de forma natural en las tareas propias de un mercenario. | Años de caminos han hecho de %name% una figura de lo más resistente. A cualquier grupo de mercenarios le vendrían bien más caballos como ella.}"
    }
    // FILE: scripts\skills\backgrounds\legend_horse_courser.nut
    // context: legend_horse_courser.create.m.Name
    {
        en = "Courser"
        es = "Corcel"
    }
    // context: legend_horse_courser.create.m.BackgroundDescription
    {
        en = "Coursers are swift and strong horses well-suited for war, hunting and transportation."
        es = "Los corceles son caballos rápidos y fuertes, muy adecuados para la guerra, la caza y el transporte."
    }
    // context: legend_horse_courser.create.m.GoodEnding
    {
        en = "%name% the Courser was sold to a Lady of a Noble House as her coming-of-age present. Though its fighting skill dulled with age, it was well-loved and enjoyed the luxurious life of a Noble's steed."
        es = "Vendieron a %name% a una dama de una casa noble como regalo por su mayoría de edad. Aunque con los años perdió destreza en combate, recibió mucho cariño y disfrutó de la vida lujosa de los corceles de la nobleza."
    }
    // context: legend_horse_courser.create.m.BadEnding
    {
        en = "%name% the Courser didn't wear its warwounds with as much pride and dignity one could have hoped, and one time when the horse encountered a knight in the city, it went wild and started bucking. When the knight himself was unhorsed in the commotion, there was no mercy. %name% was put down."
        es = "%name% no llevó sus heridas de guerra con todo el orgullo y la dignidad que cabía esperar, y una vez, al cruzarse con un caballero en la ciudad, se desbocó y empezó a dar corcovos. Cuando el propio caballero acabó desmontado en el alboroto, no hubo piedad. Sacrificaron a %name%."
    }
    // context: legend_horse_courser.onBuildDescription
    {
        en = "{%name% was raised as a fine riding horse.|%name% was reared by a Burgher.|Though the work is dangerous, being the steed of a Squire allowed %name% to see the world. | Fast as the lightning and sturdy as an oak, %name% was the pick of the bunch.|%name% has carried their owner to more important meetings than battles|%name% has an illustrious history of serving as the steed of notable Burghers, though none know why it has so often been sold on. | %name%'s swift speed has their owner's life numerous times. | More than once, %name% has stood steady as even men ran in fear, saving both the life and reputation of its owner. | When the former owner fell on hard times, %name% was put up for sale. | When its owner fell in battle, their comrades put %name% up for sale to help his widow | Though a fine a Courser as most others, the former owner still put %name% up for sale when he acquired an even finer steed. | Lost in a bet, %name% was put up for sale as the new owner was more interested in money than a steed.}"
        es = "{Criaron a %name% para ser una buena montura. | Un burgués crió a %name%. | Aunque el trabajo es peligroso, ser la montura de un escudero le permitió a %name% ver mundo. | Con la rapidez del rayo y la firmeza de un roble, %name% era lo mejor del lote. | %name% ha llevado a su dueño a más reuniones importantes que batallas. | %name% tiene un historial ilustre como montura de burgueses notables, aunque nadie sabe por qué ha cambiado de manos tantas veces. | La rapidez de %name% ha salvado la vida de su dueño en numerosas ocasiones. | Más de una vez, %name% se ha mantenido firme mientras incluso los hombres huían de miedo, y ha salvado así la vida y la reputación de su dueño. | Cuando su antiguo dueño pasó por tiempos difíciles, puso a %name% a la venta. | Cuando su dueño cayó en batalla, sus camaradas pusieron a %name% a la venta para ayudar a su viuda. | Aunque es un corcel tan bueno como la mayoría, su antiguo dueño puso a %name% a la venta cuando consiguió una montura aún mejor. | Tras una apuesta perdida, a %name% le tocó un nuevo dueño que prefería el dinero a una montura, y acabó a la venta.}"
    }
    // FILE: scripts\skills\backgrounds\legend_horse_destrier.nut
    // context: legend_horse_destrier.create.m.Name
    {
        en = "Destrier"
        es = "Destrero"
    }
    // context: legend_horse_destrier.create.m.BackgroundDescription
    {
        en = "Despite being so highly prized by fighting men they are also called Great Horses, not all knights can afford them over courser, and rare indeed is the non-Noble riding one"
        es = "Los destreros, a los que también llaman grandes caballos, son muy apreciados por los hombres de armas, pero no todos los caballeros pueden permitírselos en lugar de un corcel, y es raro de verdad ver a alguien que no sea noble montando uno"
    }
    // context: legend_horse_destrier.create.m.GoodEnding
    {
        en = "A marvel of a fighting horse, %name% the Destrier was retired to horse breeder, where he was treated lavishly as he helped father the next generation of living engines-of-war"
        es = "Toda una maravilla de caballo de guerra, %name%, el destrero, se retiró con un criador de caballos, que lo trató a cuerpo de rey mientras ayudaba a engendrar la siguiente generación de máquinas de guerra vivientes"
    }
    // context: legend_horse_destrier.onBuildDescription
    {
        en = "{%name% was raised to batter men into submission through sheer size and strength. |  %name% was reared by a skilled and rich horse breeder. | A Destrier's life is bloody, and %name% has trampled many men underneath his hooves. | Though the work is dangerous, being the steed of an infamous Robber Knight allowed %name% to see the world, and kill its people. | The size of a wagon and able to carry any man, %name%'s first owner paid a fortune to acquire him. | %name% carried his owner through many a both battle and tourney. | %name% was there when a cavalry charge broke the spine of a rampaging horde of Greenskins. | With an ornery streak a mile wide, %name% has cost many a stableboy their hand. | Rumors have swirled that %name% owner fed him on human flesh, though they never told to the owner's face. | While most horses would never dream of charging into battle and flee at the first sign of danger, not so for %name%. He seems to almost be gleeful when shattering humans beneath his weight. | When an errant lance-stroke hit his owner in the neck and killed him, %name% was taken as loot and put up for sale. | As useful as a Destrier is on the battlefield, they are of no use against an assassin's blade in the night, such as the one that claimed %name%'s prior owner. | Since then, %name% has bucked and trampled many a prospective owner, respecting only the strongest of riders. }"
        es = "{Criaron a %name% para someter a los hombres a golpes con su sola corpulencia y su fuerza. | Un criador de caballos rico y hábil crió a %name%. | La vida de un destrero es sangrienta, y %name% ha pisoteado a muchos hombres bajo sus cascos. | Aunque el trabajo es peligroso, ser la montura de un infame caballero ladrón le permitió a %name% ver mundo, y matar a sus gentes. | Del tamaño de un carro y capaz de cargar con cualquier hombre, %name% le costó una fortuna a su primer dueño. | %name% llevó a su dueño a más de una batalla y a más de un torneo. | %name% estuvo allí cuando una carga de caballería quebró el espinazo de una horda desbocada de pieles verdes. | Con un mal genio de una legua de ancho, %name% le ha costado la mano a más de un mozo de cuadra. | Corren rumores de que el dueño de %name% lo alimentaba con carne humana, aunque nadie se lo dijo nunca a la cara. | Mientras que la mayoría de los caballos jamás soñarían con cargar en batalla y huyen a la primera señal de peligro, no es el caso de %name%. Casi parece disfrutar cuando aplasta a los humanos bajo su peso. | Cuando una lanzada perdida alcanzó a su dueño en el cuello y lo mató, se llevaron a %name% como botín y lo pusieron a la venta. | Por útil que sea un destrero en el campo de batalla, de nada sirve contra la hoja de un asesino en plena noche, como la que se cobró la vida del anterior dueño de %name%. | Desde entonces, %name% ha derribado y pisoteado a muchos posibles dueños, y solo respeta a los jinetes más fuertes. }"
    }
    // FILE: scripts\skills\backgrounds\legend_horse_rouncey.nut
    // context: legend_horse_rouncey.create.m.Name
    {
        en = "Rouncey"
        es = "Rocín"
    }
    // context: legend_horse_rouncey.create.m.BackgroundDescription
    {
        en = "Rounceys are primarily packhorses used to long and exhausting travels, though they are able to be trained for battle"
        es = "Los rocines son sobre todo caballos de carga acostumbrados a viajes largos y agotadores, aunque se les puede adiestrar para la batalla"
    }
    // context: legend_horse_rouncey.onBuildDescription
    {
        en = "{%name% was raised to pull plows on a farm. |  %name% was reared by a traveling merchant. | A workhorse's life is tough %name% has been used for many things. | Though the work is dangerous, being a packhorse for a caravan allowed %name% to see the world. | When her former owner died, %name% was put up for sale. | Sold from owner to owner %name% has worked for more caravans than most traders. s| But the trader she worked for turned out to be abusive, nary a whip away from being a slave driver. A farmer bought %name% to free her, but eventually the cost got too great and she was sold again. | One day, goods went missing and she was blamed for it, promptly ending her time with the caravan. | But a caravan needs protection for a reason, and an ambush by brigands proved why. %name% barely made it out alive. | Years on the road went without a hitch until a new caravan master died on the road and %name% was left tied to a wagon without food until rescued. | Caravans are frequently attacked, and in one battle as the caravan hands fell %name% ran into the night. | Sadly, with the expanding war the caravan's profits were marginal. %name% was let go as the merchants retired their wagons. | After seeing the foul work of beasts on a their caravan, it didn't take long for %name% to find a new owner. | But war deprived the caravan of stock and soon its driver took to selling the animals.  %name% was among the last to be sold. | Sadly, her caravan began to sell human chattel. While the profits were enormous, it garnered the attention of a local militia - and their pitchforks. One ambush later and %name% was running for her life. | Now %name% is being sold by a farmer too deep in debt | With her caravan days behind her, working for a sellsword was just another avenue for oats. |  Well versed to traveling, %name% seems like a natural fit to the tasks already befit for a mercenary.}"
        es = "{Criaron a %name% para tirar del arado en una granja. | Un mercader itinerante crió a %name%. | La vida de un caballo de tiro es dura, y a %name% la han usado para muchas cosas. | Aunque el trabajo es peligroso, cargar con los fardos de una caravana le permitió a %name% ver mundo. | Cuando murió su antiguo dueño, pusieron a %name% a la venta. | Vendida de dueño en dueño, %name% ha trabajado para más caravanas que la mayoría de los comerciantes. | Pero el comerciante para el que trabajaba resultó ser un maltratador, a un látigo de distancia de ser un negrero. Un granjero compró a %name% para liberarla, pero al final el coste fue demasiado y volvió a venderla. | Un día desaparecieron unas mercancías y le echaron la culpa, lo que puso fin de inmediato a su tiempo en la caravana. | Pero por algo las caravanas necesitan protección, y una emboscada de bandidos lo demostró. %name% salió con vida por los pelos. | Pasó años en el camino sin contratiempos, hasta que un nuevo jefe de caravana murió durante el viaje y dejó a %name% atada a un carro y sin comida hasta que la rescataron. | Las caravanas sufren ataques con frecuencia, y en una de esas batallas, mientras caían los caravaneros, %name% huyó en la noche. | Por desgracia, con la guerra cada vez más extendida, las ganancias de la caravana eran mínimas. Los mercaderes retiraron sus carros y se deshicieron de %name%. | Después de ver la obra inmunda de las bestias en su caravana, %name% no tardó en encontrar un nuevo dueño. | Pero la guerra dejó la caravana sin existencias y su conductor no tardó en ponerse a vender los animales. %name% fue de las últimas en venderse. | Por desgracia, su caravana empezó a traficar con ganado humano. Aunque las ganancias eran enormes, atrajo la atención de una milicia local, y de sus horcas. Una emboscada después, %name% corría para salvar la vida. | Ahora un granjero hasta el cuello de deudas vende a %name%. | Con sus días de caravana atrás, trabajar para un mercenario no era más que otra forma de conseguir avena. | Muy hecha a los viajes, %name% parece encajar de forma natural en las tareas propias de un mercenario.}"
    }
    // FILE: scripts\skills\backgrounds\legend_horserider.nut
    // context: legend_horserider.create.m.Name
    {
        en = "Horse Rider"
        es = "Jinete"
    }
    // context: legend_horserider.onBuildDescription
    {
        en = "{  %name% was raised to pull plows on a farm. |  %name% was reared by a traveling merchant. | A donkey's life is tough %name% has been used for many things. | Though the work is dangerous, being a caravan donkey allowed %name% to see the world. | When her former owner died, %name% was put up for sale. | Hardy and resolute, %name% was the pick of the bunch. | Sold from owner to owner %name% has worked for more caravans than most traders.} {But the trader she worked for turned out to be abusive, nary a whip away from being a slave driver. A farmer bought %name% to free her, but eventually the cost got too great and she was sold again. | One day, goods went missing and she was blamed for it, promptly ending her time with the caravan. | But a caravan needs protection for a reason, and an ambush by brigands proved why. %name% barely made it out alive. | Years on the road went without a hitch until a new caravan master died on the road and %name% was left tied to a wagon without food until rescued. | Caravans are frequently attacked, and in one battle as the caravan hands fell %name% ran into the night. | Sadly, with the expanding war the caravan's profits were marginal. %name% was let go as the merchants retired their wagons. | After seeing the foul work of beasts on a their caravan, it didn't take long for %name% to find a new owner. | But war deprived the caravan of stock and soon its driver took to selling the donkeys.  %name% was among the last to be sold. | Sadly, her caravan began to sell human chattel. While the profits were enormous, it garnered the attention of a local militia - and their pitchforks. One ambush later and %name% was running for her life.} {Now %name% is being sold by a farmer for being too stubborn  | A donkey like %name% is no stranger to danger, making her a good fit for any mercenary group. | With her caravan days behind her, working for a sellsword was just another avenue for oats. | In %name%'s mind, being a mercenary is a lot like being a caravanner. Just more carrots. | Well versed to traveling, %name% seems like a natural fit to the tasks already befit for a mercenary. | Years of road travel have molded %name% into quite the durable figure. Any group of mercenaries could use more donkeys like her.}"
        es = "{A %name% la criaron para tirar del arado en una granja. | A %name% la crió un mercader ambulante. | La vida de una burra es dura, y a %name% la han usado para muchas cosas. | Aunque el trabajo es peligroso, ser burra de caravana le permitió a %name% ver mundo. | Cuando murió su antiguo dueño, pusieron a la venta a %name%. | Robusta y resuelta, %name% era la mejor del lote. | Vendida de dueño en dueño, %name% ha trabajado para más caravanas que la mayoría de los comerciantes.} {Pero el comerciante para el que trabajaba resultó ser un maltratador, a un latigazo de ser un negrero. Un granjero compró a %name% para liberarla, pero al final el gasto se le hizo excesivo y volvieron a venderla. | Un día desaparecieron unas mercancías y la culparon a ella, lo que puso fin de inmediato a su tiempo en la caravana. | Pero por algo necesita protección una caravana, y una emboscada de bandoleros lo demostró. %name% salió con vida a duras penas. | Pasaron años de camino sin contratiempos, hasta que un nuevo jefe de caravana murió en ruta y %name% se quedó atada a un carro sin comida hasta que la rescataron. | Las caravanas sufren ataques a menudo, y en una batalla, mientras caían los caravaneros, %name% huyó en la noche. | Por desgracia, con la guerra extendiéndose, los beneficios de la caravana eran escasos. Se deshicieron de %name% cuando los mercaderes retiraron sus carros. | Tras ver la atroz obra de las bestias en su caravana, %name% no tardó en encontrar nuevo dueño. | Pero la guerra dejó a la caravana sin mercancía y pronto su arriero se puso a vender los burros. %name% fue de las últimas en venderse. | Por desgracia, su caravana empezó a comerciar con ganado humano. Aunque los beneficios eran enormes, atrajo la atención de una milicia local... y de sus horcas. Una emboscada después, %name% corría para salvar la vida.} {Ahora un granjero vende a %name% por ser demasiado terca. | Una burra como %name% está acostumbrada al peligro, lo que la hace idónea para cualquier grupo de mercenarios. | Con sus días de caravana atrás, trabajar para un mercenario no era más que otra forma de ganarse la avena. | Para %name%, ser mercenaria se parece mucho a trabajar en una caravana. Solo que con más zanahorias. | Acostumbrada a viajar, %name% parece hecha para las tareas propias de un mercenario. | Años de camino han convertido a %name% en una figura de lo más resistente. A cualquier grupo de mercenarios le vendrían bien más burras como ella.}"
    }
    // context: legend_horserider.onSetAppearance.Sprites
    // en = "shield"  // nombre de sprite, no se muestra
    // en = "quiver"
    // FILE: scripts\skills\backgrounds\legend_husk_background.nut
    // context: legend_husk_background.create.m.Name
    {
        en = "Husk"
        es = "Cascarón"
    }
    // context: legend_husk_background.create.m.BackgroundDescription
    {
        en = "Once imbued with the will of a dead god, the departing of said god left this one...unpredictable."
        es = "Antaño imbuido de la voluntad de un dios muerto, este ser quedó... impredecible cuando dicho dios se marchó."
    }
    // context: legend_husk_background.getTooltip.ret.push().text
    {
        en = "Will never be sacrificed to Davkul"
        es = "Nunca servirá de sacrificio a Davkul"
    }
    // context: legend_husk_background.onBuildDescription
    {
        en = "{With a mind torn in half and nowhere else to go, %name% is a mess of gibbering voices and flailing fists at unseen attackers. | %They% clutch and imaginary insects and brush at unseen horrors crawling over %their% skin. | Their face an ever shifting soup of expressions. | Clothed in rags and decayed metal %they% stamp and struggle as if the earth was trying to swallow %them% whole. | Words are carved into %their% hands, face and any other virgin flesh available. | %name% spits and chitters at seemly mundane items as if every one of %them% were made from %their% own flesh. | The only constant in all this madness is a singular phrase, as you approach %them% you recite the words ingrained into your mind...} \"Davkul awaits\" you announce. %name% recomposes %themselves% instantly. \"Davkul awaits us all\" %they% reply, with perfect cadence."
        es = "{Con la mente partida en dos y sin otro lugar adonde ir, %name% es un amasijo de voces farfullantes y puños que golpean a atacantes invisibles. | Agarra insectos imaginarios y se sacude horrores invisibles que le reptan por la piel. | Su rostro es una sopa de expresiones en cambio constante. | Vestid%o% con harapos y metal podrido, patalea y forcejea como si la tierra intentara tragárse%lo% enter%o%. | Tiene palabras talladas en las manos, en la cara y en cualquier otro trozo de carne virgen disponible. | %name% escupe y castañetea ante objetos en apariencia corrientes, como si cada uno estuviera hecho de su propia carne. | Lo único constante en toda esta locura es una frase concreta: al acercarte a %el%, recitas las palabras que llevas grabadas en la mente...} \"Davkul espera\", anuncias. %name% se recompone al instante. \"Davkul nos espera a todos\", responde con una cadencia perfecta."
    }
    // FILE: scripts\skills\backgrounds\legend_illusionist_background.nut
    // context: legend_illusionist_background.create.m.Name
    {
        en = "Illusionist"
        es = "Ilusionista"
    }
    // context: legend_illusionist_background.onBuildDescription
    {
        en = "{ %name% is an expert in deception. |  %name% has an aluring gaze, as if knowing more than is aparent. | %name%'s eyes have glint in any light  | Not much is known about %name%, not for sure. Everything is an indiscernable mix of truths and untruths | Where ever the greatest story is told, %name% makes an appearance. | The brooches on %name%'s cloak seem to swirl and dance like midnight in a jug. | %name%'s true feelings are rarely known, everything is an act, designed to create an appearance of truth | %name%'s way with words is beguiling, you find yourself being drawn into conversation even when you have better things to be doing.} {%name% has lived many lives, depending who you ask | their past i but a mystery to most. | Some say %name% peered deep into the cup of stars and emerged with the ability to shape reality, others just say its all darned lies. | Who can say what is true in the past of one so good at spinning tales? | That history of %name% is subjective, each person you ask tells a different tale with complete honesty in their eyes. None of them agree, | One rumor says she traveled the land as a spellweaver. | Rumors of magic surround the woman, though some incredulous cynics are hardly impressed. | One rumor is that she was a conman, and another is that she's a sorcerer. You're not sure which you prefer. | With rumors of old magics stirring, the woman's magical proclamation just might be true. | Some say she sees the skenes of fate, and weaves new futures.} {You ask %name% a lot of questions, you hear an enthralling set of answers that keep you busy for hours. Despite all that detail you realize you have forgotten her answers. Or did you ask the questions at all? | %name% produces a dove from her sleeve. An old trick that fancies no one - until it turns in the air, returning to her as a crow. | %name% has shown the ability to shoot smoke from her mouth. It's not fire, but it's close, and has people talking in hushed tones. | %name% floats a coin into the air. An amazing display that leaves the woman too tired to attempt it again. | Predictions of the weather are common, but %name% can make weather appear. | %name% asks to read your palms. You decline. Her presence alone is as close as you're willing to go. | %name% suggests that the stars are a roadmap to another world. She seems to know a lot about the heavens above. | %name% suggests that the heavens above are in fact just endless streams of giant hungry eternal beings, continuing on for eons. What a jest! | %name% points to one star in the sky and seems to suggest that is where she came from. You don't ask for a clarification on the matter.}"
        es = "{%name% es una experta en el engaño. | %name% tiene una mirada seductora, como si supiera más de lo que aparenta. | Los ojos de %name% centellean con cualquier luz | No se sabe gran cosa de %name%, al menos no a ciencia cierta. Todo es una mezcla indescifrable de verdades y mentiras | Allí donde se cuenta la mejor historia, %name% hace acto de presencia. | Los broches de la capa de %name% parecen girar y danzar como la medianoche en una jarra. | Rara vez se conocen los verdaderos sentimientos de %name%: todo es una actuación pensada para dar apariencia de verdad | La labia de %name% es embaucadora; acabas enredándote en la conversación aun cuando tienes cosas mejores que hacer.} {%name% ha vivido muchas vidas, según a quién preguntes | su pasado no es más que un misterio para la mayoría. | Hay quien dice que %name% se asomó a lo más hondo de la copa de las estrellas y salió con el don de moldear la realidad; otros dicen sin más que todo son malditas mentiras. | ¿Quién puede saber qué hay de cierto en el pasado de alguien tan diestro en tejer historias? | La historia de %name% es subjetiva: cada persona a la que preguntas cuenta un relato distinto, con total sinceridad en la mirada. Ninguno coincide. | Según un rumor, recorrió estas tierras como tejedora de hechizos. | Rumores de magia rodean a esta mujer, aunque a algunos cínicos incrédulos no les impresionan lo más mínimo. | Hay un rumor que dice que era una estafadora, y otro, que es una hechicera. No sabes cuál prefieres. | Ahora que se habla del despertar de viejas magias, puede que las proclamas mágicas de esta mujer sean ciertas. | Hay quien dice que ve las madejas del destino y teje nuevos futuros.} {Le haces a %name% un montón de preguntas y escuchas una serie de respuestas fascinantes que te entretienen durante horas. Pese a tanto detalle, te das cuenta de que has olvidado sus respuestas. ¿O acaso llegaste a hacerle las preguntas? | %name% saca una paloma de la manga. Un truco viejo que no impresiona a nadie... hasta que la paloma gira en el aire y vuelve a ella convertida en cuervo. | %name% ha demostrado que puede echar humo por la boca. No es fuego, pero casi, y hace que la gente hable de ello en susurros. | %name% hace flotar una moneda en el aire. Una exhibición asombrosa que deja a la mujer demasiado cansada para volver a intentarlo. | Predecir el tiempo es algo común, pero %name% es capaz de invocarlo. | %name% te pide leerte las palmas de las manos. Te niegas. Su sola presencia ya es todo lo cerca que piensas llegar. | %name% sugiere que las estrellas son un mapa de caminos hacia otro mundo. Parece saber mucho de los cielos. | %name% sugiere que los cielos no son en realidad más que ríos interminables de seres gigantescos, hambrientos y eternos que se suceden durante eones. ¡Menuda broma! | %name% señala una estrella del cielo y parece dar a entender que viene de allí. No le pides que te lo aclare.}"
    }
    // context: legend_illusionist_background.onBuildDescription
    {
        en = "{ %name% is an expert in deception. |  %name% has an aluring gaze, as if knowing more than is aparent. | %name%'s eyes have glint in any light  | Not much is known about %name%, not for sure. Everything is an indiscernable mix of truths and untruths | Where ever the greatest story is told, %name% makes an appearance. | The brooches on %name%'s cloak seem to swirl and dance like midnight in a jug. | %name%'s true feelings are rarely known, everything is an act, designed to create an appearance of truth | %name%'s way with words is beguiling, you find yourself being drawn into conversation even when you have better things to be doing.} {%name% has lived many lives, depending who you ask | their past i but a mystery to most. | Some say %name% peered deep into the cup of stars and emerged with the ability to shape reality, others just say its all darned lies. | Who can say what is true in the past of one so good at spinning tales? | That history of %name% is subjective, each person you ask tells a different tale with complete honesty in their eyes. None of them agree, | One rumor says he traveled the land as a spellweaver. | Rumors of magic surround the man, though some incredulous cynics are hardly impressed. | One rumor is that he was a conman, and another is that he's a sorcerer. You're not sure which you prefer. | With rumors of old magics stirring, the man's magical proclamation just might be true. | Some say he sees the skenes of fate, and weaves new futures.} {You ask %name% a lot of questions, you hear an enthralling set of answers that keep you busy for hours. Despite all that detail you realize you have forgotten her answers. Or did you ask the questions at all? | %name% produces a dove from his sleeve. An old trick that fancies no one - until it turns in the air, returning to him as a crow. | %name% has shown the ability to shoot smoke from his mouth. It's not fire, but it's close, and has people talking in hushed tones. | %name% floats a coin into the air. An amazing display that leaves the man too tired to attempt it again. | Predictions of the weather are common, but %name% can make weather appear. | %name% asks to read your palms. You decline. His presence alone is as close as you're willing to go. | %name% suggests that the stars are a roadmap to another world. He seems to know a lot about the heavens above. | %name% suggests that the heavens above are in fact just endless streams of beings, continuing on for eons. What a jest! | %name% points to one star in the sky and seems to suggest that is where he came from. You don't ask for a clarification on the matter.}"
        es = "{%name% es un experto en el engaño. | %name% tiene una mirada seductora, como si supiera más de lo que aparenta. | Los ojos de %name% centellean con cualquier luz | No se sabe gran cosa de %name%, al menos no a ciencia cierta. Todo es una mezcla indescifrable de verdades y mentiras | Allí donde se cuenta la mejor historia, %name% hace acto de presencia. | Los broches de la capa de %name% parecen girar y danzar como la medianoche en una jarra. | Rara vez se conocen los verdaderos sentimientos de %name%: todo es una actuación pensada para dar apariencia de verdad | La labia de %name% es embaucadora; acabas enredándote en la conversación aun cuando tienes cosas mejores que hacer.} {%name% ha vivido muchas vidas, según a quién preguntes | su pasado no es más que un misterio para la mayoría. | Hay quien dice que %name% se asomó a lo más hondo de la copa de las estrellas y salió con el don de moldear la realidad; otros dicen sin más que todo son malditas mentiras. | ¿Quién puede saber qué hay de cierto en el pasado de alguien tan diestro en tejer historias? | La historia de %name% es subjetiva: cada persona a la que preguntas cuenta un relato distinto, con total sinceridad en la mirada. Ninguno coincide. | Según un rumor, recorrió estas tierras como tejedor de hechizos. | Rumores de magia rodean a este hombre, aunque a algunos cínicos incrédulos no les impresionan lo más mínimo. | Hay un rumor que dice que era un estafador, y otro, que es un hechicero. No sabes cuál prefieres. | Ahora que se habla del despertar de viejas magias, puede que las proclamas mágicas de este hombre sean ciertas. | Hay quien dice que ve las madejas del destino y teje nuevos futuros.} {Le haces a %name% un montón de preguntas y escuchas una serie de respuestas fascinantes que te entretienen durante horas. Pese a tanto detalle, te das cuenta de que has olvidado sus respuestas. ¿O acaso llegaste a hacerle las preguntas? | %name% saca una paloma de la manga. Un truco viejo que no impresiona a nadie... hasta que la paloma gira en el aire y vuelve a él convertida en cuervo. | %name% ha demostrado que puede echar humo por la boca. No es fuego, pero casi, y hace que la gente hable de ello en susurros. | %name% hace flotar una moneda en el aire. Una exhibición asombrosa que deja al hombre demasiado cansado para volver a intentarlo. | Predecir el tiempo es algo común, pero %name% es capaz de invocarlo. | %name% te pide leerte las palmas de las manos. Te niegas. Su sola presencia ya es todo lo cerca que piensas llegar. | %name% sugiere que las estrellas son un mapa de caminos hacia otro mundo. Parece saber mucho de los cielos. | %name% sugiere que los cielos no son en realidad más que ríos interminables de seres que se suceden durante eones. ¡Menuda broma! | %name% señala una estrella del cielo y parece dar a entender que viene de allí. No le pides que te lo aclare.}"
    }
    // FILE: scripts\skills\backgrounds\legend_inventor_background.nut
    // context: legend_inventor_background.create.m.BackgroundDescription
    {
        en = "Inventors are trenchant problem solvers, fueled by a burning passion for knowledge."
        es = "Los inventores resuelven problemas con agudeza, movidos por una ardiente pasión por el saber."
    }
    // context: legend_inventor_background.create.m.GoodEnding
    {
        en = "%name% initially did not fit in well with %companyname%, but given time everyone saw their value in setting both weapons and joints back together. They took their small fortune and set up a workshop to call their own, accidently creating a mortar that did not fire up in the air, but rather directly at the enemy."
        es = "Al principio, %name% no encajó bien en %companyname%, pero con el tiempo todos vieron su valía para recomponer tanto armas como articulaciones. Con su pequeña fortuna montó un taller propio, donde creó por accidente un mortero que no disparaba hacia arriba, sino directamente contra el enemigo."
    }
    // context: legend_inventor_background.create.m.BadEnding
    {
        en = "%name% was a misfit from the start, their lack of skill on the battlefield held them back compared to their stronger mercenary counterparts. Their journey ironically ended not on the battlefield but instead in their workshop, which stands only as a charred ruin."
        es = "%name% nunca encajó desde el principio: su falta de destreza en el campo de batalla le hacía quedarse atrás frente a mercenarios más fuertes. Irónicamente, su viaje no terminó en el campo de batalla, sino en su taller, del que hoy solo quedan unas ruinas calcinadas."
    }
    // context: legend_inventor_background.getTooltip.ret.push().text
    {
        en = "[color=%positive%]+20%[/color] Experience Gain"
        es = "[color=%positive%]+20%[/color] Experiencia ganada"
    }
    // context: legend_inventor_background.onBuildDescription
    {
        en = "{Having spent most of his life in and around %townname%, covered in books, conducting various experiments and creating all sort of contraptions, %name% eventually turned his eyes towards knights, soldiers, sellswords, brigands and others that live and die by the sword. Perhaps his knowledge could be applied to their circumstances? Could he possibly become a great fighter himself? Tempted and intrigued by his own thoughts, he wasted no time setting out to look for a mercenary company that would consider taking him in. What could go wrong?}"
        es = "{Tras pasar la mayor parte de su vida en %townname% y sus alrededores, enterrado en libros, realizando experimentos de todo tipo y creando toda clase de artilugios, %name% acabó por fijarse en caballeros, soldados, mercenarios, bandoleros y demás gente que vive y muere por la espada. ¿Quizá sus conocimientos podrían aplicarse a sus circunstancias? ¿Podría llegar a convertirse él mismo en un gran guerrero? Tentado e intrigado por sus propias ideas, no perdió tiempo en salir a buscar una compañía de mercenarios que estuviera dispuesta a aceptarlo. ¿Qué podía salir mal?}"
    }
    // FILE: scripts\skills\backgrounds\legend_ironmonger_background.nut
    // context: legend_ironmonger_background.create.m.Name
    {
        en = "Ironmonger"
        es = "Ferretero"
    }
    // context: legend_ironmonger_background.create.m.BackgroundDescription
    {
        en = "Ironmongers are stronger than average and good at maintaining equipment."
        es = "Los ferreteros son más fuertes que la media y se les da bien mantener el equipo."
    }
    // context: legend_ironmonger_background.create.m.GoodEnding
    {
        en = "A more reliable sellsword than most, %name%'s background as an ironmonger helped %them% to keep the %companyname%'s equipment functioning. Having saved more than enough crowns, %name% retired and returned to blacksmithing, learning from a true master and becoming a paragon of the craft. Last you heard of %them% %they% was living in luxury, making custom weapons and armor for nobles."
        es = "Más fiable que la mayoría de los mercenarios, %name% aprovechó su pasado de ferreter%o% para mantener en funcionamiento el equipo de %companyname%. Tras ahorrar coronas de sobra, %name% se retiró y volvió a la herrería, donde aprendió de un auténtico maestro hasta convertirse en un modelo del oficio. Lo último que supiste de %el% es que vivía rodead%o% de lujos, forjando armas y armaduras a medida para nobles."
    }
    // context: legend_ironmonger_background.create.m.BadEnding
    {
        en = "%name% the ironmonger stayed with the %companyname% for some time after your departure, but after a particularly nasty stretch of bad luck %they% saw the rot for what it was and jumped ship. Bad luck seemed to follow %them%, however, and %they% never managed to settle down. He burned through his leftover crowns in a few years. He died in poverty one winter, freezing overnight."
        es = "%name%, %art% ferreter%o%, siguió en %companyname% un tiempo tras tu marcha, pero después de una racha de mala suerte especialmente cruel vio la podredumbre por lo que era y abandonó el barco. Sin embargo, la mala suerte pareció perseguir%lo%, y nunca logró asentarse. En pocos años dilapidó las coronas que le quedaban. Murió en la miseria un invierno, congelad%o% en una sola noche."
    }
    // context: legend_ironmonger_background.create.m.Titles
    {
        en = "the Ironmonger"
        es = "el Ferretero"
    }
    // context: legend_ironmonger_background.create.m.Titles
    {
        en = "the Farrier"
        es = "el Herrador"
    }
    // context: legend_ironmonger_background.create.m.Titles
    {
        en = "the Scavenger"
        es = "el Carroñero"
    }
    // context: legend_ironmonger_background.create.m.Titles
    {
        en = "the Iron-shaper"
        es = "el Forjahierros"
    }
    // context: legend_ironmonger_background.create.m.Titles
    {
        en = "the Scrounger"
        es = "el Rebuscador"
    }
    // context: legend_ironmonger_background.onBuildDescription
    {
        en = "{When one needs tools repaired but cannot afford a blacksmith, they seek out their local ironmonger. | A self taught smith working from scrap metal, the ironmonger works mostly with farm tools and horseshoes.} {No ironmonger can compare to the skills of a full fledged blacksmith, but it can be a lucrative profession in smaller villages. | Though lacking the skills of a fully trained blacksmith, ironmongers are vital for some settlements, too small or remote to merit a resident blacksmith.} {%name% was an ironmonger in %townname%. | %name% served for many years as an ironmonger in %townname%. | %name% was an ironmonger, like %their% father. | Urged by %their% parents to join the craft, %name% was an ironmonger for many years. | Not to be outdone by %their% overachieving militia sister, %name% learned to smith and served as the local ironmonger.} {Unfortunately, a trained blacksmith arrived in town, and %name%'s skills were quickly rendered obsolete. Facing poverty, %they% left home to join a company of sellswords. | %name%'s clients eventually dried up, and %they% was forced to leave home and seek new work. | %name% eventually left home due to a tragedy that %they% refused to speak of. Face grim, %they% seeks new employment.}"
        es = "{Cuando alguien necesita reparar sus herramientas pero no puede pagar a un herrero, acude al ferretero del lugar. | Herrero autodidacta que trabaja con chatarra, el ferretero se dedica sobre todo a aperos de labranza y herraduras.} {Ningún ferretero puede compararse con la destreza de un herrero hecho y derecho, pero en las aldeas pequeñas puede ser un oficio lucrativo. | Aunque carecen de la destreza de un herrero con formación completa, los ferreteros son vitales para algunos asentamientos demasiado pequeños o remotos como para tener herrero propio.} {%name% era ferreter%o% en %townname%. | %name% trabajó muchos años como ferreter%o% en %townname%. | %name% era ferreter%o%, como su padre. | Animad%o% por sus padres a dedicarse al oficio, %name% fue ferreter%o% durante muchos años. | Para no quedarse atrás frente a su hermana, una miliciana sobresaliente, %name% aprendió a forjar y ejerció de ferreter%o% del lugar.} {Por desgracia, llegó al pueblo un herrero con formación, y el oficio de %name% quedó obsoleto en poco tiempo. Ante la pobreza, dejó su hogar para unirse a una compañía de mercenarios. | Con el tiempo, los clientes de %name% desaparecieron, y se vio obligad%o% a dejar su hogar y buscar otro trabajo. | %name% acabó dejando su hogar por una tragedia de la que se negó a hablar. Con gesto sombrío, busca un nuevo empleo.}"
    }
    // FILE: scripts\skills\backgrounds\legend_leech_peddler_background.nut
    // context: legend_leech_peddler_background.create.m.Name
    {
        en = "Leech Peddler"
        es = "Vendedor de sanguijuelas"
    }
    // context: legend_leech_peddler_background.create.m.BackgroundDescription
    {
        en = "Leech peddlers are of questionable mindset at the best of times, but their unusual remedies often help those who cannot afford a real healer."
        es = "Los vendedores de sanguijuelas tienen una mentalidad dudosa incluso en sus mejores momentos, pero sus insólitos remedios suelen ayudar a quienes no pueden pagarse un sanador de verdad."
    }
    // context: legend_leech_peddler_background.create.m.GoodEnding
    {
        en = "%name% continued their bizaare adventure after you left %companyname%, soon after they made their way back to the swamps in search of new 'pets'. They happened to bump into a {wildwoman | wildman} who was almost derranged as they were. They quickly formed a bond and it is said they adopted children and now leave peacefully in the swamp. However you suspect said children are really just more leeches."
        es = "%name% continuó con su estrafalaria aventura cuando dejaste %companyname%, y poco después volvió a los pantanos en busca de nuevas «mascotas». Allí se topó con {una salvaje | un salvaje} que tenía la cabeza casi tan perdida como la suya. Enseguida congeniaron y, según dicen, adoptaron hijos y ahora viven en paz en el pantano. Aunque sospechas que esos hijos no son más que otras sanguijuelas."
    }
    // context: legend_leech_peddler_background.create.m.BadEnding
    {
        en = "%name% went off to join another mercanry company in a large city somewhere. They travelled with what is said to be a witch hunter and a small boy. What became of %name% is unknown at that point - some say they were killed... or worse."
        es = "%name% se marchó para unirse a otra compañía de mercenarios en alguna gran ciudad. Según dicen, viajaba con un cazador de brujas y un niño pequeño. A partir de ahí, se desconoce qué fue de %name%: hay quien dice que encontró la muerte... o algo peor."
    }
    // context: legend_leech_peddler_background.create.m.Titles
    {
        en = "the Unhinged"
        es = "el Trastornado"
    }
    // context: legend_leech_peddler_background.create.m.Titles
    {
        en = "the Slimy"
        es = "el Baboso"
    }
    // context: legend_leech_peddler_background.create.m.Titles
    {
        en = "the Unsound"
        es = "el Desquiciado"
    }
    // context: legend_leech_peddler_background.create.m.Titles
    {
        en = "the Jarman"
        es = "el Tarrero"
    }
    // context: legend_leech_peddler_background.onBuildDescription
    {
        en = "{%name% is an odd sort - clearly unhinged enough to go hunting for bloodsucking worms but also to treat them as their own children. | If you look closely, %name% will stroke a small jar of leeches under their arm and 'play' with them - as if playing with an infant. | If you listen carefully, you can make out %name% pressing their lips to the glass jar of angry leeches and whispering to them about this and that. | No matter the weather, the leeches must be cared and accounted for. | %name% will frequently dive into pools of murky water for more leeches. The location or current situation they perform this in seems to have no impact on them. | If you look closely, you can make out that the leeches are scared of %name% and, under no circamstances, attempt to feed off them. Makes you wonder if they know something you don't... | Everyone needs a hobby, and %name% managed to make their dreams become reality - even if that means wading waist deep through cold, murky water. | In a time of war, healers are always needed. However the profession can be somewhat...muddy at times. Often requiring mercenaries to look for alternative methods for healing.} {%name% talks at length about how to catch and care for leeches, often three or four times a day. Everyone normally zones out during these times however, so what %name% says could well be gibberish. | %name% assures you they are of sound mind - often saying that they worked for nobles. However the fact that they are still wading through water looking for bloodsucking worms may say a lot about that venture. | %name% sometimes breaks into a weep - going into detail about how they once sold leeches and never forgave themselves for it. Someone normally has to hug them to stop the flow of tears and sobbing. | Their background is somewhat a mystery - they live as a hermit would but are educated like a scribe would be. Perhaps they were never always like this? | They offer you a fat leech, one of the largest you have ever seen. You shake your head sideways. Dejected they kiss the leech on where it's forehad would be before comitting it back to the jar. | %name% sometimes goes into depth about how they were once in love with a young man. However at the end of the story you still have doubts as if to this mystery lover is a man or leech. | The peddler assures you that all their leeches have names. They go to press their finger against the razor maw of each leech pushing angrily against their glass prison but you interject in time to say that won't be needed. Somehow they still seem happy. | %name% says that this job puts food on the table for their family. You eye the jar of leeches and ask where they live. But you think you already know what she means.} {It didn't take long for war and famine to find %name%'s village, but instead of being forced out they made a tidy sum offering 'leech based services' to the dying locals. They also refuse to say what became of all of them. | %name% is always happy to find a bountiful harvest - however you suspect they do not mean crops or other things normal people would mean by that. | %name% was captured by bandits a few nights ago. Where any other woman would've been beaten and killed, the bandits instead decided to let her go. Looking at the way she strokes that jar, you can see why. | %name% says she founded a cult just outside of %randomtown%, she askes you if you'd like to guess as to what they worshipped. But you suspect you know the answer already. | When asked as to why she would join a band of militia, %name% simply stares over your shoulder, occasioanlly breaking character to check her leeches are still okay. | %name% says they tried to be a merchant at one point in life, but it turns out everyone else is 'too uneducated' to apprecaite the value of leech companions.}"
        es = "{%name% es una mujer peculiar: lo bastante trastornada como para salir a cazar gusanos chupasangre, pero también para tratarlos como a sus propios hijos. | Si te fijas bien, verás a %name% acariciar un tarrito de sanguijuelas que lleva bajo el brazo y «jugar» con ellas, como quien juega con un bebé. | Si escuchas con atención, alcanzas a oír a %name% pegar los labios al tarro de cristal lleno de sanguijuelas furiosas y susurrarles sobre esto y aquello. | Haga el tiempo que haga, hay que cuidar de las sanguijuelas y tenerlas todas contadas. | %name% se zambulle a menudo en charcas de agua turbia en busca de más sanguijuelas. El lugar o la situación en que lo haga no parecen importarle lo más mínimo. | Si te fijas bien, notarás que las sanguijuelas temen a %name% y que no intentan alimentarse de ella bajo ninguna circunstancia. Te hace pensar que saben algo que tú no... | Todo el mundo necesita una afición, y %name% logró hacer realidad sus sueños, aunque eso suponga meterse hasta la cintura en aguas frías y turbias. | En tiempos de guerra siempre hacen falta sanadores. Sin embargo, la profesión puede ser algo... fangosa a veces, y a menudo obliga a los mercenarios a buscar métodos alternativos de curación.} {%name% habla largo y tendido sobre cómo atrapar y cuidar sanguijuelas, a menudo tres o cuatro veces al día. Pero en esos momentos todos suelen desconectar, así que lo que dice %name% bien podrían ser sandeces. | %name% te asegura que está en su sano juicio, y a menudo dice que trabajó para nobles. Sin embargo, que siga vadeando aguas en busca de gusanos chupasangre quizá diga mucho de cómo le fue en aquella empresa. | A veces %name% rompe a llorar y cuenta con todo detalle cómo una vez vendió sanguijuelas y nunca se lo perdonó. Normalmente alguien tiene que abrazarla para que deje de llorar y sollozar. | Su pasado es todo un misterio: vive como una ermitaña, pero tiene la educación de una escriba. ¿Quizá no siempre fue así? | Te ofrece una sanguijuela gorda, una de las más grandes que has visto nunca. Niegas con la cabeza. Abatida, besa la sanguijuela en lo que sería su frente antes de devolverla al tarro. | A veces %name% se explaya contando que una vez estuvo enamorada de un joven. Pero al final de la historia aún te queda la duda de si ese amor misterioso era una persona o una sanguijuela. | La vendedora te asegura que todas sus sanguijuelas tienen nombre. Se dispone a apretar el dedo contra las fauces afiladas de cada una, que empujan furiosas contra su prisión de cristal, pero intervienes a tiempo para decirle que no hará falta. Aun así, de algún modo parece contenta. | %name% dice que este trabajo le permite llevar comida a la mesa de su familia. Miras el tarro de sanguijuelas y le preguntas dónde viven. Pero crees que ya sabes a qué se refiere.} {La guerra y el hambre no tardaron en llegar a la aldea de %name%, pero en vez de verse obligada a marcharse, sacó una buena suma ofreciendo «servicios a base de sanguijuelas» a los lugareños moribundos. Eso sí, se niega a contar qué fue de todos ellos. | A %name% siempre le alegra encontrar una cosecha abundante, aunque sospechas que no se refiere a cultivos ni a nada de lo que entendería por eso la gente normal. | Unos bandidos capturaron a %name% hace unas noches. Donde a cualquier otra mujer la habrían apaleado y matado, los bandidos decidieron dejarla marchar. Viendo cómo acaricia ese tarro, entiendes por qué. | %name% dice que fundó una secta a las afueras de %randomtown% y te pregunta si quieres adivinar a qué rendían culto. Pero sospechas que ya sabes la respuesta. | Cuando le preguntas por qué se uniría a una banda de milicianos, %name% se limita a mirar por encima de tu hombro, y solo sale de su ensimismamiento de vez en cuando para comprobar que sus sanguijuelas siguen bien. | %name% cuenta que una vez intentó ser mercader, pero resulta que todos los demás son «demasiado incultos» para apreciar el valor de tener sanguijuelas por compañía.}"
    }
    // context: legend_leech_peddler_background.onBuildDescription
    {
        en = "{%name% is an odd sort - clearly unhinged enough to go hunting for bloodsucking worms but also to treat them as their own children. | If you look closely, %name% will stroke a small jar of leeches under their arm and 'play' with them - as if playing with an infant. | If you listen carefully, you can make out %name% pressing their lips to the glass jar of angry leeches and whispering to them about this and that. | No matter the weather, the leeches must be cared and accounted for. | %name% will frequently dive into pools of murky water for more leeches. The location or current situation they perform this in seems to have no impact on them. | If you look closely, you can make out that the leeches are scared of %name% and, under no circamstances, attempt to feed off them. Makes you wonder if they know something you don't... | Everyone needs a hobby, and %name% managed to make their dreams become reality - even if that means wading waist deep through cold, murky water. | In a time of war, healers are always needed. However the profession can be somewhat...muddy at times. Often requiring mercenaries to look for alternative methods for healing.} {%name% talks at length about how to catch and care for leeches, often three or four times a day. Everyone normally zones out during these times however, so what %name% says could well be gibberish. | %name% assures you they are of sound mind - often saying that they worked for nobles. However the fact that they are still wading through water looking for bloodsucking worms may say a lot about that venture. | %name% sometimes breaks into a weep - going into detail about how they once sold leeches and never forgave themselves for it. Someone normally has to hug them to stop the flow of tears and sobbing. | Their background is somewhat a mystery - they live as a hermit would but are educated like a scribe would be. Perhaps they were never always like this? | They offer you a fat leech, one of the largest you have ever seen. You shake your head sideways. Dejected they kiss the leech on where it's forehad would be before comitting it back to the jar. | %name% sometimes goes into depth about how they were once in love with a young woman. However at the end of the story you still have doubts as if to this mystery lover is a man or leech. | The peddler assures you that all their leeches have names. They go to press their finger against the razor maw of each leech pushing angrily against their glass prison but you interject in time to say that won't be needed. Somehow they still seem happy. | %name% says that this job puts food on the table for their family. You eye the jar of leeches and ask where they live. But you think you already know what he means.} {It didn't take long for war and famine to find %name%'s village, but instead of being forced out they made a tidy sum offering 'leech based services' to the dying locals. They also refuse to say what became of all of them. | %name% is always happy to find a bountiful harvest - however you suspect they do not mean crops or other things normal people would mean by that. | %name% was captured by bandits a few nights ago. Where any other man would've been beaten and killed, the bandits instead decided to let him go. Looking at the way he strokes that jar, you can see why. | %name% says he founded a cult just outside of %randomtown%, he askes you if you'd like to guess as to what they worshipped. But you suspect you know the answer already. | When asked as to why he would join a band of militia, %name% simply stares over your shoulder, occasioanlly breaking character to check his leeches are still okay. | %name% says they tried to be a merchant at one point in life, but it turns out everyone else is 'too uneducated' to apprecaite the value of leech companions.}"
        es = "{%name% es un hombre peculiar: lo bastante trastornado como para salir a cazar gusanos chupasangre, pero también para tratarlos como a sus propios hijos. | Si te fijas bien, verás a %name% acariciar un tarrito de sanguijuelas que lleva bajo el brazo y «jugar» con ellas, como quien juega con un bebé. | Si escuchas con atención, alcanzas a oír a %name% pegar los labios al tarro de cristal lleno de sanguijuelas furiosas y susurrarles sobre esto y aquello. | Haga el tiempo que haga, hay que cuidar de las sanguijuelas y tenerlas todas contadas. | %name% se zambulle a menudo en charcas de agua turbia en busca de más sanguijuelas. El lugar o la situación en que lo haga no parecen importarle lo más mínimo. | Si te fijas bien, notarás que las sanguijuelas temen a %name% y que no intentan alimentarse de él bajo ninguna circunstancia. Te hace pensar que saben algo que tú no... | Todo el mundo necesita una afición, y %name% logró hacer realidad sus sueños, aunque eso suponga meterse hasta la cintura en aguas frías y turbias. | En tiempos de guerra siempre hacen falta sanadores. Sin embargo, la profesión puede ser algo... fangosa a veces, y a menudo obliga a los mercenarios a buscar métodos alternativos de curación.} {%name% habla largo y tendido sobre cómo atrapar y cuidar sanguijuelas, a menudo tres o cuatro veces al día. Pero en esos momentos todos suelen desconectar, así que lo que dice %name% bien podrían ser sandeces. | %name% te asegura que está en su sano juicio, y a menudo dice que trabajó para nobles. Sin embargo, que siga vadeando aguas en busca de gusanos chupasangre quizá diga mucho de cómo le fue en aquella empresa. | A veces %name% rompe a llorar y cuenta con todo detalle cómo una vez vendió sanguijuelas y nunca se lo perdonó. Normalmente alguien tiene que abrazarlo para que deje de llorar y sollozar. | Su pasado es todo un misterio: vive como un ermitaño, pero tiene la educación de un escriba. ¿Quizá no siempre fue así? | Te ofrece una sanguijuela gorda, una de las más grandes que has visto nunca. Niegas con la cabeza. Abatido, besa la sanguijuela en lo que sería su frente antes de devolverla al tarro. | A veces %name% se explaya contando que una vez estuvo enamorado de una joven. Pero al final de la historia aún te queda la duda de si ese amor misterioso era una persona o una sanguijuela. | El vendedor te asegura que todas sus sanguijuelas tienen nombre. Se dispone a apretar el dedo contra las fauces afiladas de cada una, que empujan furiosas contra su prisión de cristal, pero intervienes a tiempo para decirle que no hará falta. Aun así, de algún modo parece contento. | %name% dice que este trabajo le permite llevar comida a la mesa de su familia. Miras el tarro de sanguijuelas y le preguntas dónde viven. Pero crees que ya sabes a qué se refiere.} {La guerra y el hambre no tardaron en llegar a la aldea de %name%, pero en vez de verse obligado a marcharse, sacó una buena suma ofreciendo «servicios a base de sanguijuelas» a los lugareños moribundos. Eso sí, se niega a contar qué fue de todos ellos. | A %name% siempre le alegra encontrar una cosecha abundante, aunque sospechas que no se refiere a cultivos ni a nada de lo que entendería por eso la gente normal. | Unos bandidos capturaron a %name% hace unas noches. Donde a cualquier otro hombre lo habrían apaleado y matado, los bandidos decidieron dejarlo marchar. Viendo cómo acaricia ese tarro, entiendes por qué. | %name% dice que fundó una secta a las afueras de %randomtown% y te pregunta si quieres adivinar a qué rendían culto. Pero sospechas que ya sabes la respuesta. | Cuando le preguntas por qué se uniría a una banda de milicianos, %name% se limita a mirar por encima de tu hombro, y solo sale de su ensimismamiento de vez en cuando para comprobar que sus sanguijuelas siguen bien. | %name% cuenta que una vez intentó ser mercader, pero resulta que todos los demás son «demasiado incultos» para apreciar el valor de tener sanguijuelas por compañía.}"
    }
    // FILE: scripts\skills\backgrounds\legend_legion_auxiliary_background.nut
    // context: legend_legion_auxiliary_background.create.m.Name
    {
        en = "Auxiliary"
        es = "Auxiliar"
    }
    // context: legend_legion_auxiliary_background.create.m.BackgroundDescription
    {
        en = "Pressed onto service by some means or another, the Auxiliary serves their masters in exchange of a promise for a better life."
        es = "Forzados a prestar servicio de un modo u otro, los Auxiliares sirven a sus amos a cambio de la promesa de una vida mejor."
    }
    // context: legend_legion_auxiliary_background.onBuildDescription
    {
        en = "{Having been recruited by the Legion after falling to a plague, %name% believed their fighting days were soundly finished. Now, new battles await, and this call to violence cannot be refused. | %name% is no stranger to battle considering the myriad cuts, crushes, and fractures that dot their husked frame. While death may grant reprieve for some, in the Legion, it merely ensures your everlasting service. | Death in battle is no excuse to rest, and %name% knows this all too well. Being pressed into the Legion's auxiliary ranks, a violent destruction is all but assured unless their knowledge of wars past guides them through another day. | Brought in under the illusion of imperial citizenship and the promise of steady work, %name% know finds themselves an agent of the Legion's restless war machine, the completion of their service always one more campaign away | Dragged from their restful death, %name% fills the unenviable role of a front line skirmisher in the resurgent legion. Now a new lifetime of war and carnage await, with them tossed into the maelstrom at the Emperor's command.} {Skilled in various forms of combat, this auxiliary is pressed to bolster the legion's ranks through skirmishes and mixed support. Whether they 'survive' to fight another day is frankly optional. | Primed to fill gaps in the frontlines, the role of an auxiliary is often short-lived and underappreciated, if they make it out intact, a new battle is always on the horizon. | Scouting, mapping, trapping, and killing- the work of an imperial auxiliary is one of constant peril and exertion. Should one survive an ordeal, a fresh danger always lingers behind every tree and over every hill, for the empire's enemies are plentiful and relentless. | Often sent in waves of bone and bronze to buy opportunities for more valuable troops, auxiliaries can depend on receiving the most dangerous orders, with little interest as to their success or destruction. If they kill a foe or two, even better, if not, there are always more bodies. | The first to fight and often to fall, auxiliaries are routinely used to probe enemy formations to find weaknesses for more important soldiers, often boasting strong skirmishing skills. While some find success on the frontlines, most are expected to soften the enemy before their inevitable destruction.} {Though they have heard little of this legion or the emperor it serves, %name% now serves through a confused mix of fear and admiration for their work, and hopes to carve out a better status within it. The horrors of their doomed station have not yet dawned on them, or perhaps they are simply wilfully blind to them. | Seemingly undisturbed by their station or the perils it entails, %name% wields a drive and thoroughness that would undoubtedly secure advancement anywhere else in the legion. At the front however, they might be lucky to last half a campaign... | If %name% still had flesh to plaster their cracked skull, it would undoubtedly paint a face of terror for all to see. The prospect of death in battle or at the hands of disappointed superiors disturbs this auxiliary on the regular, driving them to more reckless fights in hopes of escaping this cycle of horror. | An ardent believer in the empire and legion's mission, %auxiliary% hopes that their brief stint in the auxiliary troop will ensure their recognition and swift promotion to a station that befits their loyalty. Whether they make it that far remains to be seen... | Nervous and ever paranoid that they are being judged by their peers, %auxiliary% makes up for a lifetime of indecision through reckless abandon for their new unlife, seeking to prove themself and make the best of their peculiar new position within the legion.}"
        es = "{Cuando la Legión reclutó a %name%, tras sucumbir a una plaga, creía que sus días de lucha habían acabado para siempre. Ahora le esperan nuevas batallas, y esta llamada a la violencia no admite negativa. | La batalla no le es ajena a %name%, a juzgar por los innumerables cortes, aplastamientos y fracturas que salpican su cuerpo marchito. Puede que para algunos la muerte sea un respiro, pero en la Legión solo garantiza que sirvas para siempre. | Morir en batalla no es excusa para descansar, y %name% lo sabe de sobra. Ahora que forma parte de las filas auxiliares de la Legión, su destrucción violenta está casi asegurada, a menos que su conocimiento de guerras pasadas le permita sobrevivir un día más. | Con la ilusión de la ciudadanía imperial y la promesa de un trabajo estable como cebo, %name% es ahora una pieza más de la incansable maquinaria de guerra de la Legión, con el final de su servicio siempre a una campaña de distancia | Le arrebataron su apacible muerte, y ahora %name% cumple el poco envidiable papel de hostigar en primera línea para la resurgida Legión. Le aguarda toda una nueva vida de guerra y matanza, y entrará en la vorágine en cuanto lo ordene el Emperador.} {Gracias a su destreza en diversas formas de combate, le toca reforzar las filas de la Legión con escaramuzas y apoyo de todo tipo. Que «sobreviva» para luchar otro día es, francamente, opcional. | Pensado para cubrir huecos en primera línea, el papel de un auxiliar suele ser breve y poco valorado; y si se sale de una pieza, siempre hay una nueva batalla en el horizonte. | Explorar, cartografiar, tender trampas y matar: el trabajo de un auxiliar imperial es de peligro y esfuerzo constantes. Si se sobrevive a una prueba, siempre acecha un nuevo peligro tras cada árbol y sobre cada colina, pues los enemigos del Imperio son numerosos e implacables. | Enviados a menudo en oleadas de hueso y bronce para abrir oportunidades a tropas más valiosas, los auxiliares pueden contar con recibir las órdenes más peligrosas, sin que a nadie le importe mucho si triunfan o perecen. Si matan a un enemigo o dos, mejor; si no, siempre hay más cuerpos. | Los primeros en luchar y a menudo en caer, los auxiliares se usan de forma rutinaria para tantear las formaciones enemigas y encontrar puntos débiles para soldados más importantes, y suelen destacar en las escaramuzas. Aunque algunos triunfan en primera línea, de la mayoría se espera que debiliten al enemigo antes de su inevitable destrucción.} {Aunque sabe poco de esta Legión o del Emperador al que sirve, %name% sirve ahora en ella con una confusa mezcla de miedo y admiración por su labor, y espera labrarse una posición mejor dentro de sus filas. Los horrores de su destino condenado aún no se le han revelado, o quizá simplemente se niega a verlos. | Sin que parezcan inquietarle su puesto ni los peligros que conlleva, %name% muestra un empuje y una minuciosidad que sin duda le asegurarían el ascenso en cualquier otro lugar de la Legión. En el frente, en cambio, tendrá suerte si dura media campaña... | Si a %name% aún le quedara carne para cubrir su cráneo agrietado, sin duda mostraría a todos un rostro de terror. La perspectiva de morir en batalla o a manos de superiores decepcionados no deja de inquietarle, así que se lanza a combates cada vez más temerarios con la esperanza de escapar de este ciclo de horror. | Ferviente creyente en la misión del Imperio y de la Legión, %auxiliary% espera que su breve paso por la tropa auxiliar le asegure reconocimiento y un rápido ascenso a un puesto a la altura de su lealtad. Está por ver si llega tan lejos... | Con los nervios a flor de piel y la paranoia constante de ser objeto del juicio de sus compañeros, %auxiliary% compensa toda una vida de indecisión entregándose con temeridad a su nueva no-vida, con afán de demostrar su valía y sacar el máximo partido a su peculiar nueva posición en la Legión.}"
    }
    // FILE: scripts\skills\backgrounds\legend_legion_centurion_background.nut
    // context: legend_legion_centurion_background.create.m.Name
    {
        en = "Centurion"
        es = "Centurión"
    }
    // context: legend_legion_centurion_background.create.m.BackgroundDescription
    {
        en = "A leader of many, a slave to a few."
        es = "Líder de muchos, esclavo de unos pocos."
    }
    // context: legend_legion_centurion_background.onBuildDescription
    {
        en = "{%name% had once given a lifetime of service to the Empire. In this new life, and new Legion, they pledge their undying loyalty to the Emperor as one of the finest military leaders of their time. | Hailing from the finest noble stock, %name% rose through the Legion's leadership and achieved senior command. Back from beyond, the mission has changed, but their zeal to serve persists. | Few would suspect %name%'s humble roots given their status as one of the finest commanders in the Empire. What life they had before however is long gone, and now, only the Legion remains. | Few would suspect %name%'s humble roots given their status as one of the finest commanders in the Empire. What life they had before however is long gone, and now, only the Legion remains. | Death could not stop %name%. As one of the Empire's most decorated commanders, in ages past their reputation would precede them. Now, they seek to restore their fearsome title as both a leader and killer of men. | To plan, execute, adapt, and triumph in the face of great adversity is %name%'s speciality. Having whet their teeth against some of the Empire's toughest foes, they answer the call for one final mission.} {Even in undeath, %name% wears numerous scars down to the bone. | %name% wears their armour as if it were a second skin. | %name% has an aura of authority about them. | %name% has a commanding presence, even when not on the battlefield. | %name% has witnessed many battles with the scars to prove it.} {Leading from the front, this centurion stands as an inspiring beacon to the Legion, and a terrible demon to its foes. Leading groups of soldiers in extended combats, they can be trusted to fight to the end, and beyond. | Centurions are responsible for commanding troops in battle. Seasoned, grizzled, and beyond loyal, they represent the best of the Empire's fighting troops. Death has little chance of stopping them. | The life of a centurion is one of mixed administration and combat leadership. From directing work around camp, to launching a raid on the enemy's, a centurion's work is dynamic and vital to the Legion's success. | Few men have the mettle for what being a Legion centurion entails. An artist on the battlefield, they paint with troop movements and battle tactics, creating masterpieces of imperial ingenuity, signed with a swathe of enemy dead. | Soldiers need orders. The centurion provides direction and determination to the ranks, leading battles and facing the enemy head-on. | They keep a keen view on who exists and enters camp, even in death where spies would be obvious, they still act as if any newcomer could be an infiltrator. | They always keep several legionaries perpetually building fortifications. Many of which are pointless given the situation — from latrines to irrigation wells.} {They are always pacing around camp, ordering legionaries in charge of logistics to buy more grain. The legonaries pile the grain in the tent, but none touch it thereafter. | Upbeat even in spite of their skeletal form, %name% clearly relishes the opportunity to lead their troops once more. When moods sour and times get tough, they're the first to rally the men into a beaming fervour. | One can tell that %name% worked their way through the Legion's ranks, even if a lifetime ago. They aren't afraid to help with the donkey's work around camp or reminisce with old brothers in arms, sharing tales of their lives and deaths. | A mean streak to boot, and a taste for order that would give the Emperor pause, %name% manifests the rugged discipline of the Legion's finest. They strive for absolute excellence, and expect nothing less from their men. | %name%'s death was a mercy for both their men and the enemy. %name%'s cruel genius exacted a heavy toll from all who dared to stand against them. Now, with a new life and mission, all will find death's mercy was but a temporary reprieve. | Fear is as alien a concept to %name% as defeat is. Their unsettlingly calm demeanour against seemingly insurmountable odds betrays them as one of the Legion's most dauntless leaders.}"
        es = "{%name% ya dio una vida entera de servicio al Imperio. En esta nueva vida, y en esta nueva Legión, jura lealtad inmortal al Emperador como una de las mejores mentes militares de su tiempo. | Procedente del mejor linaje noble, %name% ascendió en la cúpula de la Legión hasta alcanzar el alto mando. De vuelta del más allá, la misión ha cambiado, pero su celo por servir perdura. | Pocos sospecharían los humildes orígenes de %name%, dada su posición entre los mejores comandantes del Imperio. Pero la vida que tuvo antes quedó atrás hace mucho, y ahora solo queda la Legión. | Pocos sospecharían los humildes orígenes de %name%, dada su posición entre los mejores comandantes del Imperio. Pero la vida que tuvo antes quedó atrás hace mucho, y ahora solo queda la Legión. | La muerte no pudo detener a %name%. Por contarse entre los comandantes más condecorados del Imperio, en otros tiempos su fama le precedía. Ahora busca recuperar su temible reputación como líder y como azote de hombres. | Planificar, ejecutar, adaptarse y triunfar ante la mayor adversidad es la especialidad de %name%. Tras foguearse contra algunos de los enemigos más duros del Imperio, responde a la llamada para una última misión.} {Incluso en la no muerte, %name% luce numerosas cicatrices que llegan hasta el hueso. | %name% lleva la armadura como si fuera una segunda piel. | %name% desprende un aura de autoridad. | %name% tiene una presencia imponente, incluso fuera del campo de batalla. | %name% ha vivido muchas batallas, y tiene las cicatrices que lo demuestran.} {Al dirigir desde la vanguardia, los centuriones son un faro de inspiración para la Legión y un demonio terrible para sus enemigos. Al frente de grupos de soldados en combates prolongados, se puede confiar en que lucharán hasta el final, y más allá. | Los centuriones se encargan de dirigir a las tropas en batalla. Curtidos, aguerridos y de una lealtad a toda prueba, representan lo mejor de las tropas de combate del Imperio. La muerte tiene pocas posibilidades de detenerlos. | La vida de un centurión combina la administración con el mando en combate. Desde dirigir las tareas del campamento hasta lanzar una incursión contra el del enemigo, su trabajo es dinámico y vital para el éxito de la Legión. | Pocos hombres tienen el temple que exige ser centurión de la Legión. Son artistas del campo de batalla que pintan con movimientos de tropas y tácticas de combate, y crean obras maestras del ingenio imperial firmadas con un reguero de enemigos muertos. | Los soldados necesitan órdenes. Los centuriones dan rumbo y determinación a las filas, dirigen las batallas y se enfrentan cara a cara al enemigo. | Vigila con atención quién sale y entra del campamento; incluso en la muerte, cuando los espías saltarían a la vista, sigue actuando como si cualquier recién llegado pudiera ser un infiltrado. | Siempre tiene a varios legionarios construyendo fortificaciones sin descanso, muchas de ellas inútiles dada la situación, desde letrinas hasta pozos de riego.} {Siempre anda de un lado a otro del campamento, ordenando a los legionarios encargados de la logística que compren más grano. Los legionarios amontonan el grano en la tienda, pero nadie vuelve a tocarlo. | Con buen humor pese a su forma esquelética, %name% disfruta a todas luces de la ocasión de volver a dirigir a sus tropas. Cuando los ánimos se agrian y vienen tiempos duros, es quien antes enardece a los hombres con un fervor radiante. | Se nota que %name% ascendió en la Legión desde abajo, aunque fuera hace una vida entera. No le importa echar una mano con las faenas más pesadas del campamento ni rememorar viejos tiempos con antiguos hermanos de armas, compartiendo historias de sus vidas y sus muertes. | Con una vena despiadada por si fuera poco, y un gusto por el orden que haría titubear al propio Emperador, %name% encarna la férrea disciplina de lo mejor de la Legión. Aspira a la excelencia absoluta y no espera menos de sus hombres. | La muerte de %name% fue un acto de piedad tanto para sus hombres como para el enemigo. El cruel genio de %name% se cobró un alto precio entre todos los que se atrevieron a plantarle cara. Ahora, con una nueva vida y una nueva misión, todos descubrirán que la piedad de la muerte no fue más que un respiro pasajero. | El miedo es un concepto tan ajeno para %name% como la derrota. Su calma inquietante ante dificultades aparentemente insalvables revela que se cuenta entre los líderes más intrépidos de la Legión.}"
    }
    // FILE: scripts\skills\backgrounds\legend_legion_gladiator_background.nut
    // context: legend_legion_gladiator_background.create.m.BackgroundDescription
    {
        en = "A leader to few, a slave of many."
        es = "Líder de pocos, esclavo de muchos."
    }
    // context: legend_legion_gladiator_background.onBuildDescription
    {
        en = "{Although scarred and worn, %name% frequently stands out of place in the wider display of the legion. | After completing their contract at their gladiator school, %name% sought to apply their skills to the Legion. Eagerly accepted, they now seek to carve their name into the minds of their foes as well as fans. | Having been defeated in the arena, %name% believed their career to be over. After being found by the Legion however, a new opportunity for redemption and glory presents itself, one that will not be ignored. | %name% comes from one of the many imperial fighting pits, a slave-made-soldier in the blood sport industry. When the Legion came through, they saw the perfect opportunity to make a better name for themselves. | Killing can be made art in the right hands. %name% commanded the respect and admiration of much of the Empire at their zenith; now they serve the Legion, another faceless agent of carnage. | %name% led a once prestigious gladiator school, but time has since erased both from the world's memory. Now, they practice their trade of vicious combat in the rugged Legion, a far cry from days past. | The experience of fighting both man and beast has given %name% unique talents on the battlefield — preferring to trap their targets rather than forming shieldwalls or pike lines. | Despite the unusual methods of %name%, they fit well into the legion. | While different from the rest of the legion, %name% provides a skillset that many of the other legionaries could not hold a candle to.} {They prefer to wear a lighter set of armour, still dodging with uncanny speed despite their appearance. | Excelling at brutal and flashy bouts of violence, this gladiator is at home in the fighting pits. In the Legion, they will have to adapt their theatrical skills of arms if they hope to survive the harsher reality of real war. | Laying waste to beasts, slaves, and the condemned criminals of the empire, this gladiator boasts impressive martial skills, albeit with limited experience in larger scale combat. |  Better suited to dramatic and performative combat than rigid formation warfare, this gladiator promises a strong martial foundation, if they can adapt to life outside the pits. | Skilled in nets, lassos, whips, tridents, and other unconventional weapons of war, this gladiator presents a remarkable proficiency in adaptable combat. Whether they can transfer these skills to the Legion remains to be seen. | This imperial gladiator boasts intimate experience in slaying the myriad monsters of the world with ceremonial flair. Time will tell if their pit knowledge transfers well against human prey. | As the rest of the camp sharpens weapons, %they% fixes their nets for beasts and soldiers alike. | Often opting for unconventional weapons, %name% managed to fill a role within the legion that few can match, which is to say, working alone. | They have a habit of pacing around the camp's edge, watching for trespassers on two legs or more. | %name% has a supernatural amount in finesse about them, often outperforming their fellow fights in speed and precision.} {Years of training and hardship endure in what remains of them, even in death they are still little more than a slave. | On the whole, they are not far detached from the camp slaves or auxiliaries — often spending more time in quiet communion with them than the other groups. | Despite their clear strength, the years have taken a toll on them, showing confusion when claws of beasts do not draw blood, or jaws that would rip their skin merely clamp on their bones. | Boastful and loud, %name% practically demands attention at every moment. Perhaps forgetting their position in the Legion, they are quick to suffer reprimands from their superiors. | %name%'s hollow face shows a clear mourning for their old position in the fighting pits. When the order comes to fight, they put their old experience to use, perhaps remembering better days. | %name% spends much of their time in confused sparring matches against vanquished foes centuries past. Whether they believe themself still in the arena, or seeking a desperate attempt to relive old glories is uncertain. | Not all gladiators miss their old trade, and %name% seems to one of them. Eager to work with their new brothers in arms in collaboration instead of contest, they now fight and die for the Legion. | Perhaps lamenting the new chain of command they're beholden to, %name% appears crestfallen and underappreciated. While killing might be celebrated in the arena, in the Legion, it's just part of the job.}"
        es = "{Pese a sus cicatrices y su desgaste, %name% desentona a menudo en el conjunto de la Legión. | Tras cumplir su contrato en la escuela de gladiadores, %name% quiso poner su destreza al servicio de la Legión. Aceptad%o% con entusiasmo, ahora busca grabar su nombre en la mente de sus enemigos y también de sus admiradores. | Tras su derrota en la arena, %name% creía acabada su carrera. Pero cuando la Legión %lo% encontró, se le presentó una nueva oportunidad de redención y gloria, y no piensa desaprovecharla. | %name% procede de uno de los muchos fosos de combate imperiales: %un% esclav%o% convertid%o% en soldado del negocio de los deportes de sangre. Cuando la Legión pasó por allí, vio la ocasión perfecta para labrarse un nombre mejor. | En las manos adecuadas, matar puede convertirse en arte. En su apogeo, %name% se ganó el respeto y la admiración de buena parte del Imperio; ahora sirve a la Legión, una pieza anónima más de la carnicería. | %name% dirigió una escuela de gladiadores antaño prestigiosa, pero el tiempo ha borrado de la memoria del mundo tanto la escuela como a quien la dirigía. Ahora ejerce su despiadado oficio de combate en la curtida Legión, muy lejos de los días de antaño. | La experiencia de luchar tanto contra hombres como contra bestias le ha dado a %name% un talento único en el campo de batalla: prefiere atrapar a sus objetivos antes que formar muros de escudos o líneas de picas. | Pese a los métodos poco habituales de %name%, encaja bien en la Legión. | Aunque es distint%o% al resto de la Legión, %name% aporta unas habilidades que muchos de los otros legionarios ni de lejos podrían igualar.} {Prefiere llevar una armadura más ligera, y aun así esquiva con una rapidez asombrosa pese a su aspecto. | Con un don para los combates brutales y vistosos, %ese% combatiente se siente como en casa en los fosos de lucha. En la Legión tendrá que adaptar su teatral destreza con las armas si espera sobrevivir a la realidad más dura de la guerra de verdad. | Tras arrasar con bestias, esclavos y criminales condenados del Imperio, %ese% combatiente de la arena presume de una impresionante destreza marcial, aunque con poca experiencia en combates a mayor escala. | Más dotad%o% para el combate dramático y teatral que para la rígida guerra en formación, %ese% combatiente promete una sólida base marcial, si logra adaptarse a la vida fuera de los fosos. | Diestr%o% con redes, lazos, látigos, tridentes y otras armas de guerra poco convencionales, %ese% combatiente muestra una notable soltura en el combate versátil. Está por ver si sabrá trasladar estas habilidades a la Legión. | %Ese% combatiente imperial tiene una experiencia íntima en matar a los innumerables monstruos del mundo con un estilo ceremonioso. El tiempo dirá si lo que aprendió en los fosos sirve igual contra presas humanas. | Mientras el resto del campamento afila las armas, remienda sus redes para bestias y soldados por igual. | Con su afición por las armas poco convencionales, %name% ha logrado ocupar dentro de la Legión un papel que pocos pueden igualar: trabajar en solitario. | Tiene la costumbre de rondar el perímetro del campamento, atent%o% a intrusos de dos patas o más. | %name% tiene una delicadeza sobrenatural, y a menudo supera a sus compañeros de lucha en rapidez y precisión.} {Los años de entrenamiento y penurias perduran en lo que queda de %el%; incluso muert%o%, sigue siendo poco más que %un% esclav%o%. | En general, no se aleja mucho de los esclavos del campamento ni de los auxiliares, y a menudo pasa más tiempo en silenciosa comunión con ellos que con los demás grupos. | Pese a su evidente fuerza, los años le han pasado factura: se muestra confus%o% cuando las garras de las bestias no le hacen sangrar, o cuando unas fauces que deberían desgarrarle la piel se limitan a cerrarse sobre sus huesos. | Jactancios%o% y escandalos%o%, %name% exige atención prácticamente a cada momento. Quizá porque olvida su lugar en la Legión, no tarda en ganarse reprimendas de sus superiores. | El rostro hueco de %name% muestra un claro duelo por su antiguo puesto en los fosos de lucha. Cuando llega la orden de combatir, pone en práctica su vieja experiencia, quizá recordando tiempos mejores. | %name% pasa gran parte del tiempo en confusos combates de práctica contra enemigos vencidos hace siglos. No está claro si cree seguir en la arena o si es un intento desesperado de revivir viejas glorias. | No todos los gladiadores echan de menos su antiguo oficio, y %name% parece encontrarse entre ellos. Con ganas de colaborar con sus nuevos hermanos de armas en lugar de competir con ellos, ahora lucha y muere por la Legión. | Quizá porque lamenta la nueva cadena de mando a la que debe obediencia, %name% parece abatid%o% y poco valorad%o%. Puede que matar se celebre en la arena, pero en la Legión no es más que parte del trabajo.}"
    }
    // FILE: scripts\skills\backgrounds\legend_legion_honour_guard_background.nut
    // context: legend_legion_honour_guard_background.create.m.Name
    {
        en = "Honour Guard"
        es = "Guardia de honor"
    }
    // context: legend_legion_honour_guard_background.create.m.BackgroundDescription
    {
        en = "A veteran of hundreds of battles, the honour guard is rewarded for their prowess with ever increasing danger."
        es = "Con cientos de batallas a sus espaldas, quien sirve en la guardia de honor recibe como premio a su destreza peligros cada vez mayores."
    }
    // context: legend_legion_honour_guard_background.onBuildDescription
    {
        en = "{Decades of campaigning and violence have only cemented %name%'s reputation in the Legion as an avatar of war. Their very presence instils confidence in their troop's fighting odds. | Some %name% are born to grant others death. %name% answered this calling alongside his duty to the Emperor, and has carved a path through their many enemies, with little sign of stopping. | %name%'s war never ended. Found amongst a battlefield surrounded by felled foes, they were only too eager to take up arms again in service of the Emperor and his Legion. | %name% sought the Legion out on their own, having felt the call to serve the Emperor through honourable combat. Offered a prestigious position as one of the Legion's best, they stand as both shield and sword against the Empire's many enemies. | Few can compare to %name%'s martial prowess and imposing presence, even in death. Quickly proving their knack for violence, they secured a place in the Legion's honour guard.} {When the lines break, it inevitably falls to this honour guard to hold the line and salvage the day. Unmatched in close combat, they can be trusted to make any enemy pay in rivers of blood. | Perfectly suited to breaking enemy lines and reforming allied ones, this honour guard stands stalwart as a decisive actor on the battlefield. Enemies and allies alike fear their skill of arms. | When the day seems lost, it falls to an honour guard to turn the tide and achieve glory for the Empire. Masterfully applied violence and a feverish loyalty to the mission bolster the Legion's capabilities on and off the battlefield. | The perfect weapon in the Legion, this honour guard is the solution to throw at almost any problem that stands against the Emperor's will. Single-minded in violence, the Empire's enemies tremble at the very sight of this paragon of imperial martial excellence. | Violence made art. Killing made a science. This honour guard is no stranger to war, and can be relied upon to demonstrate the ancient mastery of imperial war to those in the Legion, and those who dare oppose it.} {Cold, reserved and unmistakably absent-minded in camp, %name%'s mind clearly lives on the battlefield. The lulls between battle seem only to send this agent of war into a placated stasis, awaiting the next call to action... | Death comes easy for some. %name% appears aware of their undeath, occasionally spotted admiring their skeletal form. Despite what some might consider horrific, they relish the opportunity to relive the art of killing. Again, and again, and again. | %name% relishes their new undead station in the Legion, eagerly flexing their status against their inferiors, and often failing to hide their glee for their curse of unlife. At least someone is having fun in death. | Bouts of confused stupors quickly give way to an unquestionable discipline practised and perfected over countless years. Though %name% is sometimes spotted pensive and disturbed by their undead company, the order to form ranks quickly sweeps such self-awareness away... | %name% lived and died and now lives again for the Legion. Eagerly taking up the opportunity to serve the Emperor once more, they vow never to never again fall in battle.}"
        es = "{Décadas de campañas y violencia no han hecho más que cimentar la fama de %name% en la Legión como encarnación de la guerra. Su sola presencia hace que la tropa confíe en sus posibilidades en combate. | Hay quienes, como %name%, nacen para dar muerte a otros. %name% respondió a esa llamada además de a su deber con el Emperador, y se ha abierto paso entre sus muchos enemigos sin visos de detenerse. | La guerra de %name% nunca terminó. Apareció en medio de un campo de batalla, entre enemigos abatidos, y no se hizo de rogar para volver a empuñar las armas al servicio del Emperador y de su Legión. | %name% buscó a la Legión por voluntad propia, tras sentir la llamada de servir al Emperador mediante el combate honorable. Ahora, con un puesto de prestigio entre los mejores de la Legión, es a la vez escudo y espada frente a los muchos enemigos del Imperio. | Pocos pueden compararse con la destreza marcial y la imponente presencia de %name%, incluso en la muerte. Tras demostrar enseguida su talento para la violencia, se ganó un puesto en la guardia de honor de la Legión.} {Cuando las líneas se rompen, inevitablemente le toca a este miembro de la guardia de honor sostener la línea y salvar la jornada. Sin rival en el cuerpo a cuerpo, se puede confiar en que hará pagar a cualquier enemigo con ríos de sangre. | Ideal para romper las líneas enemigas y recomponer las propias, este miembro de la guardia de honor se mantiene firme como pieza decisiva en el campo de batalla. Enemigos y aliados por igual temen su destreza con las armas. | Cuando la jornada parece perdida, le toca a la guardia de honor cambiar las tornas y conseguir la gloria para el Imperio. Una violencia aplicada con maestría y una lealtad febril a la misión refuerzan las capacidades de la Legión dentro y fuera del campo de batalla. | Arma perfecta de la Legión, este miembro de la guardia de honor es la solución que lanzar contra casi cualquier problema que se interponga a la voluntad del Emperador. Con la violencia como única meta, es un dechado de la excelencia marcial imperial cuya sola visión hace temblar a los enemigos del Imperio. | La violencia hecha arte. La matanza hecha ciencia. La guerra no le es ajena a este miembro de la guardia de honor, y se puede contar con que demostrará la antigua maestría de la guerra imperial a los de la Legión y a quienes se atrevan a oponerse a ella.} {Frialdad, reserva y una distracción inconfundible: así se muestra %name% en el campamento, porque su mente vive a todas luces en el campo de batalla. Las treguas entre batallas no hacen más que sumir a este instrumento de la guerra en un letargo apacible, a la espera de la siguiente llamada a la acción... | Para algunos, la muerte llega fácil. %name% parece consciente de su no muerte, y a veces se le ve admirando su forma esquelética. Pese a lo que algunos considerarían horrible, disfruta de la oportunidad de revivir el arte de matar. Una y otra y otra vez. | %name% disfruta de su nueva posición de ultratumba en la Legión, presume con ganas de su rango ante sus inferiores y a menudo no logra ocultar el regocijo que le provoca su maldición de no vida. Al menos alguien se divierte en la muerte. | Los episodios de estupor y confusión dan paso enseguida a una disciplina incuestionable, practicada y perfeccionada durante incontables años. Aunque a veces se nota en %name% una inquietud pensativa ante sus compañeros no muertos, la orden de formar filas barre enseguida esa conciencia de sí... | %name% vivió y murió, y ahora vive de nuevo para la Legión. Tras aprovechar con ganas la oportunidad de servir otra vez al Emperador, jura no volver a caer jamás en batalla.}"
    }
    // FILE: scripts\skills\backgrounds\legend_legion_legate_background.nut
    // context: legend_legion_legate_background.create.m.Name
    {
        en = "Legate"
        es = "Legado"
    }
    // context: legend_legion_legate_background.create.m.BackgroundDescription
    {
        en = "A military figure of great experience and prowess"
        es = "Una figura militar de gran experiencia y destreza"
    }
    // context: legend_legion_legate_background.getTooltip.ret.push().text
    {
        en = "Can directly command a single unit that is not another Legate"
        es = "Puede dar órdenes directas a una sola unidad que no sea otro Legado"
    }
    // context: legend_legion_legate_background.onBuildDescription
    {
        en = "{ TODO | TODO }"
        es = "{ PENDIENTE | PENDIENTE }"
    }
    // FILE: scripts\skills\backgrounds\legend_legion_legionary_background.nut
    // context: legend_legion_legionary_background.create.m.Name
    {
        en = "Legionary"
        es = "Legionario"
    }
    // context: legend_legion_legionary_background.create.m.BackgroundDescription
    {
        en = "The backbone of the Empire, the Legionary has seen horrors far and wide — and now travels those lands as one."
        es = "Columna vertebral del Imperio, el Legionario ha visto horrores por todas partes, y ahora recorre esas tierras siendo uno de ellos."
    }
    // context: legend_legion_legionary_background.onBuildDescription
    {
        en = "{Hailing from a long line of soldiers, %name% joined the Legion eager to serve the Emperor through force of arms. | With few prospects in civilian life, %name% turned to a career in the military as a rank and file soldier. After falling into the Legion, they have dedicated their new life to perfecting their martial skills in hopes of one day finding peace. | Having signed a short military contract to pay off debts, %name% found their service extended indefinitely upon being drafted into the Legion. While they still hope to one day complete their contract, for now- duty calls. | With a choice between punishment in a penal colony, or a shorter sentence in the Legion, %name% figured the latter would be safer and better for their personal growth. Wrong on both counts and bound by eternal service, the Legion is the only place they have left. | Found amongst an old battlefield by the Legion, %name% was all too eager to link up with their new unit upon hearing their mission. With new companions and a purpose renewed, they promise a strong presence in the ranks.} {Confidently filling the ranks of the fighting Legion, this legionary is well versed in formation fighting and sustained combat- through years of training, they're well equipped to deliver death to the Emperor's foes. | Killing men is this legionary's speciality, able to maintain pike ranks with relentless discipline and lead charges in shield formation. With men needing killing more than ever, the front might just be this legionary's best chance at it. | Between battles, the endless apparatus of the Legion is maintained by its many skilled troops. This legionary in particular assists in the logistics and camp works before whetting their blade on the Emperor's foes. | When orders are given, you need strong and devoted men to obey them. This legionary follows the call of duty without question, and is invaluable in any formation, whether protecting their comrades or slaying the enemy.} {Stoic and reserved, %name% dedicates what's left of their humanity to quiet reflection, and is often seen reflecting on the minutia of their daily observations. Whether they're still lucid enough to understand or appreciate them is another matter. | %name% brings a loud and haughty personality to the ranks that betrays a deep satisfaction in their station. While simple to some, they enjoy the honest routine that comes from their position. | Thriving on a diet of violence and honourable service, %name% relishes each encounter with the enemy as a fresh opportunity to see their foes vanquished and the Empire's glory bolstered. | %name% avoids their fellow soldiers when they can, muttering nonsense about the dead not staying dead. While peculiar at times, they remain a strong and loyal soldier to the Emperor. | Between the cynical mockery of their station and cheek often bordering on insubordinate, %name% is as devoted to the Emperor as they come, and is ready to lay down their life for their mission when the time comes.}"
        es = "{Descendiente de un largo linaje de soldados, %name% se unió a la Legión con ganas de servir al Emperador por la fuerza de las armas. | Con pocas perspectivas en la vida civil, %name% se dedicó a la carrera militar como soldado de a pie. Desde que acabó en la Legión, ha consagrado su nueva vida a perfeccionar sus habilidades marciales con la esperanza de encontrar algún día la paz. | Tras firmar un breve contrato militar para saldar sus deudas, %name% vio cómo su servicio se prolongaba sin fecha de fin al pasar a las filas de la Legión. Aunque aún espera cumplir algún día su contrato, por ahora, el deber llama. | Ante la elección entre cumplir condena en una colonia penal o una sentencia más corta en la Legión, %name% pensó que lo segundo sería más seguro y mejor para su crecimiento personal. Se equivocó en las dos cosas y ahora, con un servicio eterno por delante, la Legión es el único lugar que le queda. | Cuando la Legión dio con %name% en un antiguo campo de batalla, no se hizo de rogar para unirse a su nueva unidad en cuanto supo cuál era su misión. Con nuevos compañeros y un propósito renovado, promete ser una presencia sólida en las filas.} {Ocupa con aplomo su puesto en las filas de la Legión combatiente y domina la lucha en formación y el combate prolongado; tras años de entrenamiento, tiene todo lo necesario para llevar la muerte a los enemigos del Emperador. | Matar hombres es su especialidad: sabe mantener las filas de picas con una disciplina implacable y encabezar cargas en formación de escudos. Ahora que hay más hombres que matar que nunca, puede que el frente sea su mejor oportunidad para hacerlo. | Entre batalla y batalla, el interminable aparato de la Legión se mantiene gracias a sus muchas tropas hábiles. En su caso, colabora en la logística y las obras del campamento antes de afilar su hoja en los enemigos del Emperador. | Cuando se dan órdenes, hacen falta hombres fuertes y entregados que las cumplan. Sigue la llamada del deber sin rechistar y resulta inestimable en cualquier formación, ya sea protegiendo a sus camaradas o matando al enemigo.} {Con estoicismo y reserva, %name% dedica lo que le queda de humanidad a la reflexión silenciosa, y a menudo se le ve cavilando sobre las minucias de lo que observa a diario. Otra cosa es que aún conserve la lucidez suficiente para entenderlas o apreciarlas. | %name% aporta a las filas una personalidad ruidosa y altiva que delata una profunda satisfacción con su puesto. Aunque para algunos sea poca cosa, disfruta de la honrada rutina que conlleva su posición. | %name% prospera a base de violencia y servicio honorable, y saborea cada encuentro con el enemigo como una nueva oportunidad de ver a sus enemigos vencidos y la gloria del Imperio reforzada. | %name% evita a sus compañeros siempre que puede y masculla sinsentidos sobre muertos que no se quedan muertos. Aunque a veces tiene sus rarezas, sigue sirviendo al Emperador con fuerza y lealtad. | Pese a sus burlas cínicas sobre su puesto y un descaro que a menudo roza la insubordinación, nadie sirve al Emperador con más devoción que %name%, que cuando llegue el momento dará la vida por su misión.}"
    }
    // FILE: scripts\skills\backgrounds\legend_legion_prefect_background.nut
    // context: legend_legion_prefect_background.create.m.Name
    {
        en = "Prefect"
        es = "Prefecto"
    }
    // context: legend_legion_prefect_background.create.m.BackgroundDescription
    {
        en = "An official or administrator with some standing to someone who's name and title is unknown to you."
        es = "Alguien con cierto rango en la administración, al servicio de una persona cuyo nombre y título desconoces."
    }
    // context: legend_legion_prefect_background.onBuildDescription
    {
        en = "{Having completed their academic training quicker than their peers, %name% was fingered for a role in the Legion as one of its administrative clerks. Though the task is daunting, they eagerly accepted to serve the Empire on the battlefield of ink and paper. | Having served on various campaigns in the past, %name% was eager to rise from their grave to conduct the administrative duties of the resurgent Legion. Tome in hand, they swear their new life to the Emperor once more. | Few %people_name% truly excel at the art of shifting numbers. %name% handily stands out as unmatched in their discipline, taking their smarts from the imperial academy and applying it to a real cause. | The third child of a major royal house, %name% had earned their laurels serving in the Legion's administrative divisions centuries past, and rises once more to ensure none forget their name.} {Through a talented regime of both carrot and stick, this prefect understands the importance of motivation amongst the troops. %They_name% keep a bony finger on the pulse of the Legion, quelling dissent before it festers. | Others fight with sword and axe. This prefect favours the quill and inkwell. When poor coordination, logistics, morale, and vision pose a lethal threat to the Legion, this champion of ink rises to strike them down. | Managing numbers, collating reports, amassing intel, and possessing the disparate limbs of the Legion into one united amalgam, this prefect is a master of coordination and clerical planning. | Some prefects content themselves to a life strapped to a desk. This prefect however thrives right behind the battle lines, allocating tactical support and skilfully manoeuvring the Legion's many martial assets. | Although the Legion doesn't march on its stomach like in ages past, this prefect ensures that the men remain content, efficient, and honed to fight at a moments notice. Although often unseen, their work oils the ever-turning wheels of the Legion's war machine.} {%name% seemingly delights in their undeath. Whilst the peons waste time to eat and sleep, the lack of bodily upkeep allows this erudite scribe to endlessly log and detail the Legion's activities and many triumphs. | There is much to do, and %name% is rarely seen outside of the officer's tent, endlessly slaving away to maintain the Legion and its warriors. When others do see them, it's often with a look of scholarly smugness, and a fresh ream of paper under-arm. | In the rare moments of quiet, %name% appears to panic upon the fresh realisation of their undeath. Only through constant occupation of their fierce and brilliant mind can they quiet the horrors that surround them. | %name% isn't afraid to debase their station through eager interaction with their subordinates. While unorthodox, their methods allow enhanced observation of the Legion's morale and attitudes — a scroll rarely leaving their hand. | The scholarly and inquisitive %name% took quite nicely to their new form, eager to explore its implications and potential. When not balancing Legion books, they can be seen furiously scribbling in their own private tomes.}"
        es = "{Tras completar su formación académica antes que sus compañeros, a %name% le asignaron un puesto de escribiente administrativo en la Legión. Aunque la tarea intimida, aceptó con entusiasmo servir al Imperio en el campo de batalla de la tinta y el papel. | Tras servir en diversas campañas en el pasado, %name% se levantó de su tumba con ganas de desempeñar las tareas administrativas de la Legión resurgida. Tomo en mano, consagra una vez más su nueva vida al Emperador. | Pocas personas destacan de verdad en el arte de mover cifras. %name% sobresale sin esfuerzo como alguien sin rival en su disciplina, y lleva lo aprendido en la academia imperial a una causa real. | Tercer vástago de una gran casa real, %name% se ganó sus laureles sirviendo en las divisiones administrativas de la Legión hace siglos, y vuelve a alzarse para que nadie olvide su nombre.} {Con un hábil régimen de palo y zanahoria, demuestra entender la importancia de mantener motivada a la tropa. Toma el pulso de la Legión con un dedo huesudo y sofoca el descontento antes de que se encone. | Otros luchan con espada y hacha; sus armas predilectas son la pluma y el tintero. Cuando una mala coordinación, logística, moral o visión suponen una amenaza letal para la Legión, se alza para abatirlas a golpe de tinta. | Gestiona cifras, compila informes, reúne información y gobierna los miembros dispares de la Legión hasta fundirlos en una sola amalgama: domina como nadie la coordinación y la planificación administrativa. | Algunos prefectos se conforman con una vida atada al escritorio. No es su caso: se crece justo detrás de las líneas de batalla, asignando apoyo táctico y maniobrando con destreza los muchos recursos marciales de la Legión. | Aunque la Legión ya no marcha sobre su estómago como antaño, se encarga de que los hombres sigan contentos, eficaces y listos para luchar al menor aviso. Aunque su labor rara vez se ve, engrasa las ruedas siempre en marcha de la maquinaria de guerra de la Legión.} {Aparentemente, %name% disfruta de su no muerte. Mientras los peones pierden el tiempo comiendo y durmiendo, no tener un cuerpo que mantener le permite registrar y detallar sin descanso, con pluma de escriba erudit%o_name%, las actividades y los muchos triunfos de la Legión. | Hay mucho que hacer, y rara vez se ve a %name% fuera de la tienda de los oficiales, dejándose la piel sin descanso para mantener a la Legión y a sus guerreros. Cuando alguien se cruza con su figura, suele lucir un aire de suficiencia erudita y una resma de papel nueva bajo el brazo. | En los raros momentos de calma, %name% parece sentir pánico al darse cuenta de nuevo de su no muerte. Solo manteniendo ocupada sin cesar su mente feroz y brillante logra acallar los horrores de su alrededor. | A %name% no le importa rebajar su rango tratando de buen grado con sus subordinados. Aunque poco ortodoxos, sus métodos permiten observar mejor la moral y las actitudes de la Legión, y rara vez suelta el pergamino de la mano. | Con su carácter erudito e inquisitivo, %name% se adaptó muy bien a su nueva forma, con ganas de explorar sus implicaciones y su potencial. Cuando no cuadra las cuentas de la Legión, se le puede ver garabateando con furia en sus propios tomos privados.}"
    }
    // FILE: scripts\skills\backgrounds\legend_legion_slave_background.nut
    // context: legend_legion_slave_background.create.m.Name
    {
        en = "Servus"
        es = "Siervo"
    }
    // context: legend_legion_slave_background.create.m.BackgroundDescription
    {
        en = "Taken from a distant land lost to time, this slave still fights for their household."
        es = "Arrebatada a una tierra lejana perdida en el tiempo, esta alma esclava sigue luchando por la casa a la que pertenece."
    }
    // context: legend_legion_slave_background.onBuildDescription
    {
        en = "{%name% hunches and hobbles along as though their bone frame was still burdened by calloused flesh and aching muscles. | %name% appears oblivious to their undeath, limping and lamenting their station, ever fearful of their superiors overhearing and adding to their misfortunes. | Wearing the scars of decades of servitude at the bottom of the Legion, %name%'s bony frame threatens to crumble under the weight of more orders. | March. Dig. Cook. Build. March. Kill. March. The endless labours of %name% persist even in the face of their undeath. | With a bony frame that portrays weakness and years of backbreaking work even after death, %name% shuffles with a stiffness that betrays their battered state.} {A slave in the Legion, their station affords them an excessive regime of endless work. Digging trenches, stripping corpses, and making said corpses dominate the daily unlife of this walking cadaver. | Filling the disposable ranks of the Legion's many slaves, their work is dominated with manual and violent tasks to ensure the unimpeded task of the machine-like Legion. | As one of many faceless slaves within the Legion, they fill the role of the disposable body to throw at problems — fighting, carrying of supplies, and their eventual destruction are vital parts of their role. | Providing comforts to the rest of the Legion at the expense of their own, the work of a Legion slave is one of never-ending toil and torment. | The often unseen labour behind the Legion's frightening efficiency, the labouring slave shares no glory and wins no accolades for its success, but is first to suffer setbacks both on and off the battlefield.} {If %name%'s face had any flesh or human features left, it would betray unspeakable sadness and desperation in the face of their endless torment. Instead, a cold and hollow skull hides such inconveniences, only presenting as ready for more orders. | Despite their station, %name% wears a misplaced enthusiasm to serve and better their situation, tricked by their own delusion that eventually, their toils will end, and they will rise through the Legion as a respected figure. | Fearing the ever-present judgement of their betters, %name% toils with a fervour that threatens to break apart their fragile frame. | The resignation to their fate is clear in how %name% carries themself. Aware of their nature within the Legion's endless campaign, they seemingly await their destruction to return them to the earth, were they so lucky. | Having spent little time in their station, the almost eager demeanour of %name% is likely to be short lived. With the weight of the Legion's endless orders upon their hollow shoulders, one must wonder how long they'll last before crumbling into dust...}"
        es = "{%name% avanza a trompicones y con la espalda doblada, como si su esqueleto aún cargara con carne encallecida y músculos doloridos. | %name% no parece ser consciente de su no muerte: cojea y se lamenta de su condición, siempre con miedo de que sus superiores escuchen sus quejas y sumen más desgracias a las suyas. | Con las cicatrices de décadas de servidumbre en lo más bajo de la Legión, el armazón huesudo de %name% amenaza con desmoronarse bajo el peso de más órdenes. | Marchar. Cavar. Cocinar. Construir. Marchar. Matar. Marchar. Ni siquiera la no muerte pone fin a las interminables labores de %name%. | Con un esqueleto que transmite debilidad y años de trabajo extenuante incluso después de la muerte, %name% arrastra los pies con una rigidez que delata lo maltrecho de su estado.} {Su condición de esclavitud en la Legión le depara un régimen desmedido de trabajo sin fin. Cavar trincheras, despojar cadáveres y fabricar esos mismos cadáveres llenan la no vida diaria de este cadáver andante. | Entre las filas prescindibles de los muchos esclavos de la Legión, su trabajo lo copan las tareas manuales y violentas que garantizan el avance sin trabas de una Legión que funciona como una máquina. | Entre los muchos esclavos sin rostro de la Legión, cumple la función de cuerpo desechable que lanzar contra los problemas: luchar, cargar suministros y su destrucción final son partes vitales de su cometido. | La labor de los esclavos de la Legión, que procuran comodidades al resto a costa de las suyas, es un trabajo sin fin de fatiga y tormento. | Mano de obra a menudo invisible tras la temible eficiencia de la Legión, quienes cargan con el trabajo esclavo no comparten la gloria ni reciben honores por su éxito, pero son los primeros en sufrir los reveses, dentro y fuera del campo de batalla.} {Si al rostro de %name% le quedara algo de carne o rasgos humanos, delataría una tristeza y una desesperación indecibles ante su tormento sin fin. En cambio, un cráneo frío y hueco oculta tales inconvenientes y solo muestra disposición a recibir más órdenes. | Pese a su condición, %name% luce un entusiasmo fuera de lugar por servir y mejorar su situación, víctima de su propio delirio: cree que algún día sus penurias terminarán y ascenderá en la Legión hasta ser una figura respetada. | Con temor al juicio siempre presente de sus superiores, %name% se afana con un fervor que amenaza con despedazar su frágil esqueleto. | La resignación ante su destino se nota en el porte de %name%. Consciente de su naturaleza dentro de la interminable campaña de la Legión, parece esperar la destrucción que devuelva sus huesos a la tierra, si tiene esa suerte. | Con poco tiempo aún en su puesto, la actitud casi entusiasta de %name% probablemente durará poco. Con el peso de las interminables órdenes de la Legión sobre sus hombros huecos, cabe preguntarse cuánto aguantará antes de desmoronarse en polvo...}"
    }
    // FILE: scripts\skills\backgrounds\legend_lonewolf_background.nut
    // context: legend_lonewolf_background.create.m.BackgroundDescription
    {
        en = "You've come this far. Is it worth it? What are a few more heads on the pile in the pursuit of satisfaction?"
        es = "Has llegado hasta aquí. ¿Merece la pena? ¿Qué son unas cuantas cabezas más en el montón en pos de la satisfacción?"
    }
    // context: legend_lonewolf_background.create.m.Titles
    {
        en = "Butcher of %townname%"
        es = "Carnicero de %townname%"
    }
    // context: legend_lonewolf_background.onBuildDescription
    {
        en = "{You've come so far that you forgot where you came from and how it all started. Distant memories of gold grew into fame. But what point is fame and gold to those who are mortal? If you want to create a legacy you'll need to prove yourself first - but years spent alone training for battles that never came will make it hard for anyone to notice you outside of a tournament.}"
        es = "{Has llegado tan lejos que has olvidado de dónde vienes y cómo empezó todo. Los lejanos recuerdos del oro se convirtieron en fama. Pero ¿de qué sirven la fama y el oro a los mortales? Si quieres forjar un legado, primero tendrás que demostrar tu valía, pero los años que pasaste entrenando a solas para batallas que nunca llegaron harán que a nadie le resulte fácil fijarse en ti fuera de un torneo.}"
    }
    // FILE: scripts\skills\backgrounds\legend_lurker_background.nut
    // context: legend_lurker_background.create.m.BackgroundDescription
    {
        en = "This one is unsettling, even for a cultist. Ever quiet and brooding, but with eyes as keen as that of a vengeful god."
        es = "Su presencia inquieta, incluso entre sectarios. Siempre en silencio, con aire sombrío, pero con unos ojos tan agudos como los de un dios vengativo."
    }
    // context: legend_lurker_background.onBuildDescription
    {
        en = "{%name% has always been a quiet sort, preferring to observe rather than act impulsively. | They gravitate to the darkest places possible and have no problem marching through difficult terrain. | Shot in the head by a bolt at close range, %name% was pulled from a shallow grave far in the southern sands by a healer, now they seek reprisal. | Clothed in rags, %name% is suprisingly at ease with their surroundings, ever watchful of potential predators...or prey. | %name% carries a myriad of makeshift arrows, some bone and others metal. However a few shafts and arrowheads seem more otherworldly than the others... | Looking at %name% you can't help but feel that you have met one another before. A familial bond links the two of you together as if you have known each other a lifetime before.} They place a finger on their lips and your thoughts evaporate. \"Davkul awaits us all, chosen one\"."
        es = "{%name% siempre ha sido de pocas palabras y prefiere observar antes que actuar por impulso. | Busca siempre los lugares más oscuros posibles y no tiene problema en marchar por terreno difícil. | Un virote a quemarropa en la cabeza mandó a %name% a una tumba poco profunda en las lejanas arenas del sur, de la que un sanador logró sacar su cuerpo. Ahora busca represalias. | Con harapos por toda vestimenta, %name% está sorprendentemente a gusto en su entorno, siempre al acecho de posibles depredadores... o presas. | %name% lleva una miríada de flechas improvisadas, unas de hueso y otras de metal. Sin embargo, algunas astas y puntas parecen más de otro mundo que las demás... | Al mirar a %name%, no puedes evitar sentir que ya se conocían de antes. Un vínculo familiar los une a los dos, como si se hubieran conocido en una vida anterior.} Se lleva un dedo a los labios y tus pensamientos se evaporan. \"Davkul nos espera a todos, alma elegida\"."
    }
    // FILE: scripts\skills\backgrounds\legend_magister_background.nut
    // context: legend_magister_background.create.m.Name
    {
        en = "Magister"
        es = "Magíster"
    }
    // context: legend_magister_background.create.m.BackgroundDescription
    {
        en = "Magisters are a unique breed of insane. While among the ranks of the insane preside over, their quiet madness eclipses all and causes the rest to fall in line."
        es = "Los magísteres son una clase única de locos. Entre las filas de dementes a las que presiden, su silenciosa locura lo eclipsa todo y hace que los demás acaten su orden."
    }
    // context: legend_magister_background.onBuildDescription
    {
        en = "{Magisters are a conduit of evil in the world, seemingly sucking up all the suffering around them and directing it upon whoever they please.} {%name% is wreathed in fabrics that seem to obey a differant set of rules to the rest of the world. | %name% occasionally turns their head as if an unseen force was whispering to them, nodding and whispering back to the unseen force in kind, almost as if affirming their own madness. | %name% whispers into their weapon and nods in agreement with it, almost as if conversing with a long lost friend. | The stranger tracks and nods towards unseen figures like a ringmaster for a ghostly parade. | The look in the eyes of %name% reveals little, aside from the fact that the more you look at them the more you notice the irregularaties, having a smaller, second pupil for instance. | They stand with a a crooked posture, as if holding up a heavy and unseen burden.} \"Davkul awaits us all\" %name% parrots. You are not certain, but you feel a second voice repeat those words in unison from deep inside your mind."
        es = "{Los magísteres son un conducto del mal en el mundo: aparentemente absorben todo el sufrimiento que los rodea y lo dirigen contra quien les place.} {Envuelven a %name% unas telas que parecen obedecer reglas distintas a las del resto del mundo. | De vez en cuando, %name% gira la cabeza como si una fuerza invisible le susurrara, asiente y le devuelve el susurro, casi como si reafirmara su propia locura. | %name% le susurra a su arma y asiente como si le diera la razón, casi como si conversara con un viejo amigo perdido hace mucho. | Sigue con la mirada a figuras invisibles y les hace señas con la cabeza, como quien dirige un desfile fantasmal. | La mirada de %name% revela poco, salvo que cuanto más miras esos ojos, más irregularidades notas, como una segunda pupila más pequeña, por ejemplo. | Tiene una postura torcida, como si sostuviera una carga pesada e invisible.} \"Davkul nos espera a todos\", repite %name% como un loro. No lo sabes con certeza, pero sientes que una segunda voz repite al unísono esas palabras desde lo más hondo de tu mente."
    }
    // FILE: scripts\skills\backgrounds\legend_man_at_arms_background.nut
    // context: legend_man_at_arms_background.create.m.Name
    {
        en = "Man-At-Arms"
        es = "Hombre de armas"
    }
    // context: legend_man_at_arms_background.create.m.BackgroundDescription
    {
        en = "An old soldier, maimed by some forgettable past conflict, waits for another war that may never come."
        es = "Un viejo soldado, mutilado en algún olvidable conflicto del pasado, espera otra guerra que quizá nunca llegue."
    }
    // context: legend_man_at_arms_background.create.m.GoodEnding
    {
        en = "A former militia recruit such as %name% eventually left the %companyname%. Traveling the lands, visiting villages and helping %them% establish credible militias with which to defend %themselves%. Finding success in an increasingly dangerous world, %name% eventually came to be a known name, called upon as a sort of 'fixer' to come and ensure these villages would remain safe. Last you heard, %name% had purchased a plot of land and was raising a family far from the strife of the world."
        es = "Alguien que había sido recluta de la milicia, como %name%, acabó dejando a %companyname%. Recorrió las tierras, visitando aldeas y ayudándolas a formar milicias creíbles con las que defenderse. Con éxito en un mundo cada vez más peligroso, %name% acabó haciéndose un nombre, y empezaron a recurrir a sus servicios como una especie de 'apagafuegos' para asegurarse de que esas aldeas siguieran a salvo. Lo último que supiste fue que %name% había comprado una parcela de tierra y estaba criando una familia lejos de los conflictos del mundo."
    }
    // context: legend_man_at_arms_background.setGender.m.Name
    {
        en = "Woman-At-Arms"
        es = "Mujer de armas"
    }
    // context: legend_man_at_arms_background.onBuildDescription
    {
        en = "{Years ago, %name% decided to join the local militia. The pay was good and the job was easy. At first. | %name% had no talents in %their% youth, but quickly found %their% calling when defending %their% home from bandits. | When the living dead swarmed into town one cold night years ago, %name% was one of the few who took up arms to protect %their% home - which bought precious time for others to flee. | %name% was never destined for greatness - %they% quickly found %themselves% content in protecting an otherwise sleepy village outside of %randomtown% with a handful of others. | Bored of farming, %name% used %their% talents of stabbing and hammering to protect the village %they% grew up in.} {%name% is largely self taught, practising %their% combat skills on the occasional lost undead or meek bandit raid. Although %their% current injuries suggest that at one time %they% still had a lot to learn. | %name% has fought alongside farmers, mercenaries and even nobles. However %their% inability to gain fame led %them% to age past %their% prime - and pick up an injury along the way. | The injury %name% carries is quite evident, however %they% assure you that %they% can fight just as well as any mercenary could. Only time will tell how much of a lie this might be. | %name%'s injury was unrelated to %their% duties protecting %their% home. Instead %they% recite the tale of 'The cat, the witchling and the cupboard'. Which you find works well as a way to fall asleep on your feet.} {With the writing on the wall that %name% may have a long and painful death ahead of %them%, %they% decided to do what %they% always dreamed of - fighting in a real battle. | Years have not been kind to %name%, however %their% longer than usual time spent training has gifted %them% with a much broader skillset than your average militia. | %name% has outlived enemies and allies alike, and now finds %themselves% completely alone in a world full of strangers. | %name%'s experience and determination in the face of danger is a skill that is rare, even among more hardened professions.}"
        es = "{Hace años, %name% decidió unirse a la milicia local. La paga era buena y el trabajo, fácil. Al principio. | %name% no tenía ningún talento en su juventud, pero enseguida encontró su vocación al defender su hogar de los bandidos. | Cuando los muertos vivientes invadieron el pueblo una fría noche hace años, %name% fue un%o% de los pocos que empuñaron las armas para proteger su hogar, lo que dio a otros un tiempo precioso para huir. | %name% nunca estuvo destinad%o% a la grandeza: enseguida se dio por satisfech%o% protegiendo, junto a un puñado de otros, una aldea por lo demás adormecida a las afueras de %randomtown%. | Hart%o% de la labranza, %name% usó su talento para apuñalar y martillear en proteger la aldea en la que se crió.} {%name% es en gran medida autodidacta y practicaba sus habilidades de combate con algún no muerto extraviado o alguna tímida incursión de bandidos. Aunque sus heridas actuales sugieren que hubo un tiempo en que aún tenía mucho que aprender. | %name% ha luchado junto a granjeros, mercenarios e incluso nobles. Sin embargo, su incapacidad para ganar fama hizo que dejara atrás sus mejores años, y que sufriera una herida por el camino. | La herida de %name% es bastante evidente, pero te asegura que puede luchar tan bien como cualquier mercenario. Solo el tiempo dirá cuánto hay de mentira en ello. | La herida de %name% no tuvo nada que ver con sus deberes protegiendo su hogar. En cambio, te cuenta la historia de 'El gato, la brujilla y el armario', que te parece un buen modo de dormirte de pie.} {Viendo las señales de que quizá tenga por delante una muerte larga y dolorosa, %name% decidió hacer lo que siempre había soñado: luchar en una batalla de verdad. | Los años no han sido amables con %name%, pero su tiempo de entrenamiento, más largo de lo habitual, le ha dado un repertorio de habilidades mucho más amplio que el de un miliciano corriente. | %name% ha sobrevivido a enemigos y aliados por igual, y ahora se encuentra completamente sol%o% en un mundo lleno de extraños. | La experiencia y la determinación de %name% ante el peligro son una cualidad poco común, incluso entre oficios más curtidos.}"
    }
    // FILE: scripts\skills\backgrounds\legend_master_archer_background.nut
    // context: legend_master_archer_background.create.m.BackgroundDescription
    {
        en = "Master Archers have spent years honing their craft in hunting, sport and war."
        es = "Los Maestros arqueros han pasado años perfeccionando su oficio en la caza, el deporte y la guerra."
    }
    // context: legend_master_archer_background.create.m.GoodEnding
    {
        en = "While the %companyname% continued on with great success, %name% the hunter eventually saw fit to leave it all behind. They returned to the life of an archer, working for who ever paid the best. %name% rarely showed the grim reality of hunting humans, but you have to imagine they'd just rather stop doing it. As far as you know, %name% is doing well these days. The archer purchased a bit of land and helps guide nobles on pricey hunting trips."
        es = "Mientras %companyname% seguía adelante con gran éxito, %name% acabó por dejarlo todo atrás. Volvió a vivir del arco, trabajando para quien mejor pagara. Rara vez dejaba ver %name% lo sombrío de cazar humanos, pero cabe imaginar que preferiría dejar de hacerlo. Que tú sepas, a %name% le va bien estos días: compró un poco de tierra y ayuda a guiar a nobles en costosas partidas de caza."
    }
    // context: legend_master_archer_background.create.m.BadEnding
    {
        en = "With the decline of the %companyname% readily obvious, %name% the master archer departed from the company and returned to archery contests. Unfortunately, a shoot off went awry while shooting apples off each other's heads. The master archer was the better shot, but being better does not help if you're dead."
        es = "Con el declive de %companyname% bien a la vista, %name% dejó la compañía con toda su maestría con el arco y volvió a los concursos de tiro. Por desgracia, un desempate salió mal en una prueba en la que cada uno disparaba a una manzana sobre la cabeza del otro. Su puntería era mejor, pero ser mejor no sirve de nada si estás muerto."
    }
    // context: legend_master_archer_background.create.m.Titles
    {
        en = "Target Finder"
        es = "Buscablancos"
    }
    // context: legend_master_archer_background.create.m.Titles
    {
        en = "the Accurate"
        es = "el Certero"
    }
    // context: legend_master_archer_background.create.m.Titles
    {
        en = "the Archer"
        es = "el Arquero"
    }
    // context: legend_master_archer_background.create.m.Titles
    {
        en = "Arrowsplitter"
        es = "Parteflechas"
    }
    // context: legend_master_archer_background.onBuildDescription
    {
        en = "{Without a father around, %name%'s mother taught the child how to shoot a bow, and how to feed the rest of the family. | Born in the hinterlands of %randomtown%, %name% has spent life stalking the beasts amongst the trees. | %name% once took a bet to shoot an apple off a pig's head, and missed. With a belly full of bacon, the archer became determined to never miss again - unless it meant more bacon, of course. | Early in life, %name% liked to traipse about the forests. When a rabid fox attacked, %name% learned to take a bow. When a devilish eagle clawed the archer's face, %name% learned to shoot it.} {Once employed by local royalty, a disastrous boar hunt ended with a gored baron and all the blame - and blood - on %name%'s hands. | The hunter hid the thought well, but for the longest time wondered what it would be like to hunt the ultimate game: man. | Sadly, a bad game of peasant-roulette forced the deer hunter into seeking other means of income. | Unfortunately, not nearly as good at cooking deer as shooting them. A dinner consisting of undercooked meats poisoned the archer's entire family. Desperation for a new life is understandable. | After an arduous trip to town to sell meats and leathers, %name% followed the call of mercenary work. | War drove the game out of the forests, and the hunt out of %name%. Now %name% seeks another line of work. | When %name%'s partner fell ill, the archer could not heal with hunted meat. Needing to earn crowns to pay for treatment, %name% took up the vocation of sellswords - or sellbows, as it were.} {Any outfit could use a deadeye such as this. | Not entirely without faults, %name% is a professional bowman nonetheless. | A quick demonstration is offered: %name% shoots one arrow high into the sky, and with another he knocks it out. Impressive. | %name% has something to prove - just make sure it is done at range. When first given a sword, %name% grabbed it at the wrong end. Yes, that end. | The hunter wields a bow like another limb, and shoots arrows like a preacher does words.}"
        es = "{Sin un padre cerca, la madre de %name% le enseñó a disparar con arco y a alimentar al resto de la familia. | Desde que nació en las tierras salvajes de los alrededores de %randomtown%, %name% se ha pasado la vida acechando a las bestias entre los árboles. | %name% aceptó una vez una apuesta para acertarle a una manzana sobre la cabeza de un cerdo, y falló. Con la barriga llena de tocino, se propuso no volver a fallar nunca, salvo que eso significara más tocino, claro. | En su infancia, a %name% le gustaba deambular por los bosques. Tras el ataque de un zorro rabioso, %name% aprendió a empuñar un arco. Cuando un águila endiablada le arañó la cara, %name% aprendió a dispararlo.} {En otro tiempo trabajó para la realeza local, hasta que una desastrosa cacería de jabalíes terminó con un barón destripado y toda la culpa, y la sangre, en manos de %name%. | Lo ocultaba bien, pero durante mucho tiempo se preguntó cómo sería cazar la presa definitiva: el hombre. | Por desgracia, una mala partida de ruleta campesina obligó a quien antes cazaba ciervos a buscar otros medios de vida. | Por desgracia, cocinar ciervos no se le da ni de lejos tan bien como abatirlos. Una cena de carnes poco hechas envenenó a toda su familia. Es comprensible la desesperación por empezar una nueva vida. | Tras un arduo viaje a la ciudad para vender carnes y pieles, %name% siguió la llamada del oficio de mercenario. | La guerra sacó la caza de los bosques, y a %name% las ganas de cazar. Ahora %name% busca otro oficio. | Cuando la pareja de %name% enfermó, la carne de caza no bastó para curarla. Con la necesidad de ganar coronas para pagar el tratamiento, %name% abrazó el oficio de mercenario: espada a sueldo, o más bien arco a sueldo.} {A cualquier banda le vendría bien una puntería como esta. | %name% no está libre de defectos, pero aun así maneja el arco como un profesional. | %name% ofrece una rápida demostración: dispara una flecha muy alto al cielo y la derriba con otra. Impresionante. | %name% tiene algo que demostrar; solo asegúrate de que lo haga a distancia. La primera vez que le dieron una espada, %name% la agarró por el extremo equivocado. Sí, por ese extremo. | Maneja el arco como si fuera una extremidad más y dispara flechas como un predicador suelta palabras.}"
    }
    // FILE: scripts\skills\backgrounds\legend_muladi_background.nut
    // context: legend_muladi_background.create.m.BackgroundDescription
    {
        en = "A muladi is accustomed to the south, although not entirely accepted by the locals."
        es = "Los muladíes están acostumbrados al sur, aunque los lugareños no terminan de aceptarlos."
    }
    // context: legend_muladi_background.create.m.GoodEnding
    {
        en = "Ever an outcast, %name% returned home and used the crowns gained from their adventures to buy a home far away from those who scorned them in the past. The link between nature and %name% strengthened, acting a safe safe haven for those wronged or on the run."
        es = "Siempre en los márgenes, %name% volvió a casa y usó las coronas ganadas en sus aventuras para comprar un hogar lejos de quienes le hicieron el vacío en el pasado. El vínculo entre %name% y la naturaleza se fortaleció, y su hogar se convirtió en un refugio seguro para quienes sufrían agravios o huían."
    }
    // context: legend_muladi_background.create.m.BadEnding
    {
        en = "Living on the divide was a dangerous business, in attempting to return home they were driven out by northern militia on a border town with the desert. Alone, hungry and desperate. %name% was easy prey for the wild animals they once called kin."
        es = "Vivir en la frontera entre dos mundos era un asunto peligroso: al intentar volver a casa, la milicia norteña le hizo huir de un pueblo fronterizo con el desierto. Sin compañía, con hambre y sin esperanza. %name% fue presa fácil de los animales salvajes que antaño consideró de su misma sangre."
    }
    // context: legend_muladi_background.onAdded.actor.setTitle()
    {
        en = "the Muladí"
        es = "el Muladí"
    }
    // context: legend_muladi_background.onBuildDescription
    {
        en = "{Despite the clothing and language of the south, %name% has always been regarded with contempt by %their% fellow southerners who prefer to name them 'outsider' than anything else. | Life on the edge of society taught %name% about a lot of things - self reliance, animal kinship, and how to effectively fell a man at 30 paces with an arrow. } {Once a northerner, %name% dresses, speaks and acts in all southern customs. Much to the irritation of some of the local inhabitants. | %name%'s presence is seen as a threat by some and an abomination by others. | %name% assures you that this way of life is not as painful as it may seem, despite the occasional insults from the locals. } {%name% stands out to everyone around them - at a glance %they% appears to be your typical nomad wandering the streets or moving across the dunes, but on closer inspection many will recognise %their% face has not been gilded by the sun and is missing the darker hair common in this region.  | %name% is a self appointed outcast, or perhaps a victim of shifting territories and warring cultures. } {%name%'s existence is quite simple - life at the rim of society allows %them% to appreciate the more natural things in life. Nature, landscapes and the occasional holy war far off on the horizon. | The aggression and violence of humanity is what led %name% to adopt more of the southern customs, perhaps feeling that trading multiple tyrants for a singular one would be a favourable transaction. | %name% remarks %they% moved only for the food, but you suspect %they% came for a little bit more than that.}"
        es = "{Pese a vestir y hablar como en el sur, %name% siempre ha sido mirad%o% con desprecio por sus paisanos sureños, que antes que cualquier otra cosa prefieren llamar%lo% 'foraster%o%'. | La vida al margen de la sociedad le enseñó muchas cosas a %name%: a valerse por sí mism%o%, el parentesco con los animales y cómo abatir con eficacia a un hombre a 30 pasos con una flecha. } {Aunque en su día fue norteñ%o%, %name% viste, habla y actúa según todas las costumbres del sur. Para gran irritación de algunos de los lugareños. | Algunos ven la presencia de %name% como una amenaza, y otros, como una abominación. | %name% te asegura que este modo de vida no es tan doloroso como pueda parecer, pese a los insultos ocasionales de los lugareños. } {%name% llama la atención de todo el que %lo% rodea: a simple vista parece %un% nómada cualquiera que vaga por las calles o cruza las dunas, pero si se mira de cerca, muchos advertirán que el sol no ha dorado su rostro y que le falta el pelo más oscuro tan común en esta región.  | %name% es %un% paria por voluntad propia, o quizá víctima de territorios cambiantes y culturas en guerra. } {La existencia de %name% es bastante sencilla: vivir en los márgenes de la sociedad le permite apreciar las cosas más naturales de la vida. La naturaleza, los paisajes y alguna que otra guerra santa a lo lejos, en el horizonte. | La agresividad y la violencia de la humanidad fueron lo que llevó a %name% a adoptar más costumbres sureñas, quizá porque cambiar muchos tiranos por uno solo le parecía un buen negocio. | %name% comenta que se mudó solo por la comida, pero sospechas que vino por algo más que eso.}"
    }
    // FILE: scripts\skills\backgrounds\legend_necro_background.nut
    // context: legend_necro_background.create.m.Name
    {
        en = "Warlock"
        es = "Brujo"
    }
    // FILE: scripts\skills\backgrounds\legend_necro_commander_background.nut
    // context: legend_necro_commander_background.create.m.BackgroundDescription
    {
        en = "Years of practical training and close calls have shaped %name% into a cold, dark figure capable of calling colder and darker followers to serve them."
        es = "Años de práctica y de salvarse por los pelos han convertido a %name% en una figura fría y oscura, capaz de llamar a su servicio a seguidores aún más fríos y oscuros."
    }
    // context: legend_necro_commander_background.create.m.GoodEnding
    {
        en = "What awaits you at the top? You move from place to place and nothing ever holds your attention for long. Your mind bristles with ideas but the company you keep often fails to keep up in more ways than one. You repeated the same routes, strategies and maximised your efforts, perhaps cutting a few too many corners along the way. Why are you not happy? Is this not what you wanted? Nothing stirs within you — maybe you should have taken things more slowly? Enjoyed the small moments? Even if you did, would it change this outcome? Was this all too easy? Or perhaps too hard? Regardless, you are here now, and you can't go back anymore..."
        es = "¿Qué te espera en la cima? Vas de un lugar a otro y nada retiene tu atención por mucho tiempo. Tu mente bulle de ideas, pero tu compañía rara vez consigue seguirte el ritmo, y en más de un sentido. Repetiste las mismas rutas y estrategias y llevaste tus esfuerzos al máximo, quizá tomando demasiados atajos por el camino. ¿Por qué no eres feliz? ¿No es esto lo que querías? Nada se agita en tu interior: ¿quizá deberías haberte tomado las cosas con más calma? ¿Disfrutar de los pequeños momentos? Aunque lo hubieras hecho, ¿cambiaría esto el desenlace? ¿Fue todo demasiado fácil? ¿O quizá demasiado difícil? Sea como sea, ahora estás aquí, y ya no puedes volver atrás..."
    }
    // context: legend_necro_commander_background.create.m.BadEnding
    {
        en = "What awaits you at the top? You move from place to place and nothing ever holds your attention for long. Your mind bristles with ideas but the company you keep often fails to keep up in more ways than one. You repeated the same routes, strategies and maximised your efforts, perhaps cutting a few too many corners along the way. Why are you not happy? Is this not what you wanted? Nothing stirs within you — maybe you should have taken things more slowly? Perhaps enjoyed the small moments? Even if you did, would it change this outcome? Was this all too easy? Or perhaps too hard? Regardless, you are here now, and you can't go back anymore..."
        es = "¿Qué te espera en la cima? Vas de un lugar a otro y nada retiene tu atención por mucho tiempo. Tu mente bulle de ideas, pero tu compañía rara vez consigue seguirte el ritmo, y en más de un sentido. Repetiste las mismas rutas y estrategias y llevaste tus esfuerzos al máximo, quizá tomando demasiados atajos por el camino. ¿Por qué no eres feliz? ¿No es esto lo que querías? Nada se agita en tu interior: ¿quizá deberías haberte tomado las cosas con más calma? ¿Quizá disfrutar de los pequeños momentos? Aunque lo hubieras hecho, ¿cambiaría esto el desenlace? ¿Fue todo demasiado fácil? ¿O quizá demasiado difícil? Sea como sea, ahora estás aquí, y ya no puedes volver atrás..."
    }
    // context: legend_necro_commander_background.create.m.Titles
    {
        en = "the Hidden Hand"
        es = "la Mano Oculta"
    }
    // context: legend_necro_commander_background.create.m.Titles
    {
        en = "the Morbid"
        es = "el Morboso"
    }
    // context: legend_necro_commander_background.create.m.Titles
    {
        en = "the Surgeon"
        es = "el Cirujano"
    }
    // context: legend_necro_commander_background.create.m.Titles
    {
        en = "the Waker"
        es = "el Resucitador"
    }
    // context: legend_necro_commander_background.create.m.Titles
    {
        en = "the Fleshshaper"
        es = "el Moldeacarne"
    }
    // context: legend_necro_commander_background.create.m.Titles
    {
        en = "the Overseer"
        es = "el Capataz"
    }
    // context: legend_necro_commander_background.onBuildDescription
    {
        en = "Clothed in the un-reality of your life's work, manipulating the undead is second nature. With nothing to fear, manipulating people was not much more difficult. Despite the pacts you have made and the enemies bested along the way, you feel age catching up to you. How long has it been — how much longer is there to go?"
        es = "Con la irrealidad de la obra de tu vida como vestimenta, manipular a los no muertos es para ti una segunda naturaleza. Sin nada que temer, manipular a la gente no fue mucho más difícil. Pese a los pactos que has sellado y a los enemigos que has vencido por el camino, sientes que la edad te alcanza. ¿Cuánto tiempo ha pasado? ¿Cuánto queda aún?"
    }
    // FILE: scripts\skills\backgrounds\legend_necrosavant_background.nut
    // en = "Necrosavant"
    // en base_es
    // context: legend_necrosavant_background.create.m.Titles
    {
        en = "the Gruesome"
        es = "el Espantoso"
    }
    // en = "the Bloody"
    // en base_es
    // context: legend_necrosavant_background.create.m.Titles
    {
        en = "the Vile"
        es = "el Vil"
    }
    // context: legend_necrosavant_background.create.m.Titles
    {
        en = "The Leech"
        es = "La Sanguijuela"
    }
    // context: legend_necrosavant_background.create.m.Titles
    {
        en = "the Bat"
        es = "el Murciélago"
    }
    // FILE: scripts\skills\backgrounds\legend_nightwatch_background.nut
    // context: legend_nightwatch_background.create.m.Name
    {
        en = "Night Watch"
        es = "Guardia nocturno"
    }
    // context: legend_nightwatch_background.create.m.BackgroundDescription
    {
        en = "The night watch are an unlucky few chosen to break up fights and keep towns lawful at the worst time of the day."
        es = "La guardia nocturna la forman unos pocos desafortunados elegidos para disolver peleas y mantener el orden en los pueblos en la peor hora del día."
    }
    // context: legend_nightwatch_background.create.m.GoodEnding
    {
        en = "%name% found themselves quite comfortable within the darkness, mingling with the company and learning many valuable skills. After they retired from service, they joined with a group of beast hunters that sought to hunt down the horrors of the night. Last you heard, they have been doing quite well for themselves. Able to spot and expell an alp from a village without breaking a sweat."
        es = "%name% se encontró muy a gusto en la oscuridad, codeándose con la compañía y aprendiendo muchas habilidades valiosas. Tras retirarse del servicio, se unió a un grupo de cazadores de bestias que buscaban dar caza a los horrores de la noche. Lo último que supiste es que le va bastante bien. Es capaz de detectar a un alp y expulsarlo de una aldea sin sudar siquiera."
    }
    // context: legend_nightwatch_background.create.m.BadEnding
    {
        en = "After many sleepless nights, remembering the horrors they faced within the company, %Name% returned to their village and became a night watchman once more. Unfortunately, a few days later they were found dead at their post. Their eyes shut, yet face contorted into a look of horror. Not a single villager heard any commotion during the night, but one reported seeing a pale figure stalking off in the moonlight."
        es = "Tras muchas noches en vela recordando los horrores que vivió en la compañía, %Name% volvió a su aldea y retomó las guardias nocturnas. Por desgracia, pocos días después apareció sin vida en su puesto. Tenía los ojos cerrados, pero el rostro contraído en una mueca de horror. Ni un solo aldeano oyó alboroto alguno durante la noche, pero uno contó haber visto una figura pálida alejándose sigilosa a la luz de la luna."
    }
    // context: legend_nightwatch_background.onBuildDescription
    {
        en = "{Never one to fear the night, %name%'s path in life lead them to the mantle of watchman. | With pale skin and bloodshot eyes, %name% carries the 'look' of a night watchman. | %name% carries an old lantern attached to a stick over their shoulder. An eerie smile on their face as they stare you down. | With their bellowing voice and keen eyes, it's no wonder %name% was selected as %townname%'s watchwoman. | %name% was assigned to watchman duty as punishment for falling asleep during the day. Cursed to a dark, and lonely service in the local militia. | %name% was forced into the duty of night watchman as a punishment after being accused for a string of night robberies within %townname%.} {Living a quiet life in the night became quite a lonely and soul crushing experience for %name%. They sought something more, hanging up their lantern and looking to join a band of wandering mercenaries. | After falling asleep at an inopportune time, which ended up with two children being kidnapped right out of their homes. %name% sought to escape persecution for the failure in any way they could. | After a string of haunting visions in the night, %name% found themselves unable to cope with such. Resigning immediately and looking for a new avenue of employment.} {Night watchman has molded them into a pale and wiry figure. But still a somewhat capable fighter. | With all the horrors that stalk the night, %name% seems like a fitting member to keep around. | %name% looks like they haven't slept in days. But they assure you they get plenty of rest, and their odd sleep patterns will not be an issue. | %name%'s keen eyes will be /very/ useful in the coming days. Having someone to watch you while you sleep is a blessing considering what roams in the dark.}"
        es = "{Como nunca le tuvo miedo a la noche, el camino de la vida llevó a %name% al puesto de vigilante. | Con la piel pálida y los ojos inyectados en sangre, %name% tiene la 'pinta' típica de la guardia nocturna. | %name% lleva al hombro un viejo farol atado a un palo. Luce una sonrisa inquietante mientras te sostiene la mirada. | Con esa voz atronadora y esa vista aguda, no es de extrañar que eligieran a %name% como vigilante de %townname%. | A %name% le asignaron la guardia nocturna como castigo por echarse a dormir durante el día. Le tocó en suerte un servicio oscuro y solitario en la milicia local. | Obligaron a %name% a hacer guardia por las noches como castigo, tras atribuirle una serie de robos nocturnos en %townname%.} {Llevar una vida tranquila de noche acabó siendo para %name% una experiencia muy solitaria y demoledora para el alma. Buscaba algo más, así que colgó el farol y quiso unirse a una banda de mercenarios errantes. | Tras dormirse en un momento inoportuno, lo que acabó con dos niños secuestrados en sus propias casas, %name% intentó escapar como fuera de la persecución por aquel fallo. | Tras una serie de visiones inquietantes en la noche, %name% no pudo soportarlo más. Renunció de inmediato y buscó un nuevo oficio.} {Las guardias nocturnas le han dado una figura pálida y fibrosa. Pero aún sabe pelear razonablemente bien. | Con todos los horrores que acechan en la noche, parece buena idea tener a %name% cerca. | Parece que %name% lleva días sin dormir. Pero te asegura que descansa de sobra y que sus extraños horarios de sueño no serán un problema. | La aguda vista de %name% será /muy/ útil en los próximos días. Tener a alguien que te vigile mientras duermes es una bendición, teniendo en cuenta lo que ronda en la oscuridad.}"
    }
    // context: legend_nightwatch_background.onBuildDescription
    {
        en = "{Never one to fear the night, %name%'s path in life lead them to the mantle of watchman. | With pale skin and bloodshot eyes, %name% carries the 'look' of a night watchman. | %name% carries an old lantern attached to a stick over their shoulder. An eerie smile on their face as they stare you down. | With their bellowing voice and keen eyes, it's no wonder %name% was selected as %townname%'s watchman. | %name% was assigned to watchman duty as punishment for falling asleep during the day. Cursed to a dark, and lonely service in the local militia. | %name% was forced into the duty of night watchman as a punishment after being accused for a string of night robberies within %townname%.} {Living a quiet life in the night became quite a lonely and soul crushing experience for %name%. They sought something more, hanging up their lantern and looking to join a band of wandering mercenaries. | After falling asleep at an inopportune time, which ended up with two children being kidnapped right out of their homes. %name% sought to escape persecution for the failure in any way they could. | After a string of haunting visions in the night, %name% found themselves unable to cope with such. Resigning immediately and looking for a new avenue of employment.} {Night watchman has molded them into a pale and wiry figure. But still a somewhat capable fighter. | With all the horrors that stalk the night, %name% seems like a fitting member to keep around. | %name% looks like they haven't slept in days. But they assure you they get plenty of rest, and their odd sleep patterns will not be an issue. | %name%'s keen eyes will be /very/ useful in the coming days. Having someone to watch you while you sleep is a blessing considering what roams in the dark.}"
        es = "{Como nunca le tuvo miedo a la noche, el camino de la vida llevó a %name% al puesto de vigilante. | Con la piel pálida y los ojos inyectados en sangre, %name% tiene la 'pinta' típica de la guardia nocturna. | %name% lleva al hombro un viejo farol atado a un palo. Luce una sonrisa inquietante mientras te sostiene la mirada. | Con esa voz atronadora y esa vista aguda, no es de extrañar que eligieran a %name% como vigilante de %townname%. | A %name% le asignaron la guardia nocturna como castigo por echarse a dormir durante el día. Le tocó en suerte un servicio oscuro y solitario en la milicia local. | Obligaron a %name% a hacer guardia por las noches como castigo, tras atribuirle una serie de robos nocturnos en %townname%.} {Llevar una vida tranquila de noche acabó siendo para %name% una experiencia muy solitaria y demoledora para el alma. Buscaba algo más, así que colgó el farol y quiso unirse a una banda de mercenarios errantes. | Tras dormirse en un momento inoportuno, lo que acabó con dos niños secuestrados en sus propias casas, %name% intentó escapar como fuera de la persecución por aquel fallo. | Tras una serie de visiones inquietantes en la noche, %name% no pudo soportarlo más. Renunció de inmediato y buscó un nuevo oficio.} {Las guardias nocturnas le han dado una figura pálida y fibrosa. Pero aún sabe pelear razonablemente bien. | Con todos los horrores que acechan en la noche, parece buena idea tener a %name% cerca. | Parece que %name% lleva días sin dormir. Pero te asegura que descansa de sobra y que sus extraños horarios de sueño no serán un problema. | La aguda vista de %name% será /muy/ útil en los próximos días. Tener a alguien que te vigile mientras duermes es una bendición, teniendo en cuenta lo que ronda en la oscuridad.}"
    }
    // FILE: scripts\skills\backgrounds\legend_noble_2h.nut
    // context: legend_noble_2h.create.m.Name
    {
        en = "Warrior"
        es = "Guerrero"
    }
    // context: legend_noble_2h.create.m.BackgroundDescription
    {
        en = "Noble House Warriors are drawn from peasant backgrounds, then trained in two handed weapons and heavy armor"
        es = "Los guerreros de casa noble salen del campesinado y luego se entrenan con armas a dos manos y armadura pesada"
    }
    // context: legend_noble_2h.create.m.GoodEnding
    {
        en = "Supporting your cause from the start, %name% was with you in retirement, leaving the company not long after you did. Though he was a lowly peasant, he proved himself in battle after battle and slowly became as trusted and valued a friend as one can have in a mercenary company."
        es = "Tras apoyar tu causa desde el principio, %name% te acompañó en el retiro y dejó la compañía poco después que tú. Aunque era un humilde campesino, demostró su valía batalla tras batalla y poco a poco se convirtió en el amigo más fiel y apreciado que se puede tener en una compañía de mercenarios."
    }
    // context: legend_noble_2h.create.m.BadEnding
    {
        en = "A supporter from the start, %name% was as loyal as he was talented. He stayed with the company for a time before eventually leaving to forge out a path for himself. The other day, you received a letter from the mercenary stating that he had started his own company and was in dire need of help. Unfortunately, the message was dated to nearly a full year ago. When you investigated the existence of his company, you learned that it had been completely annihilated in a battle between nobles."
        es = "Partidario tuyo desde el principio, %name% era tan leal como talentoso. Se quedó con la compañía un tiempo antes de marcharse finalmente para labrarse su propio camino. El otro día recibiste una carta del mercenario en la que decía que había fundado su propia compañía y necesitaba ayuda urgentemente. Por desgracia, el mensaje tenía fecha de hacía casi un año. Cuando averiguaste qué había sido de su compañía, supiste que la habían aniquilado por completo en una batalla entre nobles."
    }
    // context: legend_noble_2h.setGender.m.GoodEnding
    {
        en = "Supporting your cause from the start, %name% was with you in retirement, leaving the company not long after you did. Though she was a lowly peasant, she proved herself in battle after battle and slowly became as trusted and valued a friend as one can have in a mercenary company."
        es = "Tras apoyar tu causa desde el principio, %name% te acompañó en el retiro y dejó la compañía poco después que tú. Aunque era una humilde campesina, demostró su valía batalla tras batalla y poco a poco se convirtió en la amiga más fiel y apreciada que se puede tener en una compañía de mercenarios."
    }
    // context: legend_noble_2h.setGender.m.BadEnding
    {
        en = "A supporter of your cause from the start, %name% was as loyal as she was talented. She stayed with the company for a time before eventually leaving to forge out a path for himself. The other day, you received a letter from the mercenary stating that she had started her own company and was in dire need of help. Unfortunately, the message was dated to nearly a full year ago. When you investigated the existence of her company, you learned that it had been completely annihilated in a battle between nobles."
        es = "Partidaria de tu causa desde el principio, %name% era tan leal como talentosa. Se quedó con la compañía un tiempo antes de marcharse finalmente para labrarse su propio camino. El otro día recibiste una carta de la mercenaria en la que decía que había fundado su propia compañía y necesitaba ayuda urgentemente. Por desgracia, el mensaje tenía fecha de hacía casi un año. Cuando averiguaste qué había sido de su compañía, supiste que la habían aniquilado por completo en una batalla entre nobles."
    }
    // context: legend_noble_2h.onBuildDescription
    {
        // corrige base: "un gran hacha de dos manos" añade un hacha que el inglés no dice ("two-hander" es cualquier arma a dos manos) y además es incorrecto ("una gran hacha"); pasa a "una gran arma a dos manos".
        // corrige base: "Vestido en intenciones asesinas" no es castellano idiomático; pasa a "Revestido de".
        // corrige base: "un noble que lo estaba mirando" invierte el sentido: el noble asistía al torneo como espectador, no miraba al personaje; pasa a "un noble que asistía al torneo".
        // corrige base: "Por lo visto, imparable" traduce "Seemingly", que es "aparentemente" ("por lo visto" es "apparently").
        // corrige base: "solo con su empujón" no traduce "backswing" (el movimiento de echar el arma atrás); pasa a "con solo echar el arma atrás para tomar impulso".
        // corrige base: "convertir a un hombre en una ruina" omite "body"; pasa a "convertir el cuerpo de un hombre en una ruina calamitosa".
        en = "Brooding and at times suicidal, it's no surprise that %name% is frequently found diving into battle with nothing more than a large two-hander. {Clothed in murderous intent, you once saw her cleave a man in two - top to bottom. | It is said that she once cleaved a warrior orc in two, leaving the trunk of its legs still standing. | The woman is known to ignore the fragility of her own mortality just to end the life of another. | She thrives being in the thick of battle where she can swing her weapons with little regard for safety or accuracy. | Supposedly, she once won a jousting tournament, but had to flee after bedding a watching nobleman's wife. | The woman is not a murderer, but she would have made a fine one. | Seemingly unstoppable at times, you are glad to have the woman on your side. | In a fit of bloodthirsty rage she once impaled two goblins on one pike. | A strong brute, you once saw %name% kill someone just on her backswing.} She'll use any weapon you give her, but %name% has a proclivity towards those that can make calamitous ruin out of a man's body."
        es = "Sumida en la melancolía y a veces con tendencias suicidas, no sorprende que a %name% se la encuentre a menudo lanzándose a la batalla con nada más que una gran arma a dos manos. {Revestida de intenciones asesinas, una vez la viste partir a un hombre en dos, de arriba abajo. | Se dice que una vez partió en dos a un guerrero orco, dejando la parte inferior de sus piernas aún de pie. | Se sabe que esta mujer desdeña la fragilidad de su propia mortalidad solo para poner fin a la vida de otro. | Prospera en lo más reñido de la batalla, donde puede blandir sus armas sin preocuparse mucho por la seguridad o la precisión. | Supuestamente, una vez ganó un torneo de justas, pero tuvo que huir después de acostarse con la esposa de un noble que asistía al torneo. | La mujer no es una asesina, pero habría sido una excelente asesina. | Aparentemente imparable en ocasiones, te alegra tener a esta mujer de tu lado. | En un arranque de ira sedienta de sangre, una vez empaló a dos trasgos en una sola pica. | Bruta y fuerte, una vez viste a %name% matar a alguien con solo echar el arma atrás para tomar impulso.} Usará cualquier arma que le des, pero %name% tiene predilección por aquellas capaces de convertir el cuerpo de un hombre en una ruina calamitosa."
    }
    // FILE: scripts\skills\backgrounds\legend_noble_background.nut
    // context: legend_noble_background.create.m.BackgroundDescription
    {
        en = "A noble of the realm, practiced in fencing but quite unfit"
        es = "Miembro de la nobleza del reino, con práctica en la esgrima pero en muy baja forma"
    }
    // context: legend_noble_background.create.m.GoodEnding
    {
        // corrige base: "rincones más remotos e inhósputos" tiene errata ("inhóspitos") y añade un adjetivo que el inglés no tiene ("furthest reaches"); pasa a "los confines más remotos del mundo".
        // corrige base: "tales cuentos fantásticos" rebaja "fantastical tripe", que es despectivo; pasa a "tales paparruchas fantásticas".
        // corrige base: "regresar a su noble familia" pide "regresar con"; "en estos días" es calco de "these days", mejor "hoy en día"; "guerra civil noble" pasa a "guerra civil entre nobles".
        en = "Adventurousness never leaves the soul of a man like %name%. {Instead of returning to the armed services, he left the %companyname% and headed east in search of rare beasts. Word has it he returned to town with the head of what looked like a giant lizard, but you don't believe such fantastical tripe. | He departed the %companyname% and ventured west, sailing across the oceans to unseen lands. There's no telling where he is these days, but you've little doubt that he'll be coming back with stories to tell. | He retired from the %companyname% and, instead of returning to his noble family, headed south. Word has it he fought in a great noble civil war, killed an orc warlord, climbed the highest mountain in the land, and is currently writing an epic about his travels. | The nobleman left the %companyname% and, preferring the life of adventure to noble boredom, he headed north. Word has it that he's currently marching a troop of explorers to the furthest reaches of the world.}"
        es = "El espíritu aventurero nunca abandona el alma de un hombre como %name%. {En lugar de volver al servicio de las armas, dejó a %companyname% y se dirigió al este en busca de bestias raras. Se rumorea que regresó a la ciudad con la cabeza de lo que parecía ser un lagarto gigante, pero no crees en tales paparruchas fantásticas. | Dejó a %companyname% y se aventuró hacia el oeste, navegando por los océanos hacia tierras desconocidas. No hay forma de saber dónde está hoy en día, pero no te cabe duda de que volverá con historias que contar. | Se retiró de %companyname% y, en lugar de regresar con su noble familia, se dirigió al sur. Se dice que luchó en una gran guerra civil entre nobles, mató a un señor de la guerra orco, escaló la montaña más alta de la tierra y actualmente está escribiendo una epopeya sobre sus viajes. | El noble dejó a %companyname% y, prefiriendo la vida de aventura al aburrimiento de la nobleza, se dirigió al norte. Se dice que actualmente está guiando a una tropa de exploradores hacia los confines más remotos del mundo.}"
    }
    // en = "%name% departed the %companyname% and continued his adventuring elsewhere. \x7bHe headed east, hoping to discover the source of the greenskins, but the nobleman has not been heard from since. | He headed north into the snowy wastes. Word has it he was seen a week ago, marching south this time, looking rather pale and shuffling moreso than walking. | He headed south into brutal marshlands. Word has it that a mysterious flame appeared in the fog and he walked toward it. The men who saw this said he disappeared into the mist and never returned. | He headed west and sailed the open sea. Despite having no experience at sea, he saw fit to make himself captain of the boat. They say pieces of his ship and dead sailors kept washing ashore for weeks.\x7d"
    // en base_es
    // context: legend_noble_background.onBuildDescription
    {
        en = "{A viscount of the realm | As the third in the line of the noble retinue | A young and brash noble | A skilled swordsman}, %name%'s life at court {had grown stale for him | was not exciting enough for him with endless studying of tactics and strategy | felt like wasting the best time of his life | was not half as exciting to him as the tales of adventures, battles, fearsome beasts to vanquish and fair maidens to conquer}. {Wearing the house crest proudly | At the encouragement of his brother | To the frustration of his mother | Finally making a decision to change things}, %name% rode out to {prove himself | make a name for himself | earn glory on the battlefield | test his skills in battle} and {live life to its fullest as he imagined it from behind the castle walls | see all the wonders and exotic places of the world | earn his place in the world | be knighted for his valor | become famous and loved in all the known world | become infamous and feared in all the known world}."
        es = "{Vizconde del reino | Tercero en la línea sucesoria de su casa noble | Noble joven e impetuoso | Espadachín habilidoso}, %name% sentía que la vida en la corte {se le había vuelto rancia | no era lo bastante emocionante, con el interminable estudio de tácticas y estrategias | era desperdiciar los mejores años de su vida | no era ni la mitad de emocionante que los relatos de aventuras, batallas, bestias temibles que vencer y bellas doncellas que conquistar}. {Luciendo con orgullo el blasón de su casa | Animado por su hermano | Para frustración de su madre | Decidido por fin a cambiar las cosas}, %name% partió a caballo para {demostrar su valía | hacerse un nombre | ganar gloria en el campo de batalla | poner a prueba su destreza en combate} y {vivir la vida al máximo, tal como la imaginaba tras los muros del castillo | ver todas las maravillas y lugares exóticos del mundo | ganarse su lugar en el mundo | ser armado caballero por su valor | hacerse famoso y querido en todo el mundo conocido | hacerse infame y temido en todo el mundo conocido}."
    }
    // FILE: scripts\skills\backgrounds\legend_noble_commander_background.nut
    // context: legend_noble_commander_background.create.m.Name
    {
        en = "Noble Usurper"
        es = "Noble usurpador"
    }
    // context: legend_noble_commander_background.create.m.BackgroundDescription
    {
        en = "A noble with a birthright claim to authority"
        es = "Noble de cuna, con derecho de nacimiento a ejercer autoridad"
    }
    // context: legend_noble_commander_background.setGender.m.GoodEnding
    {
        en = "Adventurousness never leaves the soul of a woman like %name%. {Instead of returning to the armed services, she left the %companyname% and headed east in search of rare beasts. Word has it she returned to town with the head of what looked like a giant lizard, but you don't believe such fantastical tripe. | She departed the %companyname% and ventured west, sailing across the oceans to unseen lands. There's no telling where she is these days, but you've little doubt that she'll be coming back with stories to tell. | She retired from the %companyname% and, instead of returning to her noble family, headed south. Word has it she fought in a great noble civil war, killed an orc warlord, climbed the highest mountain in the land, and is currently writing an epic about his travels. | The noblewoman left the %companyname% and, preferring the life of adventure to noble boredom, she headed north. Word has it that she's currently marching a troop of explorers to the furthest reaches of the world.}"
        es = "El espíritu aventurero nunca abandona el alma de una mujer como %name%. {En lugar de volver al servicio de armas, dejó %companyname% y se dirigió al este en busca de bestias raras. Se rumorea que volvió a la ciudad con la cabeza de lo que parecía un lagarto gigante, pero no te crees semejantes patrañas fantasiosas. | Se marchó de %companyname% y se aventuró hacia el oeste, cruzando los océanos hacia tierras ignotas. No hay forma de saber dónde está hoy en día, pero tienes pocas dudas de que volverá con historias que contar. | Se retiró de %companyname% y, en lugar de volver con su noble familia, se dirigió al sur. Se rumorea que luchó en una gran guerra civil entre nobles, mató a un caudillo orco, escaló la montaña más alta del país y que actualmente está escribiendo una epopeya sobre sus viajes. | La noble dejó %companyname% y, prefiriendo la vida de aventuras al aburrimiento de la nobleza, se dirigió al norte. Se rumorea que actualmente encabeza una expedición de exploradores hacia los confines más lejanos del mundo.}"
    }
    // context: legend_noble_commander_background.setGender.m.BadEnding
    {
        // corrige base: «shuffling» es arrastrar los pies, no tambalearse; «luciendo pálido» es calco y pierde el «rather» («con aspecto bastante pálido»).
        // corrige base: «into the snowy wastes» e «into brutal marshlands» indican dirección («hacia»), no «en medio de» ni «en».
        en = "%name% departed the %companyname% and continued his adventuring elsewhere. {She headed east, hoping to discover the source of the greenskins, but the noblewoman has not been heard from since. | She headed north into the snowy wastes. Word has it she was seen a week ago, marching south this time, looking rather pale and shuffling moreso than walking. | She headed south into brutal marshlands. Word has it that a mysterious flame appeared in the fog and she walked toward it. The men who saw this said she disappeared into the mist and never returned. | She headed west and sailed the open sea. Despite having no experience at sea, she saw fit to make herself captain of the boat. They say pieces of her ship and dead sailors kept washing ashore for weeks.}"
        es = "%name% dejó %companyname% y continuó sus aventuras en otro lugar. {Se dirigió al este, esperando descubrir el origen de los pieles verdes, pero no se ha sabido nada de la noble desde entonces. | Se dirigió al norte, hacia los páramos nevados. Se rumorea que la vieron hace una semana, marchando hacia el sur esta vez, con aspecto bastante pálido y arrastrando los pies más que caminando. | Se dirigió al sur, hacia unas brutales tierras pantanosas. Se dice que una misteriosa llama apareció en la niebla y que ella fue a su encuentro. Los hombres que lo vieron dijeron que desapareció en la bruma y nunca regresó. | Se dirigió al oeste y navegó por el mar abierto. A pesar de no tener experiencia en el mar, consideró oportuno nombrarse capitana del barco. Dicen que durante semanas siguieron llegando a la orilla pedazos de su barco y marineros muertos.}"
    }
    // context: legend_noble_commander_background.onBuildDescription
    {
        // return playerCharacter + "{A viscountess of the realm | As the third in the line of succession | A young and brash noble | A skilled swordswoman}, %name%\'s life at court {had grown stale for her | was not exciting enough for her with endless studying of court etiquette and family lineage | felt like wasting the best time of her life | was not half as exciting to her as the tales of adventures, battles, fearsome beasts to vanquish and fair maidens to conquer}. {Wearing the family crest proudly | At the encouragement of her brother | To the frustration of her mother | Finally making a decision to change things}, %name% rode out to {prove herself | make a name for herself | earn glory on the battlefield | test her skills in battle} and {live life to its fullest as she imagined it from behind the castle walls | see all the wonders and exotic places of the world | earn her place in the world | be knighted for her valor | become famous and loved in all the known world | become infamous and feared in all the known world}.";
        mode = "pattern"
        en = "<playerCharacter:str>{A viscountess of the realm | As the third in the line of succession | A young and brash noble | A skilled swordswoman}, %name%'s life at court {had grown stale for her | was not exciting enough for her with endless studying of court etiquette and family lineage | felt like wasting the best time of her life | was not half as exciting to her as the tales of adventures, battles, fearsome beasts to vanquish and fair maidens to conquer}. {Wearing the family crest proudly | At the encouragement of her brother | To the frustration of her mother | Finally making a decision to change things}, %name% rode out to {prove herself | make a name for herself | earn glory on the battlefield | test her skills in battle} and {live life to its fullest as she imagined it from behind the castle walls | see all the wonders and exotic places of the world | earn her place in the world | be knighted for her valor | become famous and loved in all the known world | become infamous and feared in all the known world}."
        es = "<playerCharacter>{Vizcondesa del reino | Tercera en la línea de sucesión | Noble joven e impetuosa | Hábil espadachina}, %name% {se había hartado de la vida en la corte | no encontraba suficiente emoción en la vida cortesana, con su interminable estudio de la etiqueta y los linajes familiares | sentía que en la corte desperdiciaba los mejores años de su vida | no encontraba en la vida cortesana ni la mitad de la emoción de los relatos de aventuras, batallas, bestias temibles que derrotar y bellas doncellas que conquistar}. {Portando con orgullo el blasón familiar | Animada por su hermano | Para frustración de su madre | Decidida por fin a cambiar las cosas}, %name% partió a caballo para {demostrar su valía | hacerse un nombre | ganar gloria en el campo de batalla | poner a prueba su destreza en combate} y {vivir la vida al máximo, tal como la imaginaba tras los muros del castillo | ver todas las maravillas y lugares exóticos del mundo | ganarse un lugar en el mundo | recibir el título de caballero por su valor | volverse famosa y querida en todo el mundo conocido | volverse infame y temida en todo el mundo conocido}."
    }
    // context: legend_noble_commander_background.onBuildDescription
    {
        // return playerCharacter + "{A viscount of the realm | As the third in the line of succession | A young and brash noble | A skilled swordsman}, %name%\'s life at court {had grown stale for him | was not exciting enough for him with endless studying of court etiquette and family lineage | felt like wasting the best time of his life | was not half as exciting to him as the tales of adventures, battles, fearsome beasts to vanquish and fair maidens to conquer}. {Wearing the family crest proudly | At the encouragement of his brother | To the frustration of his mother | Finally making a decision to change things}, %name% rode out to {prove himself | make a name for himself | earn glory on the battlefield | test his skills in battle} and {live life to its fullest as he imagined it from behind the castle walls | see all the wonders and exotic places of the world | earn his place in the world | be knighted for his valor | become famous and loved in all the known world | become infamous and feared in all the known world}.";
        mode = "pattern"
        en = "<playerCharacter:str>{A viscount of the realm | As the third in the line of succession | A young and brash noble | A skilled swordsman}, %name%'s life at court {had grown stale for him | was not exciting enough for him with endless studying of court etiquette and family lineage | felt like wasting the best time of his life | was not half as exciting to him as the tales of adventures, battles, fearsome beasts to vanquish and fair maidens to conquer}. {Wearing the family crest proudly | At the encouragement of his brother | To the frustration of his mother | Finally making a decision to change things}, %name% rode out to {prove himself | make a name for himself | earn glory on the battlefield | test his skills in battle} and {live life to its fullest as he imagined it from behind the castle walls | see all the wonders and exotic places of the world | earn his place in the world | be knighted for his valor | become famous and loved in all the known world | become infamous and feared in all the known world}."
        es = "<playerCharacter>{Vizconde del reino | Tercero en la línea de sucesión | Noble joven e impetuoso | Hábil espadachín}, %name% {se había hartado de la vida en la corte | no encontraba suficiente emoción en la vida cortesana, con su interminable estudio de la etiqueta y los linajes familiares | sentía que en la corte desperdiciaba los mejores años de su vida | no encontraba en la vida cortesana ni la mitad de la emoción de los relatos de aventuras, batallas, bestias temibles que derrotar y bellas doncellas que conquistar}. {Portando con orgullo el blasón familiar | Animado por su hermano | Para frustración de su madre | Decidido por fin a cambiar las cosas}, %name% partió a caballo para {demostrar su valía | hacerse un nombre | ganar gloria en el campo de batalla | poner a prueba su destreza en combate} y {vivir la vida al máximo, tal como la imaginaba tras los muros del castillo | ver todas las maravillas y lugares exóticos del mundo | ganarse un lugar en el mundo | recibir el título de caballero por su valor | volverse famoso y querido en todo el mundo conocido | volverse infame y temido en todo el mundo conocido}."
    }
    // FILE: scripts\skills\backgrounds\legend_noble_ranged.nut
    // context: legend_noble_ranged.create.m.GoodEnding
    {
        en = "He supported you from the start, %name%, and he was with you in retirement, leaving the company not long after you did. But he wasn't yet done with the fighting life and took up fighting for another company - his own. Having learned so much from your leadership, he is making you about as proud as any son could. Ironically, he hates the notion of you being a father figure to him, and you always tell him you'd never father a son so ugly to begin with. You keep in touch to this day."
        es = "%name% te apoyó desde el principio y te acompañó también en el retiro, pues dejó la compañía poco después que tú. Pero aún no había terminado con la vida de combate y volvió a luchar para otra compañía: la suya propia. Tras aprender tanto de tu liderazgo, te enorgullece casi tanto como podría hacerlo cualquier hijo. Irónicamente, odia la idea de que seas una figura paterna en su vida, y tú siempre le dices que, para empezar, jamás habrías engendrado un hijo tan feo. Siguen en contacto hasta el día de hoy."
    }
    // context: legend_noble_ranged.create.m.BadEnding
    {
        en = "Supporting you from the start, %name% was as loyal as he was talented. He stayed with the company for a time before eventually leaving to forge out a path for himself. The other day, you received a letter from the mercenary stating that he had started his own company and was in dire need of help. Unfortunately, the message was dated to nearly a full year ago. When you investigated the existence of his company, you learned that it had been completely annihilated in a battle between nobles."
        es = "%name%, que te apoyó desde el principio, tenía tanta lealtad como talento. Permaneció en la compañía un tiempo antes de acabar marchándose para abrirse su propio camino. Hace unos días recibiste una carta suya en la que decía que había fundado su propia compañía y que necesitaba ayuda con urgencia. Por desgracia, el mensaje estaba fechado casi un año atrás. Cuando averiguaste qué había sido de su compañía, supiste que había sido aniquilada por completo en una batalla entre nobles."
    }
    // context: legend_noble_ranged.onBuildDescription
    {
        // corrige base: «charging» es cargar contra alguien, no acercarse («que cargaban contra él»).
        // corrige base: «tiene un cariño por matar» es calco agramatical de «has a fondness for»; va «le gusta matar».
        // corrige base: «Aprender acerca de este hombre» calca «learning of the man», que aquí es dar con él («Dar con este hombre»).
        en = "%name% is one of the more talented markswoman you've encountered in your travels. {After she saved your life with an arrow into the heart of a would-be assassin, you hired the woman on the spot. | Learning of the woman was easy - you just had to find the winner of a local shooting competition. | She once won an archery contest that had over a hundred participants from all the lands. | It is said that she can split an arrow - mid-flight. | You found the woman on a farm where, obviously, you thought her shooting talents were going to waste. | A poacher, a bowyer, an archer, the woman's skills have gotten plenty of use. You suspect she readily accepted your offer for mercenary work just to say 'she's done it all'. | You once saw her shoot the moon, but that may have been some sort of trick. | A clever bowman, she once loosed two arrows simultaneously to kill a charging set of brigands.} While she has a fondness for killing from afar, %name%'s no slouch in close-quarters combat."
        es = "%name% es una de las tiradoras más talentosas que has encontrado en tus viajes. {Después de que te salvara la vida clavándole una flecha en el corazón a un aspirante a asesino, la contrataste en el acto. | Dar con esta mujer fue fácil: solo tuviste que buscar a la ganadora de un concurso de tiro local. | Una vez ganó un concurso de tiro con arco con más de cien participantes de todas las tierras. | Se dice que puede partir una flecha en pleno vuelo. | Encontraste a la mujer en una granja donde, evidentemente, pensaste que su talento para el tiro se estaba desperdiciando. | Cazadora furtiva, fabricante de arcos, arquera: las habilidades de esta mujer han tenido mucho uso. Sospechas que aceptó de buen grado tu oferta de trabajo como mercenaria solo para poder decir que 'lo ha hecho todo'. | Una vez la viste dispararle a la luna, pero puede que fuera algún tipo de truco. | Arquera astuta, una vez soltó dos flechas a la vez para matar a un grupo de bandidos que cargaba contra ella.} Aunque le gusta matar desde lejos, %name% no se queda atrás en el combate cuerpo a cuerpo."
    }
    // FILE: scripts\skills\backgrounds\legend_noble_shield.nut
    // context: legend_noble_shield.create.m.Name
    {
        en = "Foot Soldier"
        es = "Soldado de infantería"
    }
    // context: legend_noble_shield.create.m.GoodEnding
    {
        en = "He supported you from the start, %name%, and he was with you in retirement, leaving the company not long after you did. Though he was a lowly peasant, he proved himself in battle after battle and slowly became as trusted and valued a friend as one can have in a mercenary company."
        es = "%name% te apoyó desde el principio y te acompañó también en el retiro, pues dejó la compañía poco después que tú. Pese a su humilde origen campesino, demostró su valía batalla tras batalla y, poco a poco, llegó a ser una amistad tan fiable y valiosa como la que más en una compañía de mercenarios."
    }
    // context: legend_noble_shield.onBuildDescription
    {
        en = "%name% is not known to be a big talker, but she has every right to be. {She's saved the lives of many of the company. | She once spared you from an orc's wicked chain. | An assassin would have killed the local noble in a pub were it not for this woman. | A misfired crossbow nearly took out your eye - hadn't %name%'s shield been there to stop it. | She once pushed two men off a cliff using only her shield and two strong legs. | She learned how to fight from her father, a vanguard at the Battle of Many Names. | Sacrificing her family's heirloom - an old shield of wood and studded iron - she saved the local noble's life. | A woman of rather consistent heroism, she pulled a drunken captain from a pub fire. | Faced with a horde of goblins, she used her shield and strength to push a hole in their lines, opening the way for the rest of her company to kill them all.} With quick whirls and whips of her shield, the woman's deflected all manner of mortal danger. Although rather quiet, you've found %name%'s place in a shield-wall to be rather indispensable."
        es = "%name% no tiene fama de hablar mucho, aunque tendría todo el derecho a presumir. {Ha salvado la vida de muchos en la compañía. | Una vez te libró de la cruel cadena de un orco. | Un asesino habría matado al noble local en una taberna de no ser por esta mujer. | Una ballesta disparada por error casi te saca un ojo, y lo habría hecho de no ser por el escudo de %name%, que estaba allí para detener el virote. | Una vez empujó a dos hombres por un precipicio usando solo su escudo y sus dos fuertes piernas. | Aprendió a luchar de su padre, que combatió en la vanguardia en la Batalla de los Muchos Nombres. | Sacrificando la reliquia de su familia, un viejo escudo de madera tachonado de hierro, salvó la vida del noble local. | Mujer de un heroísmo bastante constante, sacó a un capitán borracho de una taberna en llamas. | Frente a una horda de goblins, usó su escudo y su fuerza para abrir una brecha en sus líneas, despejando el camino para que el resto de su compañía los matara a todos.} Con rápidos giros y golpes de escudo, esta mujer ha desviado toda clase de peligros mortales. Aunque es bastante callada, te ha parecido que el puesto de %name% en el muro de escudos es prácticamente indispensable."
    }
    // context: legend_noble_shield.onBuildDescription
    {
        en = "%name% is not known to be a big talker, but he has every right to be. {He's saved the lives of many of the company. | He once spared you from an orc's wicked chain. | An assassin would have killed the local noble in a pub were it not for this man. | A misfired crossbow nearly took out your eye - hadn't %name%'s shield been there to stop it. | He once pushed two men off a cliff using only his shield and two strong legs. | He learned how to fight from his father, a vanguard at the Battle of Many Names. | Sacrificing his family's heirloom - an old shield of wood and studded iron - he saved the local noble's life. | A man of rather consistent heroism, he pulled a drunken captain from a pub fire. | Faced with a horde of goblins, he used his shield and strength to push a hole in their lines, opening the way for the rest of her company to kill them all.} With quick whirls and whips of his shield, the man's deflected all manner of mortal danger. Although rather quiet, you've found %name%'s place in a shield-wall to be rather indispensable."
        es = "%name% no tiene fama de hablar mucho, aunque tendría todo el derecho a presumir. {Ha salvado la vida de muchos en la compañía. | Una vez te libró de la cruel cadena de un orco. | Un asesino habría matado al noble local en una taberna de no ser por este hombre. | Una ballesta disparada por error casi te saca un ojo, y lo habría hecho de no ser por el escudo de %name%, que estaba allí para detener el virote. | Una vez empujó a dos hombres por un precipicio usando solo su escudo y sus dos fuertes piernas. | Aprendió a luchar de su padre, que combatió en la vanguardia en la Batalla de los Muchos Nombres. | Sacrificando la reliquia de su familia, un viejo escudo de madera tachonado de hierro, salvó la vida del noble local. | Hombre de un heroísmo bastante constante, sacó a un capitán borracho de una taberna en llamas. | Frente a una horda de goblins, usó su escudo y su fuerza para abrir una brecha en sus líneas, despejando el camino para que el resto de su compañía los matara a todos.} Con rápidos giros y golpes de escudo, este hombre ha desviado toda clase de peligros mortales. Aunque es bastante callado, te ha parecido que el puesto de %name% en el muro de escudos es prácticamente indispensable."
    }
    // FILE: scripts\skills\backgrounds\legend_peddler_commander_background.nut
    // context: legend_peddler_commander_background.create.m.Name
    {
        en = "Merchant"
        es = "Mercader"
    }
    // context: legend_peddler_commander_background.create.m.BackgroundDescription
    {
        en = "Merchants were held in high regard and powerful people, they could bankroll armies or buy entire estates if they had the reason to do so."
        es = "Los mercaderes eran gente poderosa y muy respetada: podían financiar ejércitos o comprar fincas enteras si tenían motivos para ello."
    }
    // context: legend_peddler_commander_background.onBuildDescription
    {
        en = "{After an exchange gone bad, | Once a proud noble, now | Well read and learned, | In tough times, humanity has a habit of falling to pieces when they need to be together most, hence} %name% now roams the land buying and selling what they can. {More honest than most of their kind | Persisent but kind | Trying to hide from their past | A purveyor of exotic goods | After getting into the business selling {used weapons | wine | trinkets}} {, they prefer to be known as a merchant - not a desperate peddler. Even if an unhealthy lifestyle has caught up with them in the meantime. | , they prefer to be known as someone who is trying their best to get by in an uncaring world | , %name% moves from place to place, possibly for good reasons they'd rather not discuss in the open. Or at all.}"
        es = "{Tras un trato que salió mal, | Antaño parte de la orgullosa nobleza, | Con muchas lecturas y estudios a sus espaldas, | En tiempos difíciles, la humanidad suele desmoronarse justo cuando más necesita mantenerse unida; por eso,} %name% recorre ahora estas tierras comprando y vendiendo lo que puede. {Con más honradez que la mayoría de su gremio | Con tanta insistencia como amabilidad | Intentando esconderse de su pasado | Dedicándose a las mercancías exóticas | Desde que se metió en el negocio de vender {armas usadas | vino | baratijas}}{, prefiere que se le tenga por mercader, y no por quien vende de puerta en puerta por pura desesperación. Aunque, entretanto, una vida poco saludable le haya pasado factura. | , prefiere que se le vea como alguien que hace lo que puede por salir adelante en un mundo indiferente. | , %name% va de un lugar a otro, quizá por buenas razones de las que prefiere no hablar abiertamente. O de las que prefiere no hablar en absoluto.}"
    }
    // FILE: scripts\skills\backgrounds\legend_philosopher_background.nut
    // context: legend_philosopher_background.create.m.Name
    {
        en = "Philosopher"
        es = "Filósofo"
    }
    // context: legend_philosopher_background.create.m.Titles
    {
        en = "the Philosopher"
        es = "el Filósofo"
    }
    // context: legend_philosopher_background.onBuildDescription
    {
        en = "{There is no description Mwah doesn't have any real thoughts in his head unlike this super cool philosopher. Please understand!}"
        es = "{No hay descripción. Mwah no tiene ni una sola idea de verdad en la cabeza, a diferencia de esta eminencia filosófica supergenial. ¡Compréndelo, por favor!}"
    }
    // FILE: scripts\skills\backgrounds\legend_pilgrim_background.nut
    // context: legend_pilgrim_background.create.m.Name
    {
        en = "Pilgrim"
        es = "Peregrino"
    }
    // context: legend_pilgrim_background.create.m.BackgroundDescription
    {
        en = "Dirty and tired, these disciples of the old gods look for clarity and power in their teachings."
        es = "Sucios y cansados, estos discípulos de los viejos dioses buscan claridad y poder en sus enseñanzas."
    }
    // context: legend_pilgrim_background.create.m.GoodEnding
    {
        en = "%name% began %their% journey with you as a victim of circumstance, at odds with the rest of the world in %their% newfound predicament. Although they were not paid much %name% continued to spread your teachings to all who would listen. Seasons from then %they% would join the same holy order after it's monastery was burned down, setting out with like minded companions as a crusader."
        es = "%name% empezó su viaje contigo como víctima de las circunstancias, en conflicto con el resto del mundo por su nueva situación. Aunque no se le pagaba mucho, %name% siguió difundiendo tus enseñanzas a todo el que quisiera escuchar. Al cabo de unas estaciones se uniría a esa misma orden sagrada después de que incendiaran su monasterio, y partiría como cruzad%o% junto a compañeros de ideas afines."
    }
    // context: legend_pilgrim_background.create.m.BadEnding
    {
        en = "With your retirement from the company, %name% set out to spread the word of your teachings. Many did not take kindly to %their% words and often found %themselves% driven out of towns and into the wilderness. After one such instance %name% took shelter in an abandoned crypt, which quickly turned out to not be abandoned at all..."
        es = "Tras tu retiro de la compañía, %name% partió para difundir tus enseñanzas. Muchos no recibieron bien sus palabras, y a menudo acababa expulsad%o% de los pueblos y empujad%o% hacia las tierras salvajes. Tras uno de esos episodios, %name% se refugió en una cripta abandonada que, muy pronto, resultó no estar abandonada en absoluto..."
    }
    // context: legend_pilgrim_background.create.m.Titles
    {
        en = "the Holy"
        es = "el Santo"
    }
    // context: legend_pilgrim_background.create.m.Titles
    {
        en = "the Martyr"
        es = "el Mártir"
    }
    // context: legend_pilgrim_background.create.m.Titles
    {
        en = "the Devout"
        es = "el Devoto"
    }
    // context: legend_pilgrim_background.create.m.Titles
    {
        en = "the Zealous"
        es = "el Fervoroso"
    }
    // context: legend_pilgrim_background.getTooltip.ret.push().text
    {
        en = "No morale check triggered for non-pilgrim allies upon dying"
        es = "Su muerte no provoca chequeos de moral en los aliados que no sean peregrinos"
    }
    // context: legend_pilgrim_background.onBuildDescription
    {
        en = "{%name% has walked long and hard to almost all the holy sites. | As a shepherd's wife of a rural farm out in the hinterlands, %name% often dealt with trepassers. One day a budding necromancer and his three apprentices took the farm for herself. Her husband was slain and still wanders someplace between the world of the living and the dead. Ever since %name% has been looking for a way to avenge her husband's death and purge the land of the undead. | A fight with an innkeeper over the rates that they were charging for beds quickly escalated into a brawl. After the the night watch broke up and took all of %name%'s crowns for 'services', they did what they could to find safe passage to her last designation. Thats where you come in. | A northerner with a hefty and well known family name marked %name% as a target the moment they set foot on the road alone with little more than a staff and good intentions. Bandits quickly descended upon her. Without passes and forms to prove her status as a pilgrim %name% had all but given up hope of ever getting out on the road again. | %name% talks at great lengths about her vocation as a missionary and woman of god. However a large stash of valubles they accumulate leads to to believe something more sinister is afoot.}"
        es = "{%name% ha caminado largo y tendido hasta casi todos los lugares sagrados. | Como esposa de un pastor en una granja perdida en las tierras remotas, %name% solía lidiar con intrusos. Un día, un nigromante en ciernes y sus tres aprendices se apoderaron de la granja. Su marido fue asesinado y aún vaga en algún lugar entre el mundo de los vivos y el de los muertos. Desde entonces, %name% busca la manera de vengar la muerte de su marido y purgar la tierra de no muertos. | Una discusión con un posadero sobre lo que cobraba por las camas no tardó en convertirse en una pelea. Después de que la guardia nocturna pusiera fin a la trifulca y se quedara con todas las coronas de %name% en concepto de 'servicios', ella hizo lo que pudo por encontrar un paso seguro hasta su último destino. Ahí es donde entras tú. | Ser norteña y llevar un apellido de peso y bien conocido convirtió a %name% en un blanco en cuanto pisó el camino a solas, con poco más que un bastón y buenas intenciones. Los bandidos no tardaron en caer sobre ella. Sin salvoconductos ni papeles que acreditaran su condición de peregrina, %name% casi había perdido la esperanza de volver a recorrer los caminos. | %name% habla largo y tendido de su vocación como misionera y mujer de dios. Sin embargo, el gran alijo de objetos de valor que acumula te lleva a pensar que se trama algo más siniestro.}"
    }
    // context: legend_pilgrim_background.onBuildDescription
    {
        en = "{%name% has walked long and hard to almost all the holy sites. | As a farmhand in an orchard around the border towns of the south and north %name% lived a peaceful life until a throng of anicent dead swept through the village and burnt everything to the ground. Ever since a fire has burned in his heart to clean the land of the dead that still walk the earth. | Once a billman in service to a local lord, %name% quickly fell out of service when said lord was drowned in the river by an angry mob. Now with a target painted on his back, %name% tries to blend in to the crowd as a pilgrim. They say they always wanted to give 'this holy lark' a 'fair shake' anyway. | Born a bastard to a local lord, %name% lived most of his life in the countryside as a farmhand. One day a messanger arrived, escorted by a dozen or so footmen 'requesting' that they come pay respects to a new lord of the land. Sensing a trap %name% made a break for it and spends his time far away from the nobility as possible. | %name% is lucky to be alive, if the tales are true then they are one of the few survivors of a small hamlet in the north swarming with undead. A local necromancer has since seized the hamlet for himself. Wanting to do more and reclaim his home, he now searches for the wisdom of the old gods to fight back.}"
        es = "{%name% ha caminado largo y tendido hasta casi todos los lugares sagrados. | Como jornalero en un huerto de frutales cerca de los pueblos fronterizos entre el sur y el norte, %name% llevaba una vida tranquila hasta que una multitud de muertos antiguos arrasó la aldea y la redujo a cenizas. Desde entonces arde en su corazón un fuego por limpiar la tierra de los muertos que aún caminan por ella. | Antes piquero al servicio de un señor local, %name% se quedó rápidamente sin empleo cuando una turba furiosa ahogó a dicho señor en el río. Ahora, con una diana pintada en la espalda, %name% intenta pasar desapercibido entre la multitud como peregrino. Dice que, de todos modos, siempre quiso darle una 'oportunidad justa' a 'esto de la santidad'. | Hijo bastardo de un señor local, %name% pasó la mayor parte de su vida en el campo como jornalero. Un día llegó un mensajero, escoltado por una docena de soldados de a pie, 'solicitando' que fuera a presentar sus respetos al nuevo señor de aquellas tierras. Oliéndose una trampa, %name% puso pies en polvorosa y desde entonces pasa el tiempo lo más lejos posible de la nobleza. | %name% tiene suerte de seguir con vida: si las historias son ciertas, es uno de los pocos supervivientes de una pequeña aldea del norte infestada de no muertos. Desde entonces, un nigromante de la zona se ha apoderado de ella. Con ganas de hacer más y recuperar su hogar, ahora busca la sabiduría de los viejos dioses para contraatacar.}"
    }
    // FILE: scripts\skills\backgrounds\legend_premonitionist_background.nut
    // context: legend_premonitionist_background.create.m.Name
    {
        en = "Premonitionist"
        es = "Agorero"
    }
    // context: legend_premonitionist_background.onBuildDescription
    {
        en = "{Mwah has absolutely 0 flavor text creation ability. Please understand how sick this super cool premonitionist is while you have your tarot reading!}"
        es = "{Mwah tiene una capacidad absolutamente nula para escribir textos de ambientación. ¡Por favor, comprende lo genial que es esta eminencia vidente mientras te lee el tarot!}"
    }
    // FILE: scripts\skills\backgrounds\legend_preserver_background.nut
    // context: legend_preserver_background.create.m.Name
    {
        en = "Preserver"
        es = "Preservador"
    }
    // context: legend_preserver_background.create.m.BackgroundDescription
    {
        en = "Preservers practice the art of anatomy over resurrection - taking a more scientific approach to how dead things work."
        es = "Los preservadores practican el arte de la anatomía antes que el de la resurrección y abordan con un enfoque más científico el funcionamiento de las cosas muertas."
    }
    // context: legend_preserver_background.create.m.GoodEnding
    {
        en = "As time went on, %name% found work not too far from where they once grew up. The local village needed a new herbalist to heal the sick and tend to the wounded coming back from the wars. %name% occasionally recognised some of the casualties that ended up in her hut as a few of those who got away in the past. Thankfully they did not have the same attention to detail."
        es = "Con el paso del tiempo, %name% encontró trabajo no muy lejos de donde se había criado. La aldea del lugar necesitaba una nueva herbolaria para curar a los enfermos y atender a los heridos que volvían de las guerras. De vez en cuando, %name% reconocía entre las víctimas que acababan en su choza a algunos de los que se le habían escapado en el pasado. Por suerte, ellos no tenían la misma atención al detalle."
    }
    // context: legend_preserver_background.create.m.BadEnding
    {
        en = "%name% continued to move with the company for some time. As time went on their interest in the sciences around the dead shifted more from the living and further towards the dead. Living in a graveyard with a few puppets for company, %name% was eventually subdued and burnt at the stake by a mercenary company sent to clear the graveyard."
        es = "%name% siguió viajando con la compañía durante un tiempo. Con los años, su interés por las ciencias de la muerte se fue apartando de los vivos y desplazándose cada vez más hacia los muertos. Tras vivir en un cementerio con unas cuantas marionetas por toda compañía, %name% terminó en la hoguera después de que una compañía de mercenarios enviada a limpiar el cementerio acabara con su resistencia."
    }
    // context: legend_preserver_background.onBuildDescription
    {
        en = "{After being raised as a peasant girl in a backwater town, %name% took a shine to gathering herbs with their mother. | %name% did not get far in later life, often failing to gather what was asked of her by local herbalists. | %name% became more interested in how to kill rather than heal, which lead to them being run out of the village as a young girl after exhuming a fresh grave. | %name% wandered far and wide, often around %randomtown% until they had an outbreak of living dead from the nearby graveyard. | After being led into the forest and left to die by her parents, %name% found a local Hexe hiding amonst the ruins of an old hut. The tale goes that %name% slew the hag by pushing her into her own boiling pot. Like anyone would believe that.} {Regardless of their path, all roads led to %name% discovering a lone necromancer on the road. Who offered to take her in and teach her how to reach her full potential.}"
        es = "{Tras criarse como campesina en un pueblucho perdido, %name% le tomó el gusto a recoger hierbas con su madre. | %name% no llegó muy lejos en la vida adulta, pues a menudo no conseguía recolectar lo que le pedían los herbolarios del lugar. | %name% empezó a interesarse más por cómo matar que por cómo curar, lo que hizo que, siendo apenas una muchacha, la echaran de la aldea tras exhumar una tumba reciente. | %name% vagó por todas partes, sobre todo por los alrededores de %randomtown%, hasta que se produjo un brote de muertos vivientes en el cementerio cercano. | Después de que sus padres la llevaran al bosque y la abandonaran a su suerte, %name% encontró a una Hexe escondida entre las ruinas de una vieja choza. Cuenta la historia que %name% mató a la bruja empujándola a su propia olla hirviendo. Como si alguien fuera a creérselo.} {Fuera cual fuera su senda, todos los caminos llevaron a %name% a toparse con un nigromante solitario, que se ofreció a acogerla y a enseñarle a desarrollar todo su potencial.}"
    }
    // FILE: scripts\skills\backgrounds\legend_puppet_background.nut
    // context: legend_puppet_background.create.m.Name
    {
        en = "Puppet"
        es = "Marioneta"
    }
    // context: legend_puppet_background.create.m.BackgroundDescription
    {
        en = "A corpse in varying forms of decay. While slow on the uptake, it makes for a frightening opponent to most. You can also pick any name you like!"
        es = "Un cadáver en diversos estados de descomposición. Aunque es algo corto de entendederas, resulta un rival aterrador para la mayoría. ¡Además, puedes ponerle el nombre que quieras!"
    }
    // context: legend_puppet_background.create.m.GoodEnding
    {
        en = "There is no beginning or end for %name%. Like any feral animal %they% simply wander around - occasionally following hordes of like minded dead, being adopted by a new master and slain, only to get back up again and wander some more. %name% repeats this cycle until one day the blow will be fatal. Is this a curse of a blessing? To cheat death is such a manner many would kill for. But %name% does not care. There is only hunger."
        es = "Para %name% no hay principio ni final. Como cualquier animal salvaje, simplemente deambula: de vez en cuando sigue a hordas de muertos con sus mismas inclinaciones, es adoptad%o% por un nuevo amo y abatid%o%, solo para volver a levantarse y seguir deambulando. %name% repite este ciclo hasta que, algún día, el golpe sea definitivo. ¿Es esto una maldición o una bendición? Muchos matarían por burlar a la muerte de esa manera. Pero a %name% no le importa. Solo hay hambre."
    }
    // context: legend_puppet_background.onBuildDescription
    {
        en = "{Where %name% comes from is a mystery - %their% original name has been lost to time or washed away on an ancient gravestone far, far away. | Who this creature one was matters little. %They% serve and obey. That is all that matters. | This one is marked with cuts and nail marks, and still surprisingly fresh. | Come rain, snow or sandstorm %name% happily goes where %they% please. A truely free soul in a world of toil and dispair. If the world had more people like %name%, it would be a much better place. | This one is marked with stab wounds and cuts across %their% whole body. Many of which seem ancient in origin. | %name% is marked with wounds, many of which are fatal but have been carefully stitched shut or cauterized - suggesting that at some point, someone cared for this poor fark after death. Who the caretaker was will forever be a mystery however. | This one seems a little older than most, with barely any forms of battle damage across its carcass. Maybe this one died in a peaceful manner? Such things are rare in this world. | This one bares little evidence of a violent death, save for the noose marks around its throat. | With the rampant war and famile across the land, corpses like %name% turn up in droves these days. Mass graves remain uncovered, graveyards barely watched over. Perfect marketplaces to hone the dark arts. | The war of many names created a treaure trove of unliving recruits for necromancers. %name% is one such product of the conflict, seeminly a little more astute and reactive to orders than the average corpse - not that expectations are set very high or anything... | This one was bound and thrown into a river, however the main cause of death seems to be the dozens of arrows pocked across its body. The work of poachers, bored brigands or a vengeful feud come to an end.}{ Don't let the exterior fool you, when fresh game is involved %name% acts with sudden alacrity unbecoming %their% form. | The presence of anything living will drive this animal into a frenzy, no matter the size. | This corpse also comes with a small satchel of rusted coins, which are going to waste in %their% current state. You are sure it won't miss %them% anyway... | %name% lazily swings a rusted shortsword around as %they% plod aimlessly. | %name% is a fitting name, don't you think? It captures the struggle of this creature well. | While undead, these creatures are more like wild animals than brutal killers. | You poke %name% on what remains of its arm. It turns to look at you, then moves past you to chase a stray dog. You like this one. | %name% is still covered in clods of earth, sand and what else. This also gives you an idea... | The lifeless stare still takes some getting used to. The harder you look the more it feels like something is still in there. Something still human...} {You wonder how long it would take to teach this corpse to best a knight in battle. On second thoughts you aren't sure if you have that much time. | A victim of violence, %name% seems eager to continue the cycle of suffering. Perfect. | While clumsy, this create will make a fine addition to any collector looking to bulk out %their% macabre hobby. | You get the impression %name% would've been an interesting person to know when %they% were alive. Oh well. | A victim of murder, lyncing or witchcraft, maybe %name% was just in the wrong place at the wrong time? | %name% almost seems to enjoy %their% new existance in unlife. | After all, who needs tiring muscles, decent pay and moments of sheer panic? Not this one. | Weathered and beaten, this one will make a fine addition to the collection. | Sometimes you feel guilty to treat these creatures as personal servants.} {Despite everything, the body is willing and the flesh is weak. But you get the impression this won't be a problem. | You jokingly hand the corpse a contract, and it looks at the parchment with some familiarity... | While cheap labour, you really hope you don't need to scrub out any armour it might end up wearing. | You push %name% and it manages to stay standing, which is more impressive than it sounds by walking corpse standards. | But with sharp teeth like that, who needs weapons? | %name% drops to %their% knees and attempts to eat the critters crawling in the dirt. This will be a long and fruitful relationship. | If anything, %name% will make a decent pack mule for all the things you don't want to carry. | The poor thing looks hungry. | On second thought, maybe %name% isn't memorable enough. Surely you can do better...}"
        es = "{De dónde viene %name% es un misterio: su nombre original se ha perdido en el tiempo o se ha borrado de una antigua lápida muy, muy lejos de aquí. | Poco importa quién fue esta criatura. Sirve y obedece. Es lo único que importa. | Este cadáver está marcado por cortes y arañazos, y aún se conserva sorprendentemente fresco. | Llueva, nieve o haya tormenta de arena, %name% va felizmente a donde le place. Un alma verdaderamente libre en un mundo de penurias y desesperación. Si el mundo tuviera más gente como %name%, sería un lugar mucho mejor. | Este cadáver está marcado por puñaladas y cortes por todo el cuerpo, muchos de los cuales parecen de origen antiguo. | %name% está marcad%o% por heridas, muchas de ellas mortales, pero cosidas o cauterizadas con esmero, lo que sugiere que en algún momento alguien cuidó de %ese% pobre desgraciad%o% tras su muerte. Sin embargo, quién fue ese cuidador seguirá siendo un misterio para siempre. | Este cadáver parece algo más viejo que la mayoría, y apenas tiene daños de batalla. ¿Quizá murió en paz? Algo así es raro en este mundo. | Este cadáver apenas muestra indicios de una muerte violenta, salvo las marcas de la soga alrededor del cuello. | Con la guerra y la hambruna desatadas por todo el territorio, hoy en día aparecen cadáveres como %name% a montones. Las fosas comunes siguen al descubierto y los cementerios apenas tienen vigilancia. Mercados ideales para pulir las artes oscuras. | La guerra de los muchos nombres creó un auténtico tesoro de reclutas no vivos para los nigromantes. %name% es uno de esos productos del conflicto, al parecer algo más despiert%o% y receptiv%o% a las órdenes que el cadáver medio; no es que el listón esté muy alto, ni nada por el estilo... | Este cadáver fue atado y arrojado a un río; sin embargo, la causa principal de la muerte parecen ser las decenas de flechas que le acribillan el cuerpo. Obra de cazadores furtivos, de bandidos aburridos o de una venganza que llegó a su fin.}{ No te dejes engañar por su aspecto: cuando hay presa fresca de por medio, %name% actúa con una presteza repentina impropia de su estado. | La presencia de cualquier ser vivo, sea del tamaño que sea, desata el frenesí de este animal. | Este cadáver viene además con una pequeña bolsa de monedas oxidadas, que en su estado actual se están desperdiciando. Seguro que no las echará de menos... | %name% blande perezosamente una espada corta oxidada mientras arrastra los pies sin rumbo. | %name% es un nombre apropiado, ¿no crees? Refleja bien la lucha de esta criatura. | Aunque son no muertos, estas criaturas se parecen más a animales salvajes que a asesinos brutales. | Le das un toque a %name% en lo que queda de su brazo. Se gira para mirarte y luego pasa de largo para perseguir a un perro callejero. Te cae bien. | %name% sigue cubiert%o% de terrones de tierra, arena y quién sabe qué más. Eso también te da una idea... | Todavía cuesta acostumbrarse a esa mirada sin vida. Cuanto más la miras, más sientes que aún queda algo ahí dentro. Algo todavía humano...} {Te preguntas cuánto tardarías en enseñar a este cadáver a vencer a un caballero en combate. Pensándolo mejor, no estás seguro de tener tanto tiempo. | Víctima de la violencia, %name% parece deseos%o% de continuar el ciclo de sufrimiento. Perfecto. | Aunque torpe, esta criatura será una buena adición para cualquier coleccionista que quiera ampliar su macabra afición. | Te da la impresión de que %name% habría sido una persona interesante de conocer en vida. En fin. | Víctima de un asesinato, un linchamiento o la brujería, ¿quizá %name% simplemente estuvo en el lugar equivocado en el momento equivocado? | %name% casi parece disfrutar de su nueva existencia en la no vida. | Al fin y al cabo, ¿quién necesita músculos que se cansan, una paga decente y momentos de pánico absoluto? Desde luego, esta criatura no. | Curtid%o% y maltrech%o%, será una buena adición a la colección. | A veces te sientes culpable por tratar a estas criaturas como sirvientes personales.} {A pesar de todo, el cuerpo está dispuesto y la carne es débil. Pero te da la impresión de que eso no será un problema. | En broma, le tiendes un contrato al cadáver, y este mira el pergamino con cierta familiaridad... | Aunque es mano de obra barata, esperas de verdad no tener que restregar ninguna armadura que acabe llevando. | Empujas a %name% y consigue mantenerse en pie, lo cual es más impresionante de lo que parece para lo que cabe esperar de un cadáver andante. | Pero con unos dientes tan afilados, ¿quién necesita armas? | %name% cae de rodillas e intenta comerse los bichos que se arrastran por el suelo. Esta será una relación larga y fructífera. | Como mínimo, %name% servirá de buena mula de carga para todo lo que no quieras llevar. | La pobre criatura parece hambrienta. | Pensándolo mejor, quizá %name% no sea lo bastante memorable. Seguro que se te ocurre algo mejor...}"
    }
    // FILE: scripts\skills\backgrounds\legend_puppet_master_background.nut
    // context: legend_puppet_master_background.create.m.Name
    {
        en = "Puppet Master"
        es = "Titiritero"
    }
    // context: legend_puppet_master_background.create.m.BackgroundDescription
    {
        en = "Puppet masters are warlocks in training. While they do not understand the raising or preservation of the dead, they do excel at controlling them."
        es = "Los maestros de marionetas son brujos en formación. Aunque no comprenden cómo alzar o preservar a los muertos, destacan a la hora de controlarlos."
    }
    // context: legend_puppet_master_background.create.m.GoodEnding
    {
        en = "%name% continued to practice their control over immortal objects for some time after mastering the basics from their time with the company. Given time they slowly strayed further and further from mortal company and surrounded themselves with marionettes of their own making — it didn't take long for them to muster a court of silent friends and comrades that agreed with their every word and whim. %name% had found a place where they could belong, even if the road to get here was paved with darker intentions."
        es = "Tras dominar lo básico durante su etapa en la compañía, %name% siguió practicando un tiempo su control sobre objetos inmortales. Con los años, fue alejándose poco a poco del trato con los mortales y rodeándose de marionetas de su propia creación; no tardó en reunir una corte de amigos y camaradas silenciosos que aprobaban cada una de sus palabras y caprichos. %name% había encontrado un lugar al que pertenecer, aunque el camino hasta allí estuviera empedrado de intenciones más oscuras."
    }
    // context: legend_puppet_master_background.create.m.BadEnding
    {
        en = "%name% gradually detached from reality as their powers grew, forming their own as the world around them fell apart. Living or dead — it no longer mattered to him. %name% left quietly one night with a small group of his puppets, only to realise that when you are cold and alone, a brutal overseer has few friends when he needs them most."
        es = "A medida que crecían sus poderes, %name% se fue desligando de la realidad y forjando la suya propia mientras el mundo a su alrededor se desmoronaba. Vivos o muertos: ya le daba igual. Una noche, %name% se marchó en silencio con un pequeño grupo de sus marionetas, solo para darse cuenta de que, cuando uno tiene frío y está solo, un capataz brutal tiene pocos amigos cuando más los necesita."
    }
    // context: legend_puppet_master_background.create.m.Titles
    {
        en = "the Schemer"
        es = "el Intrigante"
    }
    // context: legend_puppet_master_background.create.m.Titles
    {
        en = "the Director"
        es = "el Director"
    }
    // context: legend_puppet_master_background.onBuildDescription
    {
        en = "{Chronically lazy, %name% was the son of a noble that had little interest in fencing, archery or diplomacy. They instead perferred to watch people move around like little ants from up high and command them as if they were the gilder themselves. | When a political rival ousted their father from power, %name% was forced into exile. | %name% was born a titan of a baby, already outmatching his siblings in strength and size. His natural gifts were never put to much use however. | %name% never had much disipline as a child, they would frequently cause mischief around their father's' estate. They discovered their dark gifts on accident while poking a living corpse trapped in the arches of the watermill, and the rest just fell into place. | %name% never understood why everyone was running around and so angry all the time. To them life is about relaxation and enjoying things, even if that involves having a small army of shuffling corpses to bring you drinks and clear the weeds from the herb garden. | %name% discovered their gifts early into their development. At first it was an accident involving a stray dog, but that experience quickly grew into an art form for %name% until they were exiled for their interests. | %name% was a child without a purpose. Born into nobility they spent their days as a child crushing ants and poking dead animals in the courtyard. Nothing interested %name% until they met an old man performing macabre tricks for the royal court...} {%name% always considered the old master to be their true father. With the death of the master the lowly pupil feels like a dark light has been extinguished from the world. Is it truely worth going on anymore?}"
        es = "{Crónicamente perezoso, %name% era hijo de un noble y tenía poco interés por la esgrima, el tiro con arco o la diplomacia. Prefería observar desde lo alto cómo la gente se movía como hormiguitas y darle órdenes como si fuera el mismísimo Dorado. | Cuando un rival político despojó del poder a su padre, %name% tuvo que partir al exilio. | %name% fue un bebé titánico que ya superaba a sus hermanos en fuerza y tamaño. Sin embargo, nunca se sacó mucho partido de sus dones naturales. | %name% nunca tuvo mucha disciplina en su infancia y a menudo hacía travesuras por la finca de su padre. Descubrió sus oscuros dones por accidente al pinchar a un cadáver viviente atrapado en los arcos del molino de agua, y el resto vino solo. | %name% nunca entendió por qué todo el mundo andaba corriendo de un lado a otro y de tan mal humor todo el tiempo. A su modo de ver, la vida consiste en relajarse y disfrutar de las cosas, aunque eso implique tener un pequeño ejército de cadáveres que arrastran los pies para que te traigan bebidas y quiten las malas hierbas del huerto de hierbas aromáticas. | %name% descubrió sus dones a temprana edad. Al principio fue un accidente con un perro callejero, pero aquella experiencia pronto se convirtió en todo un arte para %name%, hasta que acabó en el exilio por sus aficiones. | %name% tuvo una infancia sin propósito. De cuna noble, pasaba los días aplastando hormigas y pinchando animales muertos en el patio. Nada interesaba a %name% hasta que conoció a un anciano que hacía trucos macabros para la corte real...} {%name% siempre consideró al viejo maestro su verdadero padre. Ahora que el maestro ha muerto, siente que una luz oscura se ha apagado en el mundo. ¿De verdad vale la pena seguir adelante?}"
    }
    // FILE: scripts\skills\backgrounds\legend_qiyan_background.nut
    // context: legend_qiyan_background.create.m.Name
    {
        en = "Qiyan"
        es = "Qiyan"
    }
    // context: legend_qiyan_background.create.m.BackgroundDescription
    {
        en = "The qiyan is a slave, seductive and knowledgeable."
        es = "La qiyan es una esclava, seductora y erudita."
    }
    // context: legend_qiyan_background.create.m.GoodEnding
    {
        en = "%name% took what they had learned from their time in the company and headed north with the intention of getting as far away from the south as possible. They found good work and few questions awaiting them at a northern settlement in the tundra where they quickly rose the ranks of the local militia to become captain."
        es = "%name% se llevó lo aprendido durante su tiempo en la compañía y se dirigió al norte con la intención de alejarse todo lo posible del sur. En un asentamiento norteño de la tundra encontró buen trabajo y pocas preguntas, y allí ascendió rápidamente en la milicia local hasta llegar a capitanearla."
    }
    // context: legend_qiyan_background.create.m.BadEnding
    {
        en = "With the commander gone %name%'s future was uncertain, but her old masters were not. Manhunters came for %name% a few nights after the commander leaving. Without your guidance the remaining mercenaries did not attempt to stop the manhunters. What became of %name% is a mystery, she was last seen on a slave caravan heading south, but after that is anyone's guess."
        es = "Con la marcha del comandante, el futuro de %name% era incierto, pero sus antiguos amos no tenían ninguna duda. Los Cazahombres fueron a buscar a %name% pocas noches después de que el comandante se marchara. Sin tu guía, los mercenarios que quedaban no intentaron detenerlos. Lo que fue de %name% es un misterio: la vieron por última vez en una caravana de esclavos que se dirigía al sur, pero lo que pasó después, nadie lo sabe."
    }
    // context: legend_qiyan_background.create.m.Titles
    {
        en = "the Qiyan"
        es = "la Qiyan"
    }
    // context: legend_qiyan_background.onBuildDescription
    {
        en = "{%name% caught your eye during a festival held on a street corner, her singing voice was the most serene thing you had ever heard yet the chains of slavemasters rattled and clattered, masking her falsettos. | Her owners keep her at a distance, despite the delicate demeanour. | After verifying her claims that she stabbed a man twice her size to death in the street only a few weeks ago, you may think that she has what it takes to work in more gainful employment. } {%name% talks at length about her routine as a slave girl - she always wore as little clothing as she could get away with and her dances enthralled men and women alike. | She would dance for hours in public or private, normally for the wealthiest men in the land. | She also goes into great depth about how she killed each and every one of them with mundane objects like incense sticks, candles and even her own clothes. | This would explain why %name% wears broken shackles and is currently on the run from her employers. } {%name% used to be a slave girl, she is very particular on using the past tense when describing her past involving 'the rice and that stupid noble boy'. | When asked why she dances, she laughs and motions to the flowers and herbs adorning her hair. | While you are no expert, you do recognise at least two types that could kill a donkey in just a few bites. } {%name% is a mysterious character, under their clothing you can hear the occasional rattle of chains and the flash of a knife. | While all the hallmarks of a slave and assassin, %name% prefers to recite political treatise and poetry, almost word for word, to anyone who will listen. | Either a political captive or perhaps a recently learned woman, %name% can sit down with anyone and explain how to effectively, silently and efficiently kill any man with nothing but a scrap of metal and the element of surprise. | Almost word for word.}"
        es = "{%name% te llamó la atención durante una fiesta celebrada en una esquina: su voz al cantar era lo más sereno que habías oído jamás, pero las cadenas de los esclavistas resonaban y entrechocaban, ahogando sus falsetes. | Sus dueños la mantienen a distancia, a pesar de su aire delicado. | Tras comprobar que es cierto que hace solo unas semanas apuñaló hasta la muerte en plena calle a un hombre que le doblaba en tamaño, quizá pienses que tiene lo que hace falta para un empleo más lucrativo. } {%name% habla largo y tendido de su rutina como esclava: siempre llevaba tan poca ropa como le dejaban y sus bailes cautivaban por igual a hombres y mujeres. | Bailaba durante horas en público o en privado, normalmente para los hombres más ricos de la tierra. | También entra en detalle sobre cómo los mató a todos y cada uno con objetos corrientes, como varitas de incienso, velas e incluso su propia ropa. | Eso explicaría por qué %name% lleva grilletes rotos y anda huyendo de sus patrones. } {%name% fue esclava, y se cuida mucho de usar el pasado al describir lo que vivió con 'el arroz y aquel estúpido niño noble'. | Cuando le preguntan por qué baila, se ríe y señala las flores y hierbas que le adornan el cabello. | Aunque no eres ningún experto, sí reconoces al menos dos tipos capaces de matar a un burro en unos pocos bocados. } {%name% es un personaje misterioso: bajo su ropa se oye de vez en cuando el tintineo de unas cadenas y se ve el destello de un cuchillo. | Aunque tiene todas las trazas de esclava y asesina, %name% prefiere recitar tratados políticos y poesía, casi palabra por palabra, a cualquiera que quiera escuchar. | Ya sea una cautiva política o quizá una mujer instruida hace poco, %name% puede sentarse con cualquiera y explicarle cómo matar a cualquier hombre de forma eficaz, silenciosa y eficiente con nada más que un trozo de metal y el factor sorpresa. | Casi palabra por palabra.}"
    }
    // FILE: scripts\skills\backgrounds\legend_ranger_background.nut
    // context: legend_ranger_background.create.m.BackgroundDescription
    {
        en = "Rangers are expert trackers and marksman, used to hunting prey of any kind"
        es = "Los guardabosques son rastreadores y tiradores expertos, acostumbrados a cazar presas de todo tipo"
    }
    // context: legend_ranger_background.create.m.GoodEnding
    {
        // corrige base: «you have to imagine» es «te imaginas», no «debes imaginar» (calco).
        en = "While the %companyname% continued on with great success, %name% the ranger eventually saw fit to leave it all behind. %They% returned to the forests and fields, hunting deer and small game. %They% rarely showed the grim reality of hunting humans, but you have to imagine %they%'d just rather stop doing it. As far as you know, %they%'s doing well for %themselves% these days. %They% purchased a bit of land and helps guide nobles on pricy hunting trips."
        es = "Mientras %companyname% seguía cosechando grandes éxitos, %name%, %art% guardabosques, acabó por decidir dejarlo todo atrás. Regresó a los bosques y campos, a cazar ciervos y piezas menores. Rara vez dejaba ver la sombría realidad de cazar humanos, pero te imaginas que, sencillamente, prefería dejar de hacerlo. Hasta donde sabes, hoy en día le va bien. Compró un pedazo de tierra y ayuda a guiar a nobles en costosas partidas de caza."
    }
    // context: legend_ranger_background.create.m.BadEnding
    {
        // corrige base: «readily obvious» es «ya evidente»; «evidentemente obvio» es una redundancia que el inglés no tiene.
        // corrige base: «feeling he'd be blamed» es temer que lo culpen; «sintiendo que sería culpado» es calco.
        en = "With the decline of the %companyname% readily obvious, %name% the ranger departed from the company and returned to game hunting. Unfortunately, a hunting trip with a nobleman went awry when the lord was gored through both cheeks by a boar. The hunter, feeling %they%'d be blamed, shot the nobleman and his guard and fled through the forests on %their% own. %They% has not been seen since."
        es = "Con el declive de %companyname% ya evidente, %name%, %art% guardabosques, dejó la compañía y volvió a la caza de animales. Por desgracia, una partida de caza con un noble salió mal cuando un jabalí le atravesó al señor ambas mejillas. Temiendo que le echaran la culpa, %name% disparó al noble y a su guardia y huyó a solas a través de los bosques. No se le ha vuelto a ver desde entonces."
    }
    // context: legend_ranger_background.onBuildDescription
    {
        en = " {Without a father around, %name%'s mother taught how to shoot a bow, and how to feed the rest of the family. | Born in the hinterlands of %randomtown%, %name% has spent life stalking the beasts amongst the trees. | %name% once took a bet to shoot an apple off a pig's head. The shot missed. A belly full of bacon, determined to never miss again - unless it meant more bacon, of course. | Early in life, %name% liked to traipse about the forests. When a rabid fox attacked, %name% learned to take a bow. When a devilish eagle clawed %name%'s face, the pain taught how to shoot it.} {Once employed by local royalty, a disastrous boar hunt ended with a gored baron and all the blame - and blood - on %name%'s hands. | The hunter hid the thought well, but for the longest time wondered what it would be like to hunt the ultimate game: man. | Sadly, a bad game of peasant-roulette forced the deer hunter into seeking other means of income. | Unfortunately, the ranger is not nearly as good at cooking deer as shooting them. A dinner consisting of undercooked meats poisoned %name%'s entire family. Desperation for a new life is understandable. | After an arduous trip to town to sell meats and leathers, %name% followed the call of mercenary work. | War drove the game out of the forests, and the hunt out of %name%. Now it has driven %name% to seek another line of work. | When %name%'s partner fell ill, the wounds could not be healed with hunted meat. Needing to earn crowns to pay for treatment, %name% took up the vocation of sellswords - or sellbows, as it were.} {Any outfit could use a deadeye such as this ranger. | Not entirely without faults, %name% is a professional archer nonetheless. | A quick demonstration is offered: %name% shoots one arrow high into the sky, and with another knocks it out. Impressive. | %name% has the look of someone with something to prove - just make sure it is proved at range. When first given a sword, %name% grabbed it at the wrong end. Yes, that end. | The hunter wields a bow like another limb, and shoots arrows like a preacher does words.}"
        es = " {Sin un padre cerca, fue la madre de %name% quien le enseñó a disparar con arco y a alimentar al resto de la familia. | Desde que nació en las tierras remotas de %randomtown%, %name% ha pasado la vida acechando a las bestias entre los árboles. | Una vez %name% apostó a que le daba a una manzana colocada sobre la cabeza de un cerdo. Falló el tiro. Con la panza llena de tocino, se propuso no volver a fallar jamás... a menos que eso significara más tocino, claro. | De joven, a %name% le gustaba vagar por los bosques. Cuando un zorro rabioso se le echó encima, %name% aprendió a empuñar un arco. Cuando un águila endiablada le arañó la cara a %name%, el dolor le enseñó a dispararle.} {En otro tiempo al servicio de la realeza local, una desastrosa cacería de jabalíes terminó con un barón atravesado por los colmillos y toda la culpa (y la sangre) en las manos de %name%. | Aunque lo disimulaba bien, durante muchísimo tiempo se preguntó cómo sería cazar la presa definitiva: el hombre. | Por desgracia, una mala partida de ruleta campesina obligó a dejar la caza de ciervos y buscar otra fuente de ingresos. | Lamentablemente, cocinar ciervos no se le da ni de lejos tan bien como abatirlos. Una cena de carnes poco cocinadas envenenó a toda la familia de %name%. Es comprensible el deseo desesperado de empezar una nueva vida. | Tras un arduo viaje a la ciudad para vender carne y cueros, %name% siguió la llamada del trabajo mercenario. | La guerra echó la caza de los bosques, y a %name% le quitó las ganas de cazar. Ahora ha empujado a %name% a buscar otro oficio. | Cuando la pareja de %name% enfermó, sus heridas no podían curarse con carne de caza. Ante la necesidad de ganar coronas para pagar el tratamiento, %name% abrazó el oficio de las espadas a sueldo, o más bien de los arcos a sueldo.} {A cualquier compañía le vendría bien una puntería tan certera. | %name% tiene sus defectos, pero aun así tira con arco como profesional. | Se ofrece una rápida demostración: %name% dispara una flecha bien alto hacia el cielo y la derriba con otra. Impresionante. | %name% tiene el aspecto de alguien con algo que demostrar; solo asegúrate de que lo demuestre a distancia. La primera vez que le dieron una espada, %name% la agarró por el extremo equivocado. Sí, por ese extremo. | Empuña el arco como si fuera una extremidad más y suelta flechas como un predicador suelta palabras.}"
    }
    // FILE: scripts\skills\backgrounds\legend_ranger_commander_background.nut
    // context: legend_ranger_commander_background.create.m.BackgroundDescription
    {
        en = "Rangers are expert trackers and archers, used to hunting prey of any kind"
        es = "Los guardabosques son rastreadores y arqueros expertos, acostumbrados a cazar presas de todo tipo"
    }
    // context: legend_ranger_commander_background.create.m.GoodEnding
    {
        // corrige base: «you have to imagine» es «te imaginas», no «debes imaginar» (calco).
        en = "While the %companyname% continued on with great success, %name% the ranger eventually saw fit to leave it all behind. Returning to the forests and fields, hunting deer and small game. Rarely showed the grim reality of hunting humans, but you have to imagine they'd just rather stop doing it. As far as you know, %name%'s doing well these days. Purchased a bit of land and helps guide nobles on pricy hunting trips."
        es = "Mientras %companyname% seguía cosechando grandes éxitos, %name%, guardabosques de oficio, acabó por decidir dejarlo todo atrás. Regresó a los bosques y campos, a cazar ciervos y piezas menores. Rara vez dejaba ver la sombría realidad de cazar humanos, pero te imaginas que, sencillamente, prefería dejar de hacerlo. Hasta donde sabes, a %name% le va bien hoy en día. Compró un pedazo de tierra y ayuda a guiar a nobles en costosas partidas de caza."
    }
    // context: legend_ranger_commander_background.create.m.BadEnding
    {
        // corrige base: «readily obvious» es «ya evidente»; «evidentemente obvio» es una redundancia que el inglés no tiene.
        // corrige base: «shot by» es pasar a toda velocidad junto a alguien, no dispararle; la 1.0 lo traduce como «disparó al noble».
        // corrige base: «feeling he'd be blamed» es temer que lo culpen; «sintiendo que sería culpado» es calco.
        en = "With the decline of the %companyname% readily obvious, %name% the ranger departed from the company and returned to game hunting. Unfortunately, a hunting trip with a nobleman went awry when the lord was gored through both cheeks by a boar. The hunter, fearing the blame, shot by the nobleman and his guard and fled through the forests alone. %name% has not been seen since."
        es = "Con el declive de %companyname% ya evidente, %name%, guardabosques de oficio, dejó la compañía y volvió a la caza de animales. Por desgracia, una partida de caza con un noble salió mal cuando un jabalí le atravesó al señor ambas mejillas. Temiendo que le echaran la culpa, %name% pasó como una exhalación junto al noble y su guardia y huyó a solas a través de los bosques. No se le ha vuelto a ver desde entonces."
    }
    // context: legend_ranger_commander_background.setGender.m.GoodEnding
    {
        // corrige base: «you have to imagine» es «te imaginas», no «debes imaginar» (calco).
        en = "While the %companyname% continued on with great success, %name% the ranger eventually saw fit to leave it all behind. She returned to the forests and fields, hunting deer and small game. She rarely showed the grim reality of hunting humans, but you have to imagine she'd just rather stop doing it. As far as you know, she's doing well for herself these days. She purchased a bit of land and helps guide nobles on pricy hunting trips."
        es = "Mientras %companyname% seguía cosechando grandes éxitos, %name%, la guardabosques, acabó por decidir dejarlo todo atrás. Regresó a los bosques y campos, a cazar ciervos y piezas menores. Rara vez dejaba ver la sombría realidad de cazar humanos, pero te imaginas que, sencillamente, prefería dejar de hacerlo. Hasta donde sabes, hoy en día le va bien. Compró un pedazo de tierra y ayuda a guiar a nobles en costosas partidas de caza."
    }
    // context: legend_ranger_commander_background.setGender.m.BadEnding
    {
        // corrige base: «readily obvious» es «ya evidente»; «evidentemente obvio» es una redundancia que el inglés no tiene.
        // corrige base: «shot by» es pasar a toda velocidad junto a alguien, no dispararle; la 1.0 lo traduce como «disparó al noble».
        // corrige base: «feeling he'd be blamed» es temer que lo culpen; «sintiendo que sería culpado» es calco.
        en = "With the decline of the %companyname% readily obvious, %name% the ranger departed from the company and returned to game hunting. Unfortunately, a hunting trip with a nobleman went awry when the lord was gored through both cheeks by a boar. The hunter, feeling he'd be blamed, shot by the nobleman and his guard and fled through the forests on her own. She has not been seen since."
        es = "Con el declive de %companyname% ya evidente, %name%, la guardabosques, dejó la compañía y volvió a la caza de animales. Por desgracia, una partida de caza con un noble salió mal cuando un jabalí le atravesó al señor ambas mejillas. La cazadora, temiendo que la culparan, pasó como una exhalación junto al noble y su guardia y huyó sola a través de los bosques. No se la ha vuelto a ver desde entonces."
    }
    // context: legend_ranger_commander_background.onBuildDescription
    {
        en = "This is your commander, when they die the company ends. {Without a father around, %name%'s mother taught how to shoot a bow, and how to feed the rest of the family. | Born in the hinterlands of %randomtown%, %name% has spent life stalking the beasts amongst the trees. | %name% once took a bet to shoot an apple off a pig's head. The shot missed. A belly full of bacon, determined to never miss again - unless it meant more bacon, of course. | Early in life, %name% liked to traipse about the forests. When a rabid fox attacked, %name% learned to take a bow. When a devilish eagle clawed %name's face, the pain taught how to shoot it.} {Once employed by local royalty, a disastrous boar hunt ended with a gored baron and all the blame - and blood - on %name%'s hands. | The hunter hid the thought well, but for the longest time wondered what it would be like to hunt the ultimate game: man. | Sadly, a bad game of peasant-roulette forced the deer hunter into seeking other means of income. | Unfortunately, the ranger is not nearly as good at cooking deer as shooting them. A dinner consisting of undercooked meats poisoned %name%'s entire family. Desperation for a new life is understandable. | After an arduous trip to town to sell meats and leathers, %name% followed the call of mercenary work. | War drove the game out of the forests, and the hunt out of %name%. Now it has driven %name% to seek another line of work. | When %name%'s partner fell ill, the wounds could not be healed with hunted meat. Needing to earn crowns to pay for treatment, %name% took up the vocation of sellswords - or sellbows, as it were.} {Any outfit could use a deadeye such as this ranger. | Not entirely without faults, %name% is a professional archer nonetheless. | A quick demonstration is offered: %name% shoots one arrow high into the sky, and with another knocks it out. Impressive. | %name% has the look of someone with something to prove - just make sure it is proved at range. When first given a sword, h%name% grabbed it at the wrong end. Yes, that end. | The hunter wields a bow like another limb, and shoots arrows like a preacher does words.}"
        es = "Es tu comandante: si muere, la compañía termina. {Sin un padre cerca, fue la madre de %name% quien le enseñó a disparar con arco y a alimentar al resto de la familia. | Desde que nació en las tierras remotas de %randomtown%, %name% ha pasado la vida acechando a las bestias entre los árboles. | Una vez %name% apostó a que le daba a una manzana colocada sobre la cabeza de un cerdo. Falló el tiro. Con la panza llena de tocino, se propuso no volver a fallar jamás... a menos que eso significara más tocino, claro. | De joven, a %name% le gustaba vagar por los bosques. Cuando un zorro rabioso se le echó encima, %name% aprendió a empuñar un arco. Cuando un águila endiablada le arañó la cara, el dolor le enseñó a dispararle.} {En otro tiempo al servicio de la realeza local, una desastrosa cacería de jabalíes terminó con un barón atravesado por los colmillos y toda la culpa (y la sangre) en las manos de %name%. | Aunque lo disimulaba bien, durante muchísimo tiempo se preguntó cómo sería cazar la presa definitiva: el hombre. | Por desgracia, una mala partida de ruleta campesina obligó a dejar la caza de ciervos y buscar otra fuente de ingresos. | Lamentablemente, cocinar ciervos no se le da ni de lejos tan bien como abatirlos. Una cena de carnes poco cocinadas envenenó a toda la familia de %name%. Es comprensible el deseo desesperado de empezar una nueva vida. | Tras un arduo viaje a la ciudad para vender carne y cueros, %name% siguió la llamada del trabajo mercenario. | La guerra echó la caza de los bosques, y a %name% le quitó las ganas de cazar. Ahora ha empujado a %name% a buscar otro oficio. | Cuando la pareja de %name% enfermó, sus heridas no podían curarse con carne de caza. Ante la necesidad de ganar coronas para pagar el tratamiento, %name% abrazó el oficio de las espadas a sueldo, o más bien de los arcos a sueldo.} {A cualquier compañía le vendría bien una puntería tan certera. | %name% tiene sus defectos, pero aun así tira con arco como profesional. | Se ofrece una rápida demostración: %name% dispara una flecha bien alto hacia el cielo y la derriba con otra. Impresionante. | %name% tiene el aspecto de alguien con algo que demostrar; solo asegúrate de que lo demuestre a distancia. La primera vez que le dieron una espada, %name% la agarró por el extremo equivocado. Sí, por ese extremo. | Empuña el arco como si fuera una extremidad más y suelta flechas como un predicador suelta palabras.}"
    }
