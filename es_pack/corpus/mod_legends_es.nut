        en = "If enabled, every Citadel will start with all those building attachments map scummers are re-rolling for."
        es = ""
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "All trade buildings available"
        es = ""
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "If enabled, ensures there is at least one of each trade location building on the map."
        es = ""
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "(Debug) Show Entire Map"
        es = ""
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
