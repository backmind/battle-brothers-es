    // FILE: mod_legends\hooks\retinue\followers\scout_follower.nut
    // context: scout_follower.o.create.m.Name
    {
        en = "Watcher's Totem"
        es = ""
    }
    // context: scout_follower.o.create.m.Description
    {
        en = "The people of the woods and hinterlands swear that the presence of this totem grants good fortune to those around it, somehow preventing sickness and accidents as long as it is in the camp. Sounds like farking nonsense but if it keeps them happy..."
        es = ""
    }
    // context: scout_follower.o.create.m.Effects
    {
        en = "Reduces the movement penalty of difficult terrain by 15%"
        es = ""
    }
    // en = "Prevents sickness and accidents due to terrain"
