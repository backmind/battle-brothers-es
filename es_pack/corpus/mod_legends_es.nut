    // FILE: mod_legends\hooks\contracts\contracts\arena_contract.nut
    // context: arena_contract.o.create.m.DescriptionTemplates
    {
        en = "The buzzing roar of the crowd draw many to the Arena. Gold, glory and death can be found inside."
        es = "El rugido de la multitud atrae a muchos a la Arena. Dentro aguardan oro, gloria y muerte."
    }
    // context: arena_contract.o.create.m.DescriptionTemplates
    {
        en = "Amidst the cheers and jeers, the Arena stands as a testament to the might of the Southern Realms."
        es = "Entre vítores y abucheos, la Arena se alza como testimonio del poderío de los Reinos del Sur."
    }
    // context: arena_contract.o.create.m.DescriptionTemplates
    {
        en = "The Imperial Arena, where gold and glory are earned through blood and sweat."
        es = "La Arena Imperial, donde el oro y la gloria se ganan con sangre y sudor."
    }
    // context: arena_contract.o.create.m.DescriptionTemplates
    {
        en = "Legends are made and dreams shattered within the walls of the Imperial Arena."
        es = "Entre los muros de la Arena Imperial nacen leyendas y se hacen añicos los sueños."
    }
    // context: arena_contract.o.create.m.DescriptionTemplates
    {
        en = "Nobles and commoners alike gather to witness the spectacle of the Imperial Arena."
        es = "Nobles y plebeyos por igual se reúnen para presenciar el espectáculo de la Arena Imperial."
    }
    // context: arena_contract.o.create.m.DescriptionTemplates
    {
        en = "Glittering under the sun, the sands of the Imperial Arena bear witness to countless contests."
        es = "Bajo el sol, la arena reluciente de la Arena Imperial ha sido testigo de incontables contiendas."
    }
    // context: arena_contract.o.createScreens.s.start.Text.::MSU.String.replace()
    // en = "The arena master"  // cadena de búsqueda de MSU.String.replace en la pantalla Task (arena_contract.nut:122), no se muestra sola
    // context: arena_contract.o.createScreens.s.start.Text.::MSU.String.replace()
    // en = " The arena master"  // cadena de reemplazo de MSU.String.replace en la pantalla Task (arena_contract.nut:122), no se muestra sola
    // context: arena_contract.o.createScreens.s.Options.push().Text
    {
        en = "{I'll have to think it over.}"
        es = "{Tendré que pensarlo.}"
    }
    // en = "I'll have to think it over."
    // en base_es
    // context: arena_contract.createScreens.Start.start
    {
        // @composicion: this.Text += (pantalla Start del juego base + bloque de Legends).
        // La suma llega entera a Rosetta; los trozos de abajo no llegan nunca solos.
        en = "[img]gfx/ui/events/event_155.png[/img]{As you wait your turn, the crowd's bloodlust crawls through the dark, sheets of dust falling from above, the stomps of feet thunderous. They murmur in anticipation, and roar at killings. The quiet between battles is mere moments, and this silence is snatched away as the rusted gate lurches upward, chains rankling, the crowd abuzz once more. You step out into the light and so thunderous is the noise against your heart it could surely yet spur a dead man forth... | The arena's crowd is shoulder to shoulder, most blathering drunk. They scream and shout, their languages a mix of local and foreign, though the appeal to their bloodlust needs little articulation beyond their maddened faces and pumping fists. Now, the %companyname%'s men will satiate these mad fools... | Cleaners hurry about the arena. They drag away the bodies, collect what's worth collecting, and occasionally throw a trophy into the crowds, eliciting a moblike rendition of the arena's battles in the stands themselves. The %companyname% is now a part of this affair. | The arena awaits, the crowd alight, and the %companyname%'s turn to gain glory is at hand! | The crowd booms as the %companyname%'s men stride into its bloody pit. Despite the mindless bloodlust of the peoples, you can't help but feel a beat of pride in your chest, knowing that it is your company ready to put on a show. | The gate rises. Nothing is heard save the rattle of chains, the creak of pulleys, the grunts of slaves at work. When the men of the %companyname% step out of the arena's bowels they can hear the crunch of sand underfoot until they come to stand in the center of the pit. A strange voice screams from the tops of the stadium, some lost language beyond your knowing, but the words echo just once before the crowd erupts with cheers and roaring. Now is the time your men shall prove themselves before the watchful eye of the commoner. | The %companyname%'s business is rarely done before the eyes of those who would prefer themselves distantly separated from such violence. But in the arena, the commoner greedily awaits death and suffering, and it growls with bloodlust as your men enter the pits, and roars as the sellswords draw their weapons and ready for battle. | The arena is shaped like the pit of some sore, its ceiling torn away by the gods, revealing the vanity, bloodlust, and savagery of man. And it is man there, yelling and screaming, and if the blood sprays hit them, they wash their faces in the gore and grin at one another as though it were a joke. They fight one another for trophies and relish in the pain of others. And it is before these peoples that the %companyname% will fight, and for them they shall entertain and entertain well. | The arena's crowd is a mash of classes, rich and poor, for only the Viziers separate themselves out into stations above all. Briefly unified, the peoples of %townname% have graciously come together to watch men and monsters murder one another. With pleasure, the %companyname% seeks to do its part. | Boys sitting on the shoulders of fathers, young girls throwing flowers to the gladiators, women fanning themselves, men wondering if they could do it. These are the peoples of the arena - and the rest are all drunk out of their gourd and screaming nonsense. You hope the %companyname% can contribute to at least an hour or two to entertaining this mad lot. | The crowd roars as the %companyname%'s men step into the pit. One would be dumb to confuse excitement for desire, for as soon as the applause ends there is a smattering of empty beer mugs and rotten tomatoes and the general giggling delight of those watching the matter. You wonder if the %companyname%'s men are really best spent here, but then think hard on the gold and glory to be won, and that at the end of the day these mongrels in the stands will go home to their shit lives, and you'll go home to your shit life as well, but at least your pockets will be a bit deeper.}\n\n\n\n\n\n\n\nThe following characters will enter the arena:\n\n%bro1name%\n%bro2name%\n%bro3name%"
        es = "[img]gfx/ui/events/event_155.png[/img]{Mientras esperas tu turno, notas las láminas de polvo cayendo desde arriba por los estruendosos golpes de pies, como si la sed de sangre de la multitud se arrastrara en la oscuridad. Murmuran en anticipación y rugen ante las muertes. El silencio entre las batallas dura apenas un momento, y este silencio es arrebatado cuando la puerta oxidada se levanta, las cadenas chirriando, la multitud zumbando una vez más. Sales a la luz y el estruendo es tan atronador contra tu corazón que seguramente podría impulsar a un hombre muerto... | La multitud de la arena está hombro con hombro, la mayoría de ellos embriagados y balbuceantes. Gritan y vociferan en una mezcla de idiomas locales y extranjeros, aunque el llamado a su sed de sangre no necesita más que sus rostros enloquecidos y puños agitados. Ahora, los hombres de %companyname% saciarán a estos locos insensatos... | Los limpiadores se apresuran por la arena. Arrastran los cuerpos, recogen lo que vale la pena y ocasionalmente arrojan un trofeo a la multitud, provocando una versión casi caótica de las batallas de la arena en las gradas. %companyname% ahora forma parte de este espectáculo. | La arena espera, la multitud emocionada y el turno de %companyname% para ganar gloria está a la mano. | La multitud estalla en aplausos cuando los hombres de %companyname% avanzan hacia su sangriento foso. A pesar de la sed de sangre sin sentido de la gente, no puedes evitar sentir un latido de orgullo en tu pecho, sabiendo que es tu compañía la que está lista para ofrecer un espectáculo. | La puerta se levanta. Nada se escucha, solo el tintineo de cadenas, el crujido de poleas y los gruñidos de esclavos trabajando. Cuando los hombres de %companyname% salen de las entrañas del coliseo, pueden escuchar el crujir de la arena bajo sus pies hasta que llegan al centro del foso. Una extraña voz grita desde lo más alto del estadio, en un idioma perdido que desconoces, pero las palabras resuenan una sola vez antes de que la multitud estalle en vítores y rugidos. Ahora es el momento en que tus hombres demostrarán su valía ante el ojo vigilante del populacho. | Los negocios de %companyname% rara vez se llevan a cabo ante los ojos de aquellos que preferirían mantenerse distantes de tanta violencia. Pero en la arena, el populacho espera ávidamente la muerte y el sufrimiento, y ruge con sed de sangre cuando tus hombres entran a los fosos, y aplaude mientras los mercenarios sacan sus armas y se preparan para la batalla. | La arena tiene la forma del tajo de una herida, su techo desgarrado por los dioses, revelando la vanidad, la sed de sangre y la barbarie del ser humano. Y está el populacho allí, gritando y vociferando, esperando ver la sangre correr y regar la tierra, mientras se sonríen entre ellos como si fuera un simple juego. Los hombres lucharan entre ellos por trofeos mientras otros disfrutan del dolor ajeno. Y es ante este gentio que %companyname% luchará, y será a ellos a quien entretendrán. Lo harán bien. | La multitud de la arena es una mezcla de clases, ricos y pobres, porque solo los Visires se separan en palcos por encima de todos. Brevemente unidos, el pueblo de %townname% se han reunido para presenciar cómo hombres y monstruos se asesinan entre sí. Con placer, %companyname% se dispone a hacer su parte. | Niños sentados sobre los hombros de sus padres, niñas jóvenes arrojando flores a los gladiadores, mujeres abanicándose, hombres preguntándose si podrían hacerlo. Estos son los pueblos de la arena, y el resto están todos borrachos y vociferando sin sentido. Esperas que %companyname% pueda contribuir al menos una hora o dos para entretener a esta loca multitud. | La multitud ruge mientras los hombres de %companyname% entran en el foso. Sería una tontería confundir la emoción con el deseo, porque tan pronto como los aplausos terminan, hay una lluvia de jarras de cerveza vacías y tomates podridos, y la alegría generalizada de aquellos que observan el asunto. Te preguntas si los hombres de %companyname% realmente deben gastar su tiempo aquí, pero luego piensas en el oro y la gloria que pueden obtener, y que, a fin de cuentas, esta chusma en las gradas regresará a sus miserables vidas, al igual que tú, pero al menos tus bolsillos estarán un poco más llenos.}\n\n\n\n\n\n\n\nLos siguientes personajes entrarán en la arena:\n\n%bro1name%\n%bro2name%\n%bro3name%"
    }
    // context: arena_contract.o.createScreens.s.start
    {
        en = "\n\n\n\n\n\n\n\nThe following characters will enter the arena:\n\n%bro1name%\n%bro2name%\n%bro3name%"
        es = "\n\n\n\n\n\n\n\nLos siguientes personajes entrarán en la arena:\n\n%bro1name%\n%bro2name%\n%bro3name%"
    }
    // context: arena_contract.createScreens.Success.start
    {
        // @composicion: this.Text += (texto de Success + aviso de la arena).
        // La suma llega entera a Rosetta; los trozos de abajo no llegan nunca solos.
        en = "[img]gfx/ui/events/event_147.png[/img]{The arena master talks as if he doesn't even remember your face, then again he probably doesn't.%SPEECH_ON%Here's your pay, please come again.%SPEECH_OFF% | Without even raising his head from a rag of papyrus, the arena master throws you a purse of coin.%SPEECH_ON%I heard the crowds, and so here are your crowns. May you come visit the pits again.%SPEECH_OFF% | The arena master is waiting for you.%SPEECH_ON%That was a mighty fine show, Crownling. Would not mind it in the slightest if you come back again.%SPEECH_OFF%}The arena will be closed for the day, but you could return as early as tomorrow."
        es = "[img]gfx/ui/events/event_147.png[/img]{El Maestro de la Arena habla como si ni siquiera recordara tu rostro, y probablemente no lo haga.%SPEECH_ON%Aquí está tu paga, por favor vuelve otra vez.%SPEECH_OFF% | Sin siquiera levantar la cabeza de un trozo de papiro, el Maestro de la Arena te arroja una bolsa de monedas.%SPEECH_ON%Escuché a la multitud, así que aquí tienes tus coronas. Ojalá vuelvas a visitar los fosos.%SPEECH_OFF% | El Maestro de la Arena está esperándote.%SPEECH_ON%Eso fue un gran espectáculo, Cuentacoronas. No me importaría en lo más mínimo que volvieras de nuevo.%SPEECH_OFF%}La arena estará cerrada el resto del día, pero podrías regresar mañana mismo."
    }
    // context: arena_contract.createScreens.Success.start
    {
        // @composicion: this.Text += (texto de Success + aviso de la arena).
        // La suma llega entera a Rosetta; los trozos de abajo no llegan nunca solos.
        en = "[img]gfx/ui/events/event_147.png[/img]{The arena master talks as if he doesn't even remember your face, then again he probably doesn't.%SPEECH_ON%Here's your pay, please come again.%SPEECH_OFF% | Without even raising his head from a rag of papyrus, the arena master throws you a purse of coin.%SPEECH_ON%I heard the crowds, and so here are your crowns. May you come visit the pits again.%SPEECH_OFF% | The arena master is waiting for you.%SPEECH_ON%That was a mighty fine show, Crownling. Would not mind it in the slightest if you come back again.%SPEECH_OFF%}You can continue fighting today if you want."
        es = "[img]gfx/ui/events/event_147.png[/img]{El Maestro de la Arena habla como si ni siquiera recordara tu rostro, y probablemente no lo haga.%SPEECH_ON%Aquí está tu paga, por favor vuelve otra vez.%SPEECH_OFF% | Sin siquiera levantar la cabeza de un trozo de papiro, el Maestro de la Arena te arroja una bolsa de monedas.%SPEECH_ON%Escuché a la multitud, así que aquí tienes tus coronas. Ojalá vuelvas a visitar los fosos.%SPEECH_OFF% | El Maestro de la Arena está esperándote.%SPEECH_ON%Eso fue un gran espectáculo, Cuentacoronas. No me importaría en lo más mínimo que volvieras de nuevo.%SPEECH_OFF%}Puedes seguir combatiendo hoy si quieres."
    }
    // context: arena_contract.o.createScreens.s.start.Text
    {
        // corrige base: "Espero que vuelvas a visitar los fosos pronto" añade "pronto", que el inglés ("May you come visit the pits again") no tiene; queda "Ojalá vuelvas a visitar los fosos".
        en = "[img]gfx/ui/events/event_147.png[/img]{The arena master talks as if he doesn't even remember your face, then again he probably doesn't.%SPEECH_ON%Here's your pay, please come again.%SPEECH_OFF% | Without even raising his head from a rag of papyrus, the arena master throws you a purse of coin.%SPEECH_ON%I heard the crowds, and so here are your crowns. May you come visit the pits again.%SPEECH_OFF% | The arena master is waiting for you.%SPEECH_ON%That was a mighty fine show, Crownling. Would not mind it in the slightest if you come back again.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_147.png[/img]{El Maestro de la Arena habla como si ni siquiera recordara tu rostro, y probablemente no lo haga.%SPEECH_ON%Aquí está tu paga, por favor vuelve otra vez.%SPEECH_OFF% | Sin siquiera levantar la cabeza de un trozo de papiro, el Maestro de la Arena te arroja una bolsa de monedas.%SPEECH_ON%Escuché a la multitud, así que aquí tienes tus coronas. Ojalá vuelvas a visitar los fosos.%SPEECH_OFF% | El Maestro de la Arena está esperándote.%SPEECH_ON%Eso fue un gran espectáculo, Cuentacoronas. No me importaría en lo más mínimo que volvieras de nuevo.%SPEECH_OFF%}"
    }
    // context: arena_contract.o.createScreens.s.start
    {
        en = "The arena will be closed for the day, but you could return as early as tomorrow."
        es = "La arena estará cerrada el resto del día, pero podrías regresar mañana mismo."
    }
    // context: arena_contract.o.createScreens.s.start
    {
        en = "You can continue fighting today if you want."
        es = "Puedes seguir combatiendo hoy si quieres."
    }
    // en = "You gain a <a:str>"
    // en base_es
    // context: arena_contract.o.prepareBroVariables._vars.push()
    // en = "bro<currentBro++>name"  // nombre de variable de texto (%broNname%), no se muestra
    // context: arena_contract.o.prepareBroVariables._vars.push()
    // en = "bro<i>name"  // nombre de variable de texto (%broNname%), no se muestra
    // FILE: mod_legends\hooks\contracts\contracts\arena_tournament_contract.nut
    // context: arena_tournament_contract.o.create.m.DescriptionTemplates
    {
        en = "A grand tournament to the death, a celebration of slaughter. Eternal glory and prized items await."
        es = "Un gran torneo a muerte, una celebración de la matanza. Aguardan la gloria eterna y objetos preciados."
    }
    // context: arena_tournament_contract.o.create.m.DescriptionTemplates
    {
        en = "Blood soaks the sand, yet the crowd always screams for more. A grand tournament has been announced!"
        es = "La sangre empapa la arena, pero la multitud siempre pide más a gritos. ¡Se ha anunciado un gran torneo!"
    }
    // context: arena_tournament_contract.o.create.m.DescriptionTemplates
    {
        en = "Don your armor and sharpen your blades! The Imperial Arena grand tournament is about to begin!"
        es = "¡Ponte la armadura y afila tus hojas! ¡El gran torneo de la Arena Imperial está a punto de comenzar!"
    }
    // context: arena_tournament_contract.o.create.m.DescriptionTemplates
    {
        en = "Calling all warriors! The Imperial Arena grand tournament beckons!"
        es = "¡Se convoca a todos los guerreros! ¡El gran torneo de la Arena Imperial los llama!"
    }
    // context: arena_tournament_contract.o.create.m.DescriptionTemplates
    {
        en = "Champions, assemble! The Imperial Arena tournament awaits your valor!"
        es = "¡Campeones, reúnanse! ¡El torneo de la Arena Imperial aguarda su valor!"
    }
    // context: arena_tournament_contract.o.create.m.DescriptionTemplates
    {
        en = "The Imperial Arena is set to host a thrilling tournament of skill and bravery!"
        es = "¡La Arena Imperial se dispone a acoger un emocionante torneo de destreza y valentía!"
    }
    // context: arena_tournament_contract.createScreens.Start.start
    {
        // @composicion: this.Text += (pantalla Start del juego base + bloque de Legends).
        // La suma llega entera a Rosetta; los trozos de abajo no llegan nunca solos.
        en = "[img]gfx/ui/events/event_155.png[/img]{As you wait your turn, the crowd's bloodlust crawls through the dark, sheets of dust falling from above, the stomps of feet thunderous. They murmur in anticipation, and roar at killings. The quiet between battles is mere moments, and this silence is snatched away as the rusted gate lurches upward, chains rankling, the crowd abuzz once more. You step out into the light and so thunderous is the noise against your heart it could surely yet spur a dead man forth... | The arena's crowd is shoulder to shoulder, most blathering drunk. They scream and shout, their languages a mix of local and foreign, though the appeal to their bloodlust needs little articulation beyond their maddened faces and pumping fists. Now, the %companyname%'s men will satiate these mad fools... | Cleaners hurry about the arena. They drag away the bodies, collect what's worth collecting, and occasionally throw a trophy into the crowds, eliciting a moblike rendition of the arena's battles in the stands themselves. The %companyname% is now a part of this affair. | The arena awaits, the crowd alight, and the %companyname%'s turn to gain glory is at hand! | The crowd booms as the %companyname%'s men stride into its bloody pit. Despite the mindless bloodlust of the peoples, you can't help but feel a beat of pride in your chest, knowing that it is your company ready to put on a show. | The gate rises. Nothing is heard save the rattle of chains, the creak of pulleys, the grunts of slaves at work. When the men of the %companyname% step out of the arena's bowels they can hear the crunch of sand underfoot until they come to stand in the center of the pit. A strange voice screams from the tops of the stadium, some lost language beyond your knowing, but the words echo just once before the crowd erupts with cheers and roaring. Now is the time your men shall prove themselves before the watchful eye of the commoner. | The %companyname%'s business is rarely done before the eyes of those who would prefer themselves distantly separated from such violence. But in the arena, the commoner greedily awaits death and suffering, and it growls with bloodlust as your men enter the pits, and roars as the sellswords draw their weapons and ready for battle. | The arena is shaped like the pit of some sore, its ceiling torn away by the gods, revealing the vanity, bloodlust, and savagery of man. And it is man there, yelling and screaming, and if the blood sprays hit them, they wash their faces in the gore and grin at one another as though it were a joke. They fight one another for trophies and relish in the pain of others. And it is before these peoples that the %companyname% will fight, and for them they shall entertain and entertain well. | The arena's crowd is a mash of classes, rich and poor, for only the Viziers separate themselves out into stations above all. Briefly unified, the peoples of %townname% have graciously come together to watch men and monsters murder one another. With pleasure, the %companyname% seeks to do its part. | Boys sitting on the shoulders of fathers, young girls throwing flowers to the gladiators, women fanning themselves, men wondering if they could do it. These are the peoples of the arena - and the rest are all drunk out of their gourd and screaming nonsense. You hope the %companyname% can contribute to at least an hour or two to entertaining this mad lot. | The crowd roars as the %companyname%'s men step into the pit. One would be dumb to confuse excitement for desire, for as soon as the applause ends there is a smattering of empty beer mugs and rotten tomatoes and the general giggling delight of those watching the matter. You wonder if the %companyname%'s men are really best spent here, but then think hard on the gold and glory to be won, and that at the end of the day these mongrels in the stands will go home to their shit lives, and you'll go home to your shit life as well, but at least your pockets will be a bit deeper.}\n\n\n\n\n\n\n\nThe following characters will enter the arena:\n\n%bro1name%\n%bro2name%\n%bro3name%\n%bro4name%\n%bro5name%"
        es = "[img]gfx/ui/events/event_155.png[/img]{Mientras esperas tu turno, notas las láminas de polvo cayendo desde arriba por los estruendosos golpes de pies, como si la sed de sangre de la multitud se arrastrara en la oscuridad. Murmuran en anticipación y rugen ante las muertes. El silencio entre las batallas dura apenas un momento, y este silencio es arrebatado cuando la puerta oxidada se levanta, las cadenas chirriando, la multitud zumbando una vez más. Sales a la luz y el estruendo es tan atronador contra tu corazón que seguramente podría impulsar a un hombre muerto... | La multitud de la arena está hombro con hombro, la mayoría de ellos embriagados y balbuceantes. Gritan y vociferan en una mezcla de idiomas locales y extranjeros, aunque el llamado a su sed de sangre no necesita más que sus rostros enloquecidos y puños agitados. Ahora, los hombres de %companyname% saciarán a estos locos insensatos... | Los limpiadores se apresuran por la arena. Arrastran los cuerpos, recogen lo que vale la pena y ocasionalmente arrojan un trofeo a la multitud, provocando una versión casi caótica de las batallas de la arena en las gradas. %companyname% ahora forma parte de este espectáculo. | La arena espera, la multitud emocionada y el turno de %companyname% para ganar gloria está a la mano. | La multitud estalla en aplausos cuando los hombres de %companyname% avanzan hacia su sangriento foso. A pesar de la sed de sangre sin sentido de la gente, no puedes evitar sentir un latido de orgullo en tu pecho, sabiendo que es tu compañía la que está lista para ofrecer un espectáculo. | La puerta se levanta. Nada se escucha, solo el tintineo de cadenas, el crujido de poleas y los gruñidos de esclavos trabajando. Cuando los hombres de %companyname% salen de las entrañas del coliseo, pueden escuchar el crujir de la arena bajo sus pies hasta que llegan al centro del foso. Una extraña voz grita desde lo más alto del estadio, en un idioma perdido que desconoces, pero las palabras resuenan una sola vez antes de que la multitud estalle en vítores y rugidos. Ahora es el momento en que tus hombres demostrarán su valía ante el ojo vigilante del populacho. | Los negocios de %companyname% rara vez se llevan a cabo ante los ojos de aquellos que preferirían mantenerse distantes de tanta violencia. Pero en la arena, el populacho espera ávidamente la muerte y el sufrimiento, y ruge con sed de sangre cuando tus hombres entran a los fosos, y aplaude mientras los mercenarios sacan sus armas y se preparan para la batalla. | La arena tiene la forma del tajo de una herida, su techo desgarrado por los dioses, revelando la vanidad, la sed de sangre y la barbarie del ser humano. Y está el populacho allí, gritando y vociferando, esperando ver la sangre correr y regar la tierra, mientras se sonríen entre ellos como si fuera un simple juego. Los hombres lucharan entre ellos por trofeos mientras otros disfrutan del dolor ajeno. Y es ante este gentio que %companyname% luchará, y será a ellos a quien entretendrán. Lo harán bien. | La multitud de la arena es una mezcla de clases, ricos y pobres, porque solo los Visires se separan en palcos por encima de todos. Brevemente unidos, el pueblo de %townname% se han reunido para presenciar cómo hombres y monstruos se asesinan entre sí. Con placer, %companyname% se dispone a hacer su parte. | Niños sentados sobre los hombros de sus padres, niñas jóvenes arrojando flores a los gladiadores, mujeres abanicándose, hombres preguntándose si podrían hacerlo. Estos son los pueblos de la arena, y el resto están todos borrachos y vociferando sin sentido. Esperas que %companyname% pueda contribuir al menos una hora o dos para entretener a esta loca multitud. | La multitud ruge mientras los hombres de %companyname% entran en el foso. Sería una tontería confundir la emoción con el deseo, porque tan pronto como los aplausos terminan, hay una lluvia de jarras de cerveza vacías y tomates podridos, y la alegría generalizada de aquellos que observan el asunto. Te preguntas si los hombres de %companyname% realmente deben gastar su tiempo aquí, pero luego piensas en el oro y la gloria que pueden obtener, y que, a fin de cuentas, esta chusma en las gradas regresará a sus miserables vidas, al igual que tú, pero al menos tus bolsillos estarán un poco más llenos.}\n\n\n\n\n\n\n\nLos siguientes personajes entrarán en la arena:\n\n%bro1name%\n%bro2name%\n%bro3name%\n%bro4name%\n%bro5name%"
    }
    // context: arena_tournament_contract.o.createScreens.s.start
    {
        en = "\n\n\n\n\n\n\n\nThe following characters will enter the arena:\n\n%bro1name%\n%bro2name%\n%bro3name%\n%bro4name%\n%bro5name%"
        es = "\n\n\n\n\n\n\n\nLos siguientes personajes entrarán en la arena:\n\n%bro1name%\n%bro2name%\n%bro3name%\n%bro4name%\n%bro5name%"
    }
    // FILE: mod_legends\hooks\contracts\contracts\barbarian_king_contract.nut
    // context: barbarian_king_contract.o.create.m.Name
    {
        en = "The Winter King"
        es = "El Rey del Invierno"
    }
    // context: barbarian_king_contract.o.create.m.DescriptionTemplates
    {
        en = "Cold winds rise in the north. A terrible Barbarian King has emerged, dealing death and destruction to all in his path."
        es = "Se levantan vientos fríos en el norte. Ha surgido un terrible Rey Bárbaro que siembra muerte y destrucción a su paso."
    }
    // context: barbarian_king_contract.o.create.m.DescriptionTemplates
    {
        en = "From the icy wastes emerges a barbarian king, ready to conquer and rule the northern lands!"
        es = "¡De los páramos helados surge un rey bárbaro, dispuesto a conquistar y gobernar las tierras del norte!"
    }
    // context: barbarian_king_contract.o.create.m.DescriptionTemplates
    {
        en = "Behold, the rise of a barbarian king in the north, his might unmatched, his fury unstoppable!"
        es = "¡Contemplen el ascenso de un rey bárbaro en el norte, de poder sin igual y furia imparable!"
    }
    // context: barbarian_king_contract.o.create.m.DescriptionTemplates
    {
        en = "The northlands are ablaze with the rise of a barbarian king, his dominance unchallenged, his strength unmatched!"
        es = "¡Las tierras del norte arden con el ascenso de un rey bárbaro, de dominio incontestable y fuerza sin igual!"
    }
    // context: barbarian_king_contract.o.create.m.DescriptionTemplates
    {
        en = "The savage tribes of the north rally under the banner of their new king, a barbarian lord of unmatched ferocity."
        es = "Las tribus salvajes del norte se agrupan bajo el estandarte de su nuevo rey, un señor bárbaro de ferocidad sin igual."
    }
    // context: barbarian_king_contract.o.create.m.DescriptionTemplates
    {
        en = "A mighty barbarian king claims his throne in the frozen north, his rule marked by fire and steel."
        es = "Un poderoso rey bárbaro reclama su trono en el norte helado, y su reinado está marcado por el fuego y el acero."
    }
    // context: barbarian_king_contract.o.createScreens.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "los primitivos bárbaros" cambia el sentido de "those cut from the barbarian cloth"; queda "los que están cortados por el patrón bárbaro".
        // corrige base: "lo derrotes" suaviza "cut him down"; queda "lo abatas".
        // corrige base: "una planta exótica" no es "a tomato plant"; queda "una tomatera". "unas tijeras" pasa a "unas tijeras de esquilar" (goat shears) y se quita "al terminar", que el inglés no tiene.
        // corrige base: errata "quieren ser tener más"; se recupera "suzerain" como "señores de".
        // corrige base: "se gira hacia ti" no es "nods to you", y "adecuadamente" rebaja "quite well"; quedan "asiente hacia ti" y "muy bien".
        // corrige base: "no es la forma sino el propósito lo que importa" invierte "it is the shape and purpose that matters"; queda "lo que importa es la forma y el propósito".
        // corrige base: "suzerain" quedó en inglés; queda "soberano". "un cierto salvaje" pasa a "cierto primitivo" y "reúna a las tribus" a "reúna a las aldeas" (round up the villages).
        // corrige base: "un tipo fuerte" y "un montón de problemas" rebajan "strong sonuvabitch" y "heap of shit"; quedan "un hijo de puta muy fuerte" y "un montón de mierda". "ideas demasiado sabias sobre lo que es y no es ser rey" no recoge el sentido; queda "alguna idea brillante sobre de qué es soberano y de qué no".
        // corrige base: añade unas granjas y aldeas asaltadas y unos refugiados que el inglés no tiene ("the survivors trickled in"); queda "fueron llegando los supervivientes". Faltaba "nice" en "un vigoroso mercenario civilizado"; queda "un mercenario fornido, amable y civilizado".
        en = "[img]gfx/ui/events/event_45.png[/img]{%employer% is swinging a thin crown around %their_employer% finger. It is a cheap looking piece of metal, but no doubt a crown from somewhere. %They_employer% looks you up and down as the tin scrapes and skitters over %their_employer% fingernail and back again.%SPEECH_ON%I suspect I should have seen this coming. Men seek power, and those cut from the barbarian cloth are no different.%SPEECH_OFF%%They_employer% lets the crown slide down to %their_employer% knuckles where it hangs limply.%SPEECH_ON%The barbarians to the %direction% in the region of %region% are uniting under a so-called king. A savage so strong and nasty he threatens to get a horde and after that, well, I suspect he'll want to expand his realm south. I need you to go to this region, find this man, and cut him down.%SPEECH_OFF% | One of %employer%'s servants fetches you to a garden where you find the %person_employer% tending to a tomato plant. %They're_employer% pruning it with goat shears and nodding to %their_employer% own handiwork. %They_employer% talks loosely.%SPEECH_ON%My scouts tell me that a northern savage in %region% is gathering an army. A gathering of idiots is not too out of the ordinary for those primitives, but I do believe this one is proclaiming himself king. And kings, well, they wish to be suzerain over more than just what they got. They want what everyone else has got. What I got.%SPEECH_OFF%The %person_employer% pauses and nods to you.%SPEECH_ON%I need you to go to the region of %region%, find this so-called savage king, and kill him. It will not be easy, but you will be paid quite well.%SPEECH_OFF% | %employer% is surrounded by %their_employer% lieutenants. They regard you with sneers, but %employer% ignores their judgments and makes %their_employer% own.%SPEECH_ON%Ah, sellsword, I do believe a man of your chops is just the one I'm looking for. A barbarian in %region% has ordained himself king. He even wears a crown of some sort, probably of bone and antler, but it is the shape and purpose that matters. Not only matters to him, but to us. We can't allow him to live. I need you to go find this primitive and end him before he gathers an army too big for my fellow lieutenants here to deal with.%SPEECH_OFF% | %employer% welcomes you with a mug of ale. %They_employer% %themselves_employer% enjoys a goblet of wine.%SPEECH_ON%I've brought you here because there is a certain primitive in the region of %region% that I need killing. He is calling himself king, heh, suzerain over the savages. Well, while I don't respect his royal authority in the slightest, I know a budding threat when I see one. I can't wait around for this barbarian to round up the villages and gather an army. I need you to find him and kill him. It won't be easy, but you'll be paid well.%SPEECH_OFF%You now wonder if %they're_employer% slipping you ale to loosen you into accepting this absurd task. | %employer% is holding a pair of deer antlers with the crown still at the base. When %they_employer% puts it on his desk it stands upright as though still attached to its authorship.%SPEECH_ON%Word on the wind is that a savage in %region% is gathering an army. He is proclaiming himself king and if he can wrangle those primitives under his banner then that no doubt makes him a strong sonuvabitch. It also means we may be in a heap of shit here real soon if he isn't taken care of.%SPEECH_OFF%The %person_employer% knocks the antlers over and they fall upon their tips with hollow clacks.%SPEECH_ON%So that's what you're here for, sellsword. I need you to find this barbarian and put an end to him before he gets any wise ideas about what he is and isn't suzerain over.%SPEECH_OFF% | %employer%'s sitting in %their_employer% chair with pursed lips. %They're_employer% thumbing a dagger around, the tip of it auguring a divot into %their_employer% desk.%SPEECH_ON%My scouts to the %direction% started disappearing a little while ago. And then the survivors trickled in and with them tales of a barbarian proclaiming himself king of %region%. Now, do I need to conjure what the issue is with a savage ordaining himself ruler of a horde of primitives?%SPEECH_OFF%You tell %them_employer% you can imagine it keeps %them_employer% up at night. %employer% grins.%SPEECH_ON%Aye, that it does. So I need a man such as yourself, a strapping, nice, civilized sellsword. I need you to go and find this so-called king and kill him before he's got all those damn idiots marching under his banner.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_45.png[/img]{%employer% está balanceando una fina corona alrededor de su dedo. Es una pieza de metal de aspecto barato, pero sin duda una corona de algún lugar. Te mira de arriba abajo mientras el trozo de metal raspa y se desliza sobre su uña una y otra vez.%SPEECH_ON%Sospecho que debería haber visto esto venir. Los hombres buscan poder, y los que están cortados por el patrón bárbaro no son diferentes.%SPEECH_OFF%Deja que la corona se deslice hasta sus nudillos, donde cuelga lánguidamente.%SPEECH_ON%Los bárbaros al %direction%, en la región de %region%, se están uniendo bajo un autoproclamado rey. Un salvaje tan fuerte y desagradable que amenaza con reunir una horda y después de eso, bueno, sospecho que querrá expandir su reino hacia el sur. Necesito que vayas a esta región, encuentres a este hombre y lo abatas.%SPEECH_OFF% | Uno de los sirvientes de %employer% te lleva a un jardín donde encuentras %al_employer% %hombre_employer% cuidando de una tomatera. Está podándola con unas tijeras de esquilar y asiente ante su propia obra. Habla despreocupadamente.%SPEECH_ON%Mis exploradores me dicen que un salvaje del norte en %region% está reuniendo un ejército. Una reunión de idiotas no es nada fuera de lo común para esos primitivos, pero creo que este se está proclamando rey. Y los reyes, bueno, quieren ser señores de más de lo que ya poseen. Quieren lo que tienen todos los demás. Lo que tengo yo.%SPEECH_OFF%%Art_employer% %hombre_employer% hace una pausa y asiente hacia ti.%SPEECH_ON%Necesito que vayas a la región de %region%, encuentres a este supuesto rey salvaje y lo mates. No será fácil, pero se te pagará muy bien.%SPEECH_OFF% | %employer% está rodead%o_employer% por sus comandantes. Te miran con desprecio, pero %employer% hace caso omiso de sus prejuicios y forma los suyos propios.%SPEECH_ON%Ah, mercenario, creo que un hombre de tu talla es justo lo que estoy buscando. Un bárbaro en %region% se ha autoproclamado rey. Incluso lleva una corona de algún tipo, probablemente de hueso y asta, pero lo que importa es la forma y el propósito. No solo le importa a él, sino también a nosotros. No podemos permitir que viva. Necesito que vayas a encontrar a este primitivo y acabes con él antes de que reúna un ejército demasiado grande para que mis compañeros comandantes aquí presentes puedan lidiar con él.%SPEECH_OFF% | %employer% te da la bienvenida con una jarra de cerveza. Por su parte, disfruta de una copa de vino.%SPEECH_ON%Te he traído aquí porque hay cierto primitivo en la región de %region% al que necesito que mates. Se hace llamar rey, je, soberano de los salvajes. Bueno, aunque no respeto en lo más mínimo su autoridad real, sé reconocer una amenaza incipiente cuando la veo. No puedo quedarme esperando a que este bárbaro reúna a las aldeas y forme un ejército. Necesito que lo encuentres y lo mates. No será fácil, pero se te pagará bien.%SPEECH_OFF%Ahora te preguntas si te está ofreciendo cerveza para ablandarte y que aceptes esta absurda tarea. | %employer% sostiene un par de astas de ciervo con la corona todavía en la base. Cuando lo pone sobre su escritorio, se mantiene erguido como si aún estuviera unido a su portador.%SPEECH_ON%Las palabras que arrastra el viento dicen que un salvaje en %region% está reuniendo un ejército. Se proclama rey y, si puede reunir a esos primitivos bajo su bandera, eso sin duda lo convierte en un hijo de puta muy fuerte. También significa que podemos vernos metidos en un montón de mierda muy pronto si no nos ocupamos de él.%SPEECH_OFF%%Art_employer% %hombre_employer% tumba las astas, que caen sobre sus puntas con un chasquido hueco.%SPEECH_ON%Así que para eso estás aquí, mercenario. Necesito que encuentres a este bárbaro y le pongas fin antes de que se le ocurra alguna idea brillante sobre de qué es soberano y de qué no.%SPEECH_OFF% | %employer% está sentad%o_employer% en su silla con los labios fruncidos. Juega con una daga, cuya punta va abriendo un agujero en su escritorio.%SPEECH_ON%Hace un tiempo, mis exploradores al %direction% comenzaron a desaparecer. Y luego fueron llegando los supervivientes, y con ellos historias de un bárbaro que se proclamaba rey de %region%. Ahora, ¿necesito explicarte cuál es el problema de que un salvaje se autoproclame gobernante de una horda de primitivos?%SPEECH_OFF%Le dices que te imaginas que eso no %lo_employer% deja dormir por la noche. %employer% sonríe.%SPEECH_ON%Sí, así es. Así que necesito a un hombre como tú, un mercenario fornido, amable y civilizado. Necesito que vayas, encuentres a este autoproclamado rey y lo mates antes de que tenga a todos esos malditos idiotas marchando bajo su estandarte.%SPEECH_OFF%}"
    }
    // en = "Victory"
    // en base_es
    // context: barbarian_king_contract.o.createScreens.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: falta el punto final tras "%employer%".
        // corrige base: "Haces un corte en su cuello" rebaja "You chop into his neck"; queda "Le asestas un tajo en el cuello". "accesorios nativos" pasa a "pertrechos propios" (accoutrements native to).
        en = "[img]gfx/ui/events/event_145.png[/img]{The Barbarian King is dead. Though he adorned himself the title of royalty, he lies amongst the dead like any other of his people. A savage. A primitive. With a slightly hardier body and some accoutrements native to his warring and pillaging and ravaging. Little else distinguishes him. You chop into his neck with your sword and put your boot to his face as you cut him clean off the shoulders. %randombrother% takes the heavy head and drops it into a knapsack. You order the men to scavenge what they can before preparing a return to %employer%.}"
        es = "[img]gfx/ui/events/event_145.png[/img]{El Rey Bárbaro está muerto. Aunque se adornó con el título de realeza, yace entre los muertos como cualquier otro de su pueblo. Un salvaje. Un primitivo. Con un cuerpo algo más robusto y algunos pertrechos propios de sus guerras, saqueos y estragos. Poco más lo distingue. Le asestas un tajo en el cuello con tu espada y le pones la bota en la cara mientras le separas la cabeza limpiamente de los hombros. %randombrother% toma la pesada cabeza y la mete en una mochila. Ordenas a los hombres que recojan lo que puedan antes de emprender el regreso con %employer%.}"
    }
    // context: barbarian_king_contract.o.createScreens.::Legends.Screens.hook()
    // en = "AGreaterThreat2"
    // identificador de pantalla
    // context: barbarian_king_contract.o.createScreens.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "niegas hacia el anciano" contradice "nod toward the elder"; queda "señalas al anciano con la cabeza".
        en = "[img]gfx/ui/events/event_136.png[/img]{You spit and nod toward the elder.%SPEECH_ON%We walked past burned homes, raped women, and slain men just to find your sorry lot, and now you want to band together? We ain't allies. We ain't friends. Tell your so-called 'King' to pray to whatever shit gods you...%SPEECH_OFF%The elder holds his hand up and talks with the king in their native tongue. The two men nod, turn, and leave. %randombrother% laughs.%SPEECH_ON%Brevity is the soul of scorn, captain.%SPEECH_OFF%You tell the %person_randombrother% to get back to the battle line and prepare for the fight ahead.}"
        es = "[img]gfx/ui/events/event_136.png[/img]{Escupes y señalas al anciano con la cabeza.%SPEECH_ON%Hemos pasado por casas incendiadas, mujeres violadas y hombres asesinados solo para encontrarnos con tu miserable grupo, ¿y ahora quieren que nos unamos? No somos aliados. No somos amigos. Dile a tu supuesto 'Rey' que rece a los dioses de mierda que...%SPEECH_OFF%El anciano levanta la mano y habla con el rey en su lengua nativa. Los dos hombres asienten, se dan la vuelta y se van. %randombrother% se ríe.%SPEECH_ON%La brevedad es el alma del desprecio, capitán.%SPEECH_OFF%Le dices que vuelva a la línea de batalla y se prepare para la lucha que se avecina.}"
    }
    // context: barbarian_king_contract.o.createScreens.::Legends.Screens.hook()
    // en = "AGreaterThreat5"
    // identificador de pantalla
    // context: barbarian_king_contract.o.createScreens.::Legends.Screens.hook()
    // en = "Success1"
    // identificador de pantalla
    // context: barbarian_king_contract.o.createScreens.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "la solapa del cuello" y "arrastrarla por el pelo" no traducen "the flap of neck"; queda "el colgajo del cuello" en los dos sitios. "Tu empleador dice" pasa a "Dice tu empleador".
        // corrige base: "los recorre con su lengua" no es "mimics picking at them"; queda "imita que se los escarba". "¿Cómo se limpian los dientes?" pierde "like that"; queda "¿Cómo se limpia uno unos dientes así?".
        // corrige base: "Es la cabeza más grande" omite "fucking"; queda "Es la puta cabeza más grande".
        // corrige base: "Tráeme una lanza" no es "a pike"; queda "una pica".
        // corrige base: "¡Un salvaje para luchar contra un salvaje!" es pregunta en el inglés; queda entre signos de interrogación. "casi eras como un salvaje" pasa a "casi parecías un primitivo" (a primitive).
        // corrige base: "la haré rellenar" pasa a "la haré disecar" (stuffed). "bolsa de monedas" pasa a "bolsa de coronas" (satchel of crowns), y se arregla la frase torcida "se trata de la cabeza de un hombre a la que se refiere".
        en = "[img]gfx/ui/events/event_31.png[/img]{%employer% takes the Barbarian King's head and rolls it out of the sack. It tumbles freely, knocking over a tray of goblets which go scattering and clattering about. Even in death the savage is a purveyor of chaos.%SPEECH_ON%Thank you, sellsword.%SPEECH_OFF%Your employer says, nodding to %themselves_employer% as %they_employer% rights the head and tilts it onto the flap of neck.%SPEECH_ON%He is an ugly mutt, isn't he? Look at those teeth. Look at them! There's holes in those teeth. Absolutely disgusting.%SPEECH_OFF%You tell the %person_employer% to pay you and %they_employer% does so as agreed. But %they_employer% keeps shaking %their_employer% head and %they_employer% bares %their_employer% own teeth and mimics picking at them.%SPEECH_ON%How do you clean teeth like that? With a rope?%SPEECH_OFF%Shrugging, you head out the door, not bothering to tell %employer% that the first thing your men did to that godforsaken head is knife the gold out of its mouth. | You dump the Barbarian King's head onto %employer%'s table. %They_employer% stares at it, then at you.%SPEECH_ON%That's the biggest fucking head I've ever seen.%SPEECH_OFF%Nodding, you ask for your pay and it is delivered in appropriate sum. Your employer starts pushing the savage's face around, as though %they_employer% was a sorcerer looking to steal its secrets.%SPEECH_ON%I'd wager this is where tales of ogres come from, yeah? Like a child sees this ugly thing and there it is, his imagination is set alight, and so the monster is born.%SPEECH_OFF%If only things were that simple. | Even without its massive body the head of the Barbarian King makes quite the splash when shown to %employer%. A host of nobles and servants ooh and ahh at the size of it. A man in a black robe is quick to pay you what you're owed. %employer% %themselves_employer% picks the head up and tosses it into the air as to weigh it.%SPEECH_ON%By the old gods, it is truly heavy! Oy %randomname%.%SPEECH_OFF%A servant steps forward. Your employer grins.%SPEECH_ON%Fetch me a pike. We're going to hoist this horror head high into the heavens.%SPEECH_OFF%A suitable stop for a savage. | Mere moments after giving %employer% the head of the Barbarian King it is being used as a plaything. Children of noblemen roll it back and forth across the stone floor, the savage's head knocking over walls of goblets and fortresses of dinner trays. A dog barks as it tracks the head back and forth. %employer% claps you on the shoulder.%SPEECH_ON%Outstanding work, sellsword. Truly. My scouts tell me it was a hell of a fight, that you were almost like a primitive yourself. But I suppose that's what it had to take, right? A savage to fight a savage? Spirit of such primacy can't be contained by our civilized ways!%SPEECH_OFF%One of the kids kicks the King in the face, breaking its jaw and cutting the child's foot on the teeth. The kid screams for help and, perhaps defending its owner, the dog sets upon the head and starts dragging it around by the flap of neck. %employer% smiles again.%SPEECH_ON%Your pay is waiting for you outside. It is in full, as promised.%SPEECH_OFF% | A man in knight's armor takes the Barbarian King's head from you. Immediately, you draw your sword, but %employer% leaps in to end any start to violence.%SPEECH_ON%Oy, sellsword, it is quite alright. Your pay, as promised.%SPEECH_OFF%The %person_employer% hands you a satchel of crowns, but behind %them_employer% you see the head being given to a man in a black cloak. You nod and ask what they intend to do with it. %employer% grins.%SPEECH_ON%Frankly, steins await me, sellsword, and I'm quite thirsty.%SPEECH_OFF%The %person_employer% quickly walks past you. You do not see any ale, or any drink at all, %they_employer% simply follows the man in the cloak. | %employer% stares at the Barbarian King's head like a cat would meanly stare at anything not its own self.%SPEECH_ON%Interesting. I think I'll have it stuffed and put upon my mantle.%SPEECH_OFF%Speaking slightly out of turn, you remind your employer that it is the head of a man he is referring to. %employer% shrugs.%SPEECH_ON%So? It is a monstrosity. There cannot be coexistence between the civilized and the savage. By having it properly taken care of I will ruminate on that reality. What will you do? Advise me again?%SPEECH_OFF%Pursing your lips, you ask for your pay. The %person_employer% points toward the corner.%SPEECH_ON%In the satchel there. You did well, sellsword, but don't speak to me in such a manner again. Good day.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_31.png[/img]{%employer% toma la cabeza del Rey Bárbaro y la hace rodar fuera del saco. Rueda libremente y derriba una bandeja de copas que se esparcen con estrépito. Incluso muerto, el salvaje es un promotor del caos.%SPEECH_ON%Gracias, mercenario.%SPEECH_OFF%Dice tu empleador, asintiendo para sí mientras endereza la cabeza y la apoya sobre el colgajo del cuello.%SPEECH_ON%Es un chucho feo, ¿verdad? Mira esos dientes. ¡Míralos! Esos dientes están llenos de agujeros. Absolutamente repugnante.%SPEECH_OFF%Le dices que te pague y lo hace según lo acordado. Pero sigue sacudiendo la cabeza, enseña sus propios dientes e imita que se los escarba.%SPEECH_ON%¿Cómo se limpia uno unos dientes así? ¿Con una cuerda?%SPEECH_OFF%Encogiéndote de hombros, te diriges hacia la puerta, sin molestarte en decirle a %employer% que lo primero que hicieron tus hombres con esa maldita cabeza fue sacarle el oro de la boca a punta de cuchillo. | Dejas caer la cabeza del Rey Bárbaro sobre la mesa de %employer%. La mira y luego te mira a ti.%SPEECH_ON%Es la puta cabeza más grande que he visto en mi vida.%SPEECH_OFF%Asintiendo, pides tu paga y se te entrega en la cantidad acordada. Tu empleador empieza a mover la cara del salvaje de un lado a otro, como si fuera %un_employer% hechicer%o_employer% que buscara robarle sus secretos.%SPEECH_ON%Apostaría a que de aquí vienen los cuentos de ogros, ¿no crees? Un niño ve esta cosa fea y ahí lo tienes, su imaginación se enciende, y así nace el monstruo.%SPEECH_OFF%Si tan solo las cosas fueran tan simples. | Incluso sin su enorme cuerpo, la cabeza del Rey Bárbaro causa sensación cuando se la muestras a %employer%. Una multitud de nobles y sirvientes exclaman asombrados por su tamaño. Un hombre con una túnica negra se apresura a pagarte lo que se te debe. %employer% en persona levanta la cabeza y la lanza al aire como para sopesarla.%SPEECH_ON%¡Por los antiguos dioses, sí que pesa! Oye, %randomname%.%SPEECH_OFF%Un sirviente se adelanta. Tu empleador sonríe.%SPEECH_ON%Tráeme una pica. Vamos a alzar esta horrible cabeza bien alto, hasta los cielos.%SPEECH_OFF%Un final adecuado para un salvaje. | Apenas unos momentos después de entregarle a %employer% la cabeza del Rey Bárbaro, ya la usan como juguete. Los hijos de los nobles la hacen rodar de un lado a otro por el suelo de piedra, y la cabeza del salvaje derriba muros de copas y fortalezas de bandejas de la cena. Un perro ladra mientras sigue la cabeza de un lado a otro. %employer% te da una palmada en el hombro.%SPEECH_ON%Un trabajo sobresaliente, mercenario. De verdad. Mis exploradores me dicen que fue una pelea infernal, que casi parecías un primitivo. Pero supongo que eso era lo que hacía falta, ¿verdad? ¿Un salvaje para luchar contra un salvaje? ¡Un espíritu tan primario no puede contenerse con nuestras costumbres civilizadas!%SPEECH_OFF%Uno de los niños le da una patada al Rey en la cara, le rompe la mandíbula y se corta el pie con los dientes. El niño grita pidiendo ayuda y, quizá en defensa de su dueño, el perro se lanza sobre la cabeza y empieza a arrastrarla por el colgajo del cuello. %employer% vuelve a sonreír.%SPEECH_ON%Tu paga te espera afuera. Está completa, como se prometió.%SPEECH_OFF% | Un hombre con armadura de caballero te arrebata la cabeza del Rey Bárbaro. Al instante desenvainas tu espada, pero %employer% se interpone para cortar de raíz cualquier conato de violencia.%SPEECH_ON%Vamos, mercenario, no pasa nada. Tu paga, como se prometió.%SPEECH_OFF%%Art_employer% %hombre_employer% te entrega una bolsa de coronas, pero detrás de %el_employer% ves que le entregan la cabeza a un hombre con una capa negra. Asientes y preguntas qué piensan hacer con ella. %employer% sonríe.%SPEECH_ON%Francamente, me esperan jarras de cerveza, mercenario, y tengo mucha sed.%SPEECH_OFF%%Art_employer% %hombre_employer% pasa rápidamente junto a ti. No ves cerveza alguna, ni bebida de ningún tipo: simplemente sigue al hombre de la capa. | %employer% mira la cabeza del Rey Bárbaro como un gato miraría con malicia cualquier cosa que no fuera él mismo.%SPEECH_ON%Interesante. Creo que la haré disecar y la pondré sobre la repisa de la chimenea.%SPEECH_OFF%Hablando un poco más de la cuenta, le recuerdas a tu empleador que está hablando de la cabeza de un hombre. %employer% se encoge de hombros.%SPEECH_ON%¿Y qué? Es una monstruosidad. No puede haber coexistencia entre lo civilizado y lo salvaje. Al tenerla debidamente disecada, reflexionaré sobre esa realidad. ¿Qué vas a hacer? ¿Darme consejos otra vez?%SPEECH_OFF%Frunciendo los labios, pides tu paga. %Art_employer% %hombre_employer% señala hacia el rincón.%SPEECH_ON%Ahí, en la bolsa. Lo hiciste bien, mercenario, pero no vuelvas a hablarme de esa manera. Buen día.%SPEECH_OFF%}"
    }
    // en = "Success2"
    // context: barbarian_king_contract.o.createScreens.::Legends.Screens.hook()._screen.Text
    {
        // corrige base: "su cabeza pagana" omite "fat"; queda "con su gorda cabeza pagana o sin ella". "sus tierras" pasa a "estas tierras" (the lands).
        en = "[img]gfx/ui/events/event_31.png[/img]{%employer% welcomes you reluctantly.%SPEECH_ON%You realize I have scouts and spies everywhere, don't you?%SPEECH_OFF%Holding up your empty hands, you tell %them_employer% you had no intent on lying. The 'barbarian king' will bother the lands no more. Your employer taps %their_employer% fingers together a few times then nods.%SPEECH_ON%Your honesty is refreshing, though I must say it is quite unfortunate the man and his warband still live. That said, all reports suggest they are moving away so I suppose your work is done all the same, a fat pagan head or not. Your pay, as agreed upon.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_31.png[/img]{%employer% te recibe a regañadientes.%SPEECH_ON%Te das cuenta de que tengo exploradores y espías por todas partes, ¿verdad?%SPEECH_OFF%Levantando las manos vacías, le dices que no tenías intención de mentir. El 'rey bárbaro' ya no molestará más a estas tierras. %employer% junta las yemas de los dedos unas cuantas veces y luego asiente.%SPEECH_ON%Tu honestidad es refrescante, aunque debo decir que es bastante desafortunado que ese hombre y su hueste sigan con vida. Dicho esto, todos los informes sugieren que se están alejando, así que supongo que tu trabajo está hecho de todos modos, con su gorda cabeza pagana o sin ella. Tu paga, como se acordó.%SPEECH_OFF%}"
    }
    // FILE: mod_legends\hooks\contracts\contracts\big_game_hunt_contract.nut
    // context: big_game_hunt_contract.o.create.m.DescriptionTemplates
    {
        // "Foul beasts, ghouls and other monstrosities are roaming the land with impunity. %s needs someone of your caliber to slay them all.",
        mode = "pattern"
        en = "Foul beasts, ghouls and other monstrosities are roaming the land with impunity. [color=<c1:str>]<s1:str>[/color] needs someone of your caliber to slay them all."
        es = "Bestias inmundas, necrófagos y otras monstruosidades vagan por estas tierras con total impunidad. [color=<c1>]<s1>[/color] necesita a alguien de tu calibre para matarlos a todos."
    }
    // context: big_game_hunt_contract.o.create.m.DescriptionTemplates
    {
        en = "Seeking fearless hunters! A monster hunt contract of great reward beckons!"
        es = "¡Se buscan cazadores intrépidos! ¡Aguarda un contrato de caza de monstruos con una gran recompensa!"
    }
    // context: big_game_hunt_contract.o.create.m.DescriptionTemplates
    {
        // "%s is calling all skilled hunters to join an open monster hunt contract for honor and coin.",
        mode = "pattern"
        en = "[color=<c1:str>]<s1:str>[/color] is calling all skilled hunters to join an open monster hunt contract for honor and coin."
        es = "[color=<c1>]<s1>[/color] convoca a todos los cazadores hábiles a sumarse a un contrato abierto de caza de monstruos a cambio de honor y monedas."
    }
    // context: big_game_hunt_contract.o.create.m.DescriptionTemplates
    {
        // "Daring souls wanted! Take up arms for %s and kill monsters for great rewards.",
        mode = "pattern"
        en = "Daring souls wanted! Take up arms for [color=<c1:str>]<s1:str>[/color] and kill monsters for great rewards."
        es = "¡Se buscan almas audaces! Empuña las armas por [color=<c1>]<s1>[/color] y mata monstruos a cambio de grandes recompensas."
    }
    // context: big_game_hunt_contract.o.create.m.DescriptionTemplates
    {
        en = "Fields lay barren, and homes abandoned, as monster attacks ravage a once thriving region."
        es = "Los campos yacen yermos y los hogares abandonados, mientras los ataques de monstruos asolan una región antaño próspera."
    }
    // context: big_game_hunt_contract.o.create.m.DescriptionTemplates
    {
        en = "Life in the region has become a struggle, overshadowed by the constant threat of monster attacks."
        es = "La vida en la región se ha vuelto una lucha constante, ensombrecida por la amenaza continua de los ataques de monstruos."
    }
    // en = "Hunt for Direwolves, Webknechts, Nachzehrers, Hyenas and Serpents"
    // en base_es
