        en = "Inflicts 3 bleeds each dealing a stacking [color=%damage%]<dmg:int>[/color] bleeding damage per turn, for 2 turns"
        es = "Inflige [color=%damage%]3[/color] sangrados que causan cada uno [color=%damage%]<dmg>[/color] de daño por sangrado acumulable por turno, durante [color=%damage%]2[/color] turnos"
    }
    // FILE: scripts\skills\actives\legend_flogging_skill.nut
    // context: legend_flogging_skill.create.m.Description
    {
        en = "Whip the flesh of someone nearby to inflict a slow bleed."
        es = "Azota la carne de alguien cercano para infligirle un sangrado lento."
    }
    // context: legend_flogging_skill.create.m.KilledString
    {
        en = "Flogged"
        es = "Azotado"
    }
    // context: legend_flogging_skill.create.m.Overlay
    // en = "bleed"  // interna: m.Overlay es el nombre de la imagen superpuesta del icono, no se muestra como texto
    // context: legend_flogging_skill.getTooltip.ret.push().text
    {
        en = "Flog up to three targets, inflicting a bleed of 2 damage per turn over 5 turns"
        es = "Azota hasta a tres objetivos y les inflige un sangrado de [color=#135213]2[/color] de daño por turno durante [color=#135213]5[/color] turnos"
    }
    // context: legend_flogging_skill.onUse.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(_user) + " flogged " + this.Const.UI.getColorizedEntityName(nextTile.getEntity()) + " leaving them bleeding");
        mode = "pattern"
        en = "<user:str> flogged <target:str> leaving them bleeding"
        es = "<user> azotó a <target> y le provocó un sangrado"
    }
    // FILE: scripts\skills\actives\legend_flourish_skill.nut
    // context: legend_flourish_skill.create.m.Description
    {
        en = "Prepare to show your enemies a dazzling display of swordsmanship."
        es = "Prepárate para ofrecer a tus enemigos un deslumbrante despliegue de esgrima."
    }
    // context: legend_flourish_skill.getTooltip.text
    {
        en = "Increases fatigue use of all attack skills by [color=%positive%]75%[/color]"
        es = "Aumenta en un [color=%negative%]75%[/color] el gasto de Fatiga de todas las habilidades de ataque"
    }
    // context: legend_flourish_skill.getTooltip.text
    {
        en = "Increases Action Point cost of all attack skills by [color=%positive%]1[/color]"
        es = "Aumenta en [color=%negative%]1[/color] el coste en Puntos de acción de todas las habilidades de ataque"
    }
    // context: legend_flourish_skill.getTooltip.text
    {
        en = "Chance on each attack to ignore armor completely, the chance is [color=%positive%]50%[/color] of the Initiative difference between you and the target as long as you are faster"
        es = "Cada ataque tiene una probabilidad de ignorar por completo la armadura igual al [color=%positive%]50%[/color] de la diferencia de Iniciativa entre tú y el objetivo, siempre que tu Iniciativa sea mayor"
    }
    // context: legend_flourish_skill.getTooltip.text
    {
        en = "As long as you are faster than the target, any attack that inflicts at least [color=%positive%]1[/color] point of damage to Hitpoints triggers a morale check for the opponent with a penalty equal to [color=%negative%]20%[/color] of the Initiative difference between you and the target"
        es = "Mientras tu Iniciativa sea mayor que la del objetivo, cualquier ataque que inflija al menos [color=%positive%]1[/color] punto de daño a los Puntos de vida provoca una comprobación de moral al oponente con una penalización igual al [color=%positive%]20%[/color] de la diferencia de Iniciativa entre tú y el objetivo"
    }
    // FILE: scripts\skills\actives\legend_fortify_skill.nut
    // context: legend_fortify_skill.create.m.Description
    {
        en = "The shield is raised to a fortified stance until next turn."
