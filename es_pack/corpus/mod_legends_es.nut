        en = "The cost the XP that would be granted by killing the enemy, to the power of 1.3. Hover over an enemy while preparing this skill to update the tooltip."
        es = "El coste es la experiencia que daría matar al enemigo, elevada a 1,3. Pasa el cursor sobre un enemigo mientras preparas esta habilidad para actualizar la descripción."
    }
    // FILE: scripts\skills\actives\legend_buckler_bash_skill.nut
    // context: legend_buckler_bash_skill.create.m.Description
    {
        en = "A quick punch forward with a solid buckler. Anyone hit with a blow like this will be dazed and gasping for air, unable to put full force behind their blows for two turns."
        es = "Un rápido golpe hacia delante con una rodela sólida. Quien reciba un golpe así quedará atontado y sin aliento, incapaz de poner toda su fuerza en sus golpes durante dos turnos."
    }
    // context: legend_buckler_bash_skill.create.m.KilledString
