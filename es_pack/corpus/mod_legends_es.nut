        en = "This settlement is expanding with a new location, building materials are in high demand and low supply."
        es = "Este asentamiento se está ampliando con una nueva ubicación; los materiales de construcción tienen una gran demanda y una oferta escasa."
    }
    // context: legend_building_effort_situation.create.m.Rumors
    {
        en = "Been seein' lots of materials coming through 'ere to the %direction%..."
        es = "Llevo días viendo pasar un montón de materiales por aquí rumbo al %direction%..."
    }
    // context: legend_building_effort_situation.getDescription
    {
        // return "In an effort to build the new " + this.m.Target.tolower() + ", building materials are in high demand and low supply.";
        // corrige base: «Los» va en minúscula tras la coma; además «el cercano <target>» fija el masculino aunque el lugar pueda ser femenino.
        mode = "pattern"
        en = "In an effort to build the new <target:str>, building materials are in high demand and low supply."
        es = "En un esfuerzo por construir la nueva instalación (<target>), los materiales de construcción tienen una gran demanda y una oferta escasa."
    }
    // FILE: scripts\entity\world\settlements\situations\legend_degrading_effort_situation.nut
    // context: legend_degrading_effort_situation.create.m.Name
    {
        en = "Town "
        es = "Pueblo"
    }
    // context: legend_degrading_effort_situation.create.m.Description
    {
        en = "This settlement can no longer sustain its current size and is undergoing efforts to still remain productive during these difficult times."
        es = "Este asentamiento ya no puede sostener su tamaño actual y se esfuerza por seguir siendo productivo en estos tiempos difíciles."
    }
    // context: legend_degrading_effort_situation.create.m.Rumors
    {
        en = "'Lots of people comin' out from %direction% lately..."
        es = "Últimamente está llegando mucha gente del %direction%..."
    }
    // FILE: scripts\entity\world\settlements\situations\legend_merc_company_disbands_situation.nut
    // context: legend_merc_company_disbands_situation.create.m.Name
    {
        en = "Mercenaries For Hire"
        es = "Mercenarios disponibles"
    }
    // context: legend_merc_company_disbands_situation.create.m.Description
    {
        en = "A mercenary company has recently disbanded, leaving their highly trained fighters to fend for themselves."
        es = "Una compañía de mercenarios se ha disuelto hace poco y ha dejado a su suerte a sus combatientes, muy bien entrenados."
    }
    // context: legend_merc_company_disbands_situation.create.m.Rumors
    {
        // "The battle at %settlement%? Gods, what a massacre! I heard a group \' sellswords got themselves in a tight place with somthin\' fierce. Company commander quit on the spot before the battle was even over! Lots \'o them lookin\' fer work now...",
        mode = "pattern"
        en = "The battle at %settlement%? Gods, what a massacre! I heard a group ' sellswords got themselves in a tight place with somthin' fierce. Company commander quit on the spot before the battle was even over! Lots 'o them lookin' fer work now..."
        es = "¿La batalla de %settlement%? ¡Dioses, qué masacre! Oí que un grupo de mercenarios se metió en un buen lío con algo feroz. ¡El comandante de la compañía lo dejó ahí mismo, antes de que terminara la batalla! Ahora hay un montón de ellos buscando trabajo..."
    }
    // context: legend_merc_company_disbands_situation.create.m.Rumors
    {
        // "There\'s a bunch of good fighters over at %settlement%, company comman\'r couldn't pay \'em so they sit all day in the square pickin\' their boots and spittin\' at people.",
        mode = "pattern"
        en = "There's a bunch of good fighters over at %settlement%, company comman'r couldn't pay 'em so they sit all day in the square pickin' their boots and spittin' at people."
        es = "Hay un montón de buenos combatientes en %settlement%; el comandante de su compañía no podía pagarles, así que se pasan el día sentados en la plaza, hurgándose las botas y escupiéndole a la gente."
    }
    // context: legend_merc_company_disbands_situation.create.m.Rumors
    {
        // "I hear there\'s a large group of sellswords over at %settlement% without a banner to stand under. If you get there quick you might pick up a few good fighters before the Militia or Nobles do!"
        mode = "pattern"
        en = "I hear there's a large group of sellswords over at %settlement% without a banner to stand under. If you get there quick you might pick up a few good fighters before the Militia or Nobles do!"
        es = "Dicen que en %settlement% hay un buen grupo de mercenarios sin estandarte bajo el que formar. ¡Si llegas rápido, a lo mejor te haces con unos cuantos buenos combatientes antes que los milicianos o los nobles!"
    }
    // FILE: scripts\entity\world\settlements\situations\legend_militant_townsfolk_situation.nut
    // context: legend_militant_townsfolk_situation.create.m.Name
    {
        en = "Militant Townsfolk"
        es = "Vecinos militantes"
    }
    // context: legend_militant_townsfolk_situation.create.m.Description
    {
        en = "The local townsfolk have had enough of the constant attacks on their village. They are setting aside their livelihoods, turning their tools into weapons, and banding together to fight back."
        es = "Los lugareños están hartos de los constantes ataques a su aldea. Dejan de lado su sustento, convierten sus herramientas en armas y se unen para contraatacar."
    }
    // context: legend_militant_townsfolk_situation.create.m.Rumors
    {
        // "My sister-in-law in %settlement% told me that they\'ve had enough of being beaten around. They\'re all up in arms now and spoiling for a fight!",
        mode = "pattern"
        en = "My sister-in-law in %settlement% told me that they've had enough of being beaten around. They're all up in arms now and spoiling for a fight!"
        es = "Mi cuñada de %settlement% me contó que ya se hartaron de que los muelan a palos. ¡Ahora están todos en armas y con ganas de pelea!"
    }
    // context: legend_militant_townsfolk_situation.create.m.Rumors
    {
        // "If you\'re looking to hire more mercenaries, you should visit %settlement%. I heard many of them are eager to take the fight back to their enemies.",
        mode = "pattern"
        en = "If you're looking to hire more mercenaries, you should visit %settlement%. I heard many of them are eager to take the fight back to their enemies."
        es = "Si buscas contratar más mercenarios, deberías visitar %settlement%. Oí que muchos de ellos están deseando devolverles el golpe a sus enemigos."
    }
    // context: legend_militant_townsfolk_situation.create.m.Rumors
    {
        // "Be careful if you\'re passing through %settlement%. I hear the locals there are ready to go to war against anyone who crosses them!"
        mode = "pattern"
        en = "Be careful if you're passing through %settlement%. I hear the locals there are ready to go to war against anyone who crosses them!"
        es = "Ten cuidado si pasas por %settlement%. ¡Dicen que los lugareños de allí están listos para ir a la guerra contra cualquiera que se les cruce!"
    }
    // en = "<actor:str> now has <name:str>"
    // en base_es
    // en = "<actor:str> no longer has <name:str>"
    // en base_es
    // FILE: scripts\entity\world\settlements\situations\legend_rallied_militia_situation.nut
    // context: legend_rallied_militia_situation.create.m.Name
    {
        en = "Rallied Militia"
        es = "Milicia reunida"
    }
    // context: legend_rallied_militia_situation.create.m.Description
    {
        en = "The local militia has banded togeather with new recruits to deal with some of the local problems themselves. At a great cost."
        es = "Los milicianos locales se han unido a nuevos reclutas para resolver por su cuenta algunos de los problemas de la zona. A un gran precio."
    }
    // context: legend_rallied_militia_situation.create.m.Rumors
    {
        // "I recently got out of the militia at %settlement%. Big battle. Lots of blood. No problems there now but it still drags on my mind...",
        mode = "pattern"
        en = "I recently got out of the militia at %settlement%. Big battle. Lots of blood. No problems there now but it still drags on my mind..."
        es = "Hace poco salí de la milicia de %settlement%. Una gran batalla. Mucha sangre. Allí ya no hay problemas, pero todavía me ronda la cabeza..."
    }
    // context: legend_rallied_militia_situation.create.m.Rumors
    {
        // "You headed to %settlement%? Don\'t bother. The locals got tired of waitin\' for you lot to appear and took matters into their own \'ands.",
        mode = "pattern"
        en = "You headed to %settlement%? Don't bother. The locals got tired of waitin' for you lot to appear and took matters into their own 'ands."
        es = "¿Van pa' %settlement%? No se molesten. Los lugareños se cansaron de esperar a que aparecieran ustedes y tomaron el asunto en sus propias manos."
    }
    // context: legend_rallied_militia_situation.create.m.Rumors
    {
        // "Word is %settlement% cobbled togeather enough crowns to solve their problems. Shame you weren\'t there to find the easy work. A lot of folks died in those fights."
        mode = "pattern"
        en = "Word is %settlement% cobbled togeather enough crowns to solve their problems. Shame you weren't there to find the easy work. A lot of folks died in those fights."
        es = "Dicen que en %settlement% juntaron coronas suficientes para resolver sus problemas. Lástima que no estuvieran ahí para llevarse el trabajo fácil. Murió mucha gente en esas peleas."
    }
    // FILE: scripts\entity\world\settlements\situations\legend_upgrading_effort_situation.nut
    // context: legend_upgrading_effort_situation.create.m.Name
    {
        en = "Upgrading Effort"
        es = "Obras de mejora"
    }
    // context: legend_upgrading_effort_situation.create.m.Description
    {
        en = "This settlement is in the process of upgrading, building materials are in high demand and low supply."
        es = "Este asentamiento está en proceso de mejora; los materiales de construcción tienen una gran demanda y una oferta escasa."
    }
    // context: legend_upgrading_effort_situation.getDescription
    {
        en = "In an effort to expand and upgrade the settlement, building materials are in high demand and low supply."
        es = "En un esfuerzo por ampliar y mejorar el asentamiento, los materiales de construcción tienen una gran demanda y una oferta escasa."
    }
    // FILE: scripts\entity\world\settlements\situations\legend_upgrading_locations_effort_situation.nut
    // context: legend_upgrading_locations_effort_situation.create.m.Name
    {
        en = "Upgrading Max Locations Effort"
        es = "Obras de ampliación"
    }
    // FILE: scripts\entity\world\settlements\situations\legend_word_of_mouth_situation.nut
    // context: legend_word_of_mouth_situation.create.m.Name
    {
        en = "Word of Mouth"
        es = "Boca a boca"
    }
    // context: legend_word_of_mouth_situation.create.m.Description
    {
        en = "Locals witnessed your recent exploits and are singing your praises. Merchants are eager to give you a discount, and some starry-eyed locals are hoping to join your company."
        es = "Los lugareños presenciaron tus recientes hazañas y cantan tus alabanzas. Los mercaderes están deseando hacerte un descuento, y algunos lugareños deslumbrados esperan unirse a tu compañía."
    }
    // context: legend_word_of_mouth_situation.create.m.Rumors
    {
        // "Say, aren\'t you one of the %companyname%? I heard about the things you lot did for %settlement% recently. Would be nice if you could do the same for our town too.",
        mode = "pattern"
        en = "Say, aren't you one of the %companyname%? I heard about the things you lot did for %settlement% recently. Would be nice if you could do the same for our town too."
        es = "Oye, ¿no eres de %companyname%? Oí lo que hicieron ustedes por %settlement% hace poco. Estaría bien que hicieran lo mismo por nuestro pueblo."
    }
    // context: legend_word_of_mouth_situation.create.m.Rumors
    {
        // "A couple of young \'uns passed by on their way to %settlement% recently. Said they\'d heard the %companyname% had done some good work there, and wanted to join up."
        mode = "pattern"
        en = "A couple of young 'uns passed by on their way to %settlement% recently. Said they'd heard the %companyname% had done some good work there, and wanted to join up."
        es = "Hace poco pasaron por aquí un par de muchachos camino de %settlement%. Dijeron que habían oído que %companyname% había hecho un buen trabajo allí y que querían unirse."
    }
    // FILE: scripts\entity\world\settlements\situations\legends_off_book_deal_situation.nut
    // context: legends_off_book_deal_situation.create.m.Description
    {
        en = "Your peddler went around and talked every merchant into revealing their exotic goods. This obvious demand shown by your company has also led to an increase in all prices."
        es = "Quien hace de vendedor ambulante en tu compañía recorrió el lugar y convenció a todos los mercaderes de que sacaran sus mercancías exóticas. Esta demanda tan evidente por parte de tu compañía también ha provocado una subida de todos los precios."
    }
    // FILE: scripts\events\events\legends\legend_alchemist_crafts_thing_event.nut
    // context: legend_alchemist_crafts_thing_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_05.png[/img]{As you stop on the road you begin to take note of your surroundings, only to have your thoughts invaded by the smell of sulphur, meat and acid as if someone was attempting to cook a lindwurm on an open fire. \n\n Your suspicions are asserted when you turn to see %Alchemist% carefully measuring mixtures and heating equipment, keeping a steady eye on instruments while a bead of sweat trembles down their forehead. \n\n There is a sudden gasp and a flurry of action, you brace yourself and look for cover but in the seconds that pass %Alchemist% breathes a sigh of relief as if they had not been breathing at all since they started. A mess of hand motions quickly empties the mixture into a container with a few ingredients added as an afterthought, before the unknown item is committed to a small sack. \n\n %Alchemist% notices their audience and smiles, lobbing the sack and watching it float down into your outstretched palms like a beggar for a coin. \n\n Your heart did stop for a moment, but it begins beating again when %Alchemist% laughs and starts packing up their equipment, you peel back the sack opening and look at the wonders within...}"
        es = "[img]gfx/ui/events/event_05.png[/img]{Al detenerte en el camino empiezas a fijarte en lo que te rodea, solo para que un olor a azufre, carne y ácido te invada los pensamientos, como si alguien intentara cocinar un lindwurm en una hoguera. \n\n Tus sospechas se confirman al volverte y ver a %Alchemist% midiendo mezclas con cuidado y calentando su equipo, sin quitar ojo de los instrumentos mientras una gota de sudor le resbala temblorosa por la frente. \n\n De pronto se oye un jadeo y hay un torbellino de movimiento; te preparas y buscas dónde cubrirte, pero en los segundos que pasan %Alchemist% suelta un suspiro de alivio, como si no hubiera respirado desde que empezó. Un lío de gestos vacía enseguida la mezcla en un recipiente, con unos pocos ingredientes añadidos a última hora, antes de que el misterioso objeto acabe guardado en un saquito. \n\n %Alchemist% se da cuenta de que tiene público y sonríe; lanza el saquito y lo ve caer flotando en tus palmas extendidas, como las de un mendigo que pide una moneda. \n\n El corazón se te paró un momento, pero vuelve a latir cuando %Alchemist% se ríe y empieza a recoger su equipo. Abres la boca del saquito y contemplas las maravillas que guarda...}"
    }
    // context: legend_alchemist_crafts_thing_event.create.m.Screens.push().Options.Text
    {
        en = "What an interesting concoction."
        es = "Qué brebaje tan interesante."
    }
    // FILE: scripts\events\events\legends\legend_ardent_admirer_event.nut
    // context: legend_ardent_admirer_event.create.m.Title
    {
        en = "On the Road..."
        es = "En el camino..."
    }
    // context: legend_ardent_admirer_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_12.png[/img]Almost out of nowhere, a peculiar looking figure catches your eye. Clearly, you caught his too, because he smiles like he knows you and eagerly approaches, though if he did he would surely reconsider. Reflexively palming your sword with one hand and halting them with another, you call out and ask what on earth they want.%SPEECH_ON%It's - it's you! It really IS you! I thought it was, but now I'm here I can see you up close in all your glory!%SPEECH_OFF%His voice immediately forces an involuntary wince: it harbours an enthusiasm only seen in naive children and the hopelessly lovestruck, though he doesn't seem to be either. He's practically slack-jawed as he admires %randombrother%, all but worshipping the very ground %they_randombrother% occupies. You ask him who exactly 'we' are, to which he jolts forward with a burst of sickening glee.%SPEECH_ON%Well, you're... I don't know your name, actually. That's %randombrother% the mighty, over there is %randombrother2% the invincible! But you're the captain of the %companyname%, only the most heroic and noble warriors in all the lands, and now you're here, standing before me!%SPEECH_OFF%Right. While you wouldn't phrase it quite so poetically, the fool is correct about who you are. A number of the men are visibly upset by their presence, his whiny voice and unnaturally upbeat tone clearly triggering some primal unease, like looking at a corpse or someone very, very ill. Mercilessly, his grating voice begins again, this time enchanted with some gross mix of admiration and pleading. He remarks how he could clean and carry some of your equipment, but quickly abandons the prospect when seeing the lethal scowls of the company.%SPEECH_ON%I know! I can spread the word of your glorious deeds to the people of the world! People need to hear of the %companyname%'s brilliant exploits. Your name will live on through the ages when I regale people of your achievements!%SPEECH_OFF%A useful idiot is still useful, and you could let them go to spread the word of your 'glorious deeds'. That said, some of the company already resemble hungry wolves, seemingly pushed by the fool's hideous voice and energy to a violent boil."
        es = "[img]gfx/ui/events/event_12.png[/img]Casi de la nada, una figura de aspecto peculiar te llama la atención. Está claro que tú también se la llamaste a él, porque sonríe como si te conociera y se acerca con entusiasmo, aunque si te conociera de verdad, sin duda se lo pensaría mejor. Por puro reflejo, llevas una mano a la espada y con la otra lo detienes, y le preguntas a voces qué demonios quiere.%SPEECH_ON%¡Son... son ustedes! ¡De verdad SON ustedes! Ya me lo parecía, ¡pero ahora que estoy aquí puedo verlos de cerca en todo su esplendor!%SPEECH_OFF%Su voz te arranca al instante una mueca involuntaria: alberga un entusiasmo que solo se ve en los niños ingenuos y en los enamorados sin remedio, aunque él no parece ninguna de las dos cosas. Mira a %randombrother% prácticamente boquiabierto, poco menos que adorando el suelo que pisa. Le preguntas quiénes son exactamente esos 'ustedes', y él da un respingo hacia delante con un arrebato de alegría empalagosa.%SPEECH_ON%Bueno, tú eres... la verdad es que no sé cómo te llamas. ¡Allí está %randombrother%, de fuerza imponente, y allá, %randombrother2%, invencible en combate! Pero tú eres el capitán de %companyname%, ¡nada menos que los guerreros más heroicos y nobles de todas estas tierras, y ahora estás aquí, delante de mí!%SPEECH_OFF%Ya, claro. Aunque tú no lo dirías de forma tan poética, el idiota acierta en quiénes son. Varios de los hombres se ven visiblemente molestos con su presencia; su voz quejumbrosa y su tono antinaturalmente animado les despiertan un malestar primario, como al mirar un cadáver o a alguien muy, muy enfermo. Sin piedad, su voz chirriante vuelve a la carga, esta vez impregnada de una repugnante mezcla de admiración y súplica. Comenta que podría limpiar y cargar parte de tu equipo, pero abandona enseguida la idea al ver las miradas asesinas de la compañía.%SPEECH_ON%¡Ya sé! ¡Puedo dar a conocer sus gloriosas hazañas a la gente de todo el mundo! La gente tiene que oír hablar de las brillantes proezas de %companyname%. ¡Su nombre perdurará por los siglos cuando yo le cuente a todo el mundo sus logros!%SPEECH_OFF%Un idiota útil sigue siendo útil, y podrías dejarlo ir para que pregone tus 'gloriosas hazañas'. Dicho esto, algunos de la compañía ya parecen lobos hambrientos, aparentemente llevados al borde de la violencia por la voz espantosa y la energía del idiota."
    }
    // context: legend_ardent_admirer_event.create.m.Screens.push().Options.Text
    {
        en = "Yes, spread the word of our prowess. Far away from here."
        es = "Sí, cuéntale a todos nuestras proezas. Bien lejos de aquí."
    }
    // context: legend_ardent_admirer_event.create.m.Screens.push().Options.Text
    {
        en = "Can someone kill this fool already?"
        es = "¿Alguien puede matar ya a este idiota?"
    }
    // context: legend_ardent_admirer_event.create.m.Screens.push().start.Options.push().Text
    {
        en = "Our handgonner seems itching to introduce themself..."
        es = "Parece que nuestro cañón de mano tiene ganas de presentarse..."
    }
    // context: legend_ardent_admirer_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_64.png[/img]Your eagerness to shoo away this gnat of a man is met with groans by the company, quickly drowned out by an eager gasp from the starstruck fool. He moves to shake your hand, and it takes all your willpower to resist breaking the outstretched fingers like so much bramble. Catching the hint, he recoils his hand and punishes your mercy with more of his grating voice.%SPEECH_ON%Very well! I will travel, far and wide across all these lands to share the story of your troop and your legendary exploits. Soon, the whole world will call your name, uhhh... captain. Safe travels, my champion!%SPEECH_OFF%With that, he turns and runs away to only gods know where. His peculiar gait and frankly absurd appearance marks him out as almost otherworldly, though you try not to dwell on it as you strive to put him out of your mind. It's only a matter of time before they end up with a knife between the ribs, or so you hope. Turning to the company, it's apparent many of the men wished it to be their knives repeatedly slotted between his ribs, but that opportunity quickly disappears with the strange man. %randombrother% rubs their forehead and thanks seemingly every god there is that they're gone. Blinking away the absurdity of the past few minutes, you order the men back on the road."
        es = "[img]gfx/ui/events/event_64.png[/img]Tus ganas de espantar a este mosquito de hombre reciben los gruñidos de la compañía, enseguida ahogados por un jadeo ansioso del idiota deslumbrado. Hace ademán de estrecharte la mano, y necesitas toda tu fuerza de voluntad para no partirle los dedos extendidos como si fueran ramitas secas. Captando la indirecta, retira la mano y castiga tu clemencia con más de su voz chirriante.%SPEECH_ON%¡Muy bien! Viajaré a lo largo y ancho de todas estas tierras para contar la historia de tu tropa y de tus legendarias proezas. Pronto el mundo entero gritará tu nombre, eeeh... capitán. ¡Buen viaje, mi campeón!%SPEECH_OFF%Dicho esto, se da la vuelta y sale corriendo hacia donde solo los dioses saben. Su andar peculiar y su aspecto francamente absurdo le dan un aire casi de otro mundo, aunque procuras no darle vueltas mientras intentas quitártelo de la cabeza. Es solo cuestión de tiempo que acabe con un cuchillo entre las costillas, o eso esperas. Al volverte hacia la compañía, es evidente que muchos de los hombres habrían querido que fueran sus cuchillos los que se le clavaran una y otra vez entre las costillas, pero la ocasión se esfuma enseguida junto con el extraño. %randombrother% se frota la frente y da gracias a todos los dioses habidos y por haber porque se haya ido. Parpadeando para sacudirte lo absurdo de los últimos minutos, ordenas a los hombres volver al camino."
    }
    // context: legend_ardent_admirer_event.create.m.Screens.push().Options.Text
    {
        en = "I've always wanted a fan club."
        es = "Siempre quise tener un club de admiradores."
    }
    // context: legend_ardent_admirer_event.create.m.Screens.push().start.entry.::Legends.EventList.changeMood()
    {
        en = "Had to suffer the blabbering of a starstruck fool"
        es = "Tuvo que aguantar la cháchara de un idiota deslumbrado"
    }
    // context: legend_ardent_admirer_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_46.png[/img]%SPEECH_ON%Very well! I will- wait, wha-%SPEECH_OFF%Mercifully, the fool's theatrical monologue is cut short with a swift jab from %randombrother% which launches him to the ground in a frankly absurd movement. Unfortunately, the strange man's rehearsed speech is replaced with twisted yelps and wails of pain which only invite more abuse from some of the company, who has fallen in around the crumpled mess of a man to offer him kicks and punches. One of the men loudly groans 'fark this', and pulls a knife, looking to finish the job. A few deliberately messy stabs later, and the fool lays dead, their limbs splayed in almost every direction as their body takes on a bizarre form. Beside them, a pool of oozing crimson grows, and a few of the company sign their handiwork with a few hocks of spit and markedly unkind remarks, after relieving him of his belongings of course. %randombrother% rubs %their_randombrother% pate and says to no one in particular.%SPEECH_ON%Gods, man. Even killing him was irritating, it almost wasn't worth it. Almost.%SPEECH_OFF%Almost indeed. While some of the men are simply relieved to be rid of such a blight on their ears, you catch a few with mean smirks, glancing back to the fresh body of their making. Either way, with the company's bloodlust satisfied and a pestering fool dispatched, you order the men back on to the road, content to let the vultures and wildlife clean up your mess."
        es = "[img]gfx/ui/events/event_46.png[/img]%SPEECH_ON%¡Muy bien! Yo... espera, qu...%SPEECH_OFF%Por suerte, el teatral monólogo del idiota queda interrumpido por un golpe rápido de %randombrother% que lo manda al suelo con un movimiento francamente absurdo. Por desgracia, el discurso ensayado del extraño da paso a unos gañidos retorcidos y a unos aullidos de dolor que solo invitan a más palizas por parte de algunos de la compañía, que se han apiñado alrededor de ese despojo arrugado de hombre para repartirle patadas y puñetazos. Uno de los hombres gruñe en voz alta 'a la mierda' y saca un cuchillo, dispuesto a terminar el trabajo. Unas cuantas puñaladas deliberadamente chapuceras después, el idiota yace muerto, con las extremidades desparramadas en casi todas direcciones mientras su cuerpo adopta una forma grotesca. A su lado crece un charco carmesí que rezuma, y algunos de la compañía firman su obra con unos cuantos escupitajos y comentarios de lo más desagradables, no sin antes despojarlo de sus pertenencias, por supuesto. %randombrother% se frota la coronilla y dice sin dirigirse a nadie en particular.%SPEECH_ON%Dioses, hombre. Hasta matarlo fue irritante, casi no valió la pena. Casi.%SPEECH_OFF%Casi, sí. Mientras algunos de los hombres sencillamente se alegran de librarse de semejante plaga para sus oídos, sorprendes a unos cuantos con sonrisitas mezquinas, mirando de reojo el cuerpo fresco que acaban de dejar. En cualquier caso, saciada la sed de sangre de la compañía y despachado un idiota pesado, ordenas a los hombres volver al camino, conforme con dejar que los buitres y las alimañas limpien tu desastre."
    }
    // context: legend_ardent_admirer_event.create.m.Screens.push().Options.Text
    {
        en = "Never meet your heroes, I guess..."
        es = "Nunca conozcas a tus ídolos, supongo..."
    }
    // context: legend_ardent_admirer_event.create.m.Screens.push().start.entry.::Legends.EventList.changeMood()
    {
        en = "Satisfied to see an annoying fool gutted"
        es = "Disfrutó viendo destripar a un idiota pesado"
    }
    // context: legend_ardent_admirer_event.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_24.png[/img]%handgonner% the company gunner steps up, handgonne in tow. %They_gunner%'s sizing up the irritating little man before %them_gunner%, perhaps questioning how someone so offensively annoying has managed to survive to such an age, or perhaps just daydreaming about what their handgonne would do to them. With a menacing tone, %they_gunner% ask the pest.%SPEECH_ON%Have you ever wanted to fly, little man?%SPEECH_OFF%Just as the fool primed to assault your ears again with his answer, your gunner quickly swings his handgonne into firing position, primes, and... Oh fuck.  You wince as the thunder of the gun assaults your every sense- your ears ring, your eyes pulse, your bones rattle as though the earth itself was splitting beneath you. Between scrunched up eyes, you can just make out the vague image of the fool as they shatter and rip apart, the force of the hand cannon proving too much for their feeble form. Flesh and hair is shredded and made to resemble autumn leaves as they are ejected from the mass of what was once human. An eye and ear and arm succumb to the torrent of shrapnel and blasting powder, seemingly racing to escape the onslaught before them as they're launched in almost every direction. Nearby, leaves rustle as birds make flight at the sudden disturbance to their rest.\nThe handgonner has hardly moved from their firing stance, the primal thunder of their tool of war revealing itself a familiar sensation to %them_gunner%. Instead, %they_gunner% surveys %their_gunner% handiwork, mapping the viscera that soaks the once-tranquil scene around them: limbs and chunks of bone are sprinkled in a cone from the gunner, sizzling flesh and boiling blood carpet the ground, a testament to the destructive power of their terrible weapon. What remains of the fool is a caricature of gore and barbarity, though between the shock, you can't help but feel a tad amused at the excessive display of cruel obliteration. Clearly, the handgonner agrees.%SPEECH_ON%Well, I'd say he flew pretty well, captain! It certainly beats his endless prattling, eh?%SPEECH_OFF%You suppose it does, as does much of the company as they whoop and clap at the gunner's impromptu execution of someone who's ultimate crime was being an annoying prat in the wrong place. A couple of the company approach a tree in the wake of the blast, claiming to spy brain matter and skull fragments amongst the branches, others make poor attempts at hiding their amusement by covering their smirks. Ultimately, you order the men back on the road, as you surely wouldn't want to be here to explain this... mess to any other passers by."
        es = "[img]gfx/ui/events/event_24.png[/img]%handgonner%, %art_gunner% cañoner%o_gunner% de la compañía, da un paso al frente con el cañón de mano a cuestas. Mide con la mirada al irritante hombrecillo que tiene delante, quizá preguntándose cómo alguien tan ofensivamente pesado ha logrado sobrevivir hasta esa edad, o quizá simplemente soñando despiert%o_gunner% con lo que su cañón de mano le haría. Con tono amenazante, le pregunta al pesado.%SPEECH_ON%¿Alguna vez has querido volar, hombrecillo?%SPEECH_OFF%Justo cuando el idiota se disponía a asaltar de nuevo tus oídos con su respuesta, tu cañoner%o_gunner% se echa rápidamente el cañón de mano a la posición de disparo, lo ceba y... Oh, mierda. Haces una mueca cuando el trueno del arma asalta todos tus sentidos: te zumban los oídos, te palpitan los ojos, te traquetean los huesos como si la tierra misma se partiera bajo tus pies. Con los ojos entornados, apenas distingues la vaga imagen del idiota mientras se hace añicos y se desgarra; la fuerza del cañón de mano es demasiado para su endeble cuerpo. La carne y el pelo quedan triturados y parecen hojas de otoño mientras salen despedidos de la masa de lo que una vez fue un ser humano. Un ojo, una oreja y un brazo sucumben al torrente de metralla y pólvora, como si corrieran para escapar de la embestida, mientras salen disparados en casi todas direcciones. Cerca de allí, las hojas susurran mientras los pájaros alzan el vuelo ante la súbita perturbación de su descanso.\n%Art_gunner% cañoner%o_gunner% apenas se ha movido de su posición de tiro; el trueno primario de su herramienta de guerra resulta ser una sensación familiar para %el_gunner%. En cambio, contempla su obra y recorre con la vista las vísceras que empapan la escena, antes tranquila, a su alrededor: extremidades y trozos de hueso esparcidos en abanico desde su posición, carne chisporroteante y sangre hirviendo alfombrando el suelo, testimonio del poder destructivo de su terrible arma. Lo que queda del idiota es una caricatura de sangre y barbarie, aunque, entre la conmoción, no puedes evitar que te divierta un poco semejante muestra desmedida de cruel aniquilación. Está claro que %art_gunner% cañoner%o_gunner% opina lo mismo.%SPEECH_ON%Bueno, yo diría que voló bastante bien, ¡capitán! Desde luego, es mejor que su parloteo interminable, ¿eh?%SPEECH_OFF%Supones que sí, y lo mismo piensa buena parte de la compañía, que vitorea y aplaude la ejecución improvisada %del_gunner% cañoner%o_gunner% de alguien cuyo único crimen fue ser un imbécil pesado en el lugar equivocado. Un par de miembros de la compañía se acercan a un árbol tras la explosión, asegurando ver sesos y fragmentos de cráneo entre las ramas; otros intentan sin mucho éxito disimular la diversión tapándose las sonrisitas. Al final, ordenas a los hombres volver al camino, porque seguro que no querrías estar aquí para explicarle este... estropicio a ningún otro viajero."
    }
    // context: legend_ardent_admirer_event.create.m.Screens.push().Options.Text
    {
        en = "They had it coming... I think."
        es = "Se lo buscó... creo."
    }
    // context: legend_ardent_admirer_event.create.m.Screens.push().start.List.push().::Legends.EventList.changeMood()
