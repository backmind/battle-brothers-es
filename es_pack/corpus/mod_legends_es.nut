        es = "[color=%positive%]+<bonus>[/color] de Habilidad cuerpo a cuerpo, Habilidad a distancia y Defensa cuerpo a cuerpo"
    }
    // context: perk_legend_anchor.getTooltip.text
    {
        en = "If you would get Staggered instead remove a stack of Anchor"
        es = "Si fueras a quedar Tambaleante, en su lugar se pierde una acumulación de Ancla"
    }
    // FILE: scripts\skills\perks\perk_legend_back_to_basics.nut
    // context: perk_legend_back_to_basics.create.m.Description
    {
        en = "Years of practice lead this character to fall back to %their% instincts and basic training under extreme stress."
        es = "Años de práctica hacen que, bajo una presión extrema, este personaje recurra a sus instintos y a su entrenamiento básico."
    }
    // context: perk_legend_back_to_basics.getTooltip.tooltip.push().text
