    }
    // context: legend_large_broad_head_bolts.create.m.Description
    {
        en = "A large quiver of bolts with broad tips, designed for tearing flesh, but easily stopped by armor. Is automatically refilled after each battle if you have enough global ammunition. Grants 10% more damage, but 10% less armor piercing damage while wielding a crossbow."
        es = "Un carcaj grande de virotes con puntas anchas, diseñados para desgarrar la carne, pero que la armadura detiene con facilidad. Se recarga automáticamente después de cada batalla si tienes suficiente munición en reserva. Otorga un 10% más de daño, pero un 10% menos de daño que ignora la armadura al empuñar una ballesta."
