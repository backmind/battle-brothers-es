        mode = "pattern"
        en = "You spend [color=<color:str>]15[/color] Tools and Supplies"
        es = "Gastas [color=<color>]15[/color] Herramientas y suministros"
    }
    // context: legend_inventor_prosthetic_hand.create.m.Screens.push().start.trait.::Legends.Traits.grant().List.push().text
    // en = "<_event.m.Nohand.m.Name> receives a <_trait.m.Name>"  // cubierto por el patrón "<name:str> receives a <trait:str>"
    // en = "<actor:str> no longer has a <name:str>"
    // en base_es
    // context: legend_inventor_prosthetic_hand.create.m.Screens.push().start._event.m.Inventor.improveMood()
    // en = "Created a <trait.m.Name> for <_event.m.Nohand.m.Name>"  // cubierto por el patrón "Created a <trait:str> for <name:str>"
    // context: legend_inventor_prosthetic_hand.create.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_inventor_general.png[/img]You tell %inventor% that the %companyname% has no resources to spare for such things at this time. The inventor lowers his head and lets out a sigh.%SPEECH_ON%I understand. Perhaps later, then. I'll be around.%SPEECH_OFF%"
        es = "[img]gfx/ui/events/legend_inventor_general.png[/img]Le dices a %inventor% que %companyname% no tiene recursos de sobra para esas cosas ahora mismo. Agacha la cabeza y suelta un suspiro.%SPEECH_ON%Lo entiendo. Quizá más adelante, entonces. Estaré por aquí.%SPEECH_OFF%"
    }
