        es = "Se tardarán [color=%positive%]<hours>[/color] horas en inscribir todas las runas."
    }
    // context: enchanter_building.getModifierToolip.ret.text
    {
        // text = "Total enchanting modifier is [color=%positive%]" + mod.Craft + "[/color] units per hour."
        mode = "pattern"
        en = "Total enchanting modifier is [color=%positive%]<rate:str>[/color] units per hour."
        es = "El modificador total de encantamiento es de [color=%positive%]<rate>[/color] unidades por hora."
    }
    // context: enchanter_building.getResults.res.push().text
    {
        // text = "Enchanting completed: " + b.getName()
        mode = "pattern"
        en = "Enchanting completed: <item:str>"
        es = "Encantamiento completado: <item>"
    }
    // context: enchanter_building.getUpdateText
    {
        en = "No one assigned to enchant"
        es = "Nadie asignado a encantar"
