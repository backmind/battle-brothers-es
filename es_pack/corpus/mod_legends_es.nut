    // FILE: scripts\skills\actives\legend_darkflight_skill.nut
    // context: legend_darkflight_skill.create.m.Description
    {
        en = "Disapparate from your current location and reappear on the other side of the battlefield."
        es = "Desaparece de tu posición actual y reaparece al otro lado del campo de batalla."
    }
    // en = "<actor:str_tag> uses Darkflight"
    // en base_es
    // FILE: scripts\skills\actives\legend_daze_skill.nut
    // context: legend_daze_skill.create.m.Description
    {
        en = "Assault the senses of your target with a flurry of colorful sparks, whirs, and pops. Such an astonishing display is sure to leave anyone too bewildered to fight effectively. Does no damage."
        es = "Asalta los sentidos de tu objetivo con una ráfaga de chispas de colores, zumbidos y chasquidos. Un espectáculo tan asombroso deja a cualquiera demasiado desconcertado para combatir con eficacia. No causa daño."
    }
    // context: legend_daze_skill.getTooltip.ret.push().text
    {
        en = "Leave your opponent stupefied, halving their Damage, Fatigue and Initiative"
        es = "Deja atontado a tu oponente, lo que reduce a la mitad su daño, Fatiga e Iniciativa"
    }
    // context: legend_daze_skill.getTooltip.ret.push().text
    {
        en = "Hit chance based on ranged skill and doubled if you also have the Battlefield Control perk"
        es = "Probabilidad de acierto basada en la Habilidad a distancia, duplicada si además tienes la ventaja Control del campo de batalla"
    }
    // context: legend_daze_skill.onUse.logString
    {
        // local logString = this.Const.UI.getColorizedEntityName(_user) + " tries to stupefy " + this.Const.UI.getColorizedEntityName(targetEntity) + " (Chance: " + chance + ", Rolled: " + roll + ")\n";
        mode = "pattern"
        en = "<user:str> tries to stupefy <target:str> (Chance: <chance:int>, Rolled: <roll:int>)\n"
        es = "<user> intenta atontar a <target> (Probabilidad: <chance>, Tirada: <roll>)\n"
    }
    // context: legend_daze_skill.onUse.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(logString + this.Const.UI.getColorizedEntityName(_user) + " stupefied " + this.Const.UI.getColorizedEntityName(targetEntity));
        mode = "pattern"
        en = "<log:str> stupefied <target:str_tag>"
        es = "<log> atonta a <target>"
    }
    // context: legend_daze_skill.onUse.Tactical.EventLog.log()
