        en = "\nThis item has the power of the rune sigil of Luck:\n[color=%positive%]+%bonus1%%[/color] chance to have any attacker require two successful attack rolls in order to hit.\n	"
        es = "\nEste objeto posee el poder del sello rúnico de Suerte:\n[color=%positive%]+%bonus1%%[/color] de probabilidad de que cualquier atacante necesite dos tiradas de ataque con éxito para acertar.\n	"
