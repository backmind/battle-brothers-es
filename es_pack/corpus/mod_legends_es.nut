        es = "Probabilidad mínima de impacto"
    }
    // context: misc.addElement().::MSU.Class.RangeSetting()
    {
        en = "Slider for minimum hitchance percentage. Pushing this slider too far will result in no chance to hit for anyone."
        es = "Control del porcentaje mínimo de probabilidad de impacto. Llevarlo demasiado lejos hará que nadie tenga ninguna posibilidad de acertar."
    }
    // context: misc.addElement().::MSU.Class.RangeSetting()
    {
        en = "Maximum hitchance"
        es = "Probabilidad máxima de impacto"
    }
    // context: misc.addElement().::MSU.Class.RangeSetting()
    {
        en = "Slider for maximum hitchance percentage. Pushing this slider too far back will result in no chance to hit for anyone."
        es = "Control del porcentaje máximo de probabilidad de impacto. Bajarlo demasiado hará que nadie tenga ninguna posibilidad de acertar."
    }
    // context: myEnumTooltip
    {
        en = "Define AI Rotation rules: 'Default' is the Vanilla behaviour, AI is free to rotate itself and your bros as long as the skill allows; 'Limited' AI can only rotate itself, but not your bros (unless they have the Twirl Perk); 'Disabled' disable AI Rotation entirely"
        es = "Define las reglas de Rotación de la IA: 'Por defecto' es el comportamiento del juego base, en el que la IA puede rotarse a sí misma y a tus hermanos siempre que la habilidad lo permita; con 'Limitado', la IA solo puede rotarse a sí misma, pero no a tus hermanos (salvo que tengan la ventaja Vuelta); 'Desactivado' desactiva por completo la Rotación de la IA"
    }
