    // FILE: scripts\items\legend_helmets\runes\legend_rune_patience.nut
    // context: legend_rune_patience.create.m.Description
    {
        en = "An inscribed rock that can be attached to a character's helmet to increase the wearer's patience."
        es = "Una piedra grabada que se puede fijar al casco de un personaje para aumentar la paciencia de quien lo lleva."
    }
    // context: legend_rune_patience.create.m.ArmorDescription
    {
        en = "Includes a patience rune."
        es = "Incluye una runa de paciencia."
    }
    // FILE: scripts\items\legend_helmets\vanity\legend_helmet_demon_alp_helm.nut
    // context: legend_helmet_demon_alp_helm.create.m.Name
    {
        en = "Demon Alp Helm"
        es = "Yelmo de Alp demoníaco"
    }
    // context: legend_helmet_demon_alp_helm.create.m.Description
    {
        en = "A trophy made from the visage of a demon that hunts in the night."
        es = "Un trofeo hecho con el rostro de un demonio que caza de noche."
    }
    // context: legend_helmet_demon_alp_helm.create.m.ArmorDescription
    {
        en = "Includes a terrifying mask."
        es = "Incluye una máscara aterradora."
    }
    // context: legend_helmet_demon_alp_helm.onArmorTooltip.result.push().text
    {
        en = "Grants the Horrific Scream active skill"
        es = "Otorga la habilidad activa Grito horripilante"
    }
    // FILE: scripts\items\legend_helmets\vanity\legend_helmet_hunter_cap.nut
    // context: legend_helmet_hunter_cap.create.m.Name
    {
        en = "Hunter's Cap"
        es = "Gorro de cazador"
    }
    // context: legend_helmet_hunter_cap.create.m.Description
    {
        en = "The distinctive hat of a game hunter, the pointed shape focuses vision and its ornate feather and shape bristles with confidence, but also makes it an easy target for others."
        es = "El inconfundible sombrero de un cazador: su forma puntiaguda concentra la vista y su vistosa pluma rebosa aplomo, pero también convierte a quien lo lleva en un blanco fácil para los demás."
    }
    // context: legend_helmet_hunter_cap.create.m.ArmorDescription
    {
        en = "Includes a distinctive hat of a game hunter."
        es = "Incluye el inconfundible sombrero de un cazador."
    }
    // context: legend_helmet_hunter_cap.onArmorTooltip._result.push().text
    {
        en = "Makes enemies much more likely to attack you"
        es = "Los enemigos tienen muchas más probabilidades de atacarte"
    }
    // FILE: scripts\items\legend_helmets\vanity\legend_helmet_jester_hat.nut
    // en = "Jester's Hat"
    // en base_es
    // context: legend_helmet_jester_hat.create.m.Description
    {
        en = "The quintessential hat of performing folk in noble court. Wearing it makes you feel like a fool, but the jingling bells make you an irritating target for all."
        es = "El sombrero por excelencia de quienes actúan en las cortes nobles. Llevarlo te hace sentir como un bufón, y el tintineo de sus cascabeles te convierte en un blanco irritante para todos."
    }
    // context: legend_helmet_jester_hat.create.m.ArmorDescription
    {
        en = "Includes a colorful jester's hat."
        es = "Incluye un colorido gorro de bufón."
    }
    // FILE: scripts\items\legend_helmets\vanity\legend_helmet_lindwurm_helm.nut
    // context: legend_helmet_lindwurm_helm.create.m.Name
    {
        en = "Stollwurm Helm"
        es = "Yelmo de Stollwurm"
    }
    // context: legend_helmet_lindwurm_helm.create.m.Description
    {
        en = "A terrifying helmet fashioned from a trophy taken from one of the land's greatest terrors."
        es = "Un casco aterrador hecho con un trofeo arrebatado a uno de los mayores terrores de estas tierras."
    }
    // context: legend_helmet_lindwurm_helm.create.m.ArmorDescription
    {
        en = "Includes a helmet made from scales of a great beast."
        es = "Incluye un casco hecho con escamas de una gran bestia."
    }
    // context: legend_helmet_lindwurm_helm.onArmorTooltip.result.push().text
    {
        en = "Immunity from Knockback and Grab"
        es = "Inmunidad a empujones y agarres"
    }
    // context: legend_helmet_lindwurm_helm.onArmorTooltip.result.push().text
    {
        en = "Being surrounded no longer affects this character's defences at all"
        es = "Los enemigos que lo rodean ya no afectan en absoluto a las defensas de este personaje"
    }
    // context: legend_helmet_lindwurm_helm.onArmorTooltip.result.push().text
    {
        en = "No fatigue penalties from melee damage"
        es = "Sin penalizaciones de Fatiga por el daño cuerpo a cuerpo"
    }
    // FILE: scripts\items\legend_helmets\vanity\legend_helmet_mountain_helm.nut
    // context: legend_helmet_mountain_helm.create.m.Name
    {
        en = "Mountain Helm"
        es = "Yelmo de montaña"
    }
    // context: legend_helmet_mountain_helm.create.m.Description
    {
        en = "A helmet crafted from the skin and skull of a mighty rock unhold, which continues to mend itself even after the beast's death."
        es = "Un casco hecho con la piel y el cráneo de un poderoso trol de roca, que sigue regenerándose incluso después de la muerte de la bestia."
    }
    // context: legend_helmet_mountain_helm.create.m.ArmorDescription
    {
        en = "Includes a heavy, stone-like helmet."
        es = "Incluye un casco pesado con aspecto de piedra."
    }
    // context: legend_helmet_mountain_helm.onArmorTooltip.result.push().text
    {
        en = "Restores 10% helmet armor each turn"
        es = "Restaura un 10% de la armadura del casco cada turno"
    }
    // FILE: scripts\items\legend_helmets\vanity\legend_helmet_nach_helm.nut
    // context: legend_helmet_nach_helm.create.m.Name
    {
        en = "Skin Ghoul Helmet"
        es = "Yelmo de necrófago desollado"
    }
    // context: legend_helmet_nach_helm.create.m.Description
    {
        en = "A helmet fashioned made from the face and horns of a skin ghoul."
        es = "Un casco hecho con el rostro y los cuernos de un necrófago desollado."
    }
    // context: legend_helmet_nach_helm.create.m.ArmorDescription
    {
        en = "Includes some skin ghoul's parts."
        es = "Incluye algunas partes de un necrófago desollado."
    }
    // context: legend_helmet_nach_helm.onArmorTooltip.result.push().text
    {
        en = "Grants the Gruesome Feast active skill"
        es = "Otorga la habilidad activa Festín espantoso"
    }
    // FILE: scripts\items\legend_helmets\vanity\legend_helmet_pimp_hat.nut
    // context: legend_helmet_pimp_hat.create.m.Name
    {
        en = "Pimp's hat"
        es = "Sombrero de proxeneta"
    }
    // context: legend_helmet_pimp_hat.create.m.Description
    {
        en = "An exceptionally gaudy piece of headwear that instantly attracts the wrong type of attention."
        es = "Un sombrero de lo más chillón que atrae al instante la clase de atención que no conviene."
    }
    // context: legend_helmet_pimp_hat.create.m.ArmorDescription
    {
        en = "Includes a flamboyant hat."
        es = "Incluye un sombrero extravagante."
    }
    // FILE: scripts\items\legend_helmets\vanity\legend_helmet_redback_helm.nut
    // context: legend_helmet_redback_helm.create.m.Name
    {
        en = "Redback Helm"
        es = "Yelmo de lomo rojo"
    }
    // context: legend_helmet_redback_helm.create.m.Description
    {
        en = "A light helmet made from the carapace of a redback spider."
        es = "Un casco ligero hecho con el caparazón de una araña de lomo rojo."
    }
    // context: legend_helmet_redback_helm.create.m.ArmorDescription
    {
        en = "Includes a redback carapace helmet."
        es = "Incluye un casco de caparazón de araña de lomo rojo."
    }
    // context: legend_helmet_redback_helm.onArmorTooltip.result.push().text
    {
        en = "Grants poison immunity"
        es = "Otorga inmunidad al veneno"
    }
    // context: legend_helmet_redback_helm.onArmorTooltip.result.push().text
    {
        en = "Grants the Web Cast active skill"
        es = "Otorga la habilidad activa Tejer telaraña"
    }
    // FILE: scripts\items\legend_helmets\vanity\legend_helmet_white_wolf_helm.nut
    // context: legend_helmet_white_wolf_helm.create.m.Name
    {
        en = "White Wolf Helm"
        es = "Yelmo de lobo blanco"
    }
    // context: legend_helmet_white_wolf_helm.create.m.Description
    {
        en = "A fur covering fashioned from of a dangerous beast. It serves as a grim trophy that unnerves adversaries."
        es = "Una cubierta de piel confeccionada a partir de una bestia peligrosa. Sirve como macabro trofeo que inquieta a los adversarios."
    }
    // context: legend_helmet_white_wolf_helm.create.m.ArmorDescription
    {
        en = "Includes a heavy pelt of white fur."
        es = "Incluye un pesado pellejo de pelo blanco."
    }
    // context: legend_helmet_white_wolf_helm.onArmorTooltip.result.push().text
    {
        // text = "Reduces the Resolve of any opponent engaged in melee by [color=%negative%]-" + this.m.ThreatBonus + "[/color]"
        mode = "pattern"
        en = "Reduces the Resolve of any opponent engaged in melee by [color=%negative%]-<bonus:int>[/color]"
        es = "Reduce la Resolución de cualquier oponente trabado en combate cuerpo a cuerpo en [color=%negative%]-<bonus>[/color]"
    }
    // FILE: scripts\items\legend_helmets\vanity\legend_helmet_witchhunter_helm.nut
    // context: legend_helmet_witchhunter_helm.create.m.Name
    {
        en = "Witchhunter's Capotain"
        es = "Capotain del cazador de brujas"
    }
    // context: legend_helmet_witchhunter_helm.create.m.Description
    {
        en = "A tall, wide-brimmed leather hat. Those who favour such headwear are almost always an unwanted presence, bringing with them a grim air of scrutiny and unease."
        es = "Un sombrero de cuero alto y de ala ancha. Quienes prefieren este tipo de sombrero casi siempre son una presencia indeseada, y traen consigo un sombrío aire de escrutinio e inquietud."
    }
    // context: legend_helmet_witchhunter_helm.create.m.ArmorDescription
    {
        en = "Includes a tall, wide-brimmed leather hat."
        es = "Incluye un sombrero de cuero alto y de ala ancha."
    }
    // context: legend_helmet_witchhunter_helm.onArmorTooltip.result.push().text
    {
        en = "[color=%positive%]+5[/color] Resolve at morale checks against fear, panic or mind control effects"
        es = "[color=%positive%]+5[/color] de Resolución en las pruebas de moral contra efectos de miedo, pánico o control mental"
    }
    // FILE: scripts\items\legend_horse_armor\legend_horse_caparison.nut
    // context: legend_horse_caparison.create.m.Name
    {
        en = "Horse Caparison"
        es = "Gualdrapa"
    }
    // context: legend_horse_caparison.create.m.Description
    {
        en = "Mwah has absolutely no idea what a horse caparison is but it sure sounds cool. Stick this on your horse and find out."
        es = "Mwah no tiene ni la menor idea de qué es una gualdrapa de caballo, pero seguro que suena genial. Pónsela a tu caballo y descúbrelo."
    }
    // context: legend_horse_caparison.create.m.Variants
    // en = "blue"  // identificador de variante con el que se arma el nombre del sprite, no se muestra
    // FILE: scripts\items\legend_horse_helmets\legend_horse_bridle.nut
    // context: legend_horse_bridle.create.m.Name
    {
        en = "Horse Bridle"
        es = "Brida"
    }
    // context: legend_horse_bridle.create.m.Description
    {
        en = "Mwah has absolutely no idea what a horse bridle is but it sure sounds cool. Stick this on your horse and find out."
        es = "Mwah no tiene ni la menor idea de qué es una brida de caballo, pero seguro que suena genial. Pónsela a tu caballo y descúbrelo."
    }
    // FILE: scripts\items\loot\legend_basilisk_talon_item.nut
    // context: legend_basilisk_talon_item.create.m.Name
    {
        en = "Basilisk Talon"
        es = "Garra de basilisco"
    }
    // context: legend_basilisk_talon_item.create.m.Description
    {
        en = "A great, curved claw used to pin down or disembowel prey. Many would pay well for such a curiosity."
        es = "Una gran garra curva que sirve para inmovilizar o destripar a la presa. Muchos pagarían bien por semejante curiosidad."
    }
    // FILE: scripts\items\loot\legend_bear_fur_item.nut
    // context: legend_bear_fur_item.create.m.Name
    {
        en = "Bear Fur"
        es = "Piel de oso"
    }
    // context: legend_bear_fur_item.create.m.Description
    {
        en = "The intact skin and fur of a huge bear.  A very sought-after commodity, especially in larger settlements."
        es = "La piel y el pelaje intactos de un oso enorme. Una mercancía muy codiciada, sobre todo en los asentamientos más grandes."
    }
    // FILE: scripts\items\misc\legend_ancient_green_wood_item.nut
    // context: legend_ancient_green_wood_item.create.m.Name
    {
        en = "Ancient Green Wood"
        es = "Madera verde ancestral"
    }
    // context: legend_ancient_green_wood_item.create.m.Description
    {
        en = "Ancient pieces of green wood carved from the remains of a living tree."
        es = "Piezas antiguas de madera verde talladas a partir de restos de un árbol vivo."
    }
    // FILE: scripts\items\misc\legend_ancient_scroll_item.nut
    // context: legend_ancient_scroll_item.::inherit().m.BookName
    {
        en = "Ancient Scroll:"
        es = "Pergamino antiguo:"
    }
    // context: legend_ancient_scroll_item.::inherit().create.m.Name
    {
        en = "Ancient Scroll"
        es = "Pergamino antiguo"
    }
    // context: legend_ancient_scroll_item.::inherit().create.m.Description
    {
        en = "A torn-up scroll with knowledge unseen for centuries. It can be translated by a character with the interpretation perk in the crafting tent. Highly valuable to some historians, although it is useless to many. They can, however, be studied with effort and a high chance of headache. Every brother may use up to 1 scroll. Being bright increases this to 2 scrolls, and being dumb decreases this to 0 scrolls."
        es = "Un pergamino hecho jirones con conocimientos que nadie ha visto en siglos. Un personaje con la ventaja de interpretación puede traducirlo en la tienda de artesanía. Muy valioso para algunos historiadores, aunque inútil para muchos. Sin embargo, se puede estudiar con esfuerzo y muchas probabilidades de acabar con dolor de cabeza. Cada hermano puede usar hasta 1 pergamino. Ser brillante aumenta el límite a 2 pergaminos y ser tonto lo reduce a 0."
    }
    // context: legend_ancient_scroll_item.::inherit().isAbleToUseScroll
    {
        // return "Failed to use this item as the user will be recovering from the last reading for another [color=%negative%]" + injury.m.HealingTimeMin + "-" + injury.m.HealingTimeMax +"[/color] days because of [color=%status%]" + injury.getName() + "[/color].";
        mode = "pattern"
        en = "Failed to use this item as the user will be recovering from the last reading for another [color=%negative%]<min:int>-<max:int>[/color] days because of [color=%status%]<injury:str>[/color]."
        es = "No se pudo usar este objeto porque el usuario seguirá recuperándose de la última lectura durante [color=%negative%]<min>-<max>[/color] días más a causa de [color=%status%]<injury>[/color]."
    }
    // context: legend_ancient_scroll_item.::inherit().isAbleToUseScroll
    {
        // return "Failed to use this item as the user will be recovering from the last reading for another [color=%negative%]" + effect.m.HealingTime + "[/color] days because of [color=%status%]" + effect.getName() + "[/color].";
        mode = "pattern"
        en = "Failed to use this item as the user will be recovering from the last reading for another [color=%negative%]<days:int>[/color] days because of [color=%status%]<effect:str>[/color]."
        es = "No se pudo usar este objeto porque el usuario seguirá recuperándose de la última lectura durante [color=%negative%]<days>[/color] días más a causa de [color=%status%]<effect>[/color]."
    }
    // context: legend_ancient_scroll_item.::inherit().isAbleToUseScroll
    {
        en = "Failed to use this item as the user has [color=%negative%]Dumb[/color] trait."
        es = "No se pudo usar este objeto porque el usuario tiene el rasgo [color=%negative%]Tonto[/color]."
    }
    // context: legend_ancient_scroll_item.::inherit().isAbleToUseScroll
    {
        en = "Failed to use this item as the user has [color=%negative%]Brain Damage[/color] injury."
        es = "No se pudo usar este objeto porque el usuario tiene la herida [color=%negative%]Daño cerebral[/color]."
    }
    // context: legend_ancient_scroll_item.::inherit().isAbleToUseScroll
    {
        en = "Are you trying to make an animal read?"
        es = "¿Pretendes que un animal lea?"
    }
    // context: legend_ancient_scroll_item.::inherit().isAbleToUseScroll
    {
        en = "This character cannot potentially learn anything from this."
        es = "Este personaje no podría aprender nada de esto."
    }
    // FILE: scripts\items\misc\legend_armor_skill_book_item.nut
    // context: legend_armor_skill_book_item.::inherit().m.BookName
    {
        en = "A Treatise on Armor:"
        es = "Tratado sobre la armadura:"
    }
    // context: legend_armor_skill_book_item.::inherit().create.m.Name
    {
        en = "Wearing it well"
        es = "Llevarla con estilo"
    }
    // context: legend_armor_skill_book_item.::inherit().create.m.Description
    {
        en = "A collection of notes of soldiers, craftsmen and armorers, that will explain everything about wearing armor.  Will teach the relevant [color=%negative%]Armor[/color] perk group to the character that uses it."
        es = "Una colección de notas de soldados, artesanos y armeros que lo explica todo sobre llevar armadura. Enseñará al personaje que lo use el grupo de ventajas de [color=%negative%]Armadura[/color] correspondiente."
    }
    // FILE: scripts\items\misc\legend_banshee_essence_item.nut
    // context: legend_banshee_essence_item.create.m.Name
    {
        en = "Banshee Essence"
        es = "Esencia de banshee"
    }
    // context: legend_banshee_essence_item.create.m.Description
    {
        en = "The remaining residue of a dissipated Winselmutter. if you listen closely you can still hear her sobbing from the jar."
        es = "El residuo que queda de una Winselmutter disipada. Si escuchas con atención, aún puedes oírla sollozar dentro del tarro."
    }
    // FILE: scripts\items\misc\legend_basilisk_eye_item.nut
    // context: legend_basilisk_eye_item.create.m.Description
    {
        en = "The unfaltering, cruel gaze of a Basilisk. Even now it's giving you goosebumps."
        es = "La mirada cruel e inquebrantable de un basilisco. Incluso ahora te pone la piel de gallina."
    }
    // FILE: scripts\items\misc\legend_basilisk_feathers_item.nut
    // context: legend_basilisk_feathers_item.create.m.Name
    {
        en = "Basilisk Feathers"
        es = "Plumas de basilisco"
    }
    // context: legend_basilisk_feathers_item.create.m.Description
    {
        en = "Feather-like scales of varying length and thickness. Closer to lamellar than downs."
        es = "Escamas con forma de pluma, de longitud y grosor variables. Más cerca de una armadura laminar que de un plumón."
    }
    // FILE: scripts\items\misc\legend_class_skill_book_item.nut
    // context: legend_class_skill_book_item.::inherit().m.BookName
    {
        en = "Tools of the Trade:"
        es = "Herramientas del oficio:"
    }
    // context: legend_class_skill_book_item.::inherit().create.m.Name
    {
        en = "Art of War"
        es = "El arte de la guerra"
    }
    // context: legend_class_skill_book_item.::inherit().create.m.Description
    {
        en = "Tool usage training manual, written by a master craftsman. Will teach the relevant [color=%negative%]Class[/color] perk group to the character that uses it."
        es = "Manual de formación en el uso de herramientas, escrito por un maestro artesano. Enseñará al personaje que lo use el grupo de ventajas de [color=%negative%]Clase[/color] correspondiente."
    }
    // FILE: scripts\items\misc\legend_demon_alp_skin_item.nut
    // context: legend_demon_alp_skin_item.create.m.Name
    {
        en = "Demon Alp Skin"
        es = "Piel de Alp demoníaco"
    }
    // context: legend_demon_alp_skin_item.create.m.Description
    {
        en = "This skin taken from an Demon Alp is leathery and seems to ooze ichor."
        es = "Esta piel arrancada a un Alp demoníaco es correosa y parece rezumar icor."
    }
    // FILE: scripts\items\misc\legend_demon_hound_bones_item.nut
    // context: legend_demon_hound_bones_item.create.m.Name
    {
        en = "Demon Hound Bones"
        es = "Huesos de sabueso demoníaco"
    }
    // context: legend_demon_hound_bones_item.create.m.Description
    {
        en = "A few bones from a Höllenhund; they still have a faint, eerie glow about them."
        es = "Unos cuantos huesos de un Höllenhund; aún desprenden un resplandor tenue y sobrecogedor."
    }
    // FILE: scripts\items\misc\legend_demon_third_eye_item.nut
    // context: legend_demon_third_eye_item.create.m.Name
    {
        en = "Third Demon Eye"
        es = "Tercer ojo demoníaco"
    }
    // context: legend_demon_third_eye_item.create.m.Description
    {
        en = "Demon alps have no eyes, yet this eye-like organ can be retreived from inside their skulls."
        es = "Los Alps demoníacos no tienen ojos, pero este órgano parecido a un ojo puede extraerse del interior de sus cráneos."
    }
    // FILE: scripts\items\misc\legend_enemy_skill_book_item.nut
    // context: legend_enemy_skill_book_item.::inherit().m.BookName
    {
        en = "Foes and their Weaknesses:"
        es = "Los enemigos y sus debilidades:"
    }
    // context: legend_enemy_skill_book_item.::inherit().create.m.Name
    {
        en = "101: How to fight x"
        es = "101: Cómo luchar contra x"
    }
    // context: legend_enemy_skill_book_item.::inherit().create.m.Description
    {
        en = "Compendium in fighting particular enemies and their relevant weak spots.  Will teach the relevant [color=%negative%]Enemy[/color] perk group to the character that uses it."
        es = "Compendio sobre cómo combatir a enemigos concretos y sus puntos débiles. Enseñará al personaje que lo use el grupo de ventajas de [color=%negative%]Enemigo[/color] correspondiente."
    }
    // FILE: scripts\items\misc\legend_location_check_item.nut
    // context: legend_location_check_item.create.m.Name
    {
        en = "Legendary location check"
        es = "Comprobar ubicaciones legendarias"
    }
    // context: legend_location_check_item.create.m.Description
    {
        en = "Generates an event, that checks if all legendary locations spawned. Right click to start."
        es = "Genera un evento que comprueba si han aparecido todas las ubicaciones legendarias. Haz clic derecho para empezar."
    }
    // FILE: scripts\items\misc\legend_map_legendary_item.nut
    // context: legend_map_legendary_item.create.m.Name
    {
        en = "Legendary location map"
        es = "Mapa de ubicación legendaria"
    }
    // context: legend_map_legendary_item.create.m.Description
    {
        en = "This map seems to have marked location and a lot of annotations. Right click to study it."
        es = "Este mapa parece tener una ubicación marcada y muchas anotaciones. Haz clic derecho para estudiarlo."
    }
    // context: legend_map_legendary_item.setLocation.m.Name
    {
        en = "Old map"
        es = "Mapa viejo"
    }
    // context: legend_map_legendary_item.setLocation.m.Description
    {
        en = "This map unfortunately is unreadable, though you may be able to find someone to pay hefty sum for it."
        es = "Por desgracia, este mapa es ilegible, aunque quizá encuentres a alguien dispuesto a pagar una buena suma por él."
    }
    // context: legend_map_legendary_item.setLocation.m.Description
    {
        // this.m.Description = "This map seems to have marked location and a lot of annotations. After studing it for a moment, you conclude that it might be [color=" + ::Const.UI.Color.PositiveEventValue + "]" + _name + "[/color]";
        mode = "pattern"
        en = "This map seems to have marked location and a lot of annotations. After studing it for a moment, you conclude that it might be [color=<color:str>]<name:str>[/color]"
        es = "Este mapa parece tener una ubicación marcada y muchas anotaciones. Tras estudiarlo un momento, concluyes que podría tratarse de [color=<color>]<name>[/color]"
    }
    // FILE: scripts\items\misc\legend_map_named_item.nut
    // context: legend_map_named_item.create.m.Name
    {
        en = "Scout report"
        es = "Informe de exploración"
    }
    // context: legend_map_named_item.create.m.Description
    {
        en = "This map points to a location with valuable loot."
        es = "Este mapa señala una ubicación con un botín valioso."
    }
    // context: legend_map_named_item.setLocation.m.Description
    {
        // this.m.Description = "This map points to a location with valuable loot. [color=" + ::Const.UI.Color.PositiveEventValue + "]" + this.m.LocationName + "[/color]";
        mode = "pattern"
        en = "This map points to a location with valuable loot. [color=<color:str>]<location:str>[/color]"
        es = "Este mapa señala una ubicación con un botín valioso. [color=<color>]<location>[/color]"
    }
    // FILE: scripts\items\misc\legend_masterwork_fabric.nut
    // context: legend_masterwork_fabric.create.m.Name
    {
        en = "Masterwork Fabric"
        es = "Tela magistral"
    }
    // context: legend_masterwork_fabric.create.m.Description
    {
        en = "A bolt of double-quilted fabric with a mysterious, stamped mark. The material is light, thick and still flexible enough to be combined with other rare materials to make something stronger."
        es = "Un rollo de tela de doble acolchado con una misteriosa marca estampada. El material es ligero y grueso, y aun así lo bastante flexible para combinarse con otros materiales raros y crear algo más resistente."
    }
    // FILE: scripts\items\misc\legend_masterwork_metal.nut
    // context: legend_masterwork_metal.create.m.Name
    {
        en = "Masterwork Metal"
        es = "Metal magistral"
    }
    // context: legend_masterwork_metal.create.m.Description
    {
        en = "Several ingots of unknown origin bearing the same mark. This metal dark yet surprisingly light in the hand. While not very useful alone, these could be used to create something with similar, rare materials."
        es = "Varios lingotes de procedencia desconocida que llevan la misma marca. Este metal es oscuro, pero sorprendentemente ligero en la mano. Aunque por sí solos no son muy útiles, podrían servir para crear algo junto con otros materiales raros similares."
    }
    // FILE: scripts\items\misc\legend_masterwork_tools.nut
    // context: legend_masterwork_tools.create.m.Name
    {
        en = "Masterwork Tools"
        es = "Herramientas magistrales"
    }
    // context: legend_masterwork_tools.create.m.Description
    {
        en = "An assortment of tools in varying size, shape and function. Each tool bears a unique mark that lingers in the back of your mind. These tools are specially made and could be used to create something with rare materials."
        es = "Un surtido de herramientas de distintos tamaños, formas y funciones. Cada una lleva una marca única que se te queda en algún rincón de la mente. Estas herramientas están hechas a propósito y podrían servir para crear algo con materiales raros."
    }
    // FILE: scripts\items\misc\legend_mistletoe_item.nut
    // context: legend_mistletoe_item.create.m.Name
    {
        en = "Mistletoe"
        es = "Muérdago"
    }
    // context: legend_mistletoe_item.create.m.Description
    {
        en = "This parasitic plant attaches itself to a host tree. It is known associated with fertility, and used in mystical ceremonies"
        es = "Esta planta parásita se adhiere a un árbol huésped. Se la asocia con la fertilidad y se usa en ceremonias místicas"
    }
    // FILE: scripts\items\misc\legend_paint_black_item.nut
    // en = "Black Paint"
    // en base_es
    // context: legend_paint_black_item.create.m.Description
    {
        en = "A bucket of black paint. Highly sought after by artisans. It's dull appearance is a base for any fresco or artwork but alone is not interesting enough to be much much coin."
        es = "Un cubo de pintura negra. Muy codiciada por los artesanos. Su aspecto apagado sirve de base para cualquier fresco u obra de arte, pero por sí sola no resulta lo bastante interesante como para valer mucho dinero."
    }
    // FILE: scripts\items\misc\legend_paint_orange_red_item.nut
    // en = "Orange and Red Paint"
    // en base_es
    // context: legend_paint_orange_red_item.create.m.Description
    {
        en = "Buckets of orange and red paint. Both colours in high demand for artists and painters. These paints will fetch good coin."
        es = "Cubos de pintura naranja y roja. Ambos colores son muy demandados por artistas y pintores. Estas pinturas se venderán a buen precio."
    }
    // FILE: scripts\items\misc\legend_paint_red_item.nut
    // en = "Red Paint"
    // en base_es
    // context: legend_paint_red_item.create.m.Description
    {
        en = "A bucket of red paint. This is a common but much needed colour that is used from shields to the finest artwork. It is colourful but easy to make."
        es = "Un cubo de pintura roja. Es un color común pero muy necesario, que se usa desde los escudos hasta las obras de arte más refinadas. Es vistoso, pero fácil de fabricar."
    }
    // FILE: scripts\items\misc\legend_paint_remover_item.nut
    // en = "Paint Remover"
    // en base_es
    // context: legend_paint_remover_item.create.m.Description
    {
        en = "A bucket of paint remover. Everyone makes mistakes, and this is a good way for those with shakey hands to cover up their mistakes without looking like a charlatan."
        es = "Un cubo de quitapinturas. Todo el mundo comete errores, y esta es una buena forma de que quienes tienen el pulso tembloroso tapen los suyos sin parecer unos charlatanes."
    }
    // FILE: scripts\items\misc\legend_paint_set_item.nut
    // en = "Paint Set"
    // en base_es
    // context: legend_paint_set_item.create.m.Description
    {
        en = "A palette of several vibrant colors and a set of brushes. An ideal gift for any aspiring painter to use before completely losing interest halfway through."
        es = "Una paleta con varios colores vivos y un juego de pinceles. El regalo ideal para que cualquier aspirante a pintor lo use antes de perder por completo el interés a mitad de camino."
    }
    // FILE: scripts\items\misc\legend_paint_white_blue_item.nut
    // en = "White and Blue Paint"
    // en base_es
    // context: legend_paint_white_blue_item.create.m.Description
    {
        en = "Buckets of white and blue paint. Both highly sought after colours due to their rarity."
        es = "Cubos de pintura blanca y azul. Ambos colores son muy codiciados por su rareza."
    }
    // FILE: scripts\items\misc\legend_paint_white_green_yellow_item.nut
    // en = "White, Green and Yellow Paint"
    // en base_es
    // context: legend_paint_white_green_yellow_item.create.m.Description
    {
        en = "Buckets of white, green and yellow paint. This collection of paint can be used on just about anything and aside from red form the basis of most art."
        es = "Cubos de pintura blanca, verde y amarilla. Este surtido de pinturas sirve para casi cualquier cosa y, junto con el rojo, forma la base de la mayor parte del arte."
    }
    // FILE: scripts\items\misc\legend_profession_skill_book_item.nut
    // context: legend_profession_skill_book_item.::inherit().m.BookName
    {
        en = "Guilds and Craftsmanship:"
        es = "Gremios y oficios:"
    }
    // context: legend_profession_skill_book_item.::inherit().create.m.Name
    {
        en = "Skills for Dummies"
        es = "Habilidades para torpes"
    }
    // context: legend_profession_skill_book_item.::inherit().create.m.Description
    {
        en = "Profession training manual, written by an artisan.  Will teach the relevant [color=%negative%]Class[/color] perk group to the character that uses it."
        es = "Manual de formación profesional, escrito por un artesano. Enseñará al personaje que lo use el grupo de ventajas de [color=%negative%]Clase[/color] correspondiente."
    }
    // FILE: scripts\items\misc\legend_prosthetic_ear_item.nut
    // context: legend_prosthetic_ear_item.create.m.Name
    {
        en = "Prosthetic Ear"
        es = "Oreja protésica"
    }
    // context: legend_prosthetic_ear_item.create.m.Description
    {
        en = "A wax ear, carefully crafted to resemble a real one. Hardly a proper replacement, but some hearing may be returned."
        es = "Una oreja de cera, hecha con esmero para parecer real. Difícilmente es un sustituto digno, pero puede devolver algo de oído."
    }
    // context: legend_prosthetic_ear_item.getTooltip.result.extend().text
    {
        en = "Reduces the penalty of Missing Ear to [color=%negative%]-5%[/color] Initiative"
        es = "Reduce la penalización de Oreja faltante a [color=%negative%]-5%[/color] de Iniciativa"
    }
    // context: legend_prosthetic_ear_item.getTooltip.result.extend().text
    {
        en = "Right-click or drag onto the currently selected character in order to apply it. This item will be consumed in the process."
        es = "Haz clic derecho o arrastra sobre el personaje seleccionado actualmente para aplicarlo. Este artículo se consumirá en el proceso."
    }
    // context: legend_prosthetic_ear_item.getTooltip.result.extend().text
    {
        en = "Can only be used if this character has a missing ear"
        es = "Solo se puede usar si a este personaje le falta una oreja"
    }
    // FILE: scripts\items\misc\legend_prosthetic_eye_item.nut
    // context: legend_prosthetic_eye_item.create.m.Name
    {
        en = "Prosthetic Eye"
        es = "Ojo protésico"
    }
    // context: legend_prosthetic_eye_item.create.m.Description
    {
        en = "A very carefully crafted, lacquered wooden eye. It won't restore any vision, but might make the wearer feel better about their appearance."
        es = "Un ojo de madera lacada, elaborado con sumo cuidado. No devolverá la vista, pero quizá haga que quien lo lleve se sienta mejor con su aspecto."
    }
    // context: legend_prosthetic_eye_item.getTooltip.result.extend().text
    {
        en = "[color=%positive%]+7[/color] Resolve"
        es = "[color=%positive%]+7[/color] de Resolución"
    }
    // context: legend_prosthetic_eye_item.getTooltip.result.extend().text
    {
        en = "Can only be used if this character has a missing eye"
        es = "Solo se puede usar si a este personaje le falta un ojo"
    }
    // FILE: scripts\items\misc\legend_prosthetic_finger_item.nut
    // context: legend_prosthetic_finger_item.create.m.Name
    {
        en = "Prosthetic Finger"
        es = "Dedo protésico"
    }
    // context: legend_prosthetic_finger_item.create.m.Description
    {
        en = "A wooden finger with a joint for the user to force it into whatever position they need. Perfect for pointing fingers at people, but not too much else."
        es = "Un dedo de madera con una articulación para que el usuario lo fuerce a la posición que necesite. Perfecto para señalar a la gente con el dedo, pero para poco más."
    }
    // context: legend_prosthetic_finger_item.getTooltip.result.extend().text
    {
        en = "Reduces the penalty of Missing Finger to [color=%negative%]-2%[/color] Melee Skill"
        es = "Reduce la penalización de Dedo faltante a [color=%negative%]-2%[/color] de Habilidad cuerpo a cuerpo"
    }
    // context: legend_prosthetic_finger_item.getTooltip.result.extend().text
    {
        en = "Reduces the penalty of Missing Finger to [color=%negative%]-2%[/color] Ranged Skill"
        es = "Reduce la penalización de Dedo faltante a [color=%negative%]-2%[/color] de Habilidad a distancia"
    }
    // context: legend_prosthetic_finger_item.getTooltip.result.extend().text
    {
        en = "Can only be used if this character has a missing finger"
        es = "Solo se puede usar si a este personaje le falta un dedo"
    }
    // FILE: scripts\items\misc\legend_prosthetic_foot_item.nut
    // context: legend_prosthetic_foot_item.create.m.Name
    {
        en = "Prosthetic Foot"
        es = "Pie protésico"
    }
    // context: legend_prosthetic_foot_item.create.m.Description
    {
        en = "It's more than a prosthetic foot, it's a foundation! Or so it's creator says, but this contraption looks like hell to walk with. Crafted out of wood, metal and various leather straps, it manages to mimic foot movement well enough and will allow the wearer to at least recover a part of their dexterity."
        es = "¡No es solo un pie protésico, es un cimiento! O eso dice su creador, pero caminar con este artilugio parece un infierno. Hecho de madera, metal y varias correas de cuero, imita bastante bien el movimiento del pie y permitirá a quien lo lleve recuperar al menos parte de su destreza."
    }
    // context: legend_prosthetic_foot_item.getTooltip.result.extend().text
    {
        en = "Removes the [color=%negative%]1[/color] Additional Action Point per tile moved penalty from Maimed Foot Injury"
        es = "Elimina la penalización de [color=%negative%]1[/color] Punto de acción adicional por casilla recorrida de la herida Pie mutilado"
    }
    // context: legend_prosthetic_foot_item.getTooltip.result.extend().text
    {
        en = "Reduces the penalty of Missing Foot to [color=%negative%]-10%[/color] Initiative"
        es = "Reduce la penalización de Pie faltante a [color=%negative%]-10%[/color] de Iniciativa"
    }
    // context: legend_prosthetic_foot_item.getTooltip.result.extend().text
    {
        en = "Builds up [color=%negative%]3[/color] more fatigue for each tile travelled"
        es = "Acumula [color=%negative%]3[/color] de Fatiga más por cada casilla recorrida"
    }
    // context: legend_prosthetic_foot_item.getTooltip.result.extend().text
    {
        en = "Can only be used if this character has a maimed foot"
        es = "Solo se puede usar si este personaje tiene un pie mutilado"
    }
    // FILE: scripts\items\misc\legend_prosthetic_forearm_item.nut
    // context: legend_prosthetic_forearm_item.create.m.Name
    {
        en = "Prosthetic Forearm"
        es = "Antebrazo protésico"
    }
    // context: legend_prosthetic_forearm_item.create.m.Description
    {
        en = "According to the inventor, this contraption is almost like the real thing. If the real thing had no feeling and control in their forearm, of course. It can hold a weapon, even if the fingers need to be adjusted with the other hand. Mercenaries particularly enjoy setting their new hand to give the one finger salute."
        es = "Según su inventor, este artilugio es casi como el de verdad. Si el de verdad no tuviera sensibilidad ni control en el antebrazo, claro. Puede sostener un arma, aunque haya que ajustarle los dedos con la otra mano. A los mercenarios les encanta colocar su nueva mano para dedicarle a cualquiera el dedo medio."
    }
    // context: legend_prosthetic_forearm_item.getTooltip.result.extend().text
    {
        en = "Reduces the penalty of Broken Elbow Joint to [color=%negative%]-10%[/color] Melee Skill"
        es = "Reduce la penalización de Articulación del codo rota a [color=%negative%]-10%[/color] de Habilidad cuerpo a cuerpo"
    }
    // context: legend_prosthetic_forearm_item.getTooltip.result.extend().text
    {
        en = "Reduces the penalty of Broken Elbow Joint to [color=%negative%]-10%[/color] Ranged Skill"
        es = "Reduce la penalización de Articulación del codo rota a [color=%negative%]-10%[/color] de Habilidad a distancia"
    }
    // context: legend_prosthetic_forearm_item.getTooltip.result.extend().text
    {
        en = "Reduces the penalty of Broken Elbow Joint to [color=%negative%]-15%[/color] Melee Defense"
        es = "Reduce la penalización de Articulación del codo rota a [color=%negative%]-15%[/color] de Defensa cuerpo a cuerpo"
    }
    // context: legend_prosthetic_forearm_item.getTooltip.result.extend().text
    {
        en = "Can only be used if this character has a broken elbow joint"
        es = "Solo se puede usar si este personaje tiene una articulación del codo rota"
    }
    // FILE: scripts\items\misc\legend_prosthetic_hand_item.nut
    // context: legend_prosthetic_hand_item.create.m.Name
    {
        en = "Prosthetic Hand"
        es = "Mano protésica"
    }
    // context: legend_prosthetic_hand_item.create.m.Description
    {
        en = "An exceptional creation, this prosthetic hand has articulated joints which can be manipulated to hold objects and even give the finger in a pinch."
        es = "Una creación excepcional: esta mano protésica tiene articulaciones que pueden manipularse para sujetar objetos e incluso, si hace falta, sacar el dedo medio."
    }
    // context: legend_prosthetic_hand_item.getTooltip.result.extend().text
    {
        en = "User will no longer be blocked from using shields, two-handed weapons, throwing nets and from double gripping one-handed weapons"
        es = "El usuario ya no tendrá impedido usar escudos, armas a dos manos y redes arrojadizas, ni empuñar con doble agarre armas de una mano"
    }
    // context: legend_prosthetic_hand_item.getTooltip.result.extend().text
    {
        en = "[color=%negative%]-10%[/color] Melee Defense when using a shield"
        es = "[color=%negative%]-10%[/color] de Defensa cuerpo a cuerpo al usar un escudo"
    }
    // context: legend_prosthetic_hand_item.getTooltip.result.extend().text
    {
        en = "[color=%negative%]-10%[/color] Ranged Defense when using a shield"
        es = "[color=%negative%]-10%[/color] de Defensa a distancia al usar un escudo"
    }
    // context: legend_prosthetic_hand_item.getTooltip.result.extend().text
    {
        en = "[color=%negative%]-10%[/color] Melee Skill when NOT using a shield"
        es = "[color=%negative%]-10%[/color] de Habilidad cuerpo a cuerpo cuando NO se usa un escudo"
    }
    // context: legend_prosthetic_hand_item.getTooltip.result.extend().text
    {
        en = "[color=%negative%]-10%[/color] Ranged Skill when NOT using a shield"
        es = "[color=%negative%]-10%[/color] de Habilidad a distancia cuando NO se usa un escudo"
    }
    // context: legend_prosthetic_hand_item.getTooltip.result.extend().text
    {
        en = "Can only be used if this character has a missing hand"
        es = "Solo se puede usar si a este personaje le falta una mano"
    }
    // FILE: scripts\items\misc\legend_prosthetic_leg_item.nut
    // context: legend_prosthetic_leg_item.create.m.Name
    {
        en = "Prosthetic Leg"
        es = "Pierna protésica"
    }
    // context: legend_prosthetic_leg_item.create.m.Description
    {
        en = "This peg leg is pretty heavy and would be difficult to walk in. But it does allow a mercenary to walk with a certain agility retained. Holding it you feel like singing in a shanty for some reason."
        es = "Esta pata de palo es bastante pesada y costaría caminar con ella. Pero sí permite a un mercenario andar conservando cierta agilidad. Al sostenerla, por algún motivo te entran ganas de entonar una canción marinera."
    }
    // context: legend_prosthetic_leg_item.getTooltip.result.extend().text
    {
        en = "Reduces the penalty of Broken Knee to [color=%negative%]-15%[/color] Melee Skill"
        es = "Reduce la penalización de Rodilla rota a [color=%negative%]-15%[/color] de Habilidad cuerpo a cuerpo"
    }
    // context: legend_prosthetic_leg_item.getTooltip.result.extend().text
    {
        en = "Reduces the penalty of Broken Knee to [color=%negative%]-15%[/color] Ranged Skill"
        es = "Reduce la penalización de Rodilla rota a [color=%negative%]-15%[/color] de Habilidad a distancia"
    }
    // context: legend_prosthetic_leg_item.getTooltip.result.extend().text
    {
        en = "Reduces the penalty of Broken Knee to [color=%negative%]-20%[/color] Initiative"
        es = "Reduce la penalización de Rodilla rota a [color=%negative%]-20%[/color] de Iniciativa"
    }
    // context: legend_prosthetic_leg_item.getTooltip.result.extend().text
    {
        en = "Can only be used if this character has a broken knee"
        es = "Solo se puede usar si este personaje tiene una rodilla rota"
    }
    // FILE: scripts\items\misc\legend_prosthetic_nose_item.nut
    // context: legend_prosthetic_nose_item.create.m.Name
    {
        en = "Prosthetic Nose"
        es = "Nariz protésica"
    }
    // context: legend_prosthetic_nose_item.create.m.Description
    {
        en = "Nobody gaveth a damn who I was until I putteth on the mask. A faux nose attached to a strap, it allows the wearer to breath with less difficulty."
        es = "A nadie importábale un ardite quién era yo hasta que púseme la máscara. Una nariz falsa sujeta a una correa que permite a quien la lleva respirar con menos dificultad."
    }
    // context: legend_prosthetic_nose_item.getTooltip.result.extend().text
    {
        en = "Reduces the penalty of Missing Nose to [color=%negative%]-5%[/color] Max Fatigue"
        es = "Reduce la penalización de Nariz faltante a [color=%negative%]-5%[/color] de Fatiga máxima"
    }
    // context: legend_prosthetic_nose_item.getTooltip.result.extend().text
    {
        en = "Can only be used if this character has a missing nose"
        es = "Solo se puede usar si a este personaje le falta la nariz"
    }
    // FILE: scripts\items\misc\legend_redback_poison_gland_item.nut
    // context: legend_redback_poison_gland_item.create.m.Name
    {
        en = "Redback Poison Gland"
        es = "Glándula venenosa de lomo rojo"
    }
    // context: legend_redback_poison_gland_item.create.m.Description
    {
        en = "The poison gland of a Redback. Should not be carried close to any food or drink."
        es = "La glándula venenosa de un webknecht de lomo rojo. No debe llevarse cerca de ningún alimento o bebida."
    }
    // FILE: scripts\items\misc\legend_rock_unhold_bones_item.nut
    // context: legend_rock_unhold_bones_item.create.m.Name
    {
        en = "Rock Unhold Bones"
        es = "Huesos de trol de roca"
    }
    // context: legend_rock_unhold_bones_item.create.m.Description
    {
        en = "These large bones taken from a Rock Unhold are incredibly strong and valuable"
