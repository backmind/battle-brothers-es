        es = "Vio a alguien comerse un cadáver"
    }
    // FILE: scripts\skills\actives\legend_guide_steps_skill.nut
    // context: legend_guide_steps_skill.create.m.Description
    {
        en = "Point out dips and obstacles in the landscape, increasing movement for your troops."
        es = "Señala los desniveles y obstáculos del terreno, aumentando el movimiento de tus tropas."
    }
    // context: legend_guide_steps_skill.getTooltip.text
