    // context: tips
    {
        // corrige base: "¿Perdiendo...?" calca la pregunta con gerundio del inglés; en castellano va con verbo conjugado ("¿Pierdes...?").
        en = "Losing named shields to orcs? Buy Blacksmith Tools in your Retinue screen and repair any item, even if its durability reaches zero."
        es = "¿Pierdes escudos de renombre ante los orcos? Compra Herramientas del herrero en la pantalla de séquito y repara cualquier objeto, incluso si su durabilidad llega a cero."
    }
    // en = "Training your new recruits takes too long? Hire a drill sergeant to have them gain experience faster."
    // en base_es
    // en = "Facing too few enemy champions? Hire a bounty hunter to find more and even earn a bounty for every one you kill."
    // en base_es
    // en = "Paying too much in wages? Hire a paymaster to reduce the wages you have to pay."
    // en base_es
    // en = "Wondering who went there? Hire a Lookout and get more information on any footprints on the world map."
    // en base_es
    // en = "Always out of ammo and tools? Hire a scavenger to reclaim ammo you spent and gather tools from armor you destroyed."
    // en base_es
    // en = "Inventory full? Buy carts and wagons for your company in the Retinue screen."
    // en base_es
    // context: tips
    {
        en = "You unlock slots for tools in your Retinue screen by gaining Renown."
        es = "Al ganar renombre desbloqueas ranuras para herramientas en la pantalla de séquito."
    }
    // en = "Ferocious hyenas roam the southern deserts, with strong jaws that can crush even metal armor and inflict bleeding wounds."
    // en base_es
    // context: tips
    {
        en = "Try out different retinue tools to find those that complement your playstyle and chosen company origin."
        es = "Prueba diferentes herramientas del séquito para encontrar las que complementen tu estilo de juego y el origen que hayas elegido para tu compañía."
    }
