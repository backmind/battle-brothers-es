        en = "Unknown Character Perks"
        es = "Ventajas desconocidas"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "This character has unknown perks. You can pay for a tryout to reveal these."
        es = "Este personaje tiene ventajas desconocidas. Puedes pagar una prueba para revelarlos."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.text
    {
        en = "Character Perk Groups"
        es = "Grupos de ventajas del personaje"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.text
    {
        en = "[color=%negative%]Click to view all perks[/color]"
        es = "[color=%negative%]Haz clic para ver todas las ventajas[/color]"
    }
    // en = "Craft"
    // en base_es
    // en = "Pay the indicated fee, and hand over the necessary components, to receive the crafted item in return."
    // en base_es
    // en = "Travel"
    // en base_es
    // en = "Book passage for your company and fast travel to the selected destination."
    // en base_es
    // en = "Leave Shop"
    // en base_es
    // en = "Sparring Fight"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Have your mercenary participate in a sparring fight with experienced opponents and various fighting styles. The bruises collected and lessons learned will result in [color=%positive%]+50%[/color] Experience Gain for the next battle."
        es = "Haz que tu combatiente participe en un combate de entrenamiento con oponentes experimentados y estilos de lucha variados. Los moretones y las lecciones aprendidas darán [color=%positive%]+50%[/color] de experiencia ganada en la próxima batalla."
    }
    // en = "Veteran's Lessons"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Have your mercenary learn valuable lessons and insights from a true veteran of the trade. The knowledge imparted will result in [color=%positive%]+35%[/color] Experience Gain for the duration of three battles."
        es = "Haz que tu combatiente aprenda valiosas lecciones y conocimientos de un auténtico veterano del oficio. Lo aprendido dará [color=%positive%]+35%[/color] de experiencia ganada durante tres batallas."
    }
    // en = "Rigorous Schooling"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Have your mercenary undergo a rigorous training regimen to shape them into a skilled fighter. The blood and sweat spent today will benefit your mercenary in the long run with [color=%positive%]+20%[/color] Experience Gain for the duration of five battles."
        es = "Haz que tu combatiente siga un riguroso régimen de entrenamiento para forjar su destreza en la lucha. La sangre y el sudor derramados hoy le serán de provecho a la larga, con [color=%positive%]+20%[/color] de experiencia ganada durante cinco batallas."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Thorough Training"
        es = "Entrenamiento a fondo"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Utilize settlement facilities to train faster. The bruises collected and lessons learned will result in [color=%positive%]1[/color] point towards training progress. Requires participating in 2 battles to be ready for next training."
        es = "Aprovecha las instalaciones del asentamiento para entrenar más rápido. Los moretones y las lecciones aprendidas darán [color=%positive%]1[/color] punto de progreso de entrenamiento. Requiere participar en 2 batallas antes del siguiente entrenamiento."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Intense Training"
        es = "Entrenamiento intenso"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Fence with a Freifechter to train faster. The bruises collected and lessons learned will result in up to [color=%positive%]3[/color] points towards training progress. Requires participating in 5 battles to be ready for next training."
        es = "Practica esgrima con un Freifechter para entrenar más rápido. Los moretones y las lecciones aprendidas darán hasta [color=%positive%]3[/color] puntos de progreso de entrenamiento. Requiere participar en 5 batallas antes del siguiente entrenamiento."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Merciless Regimen"
        es = "Régimen despiadado"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Spare with local swordmasters and use the knowledge of veterans to adjust and perfect your skills. Rerols trait gained during Training. Requires participating in 5 battles to be ready for next training. Cost increases with each reroll."
        es = "Entrena con los maestros de espada locales y aprovecha el conocimiento de los veteranos para ajustar y perfeccionar tus habilidades. Vuelve a sortear el rasgo obtenido durante el entrenamiento. Requiere participar en 5 batallas antes del siguiente entrenamiento. El costo aumenta con cada nuevo sorteo."
    }
    // en = "Quit Game"
    // en base_es
    // en = "Quit this game and return to the main menu. Your progress here will not be saved."
    // en base_es
    // en = "Relations"
    // en base_es
    // en = "Your relations with a faction determine whether they'll fight or deal peacefully with you, their willingness to hire you for contracts, as well as the prices they give you and the number of recruits available to you at their settlements.\n\nRelations increase when working successfully for factions, and decrease on failing to do so, betraying or attacking them. Over time, relations slowly trend back towards neutral."
    // en base_es
    // en = "A mercenary company has to carry a lot of equipment and supplies. By using carts and wagons, you can expand your available inventory space and carry even more."
    // en base_es
    // en = "<header:str> for [img]gfx/ui/tooltips/money.png[/img]<cost:val>"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.text
    {
        en = "The free Lindwurm DLC adds a challenging new beast, a new player banner, as well as a new famed armor, helmet and shield. "
        es = "El DLC gratuito \"Lindwurm\" agrega una nueva bestia desafiante, un nuevo estandarte de jugador, así como una nueva armadura, casco y escudo famosos. "
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData
    {
        en = "\n\n[color=%positive%]This DLC has been installed.[/color]"
        es = "\n\n[color=%positive%]Este DLC está instalado.[/color]"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData
    {
        en = "\n\n[color=%negative%]This DLC is missing. It's available for free on Steam and GOG! ALL DLC IS NEEDED TO PLAY LEGENDS![/color]"
        es = "\n\n[color=%negative%]Falta este DLC. ¡Está disponible gratis en Steam y GOG! ¡HACEN FALTA TODOS LOS DLC PARA JUGAR A LEGENDS![/color]"
    }
    // en = "Open store page in browser"
    // en base_es
    // en = "Beasts & Exploration"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.text
    {
        // corrige base: "items" son «objetos», como en el resto del juego, no «elementos» ni «artículos».
        en = "The Beasts & Exploration DLC adds a variety of new beasts roaming the wilds, a new crafting system to create items from trophies, legendary locations with unique rewards to discover, many new contracts and events, a new system of armor attachments, new weapons, armor and usable items, and more. Legends will not work without this DLC"
        es = "El DLC \"Beasts & Exploration\" (Bestias y Exploración) agrega una variedad de nuevas bestias que deambulan por la naturaleza, un nuevo sistema de creación para crear objetos a partir de trofeos, ubicaciones legendarias con recompensas únicas para descubrir, muchos contratos y eventos nuevos, un nuevo sistema de accesorios de armadura, nuevas armas, armaduras, objetos utilizables, y más. Legends no funciona sin este DLC"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData
    {
        en = "\n\n[color=%negative%]This DLC is missing. It's available for purchase on Steam and GOG! ALL DLC IS NEEDED TO PLAY LEGENDS![/color]"
        es = "\n\n[color=%negative%]Falta este DLC. ¡Puedes comprarlo en Steam y GOG! ¡HACEN FALTA TODOS LOS DLC PARA JUGAR A LEGENDS![/color]"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Show only items that are currently equipped."
        es = "Mostrar solo los objetos equipados actualmente."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Assign All"
        es = "Asignar todo"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Add all equipment to the repair queue."
        es = "Añade todo el equipo a la cola de reparación."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Remove all"
        es = "Quitar todo"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Remove all equipment from the repair queue."
        es = "Quita todo el equipo de la cola de reparación."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Add all equipment to the salvage queue."
        es = "Añade todo el equipo a la cola de desguace."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Remove all equipment from the salvage queue."
        es = "Quita todo el equipo de la cola de desguace."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.desc
    {
        // local desc = "Number of tools that will be salvaged from selected equipment. " + tent.getConversionRate() + " points of item condition equals 1 tool. Once a tools condition reaches zero it will be destroyed.";
        mode = "pattern"
        en = "Number of tools that will be salvaged from selected equipment. <rate:str> points of item condition equals 1 tool. Once a tools condition reaches zero it will be destroyed."
        es = "Número de herramientas que se recuperarán del equipo seleccionado. <rate> puntos de estado del objeto equivalen a 1 herramienta. Cuando el estado de una herramienta llega a cero, se destruye."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.text
    {
        en = "Tools Produced"
        es = "Herramientas producidas"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.desc
    {
        en = "Number of people assigned to repair duty. The more assigned, the quicker equipment can be salvaged."
        es = "Número de personas asignadas a la tarea de reparación. Cuantas más se asignen, más rápido se podrá desguazar el equipo."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.desc
    {
        en = "Total number of hours required to salvage all the queued equipment. Assign more people to this task to decrease the amount of time required. Some backgrounds are quicker than others!"
        es = "Número total de horas necesarias para desguazar todo el equipo en cola. Asigna más personas a esta tarea para reducir el tiempo necesario. ¡Algunos trasfondos son más rápidos que otros!"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.desc
    {
        en = "Number of people assigned to crafting duty. The more assigned, the quicker items can be crafted."
        es = "Número de personas asignadas a la tarea de fabricación. Cuantas más se asignen, más rápido se podrán fabricar los objetos."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.desc
    {
        en = "Total number of hours required to craft all the queued items. Assign more people to this task to decrease the amout of time required. Some backgrounds are quicker than others!"
        es = "Número total de horas necesarias para fabricar todos los objetos en cola. Asigna más personas a esta tarea para reducir el tiempo necesario. ¡Algunos trasfondos son más rápidos que otros!"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.text
    {
        en = "Continuously Craft"
        es = "Fabricación continua"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.text
    {
        en = "Sets this item to be crafted repeatedly as long as there are enough ingredients."
        es = "Hace que este objeto se fabrique una y otra vez mientras haya ingredientes suficientes."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.desc
