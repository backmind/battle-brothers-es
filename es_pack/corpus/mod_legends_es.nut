        // text = "[color=%positive%]" + bro[0] + " units/hour [/color] " + bro[1] + " (" + bro[2] + ")"
        mode = "pattern"
        en = "[color=%positive%]<rate:str> units/hour [/color] <name:str> (<bg:str>)"
        es = "[color=%positive%]<rate> unidades/hora [/color] <name> (<bg>)"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.desc
    {
        en = "Total number of hours required to repair all the queued equipment. Assign more people to this task to decrease the amount of time required. Some backgrounds are quicker than others!"
        es = "Total de horas necesarias para reparar todo el equipo en cola. Asigna más gente a esta tarea para reducir el tiempo necesario. ¡Algunos trasfondos son más rápidos que otros!"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.text
    {
        en = "Time Required"
        es = "Tiempo necesario"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.desc
    {
        // corrige base: «Suministros médicos que consisten en...» no forma oración (el inglés dice «Los suministros médicos consisten en...»); y «Los puntos de vida se curan» omite «perdidos» ("Lost hitpoints").
        en = "Medical supplies consist of bandages, herbs, salves and the like, and are used to heal the more severe injuries sustained by your fighters in battle. One point of medical supplies is required each day for every injury to improve and ultimately heal. Lost hitpoints heal while encamped.\n\nRunning out of medical supplies will leave your fighters unable to recover from severe injuries."
        es = "Los suministros médicos consisten en vendas, hierbas, ungüentos y demás, y se usan para curar las heridas más graves que sufren tus combatientes en batalla. Cada herida necesita un punto de suministros médicos al día para mejorar y acabar curándose. Los Puntos de vida perdidos se recuperan mientras acampas.\n\nQuedarte sin suministros médicos dejará a tus combatientes sin poder recuperarse de las heridas graves."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.desc
    {
        // desc = desc + ("\n\nHealing up all your fighters will take between [color=%positive%]" + heal.DaysMin + "[/color] and [color=%positive%]" + heal.DaysMax + "[/color] days and requires between ");
        mode = "pattern"
        // y sigue con dos colores y cantidades hasta "[/color] Medical Supplies."; la frase entera va en una regla
        en = "<desc:str>\n\nHealing up all your fighters will take between [color=%positive%]<daysmin:int>[/color] and [color=%positive%]<daysmax:int>[/color] days and requires between <c1:tag><mmin:int>[/color] and <c2:tag><mmax:int>[/color] Medical Supplies."
        es = "<desc:t>\n\nCurar a todos tus combatientes llevará entre [color=%positive%]<daysmin>[/color] y [color=%positive%]<daysmax>[/color] días y requiere entre <c1><mmin>[/color] y <c2><mmax>[/color] suministros médicos."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.desc
    {
        // desc = desc + (" You need [color=%negative%]" + meds + "[/color] units each day to maintain your supply of flesh and bones for summoning.");
        mode = "pattern"
        en = "<desc:str> You need [color=%negative%]<meds:int>[/color] units each day to maintain your supply of flesh and bones for summoning."
        es = "<desc:t> Necesitas [color=%negative%]<meds>[/color] unidades al día para mantener tu provisión de carne y huesos para las invocaciones."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.desc
    {
        // desc = desc + ("\n\nYou can carry " + this.World.Assets.getMaxMedicine() + " units at most.");
        mode = "pattern"
        en = "<desc:str>\n\nYou can carry <max:int> units at most."
        es = "<desc:t>\n\nPuedes llevar como máximo <max> unidades."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.push().text
    {
        en = "Injuries:"
        es = "Heridas:"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.push().text
    {
        // text = bro[2] + " [color=%negative%]" + bro[0] + "[/color] to [color=%negative%]" + bro[1] + "[/color] days"
        mode = "pattern"
        en = "<name:str> [color=%negative%]<min:int>[/color] to [color=%negative%]<max:int>[/color] days"
        es = "<name> de [color=%negative%]<min>[/color] a [color=%negative%]<max>[/color] días"
    }
    // en = "Roster (I, C)"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.text
    {
        en = "Show the roster of the fighting force of your mercenary company. Increase your Renown to increase the Roster Size!"
        es = "Muestra la lista de combatientes de tu compañía de mercenarios. ¡Aumenta tu renombre para ampliar el tamaño de la lista!"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.push().text.::format()
    {
        // text = ::format("Next Roster Size increase at %d Renown, current: %d", nextRenown, ::World.Assets.getBusinessReputation())
        mode = "pattern"
        en = "Next Roster Size increase at <next:int> Renown, current: <cur:int>"
        es = "Próximo aumento del tamaño de la lista con <next> de renombre; actual: <cur>"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.push().text.::format()
    {
        // text = ::format("Maximum Roster Size achieved! Current Renown: %d", ::World.Assets.getBusinessReputation())
        mode = "pattern"
        en = "Maximum Roster Size achieved! Current Renown: <cur:int>"
        es = "¡Tamaño máximo de la lista alcanzado! Renombre actual: <cur>"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.push().text
    {
        en = "Terrain Movement Speed:"
        es = "Velocidad de movimiento por terreno:"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.push().text
