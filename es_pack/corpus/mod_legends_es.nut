    // context: mage_legend_mage_commander_background.create.m.Titles
    {
        en = "the Arcane"
        es = "la Arcana"
    }
    // context: mage_legend_mage_commander_background.onBuildDescription
    {
        en = "{ The air around %name% seems thicker, almost charged. It makes breathing itself difficult. %name% doesn't seem to mind though. Instead, %name%'s eyes reflects a strength of spirit able to bind the laws of nature themselves. }"
        es = "{ El aire alrededor de %name% parece más denso, casi cargado. Hasta respirar cuesta. A %name%, sin embargo, no parece importarle. Al contrario, en los ojos de %name% se refleja una fuerza de espíritu capaz de doblegar las mismísimas leyes de la naturaleza. }"
    }
    // FILE: scripts\skills\effects\legend_alp_realm_of_shadow_effect.nut
    // context: legend_alp_realm_of_shadow_effect.::inherit().getDescription
    {
        en = "This character is consumed by unnatural black mist and is experiencing supernatural terror. The horrors eat away at their sanity and they will soon be broken."
        es = "Este personaje está envuelto en una niebla negra antinatural y sufre un terror sobrenatural. Los horrores le carcomen la cordura y pronto se quebrará."
