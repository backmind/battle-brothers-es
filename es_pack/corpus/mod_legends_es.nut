    // FILE: scripts\skills\perks\perk_legend_ubernimble.nut
    // context: perk_legend_ubernimble.getDescription
    {
        en = "True berserkers shed even their clothes in the pursuit of unadaulterated primal slaughter. Gain nimble if you have no clothes or helm. Stacks with nimble"
        es = "Los verdaderos berserkers se despojan incluso de la ropa en busca de la matanza primigenia más pura. Obtienes Ligero si no llevas ropa ni casco. Se acumula con Ligero"
    }
