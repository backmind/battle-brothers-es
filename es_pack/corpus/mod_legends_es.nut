    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.extend().text
    {
        en = "The enemy is fleeing the battle. There is no point in running them down."
        es = "El enemigo huye de la batalla. No tiene sentido darle caza."
    }
    // en = "Retreat from combat"
    // en base_es
    // en = "Retreat from combat and run for your lives. Better to fight another day than to die here pointlessly."
    // en base_es
    // en = "You cannot retreat from this particular fight"
    // en base_es
    // en = "Open Menu (Esc)"
    // en base_es
    // en = "Open menu to adjust game options."
    // en base_es
    // en = "End Turn (Enter, F)"
