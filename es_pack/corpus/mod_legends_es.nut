    // FILE: scripts\items\legend_armor\armor_upgrades\legend_bone_platings_upgrade.nut
    // context: legend_bone_platings_upgrade.create.m.Description
    {
        en = "An ablative armor made of ornate bone platings, crafted from strong but surprisingly light bones. Worn on top of regular armor."
        es = "Una armadura ablativa de ornamentadas placas de hueso, elaborada con huesos fuertes pero sorprendentemente ligeros. Se lleva encima de la armadura normal."
    }
    // context: legend_bone_platings_upgrade.create.m.ArmorDescription
    {
        en = "Includes an armor made of ornate bone plates."
        es = "Incluye una armadura de ornamentadas placas de hueso."
    }
    // en = "Completely absorbs the first hit of every combat encounter which doesn't ignore armor"
    // en base_es
    // FILE: scripts\items\legend_armor\armor_upgrades\legend_double_mail_upgrade.nut
    // en = "Double Mail"
    // en base_es
    // context: legend_double_mail_upgrade.create.m.Description
    {
        en = "A set of thick double mail patches worn as shoulderguards. Heavy, but effective in adding to an armor's protection."
        es = "Un juego de gruesos parches de malla doble que se llevan como hombreras. Pesados, pero eficaces para aumentar la protección de una armadura."
    }
    // context: legend_double_mail_upgrade.create.m.ArmorDescription
