    // en base_es
    // FILE: mod_legends\!!config\camp_contracts.nut
    // en = "Intro"
    // en = "Negotiations"
    // en base_es
    // context: ::Legends.CampContracts.IntroBarbarians.Text
    {
        en = "[img]gfx/ui/events/legend_camp_hunt.png[/img]{A group of scarred warriors walk into camp like they own the place. One grunts a greeting, another spits in the dirt, and the largest tosses a half-roasted leg of meat onto your fire. %SPEECH_ON%We talk. You listen.%SPEECH_OFF%Seems they want to hire you, or maybe fight you. Either way, best to hear them out. | You wake to find a pile of unhold bones stacked at the edge of the camp. A moment later, barbarian drums rumble from the treeline, and hulking silhouettes approach. This is either a challenge or an invitation. Or both.}"
        es = "[img]gfx/ui/events/legend_camp_hunt.png[/img]{Un grupo de guerreros llenos de cicatrices entra en el campamento como si fuera suyo. Uno gruñe un saludo, otro escupe en la tierra y el más grande arroja a tu fuego una pierna de carne a medio asar. %SPEECH_ON%Nosotros hablamos. Tú escuchas.%SPEECH_OFF%Parece que quieren contratarte, o quizá pelear contigo. Sea como sea, más vale escucharlos. | Al despertar encuentras una pila de huesos de unhold amontonados al borde del campamento. Un momento después, unos tambores bárbaros retumban desde la linde del bosque y se acercan unas siluetas enormes. Esto es un desafío o una invitación. O las dos cosas.}"
    }
    // en = "Let's talk business."
    // en base_es
    // en = "Task"
    // context: ::Legends.CampContracts.IntroBandits.Text
    {
        en = "[img]gfx/ui/events/legend_camp_hunt.png[/img]{A man surprises you by sliding into your shoulder. You just about draw your sword when he quickly explains that a man by the name of %employer% has sought your acquaintance. Sheathing your weapon, you tell the stranger to take you to %them_employer% - if %they're_employer% got business, %they_employer% should tell you %themselves_employer%. The messenger nods and leads the way to a bandit's hideout. | A messenger - a young lad about as tall as a longsword - sprints by you, throwing a scroll into the air as he swings past. You catch it, but by the time you can look for the kid, he's already gone. Shrugging, you open the scroll and find the name of %employer%. Directions to a bandit's hideout tag the bottom of the scroll.}"
        es = "[img]gfx/ui/events/legend_camp_hunt.png[/img]{Un hombre te sorprende al chocar contra tu hombro. Estás a punto de desenvainar la espada cuando él te explica rápidamente que %employer% desea conocerte. Envainas el arma y le dices al desconocido que te lleve ante %el_employer%: si tiene algún asunto, que te lo diga en persona. El mensajero asiente y te guía hasta una guarida de bandidos. | Un mensajero, un muchacho que no es más alto que una espada larga, pasa corriendo a tu lado y lanza un pergamino al aire al pasar. Lo atrapas, pero cuando buscas al chico con la mirada, ya se ha ido. Te encoges de hombros, abres el pergamino y encuentras el nombre de %employer%. Al pie del pergamino hay indicaciones para llegar a una guarida de bandidos.}"
    }
    // context: ::Legends.CampContracts.IntroNecromancers.Text
    {
        en = "[img]gfx/ui/events/legend_camp_hunt.png[/img]{The camp's fire dims without a warning. Flames hiss one final time before shrinking to embers. Then, a shadowy silhouette of a %person_employer% draped in silk glides out of the dark. %SPEECH_ON%Don't be alarmed. I require your help, not your heart. A ritual has gone wrong and something is feeding on the dead - but it's not my doing.%SPEECH_OFF%%They_employer% pauses, as if to see if you believe him. %SPEECH_ON%Not everything that reeks of death is mine.%SPEECH_OFF%%They_employer% offers a heavy pouch of gold in stead of further explanation.}"
        es = "[img]gfx/ui/events/legend_camp_hunt.png[/img]{El fuego del campamento mengua sin previo aviso. Las llamas sisean una última vez antes de reducirse a brasas. Entonces, la silueta sombría de %un_employer% %hombre_employer% envuelt%o_employer% en seda se desliza fuera de la oscuridad. %SPEECH_ON%No te alarmes. Necesito tu ayuda, no tu corazón. Un ritual ha salido mal y algo se está alimentando de los muertos, pero no es obra mía.%SPEECH_OFF%Hace una pausa, como si quisiera ver si le crees. %SPEECH_ON%No todo lo que apesta a muerte es mío.%SPEECH_OFF%En lugar de dar más explicaciones, te ofrece una pesada bolsa de oro.}"
    }
    // context: ::Legends.CampContracts.IntroLegion.Title
    {
        en = "An Envoy"
        es = "Un enviado"
    }
    // context: ::Legends.CampContracts.IntroLegion.Text
    {
        en = "[img]gfx/ui/events/legend_camp_hunt.png[/img]{The camp is punctuated with the sharpening of blades and the creaking of bones. Little other noise is made outside of preparation for the next battle, only accented by quiet servitude. With little ceremony, announcement or forewarning, you find an %person_employer% stepping into the camp. Without a word, %they_employer% hands you a sealed scroll...}"
        es = "[img]gfx/ui/events/legend_camp_hunt.png[/img]{El afilado de las hojas y el crujir de los huesos salpican el campamento. Apenas se oye otro ruido que el de los preparativos para la próxima batalla, acompañados solo por una servidumbre silenciosa. Sin apenas ceremonia, anuncio ni aviso, ves que %un_employer% %hombre_employer% entra en el campamento. Sin decir palabra, te entrega un pergamino sellado...}"
    }
