        // text = "Has a range of [color=%positive%]" + getMaxRange() + "[/color] tiles on even ground" + rangeBonus + " if shooting downhill"
        mode = "pattern"
        en = "Has a range of [color=%positive%]<range:int>[/color] tiles on even ground<bonus:str> if shooting downhill"
        es = "Tiene un alcance de [color=%positive%]<range>[/color] casillas en terreno llano<bonus> si se dispara cuesta abajo"
