    // FILE: scripts\skills\actives\legend_drink_beer_skill.nut
    // context: legend_drink_beer_skill.create.m.Description
    {
        en = "Give to an adjacent ally or drink beer to get buzzed, or drunk if already buzzed, or sick if already drunk. Can not be used while engaged in melee, and anyone receiving the item needs to have a free bag slot."
        es = "Dale a un aliado adyacente o bebe cerveza para achisparte, emborracharte si ya te has achispado o enfermar si ya te has emborrachado. No se puede usar mientras se está en combate cuerpo a cuerpo, y cualquiera que reciba el artículo debe tener un espacio libre en la bolsa."
    }
    // context: legend_drink_beer_skill.tacticalLogDrink
