    // FILE: scripts\items\legend_armor\armor_upgrades\legend_armor_rusted_mail_patch_upgrade.nut
    // en = "Rusted Mail Patch"
    // en base_es
    // context: legend_armor_rusted_mail_patch_upgrade.create.m.Description
