    // en base_es
    // en = "Capacity"
    // en base_es
    // en = "Shows the current and maximum load of the stash, your global inventory."
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Fighters in Company"
        es = "Combatientes en la compañía"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "The total number of fighters under your control. Toggle fighters into reserves using the camp icon at the top left near their portrait."
        es = "El número total de combatientes bajo tu mando. Pasa combatientes a la reserva con el icono del campamento, arriba a la izquierda, junto a su retrato."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Fighters in Fighting Line"
        es = "Combatientes en la línea de batalla"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Shows the current and maximum number of fighters out of reserves and ready to fight in the next battle."
        es = "Muestra el número actual y máximo de combatientes fuera de la reserva y listos para luchar en la próxima batalla."
    }
    // en = "Ground"
    // en base_es
    // en = "Shows the current items laying on the ground."
    // en base_es
    // en = "Action Points"
    // en base_es
    // en = "Action Points (AP) are spent for every action, like moving or using a skill. Once all points are spent, the current character's turn ends automatically. AP are fully refreshed each turn."
    // en base_es
    // en = "Hitpoints represent the damage a character can take before dying. Once these reach zero, the character is considered dead. The higher the maximum hitpoints, the less likely it is a character will suffer debilitating injuries when hit."
    // en base_es
    // en = "Morale"
    // en base_es
    // en = "Morale is one of five states and represents the mental condition of combatants and their effectiveness in battle. At the lowest state, fleeing, a character will be outside your control - although they may eventually rally again. Morale changes as the battle unfolds, with characters that have high resolve less likely to fall to low morale states. Many of your opponents are affected by morale as well.\n\nMorale checks trigger on these occasions:\n- Killing an enemy\n- Seeing an enemy be killed\n- Seeing an ally be killed\n- Seeing an ally flee\n- Being hit for 15 or more damage to hitpoints\n- Being engaged by more than one opponent\n- Using certain skills, like 'Rally'"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Fatigue is gained for every action, like moving or using skills, and when being hit in combat or dodging in melee. It is reduced at a fixed rate of 15 each turn or as much as necessary for a character to start every turn with 15 less than their maximum fatigue. If a character accumulates too much fatigue they may need to rest a turn (i.e. do nothing) before being able to use more specialized skills again."
        es = "La fatiga aumenta con cada acción, como moverse o usar habilidades, y al recibir un golpe en combate o esquivar cuerpo a cuerpo. Se reduce a un ritmo fijo de 15 por turno o tanto como sea necesario para que un personaje comience cada turno con 15 menos que su fatiga máxima. Si un personaje acumula demasiada fatiga, es posible que necesite descansar un turno (es decir, no hacer nada) antes de poder volver a utilizar habilidades más especializadas."
    }
    // en = "Maximum Fatigue"
    // en base_es
    // en = "Maximum Fatigue is the amount of fatigue a character can accumulate before being unable to take any more actions and having to recuperate. It is reduced by wearing heavy equipment, especially armor."
    // en base_es
    // en = "Head Armor"
    // en base_es
    // en = "Head Armor protects, surprisingly, the head, which is harder to hit than the body, but more vulnerable to damage. The more head armor, the less damage will be applied to hitpoints on taking a hit to the head."
    // en base_es
    // en = "Body Armor"
    // en base_es
    // en = " The more body armor, the less damage will be applied to hitpoints on taking a hit to the body."
    // en base_es
    // en = "Determines the base probability of hitting a target with a melee attack, such as with swords and spears. Can be increased as the character gains experience."
    // en base_es
    // en = "Determines the base probability of hitting a target with a ranged attack, such as with bows and crossbows. Can be increased as the character gains experience."
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "A higher melee defense reduces the probability of being hit with a melee attack, such as the thrust of a spear. It can be increased as the character gains experience and by equipping a good shield. Diminishing returns above 50."
        es = "Una defensa cuerpo a cuerpo más alta reduce la probabilidad de ser golpeado con un ataque cuerpo a cuerpo, como el golpe de una lanza. Se puede incrementar a medida que el personaje gana experiencia y equipando un buen escudo. Rendimiento decreciente por encima de 50."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "A higher ranged defense reduces the probability of being hit with a ranged attack, such as an arrow shot from afar. It can be increased as the character gains experience and by equipping a good shield. Diminishing returns above 50."
        es = "Una mayor defensa a distancia reduce la probabilidad de ser alcanzado con un ataque a distancia, como una flecha disparada desde lejos. Se puede incrementar a medida que el personaje gana experiencia y equipando un buen escudo. Rendimiento decreciente por encima de 50."
    }
    // en = "Vision"
    // en base_es
    // en = "Vision, or view range, determines how far a character can see to uncover the fog of war, discover threats and hit with ranged attacks. Heavier helmets and night time can reduce vision."
    // en base_es
    // en = "Damage"
    // en base_es
    // en = "The base damage the currently equipped weapon does. Will be applied in full against hitpoints if no armor is protecting the target. If the target is protected by armor, the damage is applied to armor instead based on the weapon's effectiveness against armor. The actual damage done is modified by the skill used and the target hit."
    // en base_es
    // en = "Effectiveness against Armor"
    // en base_es
    // en = "The base percentage of damage that will be applied when hitting a target protected by armor. Once the armor is destroyed, the weapon damage applies at 100% to hitpoints. The actual damage done is modified by the skill used and the target hit."
    // en base_es
    // en = "Chance to hit head"
    // en base_es
    // en = "The base percentage chance to hit a target's head for increased damage. The final chance can be modified by the skill used."
    // en base_es
    // en = "The higher this value, the earlier the position in the turn order. Initiative is reduced by the current fatigue, as well as any penalty to maximum fatigue (such as from heavy armor). In general, someone in light armor will act before someone in heavy armor, and someone fresh will act before someone fatigued."
    // en base_es
    // en = "Resolve represents the willpower and bravery of characters. The higher, the less likely that characters fall to lower morale states at negative events, and the more likely that characters gain confidence from positive events. Resolve also acts as defense against certain mental attacks that inflict panic, fear or mind control. See also: Morale."
    // en base_es
    // en = "Talent"
    // en base_es
    // en = "TODO"
    // en = "UNDEFINED"
    // en base_es
    // en = "Higher Level"
    // en base_es
    // en = "This character already has experience in combat and starts with a higher level."
    // en base_es
    // en = "Load Campaign"
    // en base_es
    // en = "Load the selected campaign."
    // en base_es
    // en = "Cancel"
    // en base_es
    // en = "Return to the main menu."
    // en base_es
    // en = "Delete Campaign"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "[color=%negative%]WARNING:[/color] Deletes the selected campaign without any further warning."
        es = "[color=%negative%]ADVERTENCIA:[/color] Borra la partida seleccionada sin más avisos."
    }
    // en = "Save Campaign"
    // en base_es
    // en = "Save campaign at the selected slot."
    // en base_es
    // en = "Company Name"
    // en base_es
    // en = "The name your mercenary company will be known by throughout the lands."
    // en base_es
    // en = "Map Seed"
    // en base_es
    // en = "A map seed is a unique string that determines how the world in your campaign will look like. You can see the seed of ongoing campaigns in the game menu accessible by pressing the Escape key, and then share it with friends to have them play in the same world."
    // en base_es
    // en = "Beginner Difficulty"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "We all start somewhere.\n\n Enemy scaling rarely matches your own company strength one-to-one, often giving you an innate advantage in battles. Your fighters will gain bonus experience and retreating from battle is easier and less risky. You have a slight base positive hitchance modifier while your enemies have a negative one. \n\nRecommended for players new to the game or still learning."
        es = "Todos empezamos en algún sitio.\n\n La escala de los enemigos rara vez se ajusta uno a uno a la fuerza de tu compañía, lo que a menudo te da una ventaja innata en las batallas. Tus combatientes ganarán experiencia adicional, y retirarse de una batalla es más fácil y menos arriesgado. Tienes un ligero modificador base positivo a la probabilidad de acierto, mientras que el de tus enemigos es negativo. \n\nRecomendado para jugadores que empiezan en el juego o que aún están aprendiendo."
    }
    // en = "Veteran Difficulty"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Provides for a balanced playing experience that can be quite challenging at times.\n\n Enemy scaling typically matches your company strength one-to-one. You may experience some difficult fights, but rarely anything you cannot handle — unless you seek one out. You have a slight base positive hitchance modifier for all attacks against your enemies. \n\nRecommended for players who enjoy a firm but fair experience in battles."
        es = "Ofrece una experiencia de juego equilibrada que a veces puede ser todo un desafío.\n\n La escala de los enemigos suele ajustarse uno a uno a la fuerza de tu compañía. Puede que tengas algún combate difícil, pero rara vez algo que no puedas afrontar, a menos que lo busques. Tienes un ligero modificador base positivo a la probabilidad de acierto en todos tus ataques contra los enemigos. \n\nRecomendado para jugadores que disfrutan de batallas exigentes pero justas."
    }
    // en = "Expert Difficulty"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "The odds are against you. This is the intended difficulty and the one Legends is balanced around.\n\n Scaling is easier early game, then 1.5x as hard as normal for mid to late game. Enemies have a slight base hitchance modifier to strike you. \n\nRecommended for players who have mastered Vanilla and enjoy a tough, yet tactical experience."
        es = "Las probabilidades están en tu contra. Esta es la dificultad prevista y la que Legends toma como referencia para su equilibrio.\n\n La escala es más fácil al principio de la partida y luego 1,5 veces más dura que en normal a mitad y al final de la partida. Los enemigos tienen un ligero modificador base a la probabilidad de acertarte. \n\nRecomendado para jugadores que dominan el juego base y disfrutan de una experiencia dura pero táctica."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Legendary Difficulty"
        es = "Dificultad legendaria"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Evil lurks in every corner — this is where legends are forged.\n\n All enemies gain new perks, some have new effects entirely. Scaling and mechanics is about that of Expert early game, but will rapidly increase mid-late game. Expect to see more champions earlier and harder enemies much sooner — along with the the experience and equipment they bring... \n\nRecommended for those who enjoy a tactical challenge and can accept losses for a greater good."
        es = "El mal acecha en cada rincón: aquí es donde se forjan las leyendas.\n\n Todos los enemigos obtienen ventajas nuevas, y algunos tienen efectos completamente nuevos. La escala y las mecánicas son más o menos las de Experto al principio de la partida, pero aumentarán rápidamente a mitad y al final. Prepárate para ver más campeones antes y enemigos más duros mucho antes, junto con la experiencia y el equipo que traen... \n\nRecomendado para quienes disfrutan de un desafío táctico y pueden aceptar pérdidas por un bien mayor."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "The world is mostly at peace and has been for several generations, many goods are plentiful and life is fruitful — for most. \n\n Prices are 5% better than normal and you will gain a base +10% from contract payments. \nQuantity of recruits is doubled and deserters will give their equipment to the company stash when they leave. \n\nRecommended for players new to the game or have played little of Vanilla at all."
        es = "El mundo vive casi por completo en paz, y así ha sido durante varias generaciones; abundan muchos bienes y la vida es próspera, para la mayoría. \n\n Los precios son un 5% mejores de lo normal y obtendrás una base de +10% en los pagos de contratos. \nLa cantidad de reclutas se duplica y los desertores dejarán su equipo en el almacén de la compañía al marcharse. \n\nRecomendado para jugadores que empiezan en el juego o que apenas han jugado al juego base."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Join the world at a time of relative stability, provides for a balanced playing experience with some challenges. \n\n You will only have a base healing and repair rate of 66% outside camp. \nQuantity of recruits is increased by half and deserters will give their equipment to the company stash when they leave. \n\nRecommended for those who are new to legends and have mastered Vanilla at expert difficulty."
        es = "Llegas al mundo en una época de relativa estabilidad; ofrece una experiencia de juego equilibrada con algunos desafíos. \n\n Fuera del campamento solo tendrás una tasa base de curación y reparación del 66%. \nLa cantidad de reclutas aumenta un 50% y los desertores dejarán su equipo en el almacén de la compañía al marcharse. \n\nRecomendado para quienes son nuevos en Legends y dominan el juego base en dificultad Experto."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "The economic difficulty Legends is balanced around. You will need to plan ahead and budget accordingly.\n\n You will only have a base healing and repair rate of 33% outside camp. You will also suffer -5% to buying, selling and contract payments. \nDeserters will take their equipment with them. \n\nRecommended for those who want to experience Legends as orginally intended."
        es = "La dificultad económica que Legends toma como referencia para su equilibrio. Tendrás que planificar con antelación y ajustar el presupuesto.\n\n Fuera del campamento solo tendrás una tasa base de curación y reparación del 33%. También sufrirás un -5% al comprar, al vender y en los pagos de contratos. \nLos desertores se llevarán su equipo. \n\nRecomendado para quienes quieren jugar a Legends tal como se concibió en un principio."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "The intended economic difficulty for Legends. Resources are hard to come by, you will need to persevere with what you are given — time will not be your friend.\n\n You will only have a base healing and repair rate of 10% outside camp. You will also suffer -10% to buying, selling and contract payments. \nRecruit quantity and quality reduced by half and deserters will take their equipment with them. \n\nRecommended for those who have mastered hard difficulty want the most challenging experience."
        es = "La dificultad económica prevista para Legends. Los recursos escasean y tendrás que arreglártelas con lo que te den; el tiempo no será tu amigo.\n\n Fuera del campamento solo tendrás una tasa base de curación y reparación del 10%. También sufrirás un -10% al comprar, al vender y en los pagos de contratos. \nLa cantidad y la calidad de los reclutas se reducen a la mitad y los desertores se llevarán su equipo. \n\nRecomendado para quienes dominan la dificultad difícil y quieren la experiencia más exigente."
    }
    // en = "High Starting Funds"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "You'll start with more crowns, stash space and resources of your chosen story origin. \n\nRecommended for new players or those who do not wish to manage their inventory at all."
        es = "Empezarás con más coronas, espacio de almacén y recursos del origen que hayas elegido. \n\nRecomendado para jugadores nuevos o para quienes no quieren gestionar su inventario en absoluto."
    }
    // en = "Medium Starting Funds"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "You'll start with half the regular starting resources of your chosen story origin. \n\nRecommended for a balanced experience."
        es = "Empezarás con la mitad de los recursos iniciales normales del origen que hayas elegido. \n\nRecomendado para una experiencia equilibrada."
    }
    // en = "Low Starting Funds"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "You'll start with reduced stash space and no bonus resources for your starting story origin. \n\nRecommended for experienced players who wish to build their company from the ground up by themselves."
        es = "Empezarás con menos espacio de almacén y sin recursos adicionales para tu origen inicial. \n\nRecomendado para jugadores experimentados que quieren levantar su compañía desde cero por sí mismos."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "No Starting Funds"
        es = "Sin fondos iniciales"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "You'll start without crowns or resources, unless your starting story origin takes pity and gives them to you. \n\nRecommended for those who have a keen logistic mind and can manage an inventory well."
        es = "Empezarás sin coronas ni recursos, salvo que tu origen inicial se apiade de ti y te los dé. \n\nRecomendado para quienes tienen buena cabeza para la logística y saben gestionar bien un inventario."
    }
    // en = "Starting Scenario"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        // corrige base: «equipos» (que en castellano sugiere grupos de personas) por «equipo», que es lo que dice "equipment".
        en = "Choose how your company starts out in the world. Depending on your choice, you'll start with different fighters, equipment, resources, and special rules."
        es = "Elige cómo comienza tu compañía en el mundo. Dependiendo de tu elección, comenzarás con diferentes combatientes, equipo, recursos y reglas especiales."
    }
    // en = "Ironman"
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.text
    {
        en = "Not recommended in Legends. Ironman mode disables manual saving. Only a single save will exist for the company, and the game is automatically saved during the game and on exiting it. Losing the whole company means losing the save. Not recommended in while Legends is in Beta due to possible save corruptions.\n\nNote that on weaker computers autosaves may result in the game pausing for a few seconds."
        es = "No recomendado en Legends. El modo Hombre de Hierro desactiva el guardado manual. Solo existirá una partida guardada para la compañía, y el juego se guarda automáticamente durante la partida y al salir. Perder toda la compañía significa perder la partida guardada. No se recomienda mientras Legends esté en beta, porque las partidas guardadas podrían corromperse.\n\nTen en cuenta que, en PC poco potentes, los guardados automáticos pueden pausar el juego unos segundos."
    }
