        es = "<desc>Los Leñadores asignados con la ventaja Tajos del montaraz pueden traer madera para comerciar, y los Mineros con la ventaja Buscador de mena pueden encontrar gemas. "
    }
    // context: gatherer_building.getDescription.desc
