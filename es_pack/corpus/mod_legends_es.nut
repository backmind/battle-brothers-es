    // FILE: mod_legends\hooks\config\perk_strings.nut
    // context: ::Const.Strings.PerkDescription.DevastatingStrikes
    {
        en = "\nWhat could stand before you now?\n\n[color=%passive%][u]Passive:[/u][/color]\n• All damage inflicted is increased by [color=%positive%]10%[/color].\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.FortifiedMind
    {
        en = "\nAn iron will is not swayed from the true path easily.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Resolve is increased by [color=%positive%]25%[/color].\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Student
    {
        en = "\nEverything can be learned if you put your mind to it.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants an additional [color=%positive%]20%[/color] experience from battle.\n\n• At the twelfth character level, you gain an additional perk point.\n\n• The bonus experience stays until level 99.\n\n• Doesn't get as irritated while reading.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.KillingFrenzy
    {
        en = "\n'YOU'RE NEXT!'\n\n[color=%passive%][u]Passive:[/u][/color]\n• A kill increases all damage by [color=%positive%]25%[/color] for two turns.\n\n• Does not stack, but another kill will reset the timer.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Pathfinder
    {
        // ::Const.Strings.PerkDescription.Pathfinder <- "\nLearn to move on difficult terrain.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Action Point costs for movement on all terrain is reduced by [color=%negative%]-1[/color] to a minimum of [color=%negative%]2[/color] Action Points per tile.\n\n• Base Fatigue cost of movement on difficult terrain is reduced by [color=%negative%]50%[/color].\n\n• Changing height levels has no additional Action Point cost anymore.\n[color=%passive%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Climb[/color] skill which allows you to climb sheer cliffs up to five levels of height in one action.\n\n• Does not trigger attacks of opportunity.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]20[/color] Fatigue\n";
        mode = "pattern"
        en = "\nLearn to move on difficult terrain.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Action Point costs for movement on all terrain is reduced by [color=%negative%]-1[/color] to a minimum of [color=%negative%]2[/color] Action Points per tile.\n\n• Base Fatigue cost of movement on difficult terrain is reduced by [color=%negative%]50%[/color].\n\n• Changing height levels has no additional Action Point cost anymore.\n[color=%passive%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Climb[/color] skill which allows you to climb sheer cliffs up to five levels of height in one action.\n\n• Does not trigger attacks of opportunity.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]20[/color] Fatigue\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.InspiringPresence
    {
        // ::Const.Strings.PerkDescription.InspiringPresence <- "\nA rousing speech at the start of every battle inspires your allies.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants [color=%damage%]+10[/color] damage while wielding a battle standard.\n\n• Allies have a chance to start the battle at [color=%status%]Confident[/color] morale that is equal to [color=%positive%]33%[/color] of your Resolve, unless prohibited by character traits.\n\n• For each point of Resolve below 100 there is a [color=%negative%]1%[/color] chance the speech backfires and causes [color=%status%]Wavering[/color] morale.\n";
        mode = "pattern"
        en = "\nA rousing speech at the start of every battle inspires your allies.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants [color=%damage%]+10[/color] damage while wielding a battle standard.\n\n• Allies have a chance to start the battle at [color=%status%]Confident[/color] morale that is equal to [color=%positive%]33%[/color] of your Resolve, unless prohibited by character traits.\n\n• For each point of Resolve below 100 there is a [color=%negative%]1%[/color] chance the speech backfires and causes [color=%status%]Wavering[/color] morale.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Stalwart
    {
        // ::Const.Strings.PerkDescription.Stalwart <- "\nUnyielding in the face of adversity, the stalwart warrior stands firm against all odds.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants passive immunity against being [color=%status%]Knocked Back[/color], [color=%status%]Pulled[/color], [color=%status%]Grabbed[/color] or [color=%status%]Swallowed[/color].\n• Applies to skills such as Knock Back, Hook and others that change a character's position.\n";
        mode = "pattern"
        en = "\nUnyielding in the face of adversity, the stalwart warrior stands firm against all odds.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants passive immunity against being [color=%status%]Knocked Back[/color], [color=%status%]Pulled[/color], [color=%status%]Grabbed[/color] or [color=%status%]Swallowed[/color].\n• Applies to skills such as Knock Back, Hook and others that change a character's position.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Steadfast
    {
        en = "\nFirm and resolute.\n\n[color=%passive%][u]Passive:[/u][/color]\n• The Fatigue cost of getting hit or missed by regular attacks is reduced by [color=%negative%]90%[/color]. Attacks that specifically target Fatigue are unaffected.\n\n• Additionally for every 10 points of gear weight from all slots, gain [color=%positive%]1[/color] melee defense.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.SunderingStrikes
    {
        en = "\nKnights would do well to fear your heavy blows.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Effectiveness vs Armor is increased by [color=%positive%]+20%[/color] for any weapon used.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.BattleFlow
    {
        en = "\nGlide through battle like a leaf in a stream.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Once per turn, upon killing an opponent, reduce current Fatigue by [color=%negative%]10%[/color] of characters base maximum Fatigue (before penalties due to armor weight are applied).\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.SpecBow
    {
        en = "\nMaster the art of archery and pelting your opponents with arrows from afar.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• View range and maximum firing range with bows is increased by [color=%positive%]+1[/color].\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.SpecCrossbow
    {
        en = "\nMaster crossbows and firearms, and learn where to aim best.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• An additional [color=%positive%]20%[/color] of damage inflicted with crossbows ignores armor.\n\n• Handgonnes now require [color=%negative%]6[/color] Action Points to reload and can be fired every turn instead of every other turn.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.SpecThrowing
    {
        // ::Const.Strings.PerkDescription.SpecThrowing <- "\nMaster throwing weapons to wound or kill the enemy before they even get close.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• Gain [color=%positive%]+20%[/color] additional Armor penetration, [color=%positive%]+25%[/color] Armor effectiveness and lowers the threshold to inflict [color=%status%]Injuries[/color] by [color=%negative%]33%[/color] when using Throwing weapons.\n";
        mode = "pattern"
        en = "\nMaster throwing weapons to wound or kill the enemy before they even get close.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• Gain [color=%positive%]+20%[/color] additional Armor penetration, [color=%positive%]+25%[/color] Armor effectiveness and lowers the threshold to inflict [color=%status%]Injuries[/color] by [color=%negative%]33%[/color] when using Throwing weapons.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.SpecAxe
    {
        // ::Const.Strings.PerkDescription.SpecAxe <- "\nMaster combat with axes and destroying shields.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• [color=%skill%]Split Shield[/color] damage is increased by [color=%positive%]50%[/color] when used with axes.\n\n• [color=%skill%]Round Swing[/color] gains [color=%positive%]+5%[/color] chance to hit.\n\n• The Longaxe no longer has a penalty for attacking targets directly adjacent.\n";
        mode = "pattern"
        en = "\nMaster combat with axes and destroying shields.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• [color=%skill%]Split Shield[/color] damage is increased by [color=%positive%]50%[/color] when used with axes.\n\n• [color=%skill%]Round Swing[/color] gains [color=%positive%]+5%[/color] chance to hit.\n\n• The Longaxe no longer has a penalty for attacking targets directly adjacent.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.SpecCleaver
    {
        // ::Const.Strings.PerkDescription.SpecCleaver <- "\nMaster cleavers to inflict gruesome wounds.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• [color=%status%]Bleeding[/color] damage inflicted by cleavers and whips is doubled to [color=%positive%]10[/color] and [color=%positive%]20[/color] per turn, respectively.\n\n• [color=%skill%]Disarm[/color] only has half the penalty to hit.\n";
        mode = "pattern"
        en = "\nMaster cleavers to inflict gruesome wounds.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• [color=%status%]Bleeding[/color] damage inflicted by cleavers and whips is doubled to [color=%positive%]10[/color] and [color=%positive%]20[/color] per turn, respectively.\n\n• [color=%skill%]Disarm[/color] only has half the penalty to hit.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.SpecDagger
    {
        // ::Const.Strings.PerkDescription.SpecDagger <- "\nMaster swift and deadly daggers.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• [color=%skill%]Stab[/color], [color=%skill%]Puncture[/color], [color=%skill%]Perforate[/color], [color=%skill%]Skewer[/color] and [color=%skill%]Deathblow[/color] Action Point cost is reduced to [color=%negative%]3[/color], allowing for an additional attack each turn.\n\n• [color=%skill%]Throw Knife[/color] chance to distract on head hit is increased by [color=%positive%]25%[/color].\n";
        mode = "pattern"
        en = "\nMaster swift and deadly daggers.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• [color=%skill%]Stab[/color], [color=%skill%]Puncture[/color], [color=%skill%]Perforate[/color], [color=%skill%]Skewer[/color] and [color=%skill%]Deathblow[/color] Action Point cost is reduced to [color=%negative%]3[/color], allowing for an additional attack each turn.\n\n• [color=%skill%]Throw Knife[/color] chance to distract on head hit is increased by [color=%positive%]25%[/color].\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.SpecSword
    {
        // ::Const.Strings.PerkDescription.SpecSword <- "\nMaster the art of swordfighting and using your opponent's mistakes to your advantage.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue and [color=%positive%]+5%[/color] chance to hit.\n\n• [color=%status%]Riposting[/color] no longer has a penalty to hitchance.\n\n• [color=%skill%]Swing[/color] has a [color=%positive%]+10%[/color] chance to hit if using a Sword.\n\n• [color=%skill%]Gash[/color] has a [color=%negative%]50%[/color] lower threshold to inflict [color=%status%]Injuries[/color].\n\n• When [color=%status%]Dual Wielding[/color] swords, [color=%skill%]Riposte[/color] can trigger from both weapons, allowing two counter-attacks per missed enemy attack.\n";
        mode = "pattern"
        en = "\nMaster the art of swordfighting and using your opponent's mistakes to your advantage.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue and [color=%positive%]+5%[/color] chance to hit.\n\n• [color=%status%]Riposting[/color] no longer has a penalty to hitchance.\n\n• [color=%skill%]Swing[/color] has a [color=%positive%]+10%[/color] chance to hit if using a Sword.\n\n• [color=%skill%]Gash[/color] has a [color=%negative%]50%[/color] lower threshold to inflict [color=%status%]Injuries[/color].\n\n• When [color=%status%]Dual Wielding[/color] swords, [color=%skill%]Riposte[/color] can trigger from both weapons, allowing two counter-attacks per missed enemy attack.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.SpecSpear
    {
        // ::Const.Strings.PerkDescription.SpecSpear <- "\nMaster fighting with spears and keeping the enemy at bay.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• [color=%skill%]Spearwall[/color] is no longer disabled once an opponent manages to overcome it. Instead, [color=%skill%]Spearwall[/color] can still be used and continues to give free attacks on any further opponent attempting to enter the Zone of Control.\n\n• Reduces the AP cost of two-handed spear skills: [color=%skill%]Prong[/color], [color=%skill%]Skewer[/color] and [color=%skill%]Heartseeker[/color] by [color=%negative%]1[/color]. [color=%skill%]Prong[/color] and [color=%skill%]Heartseeker[/color] no longer have a penalty for attacking targets directly adjacent.\n\n• Increases armor penetration of [color=%skill%]Heartseeker[/color] by [color=%positive%]+5%[/color].\n";
        mode = "pattern"
        en = "\nMaster fighting with spears and keeping the enemy at bay.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• [color=%skill%]Spearwall[/color] is no longer disabled once an opponent manages to overcome it. Instead, [color=%skill%]Spearwall[/color] can still be used and continues to give free attacks on any further opponent attempting to enter the Zone of Control.\n\n• Reduces the AP cost of two-handed spear skills: [color=%skill%]Prong[/color], [color=%skill%]Skewer[/color] and [color=%skill%]Heartseeker[/color] by [color=%negative%]1[/color]. [color=%skill%]Prong[/color] and [color=%skill%]Heartseeker[/color] no longer have a penalty for attacking targets directly adjacent.\n\n• Increases armor penetration of [color=%skill%]Heartseeker[/color] by [color=%positive%]+5%[/color].\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.SpecPolearm
    {
        // ::Const.Strings.PerkDescription.SpecPolearm <- "\nMaster polearms and keeping the enemy at bay.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• [color=%skill%]Rupture[/color] increases [color=%status%]Bleeding[/color] damage inflicted to [color=%positive%]10[/color].\n\n• Increases [color=%status%]Daze[/color] chance when using [color=%skill%]Staff Daze[/color] to [color=%positive%]100%[/color] and increase the range of [color=%skill%]Leap[/color] by [color=%positive%]1[/color] when using a staff.\n\n• Other polearm skills have their Action Point cost reduced by [color=%negative%]1[/color] and no longer have a penalty for attacking targets directly adjacent.\n\n";
        mode = "pattern"
        en = "\nMaster polearms and keeping the enemy at bay.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• [color=%skill%]Rupture[/color] increases [color=%status%]Bleeding[/color] damage inflicted to [color=%positive%]10[/color].\n\n• Increases [color=%status%]Daze[/color] chance when using [color=%skill%]Staff Daze[/color] to [color=%positive%]100%[/color] and increase the range of [color=%skill%]Leap[/color] by [color=%positive%]1[/color] when using a staff.\n\n• Other polearm skills have their Action Point cost reduced by [color=%negative%]1[/color] and no longer have a penalty for attacking targets directly adjacent.\n\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.SpecHammer
    {
        // ::Const.Strings.PerkDescription.SpecHammer <- "\nMaster hammers and fighting against heavily armored opponents.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• [color=%skill%]Destroy Armor[/color] and [color=%skill%]Demolish Armor[/color] inflict [color=%positive%]33%[/color] more damage against armor.\n\n• [color=%skill%]Shatter[/color] gains [color=%positive%]+5%[/color] chance to hit.\n\n• [color=%skill%]Obliterate[/color] gains [color=%positive%]+25%[/color] chance to hit.\n\n• The Polehammer no longer has a penalty for attacking targets directly adjacent.\n";
        mode = "pattern"
        en = "\nMaster hammers and fighting against heavily armored opponents.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• [color=%skill%]Destroy Armor[/color] and [color=%skill%]Demolish Armor[/color] inflict [color=%positive%]33%[/color] more damage against armor.\n\n• [color=%skill%]Shatter[/color] gains [color=%positive%]+5%[/color] chance to hit.\n\n• [color=%skill%]Obliterate[/color] gains [color=%positive%]+25%[/color] chance to hit.\n\n• The Polehammer no longer has a penalty for attacking targets directly adjacent.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.SpecMace
    {
        // ::Const.Strings.PerkDescription.SpecMace <- "\nMaster maces to beat your opponents into submission, armored or not.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• [color=%skill%]Knock Out[/color], [color=%skill%]Knock Over[/color], and [color=%skill%]Strike Down[/color] have a [color=%positive%]100%[/color] chance to [color=%status%]Stun[/color] the target if not immune.\n\n• The Polemace no longer has a penalty for attacking targets directly adjacent.\n";
        mode = "pattern"
        en = "\nMaster maces to beat your opponents into submission, armored or not.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• [color=%skill%]Knock Out[/color], [color=%skill%]Knock Over[/color], and [color=%skill%]Strike Down[/color] have a [color=%positive%]100%[/color] chance to [color=%status%]Stun[/color] the target if not immune.\n\n• The Polemace no longer has a penalty for attacking targets directly adjacent.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.SpecFlail
    {
        // ::Const.Strings.PerkDescription.SpecFlail <- "\nMaster flails and circumvent your opponent's shield.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• [color=%skill%]Lash[/color] and [color=%skill%]Hail[/color] ignore the defense bonus of shields.\n\n• [color=%skill%]Thresh[/color] gains [color=%positive%]+5%[/color] chance to hit.\n\n• [color=%skill%]Pound[/color] ignores additional [color=%positive%]+10%[/color] armor penetration on hits to the head.\n";
        mode = "pattern"
        en = "\nMaster flails and circumvent your opponent's shield.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Skills build up [color=%negative%]25%[/color] less Fatigue.\n\n• [color=%skill%]Lash[/color] and [color=%skill%]Hail[/color] ignore the defense bonus of shields.\n\n• [color=%skill%]Thresh[/color] gains [color=%positive%]+5%[/color] chance to hit.\n\n• [color=%skill%]Pound[/color] ignores additional [color=%positive%]+10%[/color] armor penetration on hits to the head.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Gifted
    {
        en = "\nMercenary life comes easy when you're naturally gifted.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Instantly gain a levelup to increase this character's attributes with maximum rolls, but without talents.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.BagsAndBelts
    {
        en = "\nExtra pockets.\n\n[color=%passive%][u]Passive:[/u][/color]\n•Unlocks two extra bag slots to carry all your favorite things.\n\n• Non-two-handed items placed in bags no longer give a penalty to Maximum Fatigue.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.NineLives
    {
        // ::Const.Strings.PerkDescription.NineLives <- "\nNot done yet!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Once per battle, upon receiving a killing blow, survive instead with a few Hitpoints left.\n\n• Upon surviving, all damage over time effects (e.g. [color=%status%]Bleeding[/color], [color=%status%]Poison[/color]) are cured, and gain [color=%positive%]15[/color] Melee Defense, Ranged Defense, Resolve, and Initiative for one turn.\n\n• Grants a one in nine chance to survive a fatal blow with an injury.\n";
        mode = "pattern"
        en = "\nNot done yet!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Once per battle, upon receiving a killing blow, survive instead with a few Hitpoints left.\n\n• Upon surviving, all damage over time effects (e.g. [color=%status%]Bleeding[/color], [color=%status%]Poison[/color]) are cured, and gain [color=%positive%]15[/color] Melee Defense, Ranged Defense, Resolve, and Initiative for one turn.\n\n• Grants a one in nine chance to survive a fatal blow with an injury.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Nimble
    {
        en = "\nSpecialize in light armor!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Hitpoint damage taken is reduced by up to [color=%negative%]60%[/color]. If you also have [color=%perk%]Relentless[/color], damage done to armor is reduced by [color=%negative%]33%[/color] of your Nimble damage reduction.\n\n• This value is lowered exponentially by the total penalty to Maximum Fatigue from body and head armor above 15.\n\n• Does not affect damage from mental attacks or status effects.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Dodge
    {
        en = "\nToo fast for you!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]15%[/color] of this character's current Initiative as a bonus to Melee and Ranged Defense.\n\n• Gain a further [color=%positive%]15%[/color] bonus if your maximum Hitpoints are closer to 50. This additional bonus gradually drops as your maximum Hitpoints increase to 100.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Colossus
    {
        // ::Const.Strings.PerkDescription.Colossus <- "\nBring it on!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Hitpoints are increased by [color=%positive%]25%[/color], which reduces the chance to sustain debilitating [color=%status%]Injuries[/color] on hit.\n";
        mode = "pattern"
        en = "\nBring it on!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Hitpoints are increased by [color=%positive%]25%[/color], which reduces the chance to sustain debilitating [color=%status%]Injuries[/color] on hit.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkName.Taunt
    {
        en = "Battlefield Control"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Taunt
    {
        // ::Const.Strings.PerkDescription.Taunt <- "\n'Being aware of your surroundings can make or break a fight.'\n\n[color=%passive%][u]Passive:[/u][/color]\n• Has a [color=%positive%]50%[/color] lower chance to inflict friendly fire. Stacks with the 'Team Player'.\n\n• [color=%skill%]Knock Back[/color] will now apply [color=%status%]Taunt effect[/color].\n\n• [color=%skill%]Knock Back[/color], [color=%skill%]Repel[/color] and [color=%skill%]Hook[/color] skills have [color=%positive%]100%[/color] chance to hit when targeting an allied character and will not apply negative effects or damage when used on an ally.\n\n[color=%passive%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Taunt[/color] skill which forces a targeted opponent take offensive actions instead of defensive ones.\n\n• Will also apply the [color=%status%]Taunt effect[/color] which will make all enemies more likely to target you until the start of your next turn. Enemies will be more likely to target you by [color=%positive%]15%[/color] for every 10 points of resolve with a maximum bonus of 150%.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]15[/color] Fatigue.\n";
        mode = "pattern"
        en = "\n'Being aware of your surroundings can make or break a fight.'\n\n[color=%passive%][u]Passive:[/u][/color]\n• Has a [color=%positive%]50%[/color] lower chance to inflict friendly fire. Stacks with the 'Team Player'.\n\n• [color=%skill%]Knock Back[/color] will now apply [color=%status%]Taunt effect[/color].\n\n• [color=%skill%]Knock Back[/color], [color=%skill%]Repel[/color] and [color=%skill%]Hook[/color] skills have [color=%positive%]100%[/color] chance to hit when targeting an allied character and will not apply negative effects or damage when used on an ally.\n\n[color=%passive%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Taunt[/color] skill which forces a targeted opponent take offensive actions instead of defensive ones.\n\n• Will also apply the [color=%status%]Taunt effect[/color] which will make all enemies more likely to target you until the start of your next turn. Enemies will be more likely to target you by [color=%positive%]15%[/color] for every 10 points of resolve with a maximum bonus of 150%.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Brawny
    {
        en = "\nAll this exercise has you in great shape.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Fatigue is increased by [color=%positive%]25%[/color] of your Base Fatigue. This bonus will also offset Initiative penalties from wearing armor.\n\n• Weapons with extra Fatigue build-up on skills have this penalty reduced by [color=%negative%]1[/color]\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.ShieldBash
    {
        // ::Const.Strings.PerkDescription.ShieldBash <- "\n'Knock them back!'\n\n[color=%passive%][u]Passive:[/u][/color]\n• The [color=%skill%]Knock Back[/color] skill now inflicts [color=%positive%]10-25[/color] Damage (50% effective against armor) and [color=%damage%]10[/color] Fatigue Damage.\n\n• Additionally damage will also scale by [color=%positive%]10%[/color] of your shield's maximum condition with a maximum bonus of 10.\n\n• [color=%skill%]Buckler Bash[/color] will do [color=%positive%]8-15[/color] damage.\n\n• Both skills will also cost [color=%negative%]-25%[/color] less Fatigue and [color=%negative%]1[/color] less Action Point to use.\n";
        mode = "pattern"
        en = "\n'Knock them back!'\n\n[color=%passive%][u]Passive:[/u][/color]\n• The [color=%skill%]Knock Back[/color] skill now inflicts [color=%positive%]10-25[/color] Damage (50% effective against armor) and [color=%damage%]10[/color] Fatigue Damage.\n\n• Additionally damage will also scale by [color=%positive%]10%[/color] of your shield's maximum condition with a maximum bonus of 10.\n\n• [color=%skill%]Buckler Bash[/color] will do [color=%positive%]8-15[/color] damage.\n\n• Both skills will also cost [color=%negative%]-25%[/color] less Fatigue and [color=%negative%]1[/color] less Action Point to use.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.ShieldExpert
    {
        // ::Const.Strings.PerkDescription.ShieldExpert <- "\nLearn to better deflect hits to the side instead of blocking them head on.\n\n[color=%passive%][u]Passive:[/u][/color]\n• The shield defense bonus is increased by [color=%positive%]25%[/color].\n\n• This also applies to the additional defense bonus of [color=%skill%]Shieldwall[/color].\n\n• Shield damage received is reduced by [color=%negative%]-50%[/color] to a minimum of 1.\n\n• [color=%skill%]Knock Back[/color] gains [color=%positive%]+15%[/color] chance to hit.\n\n• Shield skills will also cost [color=%negative%]-25%[/color] less Fatigue.\n";
        mode = "pattern"
        en = "\nLearn to better deflect hits to the side instead of blocking them head on.\n\n[color=%passive%][u]Passive:[/u][/color]\n• The shield defense bonus is increased by [color=%positive%]25%[/color].\n\n• This also applies to the additional defense bonus of [color=%skill%]Shieldwall[/color].\n\n• Shield damage received is reduced by [color=%negative%]-50%[/color] to a minimum of 1.\n\n• [color=%skill%]Knock Back[/color] gains [color=%positive%]+15%[/color] chance to hit.\n\n• Shield skills will also cost [color=%negative%]-25%[/color] less Fatigue.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Overwhelm
    {
        // ::Const.Strings.PerkDescription.Overwhelm <- "\nLearn to take advantage of your high Initiative and prevent the enemy from attacking effectively by overwhelming them with your attacks!\n\n[color=%passive%][u]Passive:[/u][/color]\n• With every attack, hit or miss, against an opponent that acts after you in the current round, inflict the [color=%status%]Overwhelmed[/color] status effect.\n\n• Each stack of [color=%status%]Overwhelmed[/color] reduces both Melee Skill and Ranged Skill by [color=%negative%]5%[/color] for one turn.\n\n• The effect stacks with each attack, and can be applied to multiple targets at once with a single attack.\n";
        mode = "pattern"
        en = "\nLearn to take advantage of your high Initiative and prevent the enemy from attacking effectively by overwhelming them with your attacks!\n\n[color=%passive%][u]Passive:[/u][/color]\n• With every attack, hit or miss, against an opponent that acts after you in the current round, inflict the [color=%status%]Overwhelmed[/color] status effect.\n\n• Each stack of [color=%status%]Overwhelmed[/color] reduces both Melee Skill and Ranged Skill by [color=%negative%]5%[/color] for one turn.\n\n• The effect stacks with each attack, and can be applied to multiple targets at once with a single attack.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.ReachAdvantage
    {
        // ::Const.Strings.PerkDescription.ReachAdvantage <- "\nLearn to use the superior reach of large weapons to keep the enemy from getting close enough to land a good hit.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Each hit with a Two-Handed melee weapon adds a stack of [color=%status%]Reach Advantage[/color] which increases your Melee Defense by [color=%positive%]+5[/color], up to a maximum of 5 stacks, until this character's next turn.\n\n• A single attack hitting multiple targets can add several stacks at once.\n\n• If you put away your weapon, you lose all stacks.\n\n• Additionally, while wielding a staff, the defense malus due to being surrounded by opponents is reduced by [color=%negative%]3[/color]. If you have [color=%perk%]Underdog[/color] or [color=%perk%]Battleheart[/color], this perk will instead increase defenses by [color=%positive%]5[/color].\n";
        mode = "pattern"
        en = "\nLearn to use the superior reach of large weapons to keep the enemy from getting close enough to land a good hit.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Each hit with a Two-Handed melee weapon adds a stack of [color=%status%]Reach Advantage[/color] which increases your Melee Defense by [color=%positive%]+5[/color], up to a maximum of 5 stacks, until this character's next turn.\n\n• A single attack hitting multiple targets can add several stacks at once.\n\n• If you put away your weapon, you lose all stacks.\n\n• Additionally, while wielding a staff, the defense malus due to being surrounded by opponents is reduced by [color=%negative%]3[/color]. If you have [color=%perk%]Underdog[/color] or [color=%perk%]Battleheart[/color], this perk will instead increase defenses by [color=%positive%]5[/color].\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Backstabber
    {
        en = "\nHonor doesn't win you fights, stabbing the enemy where it hurts does.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increase damage to Hitpoints by [color=%positive%]5%[/color] and armor penetration by [color=%positive%]3%[/color] for each ally surrounding and distracting your target. Works with any weapon and skill.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.LoneWolf
    {
        en = "\nI work best alone.\n\n[color=%passive%][u]Passive:[/u][/color]\n• With no ally within two tiles, gain a [color=%positive%]15%[/color] bonus to Melee Skill, Ranged Skill, Melee Defense, Ranged Defense, and Resolve. Additionally AP cost of moving accross all terrain is reduced by [color=%positive%]1[/color]\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Recover
    {
        // ::Const.Strings.PerkDescription.Recover <- "\nTake a deep breath, rest for a turn.\n\n[color=%passive%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Recover[/color] skill which allows you to reduce accumulated Fatigue by [color=%negative%]8%[/color] of your maximum Fatigue per Action Point.\n";
        mode = "pattern"
        en = "\nTake a deep breath, rest for a turn.\n\n[color=%passive%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Recover[/color] skill which allows you to reduce accumulated Fatigue by [color=%negative%]8%[/color] of your maximum Fatigue per Action Point.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Underdog
    {
        en = "\nI'm used to it.\n\n[color=%passive%][u]Passive:[/u][/color]\n• The defense malus due to being surrounded by opponents is reduced by [color=%negative%]5[/color].\n\n• If an attacker has the [color=%perk%]Strength In Numbers[/color] perk, the effect of that perk is negated, and the normal defense malus due to being surrounded is applied instead.\n\n• Gain an additional stacking [color=%positive%]+5%[/color] chance to hit each time you dodge an attack.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Berserk
    {
        en = "\nRAAARGH!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Once per turn, upon killing an enemy [color=%positive%]4[/color] Action Points are immediately restored.\n\n• Characters cannot regain more than their maximum Action Points.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Bullseye
    {
        // ::Const.Strings.PerkDescription.Bullseye <- "\nNailed it!\n\n[color=%passive%][u]Passive:[/u][/color]\n• The penalty to hitchance when shooting at a target you have no clear line of fire to is reduced from [color=%negative%]75%[/color] to [color=%negative%]25%[/color] for any ranged weapons and [color=%skill%]Aimed Shot[/color] will not have a penalty at all.\n\n• This Character's Vision is increased by [color=%positive%]+1[/color].\n";
        mode = "pattern"
        en = "\nNailed it!\n\n[color=%passive%][u]Passive:[/u][/color]\n• The penalty to hitchance when shooting at a target you have no clear line of fire to is reduced from [color=%negative%]75%[/color] to [color=%negative%]25%[/color] for any ranged weapons and [color=%skill%]Aimed Shot[/color] will not have a penalty at all.\n\n• This Character's Vision is increased by [color=%positive%]+1[/color].\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Duelist
    {
        // ::Const.Strings.PerkDescription.Duelist <- "\nBecome one with your weapon and go for the weak spots!\n\n[color=%passive%][u]Passive:[/u][/color]\n• When holding a Buckler or Mummy Shield in your offhand an extra [color=%positive%]+25%[/color] of damage ignores armor on Melee Attacks.\n\n[color=%passive%][u]Active:[/u][/color] Unlocks the [color=%skill%]Flourish[/color] skill, which will increase fatigue cost by [color=%positive%]75%[/color], Action Point Cost [color=%positive%]1[/color] and as long as you are faster than your target grants a chance on each attack to ignore armor completely based on the initiative difference between you and your target. As long as you are faster than the target, any attack that inflicts at least [color=%positive%]1[/color] point of damage to Hitpoints triggers a morale check for the opponent with a penalty equal to [color=%negative%]20%[/color] of the Initiative difference between you and the target.\n";
        mode = "pattern"
        en = "\nBecome one with your weapon and go for the weak spots!\n\n[color=%passive%][u]Passive:[/u][/color]\n• When holding a Buckler or Mummy Shield in your offhand an extra [color=%positive%]+25%[/color] of damage ignores armor on Melee Attacks.\n\n[color=%passive%][u]Active:[/u][/color] Unlocks the [color=%skill%]Flourish[/color] skill, which will increase fatigue cost by [color=%positive%]75%[/color], Action Point Cost [color=%positive%]1[/color] and as long as you are faster than your target grants a chance on each attack to ignore armor completely based on the initiative difference between you and your target. As long as you are faster than the target, any attack that inflicts at least [color=%positive%]1[/color] point of damage to Hitpoints triggers a morale check for the opponent with a penalty equal to [color=%negative%]20%[/color] of the Initiative difference between you and the target.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.CripplingStrikes
    {
        // ::Const.Strings.PerkDescription.CripplingStrikes <- "\nCripple your enemies!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Lowers the threshold to inflict [color=%status%]Injuries[/color] by [color=%negative%]33%[/color] for both melee and ranged attacks.\n\n• Undead cannot be injured, but you gain [color=%positive%]+10%[/color] damage against them.\n";
        mode = "pattern"
        en = "\nCripple your enemies!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Lowers the threshold to inflict [color=%status%]Injuries[/color] by [color=%negative%]33%[/color] for both melee and ranged attacks.\n\n• Undead cannot be injured, but you gain [color=%positive%]+10%[/color] damage against them.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.QuickHands
    {
        en = "\nLooking for this?\n\n[color=%passive%][u]Passive:[/u][/color]\n• Swapping an item in battle becomes a free action with no Action Point cost once per turn.\n\n• Does not work with shields.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.CoupDeGrace
    {
        // ::Const.Strings.PerkDescription.CoupDeGrace <- "\nLike a beast of prey, you hunt the weak.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Inflict an additional [color=%positive%]20%[/color] damage against targets that are [color=%status%]Debilitated[/color], [color=%status%]Knocked Over[/color] or have sustained any injury effects, like a broken arm.\n\n• Also grants [color=%positive%]+10%[/color] damage against targets who suffer from any of the following effects: [color=%status%]Baffled[/color], [color=%status%]Dazed[/color], [color=%status%]Distracted[/color], [color=%status%]Grappled[/color], [color=%status%]Netted[/color], [color=%status%]Rooted[/color], [color=%status%]Shellshocked[/color], [color=%status%]Sleeping[/color], [color=%status%]Staggered[/color], [color=%status%]Stunned[/color], [color=%status%]Vulnerable[/color], [color=%status%]Webbed[/color], or [color=%status%]Withered[/color].\n";
        mode = "pattern"
        en = "\nLike a beast of prey, you hunt the weak.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Inflict an additional [color=%positive%]20%[/color] damage against targets that are [color=%status%]Debilitated[/color], [color=%status%]Knocked Over[/color] or have sustained any injury effects, like a broken arm.\n\n• Also grants [color=%positive%]+10%[/color] damage against targets who suffer from any of the following effects: [color=%status%]Baffled[/color], [color=%status%]Dazed[/color], [color=%status%]Distracted[/color], [color=%status%]Grappled[/color], [color=%status%]Netted[/color], [color=%status%]Rooted[/color], [color=%status%]Shellshocked[/color], [color=%status%]Sleeping[/color], [color=%status%]Staggered[/color], [color=%status%]Stunned[/color], [color=%status%]Vulnerable[/color], [color=%status%]Webbed[/color], or [color=%status%]Withered[/color].\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.SteelBrow
    {
        // ::Const.Strings.PerkDescription.SteelBrow <- "\nMother always said you had a hard head.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Regular hits to the head no longer cause critical damage and their damage will be reduced to normal, significantly lowering the risk of recieving debilitating head [color=%status%]Injuries[/color].\n\n• Any effects or traits that adds to the damage done to head multiplier will be reduced to [color=%negative%]2/3[/color] of the original value.\n\n• Any attacks that would [color=%status%]Stun[/color] you now [color=%status%]Daze[/color] you.\n";
        mode = "pattern"
        en = "\nMother always said you had a hard head.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Regular hits to the head no longer cause critical damage and their damage will be reduced to normal, significantly lowering the risk of recieving debilitating head [color=%status%]Injuries[/color].\n\n• Any effects or traits that adds to the damage done to head multiplier will be reduced to [color=%negative%]2/3[/color] of the original value.\n\n• Any attacks that would [color=%status%]Stun[/color] you now [color=%status%]Daze[/color] you.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Anticipation
    {
        en = "\nBy watching your opponent's aim, you have more time to react.\n\n[color=%passive%][u]Passive:[/u][/color]\n• When being attacked with ranged weapons, gain [color=%positive%]1 + 10% [/color] of your base Ranged Defense as additional Ranged Defense per tile that the attacker is away.\n\n• Always gain at least [color=%positive%]+10[/color] to Ranged Defense when attacked from range.\n\n• If you're armed with a ranged weapon and a ranged attack misses you, gain a chance to fire back at your attacker. The chance is based on Ranged Defense.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.HoldOut
    {
        // ::Const.Strings.PerkDescription.HoldOut <- "\nKeep it together!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants [color=%positive%]+8[/color] Hitpoints.\n\n• Any negative status effect with a finite duration (e.g., [color=%status%]Bleeding[/color], [color=%status%]Charmed[/color]) has its duration reduced to one turn.\n\n• Status effects that have their effects grow weaker over several turns (e.g., Goblin [color=%status%]Poison[/color]) are at their weakest state from the start.\n\n• Raises the chance to survive being struck down and not killed from [color=%negative%]33%[/color] to [color=%positive%]66%[/color].\n";
        mode = "pattern"
        en = "\nKeep it together!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants [color=%positive%]+8[/color] Hitpoints.\n\n• Any negative status effect with a finite duration (e.g., [color=%status%]Bleeding[/color], [color=%status%]Charmed[/color]) has its duration reduced to one turn.\n\n• Status effects that have their effects grow weaker over several turns (e.g., Goblin [color=%status%]Poison[/color]) are at their weakest state from the start.\n\n• Raises the chance to survive being struck down and not killed from [color=%negative%]33%[/color] to [color=%positive%]66%[/color].\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.BattleForged
    {
        en = "\nSpecialize in heavy armor!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Armor damage taken is reduced by a percentage equal to 5% of the current total armor value of both body and head armor.\n\n• The heavier your armor and helmet the more you benefit. Damage taken cannot be reduced below 20% of the total value.\n\n• Does not affect damage from mental attacks or status effects.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Relentless
    {
        // ::Const.Strings.PerkDescription.Relentless <- "\nDon't slow down!\n\n[color=%passive%][u]Passive:[/u][/color]\n• At all times your Initiative is reduced only by [color=%negative%]50%[/color] of your accumulated Fatigue, instead of all of it.\n\n• Using the [color=%skill%]Wait[/color] command will no longer give you a penalty to Initiative in the next round.\n\n• If you also have [color=%perk%]Nimble[/color], damage done to armor is reduced by [color=%negative%]33%[/color] of your Nimble damage reduction.\n\n• The threshold to sustain injuries on getting hit is increased by [color=%positive%]25%[/color].\n";
        mode = "pattern"
        en = "\nDon't slow down!\n\n[color=%passive%][u]Passive:[/u][/color]\n• At all times your Initiative is reduced only by [color=%negative%]50%[/color] of your accumulated Fatigue, instead of all of it.\n\n• Using the [color=%skill%]Wait[/color] command will no longer give you a penalty to Initiative in the next round.\n\n• If you also have [color=%perk%]Nimble[/color], damage done to armor is reduced by [color=%negative%]33%[/color] of your Nimble damage reduction.\n\n• The threshold to sustain injuries on getting hit is increased by [color=%positive%]25%[/color].\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Rotation
    {
        // ::Const.Strings.PerkDescription.Rotation <- "\nJust like dancing with your nan when you were young.\n\n[color=%passive%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Rotation[/color] skill which allows two characters to switch places while ignoring Zone of Control, as long as neither character is [color=%status%]Stunned[/color], [color=%status%]Rooted[/color] or otherwise disabled.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]25[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nJust like dancing with your nan when you were young.\n\n[color=%passive%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Rotation[/color] skill which allows two characters to switch places while ignoring Zone of Control, as long as neither character is [color=%status%]Stunned[/color], [color=%status%]Rooted[/color] or otherwise disabled.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]25[/color] Fatigue.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Footwork
    {
        // ::Const.Strings.PerkDescription.Footwork <- "\nYou've learned how to escape from sticky situations.\n\n[color=%passive%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Footwork[/color] skill which allows you to leave a Zone of Control without triggering free attacks.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]20[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nYou've learned how to escape from sticky situations.\n\n[color=%passive%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Footwork[/color] skill which allows you to leave a Zone of Control without triggering free attacks.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Indomitable
    {
        // ::Const.Strings.PerkDescription.Indomitable <- "\nIn the face of insurmountable odds, you stand firm.\n\n[color=%passive%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Indomitable[/color] skill which grants a [color=%negative%]50%[/color] damage reduction and immunity to being [color=%status%]Stunned[/color], [color=%status%]Knocked Back[/color], [color=%status%]Grabbed[/color] or [color=%status%]Swallowed[/color] for one turn.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]25[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nIn the face of insurmountable odds, you stand firm.\n\n[color=%passive%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Indomitable[/color] skill which grants a [color=%negative%]50%[/color] damage reduction and immunity to being [color=%status%]Stunned[/color], [color=%status%]Knocked Back[/color], [color=%status%]Grabbed[/color] or [color=%status%]Swallowed[/color] for one turn.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]25[/color] Fatigue.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.RallyTheTroops
    {
        // ::Const.Strings.PerkDescription.RallyTheTroops <- "\n'Get back in there or I'll kill you myself!'\n\n[color=%passive%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Rally[/color] skill which triggers a morale check that attempts to raise morale to [color=%status%]Steady[/color] for all allies within four tiles.\n\n• The higher the Resolve of the character using the skill, the higher the chance to succeed with a bonus modifier of [color=%positive%]40%[/color] of your current Resolve.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]25[/color] Fatigue.\n";
        mode = "pattern"
        en = "\n'Get back in there or I'll kill you myself!'\n\n[color=%passive%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Rally[/color] skill which triggers a morale check that attempts to raise morale to [color=%status%]Steady[/color] for all allies within four tiles.\n\n• The higher the Resolve of the character using the skill, the higher the chance to succeed with a bonus modifier of [color=%positive%]40%[/color] of your current Resolve.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]25[/color] Fatigue.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Adrenaline
    {
        // ::Const.Strings.PerkDescription.Adrenaline <- "\nSeize the Initiative!\n\n[color=%passive%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Adrenaline[/color] skill which puts you first in the turn order for the next round, allowing you another turn before your enemies.\n\n• Costs [color=%negative%]1[/color] AP and [color=%negative%]20[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nSeize the Initiative!\n\n[color=%passive%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Adrenaline[/color] skill which puts you first in the turn order for the next round, allowing you another turn before your enemies.\n\n• Costs [color=%negative%]1[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.Fearsome
    {
        en = "\nMake them scatter and flee!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Any attack that inflicts at least [color=%positive%]1[/color] point of damage to Hitpoints triggers a morale check for the opponent with a penalty equal to [color=%negative%]20%[/color] of your current Resolve.\n\n[color=%negative%]Does not trigger multiple times from the same attacker on the same target in one attack.[/color]\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.HeadHunter
    {
        en = "\nGo for the head!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Hitting the head of a target will give you a guaranteed hit to the head with your next attack.\n\n• Connecting your hit resets the effect, but every % head hit chance above 50 gives a chance for the effect to not be consumed.\n"
        es = ""
    }
    // context: ::Const.Strings.PerkDescription.FastAdaption
    {
        en = "\nAdapt to your opponent's moves!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain an additional stacking [color=%positive%]+10%[/color] chance to hit with each attack that misses an opponent.\n\n• Upon landing a hit, the character will also recover 1 Action Point for every stack up to a maximum of 3 and the bonus will be reset. The refund cannot exceed the maximum Action Points.\n"
        es = ""
    }
    // FILE: mod_legends\hooks\config\rumors.nut
    // context: ::Const.Strings.PayTavernRoundIntro
    {
        en = "The company cheer your name as they drink."
        es = ""
    }
    // context: ::Const.Strings.PayTavernRoundIntro
    {
        en = "The company drink to fallen comrades."
        es = ""
    }
    // context: ::Const.Strings.PayTavernRoundIntro
    {
        en = "The company cheer the company name as they drink."
        es = ""
    }
    // context: ::Const.Strings.PayTavernRoundIntro
    {
        en = "The company drink to love and lust."
        es = ""
    }
    // context: ::Const.Strings.PayTavernRoundIntro
    {
        en = "The company cheer the good days to come"
        es = ""
    }
    // context: ::Const.Strings.PayTavernRoundIntro
    {
        en = "The company drink to the loyal wardogs."
        es = ""
    }
    // context: ::Const.Strings.PayTavernRoundIntro
    {
        en = "Laughter and light-hearted stories fills the tavern as your company drink."
        es = ""
    }
    // context: ::Const.Strings.PayTavernRoundIntro
    {
        en = "Hard mercenary life takes a rest as the company share stories of their past lives and enjoy themselves."
        es = ""
    }
    // context: ::Const.Strings.PayTavernRoundIntro
    {
        en = "'Huzzah to the commander!', the company shout."
        es = ""
    }
    // context: ::Const.Strings.PayTavernRoundIntro
    {
        en = "Your company boast with their accomplishments as they drink."
        es = ""
    }
    // en = "The strong drinks blur the horrors of combat for a while."
    // en base_es
    // context: ::Const.Strings.PayTavernRoundIntro
    {
        en = "Your company cheer and toast to riches and a long life."
        es = ""
    }
    // en = "The beer makes the hardships of the day disappear."
    // en base_es
    // en = "The patrons shout your name as they clink their cups. The drink loosens their tongues."
    // en base_es
    // en = "The patrons nod approvingly."
    // en base_es
    // en = "People raise their mugs in appreciation."
    // en base_es
    // en = "The people murmur approvingly."
    // en base_es
    // en = "The innkeeper rings a bell to let everyone know the next round is on you."
    // en base_es
    // en = "There's a place called %location% %terrain% to the %direction% of here. Most people know about it, I think, but few would venture there."
    // en base_es
    // en = "%randomname% told me 'bout %location% the other day. Full of treasure he said, %distance% %direction% of here. Or maybe I'm remembering it wrong."
    // en base_es
    // en = "If it's adventure you seek, there's a place called %location% %terrain% %direction% of here. Don't know who lives there nowadays, though."
    // en base_es
    // en = "Heard of %location%? People say it's haunted, the dead walking and all. Somewhere %direction% of here. Maybe someone else in %townname% can tell you more..."
    // en base_es
    // en = "You know of... gosh, what was it called again? To the %direction% %distance% from here, %terrain%. Can't for the life of me remember what we used to call it..."
    // en base_es
    // en = "Came across %location% on your way here? Why, it's %terrain% to the %direction%. Someone should hire you to burn that thing to the ground. Nothing good's coming from there, that's for sure."
    // en base_es
    // en = "We spotted something on our way here, hidden way off the road, %terrain% %distance% %direction% of %townname%. Don't know what the locals call it, or if they even know about it, but it might be worth it going back there."
    // en base_es
    // context: ::Const.Strings.RumorsContract
    {
        // "I\'ve heard the council of %settlement% is looking to hire mercenaries %direction_settlement% of here. Don\'t know what for.",
        mode = "pattern"
        en = "I've heard the council of %settlement% is looking to hire mercenaries %direction_settlement% of here. Don't know what for."
        es = ""
    }
    // context: ::Const.Strings.RumorsContract
    {
        // "A group of young lads left %direction_settlement% for %settlement% some days ago. They\'re looking to hire armed fighters over there, willing to pay real good. I just hope they make it back alive.",
        mode = "pattern"
        en = "A group of young lads left %direction_settlement% for %settlement% some days ago. They're looking to hire armed fighters over there, willing to pay real good. I just hope they make it back alive."
        es = ""
    }
    // context: ::Const.Strings.RumorsContract
    {
        // "If you lot is looking for work, I\'ve heard that they\'re hiring sellswords over at %settlement% to the %direction_settlement%.",
        mode = "pattern"
        en = "If you lot is looking for work, I've heard that they're hiring sellswords over at %settlement% to the %direction_settlement%."
        es = ""
    }
    // context: ::Const.Strings.RumorsContract
    {
        // "You heard that they\'re looking to hire fighting folk at %settlement%? its %direction_settlement% from here",
        mode = "pattern"
        en = "You heard that they're looking to hire fighting folk at %settlement%? its %direction_settlement% from here"
        es = ""
    }
    // context: ::Const.Strings.RumorsContract
    {
        // "Some guy from %settlement% was here just the other day, wanted to hire strong lads for some problem they have over there. Don\'t think many went %direction_settlement% with him, though.",
        mode = "pattern"
        en = "Some guy from %settlement% was here just the other day, wanted to hire strong lads for some problem they have over there. Don't think many went %direction_settlement% with him, though."
        es = ""
    }
    // context: ::Const.Strings.RumorsContract
    {
        // "Mercenaries, eh? We got a few of those these days. Just some days ago a bunch that called themselves %randommercenarycompany% travelled through. On their way %direction_settlement%  to %settlement%, they said, good coin to be made there.",
        mode = "pattern"
        en = "Mercenaries, eh? We got a few of those these days. Just some days ago a bunch that called themselves %randommercenarycompany% travelled through. On their way %direction_settlement%  to %settlement%, they said, good coin to be made there."
        es = ""
    }
    // context: ::Const.Strings.RumorsContract
    {
        // "If it\'s work you\'re looking for, they\'re taking crowns in to the %direction_settlement% over at %settlement% to hire strong men.",
        mode = "pattern"
        en = "If it's work you're looking for, they're taking crowns in to the %direction_settlement% over at %settlement% to hire strong men."
        es = ""
    }
    // context: ::Const.Strings.RumorsContract
    {
        // "Heard that some fancy fat merchant or so from %settlement% is looking to hire armed guards the other day. Well, I ain\'t going %direction_settlement% to die to there for him, no thanks. Have me house and wife right here."
        mode = "pattern"
        en = "Heard that some fancy fat merchant or so from %settlement% is looking to hire armed guards the other day. Well, I ain't going %direction_settlement% to die to there for him, no thanks. Have me house and wife right here."
        es = ""
    }
    // en = "If you're looking to fetch a good price for your trading goods, my friend, you should go to one of the large cities or castles and not some run-down poor village at world's ass."
    // en base_es
    // en = "The drinks over in %randomtown% are way better than the cat piss they serve here!"
    // en base_es
    // en = "A trader came by this morning, claims he saw dead people shuffling through the hills nearby. Won't buy that humbug, that's for sure!"
    // en base_es
    // en = "There is many a place out there, long lost and forgotten, that holds great riches."
    // en base_es
    // en = "If you're ever visiting the tavern in %randomtown% make sure to try their roasted goat - you'll never eat that good elsewhere!"
    // en base_es
    // en = "Mercenaries aren't very popular around these parts. They kill, plunder and pillage like common brigands, so don't expect to be greeted with cheers and flowers."
    // en base_es
    // en = "If you're in need of supplies, head over to old %randomname% on the market here in %townname%. Tell him I send you!"
    // en base_es
    // en = "Tomorrow night the famous minstrel %randomname% \x7bthe Songbird | the Bard | the Storyteller | the Nightingale | the Poet\x7d is coming to this very tavern, you better not miss it!"
    // en base_es
    // en = "Don't trust the barber's potions! A friend of my cousin's friend's uncle drank one and it turned him into a toad, I swear!"
    // en base_es
    // en = "So I heard of a free company by the name of %randommercenarycompany% and it's said they collect the ears of their enemies and wear them 'round their necks!"
    // en base_es
    // en = "Don't drink the water in %randomtown%, let me tell you. It'll give you the runs in no time!"
    // en base_es
    // en = "My cousin %randomname% left town with a mercenary company like yours, %randommercenarycompany% or something like that it was called. Haven't heard from him since..."
    // en base_es
    // en = "From one sellsword to another: If you value your reputation as a mercenary, you'd better not double-cross your employers. Some will go to great lengths to hunt you down, tell ill of you and make you pay."
    // en base_es
    // en = "The noble houses act like an old couple; constant quarreling and wrangling. And who suffers most from those feuds? Not the high lords up in their castle towers, no, it's us simple folk, of course!"
    // en base_es
    // en = "I'd stay clear of swamps and marshes. There's ghastly diseases there just waiting to latch onto you."
    // en base_es
    // en = "I've heard they have a mage on the council of %randomtown%, a real wizard. Not sure if I believe that."
    // en base_es
    // en = "I love women! The way they look, the way they talk. Don't know what I'd do in a world without 'em..."
    // en base_es
    // en = "It's you and the %companyname%! Remember me from %randomtown%? We talked about... well, I don't really remember, but here we are! Let's drink! How have you been faring?"
    // en base_es
    // en = "Death is a part of life. The sooner you accept it, the more you can cherish your stay in this world."
    // en base_es
    // en = "One of my teeth fell out just the other day, see? I think the others are so loose, they're about to follow. Can you feel it? Go on, touch. They're loose, right?"
    // en base_es
    // en = "Gods, I need to take a piss. Will you watch that beer for me?"
    // en base_es
    // context: ::Const.Strings.RumorsGeneral
    {
        en = "You just missed a real show, older fella' with a boy in tow came in here and started tryin' to sell him to me — the boy that is, the older guy weren't sellin' himself, if you get my meanin'..."
        es = ""
    }
    // context: ::Const.Strings.RumorsGeneral
    {
        en = "You heard about them sellswords goin' south? Somthin' 'bout a book. Strange fella he was. Stranger ear too..."
        es = ""
    }
    // context: ::Const.Strings.RumorsGeneral
    {
        en = "I'd be mindful of all them sellswords about — they say they'd turn on anyone for the right price."
        es = ""
    }
    // en = "Always be sceptical towards the nobility, my friend. You never know what their real agenda might be."
    // en base_es
    // context: ::Const.Strings.RumorsCivilian
    {
        en = "You smell that? No? That must mean — oh no..."
        es = ""
    }
    // context: ::Const.Strings.RumorsCivilian
    {
        en = "You seen a weird fella about? Five foot tall, jar of leeches? No? Alright nevermind then..."
        es = ""
    }
    // context: ::Const.Strings.RumorsCivilian
    {
        en = "These Dakkul folks are gettin' more common by the day — one was pickin' carrots outta my field and when I yelled at 'im he just...stared."
        es = ""
    }
    // context: ::Const.Strings.RumorsCivilian
    {
        en = "You seen those brutes with the sacks on their 'eds? Nah? Well if you do i'd be mindful of how close you get to 'em — these ones weren't like the rest, 'ollow they told me... or somthin'"
        es = ""
    }
    // context: ::Const.Strings.RumorsCivilian
    {
        en = "Bumped into a real character yesterday — fella with a sack on his head. Asked him about his occupation, he said he was stairs or somthin'. I said I got one back 'ome and I didn't need another one. Why would a fella need another staircase in his 'ome? Odd sort these sackfolk..."
        es = ""
    }
    // en = "Ever considered putting down your sword and settling down? Mercenaries tend to have rather short lives."
    // en base_es
    // context: ::Const.Strings.RumorsCivilian
    {
        en = "Lost my sister last season to a sellsword band — took 'er in and then gave her a spear and some rags for protection. Put 'er right in the front line they did. Bastards."
        es = ""
    }
    // en = "They found the farm of old %randomname% burned to the ground the other day. That whole family was hanging from a nearby oak..."
    // en base_es
    // en = "Since some brigands burned down my old man's farm I switched the pitchfork for the beer mug. I hope they get what they deserve some day."
    // en base_es
    // context: ::Const.Strings.RumorsCivilian
    {
        en = "Got hired by a mercenary company lookin' for fighters. I was pretty good at it too! Ran up a king's ransom in wages until I lost me 'and to a greenskin... I'll let you touch the stump for 5 crowns..."
        es = ""
    }
    // en = "Our militia is in a pitiful state, rusty pikes and worm-eaten shields everywhere. I wish the council would take crowns in hand and buy the poor sods some real weapons."
    // en base_es
    // en = "We don't need sellswords like you here! You're nothing but trouble. Our militia can take care of us. Always has, always will."
    // en base_es
    // en = "The miller's daughter went missing last night. They found her and she is well, but she's not willing to talk about it."
    // en base_es
    // en = "Farkin' %randomname% and his farkin' dog. Rug of flea's barking day and night, rain or sunshine. Can't take it much longer, I really can't..."
    // en base_es
    // en = "I heard some tombstones in the old graveyard have been toppled over. But no one in their right mind would go there anyways."
    // en base_es
    // en = "Bought me this scramasax the other day from a travelling merchant. Real bargain, he said. A man's got to protect himself and his family, see."
    // en base_es
    // en = "I don't trust the militia here. One time, as a band of outlaws approached, they turned tail and ran for the hills without giving any fight!"
    // en base_es
    // en = "We had a murder here. Some bastard from %randomtown% put a knife into the back of one of the merchants. He'll see the noose on Sunday, you should come watch!"
    // en base_es
    // en = "They burned %randomfemalename% at the stake last week, some witchhunter did. Just appeared one day, accused her of sorcery and whatnot and had her burned. The council didn't object and that man just left soon after. Wish I knew who he was, really. Good thing he saved us from that witch, I suppose..."
    // en base_es
    // en = "Ever fought an orc? It's said they're twice as tall and thrice as strong as a man, and that they can split us clean in half with a single strike!"
    // en base_es
    // en = "Picking up desperate farmers and fishers for your company is all good and well, but you should look for recruits in a castle like this one. Here you'll find people who actually know which end of the sword goes where."
    // en base_es
    // en = "A sturdy shield is a real life-saver, let me tell you. Wouldn't have a man fight without one."
    // en base_es
    // en = "The garrison commander fought in the Battle of Many Names. Claims large orcs just shrug off hits to the head with a waraxe, he does. Don't know what to make of this."
    // en base_es
    // en = "There're things out there way more scary than some group of brigands. You'll see what I mean soon enough if you head out beyond the borderlands."
    // en base_es
    // en = "I always rely on my axe to smash the enemy's shield. Even the tallest man will fall quickly once he can not defend himself any more."
    // en base_es
    // en = "If I learned one thing during my soldiering years, it's that the high ground wins battles. Trust me on this one."
    // en base_es
    // context: ::Const.Strings.RumorsMilitary
    {
        en = "I once was a mercenary like you — but then I took an arrow to the knee."
        es = ""
    }
    // context: ::Const.Strings.RumorsMilitary
    {
        en = "Have you heard? There's an 'edge knight runnin' about the place lookin' for squires and the sort. Might consider tryin' out myself, if I was feelin' suicidal..."
        es = ""
    }
    // en = "I've seen %randomnoble% at a tourney recently. Damn, what a sight, that man. The way he jousts, I mean. Took the prize and all the ladies loved him."
    // en base_es
    // en = "I'm old now, but I still remember my first battle. Pissed my pants even before the first arrow flew. Ha!"
    // en base_es
    // en = "Been to %randomtown% not long ago and they told me about wolves as large as a man, with teeth as long as the fingers on my hand. Really don't want to meet one of those."
    // en base_es
    // en = "You know that orcs make their armor out of what they strip from those who fall against them? Honest, I'm not making this up. They wear it as trophies or something. If you ever meet one of them large orcs, you'll see. They look like it's a knight or two wrapped around them."
    // en base_es
    // en = "1st %townname% Company. Best lot of halfwits and scallywags I've ever served with. Wouldn't trade 'em for the world."
    // en base_es
    // en = "I miss my wife and my two daughters. Been stationed at %townname% for too long already, but a man's got to put food on the table somehow."
    // en base_es
    // en = "We'll head out again soon to patrol the roads. Sometimes I feel everything would go down the shitter if it weren't for us keeping order 'round here."
    // en base_es
    // en = "Farkin' patrol duty. Barely got back 'ere, blisters on me feet still from all the marchin' and we're about to 'ead out again. Just put us on 'orses, I say!"
    // en base_es
    // en = "Got wounded bad some months back in a skirmish 'gainst goblins. Couldn't feel me legs anymore, but the lads carried me all the way back to %townname%. Gods bless 'em."
    // en base_es
    // en = "You'll know greenskin territory from the idols they erect out of skulls and bones. Of human skulls and bones."
    // en base_es
    // en = "Fourteen. That's how many men I've killed. Women I count extra, three so far. What about you?"
    // en base_es
    // context: ::Const.Strings.RumorsMilitary
    {
        en = "Seen them knights wanderin' around? They look like they're the shit but trust me — you put a dagger inbetween those plates and they die just like any other man..."
        es = ""
    }
    // context: ::Const.Strings.RumorsMilitary
    {
        en = "You seen those ponces waving their swords around in their fancy 'ats? They aren't too smart when you put an arrow between their ribs!"
        es = ""
    }
    // context: ::Const.Strings.RumorsMilitary
    {
        en = "Knew a Hedge Knight who got hired by a sellsword company a few days back — he was in here puffin' his chest and talkin' about how much gold he'd make. Then as soon as he joined up they took all his gear and gave him the boot. Maybe the old gods are alive after all!"
        es = ""
    }
    // en = "I usually stand guard on the gate tower. To be honest, spitting down on some travellers is the only fun I get all day."
    // en base_es
    // en = "The mood amongst the garrison is pretty bad. They say that pay's been delayed a few times already and everyone's starting to lose patience."
    // en base_es
    // en = "When I was moved to %townname% I never imagined life here to be so dull and hard. But still better than working the fields until your back snaps, I suppose..."
    // en base_es
    // en = "I prefer fighting with my flail. Hard to defend against and it don't matter if they carry a shield, I'll just swing around it and make pulp of their head!"
    // en base_es
    // en = "Damn nigh impossible to find a reliable shield 'round here, bloody things keep breaking in two. Been keeping a spare on me back now just incase. I should charge more for fighting men with axes, ha!"
    // en base_es
    // en = "One day I'll be standard bearer of the company. It's only the bravest of us all and they've been with the company for years and years, y'know, but it's the greatest honor for a man with common blood. I've seen even a knight once shake the hand of ours."
    // en base_es
    // context: ::Const.Strings.RumorsMilitary
    {
        en = "I've trained militia before, and let me tell you, spears are the best weapons for when the soldiers don't know what they're doing yet. Cheap and easy to hit with. Put a few folk together for a spearwall and it's hard to even get close to them without a spear in your belly."
        es = ""
    }
    // context: ::Const.Strings.RumorsMilitary
    {
        en = "Ever fought goblins? Nastly little buggers, don't be fooled by their size. I'd take large kite shields to protect the fighters from their arrows. And a pack of wardogs to run them down as they scatter, if you can afford it."
        es = ""
    }
    // en = "The other day my pickaxe broke while I was hammering away. Piece of it clipped my cheek. Not much and I'd be missing an eye!"
    // en base_es
    // context: ::Const.Strings.RumorsMiningSettlement
    {
        en = "The mines are a real deathtrap, we're losing folk every week. Even venturing with you might be better for longevity, ha!"
        es = ""
    }
    // en = "Working the mines has its merits, too, you know. We never get wet from the rain, it's just the dust that kills you eventually."
    // en base_es
    // context: ::Const.Strings.RumorsMiningSettlement
    {
        en = "Hit a rock with my pick once — before you laugh it started movin' on its own, damn almost killed me!"
        es = ""
    }
    // en = "In the other mine shaft, %randomname% found a nugget the size of me fist! The overseer got to him before he could hide it, though."
    // en base_es
    // en = "Even with the bad harvest this year the landlord won't give us a rest! The high folks got to have their feasts, you know..."
    // en base_es
    // context: ::Const.Strings.RumorsFarmingSettlement
    {
        en = "If a lordling every gives you trouble, see how smart he is on the other end of yer pitchfork!"
        es = ""
    }
    // context: ::Const.Strings.RumorsFarmingSettlement
    {
        en = "You seen those beasts eatin' corpses? If its grey, you stay — if it's pick you better run as far and fast as you can. Town guard won't help so don't bother 'em."
        es = ""
    }
    // en = "If you're looking to stack up on food and supplies head over to the market and look for %randomname%. He has the best quality and the lowest prices!"
    // en base_es
    // en = "I've been a farmhand all my life and sometimes I wish I'd taken the chance to venture with a company like yours... well, it's too late for that now."
    // en base_es
    // en = "There's lots of young and naive lads out there looking for adventure. I hope you take good care of them and return them safely to their families one day."
    // en base_es
    // en = "The sea is a fickle mistress. One moment it is as calm as a mirror and the next you find yourself in a tempest fighting for your life."
    // en base_es
    // context: ::Const.Strings.RumorsFishingSettlement
    {
        en = "Nobody knows what lives in the deep black waters, but you hear the old fishers talk about giant fish larger than any ship, tentacles that crush boats like they were nutshells, and evil, dead eyes under the surface."
        es = ""
    }
    // context: ::Const.Strings.RumorsFishingSettlement
    {
        en = "Some of the old fishers will tell you that those lost at sea are cursed to walk the seabed, only to be released if they drag others down to take their place. Priest says it ain't true, but I don't know. What are the elders telling it for, then?"
        es = ""
    }
    // en = "The biggest fish of my catch I always place in front of %randomfemalename%'s door to woo her. Some day I'm going to reveal myself as her secret admirer and ask for her hand!"
    // en base_es
    // en = "I've been a lumberjack all my life, just like my father before me. But the young folk these days are all 'bout adventure and seeing the lands, you may well find some hanging 'round the market that'll have no qualms 'bout coming with you on the road."
    // en base_es
    // en = "There are things in the forest... in the deep, dark parts, there are things. Nobody dares speak of them but trust me, those are no animals..."
    // en base_es
    // en = "Say, you interested in woodcarvings? The works of %randomname% are true pieces of art and made our town known throughout the realm!"
    // en base_es
    // en = "Hiring a man of the woods could be a good idea for a mercenary like you, I'd say. They ought to know how to fling around those large axes!"
    // en base_es
    // context: ::Const.Strings.RumorsForestSettlement
    {
        en = "Saw a wolf pup not much larger than a child today, could've sworn it had white fur..."
        es = ""
    }
    // context: ::Const.Strings.RumorsForestSettlement
    {
        en = "If you see one of them livin' trees — smack it with an axe. If the wound closes as fast as you made it, run."
        es = ""
    }
    // context: ::Const.Strings.RumorsForestSettlement
    {
        en = "Lots of witchlings around here lately. Some say they are all flockin' to some kind of ancient crone... worrying thought that."
        es = ""
    }
    // en = "I've been hearing folk tell of eyes watching them from the forest's edge. Seems to be some vile creatures making their nests in these here woods. Perhaps they're sizing up their prey before striking."
    // en base_es
    // en = "Long as I can remember the woods around here have been full of wildlife. Deer, boar, wolves and bear roam them in great number. Because of this it's been tradition for families to teach the art of archery at childhood. Try to outmatch any of our lads with a bow and you're sure to be disgraced."
    // en base_es
    // en = "You may think our land is barren and scant but once you live here you will learn to love it like no other!"
    // en base_es
    // context: ::Const.Strings.RumorsTundraSettlement
    {
        en = "Saw a woman built like an Ox last season — got into the fight with a few handsy watchmen and ended up turning this whole place upside down. Legendary it was!"
        es = ""
    }
    // context: ::Const.Strings.RumorsTundraSettlement
    {
        en = "If you're up in the mountains and see one of the rocks move, just run, stranger. It ain't worth your life to gawk at."
        es = ""
    }
    // en = "The clans and families in these parts are still strong and define who we are. Those nancy southern folks will never understand how things work here in the north."
    // en base_es
    // en = "If you're looking to make a quick coin with some trades look around for furs. The ones from around here are the best far and wide."
    // en base_es
    // context: ::Const.Strings.RumorsTundraSettlement
    {
        en = "You came to the right place if you're looking for able bodies to bolster your company. Us northern folk are strong, rugged and honest!"
        es = ""
    }
    // en = "The best remedy against biting winds and freezing cold can be found right here: Beer and mead!"
    // en base_es
    // context: ::Const.Strings.RumorsSnowSettlement
    {
        en = "Knew a madman who lived out here. Said somthing about a cave and disappeared..."
        es = ""
    }
    // context: ::Const.Strings.RumorsSnowSettlement
    {
        en = "You seen that weird woman around? The one with that staff who keeps talkin' about stones? What is the world comin' to, eh?"
        es = ""
    }
    // context: ::Const.Strings.RumorsSnowSettlement
    {
        en = "'erd of a spot of trouble around here — whole family butchered by gods know what. Only one survivor I hear. We'll see how long that one lasts."
        es = ""
    }
    // en = "A fortnight ago %randomname% went missing on the way home from the tavern. Found him frozen rock solid the next morning. Could have sold him to some fancy noble as a statue, haha!"
    // en base_es
    // en = "There are tales of figures shifting in snowstorms and unearthly howls that mix with the winds... but I wouldn't want to unsettle you with the common folk's farytales."
    // en base_es
    // en = "I've been told that a long time ago this land was all green with many proud castles and awe-inspiring towers. Most of them have crumbled to ruins by now and are covered with snow. But they'll have to be out there somewhere..."
    // en base_es
    // en = "Four winters. Four winters since I saw a chance for quick coin and raided a roadside chapel. Put the iron to a holy man that tried to hold me back; now no amount of crowns can repay the debt that my spirit owes."
    // en base_es
    // context: ::Const.Strings.RumorsSteppeSettlement
    {
        en = "You folks must be sweating like pigs under all that armor. Maybe you should travel when the moon is out?"
        es = ""
    }
    // en = "Let me tell you, the southern wine is the best you can find in all the lands. But you better start bashing in some heads or whatever it is you do so you can afford the good stuff, because it doesn't come cheap."
    // en base_es
    // en = "A trader from the north got lost in the steppe the other week. He made it back but did not stop fantasizing about some lake he discovered surrounded by lush plants and strange animals."
    // en base_es
    // context: ::Const.Strings.RumorsSteppeSettlement
    {
        en = "Saw a differant kind of worm eat a caravan donkey today. Looked mean it did."
        es = ""
    }
    // context: ::Const.Strings.RumorsSteppeSettlement
    {
        en = "Tell your company to keep their mitts off of the innkeeper's daughter. The last lover boy who tried something had his nose cut right off."
        es = ""
    }
    // en = "I'm from up north originally, moved to %townname% just some years ago. Never could stand the cold; snow and wind, day in and out. So one day I just said to myself, %randomname%, I said, go where the sun warms the earth and you're not shivering every time you go out to collect fire wood. And so I did. Didn't regret it since."
    // en base_es
    // en = "You like mushrooms? Well, I most certainly hate them! But there's not much else to be found in this stinking swamp besides biting midges and spiders."
    // en base_es
    // context: ::Const.Strings.RumorsSwampSettlement
    {
        en = "Take care goining into the swamps, friend. There's a bunch of nutters out there with bows and slings who are dyin' to meet their god early."
        es = ""
    }
    // context: ::Const.Strings.RumorsSwampSettlement
    {
        en = "Word of advice from a man who's lived here all his life — stay outta the water. If someone decides to get the jump on you and you're waist high in muck you better have an escape plan."
        es = ""
    }
    // en = "Traders don't come here often. Their large carriages tend to get stuck in the mud and guess who has to help them out once that happens..."
    // en base_es
    // en = "There once was a stone road leading here bringing traders, customers and all kinds of folk. One day it completely sunk into the swamp and look at this place now..."
    // en base_es
    // en = "Don't wander through the swamps at night! You might get lost, yes, but out in the swamp at night there's far worse things that can happen to a man. Just ask anyone around here."
    // en base_es
    // en = "Those northeners pay good coin for our silk and spices, so we have caravans going up all the time. And caravans need escorts, you know."
    // en base_es
    // en = "If I can give you one piece of advice, it's this: don't venture too far out in the desert. There are things far worse than heat and sand at the edge of the world."
    // en base_es
    // context: ::Const.Strings.RumorsDesertSettlement
    {
        en = "Make sure you fill up on water before you go out into the desert, crownling. The heat will kill any man, big or small."
        es = ""
    }
    // context: ::Const.Strings.RumorsDesertSettlement
    {
        en = "Careful where you step out here friend, the sand is not as stable as you think it might be."
        es = ""
    }
    // context: ::Const.Strings.RumorsDesertSettlement
    {
        en = "You better be careful fighting the snakes in the desert around here. They're strong enough to drag a man off his feet!"
        es = ""
    }
    // context: ::Const.Strings.RumorsDesertSettlement
    {
        en = "Word of advice, crownling — if a gladiator looks at you. Look. Away."
        es = ""
    }
    // context: ::Const.Strings.RumorsDesertSettlement
    {
        en = "Did you meet any of the dead in the desert on your way in? Saw a young fighter from the arena turn to dust after hitting one of them once. Hard to bury something like that."
        es = ""
    }
    // context: ::Const.Strings.RumorsDesertSettlement
    {
        en = "A friend of mine said something about an ancient temple somewhere in the desert. Sounds like a fool's errand for me..."
        es = ""
    }
    // en = "Those northern dogs have no right to come into our lands, they should stay where they belong!"
    // en base_es
    // en = "A caravan transporting some valuable ceremonial weapon has been raided %direction% of here. Rumor is the victims had every single bone broken, and a terrible stench hangs in the air."
    // en base_es
    // en = "A patron recently spoke of some weapon called the %item% he wanted to sell. Said he got spooked by some greenskinned beasts on his way to town and abandoned it %terrain% %direction% from here."
    // en base_es
    // en = "A traveler told me the other day that he saw the biggest man alive wielding what he called %item% with his own eyes. Sounds like hogwash to me, but if you're interested the guy left here towards the %direction%."
    // en base_es
    // en = "Big cocked adventurer with a pretty face came by here a few nights ago. He headed %direction% of here looking to slay some greenskins. Wore a fancy shield on his back, looked like some type o' knight, but told me he wasn't."
    // en base_es
    // en = "They say that some famous shield, I forgot what it was called, once stopped a boulder from rolling down a hill and crushing a camp. Sounds like shite to me. Not that we'll ever find out if it's true that it's an orc war trophy now, hidden somewhere %distance% to the %direction% of here."
    // en base_es
    // en = "Don't take my word for it, but supposedly some big green oafs %direction% of here are toting around with an incredible shield simply called %item%. How they might've gotten it is beyond me."
    // en base_es
    // en = "Some nobleman's manor got raided by greenskins a few days ago. They made off with some famous shield or relic. Supposedly those greenskinned bastards are holed up somewhere %direction% of here."
    // en base_es
    // en = "Familiar with orcs? Massive beasts and strong as oxen! A mercenary band that called themselves %randommercenarycompany% came through and headed %direction% to hunt them down some weeks ago. They never returned, but their leader wore the most impressive armor I've ever seen in my life!"
    // en base_es
    // en = "Oh, have you heard of %item%? It's said to have been stolen ages ago during the last orc invasion. There were sightings of it reported %direction% of here, but me, I don't know any details. I didn't mean to get your hopes up about it."
    // en base_es
    // en = "Some famed armorsmith got slain a few days ago. Rumor has it orcs ransacked his place and ran off with his masterpiece to somewhere %direction% from here. Maybe someone else can tell you more."
    // en base_es
    // en = "Word has it %randomnoble% got forever put to sleep by a band of greenskins %direction% of here. He was well known for abusing all his servants so you won't find anyone crying for him 'round here. Just a shame for the mastercrafted armor he used to boast, that one could buy us a lot of pigs and cows. And chickens!"
    // en base_es
    // context: ::Const.Strings.RumorsItemsGoblins
    {
        en = "A really pissed-off nobleman told me the other day that some stunty greenskins made off with his family heirloom after poisoning his trusted guard dogs. He swears they hid %terrain% somewhere %distance% from here, but I don't think he ever convinced anyone to go %direction% to retrieve it for him. Certainly not me."
        es = ""
    }
    // en = "Afraid of greenskins? Some real beaten up soldiers passed down through here the other day. Said they wanted to wrestle a well-known weapon from goblins %direction% of here, but it sure looked like it didn't go down as planned and they had to pull back. Guess their prize is still up for the taking."
    // en base_es
    // en = "A farmer from up %direction% told me he saw some small, sinister creatures on his land carrying a large, shiny shield and making devilish noises. He says it was goblins, but I say he got pranked by some youngsters!"
    // en base_es
    // en = "They found the best shieldmaker in the whole region dead with a dart sticking out of his neck %direction% of here. People said they saw little creatures running off with half his wares."
    // en base_es
    // en = "Somewhere %direction% of here be some goblins. The only reason I know it is because every swinging dick that comes this way talks about how they just barely got away with their life. One even claims he lost his mastercrafted shield when legging it."
    // en base_es
    // en = "Word has it that some overpriced and overvalued piece of armor  was stolen from the guardhouse by some small devil creatures that hauled it to the %direction%. %randomname% said it must've been goblins, but no one here really knows what they look like."
    // en base_es
    // en = "It's said that kobolds and goblins take a special interest in everything shiny. I never believed this to be true myself, but I repeatedly saw something glistening in the sun %terrain% %direction% from here and heard strange stories about short and stubby creatures roaming that area."
    // en base_es
    // en = "You may be interested to learn that our old herbalist outside of town got robbed last night just as a wealthy knight payed him a visit. The assailants, he claims it was small creatures looking like deformed kids, killed the knight and made off to %terrain% in the %direction%."
    // en base_es
    // en = "Word has it that a bunch of ne'er do wells %direction% from here got their hands on something real fancy and sharp through a brash heist."
    // en base_es
    // context: ::Const.Strings.RumorsItemsBandits
    {
        en = "Buncha lowlifes tried raiding a caravan %terrain% %distance% from here. They all got slain, but rumor has it that some valuable weapon went missing during the fight. The caravan guards have been searching %direction% for it frantically since."
        es = ""
    }
    // en = "A bewildered patron told me he was held prisoner by some rogues %terrain% %distance% from here. Said they had something real pretty with them. Some sort of curious looking weapon."
    // en base_es
    // en = "The captain of the guard deserted a while ago to join a raider camp hidden %terrain% to the %direction%. My uncle, who served under him, claims he raided the armory before leaving and grabbed a real prize."
    // en base_es
    // en = "I hear the famous shield %item% has been sighted. %randomname% claims that it belongs to a band of hard boiled raiders camping out %direction% of here. But then, %randomname% talks lots about things he knows nothing about."
    // en base_es
    // context: ::Const.Strings.RumorsItemsBandits
    {
        en = "All anyone talks 'bout 'round these parts are damned raiders. 'Suppose they're the toast of Rumorville 'cause they gots their hands on the %item% or some such thing now. Where at? Oh, somewhere %terrain% to the %direction% ."
        es = ""
    }
    // en = "A friend of a friend got robbed %direction% from here by a group of outlaws the other day. He claims the leader donned the most astonishing armor!"
    // en base_es
    // en = "A brash young man came through just the other day, nobility methinks, looking for an old family heirloom called %item%. Last I saw, he was heading %direction% of here."
    // en base_es
    // en = "Now, I don't want to start any rumors, but I saw a dead man walking around %direction% of here. His rotten hands clutched an extraordinary weapon but I'd never dare go there again in my life!"
    // en base_es
    // en = "Some drunk scavenger came by last night, told us he'd tried to wrestle a weapon beset with gems from a dead man's hands %distance% to the %direction%. Said his grip was like a vice, and then he made a sound, so he ran off. Such nonsense, but he looked spooked as all hell."
    // en base_es
    // en = "There's lots of talk about the dead walking the earth again. %randomname% says there's some to the %direction% of here. Sounds like hogwash to me."
    // en base_es
    // en = "Supposedly a bunch of graves %direction% of here are turning up empty. Someone said graverobbers were looking for a famed shield buried there. Strangely, nobody's actually seen those graverobbers, so maybe it's all hogwash."
    // en base_es
    // context: ::Const.Strings.RumorsItemsUndead
    {
        en = "So I watched over the steward's books and came across old maps that depicted an ancient noble burial ground %terrain% %distance% %direction% from here. However, they've searched %direction% and nobody was able to find it yet. Well, some things are just not meant to be found, I suppose."
        es = ""
    }
    // en = "So %terrain% %direction% of here is supposedly the last resting place of a mystical piece of armor. Don't know the name myself, I just know a lot of adventurers go there and don't come back. Dunno why I told you, really. I like your business."
    // en base_es
    // context: ::Const.Strings.RumorsItemsUndead
    {
        en = "You heard of %location%? Ask anyone around here, it's been haunting %townname% since before I was born. Folks say some armor from the gods is sealed there for all time, back from when man first settled to the %direction%"
        es = ""
    }
    // en = "Nothing is holy to those barbarian brutes! A completely naked priest stumbled in here from %direction%. He was on the way to bring a revered relic to the temple but they took it from him."
    // en base_es
    // en = "A mercenary company came by here hunting barbarians. The leader wielded a weapon unlike anything I ever saw before. They turned %direction% and were never to be seen again."
    // en base_es
    // en = "When you head out %terrain% %direction%, keep your eyes peeled for a group of fierce wild men. They may lead you to their stash where a famed stolen weapon is said to be found."
    // en base_es
    // en = "Hark! A tribe of uncultured barbarians has been seen %direction% of here with a shield called %item% in their dirty hands! Slay them and get it back!"
    // en base_es
    // context: ::Const.Strings.RumorsItemsBarbarians
    {
        en = "A friend of a friend spotted some wildlings in the distance %direction% of here. He swears they carried a finely crafted shield. I call horseshit, as everbody knows they do not use shields like we do!"
        es = ""
    }
    // en = "Only a good defense allows for a strong offense they say. Rumors has it, a band of barbarians %distance% to the %direction% are in the possession of a famed shield..."
    // en base_es
    // en = "I used to be trading with some of the not-so-wild barbarians %direction% of here. When I last visited them there was a magnificent shield hanging in one of their huts. They might still be hanging out there %terrain%."
    // en base_es
    // en = "You look like you could use some better armor, my friend. If you are not scared of taking on fierce barbarians, there is a mighty fine armor to be claimed in one of their camps called %location%, %terrain% %direction% of here."
    // en base_es
    // context: ::Const.Strings.RumorsItemsBarbarians
    {
        en = "The famed %item% has been guarded in the armory for decades, but when the wildlings from the north came they took everything with them. They are said to be camping out somewhere %terrain% %distance% from here."
        es = ""
    }
    // en = "I came here to pick up an heirloom from my late grandfather just to get to know it has been stolen by marauding barbarians. They are said to loiter somewhere %terrain% %direction% of here, but I fear I will never get it back."
    // en base_es
    // en = "Are you also here to look for %item% like all those other fools? It is said to lie somewhere %terrain% %direction%. Nothing but hogwash if you ask me..."
    // en base_es
    // en = "The nomads take what they want and hide out in the desert. The guards have been looking for them %terrain% %direction% of here. I think they're %distance%."
    // en base_es
    // en = "The days here in the south are as bright as the nights are dark. I must have stumbled and lost my precious weapon %distance% to the %direction%, but I gave up looking for it."
    // en base_es
    // en = "The craftsmen of the ancient times really knew how to make remarkable weapons. Rumors has it such a weapon is with a nomad tribe hiding out in the %direction%, but who should take it from them - me? Ha!"
    // en base_es
    // en = "A shield reflecting the sunlight like a mirror, more blinding than the midday in the desert! Where I saw that? Some Nomads had it in the %direction% %distance% from here, if I recall correctly."
    // en base_es
    // en = "All my life I've been hunting nomads across the borders %terrain%, but I never saw one wield a shield like this one before. It was %distance% to the %direction% at one of their camps."
    // en base_es
    // en = "Nomads do not only take from the living but from the dead as well! Word has it they plundered the so-called %item% from a tomb %direction% of here where they have their camp still. They really do not have any decency."
    // en base_es
    // en = "I used to be first quartermaster to a Vizier. When the famed armor I ordered for a guest of honor did not arrive, I lost my position. The caravan with it was ambushed by nomads, I later learned, %direction% of here."
    // en base_es
    // en = "An opulent armor is said to be hidden out %terrain% %direction% from here. Many treasure seekers failed to claim it so far but maybe you have more luck?"
    // en base_es
    // en = "The most skilled armorsmith around, who happens to be a friend of mine, got tricked by those damned nomads and they made off with one of his prize armors. If you come across any nomads %direction% of here, search their bodies thoroughly!"
    // en base_es
    // en = "The nobles are quarreling again like two old hags at the garden fence. They just can't get over their pride!"
    // en base_es
    // en = "The nobles will take all your crowns, and your sons and husbands too, and burn them in their pointless struggles - a thousand curses 'pon them!"
    // en base_es
    // en = "I've served my time in the army twenty years ago. Lost an ear, see? Now my boy's marching. Was snatched right out the stables and forced into the frontline. Different war, same old shit. I pray he stays low and keeps his shield up."
    // en base_es
    // en = "The green tide keeps washing away one army after the other! We're all doomed! Doomed!"
    // en base_es
