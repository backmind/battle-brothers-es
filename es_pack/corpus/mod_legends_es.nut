        en = "Have at least a named or a legendary items in your possession "
        es = "Tener en tu poder al menos un objeto con nombre o legendario "
    }
    // context: bounty_hunter_follower.o.create.addSkillRequirement()
    {
        en = "Have at least one of the following backgrounds: Manhunter, Witch Hunter, Beast Slayer, Bounty Hunter"
        es = "Tener al menos uno de los siguientes trasfondos: Cazahombres, Cazador de brujas, Cazador de Bestias, Cazarrecompensas"
    }
    // FILE: mod_legends\hooks\retinue\followers\brigand_follower.nut
    // context: brigand_follower.o.create.m.Name
    {
        en = "Stolen Documents"
        es = "Documentos robados"
    }
    // context: brigand_follower.o.create.m.Description
    {
        en = "The nobles and merchants are sloppy with their security and their underlings are easily intimidated. A well placed bribe, brawl or a set of light fingers can keep you informed on who is taking what where."
        es = "Los nobles y los comerciantes descuidan su seguridad, y sus subordinados se dejan intimidar con facilidad. Un soborno bien colocado, una pelea o unos dedos ágiles pueden mantenerte informado de quién lleva qué y adónde."
    }
    // en = "Makes you see the position of some caravans at all times and even if outside your sight radius"
    // en base_es
    // context: brigand_follower.o.create.m.Effects
    {
        en = "Allows you to see up to 3 of the most valuable items that are being transporting by caravans"
        es = "Te permite ver hasta 3 de los objetos más valiosos que transportan las caravanas"
    }
    // context: brigand_follower.o.create.addRequirement()
    {
        en = "Raided at least 3 caravans"
        es = "Haber asaltado al menos 3 caravanas"
    }
    // context: brigand_follower.o.create.addRequirement()._r.UpdateText.Text
    {
        // this.Text = "Raided " + ::Math.min(this.Count, ::World.Statistics.getFlags().getAsInt("CaravansRaided")) + "/" + this.Count + " caravans"
        mode = "pattern"
        en = "Raided <count:int>/<total:int> caravans"
        es = "Haber asaltado <count>/<total> caravanas"
    }
    // context: brigand_follower.o.create.addSkillRequirement()
    {
        en = "Have at least one of the following backgrounds: Raider, Barbarian, Deserter"
        es = "Tener al menos uno de los siguientes trasfondos: Asaltante, Bárbaro, Desertor"
    }
    // FILE: mod_legends\hooks\retinue\followers\cartographer_follower.nut
    // context: cartographer_follower.o.create.m.Name
    {
        en = "Mapping Supplies"
        es = "Material cartográfico"
    }
    // context: cartographer_follower.o.create.m.Description
    {
        en = "Learning to read is a rare skill and can take some a lifetime to master. Reading maps on the other head can be a little less taxing on the average mercenary. Giving the best and brightest of the company what they need to draw could prove useful."
        es = "Aprender a leer es una destreza poco común, y a algunos les lleva toda una vida dominarla. Leer mapas, en cambio, puede resultarle algo menos agotador al mercenario medio. Darles a los más brillantes de la compañía lo que necesitan para dibujar podría resultar útil."
    }
    // en = "Pays you between 100 and 400 crowns for every location you discover on your own. The further away from civilization, the more you're paid. Legendary locations pay double."
    // en base_es
    // en = "Discovered a legendary location"
    // en base_es
    // context: cartographer_follower.o.create.addSkillRequirement()
    {
        en = "Have at least one of the following backgrounds: Adventurous Noble/Lady, Noble Commander, Philosopher, Historian"
        es = "Tener al menos uno de los siguientes trasfondos: Noble aventurero/Dama aventurera, Comandante noble, Filósofo, Historiador"
    }
    // FILE: mod_legends\hooks\retinue\followers\cook_follower.nut
    // context: cook_follower.o.create.m.Name
    {
        en = "Cooking Equipment"
        es = "Utensilios de cocina"
    }
    // context: cook_follower.o.create.m.Description
    {
        en = "A good warm meal goes a long way towards healing body and mind. A cook can only do so much with whatever there is to hand in the wilderness, Having the proper equipment to prepare meals makes sure that no provisions go to waste."
        es = "Una buena comida caliente ayuda mucho a sanar el cuerpo y la mente. Quien cocina no puede hacer milagros con lo que encuentre a mano en plena naturaleza; contar con el equipo adecuado para preparar las comidas garantiza que no se desperdicie ninguna provisión."
    }
    // context: cook_follower.o.create.m.Effects
    {
        en = "Makes all provisions last 4 extra days"
        es = "Hace que todas las provisiones duren 4 días adicionales"
    }
    // context: cook_follower.o.create.addSkillRequirement()
    {
        en = "Have someone who's learned the Camp Cook perk. Guaranteed on Bakers, Fishwives, Cannibals and Butchers, may be rarely found on many others"
        es = "Tener a alguien que haya aprendido la ventaja Cocina de campamento. Garantizado en Panaderos, Pescaderas, Caníbales y Carniceros; en raras ocasiones puede aparecer en muchos otros"
    }
    // FILE: mod_legends\hooks\retinue\followers\drill_sergeant_follower.nut
    // context: drill_sergeant_follower.o.create.m.Name
    {
        en = "Training Dummies"
        es = "Muñecos de entrenamiento"
    }
    // context: drill_sergeant_follower.o.create.m.Description
    {
        en = "Some are born to kill, but others need a little more encouragement and less risk to fully reach their potential, with supervision of course."
        es = "Algunos nacen para matar, pero otros necesitan un poco más de ánimo y menos riesgo para alcanzar todo su potencial, bajo supervisión, por supuesto."
    }
    // context: drill_sergeant_follower.o.create.m.Effects
    {
        en = "Makes your mercenaries gain 20% more experience if they are under level 12"
        es = "Hace que tus mercenarios ganen un 20% más de experiencia si están por debajo del nivel 12"
    }
    // context: drill_sergeant_follower.o.create.m.Effects
    {
        en = "Makes mercenaries in reserve never lose mood from not taking part in battles"
        es = "Hace que los mercenarios en la reserva nunca pierdan ánimo por no participar en las batallas"
    }
    // context: drill_sergeant_follower.o.create.addRequirement()
    {
        en = "Won 50 battles"
        es = "Haber ganado 50 batallas"
    }
    // context: drill_sergeant_follower.o.create.addRequirement()._r.UpdateText.Text
    {
        // this.Text = "Won at least " + ::Math.min(this.Count, ::World.Statistics.getFlags().getAsInt("BattlesWon")) + "/" + this.Count + " battles"
        mode = "pattern"
        en = "Won at least <count:int>/<total:int> battles"
        es = "Haber ganado al menos <count>/<total> batallas"
    }
    // context: drill_sergeant_follower.o.create.addSkillRequirement()
    {
        en = "Have at least one of the following backgrounds: Retired Soldier, Swordmaster, Sellsword, or Gladiator"
        es = "Tener al menos uno de los siguientes trasfondos: Soldado retirado, Maestro espadachín, Mercenario o Gladiador"
    }
    // FILE: mod_legends\hooks\retinue\followers\lookout_follower.nut
    // context: lookout_follower.o.create.m.Name
    {
        en = "Outrider's Post"
        es = "Puesto del batidor"
    }
    // en = "Having a quick Lookout with sharp eyes travel in advance of the company can prove invaluable in being aware of dangers and points of interests before others become aware of the company."
    // en base_es
    // en = "Increases your sight radius by 25%"
    // en base_es
    // en = "Reveals extended information about footprints"
    // en base_es
    // context: lookout_follower.o.create.addSkillRequirement()
    {
        en = "Have someone with the Lookout perk. Guaranteed on Thief, Poacher, Nomad and many others"
        es = "Tener a alguien con la ventaja Vigía. Garantizado en Ladrón, Cazador furtivo, Nómada y muchos otros"
    }
    // FILE: mod_legends\hooks\retinue\followers\minstrel_follower.nut
    // context: minstrel_follower.o.create.m.Name
    {
        en = "Minstrel's Tent"
        es = "Tienda del juglar"
    }
    // context: minstrel_follower.o.create.m.Description
    {
        en = "A good song and story play a large part in creating the reputation of a company. A place to practice and reflect on these crafts will help to spread the word about your deeds to all ears - willing to hear them or not."
        es = "Una buena canción y una buena historia juegan un papel importante en la creación de la reputación de cualquier compañía. Un lugar donde practicar estos oficios y reflexionar sobre ellos ayudará a difundir tus hazañas a todos los oídos, estén dispuestos a escucharlas o no."
    }
    // en = "Makes you earn 15% more renown with every action"
    // en base_es
    // en = "Makes tavern rumors more likely to contain useful information"
    // en base_es
    // context: minstrel_follower.o.create.addSkillRequirement()
    {
        en = "Have someone with the Entice perk. Guaranteed on Minstrels and Troubadours"
        es = "Tener a alguien con la ventaja Tentar. Garantizado en Juglares y Trovadores"
    }
    // FILE: mod_legends\hooks\retinue\followers\negotiator_follower.nut
    // context: negotiator_follower.o.create.m.Name
    {
        en = "Meeting Point"
        es = "Punto de encuentro"
    }
    // context: negotiator_follower.o.create.m.Description
    {
        en = "Having a dedicated meeting place where negotiators can talk, barter and trade insults with prominent figures or their lackeys can help in finding work."
        es = "Contar con un lugar de reunión propio donde los negociadores puedan conversar, regatear e intercambiar insultos con personajes destacados o sus lacayos puede ayudar a encontrar trabajo."
    }
    // context: negotiator_follower.o.create.m.Effects
    {
        en = "Allows for more rounds of contract negotiations and greater payment with your potential employers before they abort, and with only a 10% chance on a hit to relations. Bad relations recover faster"
        es = "Permite más rondas de negociación de contratos y pagos mayores con tus posibles empleadores antes de que se retiren, y con solo un 10% de probabilidad de que empeoren las relaciones. Las malas relaciones se recuperan más rápido"
    }
    // context: negotiator_follower.o.create.addRequirement()
    {
        en = "Negotiated for the payment of contracts x times"
        es = "Haber negociado el pago de contratos x veces"
    }
    // context: negotiator_follower.o.create.addRequirement()._r.UpdateText.Text
    {
        // this.Text = "Negotiated for the payment of contracts " + ::Math.min(this.Count, ::World.Statistics.getFlags().getAsInt("NegotiatingTries")) + "/" + this.Count + " times (attempts only be counted after accepting the contract)"
        mode = "pattern"
        en = "Negotiated for the payment of contracts <count:int>/<total:int> times (attempts only be counted after accepting the contract)"
        es = "Haber negociado el pago de contratos <count>/<total> veces (los intentos solo cuentan después de aceptar el contrato)"
    }
    // context: negotiator_follower.o.create.addSkillRequirement()
    {
        en = "Have someone with the Pacifist perk. Guaranteed on Widow, Inventor, Tailor and many others"
        es = "Tener a alguien con la ventaja Pacifista. Garantizado en Viuda, Inventor, Sastre y muchos otros"
    }
    // FILE: mod_legends\hooks\retinue\followers\paymaster_follower.nut
    // context: paymaster_follower.o.create.m.Name
    {
        en = "Pennypincher's Tools"
        es = "Herramientas del tacaño"
    }
    // context: paymaster_follower.o.create.m.Description
    {
        en = "Few have the patience to count and fewer still the willpower to weigh and count coins as part of their contract. But the Paymaster is a figure of respect to all those around them."
        es = "Pocos tienen la paciencia de contar, y menos aún la fuerza de voluntad para pesar y contar monedas como parte de su contrato. Pero el Contador es una figura respetada por todo su entorno."
    }
    // context: paymaster_follower.o.create.m.Effects.format()
    {
        // format("Reduces the daily wage of each man by %s%%", ((1.0 - this.m.Multiplier) * 100).tostring()),
        mode = "pattern"
        en = "Reduces the daily wage of each man by <pct:str>%%"
        es = "Reduce el salario diario de cada hombre en un <pct>%%"
    }
    // en = "Reduces the chance of desertion by 50%"
    // en base_es
    // en = "Prevents men demanding more pay in events"
    // en base_es
    // context: paymaster_follower.o.create.addSkillRequirement()
    {
        en = "Have a mercenary who has taken the Paymaster perk. Guaranteed on Peddlers, Eunuchs and Servants"
        es = "Tener un mercenario que haya elegido la ventaja Contador. Garantizado en Vendedores ambulantes, Eunucos y Sirvientes"
    }
    // FILE: mod_legends\hooks\retinue\followers\quartermaster_follower.nut
    // context: quartermaster_follower.o.create.m.Name
    {
        en = "Ordered Inventory"
        es = "Inventario ordenado"
    }
    // en = "With years of experience from traveling with caravans, the Quartermaster is able to squeeze and rotate any piece of gear, luggage or armor into the perfect spot to use space as efficiently as possible."
    // en base_es
    // context: quartermaster_follower.o.create.m.Effects
    {
        en = "Increases the amount of you can carry of ammunition by 100, medical supplies and tools by 50"
        es = "Aumenta en 100 la munición que puedes llevar, y en 50 la medicina y las herramientas"
    }
    // context: quartermaster_follower.o.create.m.Effects
    {
        en = "Increases stash size by 27"
        es = "Aumenta en 27 el tamaño del alijo"
    }
    // context: quartermaster_follower.o.create.addSkillRequirement()
    {
        en = "Have someone with the Skillful Stacking perk. Guaranteed on Vagabonds, Millers, Donkeys and many others"
        es = "Tener a alguien con la ventaja Apilado hábil. Garantizado en Vagabundos, Molineros, Burros y muchos otros"
    }
    // FILE: mod_legends\hooks\retinue\followers\recruiter_follower.nut
    // context: recruiter_follower.o.create.m.Name
    {
        en = "Pre-filled Contracts"
        es = "Contratos ya redactados"
    }
    // context: recruiter_follower.o.create.m.Description
    {
        en = "The deviousness of a pre-filled contract that needs a single signature can make the labours of arguing about pay a thing of the past. Just simply sign on the line and you are ready to go! Just don't let them read the small print."
        es = "La astucia de un contrato ya rellenado que solo necesita una firma puede convertir en cosa del pasado la tarea de discutir la paga. ¡Basta con firmar en la línea y listo! Eso sí, que no lean la letra pequeña."
    }
    // en = "Makes you pay 10% less up front for hiring new men, and 50% less for tryouts"
    // en base_es
    // en = "Makes between 2 and 4 additional men available to recruit in every settlement"
    // en base_es
    // context: recruiter_follower.o.create.addSkillRequirement()
    {
        en = "Have a mercenary who has taken the Inspiring Presence perk. Guaranteed on Cultists, Pimps, Retired Soldiers and many others."
        es = "Tener un mercenario que haya elegido la ventaja Presencia inspiradora. Garantizado en Cultistas, Chulos, Soldados retirados y muchos otros."
    }
    // FILE: mod_legends\hooks\retinue\followers\scavenger_follower.nut
    // context: scavenger_follower.o.create.m.Name
    {
        en = "Scavenger's Cart"
        es = "Carro del carroñero"
    }
    // context: scavenger_follower.o.create.m.Description
    {
        en = "While mundane, the act of taking everything not nailed down after a battle can save a lot of money later down the road. Comes with pliars to open deathgrips."
        es = "Aunque sea algo mundano, llevarse todo lo que no esté clavado después de una batalla puede ahorrar mucho dinero más adelante. Incluye tenazas para abrir los puños rígidos de los muertos."
    }
    // en = "Recovers a part of all ammo you use during battle"
    // en base_es
    // en = "Recovers tools and supplies from every armor destroyed by you during battle"
    // en base_es
    // context: scavenger_follower.o.create.addSkillRequirement()
    {
        en = "Have at least one of the following backgrounds: Beggar, Cripple, Refugee, Indebted"
        es = "Tener al menos uno de los siguientes trasfondos: Mendigo, Lisiado, Refugiado, Endeudado"
    }
    // FILE: mod_legends\hooks\retinue\followers\scout_follower.nut
    // context: scout_follower.o.create.m.Name
    {
        en = "Watcher's Totem"
        es = "Tótem del vigilante"
    }
    // context: scout_follower.o.create.m.Description
    {
        en = "The people of the woods and hinterlands swear that the presence of this totem grants good fortune to those around it, somehow preventing sickness and accidents as long as it is in the camp. Sounds like farking nonsense but if it keeps them happy..."
        es = "La gente de los bosques y de las tierras del interior jura que la presencia de este tótem trae buena fortuna a quienes lo rodean y que, de algún modo, previene enfermedades y accidentes mientras esté en el campamento. Suena a una jodida tontería, pero si así están contentos..."
    }
    // context: scout_follower.o.create.m.Effects
    {
        en = "Reduces the movement penalty of difficult terrain by 15%"
        es = "Reduce un 15% la penalización de movimiento en terreno difícil"
    }
    // en = "Prevents sickness and accidents due to terrain"
    // en base_es
    // context: scout_follower.o.create.addSkillRequirement()
    {
        en = "Have at least one of the following backgrounds: Wildman/Wildwoman, Hunter, Lumberjack, Ranger, Master Archer"
        es = "Tener al menos uno de los siguientes trasfondos: Salvaje, Cazador, Leñador, Guardabosques, Maestro arquero"
    }
    // FILE: mod_legends\hooks\retinue\followers\surgeon_follower.nut
    // context: surgeon_follower.o.create.m.Name
    {
        en = "Triage Table"
        es = "Mesa de triaje"
    }
    // context: surgeon_follower.o.create.m.Description
    {
        en = "Having an area set up and ready to treat the worst injuries could be the hair between life and death for the company. Maybe even yourself...one day."
        es = "Contar con una zona preparada y lista para tratar las peores heridas podría marcar, por un pelo, la diferencia entre la vida y la muerte para la compañía. Quizá incluso para ti... algún día."
    }
    // en = "Makes every man without a permanent injury guaranteed to survive an otherwise fatal blow"
    // en base_es
    // en = "Makes every injury take one less day to heal"
    // en base_es
    // context: surgeon_follower.o.create.addSkillRequirement()
    {
        en = "Have someone with the Field Triage perk. Guaranteed on Monks and Nuns"
        es = "Tener a alguien con la ventaja Triaje de campaña. Garantizado en Monjes y Monjas"
    }
    // FILE: mod_legends\hooks\retinue\followers\trader_follower.nut
    // context: trader_follower.o.create.m.Name
    {
        en = "Secure Chests"
        es = "Cofres seguros"
    }
    // context: trader_follower.o.create.m.Description
    {
        en = "While not common, some companies have special goods stashed away to tell on the road to travellers. These goods are always kept in the most fortified chests the company has to offer, to prevent prying fingers from outside and inside the camp."
        es = "Aunque no es habitual, algunas compañías guardan mercancías especiales para vendérselas por el camino a los viajeros. Estas mercancías se guardan siempre en los cofres más reforzados de la compañía, para evitar dedos curiosos de dentro y de fuera del campamento."
    }
    // en = "Increases the amount of trade goods for sale by 1 for each location that produces them, like salt near salt mines, allowing you to trade at higher volumes"
    // en base_es
    // context: trader_follower.o.create.addRequirement()
    {
        en = "Sold 25 trade goods"
        es = "Haber vendido 25 mercancías"
    }
    // context: trader_follower.o.create.addRequirement()._r.UpdateText.Text
    {
        // this.Text = "Sold " + ::Math.min(this.Count, ::World.Statistics.getFlags().getAsInt("TradeGoodsSold")) + "/" + this.Count + " trade goods"
        mode = "pattern"
        en = "Sold <count:int>/<total:int> trade goods"
        es = "Haber vendido <count>/<total> mercancías"
    }
    // context: trader_follower.o.create.addSkillRequirement()
    {
        en = "Have at least one of the following backgrounds: Caravan Hand, Peddler, Trader, Donkey"
        es = "Tener al menos uno de los siguientes trasfondos: Ayudante de caravana, Vendedor ambulante, Comerciante, Burro"
    }
    // FILE: mod_legends\hooks\scenarios\tactical\scenario_line_battle_lindwurm.nut
    // en = "ScenarioLineBattle::generate()"
    // FILE: mod_legends\hooks\scenarios\world\anatomists_scenario.nut
    // en = "\x7bCaptain? Is it alright if I call you captain? Ah, of course it is. What? No, we were not calling you by another name. Yers is a smooth costard, good sir, and we would not be of such derring-do to refer to you as a sellsword who is as ordinary as any of our coetaneous clodpolls, or state that we were in some sense importuning commerce by conducting business with a man of your particular skills. No sir, we would not. We are not children of perdition, sir.\x7d"
    // en base_es
    // en = "\x7bDespite others' hesitancies, I've no qualms calling you a javel, sir. You are, after all, a javel. A scapegrace. Some sellsword or another, yes? I think only a man who trucks cowardice would avoid calling you what you are. That someone disrespects your intelligence, thinking you yourself know not yourself. Even I see that in you accepting who you are, you are quite a good specimen. I mean, sellsword.\x7d"
    // en base_es
    // en = "\x7bThough our quotidian dialogues are no doubt drollery, beneath the banausic surface I must admit I feel a touch of serotinous savagery lurking within you, coming to the fore as if my words be fire. Even our most desultory talks has me on edge, the way you stare at me with such hateful eyes. Well, know this, bounty hunter, I am no casuist, I speak in earnest. You are too fine a specimen-I mean captain to be lofting some sapskull's brickbats at. Understand?\x7d"
    // en base_es
    // FILE: mod_legends\hooks\scenarios\world\beast_hunters_scenario.nut
    // en = "Beast Slayers"
    // en base_es
    // context: beast_hunters_scenario.o.create.m.Description
    {
        // corrige base: «azotan las tierras» por «azotan las aldeas»: el inglés dice «villages»
        // corrige base: «Te ganas la vida» omite «and your men»; ahora «Tú y los tuyos se ganan la vida»
        // corrige base: «algunos trofeos» por «algunos trofeos de bestias» («beast trophies»)
        // corrige base: «Rastreadores» y «Desolladores» pierden el «Expert» de «Expert Trackers» y «Expert Skinners»
        en = "[p=c][img]gfx/ui/events/event_122.png[/img][/p][p]You and your kind make your living by hunting down the many beasts that beset villages on the fringes of civilization. It is dangerous work, but it pays well enough and there is always a bigger beast to slay and more crowns to earn.\n\n[color=#bcad8c]Beast Slayers:[/color] Start with three Beast Slayers and decent equipment, as well as some beast trophies. Beast Slayers gain a unique trait when fighting beasts. Chance to find others that support your cause.\n[color=#bcad8c]Expert Skulkers:[/color] See tracks from further away. Recruits gain a random Favoured Beast Enemy perk.\n[color=#bcad8c]Expert Skinners:[/color] Each beast you slay has a 50% chance to drop an additional trophy.\n[color=#bcad8c]Prejudice:[/color] Most people do not trust your kind, get 20% worse prices.[/p]"
        es = "[p=c][img]gfx/ui/events/event_122.png[/img][/p][p]Con los tuyos te ganas la vida cazando las numerosas bestias que azotan las aldeas en los límites de la civilización. Es un trabajo peligroso, pero paga bastante bien, y siempre hay una bestia más grande que matar y más coronas que ganar.\n\n[color=#dda21f]Cazadores de bestias:[/color] Comienza con tres cazadores de bestias, equipo decente y algunos trofeos de bestias. Los cazadores de bestias obtienen un rasgo único al luchar contra bestias. Posibilidad de encontrar a otros que apoyen tu causa.\n[color=#dda21f]Acechadores expertos:[/color] Puedes ver huellas desde más lejos. Los reclutas obtienen una ventaja aleatoria de enemigo predilecto contra bestias.\n[color=#dda21f]Desolladores expertos:[/color] Cada bestia que mates tiene un [color=#1e861e]50%[/color] de probabilidad de soltar un trofeo adicional.\n[color=#dda21f]Prejuicio:[/color] La mayoría de las personas no confían en los de tu tipo; obtienes precios un [color=#a22424]20%[/color] peores.[/p]"
    }
    // en = "Has slain a dangerous witch"
    // en base_es
    // en = "Lost most of the company in a betrayal"
    // en base_es
    // context: beast_hunters_scenario.o.onSpawnAssets.bros[0].getBackground().m.RawDescription
    {
        en = "%name% saved you in the brigand's ambush that destroyed your band of slayers. The Guildmaster does not hang this fact over you, for you have saved %name% many a times yourself. This slayer of beasts suffers no emotion that does not bid well in this world, and that alone makes for a sound mercenary."
        es = "%name% te salvó en la emboscada de bandidos que acabó con tu banda de cazadores. Quien dirige el gremio no te lo echa en cara, pues tú también has salvado a %name% muchas veces. Quien mata bestias por oficio no se permite ninguna emoción que no convenga en este mundo, y solo con eso ya vale para el oficio de mercenario."
    }
    // context: beast_hunters_scenario.o.onSpawnAssets.bros[1].getBackground().m.RawDescription
    {
        en = "A young whelp from the city, %name% got a start in beast slaying by rooting out the warrens of 'vicious rabbits', as one puts it. You are not sure how true that is, but regardless %name% has demonstrated greats feats of arms on the battlefield more times than you can count."
        es = "Joven de ciudad y sin curtir, %name% se inició en la caza de bestias limpiando madrigueras de 'conejos feroces', como dice alguno. No sabes cuánto hay de verdad en eso, pero, en cualquier caso, %name% ha realizado grandes hazañas de armas en el campo de batalla más veces de las que puedes contar."
    }
    // context: beast_hunters_scenario.o.onSpawnAssets.bros[2].getBackground().m.RawDescription
    {
        // corrige base: sobra la coma entre sujeto y verbo en «y %name%, ciertamente no es uno»
        // corrige base: «Aún así» por «Aun así» (sin tilde: equivale a «incluso así»)
        en = "Grizzled vets are a rarity in beast slaying, and %name% sure ain't one. Instead, the 'slayer' started the foray into monster hunting by reading books instead of training the sword. Still a good enough warrior at heart, it is the study and preparation that gives %name% the edge in battle."
        es = "Los veteranos curtidos son una rareza en la caza de bestias, y desde luego no es el caso de %name%. Su incursión en la caza de monstruos empezó leyendo libros en lugar de entrenar con la espada. Aun así, sigue teniendo alma guerrera, y son el estudio y la preparación lo que da a %name% ventaja en la batalla."
    }
    // context: beast_hunters_scenario.o.onGenerateBro.bro.improveMood()
    {
        en = "Hates beasts as much as you do"
        es = "Odia a las bestias tanto como tú"
    }
    // context: beast_hunters_scenario.o.onGenerateBro.bro.improveMood()
    {
        en = "Excited to teach the new blood"
        es = "Le entusiasma instruir a la sangre nueva"
    }
    // context: beast_hunters_scenario.o.onGenerateBro.bro.improveMood()
    {
        en = "Feels at one with nature"
        es = "Se siente en comunión con la naturaleza"
    }
    // context: beast_hunters_scenario.o.onGenerateBro.bro.worsenMood()
    {
        en = "Has heard worrying things about your kind..."
        es = "Ha oído cosas inquietantes sobre los de tu tipo..."
    }
    // FILE: mod_legends\hooks\scenarios\world\cultists_scenario.nut
    // en = "Davkul Cultists"
    // en base_es
    // context: cultists_scenario.o.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_140.png[/img][/p][p]Davkul awaits. You lead a small flock devoted to the elder god, and it is time to spread the word. Find more followers, acquire riches, and please Davkul with sacrifices.\n\n[color=#bcad8c]Cultists:[/color] Start with a group of five cultists and encounter fanatical special cultists in towns.\n[color=#bcad8c]Sacrifices:[/color] Davkul will occasionally demand sacrifices from you, but also bestow boons upon those loyal to him. Davkul will not sacrifice his chosen elite. Cultists cost 25% less to hire and maintain.\n[color=#c90000]Let the Blood Flow:[/color] All cultists gain bonus melee skill and the [color=#008060]True Believer[/color] perk.[/p]"
        es = "[p=c][img]gfx/ui/events/event_140.png[/img][/p][p]Davkul aguarda. Guías a un pequeño rebaño consagrado al dios antiguo, y es hora de difundir la palabra. Encuentra más seguidores, consigue riquezas y complace a Davkul con sacrificios.\n\n[color=#dda21f]Cultistas:[/color] Comienza con un grupo de cinco cultistas y encuentra cultistas fanáticos especiales en las ciudades.\n[color=#dda21f]Sacrificios:[/color] De vez en cuando, Davkul te exigirá sacrificios, pero también concederá dones a quienes le sean leales. Davkul no sacrificará a sus elegidos de élite. Contratar y mantener cultistas cuesta un [color=#1e861e]25%[/color] menos.\n[color=#dda21f]Que fluya la sangre:[/color] Todos los cultistas obtienen una bonificación de Habilidad cuerpo a cuerpo y la ventaja [color=#008060]Verdadero creyente[/color].[/p]"
    }
    // context: cultists_scenario.o.onSpawnAssets.bros[0].getBackground().m.RawDescription
    {
        en = "When %name% joined, the cultist warmly called you captain, saying \"tis a proper manner to pursue the path into the Black from whence we came\"."
        es = "Cuando %name% se unió, te llamó cariñosamente capitán, diciendo: \"es una forma adecuada de seguir el camino hacia lo Negro de donde venimos\"."
    }
    // context: cultists_scenario.o.onSpawnAssets.bros[1].getBackground().m.RawDescription
    {
        en = "%name% found you upon the road, stating with certainty you were a mercenary captain. You wore but ordinary cloth at that moment, but %name% said that by Davkul's darkness you had an aura of wanted Black about you."
        es = "%name% te encontró en el camino y afirmó con certeza que eras un capitán mercenario. En ese momento no vestías más que ropas corrientes, pero %name% dijo que, por la oscuridad de Davkul, te envolvía un aura del anhelado Negro."
    }
    // context: cultists_scenario.o.onSpawnAssets.bros[2].getBackground().m.RawDescription
    {
        en = "A quiet figure, %name% has shadows beneath the fingerprints, running like the brine beneath a pallid shore. When you exchanged a handshake, it was as though you could hear the hissing of your sanity."
        es = "Figura callada, %name% tiene sombras bajo las huellas de los dedos, que corren como el agua salobre bajo una orilla pálida. Cuando le estrechaste la mano, fue como si pudieras oír el siseo de tu cordura."
    }
    // context: cultists_scenario.o.onSpawnAssets.bros[3].getBackground().m.RawDescription
    {
        en = "%name% banded with you outside a tavern. The first time you saw the cultist, there were scars running up %name%'s arms and across veins that could not be survived. But each morning it appears as though the scars move, slowly creeping in one direction: toward the forehead."
        es = "%name% se unió a ti a las puertas de una taberna. La primera vez que viste a %name%, tenía cicatrices que le subían por los brazos y le cruzaban las venas, heridas a las que nadie habría sobrevivido. Pero cada mañana parece como si las cicatrices se movieran, arrastrándose lentamente en una sola dirección: hacia la frente."
    }
    // context: cultists_scenario.o.onHiredByScenario._bro.improveMood()
    {
        en = "Embraced by Davkul"
        es = "Ha recibido el abrazo de Davkul"
    }
    // context: cultists_scenario.o.onHiredByScenario._bro.worsenMood()
    {
        en = "What madness have I walked into!?"
        es = "¡¿En qué locura me he metido?!"
    }
    // context: cultists_scenario.o.onGetBackgroundTooltip._tooltip.push().text
    {
        en = "[color=%positive%]+10[/color] Melee Skill from being a cultist in a cultist mercenary company"
        es = "[color=#135213]+10[/color] de Habilidad cuerpo a cuerpo por ser cultista en una compañía de mercenarios cultistas"
    }
    // context: cultists_scenario.o.onGetBackgroundTooltip._tooltip.push().text
    {
        en = "[color=%positive%]+10[/color] Melee Skill from being a cultist in a cultist mercenary company and will never be offered up to be sacrificed"
        es = "[color=#135213]+10[/color] de Habilidad cuerpo a cuerpo por ser cultista en una compañía de mercenarios cultistas, y nunca se le ofrecerá en sacrificio"
    }
    // FILE: mod_legends\hooks\scenarios\world\deserters_scenario.nut
    // en = "Deserters"
    // en base_es
    // context: deserters_scenario.o.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_88.png[/img][/p][p]For too long have you been dragged from one bloody battle to another at the whim of lords sitting in high towers. Last night, you absconded from camp together with three others. You're dressed like soldiers still, but you're deserters, and the noose will be your end if you stay here for too long.\n[color=#bcad8c]Deserters:[/color] Start with three deserters and decent armor, but lower funds, you can only be joined by outlaws or combat backgrounds, and a noble house that wants to hunt you down.\n[color=#bcad8c]First to Run:[/color] Your men always are first to act in the very first round of combat.\n[color=#c90000]Like Minded:[/color] Increased chance of finding craven dastards, deserters and the disowned. [/p]"
        es = "[p=c][img]gfx/ui/events/event_88.png[/img][/p][p]Por demasiado tiempo te han arrastrado de una sangrienta batalla a otra, a merced de señores que se sientan en altas torres. Anoche, te escapaste del campamento junto con otros tres. Todavía están vestidos como soldados, pero son desertores, y la soga será su fin si se quedan aquí por demasiado tiempo.\n[color=#dda21f]Desertores:[/color] Comienzas con tres desertores y una armadura decente, pero con menos fondos y con una casa noble que quiere darte caza; además, solo pueden unirse a ti proscritos o personas con trasfondos de combate.\n[color=#dda21f]Primeros en huir:[/color] Tus hombres siempre son los primeros en actuar en la primera ronda del combate.\n[color=#dda21f]Afines:[/color] Mayor probabilidad de encontrar cobardes rastreros, desertores y repudiados. [/p]"
    }
    // en = "Was dragged from one bloody battle to the next"
    // en base_es
    // en = "Deserted from the army"
    // en base_es
    // en = "You and your men deserted"
    // en base_es
    // context: deserters_scenario.o.onSpawnPlayer.bros[0].getBackground().m.RawDescription
    {
        en = "{Prior to conscription into the army, %name% was a failed, illiterate baker. Poor work and frequent dessert errors made it prone to pull %name% into military ranks. Having always hated the life, the deserter was quick to join your cause and company.}"
        es = "{Antes de su reclutamiento forzoso en el ejército, %name% tenía una panadería ruinosa y no sabía leer ni escribir. El mal trabajo y los frecuentes errores con los postres facilitaron que %name% acabara en las filas militares. Como siempre había odiado esa vida, no tardó en unirse a tu causa y a tu compañía.}"
    }
    // context: deserters_scenario.o.onSpawnPlayer.bros[1].getBackground().m.RawDescription
    {
        // corrige base: «Como un buen luchador» no traduce «A fine fighter by any judgment»: sobra el «Como», que cambia el sentido
        en = "{A fine fighter by any judgment, %name% simply hated the low pay of being a soldier in the army. The pursuit of the sellsword's life makes sense. Though quite flighty, you believe %name%'s transient sense of allegiance will be buffered by a steady flow of good coin.}"
        es = "{A juicio de cualquiera, %name% sabe pelear de maravilla, pero simplemente odiaba el bajo salario de soldado en el ejército. Su búsqueda de la vida de mercenario tiene sentido. Aunque es bastante voluble, crees que su fugaz sentido de la lealtad se verá compensado por un flujo constante de buena moneda.}"
    }
    // context: deserters_scenario.o.onSpawnPlayer.bros[2].getBackground().m.RawDescription
    {
        // corrige base: «No lo hace un cobarde» es calco de «It doesn't make him a coward»; en castellano, «eso no lo convierte en un cobarde»
        en = "{%name% is like many deserters. You can see the spirit of a fighter, but the heart for it is withering. It doesn't make %name% a coward, as many assume deserters to be, but instead simply someone who may need change. Hopefully the coin of mercenary work can provide it.}"
        es = "{%name% es como muchos desertores. Se nota el espíritu de quien sabe luchar, pero las ganas de hacerlo se están marchitando. Eso no convierte a %name% en una persona cobarde, como muchos suponen que son los desertores, sino simplemente en alguien que quizá necesite un cambio. Esperemos que la moneda del trabajo mercenario pueda proporcionárselo.}"
    }
    // context: deserters_scenario.o.onGenerateBro.bro.improveMood()
    {
        en = "Is excited at becoming a deserter"
        es = "Le entusiasma desertar"
    }
    // en = "Always acts first in the very first round of combat"
    // en base_es
    // FILE: mod_legends\hooks\scenarios\world\early_access_scenario.nut
    // en = "A New Company"
    // en base_es
    // en = "[p=c][img]gfx/ui/events/event_80.png[/img][/p][p]After years of bloodying your sword for meager pay, you've saved enough crowns to start your very own mercenary company. With you are three experienced mercenaries with whom you've fought side by side in the shieldwall before.\n\n[color=#bcad8c]A quick start into the world, without any particular advantages or disadvantages.[/color][/p]"
    // en base_es
    // en = "Joined a mercenary company"
    // en base_es
    // en = "\x7bYou saved %name%'s life in a battle against brigands, and he returned the favor in an alley ambush by thieves. Given that common criminals are a few levels beneath brigands, you often joke with him that he is still a little behind on the 'saving each other's asses' debt.\x7d"
    // en base_es
    // en = "\x7bWhatever is wrong with %name% you hope he never fixes it. A character with a particular taste for battling, whoring, gambling, singing, dogfighting, skirt chasing, weirdly dish washing, vomiting and, of course, drinking, he has always been a gift to have around. He also just happens to be an excellent fighter in his own right.\x7d"
    // en base_es
    // en = "You crossed paths with %name% a number of times prior to his joining the company. First time you were both simple laborers. The second time you were sellswords. And now is the third go of it with him joining your company. If all goes well, he'll finally stick around this time and you'll both find the riches you seek."
    // en base_es
    // FILE: mod_legends\hooks\scenarios\world\gladiators_scenario.nut
    // en = "Gladiators"
    // en base_es
    // context: gladiators_scenario.o.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_155.png[/img][/p][p]You've fought in the arenas of the south for years. First for your freedom, then for crowns, and finally to become immortal. What else does fate have in stock for you?\n\n[color=#bcad8c]Gladiators:[/color] Start with three experienced gladiators with good equipment, but very high daily wages.\n[color=#bcad8c]Legends of the Arena:[/color] Each gladiator has a unique trait in combat.\n[color=#bcad8c]Glorious Three:[/color] You can never have more than 16 fighters in your roster, and if all of your three starting men should die, your campaign ends.[/p]"
        es = "[p=c][img]gfx/ui/events/event_155.png[/img][/p][p]Has luchado en las arenas del sur durante años. Primero por tu libertad, luego por coronas y finalmente para volverte inmortal. ¿Qué más tiene el destino en reserva para ti?\n\n[color=#dda21f]Gladiadores:[/color] Comienzas con tres gladiadores experimentados con buen equipo, pero con salarios diarios muy altos.\n[color=#dda21f]Leyendas de la Arena:[/color] Cada gladiador tiene un rasgo único en combate.\n[color=#dda21f]Los Gloriosos Tres:[/color] Nunca puedes tener más de [color=#a22424]16[/color] luchadores en tu lista y si tus tres hombres iniciales mueren, tu campaña termina.[/p]"
    }
    // en = "the Lion"
    // en base_es
    // en = "Eager to prove himself outside the arena"
    // en base_es
    // en = "the Bear"
    // en base_es
    // en = "the Viper"
    // en base_es
    // en = "\x7b%fullname% thinks muscles make for glory. Wrong. Captain, it is I, <bros:str>, who commands the ladies of this realm. Need not ask me how. Behold! Look at it! Look at the size of it! Yeah. That's what I thought. Fools, train all you want, you can't have this!\x7d"
    // en base_es
    // en = "\x7b%fullname% is not the best warrior here, let's be clear. Captain, look at my muscles, is it not I, <bros:str>, who commands the greatest reward of life: the fear of one's own enemies! Look, if I lather a little and catch the light, the muscles gleam. Would it not be that the heavens were mistakened for above, when all the women say they find them right here, particularly here, upon my glorious pecs?\x7d"
    // en base_es
    // en = "\x7bWhy are you looking at %fullname%? Captain, it is I, <bros:str>, who is your greatest gladiator. I am the one who swept the legs of a lindwurm and choked it out with its own tail! What you bastards say? You call that a tall tale? Pah! 'Tis a horizontal lizard at best.\x7d"
    // en base_es
    // en = "\x7b%fullname% is somber about the passing of a good friend, but he looks to the future knowing that he has someone behind him at all times. Behind him in a brotherly way, that is. And spiritually. Brotherly and spiritually, only.\x7d"
    // en base_es
    // en = "\x7bYou should know something, captain. I'm glad you stay out of the fray. I haven't felt this alive in what must be ten years. And if you see me out there about to go down, you stay right where you are, because I'll be right where I want to be.\x7d"
    // en base_es
    // FILE: mod_legends\hooks\scenarios\world\lone_wolf_scenario.nut
    // context: lone_wolf_scenario.o.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_35.png[/img][/p][p]You have been traveling for a long time, taking part in tourneys and sparring with young nobles. A hedge knight as tall as a tree, you never needed anybody for long. Is it true still?\n\n[color=#bcad8c]Lone Wolf:[/color] Start with a single experienced hedge knight with great equipment but low funds. All encounters are two-thirds harder than normal.\n[color=#bcad8c]Elite Few:[/color] Can never have more than 12 fighters in your roster. You may encounter other champions and special allies through events to join your cause.\n[color=#bcad8c]Avatar:[/color] If your lone wolf dies, the campaign ends.\n[color=#c90000]Living Legend:[/color] As your renown grows, the more recruits will be present in towns. Higher renown increases quality of hires, but you will start with being unable to hire anyone.[/p]"
        es = "[p=c][img]gfx/ui/events/event_35.png[/img][/p][p]Llevas mucho tiempo viajando, participando en torneos y entrenando con jóvenes nobles. Caballero errante alto como un árbol, nunca has necesitado a nadie por mucho tiempo. ¿Sigue siendo así?\n\n[color=#dda21f]Lobo solitario:[/color] Comienzas con un único caballero errante experimentado, con un equipo excelente pero pocos fondos. Todos los enfrentamientos son dos tercios más difíciles de lo normal.\n[color=#dda21f]Pocos pero selectos:[/color] Nunca puedes tener más de [color=#a22424]12[/color] luchadores en tu lista. Mediante eventos, puedes encontrar a otros campeones y aliados especiales que se unan a tu causa.\n[color=#dda21f]Avatar:[/color] Si tu lobo solitario muere, la campaña termina.\n[color=#dda21f]Leyenda viviente:[/color] Cuanto más crezca tu renombre, más reclutas habrá en las ciudades. Un mayor renombre aumenta la calidad de las contrataciones, pero al principio no podrás contratar a nadie.[/p]"
    }
    // en = "the Lone Wolf"
    // en base_es
    // en = "squire"
    // en = "butcher"
    // en = "cripple"
    // context: lone_wolf_scenario.o.onUpdateHiringRoster.tier1
    // en = "daytaler"  // identificador interno de trasfondo (background.daytaler), no se muestra
    // en = "miner"
    // en = "minstrel"
    // en = "poacher"
    // en = "lumberjack"
    // en = "apprentice"
    // en = "farmhand"
    // en = "thief"
    // en = "fisherman"
    // en = "flagellant"
    // en = "gambler"
    // en = "ratcatcher"
    // en = "refugee"
    // en = "shepherd"
    // en = "bowyer"
    // context: lone_wolf_scenario.o.onUpdateHiringRoster.tier1
    // en = "vagabond"  // identificador interno de trasfondo (background.vagabond), no se muestra
    // en = "monk"
    // en = "deserter"
    // en = "cultist"
    // en = "houndmaster"
    // en = "juggler"
    // en = "barbarian"
    // en = "bastard"
    // en = "raider"
    // en = "sellsword"
    // en = "swordmaster"
    // en = "gladiator"
    // context: lone_wolf_scenario.o.onUpdateHiringRoster.tier5
    // en = "assassin"  // identificador interno de trasfondo (background.assassin), no se muestra
    // context: lone_wolf_scenario.o.onUpdateHiringRoster.tier5
    // en = "paladin"  // identificador interno de trasfondo (background.paladin), no se muestra
    // context: lone_wolf_scenario.o.onUpdateHiringRoster.short.bgID.find()
    // en = "<bgID.slice(background..len())>"  // ID de trasfondo recortado para comparar con las listas de tier, no se muestra
    // FILE: mod_legends\hooks\scenarios\world\manhunters_scenario.nut
    // context: manhunters_scenario.o.create.m.Description
    {
        // corrige base: «tus filas crecen» por «sus filas crecen»: «their ranks» son las filas de los cautivos
        en = "[p=c][img]gfx/ui/events/event_172.png[/img][/p][p]Constant conflict between city states and nomads makes for good business. The bulk of your outfit are captives, forced to fight to earn their freedom, and their ranks grow after each battle.\n\n[color=#bcad8c]Army of Captives:[/color] Start with two manhunters and four indebted. Take up to 16 men into battle at once. Having equal or fewer indebted than non-indebted will make your men dissatisfied.\n[color=#bcad8c]Overseers:[/color] All non-indebted can whip indebted in combat to reset their morale and buff their stats.\n[color=#bcad8c]Captives:[/color] Indebted earn 10% more experience, are capped at level 7, and will die if struck down. However, they are 50% cheaper to buy in towns.[/p]"
        es = "[p=c][img]gfx/ui/events/event_172.png[/img][/p][p]El constante conflicto entre las ciudades-estado y los nómadas es un buen negocio. La mayoría de tu grupo son cautivos, obligados a luchar para ganar su libertad, y sus filas crecen después de cada batalla.\n\n[color=#dda21f]Ejército de cautivos:[/color] Comienza con dos cazadores de hombres y cuatro endeudados. Puedes llevar hasta [color=#1e861e]16[/color] hombres a la batalla al mismo tiempo. Tener igual o menos endeudados que hombres libres hará que tus hombres estén insatisfechos.\n[color=#dda21f]Supervisores:[/color] Todos los no endeudados pueden azotar a los endeudados en combate para restablecer su moral y mejorar sus estadísticas.\n[color=#dda21f]Cautivos:[/color] Los endeudados ganan un [color=#1e861e]10%[/color] más de experiencia, tienen un límite de nivel [color=#a22424]7[/color] y morirán si son derribados en combate. Sin embargo, comprarlos en las ciudades cuesta un [color=#1e861e]50%[/color] menos.[/p]"
    }
    // en = "the Stoic"
    // en base_es
    // en = "\x7bIn a sense, you don't particularly care for %name%. He's not hateful nor forgiving toward the prisoners of war, criminals, and the like. He just handles his business. But he's also this calm, unwavering way with you, and it's a bit bothersome. The man has so much potential, which is why you have him onboard for the %companyname%, but you just wished he showed some passion now and again.\x7d"
    // en base_es
    // en = "the Whip"
    // en base_es
    // en = "\x7b%name% is one of the worst people you have ever come to know. He is relentlessly brutal on the indebted, even by your measure, and is responsible for outright killing a few of your catches. That said, his mean streak will serve the company well. And given that you've already whipped him a time or three for losing inventory, you know he can take a hit as well as he can give it.\x7d"
    // en base_es
    // en = "Annoyed by your recent reprimand not to mistreat your captives"
    // en base_es
    // en = "the Learned"
    // en base_es
    // en = "\x7bYou found %name% being lawed by city guards. It looked like they were gonna play a game of 'catch the scimitar' with his wrists until you intervened, opining that he owed the Gilder far before he owed any man. You hoped to offload him to high-paying Viziers, but none would take him as he was too 'learned' and seemed the exact sort of threat to spur an uprising. Unusual to a man of his standing, he does harbor a fair bit of respect for you.\x7d"
    // en base_es
    // en = "Misses his books"
    // en base_es
    // en = "the Northerner"
    // en base_es
    // en = "\x7bNot a friendly man by any means, but that's what the shackles are for. %name% was on the chopping block for a series of crimes when you happened upon him. You paid for his life as an investment, stating that he now owed hard work to find salvation in the Gilder's eyes. He's not so sure of your earnest beliefs, but you paid a priest to confirm that the man indeed owes his sweat to a higher sublimity.\x7d"
    // en base_es
    // en = "Almost got executed"
    // en base_es
    // en = "Relieved that he escaped execution"
    // en base_es
    // en = "Worried about what awaits him next"
    // en base_es
    // en = "the Deserter"
    // en base_es
    // en = "\x7b%name% is an heirloom of heresy, a man gifted to you by one of the Vizier's priests. The man was a deserter in the high lord's army, but through wealthy connections managed to avoid execution. However, there's only one way to avoid the fire of the hells, and that is through indebted gratitude. He will work for you until he finds salvation, and when that happens is entirely up to you.\x7d"
    // en base_es
    // en = "Feels cursed to have deserted one army only to end up an indebted in another"
    // en base_es
    // en = "the Beggar"
    // en base_es
    // en = "\x7bFound on the streets, %name% never stood much of a chance. Being a beggar, it was physically easy to slap the chains on him, and socially no one would care. The Gilder cares not for those who do not work, and every day the man squandered without putting in his sweat he accrued a debt. Now it must be paid lest he taste that desert fire for eternity. He's actually healthier looking now than when you found him, though he never seems to thank you for this.\x7d"
    // en base_es
    // context: manhunters_scenario.o.onGetBackgroundTooltip._tooltip.push().text
    {
        en = "[color=%negative%]-25%[/color] Experience Gain"
        es = "[color=#8f1e1e]-25%[/color] de experiencia ganada"
    }
    // context: manhunters_scenario.o.onGetBackgroundTooltip._tooltip.push().text
    {
        en = "[color=%positive%]+5%[/color] Experience Gain"
        es = "[color=#135213]+5%[/color] de experiencia ganada"
    }
    // context: manhunters_scenario.o.onGetBackgroundTooltip._tooltip.push().text
    {
        en = "[color=%negative%]-10%[/color] Experience Gain"
        es = "[color=#8f1e1e]-10%[/color] de experiencia ganada"
    }
    // context: manhunters_scenario.o.onGetBackgroundTooltip._tooltip.push().text
    {
        en = "[color=%positive%]+10%[/color] Experience Gain"
        es = "[color=#135213]+10%[/color] de experiencia ganada"
    }
    // en = "Limited to character level 7"
    // en base_es
    // en = "Is permanently dead if struck down and will not survive with a permanent injury"
    // en base_es
    // FILE: mod_legends\hooks\scenarios\world\militia_scenario.nut
    // en = "Peasant Militia"
    // en base_es
    // context: militia_scenario.o.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_141.png[/img][/p][p]It started as a ragtag militia made up of anyone brave or desperate enough to volunteer for defending their homes, but has grown into a small army. An army that needs to be fed each day. \n[color=#bcad8c]Peasant Army:[/color] Start with a roster of 12 poorly equipped peasants.\n[color=#bcad8c]Human Wave:[/color] Take up to [color=#c90000]22[/color] men into battle at once, with no need to build renown.\n[color=#bcad8c]Dirty Peasants:[/color] Can only hire lowborn peasants, lose reputation with nobles faster. \n[color=#c90000]Reduced scaling:[/color] Each member of your company only counts for two thirds of a person in scaling. \n[color=#c90000]Class warfare:[/color] Each person you hire gains a hatred of nobles[/p]"
        es = "[p=c][img]gfx/ui/events/event_141.png[/img][/p][p]Empezó como una milicia variopinta formada por cualquiera lo bastante valiente o desesperado para ofrecerse a defender su hogar, pero se ha convertido en un pequeño ejército. Un ejército que hay que alimentar cada día. \n[color=#dda21f]Ejército campesino:[/color] Comienzas con una lista de 12 campesinos mal equipados.\n[color=#dda21f]Oleada humana:[/color] Puedes llevar hasta [color=#1e861e]22[/color] hombres a la batalla al mismo tiempo, sin necesidad de ganar renombre.\n[color=#dda21f]Campesinos sucios:[/color] Solo puedes contratar campesinos de baja cuna, y pierdes reputación con los nobles más rápido. \n[color=#dda21f]Escalado reducido:[/color] Cada miembro de tu compañía cuenta solo como dos tercios de una persona a efectos de escalado. \n[color=#dda21f]Guerra de clases:[/color] Cada persona que contrates desarrolla odio hacia los nobles[/p]"
    }
    // en = "Lost many a friend in battle"
    // en base_es
    // en = "Part of a militia"
    // en base_es
    // context: militia_scenario.o.onSpawnAssets.bros[0].getBackground().m.RawDescription
    {
        en = "%name% is a farmer's child, and presumably wishes to have a child of their own at some point. For now, they are with you — which is quite a regrettable clash between dreams and reality."
        es = "%name% viene de una familia granjera y presumiblemente desea tener descendencia en algún momento. Por ahora, está contigo, lo que representa un lamentable choque entre sus sueños y la realidad."
    }
    // en = "Has recently fallen in love"
    // en base_es
    // context: militia_scenario.o.onSpawnAssets.bros[1].getBackground().m.RawDescription
    {
        en = "%name% owned a farmstead that has long since gone underfoot of countless passing armies, including the very ones they've fought for. Their 'allegiance' to you is arguably the result of an empty belly more than anything."
        es = "%name% tenía una granja que hace tiempo quedó pisoteada por incontables ejércitos de paso, incluidos aquellos por los que luchó. Su 'lealtad' hacia ti es, posiblemente, fruto de un estómago vacío más que de cualquier otra cosa."
    }
    // en = "Was involved in a brawl"
    // en base_es
    // context: militia_scenario.o.onSpawnAssets.bros[2].getBackground().m.RawDescription
    {
        en = "It is a common joke that %name% is in fact a noble hiding away from the world, but to the best of your knowledge they were a simple poacher. The grind of the world got them to where they are today, not much else need be said other than you hope they gets back on their feet."
        es = "Es una broma común que %name% sea en realidad de noble cuna y se esconda del mundo, pero, hasta donde sabes, se dedicaba simplemente a la caza furtiva. Las dificultades de la vida han llevado a %name% hasta donde está hoy, y no hay mucho más que decir, salvo que esperas que vuelva a levantar cabeza."
    }
    // context: militia_scenario.o.onSpawnAssets.bros[3].getBackground().m.RawDescription
    {
        en = "You notice that %name% hides from certain noblemen. It is likely that they are a common criminal at large for some petty crime, but so long as they fight well it is no business to you."
        es = "Notas que %name% se esconde de ciertos nobles. Es probable que se le busque por algún delito menor, como a tantos delincuentes comunes, pero mientras luche bien, eso no es asunto tuyo."
    }
    // en = "Stole someone's scramasax"
    // en base_es
    // context: militia_scenario.o.onSpawnAssets.bros[4].getBackground().m.RawDescription
    {
        en = "A daytaler and common laborer, %name% would rather join your outfit than go back to wasting their body building some nobleman's new fancy foyer."
        es = "Tras años de jornales y trabajo duro, %name% prefiere unirse a tu grupo antes que volver a malgastar su cuerpo construyendo la elegante entrada nueva de algún noble."
    }
    // context: militia_scenario.o.onSpawnAssets.bros[5].getBackground().m.RawDescription
    {
        // corrige base: «actividades en las cuales no era bueno especialmente en ninguna» es agramatical (doble «en»); mejor «en ninguna de las cuales destacaba especialmente»
        en = "Seeking riches, %name% has come to the right place in your newfound mercenary band. Unfortunately, their background is in farming, milling, and laying stone, particularly none of which they were any good at."
        es = "Buscando riquezas, %name% ha llegado al lugar adecuado en tu recién formada banda de mercenarios. Desafortunadamente, su experiencia se encuentra en la agricultura, la molienda y la colocación de piedra, actividades en ninguna de las cuales destacaba especialmente."
    }
    // en = "Looks forward to becoming rich as a sellsword"
    // en base_es
    // context: militia_scenario.o.onSpawnAssets.bros[6].getBackground().m.RawDescription
    {
        en = "%name% states they were a sailor prior to coming inland and falling in with the militia and now your mercenary band. They hope to eventually own a boat and put its sails to the open ocean. You hope they can do that someday, truly."
        es = "%name% asegura que se ganaba la vida en el mar antes de venir tierra adentro y acabar en la milicia, y ahora en tu banda de mercenarios. Espera llegar a tener un barco y desplegar sus velas en mar abierto. De verdad esperas que algún día lo consiga."
    }
    // en = "Feels somewhat sickly of late"
    // en base_es
    // context: militia_scenario.o.onSpawnAssets.bros[7].getBackground().m.RawDescription
    {
        // corrige base: añade texto que el inglés no tiene («REALMENTE» y la frase «Después de todo, ese hijo no va a mantenerse solo.»)
        en = "%name% has apparently been in many militias, all of which eventually dissolved for one reason or another. At no point have they made any money in any of them, so they hope to changes that with this whole new sellswording schtick."
        es = "Por lo visto, %name% ha estado en muchas milicias, todas las cuales se disolvieron por una razón u otra. En ningún momento ha ganado dinero en ninguna de ellas, así que espera cambiar eso con todo este nuevo asunto de vender su espada."
    }
    // context: militia_scenario.o.onSpawnAssets.bros[7].improveMood()
    {
        en = "Has recently become a parent"
        es = "Ha tenido un bebé hace poco"
    }
    // context: militia_scenario.o.onSpawnAssets.bros[8].getBackground().m.RawDescription
    {
        en = "%name% enjoys carousing ladies at the pub and chasing skirt in the church. You get the sense they've only tagged along to spread their sense of 'fun' around the world."
        es = "A %name% le gusta ir de juerga con damas en la taberna y perseguir faldas en la iglesia. Te da la sensación de que solo se ha sumado para repartir su idea de la 'diversión' por el mundo."
    }
    // context: militia_scenario.o.onSpawnAssets.bros[9].getBackground().m.RawDescription
    {
        en = "Daytaler, laborer, caravan hand, sailor, militia, %name%'s done a bit of it all. Hopefully this new foray into mercenary work will stick for them."
        es = "Jornales, obras, caravanas, el mar, la milicia: %name% ha hecho un poco de todo. Esperemos que esta nueva incursión en el trabajo mercenario le funcione."
    }
    // context: militia_scenario.o.onSpawnAssets.bros[9].worsenMood()
    {
        en = "Had their trusty scramasax stolen"
        es = "Le robaron su fiel scramasax"
    }
    // context: militia_scenario.o.onSpawnAssets.bros[10].getBackground().m.RawDescription
    {
        en = "Like yourself, %name% was fed up with militias being overused to solve the crises of unprepared nobles. They were arguably the most earnest of the fighters in joining the transition to mercenary work."
        es = "Igual que a ti, a %name% le hartaba que se abusara de las milicias para resolver las crisis de nobles mal preparados. Fue, posiblemente, quien con más sinceridad se sumó a la transición al trabajo mercenario."
    }
    // en = "Disliked that some members of the militia were involved in a brawl"
    // en base_es
    // context: militia_scenario.o.onSpawnAssets.bros[11].getBackground().m.RawDescription
    {
        // corrige base: «aparentemente» traduce «seemingly», no «ostensibly»; aquí «según dice»
        // corrige base: «otro soldado» suaviza «another body»; se restituye «otro cuerpo»
        // corrige base: «Esa mujer» rebaja el despectivo «wench»; se usa «esa arpía»
        en = "%name% is, ostensibly, running away from their other half. You met them once and approve their escape plan entirely, and not just because it affords you another body on the front line — that wench is genuinely crazy."
        es = "%name% está, según dice, huyendo de su media naranja. La conociste una vez y apruebas por completo su plan de fuga, y no solo porque te brinde otro cuerpo en primera línea: esa arpía está loca de verdad."
    }
    // context: militia_scenario.o.onSpawnAssets.bros[11].improveMood()
    {
        en = "Managed to get away from their family"
        es = "Logró alejarse de su familia"
    }
    // en = "Considered local heroes for keeping the village safe"
    // en base_es
    // FILE: mod_legends\hooks\scenarios\world\paladins_scenario.nut
    // en = "Oathtakers"
    // en base_es
    // en = "[p=c][img]gfx/ui/events/event_180.png[/img][/p][p]Oathtakers are knightly warriors beholden not to liege lords, but to the ideals and teachings of their founder, Young Anselm. The order now finds itself in dire straits, and they've turned to you to reverse their fortunes. Can you teach these zealots to become successful mercenaries?\n\n[color=#bcad8c]Paladins:[/color] Start with two battle-hardened warriors and good equipment.\n[color=#bcad8c]Oathtakers:[/color] Sworn to Young Anselm's teachings, you must take oaths that confer various advantages and disadvantages until fulfilled.[/p]"
    // en base_es
    // en = "\x7bPerhaps of an age more suitable for caretaking than oathtaking, %name% is a rather old, nigh on decrepit Oathtaker. While age has robbed him of his more natural talents, it has at least gifted him with learning and experience that no physical capabilities can match. He is a man of many spirits, having gone around this world in the shell of soldier, farmer, sellsword, and more. Now he is an Oathtaker, and all those skills and traits he built up over the years has made him quite a formidable one at that. | When First Oathtaker Anselm first met %name%, it is said that the prime paladin divulged details no one else could have possibly known, thus proving the aethereal power behind his beliefs. %name% is an ardent believer in the Oaths, and in seeing Young Anselm's vision through.\x7d"
    // en base_es
    // context: paladins_scenario.o.onSpawnAssets.bros[1].getBackground().m.RawDescription
    {
        en = "{%name%, like many of the Oathtakers' more spry members, strives to be like Young Anselm. A youthful, capable man who has yet to let the world's horrors and grind wear him down. In moments of honesty, he reminds you of yourself. In moments of reflection, you realize that he will likely one day resemble you as you are now. But until then, to the youth of the world, for the Oaths are certainly not wasted upon them! | When Anselm set out on his quest, it was %name% whom joined him first. Despite the Young Anselm's untimely death, %name% still sought to see the young man's vision through. He is an ardent believer in the Oaths and can be frequently found idolizing and commemorating Young Anselm's skull.}"
        es = "{%name%, como muchos de los miembros más briosos de los Juramentados, se esfuerza por ser como el Joven Anselm. Un hombre joven y capaz que aún no ha dejado que los horrores y el desgaste del mundo lo derroten. En momentos de sinceridad, te recuerda a ti mismo. En momentos de reflexión, te das cuenta de que probablemente algún día se parecerá a como eres tú ahora. Pero hasta entonces, a la juventud del mundo, ¡pues los Juramentos ciertamente no se desperdician en ella! | Cuando Anselm emprendió su búsqueda, fue %name% quien se unió a él primero. A pesar de la temprana muerte del Joven Anselm, %name% siguió buscando cumplir la visión del joven. Es un ferviente creyente en los Juramentos y con frecuencia se le puede encontrar idolatrando y conmemorando el cráneo del Joven Anselm.}"
    }
    // FILE: mod_legends\hooks\scenarios\world\raiders_scenario.nut
    // en = "Northern Raiders"
    // en base_es
    // context: raiders_scenario.o.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_135.png[/img][/p][p]For all your adult life you have been raiding and pillaging in these lands. But with the local peasantry poor as mice, you may want to finally expand into the profitable field of mercenary work - that is, if your potential employers are willing to forgive your past transgressions.\n[color=#bcad8c]Warband:[/color] Start with three experienced barbarians, and increased chance of finding [color=#c90000]bloodthirsty brutes, barbarians, killers and assassins[/color].\n[color=#bcad8c]Pillagers:[/color] [color=%positive%]15%[/color] chance to get any items from slain enemies, that might not otherwise be available to loot.\n[color=#bcad8c]Outlaws:[/color] Start with [color=#c90000]perks for hunting civilians[/color], bad relations to most human factions, only other outlaws are keen to work for you.[/p]"
        es = "[p=c][img]gfx/ui/events/event_135.png[/img][/p][p]Llevas toda tu vida adulta asaltando y saqueando estas tierras. Pero, con el campesinado local más pobre que las ratas, quizá quieras expandirte por fin al lucrativo terreno del trabajo mercenario, siempre que tus posibles empleadores estén dispuestos a perdonar tus faltas pasadas.\n[color=#dda21f]Banda de guerra:[/color] Comienzas con tres bárbaros experimentados y mayor probabilidad de encontrar [color=#dda21f]brutos sanguinarios, bárbaros, asesinos y sicarios[/color].\n[color=#dda21f]Saqueadores:[/color] [color=#1e861e]15%[/color] de probabilidad de obtener cualquier objeto de los enemigos abatidos, aunque de otro modo no pudiera saquearse.\n[color=#dda21f]Proscritos:[/color] Comienzas con [color=#dda21f]ventajas para cazar civiles[/color] y malas relaciones con la mayoría de las facciones humanas; solo otros proscritos están dispuestos a trabajar para ti.[/p]"
    }
    // context: raiders_scenario.o.onSpawnAssets.bros[0].getBackground().m.RawDescription
    {
        en = "A sturdy warrior, %name% has been through many campaigns of raiding and pillaging. Although a %person% of few words, the raider is an absolutely vicious specimen in battle. Even for a raider, what %they% does to defeated villagers irks many. It is likely %they% came with you to satiate %their% more sadistic lusts."
        es = "Guerrer%o% robust%o%, %name% ha participado en muchas campañas de saqueo y pillaje. Aunque es %un% %hombre% de pocas palabras, es un espécimen absolutamente feroz en la batalla. Incluso para alguien que vive del saqueo, lo que hace con los aldeanos derrotados disgusta a muchos. Es probable que se haya unido a ti para saciar sus deseos más sádicos."
    }
    // en = "Had a successful raid"
    // en base_es
    // en = "Fenrir the Warhound"
    // en base_es
    // context: raiders_scenario.o.onSpawnAssets.bros[1].getBackground().m.RawDescription
    {
        en = "%name% was a %child% when taken from a southern village and raised amongst the barbarians of the wastes. While %they% learned the language and culture, %they% never fit in and was a constant victim of cruel jokes and games. You are not sure if %they% has followed you to return home or to get away from %their% northern 'family'."
        es = "%name% era niñ%o% cuando %lo% raptaron de una aldea sureña y %lo% criaron entre los bárbaros de los yermos. Aunque aprendió su lengua y su cultura, nunca encajó y fue víctima constante de bromas y juegos crueles. No sabes si te ha seguido para volver a casa o para alejarse de su 'familia' norteña."
    }
    // context: raiders_scenario.o.onSpawnAssets.bros[2].getBackground().m.RawDescription
    {
        en = "Barbarian raiders often take from lands foreign to them. Most see their raids as a matter of material and women, but occasionally they will enslave formidable boys with great potential. %name%, a northerner, was such a child and %they% was raised to be a raider %themselves%. Half %their% life was with %their% primitive clan, and the other half with those who took %them%. This has made %them% as hardy and brutish a warrior as one can get."
        es = "Los saqueadores bárbaros suelen saquear tierras que les son ajenas. La mayoría ve sus incursiones como una cuestión de bienes y mujeres, pero de vez en cuando esclavizan a niños formidables con gran potencial. %name%, norteñ%o% de nacimiento, fue una de esas criaturas, y %lo% criaron para que se dedicara al saqueo como ellos. Pasó la mitad de su vida con su clan primitivo, y la otra mitad con quienes %lo% raptaron. Eso %lo% ha convertido en %un% guerrer%o% tan dur%o% y brutal como pocos."
    }
    // context: raiders_scenario.o.onSpawnAssets.bros[3].getBackground().m.RawDescription
    {
        // corrige base: «El hombre que te puso en este camino, crees que...» es un anacoluto calcado del inglés; se reordena la frase
        en = "The man who put you on the path, you believe %name% may serve some greater role to your attaining immense treasures. You have seen northern gimps and one-armed men who would best %them% in combat, but %their% knowledge and intelligence may be sharper blades in good time."
        es = "Fue quien te puso en este camino, y crees que %name% puede desempeñar un papel importante en tu búsqueda de inmensos tesoros. Has visto a lisiados norteños y a mancos capaces de vencer%lo% en combate, pero su saber y su inteligencia pueden acabar siendo armas más afiladas con el tiempo."
    }
    // en = "Thinks he managed to convince you to give up raiding and pillaging"
    // en base_es
    // en = "You are considered outlaws and barbarians"
    // en base_es
    // context: raiders_scenario.o.onHiredByScenario._bro.worsenMood()
    {
        en = "Is uncomfortable with joining raiders"
        es = "Le incomoda unirse a unos saqueadores"
    }
    // context: raiders_scenario.o.onHiredByScenario._bro.improveMood()
    {
        en = "Is excited at becoming a raider"
        es = "Le entusiasma dedicarse al saqueo"
    }
    // FILE: mod_legends\hooks\scenarios\world\random_scenario.nut
    // context: random_scenario.o.create.m.Description
    {
        // corrige base: «¡Que emocionante!» por «¡Qué emocionante!» (exclamativo con tilde)
        en = "[p=c][img]gfx/ui/events/event_74.png[/img][/p][p]Start a campaign with a randomly picked origin. How exciting![/p] [p]Tip: move the scroll bar slowly to view all scenarios[/p]"
        es = "[p=c][img]gfx/ui/events/event_74.png[/img][/p][p]Comienza una campaña con un origen elegido al azar. ¡Qué emocionante![/p] [p]Consejo: mueve la barra de desplazamiento despacio para ver todos los escenarios[/p]"
    }
    // FILE: mod_legends\hooks\scenarios\world\rangers_scenario.nut
    // en = "Band of Poachers"
    // en base_es
    // context: rangers_scenario.o.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_10.png[/img][/p][p]For years you have made a decent living by poaching in the local woods, evading your lord's men by being quick on your feet. But pickings have become slimmer and slimmer, and you are faced with a decision - how to make a living when all you know is how to use a bow?\n\n[color=#bcad8c]Hunters:[/color] Start with a group of three woodsmen.\n[color=#bcad8c]Expert Scouts:[/color] You move faster and can always get a scouting report for any enemies near you.\n[color=#bcad8c]Travel Light:[/color] You can carry fewer items in your company's inventory.[/p]"
        es = "[p=c][img]gfx/ui/events/event_10.png[/img][/p][p]Durante años te has ganado la vida cazando furtivamente en los bosques de la zona, esquivando a los hombres de tu señor con tus pies ligeros. Pero las presas escasean cada vez más y toca decidir: ¿cómo ganarse la vida si solo sabes usar un arco?\n\n[color=#dda21f]Cazadores:[/color] Empiezas con tres moradores del bosque.\n[color=#dda21f]Exploradores expertos:[/color] Te mueves más rápido y siempre obtienes un informe de exploración de los enemigos cercanos.\n[color=#dda21f]Viajar liviano:[/color] Puedes llevar menos objetos en el inventario de tu compañía.[/p]"
    }
    // context: rangers_scenario.o.onSpawnAssets.bros[0].getBackground().m.RawDescription
    {
        en = "{A bit of a devious runt, though a good person at heart. %name% used to hunt for the local liege, but when the nobleman died falling into an unseen ravine the hunter was blamed and kicked out of court. With some guile, %name% turned hunting talents into poaching and fur trade. Has a merchant's mind and was quick to engender the idea of mercenary work because of it.}"
        es = "{Tiene algo de alimaña retorcida, aunque en el fondo es buena persona. %name% cazaba para el señor local, pero cuando el noble murió al caer por un barranco oculto, le echaron la culpa y tuvo que abandonar la corte. Con cierta astucia, %name% convirtió su maña para la caza en caza furtiva y comercio de pieles. Tiene mente de mercader, y por eso no tardó en concebir la idea del trabajo mercenario.}"
    }
    // context: rangers_scenario.o.onSpawnAssets.bros[1].getBackground().m.RawDescription
    {
        // corrige base: «fue rápido en nominarte» calca «was quick to nominate you»; en castellano, «no tardó en proponerte»
        en = "{%name% fell into poaching after a drought ravaged the personal farmstead. Like most poachers, %name% is not truly of the criminal mind. Long grouped together in the hunting gangs, the poacher was quick to nominate you as captain of the new sellsword outfit.}"
        es = "{%name% se dedicó a la caza furtiva después de que una sequía arruinara su granja. Como la mayoría de quienes cazan furtivamente, %name% no tiene realmente mentalidad criminal. Tras pasar mucho tiempo en bandas de cazadores, no tardó en proponerte como capitán del nuevo grupo de mercenarios.}"
    }
    // context: rangers_scenario.o.onSpawnAssets.bros[2].getBackground().m.RawDescription
    {
        en = "{A former jester whose gag was to shoot three water jugs out of the sky. You do not know how %name% got into poaching and you sense bitterness about some jester-related drama, but an excellent archer nonetheless. Likes to pretend being a far better shot than you. Nonsense, of course.}"
        es = "{Antes se dedicaba a la bufonería, y su número consistía en derribar en el aire tres jarras de agua a flechazos. No sabes cómo acabó %name% en la caza furtiva y notas cierto rencor por algún drama de bufones, pero aun así tiene una puntería excelente con el arco. Le gusta fingir que dispara mucho mejor que tú. Tonterías, claro.}"
    }
    // en = "Heard rumors of you poaching in their woods"
    // en base_es
    // FILE: mod_legends\hooks\scenarios\world\southern_quickstart_scenario.nut
    // en = "Southern Mercenaries"
    // en base_es
    // context: southern_quickstart_scenario.o.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_156.png[/img][/p][p]You and your small band of mercenaries have done the dirty work of small-time merchants for years, yet you are barely a step above brigands. You want to be bigger than that. You want it all. And the Gilder will reveal the way to you.\n\n[color=#bcad8c]A quick start into the southern part of the world, without any particular advantages or disadvantages.[/color][/p]"
        es = "[p=c][img]gfx/ui/events/event_156.png[/img][/p][p]Con tu pequeña banda de mercenarios, has realizado el trabajo sucio para comerciantes de poca monta durante años, pero apenas estás un paso por encima de los bandidos. Quieres ser más que eso. Quieres tenerlo todo. Y el Dorado te revelará el camino.\n\n[color=#dda21f]Un inicio rápido en la parte sur del mundo, sin ventajas o desventajas especiales.[/color][/p]"
    }
    // context: southern_quickstart_scenario.o.onSpawnAssets.bros[0].getBackground().m.RawDescription
    {
        en = "{%name% was once in a Vizier's elite vanguard. A pitched battle saw the entire legion annihilated and %name% buried beneath their bodies. Abandoned to the desert, %name% survived by means that even to this day shall not be told. But the unerring loyalty to you speaks more than any war story ever could.}"
        es = "{%name% formó parte en su día de la vanguardia de élite de un visir. Una batalla campal aniquiló a toda la legión y dejó a %name% bajo una montaña de cadáveres. A merced del desierto, %name% sobrevivió por medios que ni siquiera hoy se contarán. Pero su inquebrantable lealtad hacia ti dice más de lo que podría decir cualquier historia de guerra.}"
    }
    // context: southern_quickstart_scenario.o.onSpawnAssets.bros[1].getBackground().m.RawDescription
    {
        en = "{If loyalty was gold, this might be the wealthiest person to stand beneath the Gilder's eye. You found %name% being ambushed in an alley and promptly fought off the thieves. The southerner swore allegiance to you for one year. And it has been many since. Despite a lousy first fighting impression, %name% is a formidable warrior when not getting bushwhacked.}"
        es = "{Si la lealtad fuera oro, esta sería quizá la persona más rica bajo la mirada del Dorado. Encontraste a %name% sufriendo una emboscada en un callejón y no dudaste en espantar a los ladrones. Te juró lealtad durante un año. Y desde entonces han pasado muchos. Pese a la pésima primera impresión en combate, %name% es formidable con las armas cuando no le tienden una emboscada.}"
    }
    // context: southern_quickstart_scenario.o.onSpawnAssets.bros[2].getBackground().m.RawDescription
    {
        en = "{You are not entirely sure of %name%'s past, only that the path traveled has not had as much shine as one would hope. %name% has attempted to live many lives, but the army said no, the city guard refused and the brothels closed their doors shut. A life as a Crownling it is then. %name% thinks a glorious and hastened death will mean a faster trip to the Gilder's eye so the two of them can discuss why exactly the life lived was so troublesome. When the southerner is not moping about, %name% can be cheerful and funny. Just keep the mercenary away from drinks and priests.}"
        es = "{No conoces del todo el pasado de %name%; solo sabes que el camino recorrido no ha brillado tanto como cabría esperar. %name% ha intentado vivir muchas vidas, pero el ejército dijo que no, la guardia de la ciudad se negó y los burdeles le cerraron las puertas en las narices. Así que le toca la vida de cuentacoronas. %name% cree que una muerte gloriosa y precipitada supondrá un viaje más rápido ante la mirada del Dorado, para que los dos puedan discutir por qué exactamente su vida fue tan complicada. Cuando no anda lamentándose, %name% tiene buen humor y gracia. Eso sí, que no se acerque a la bebida ni a los sacerdotes.}"
    }
    // FILE: mod_legends\hooks\scenarios\world\trader_scenario.nut
    // context: trader_scenario.o.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_41.png[/img][/p]You are running a small trading caravan and have most of your crowns invested into trading goods. But the roads have become dangerous - brigands and greenskins lay in ambush, and there are rumors of even worse things out there.\n\n [color=#bcad8c]Not a Warrior:[/color] Start with no renown, every non-combat recruit gains the Peaceable perk. Professional soldiers will cost 25% more and have a high chance of having additional bad traits and be less eager to stick around if things get tough. Cannot recruit outlaws.\n [color=#bcad8c]Avatar:[/color] Start with a cunning and wealthy merchant, the caravan will be dissolved if they die.\n [color=#bcad8c]Bribery:[/color] Pay off human enemies instead of fighting them. Peddlers cost 25% less.\n\n"
        es = "[p=c][img]gfx/ui/events/event_41.png[/img][/p]Diriges una pequeña caravana comercial y tienes la mayor parte de tus coronas invertidas en mercancías. Pero los caminos se han vuelto peligrosos: bandidos y pieles verdes acechan emboscados, y se rumorea que ahí fuera hay cosas aún peores.\n\n [color=#dda21f]No eres un guerrero:[/color] Comienzas sin renombre y cada recluta no combatiente obtiene la ventaja Pacífico. Los soldados profesionales cuestan un [color=#a22424]25%[/color] más, tienen muchas probabilidades de tener rasgos negativos adicionales y estarán menos dispuestos a quedarse si las cosas se ponen difíciles. No puedes reclutar proscritos.\n [color=#dda21f]Avatar:[/color] Comienzas con una figura mercantil de gran astucia y fortuna; si muere, la caravana se disolverá.\n [color=#dda21f]Soborno:[/color] Paga a los enemigos humanos en lugar de luchar contra ellos. Los vendedores ambulantes cuestan un [color=#1e861e]25%[/color] menos.\n\n"
    }
    // en = "Encountered another caravan slaughtered by greenskins"
    // en base_es
    // context: trader_scenario.o.onSpawnAssets.bros[1].getBackground().m.RawDescription
    {
        en = "You found %name% being thrown out of a pub and at first glance thought that was little more than a drunken miscreant. But you watched as off three would-be muggers were soon on the ground. They still managed to take off with a coin purse in the end, sure, but they could not truly defeat %name%. Impressed, you took the newly-impoverished fighter on as a caravan hand."
        es = "Viste cómo echaban a %name% de una taberna y, a primera vista, pensaste que no era más que una sabandija borracha. Pero luego viste cómo tres aspirantes a atracadores acababan pronto en el suelo. Al final lograron escapar con una bolsa de monedas, sí, pero no consiguieron vencer de verdad a %name%. Te causó tal impresión que contrataste a %name%, ahora con los bolsillos vacíos, como ayudante de caravana."
    }
    // context: trader_scenario.o.onHiredByScenario._bro.worsenMood()
    {
        en = "Unhappy they will need to do all the fighting"
        es = "Le disgusta tener que encargarse de toda la lucha"
    }
    // context: trader_scenario.o.onHiredByScenario._bro.improveMood()
    {
        en = "Glad to be out of the fighting line"
        es = "Le alegra estar fuera de la línea de batalla"
    }
    // FILE: mod_legends\hooks\scenarios\world\tutorial_scenario.nut
    // context: tutorial_scenario.o.create.m.Name
    {
        en = "(Tutorial)"
        es = "(Tutorial)"
    }
    // en = "[p=c][img]gfx/ui/events/event_21.png[/img][/p][p]You are second-in-command in a mercenary company that has been tracking a brigand named Hoggart for some time now. An unexpected turn of events leaves the company in shatters, and you in charge to rebuild it to its former glory.\n\n[color=#bcad8c]Recommended for new players as it includes some helpful guidance in the beginning.[/color][/p]"
    // en base_es
    // en = "Lost most of the company"
    // en base_es
