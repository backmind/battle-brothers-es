        en = "<actor:str>'s <skill:str> completely bypasseses <target:str>'s defenses with great flourish (Chance: <chance:int>, Rolled: <roll:int>)"
        es = "<skill> de <actor> sortea por completo las defensas de <target> con una gran floritura (Probabilidad: <chance>, Tirada: <roll>)"
    }
    // FILE: scripts\skills\effects\legend_fortify_effect.nut
    // context: legend_fortify_effect.create.m.Description
