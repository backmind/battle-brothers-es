    // FILE: scripts\skills\actives\legend_bribe_skill.nut
    // context: legend_bribe_skill.create.m.Description
    {
        en = "Throw coins at an enemy to bribe them away from battle. Only works on humans, more powerful enemies cost more."
        es = "Lanza monedas a un enemigo para sobornarlo y que abandone la batalla. Solo funciona con humanos; los enemigos más poderosos cuestan más."
    }
    // context: legend_bribe_skill.getTooltip.ret.push().text
