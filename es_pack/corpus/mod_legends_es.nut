    }
    // context: legend_scroll_item.::inherit().create.m.Description
    {
        en = "A freshly minted scroll. Could be a masterpiece used to train your mercenaries or gibberish that will be of interest to local scribes."
        es = "Un pergamino recién escrito. Podría ser una obra maestra con la que entrenar a tus mercenarios o un galimatías que interesará a los escribas locales."
    }
    // context: legend_scroll_item.::inherit().getTooltip.result.text
