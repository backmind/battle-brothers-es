    // FILE: scripts\!mods_preload\~legends_finalize.nut
    // context: ::Legends.Popup.connect.m.JSHandle.::UI.connect()
    // en = "MSUPopup"  // identificador del manejador JS de la ventana emergente
    // context: 
    // en = "ERROR: Legends Requires Modding Standards & Utilities (MSU) to function.<br><a style=\"color: lightblue; text-decoration: underline;\"onclick=\"openURL('https://www.nexusmods.com/battlebrothers/mods/479')\">Get MSU from Nexusmods</a>"  // aviso de ~legends_finalize.nut que solo sale si falta MSU; el pack exige MSU y Modern Hooks, así que en ese caso ni Rosetta ni el pack cargan y la traducción no puede aplicarse
    // context: 
    // en = "ERROR: Modding Standards & Utilities v<::MSU.Version> (MSU) Requires Modern Hooks to function.<br><a style=\"color: lightblue; text-decoration: underline;\"onclick=\"openURL('https://www.nexusmods.com/battlebrothers/mods/685')\">Get Modern Hooks from Nexusmods</a>"  // aviso de ~legends_finalize.nut que solo sale si falta Modern Hooks; el pack exige MSU y Modern Hooks, así que en ese caso ni Rosetta ni el pack cargan y la traducción no puede aplicarse
    // FILE: scripts\ambitions\ambitions\legend_have_all_camp_activities_ambition.nut
    // context: legend_have_all_camp_activities_ambition.create.m.ButtonText
    {
        en = "We need to enhance our camping skills. Visit the local towns and learn what you can."
        es = "Necesitamos mejorar el campamento. Visitemos los pueblos y aprendamos."
    }
    // context: legend_have_all_camp_activities_ambition.create.m.UIText
    {
        en = "Learn all camping skills"
        es = "Aprender todas las habilidades de campamento"
    }
    // context: legend_have_all_camp_activities_ambition.create.m.TooltipText
    {
        en = "Discover all camping skills. Visit settlements across the lands to find buildings that perform the required skills. Having learned all camp skills, you will be able to sustain and maintain the company for longer periods without having to visit settlements."
        es = "Descubre todas las habilidades de campamento. Visita asentamientos por todas estas tierras para encontrar edificios donde se practiquen las habilidades necesarias. Cuando hayas aprendido todas las habilidades de campamento, podrás abastecer y mantener a la compañía durante más tiempo sin tener que visitar asentamientos."
    }
    // context: legend_have_all_camp_activities_ambition.create.m.SuccessText
    {
        en = "[img]gfx/ui/events/event_80.png[/img]Having finally learned all the skills required to properly run your company while camped, you feel confident that you will be able to venture further into the wilderness and keep the company running smoothly."
        es = "[img]gfx/ui/events/event_80.png[/img]Ahora que por fin has aprendido todas las habilidades necesarias para llevar como es debido tu compañía en el campamento, confías en poder aventurarte más lejos en tierras salvajes y mantener a la compañía en marcha sin tropiezos."
    }
    // context: legend_have_all_camp_activities_ambition.create.m.SuccessButtonText
    {
        en = "Lets go camping!"
        es = "¡A acampar!"
    }
    // context: legend_have_all_camp_activities_ambition.getTooltipText.ret
    {
        // local ret = this.m.TooltipText + "\n\nSkills we still need to learn.\n";
        mode = "pattern"
        en = "<text:str>\n\nSkills we still need to learn.\n"
        es = "<text:t>\n\nHabilidades que aún nos falta aprender.\n"
    }
    // context: legend_have_all_camp_activities_ambition.getTooltipText.ret
    {
        // ret = ret + "\n- Crafting";
        mode = "pattern"
        en = "<ret:str>\n- Crafting"
        es = "<ret:t>\n- Fabricación"
    }
    // context: legend_have_all_camp_activities_ambition.getTooltipText.ret
    {
        // ret = ret + "\n- Fletching";
        mode = "pattern"
        en = "<ret:str>\n- Fletching"
        es = "<ret:t>\n- Fabricación de flechas"
    }
    // context: legend_have_all_camp_activities_ambition.getTooltipText.ret
    {
        // ret = ret + "\n- Gathering";
        mode = "pattern"
        en = "<ret:str>\n- Gathering"
        es = "<ret:t>\n- Recolección"
    }
    // context: legend_have_all_camp_activities_ambition.getTooltipText.ret
    {
        // ret = ret + "\n- Hunting";
        mode = "pattern"
        en = "<ret:str>\n- Hunting"
        es = "<ret:t>\n- Caza"
    }
    // context: legend_have_all_camp_activities_ambition.getTooltipText.ret
    {
        // ret = ret + "\n- Patrolling";
        mode = "pattern"
        en = "<ret:str>\n- Patrolling"
        es = "<ret:t>\n- Patrullaje"
    }
    // context: legend_have_all_camp_activities_ambition.getTooltipText.ret
    {
        // ret = ret + "\n- Scrapping";
        mode = "pattern"
        en = "<ret:str>\n- Scrapping"
        es = "<ret:t>\n- Desguace"
    }
    // context: legend_have_all_camp_activities_ambition.getTooltipText.ret
    {
        // ret = ret + "\n- Training";
        mode = "pattern"
        en = "<ret:str>\n- Training"
        es = "<ret:t>\n- Entrenamiento"
    }
    // context: legend_have_all_camp_activities_ambition.getTooltipText.ret
    {
        // La regla genérica del base "<ret:str>\n- <name:line>" (clave "-") se carga antes y tapa
        // las reglas "<ret:str>\n- X" de Legends, dejando el último renglón en inglés. Esta regla tiene
        // una clave que aparece antes del primer guion, parte la cadena por "\n- " y traduce cada trozo
        // con su par.
        split = "\n- "
        en = "<text:str>\n\nSkills we still need to learn.\n<list:str>"
        es = "<text>\n\nHabilidades que aún nos falta aprender.\n<list>"
    }
    // context: legend_have_all_camp_activities_ambition.getTooltipText.ret
    {
        en = "Gathering"
        es = "Recolección"
    }
    // context: legend_have_all_camp_activities_ambition.getTooltipText.ret
    {
        en = "Scrapping"
        es = "Desguace"
    }
    // FILE: scripts\ambitions\ambitions\legend_roster_of_6_ambition.nut
    // context: legend_roster_of_6_ambition.create.m.ButtonText
    {
        en = "We shall get the company strength back to a half dozen men! It will make us\na formidable force again and will allow us to take on more profitable work."
        es = "¡Volveremos a ser media docena de hombres! Eso nos hará de nuevo\nuna fuerza formidable y nos permitirá aceptar trabajos más provechosos."
    }
    // context: legend_roster_of_6_ambition.create.m.UIText
    {
        en = "Have a roster of at least 6 men"
        es = "Tener una plantilla de al menos [color=#bcad8c]6[/color] hombres"
    }
    // context: legend_roster_of_6_ambition.create.m.TooltipText
    {
        en = "Hire enough men to have a crew roster of at least 6 men. Visit settlements across the lands to find recruits that suit your needs. Having a fuller roster will allow you to take on more dangerous and better paying contracts."
        es = "Contrata suficientes hombres para tener una plantilla de al menos [color=#1e468f]6[/color] hombres. Visita asentamientos por todas estas tierras para encontrar reclutas que se ajusten a tus necesidades. Una plantilla más completa te permitirá aceptar contratos más peligrosos y mejor pagados."
    }
    // context: legend_roster_of_6_ambition.create.m.SuccessText
    {
        // corrige base: "gritan las palabras con ti" es agramatical; debe ser "gritan la letra contigo".
        // corrige base: "un complemento completo" calca "full complement" y en castellano no significa contingente; mejor "una dotación completa".
        // corrige base: "se hayan instalado para una bebida de celebración" es un calco; mejor "se hayan acomodado para tomar una copa de celebración".
        en = "[img]gfx/ui/events/event_80.png[/img]Having finally gathered the coin and equipment, you manage to assemble a full complement of six able fighters. When next you walk down %currenttown%'s main street, the men break into a full-throated marching song. A few of the townsfolk mutter under their breath about dirty mercenaries taking over the town, but others walk alongside and shout the words with you. %SPEECH_ON%Stand tall, brothers. People can see this is a real mercenary company now, and not a handful of wandering vagabonds.%SPEECH_OFF%%highestexperience_brother% declares.%SPEECH_ON%We trade in strength, and now that our numbers have gone up, so will our price.%SPEECH_OFF%It appears %they_veteranbrother% has the right of it. You notice one particularly fat nobleman sizing up the company as if he already has a task in mind. The %companyname% are now a more formidable force. Once the men have settled in for a celebratory drink, perhaps you should take another stroll through town to see if any more lucrative contracts may be available."
        es = "[img]gfx/ui/events/event_80.png[/img]Habiendo reunido por fin la moneda y el equipo, consigues formar una dotación completa de seis luchadores capaces. Cuando vuelves a recorrer la calle principal de %currenttown%, los hombres rompen a cantar a pleno pulmón una canción de marcha. Algunos lugareños murmuran entre dientes sobre mercenarios sucios apoderándose de la ciudad, pero otros caminan junto a ti y gritan la letra contigo. %SPEECH_ON%En pie, hermanos. La gente puede ver que esto es ahora una compañía mercenaria de verdad, y no un puñado de vagabundos errantes.%SPEECH_OFF%declara %highestexperience_brother%.%SPEECH_ON%Comerciamos con fuerza, y ahora que nuestro número ha crecido, también lo hará nuestro precio.%SPEECH_OFF%Parece que tiene razón. Notas a un noble particularmente gordo midiendo a la compañía como si ya tuviera una tarea en mente. La %companyname% es ahora una fuerza más formidable. Una vez que los hombres se hayan acomodado para tomar una copa de celebración, quizás deberías dar otro paseo por la ciudad para ver si hay contratos más lucrativos disponibles."
    }
    // en = "We're getting there."
    // en base_es
    // FILE: scripts\contracts\contracts\legend_bandit_army_contract.nut
    // context: legend_bandit_army_contract.create.m.Name
    {
        en = "King of Knives (Legendary)"
        es = "El Rey de los Cuchillos (Legendario)"
    }
    // context: legend_bandit_army_contract.create.m.DescriptionTemplates
    {
        en = "Fearful talk abounds that all the brigand gangs have united under a dangerous new leader. Even the farkin' nobility look worried."
        es = "Abundan los rumores temerosos de que todas las bandas de bandidos se han unido bajo un nuevo y peligroso líder. Hasta la jodida nobleza parece preocupada."
    }
    // context: legend_bandit_army_contract.create.m.DescriptionTemplates
    {
        en = "A new era dawns as brigand gangs across the land swear fealty to the banner of the underworld king, their unified front heralding a dark chapter in the history of the realm."
        es = "Amanece una nueva era: las bandas de bandidos de todo el territorio juran lealtad al estandarte del rey del hampa, y su frente unido anuncia un capítulo oscuro en la historia del reino."
    }
    // context: legend_bandit_army_contract.create.m.DescriptionTemplates
    {
        en = "A charismatic new crime lord had united all the brigand gangs, marking a dark turning point for the realm."
        es = "Un nuevo y carismático señor del crimen ha unido a todas las bandas de bandidos, lo que marca un oscuro punto de inflexión para el reino."
    }
    // en = "Offer"
    // context: legend_bandit_army_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        en = "Investigate this supposed 'army' of brigands"
        es = "Investiga ese supuesto 'ejército' de bandidos"
    }
    // en = "Running"
    // context: legend_bandit_army_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        // "Gather rumors at " + this.Contract.m.Location1.getName()
        mode = "pattern"
        en = "Gather rumors at <location:str>"
        es = "Reúne rumores en <location>"
    }
    // context: legend_bandit_army_contract.createStates.m.States.push().update.Contract.setScreen()
    // en = "Shortcut"
    // identificador de pantalla
    // context: legend_bandit_army_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        // "We need more clues from " + this.Contract.m.Location2.getName()
        mode = "pattern"
        en = "We need more clues from <location:str>"
        es = "Necesitamos más pistas de <location>"
    }
    // context: legend_bandit_army_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        // "Report back to " + this.Contract.m.Home.getName()
        mode = "pattern"
        en = "Report back to <home:str>"
        es = "Vuelve a <home> para informar"
    }
    // context: legend_bandit_army_contract.createStates.m.States.push().update.Contract.setScreen()
    // en = "ISEEYOU"
    // identificador de pantalla
    // context: legend_bandit_army_contract.createStates.m.States.push().ID
    // en = "TOBATTLE"  // id de estado del contrato
    // context: legend_bandit_army_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        // "Defeat outlaw army at " + this.Contract.m.Destination.getName()
        mode = "pattern"
        en = "Defeat outlaw army at <destination:str>"
        es = "Derrota al ejército de forajidos en <destination>"
    }
    // en = "Return to <home:str>"
    // en base_es
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_20.png[/img]%employer% looks on as you fumble for somewhere to sit.%SPEECH_ON%Mercenary, how long has it been since you've slaked your sword with the blood of evil, cruel men?%SPEECH_OFF% He theatrically raises his fist, shaking it ever so slightly as if he was centre stage of a stage performance. By the time you have parsed this, you realise that you have been simply standing there, dumbfounded, looking for a reply. After a moment their face reverts to a more natural state, it looks like you'll be standing from now on.%SPEECH_ON%We are having a bit of a problem with some local brigands — local to us, that is.\n\n They must be somewhere not far from here — they come frequently and grow in number by the day. The Smallfolk bother me every day about this, they panic as if there were a whole army of these troublemakers! Can you believe it?\n Obviously, I think the answer to this issue is to hire some of my own brigands, such as your little company of good folk. So, does that pique your interest, mercenary? Or do I need to find sturdier types for the task?%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_20.png[/img]%employer% te observa mientras buscas torpemente dónde sentarte.%SPEECH_ON%Mercenario, ¿cuánto hace que no sacias tu espada con la sangre de hombres malvados y crueles?%SPEECH_OFF% Levanta el puño con teatralidad y lo agita apenas, como si estuviera en el centro de un escenario. Para cuando terminas de entenderlo, te das cuenta de que te has quedado ahí de pie, sin palabras, buscando una respuesta. Al cabo de un momento su rostro recupera una expresión más natural; parece que a partir de ahora vas a estar de pie.%SPEECH_ON%Tenemos un pequeño problema con unos bandidos de la zona... de nuestra zona, quiero decir.\n\n Deben de estar en algún lugar no muy lejos de aquí: vienen a menudo y cada día son más. La plebe me molesta a diario con esto, ¡entran en pánico como si hubiera todo un ejército de esos alborotadores! ¿Te lo puedes creer?\n Obviamente, creo que la solución a este asunto es contratar a mis propios bandidos, como tu pequeña compañía de buena gente. Entonces, ¿te interesa, mercenario? ¿O tengo que buscar gente más dura para la tarea?%SPEECH_OFF%"
    }
    // en = "\x7bHow many crowns are we talking about? | What is %townname% prepared to pay for their safety? | Let's talk money.\x7d"
    // en base_es
    // en = "\x7bNot interested. | We have more important matters to settle. | I wish you luck, but we'll not be part of this.\x7d"
    // en base_es
    // en = "Before the attack..."
    // en base_es
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_54.png[/img]Diplomacy has failed; the bandits arm themselves and are organised as well as a proper army. They seem well drilled and come from a mix of backgrounds — some professional, others less so."
        es = "[img]gfx/ui/events/event_54.png[/img]La diplomacia ha fracasado; los bandidos se arman y están tan organizados como un ejército de verdad. Parecen bien adiestrados y tienen procedencias diversas: algunos son profesionales, otros no tanto."
    }
    // en = "Prepare the attack!"
    // en base_es
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Text
    {
        // Text = "[img]gfx/ui/events/event_54.png[/img]As you approach bandit encampment you notice they do not seem like any raiders you\'ve encountered. You expected to be attacked instantly, but they hesitate — some belligerents, even though well equipped, do not seem eager for a fight.\n\n %shouter% notices some familiar faces, folk not built for combat but are instead malnourished and desperate. Before any hostilities starts, %shouter% approaches you with a risky idea, if you\'re willing to try.",
        mode = "pattern"
        en = "[img]gfx/ui/events/event_54.png[/img]As you approach bandit encampment you notice they do not seem like any raiders you've encountered. You expected to be attacked instantly, but they hesitate — some belligerents, even though well equipped, do not seem eager for a fight.\n\n %shouter% notices some familiar faces, folk not built for combat but are instead malnourished and desperate. Before any hostilities starts, %shouter% approaches you with a risky idea, if you're willing to try."
        es = "[img]gfx/ui/events/event_54.png[/img]Al acercarte al campamento de los bandidos, notas que no se parecen a ningún saqueador con el que te hayas topado. Esperabas que te atacaran de inmediato, pero dudan: algunos de los combatientes, aunque bien equipados, no parecen tener ganas de pelea.\n\n %shouter% reconoce algunas caras, gente que no está hecha para el combate, sino desnutrida y desesperada. Antes de que empiecen las hostilidades, %shouter% se te acerca con una idea arriesgada, por si quieres intentarlo."
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "I would rather we not waste the crowns."
        es = "Prefiero que no malgastemos las coronas."
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Options.Text
    {
        // Text = "Perhaps %shouter% knows how to bargain with these people...",
        mode = "pattern"
        en = "Perhaps %shouter% knows how to bargain with these people..."
        es = "Quizá %shouter% sepa negociar con esta gente..."
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Title
    {
        en = "An enemy divided..."
        es = "Un enemigo dividido..."
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Text
    {
        // Text = "[img]gfx/ui/events/event_54.png[/img] %shouter% starts negotiations with some of the less bloodthirsty looking brigands — weaving their way through the crowd looking for the weakest and least angry of the group first.\n Promises of great wealth without spilling blood appeal to sizeable part of the mob — you notice quite a few of the raiders taking the coins %shouter% offers and preparing to leave the camp.\n\n This situation, while acceptable for the greedy, does not sit well with the remainers looking for blood.\n The camp atmosphere grows more tense with every minute, as those interested in crowns gradually filter out of the camp — some are left clutching their weapons and ready to fight. The last moment of peaceful negotiations is interrupted when one of the larger fighters pushes %shouter% back to your group.\n They did what they could, and now it\'s your turn.",
        mode = "pattern"
        en = "[img]gfx/ui/events/event_54.png[/img] %shouter% starts negotiations with some of the less bloodthirsty looking brigands — weaving their way through the crowd looking for the weakest and least angry of the group first.\n Promises of great wealth without spilling blood appeal to sizeable part of the mob — you notice quite a few of the raiders taking the coins %shouter% offers and preparing to leave the camp.\n\n This situation, while acceptable for the greedy, does not sit well with the remainers looking for blood.\n The camp atmosphere grows more tense with every minute, as those interested in crowns gradually filter out of the camp — some are left clutching their weapons and ready to fight. The last moment of peaceful negotiations is interrupted when one of the larger fighters pushes %shouter% back to your group.\n They did what they could, and now it's your turn."
        es = "[img]gfx/ui/events/event_54.png[/img] %shouter% empieza a negociar con algunos de los bandidos de aspecto menos sanguinario, abriéndose paso entre la multitud en busca primero de los más débiles y menos airados del grupo.\n Las promesas de grandes riquezas sin derramar sangre atraen a buena parte de la turba: ves a bastantes saqueadores aceptar las monedas que ofrece %shouter% y prepararse para abandonar el campamento.\n\n Esta situación, aceptable para los codiciosos, no sienta nada bien a los que se quedan con ganas de sangre.\n El ambiente del campamento se vuelve más tenso a cada minuto, a medida que los interesados en las coronas se van marchando poco a poco; algunos se quedan aferrados a sus armas y listos para pelear. El último momento de negociación pacífica se interrumpe cuando uno de los combatientes más corpulentos empuja a %shouter% de vuelta hacia tu grupo.\n Hizo lo que pudo, y ahora te toca a ti."
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "At least we got some of them."
        es = "Al menos convencimos a algunos."
    }
    // en = "You spend <v:str_tag> Crowns"
    // en base_es
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Text
    {
        // Text = "[img]gfx/ui/events/event_54.png[/img] At first it looked like great idea.\n\n For a moment a few raiders seemed to be swayed by the coins in %shouter% purse. Suddenly a grim looking brute strikes %shouter% with a weapon. %shouter% throws coins on ground and escapes to back your group. Instead of chasing, the raider only laughs and shouts %SPEECH_ON%Look at the wee babe running back to the apron strings. You dropped something coward!%SPEECH_OFF% as a group cackle and descend on gold dropped by %shouter%. You hear a shout coming from beyond the crowd that appears to be the leader %SPEECH_ON%SHOW\'S OVER!  KILL THEM!%SPEECH_OFF%",
        mode = "pattern"
        en = "[img]gfx/ui/events/event_54.png[/img] At first it looked like great idea.\n\n For a moment a few raiders seemed to be swayed by the coins in %shouter% purse. Suddenly a grim looking brute strikes %shouter% with a weapon. %shouter% throws coins on ground and escapes to back your group. Instead of chasing, the raider only laughs and shouts %SPEECH_ON%Look at the wee babe running back to the apron strings. You dropped something coward!%SPEECH_OFF% as a group cackle and descend on gold dropped by %shouter%. You hear a shout coming from beyond the crowd that appears to be the leader %SPEECH_ON%SHOW'S OVER!  KILL THEM!%SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_54.png[/img] Al principio parecía una gran idea.\n\n Por un momento, unos cuantos saqueadores parecieron dejarse convencer por las monedas de la bolsa de %shouter%. De pronto, un bruto de aspecto torvo golpea a %shouter% con un arma. %shouter% tira las monedas al suelo y huye de vuelta a tu grupo. En lugar de salir en persecución, el saqueador se limita a reír y grita %SPEECH_ON%¡Miren al bebé corriendo a esconderse tras las faldas de mamá! ¡Se te cayó algo, cobarde!%SPEECH_OFF% mientras un grupo se carcajea y se abalanza sobre el oro que ha soltado %shouter%. Oyes un grito más allá de la multitud que parece venir del cabecilla %SPEECH_ON%¡SE ACABÓ EL ESPECTÁCULO!  ¡MÁTENLOS!%SPEECH_OFF%"
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "It was worth a try"
        es = "Valía la pena intentarlo"
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().start.List.push().text
    {
        // text = this.Contract.m.Briber.getName() + " suffers " + injury1.getNameOnly() + " and " + injury2.getNameOnly()
        mode = "pattern"
        en = "<name:str> suffers <injury1:str> and <injury2:str>"
        es = "<name> sufre <injury1:t> y <injury2:t>"
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().start.Contract.m.Briber.worsenMood()
    {
        en = "Failed to negotiate with bandits"
        es = "No logró negociar con los bandidos"
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_22.png[/img]The silence rolls in after the battle gradually concludes, those who are not dead are writhing in pain or struggling to crawl to safety, out of the corner of your eye you can see Nachzehrers skulking around in the brush, presumably waiting until you depart to begin their meal.\n\n Before you have looted what remains, nature is already descending to clean the battlefield - crows start to finish off those alive who can't defend themselves, stray dogs pull away corpses at the edges of the battle before the more dangerous predators can arrive. A robed man, unknown to either party involved, begins taking what trinkets he can from the dead, no doubt to be sold in a market you will end up visiting later.\n With as many spoils as your company can carry, it is time to get paid at %Home%."
        es = "[img]gfx/ui/events/event_22.png[/img]El silencio se impone a medida que la batalla va terminando; los que no han muerto se retuercen de dolor o se esfuerzan por arrastrarse hasta un lugar seguro. Por el rabillo del ojo ves a unos Nachzehrers merodeando entre la maleza, seguramente esperando a que te marches para empezar su festín.\n\n Antes de que hayas saqueado lo que queda, la naturaleza ya desciende a limpiar el campo de batalla: los cuervos empiezan a rematar a los vivos que no pueden defenderse y los perros callejeros se llevan a rastras los cadáveres de los márgenes antes de que lleguen depredadores más peligrosos. Un hombre con túnica, desconocido para ambos bandos, empieza a quitarles a los muertos todas las baratijas que puede, sin duda para venderlas en algún mercado que acabarás visitando más adelante.\n Con todo el botín que tu compañía puede cargar, es hora de cobrar en %Home%."
    }
    // en = "We move out!"
    // en base_es
    // en = "At %location1%..."
    // en base_es
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_45.png[/img]You reach %location1% and order everyone to start gathering any information related to these local bandits. News of your arrival spreads and commoners begin to ask you if the threat of the horde is real.\n\n With your agenda in mind and little care for the safety of every individual here, you tell them the main force of the bandits has already been defeated — locals are told you were hired to hunt down the remaining bandits that most likely retreated back to their encampment. Being small folk with small minds, you are able to collect a few hints about where their main force operates from. A few opportunistic merchants are willing to trade as you prepare to head out from %location1%."
        es = "[img]gfx/ui/events/event_45.png[/img]Llegas a %location1% y ordenas a todos que empiecen a reunir cualquier información sobre esos bandidos de la zona. La noticia de tu llegada se extiende y la gente común empieza a preguntarte si la amenaza de la horda es real.\n\n Con tus propios planes en mente y poco interés por la seguridad de cada uno de los presentes, les dices que el grueso de los bandidos ya ha sido derrotado; a los lugareños se les cuenta que te contrataron para dar caza a los bandidos restantes, que lo más probable es que se hayan replegado a su campamento. Como son gente de poca monta y pocas luces, consigues reunir algunas pistas sobre el lugar desde el que opera el grueso de sus fuerzas. Unos cuantos mercaderes oportunistas están dispuestos a comerciar mientras te preparas para partir de %location1%."
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "Every rumour helps."
        es = "Cada rumor cuenta."
    }
    // en = "At %location2%..."
    // en base_es
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_45.png[/img]%location2% is where you were told to find more clues. Your mercenaries approach locals with the same lies that worked last time. To your amusement these people seem to take the bait and are soon spreading gossip that could be helpful in your main objective — spirits at %location2% are noticeably raised. Hopefully all the gossip you were able to get is enough to find the bandit army. You head back to consult with you employer about the next move."
        es = "[img]gfx/ui/events/event_45.png[/img]En %location2% te dijeron que encontrarías más pistas. Tus mercenarios abordan a los lugareños con las mismas mentiras que funcionaron la última vez. Para tu diversión, esta gente parece morder el anzuelo y pronto difunde chismes que podrían servir para tu objetivo principal; los ánimos en %location2% se elevan notablemente. Con suerte, todos los chismes que has conseguido bastarán para encontrar al ejército de bandidos. Regresas para consultar con tu patrón el siguiente paso."
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Options.Text
    {
        // corrige base: "Esto valdrá la pena" pierde el matiz de advertencia de "better be"; debe ser "Más vale que esto valga la pena."
        en = "This better be enough..."
        es = "Más vale que esto baste..."
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Title
    {
        en = "At %Home%..."
        es = "En %Home%..."
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_45.png[/img]Not long after you enter %Home%, your employer summons you. This time you enter meeting that is more war council than a social visit — All local militia captains are present, discussing the defensive capabilities of %Home% and outlying farms in case of a siege. With the rumours you gathered and information from other agents, the location of the bandit army is finally determined to be not far from here.\n\n You begin to wonder if this job is worth the risk, but so close to the end and with the threat confirmed, there is no turning back now. Your hesitance clearly terrifies your employer greatly, they assure you that coin promised will be paid to the last crown if threat is eliminated. Food, wine and company are offered if you succeed; anything to convince you to stop the bandits or die trying, or at least to slow it down.\n Preparing to move out from %Home% you notice unusual mobilization of the locals."
        es = "[img]gfx/ui/events/event_45.png[/img]Poco después de entrar en %Home%, quien te contrató te manda llamar. Esta vez entras en una reunión que es más consejo de guerra que visita de cortesía: están presentes todos los capitanes de la milicia local, discutiendo la capacidad defensiva de %Home% y de las granjas de los alrededores en caso de asedio. Con los rumores que reuniste y la información de otros agentes, por fin se determina que el ejército de bandidos no está lejos de aquí.\n\n Empiezas a preguntarte si este trabajo vale el riesgo, pero tan cerca del final y con la amenaza confirmada, ya no hay vuelta atrás. Tu vacilación aterra visiblemente a quien te contrató, que te asegura que la moneda prometida se pagará hasta la última corona si se elimina la amenaza. Te ofrecen comida, vino y compañía si tienes éxito; lo que sea con tal de convencerte de detener a los bandidos o morir en el intento, o al menos de frenarlos.\n Mientras te preparas para partir de %Home%, notas una movilización inusual de los lugareños."
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "To war."
        es = "A la guerra."
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Title
    {
        en = "The violence settles..."
        es = "La violencia se apacigua..."
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_22.png[/img]With the patrol destroyed %randombrother% collects weapons from those unable to fight back while %randombrother2% waltzes between corpses, poking at each body with a stick in one hand and a sword in the other, occasionally plunging the blade into the ribcage of a squirming corpse who failed to play dead.\n When everyone has reported in and spoils are organised and the surviving bandits get a little attention. %randombrother% approaches you. %SPEECH_ON% These scum bleeding out might know something — what if we convince 'em to speak up? I would rather torture these bastards until they share their little secrets rather than running around asking peasants for goddamn directions. %SPEECH_OFF%"
        es = "[img]gfx/ui/events/event_22.png[/img]Con la patrulla aniquilada, %randombrother% recoge las armas de los que ya no pueden defenderse mientras %randombrother2% se pasea entre los cadáveres, pinchando cada cuerpo con un palo en una mano y una espada en la otra, y de vez en cuando hunde la hoja en las costillas de algún cadáver que se retuerce y no ha sabido hacerse el muerto.\n Cuando todos han dado parte y el botín está organizado, los bandidos supervivientes reciben un poco de atención. %randombrother% se te acerca. %SPEECH_ON% Esta escoria que se está desangrando podría saber algo. ¿Y si los convencemos de que hablen? Prefiero torturar a estos bastardos hasta que suelten sus secretitos antes que andar por ahí preguntándoles a los campesinos por el maldito camino. %SPEECH_OFF%"
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "The first one to talk gets their freedom."
        es = "El primero que hable quedará libre."
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "We have wasted enough time, kill them."
        es = "Ya hemos perdido bastante tiempo, mátenlos."
    }
    // context: legend_bandit_army_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_04.png[/img]{You return to %townname% to meet with %employer%. Claiming your reward for all the troubles your company had to endure is your main priority. While you are being summoned to %employer% your mercenaries are already trading away spoils of war acquired though this adventure. You head off to the meeting, accompanied by the personal guards of %employer% and local militia captains.\n\n Everyone present at meeting with %employer% can clearly sense mixed feelings coming from him. On one side relief with the threat eliminated, but in the other anger due to giving away the small fortune that was promised. Walking around %townname% you notice it has been well prepared for eventuality of siege. This adventure did not come cheap.}"
        es = "[img]gfx/ui/events/event_04.png[/img]{Regresas a %townname% para reunirte con %employer%. Reclamar tu recompensa por todas las penurias que ha tenido que soportar tu compañía es tu prioridad. Mientras te convocan ante %employer%, tus mercenarios ya están vendiendo el botín de guerra conseguido en esta aventura. Te diriges a la reunión en compañía de los guardias personales de %employer% y de los capitanes de la milicia local.\n\n Todos los presentes en la reunión con %employer% perciben con claridad sus sentimientos encontrados: por un lado, el alivio de ver eliminada la amenaza; por otro, la rabia de tener que desprenderse de la pequeña fortuna prometida. Al recorrer %townname% notas que la ciudad se ha preparado bien para un posible asedio. Esta aventura no ha salido barata.}"
    }
    // en = "Destroyed a brigand encampment"
    // en base_es
    // en = "You gain <v:val_tag> Crowns"
    // en base_es
    // context: legend_bandit_army_contract.onPrepareVariables._vars.push()
    // en = "Home"  // nombre de variable de plantilla (%Home%); no se muestra
    // en = "location1"
    // context: legend_bandit_army_contract.onPrepareVariables._vars.push()
    // en = "location2"  // nombre de variable de plantilla (%location2%); no se muestra
    // en = "shouter"
    // context: legend_bandit_army_contract.spawnRaidingParty.party.World.FactionManager.getFactionOfType(this.Const.FactionType.Bandits).spawnEntity()
    {
        en = "Raiding party"
        es = "Partida de saqueo"
    }
    // context: legend_bandit_army_contract.spawnRaidingParty.party.setDescription()
    {
        en = "A group of brigands, more coordinated than usual."
        es = "Un grupo de bandidos, más coordinado de lo habitual."
    }
    // context: legend_bandit_army_contract.spawnBribedParty.party.World.FactionManager.getFactionOfType(this.Const.FactionType.Settlement).spawnEntity()
    {
        en = "Bribed Raiders"
        es = "Saqueadores sobornados"
    }
    // context: legend_bandit_army_contract.spawnBribedParty.party.setDescription()
    {
        en = "Those who like gold above all"
        es = "Los que aman el oro por encima de todo"
    }
    // FILE: scripts\contracts\contracts\legend_barbarian_prisoner_contract.nut
    // context: legend_barbarian_prisoner_contract.create.m.Name
    {
        en = "Facing Justice (Legendary)"
        es = "Ante la justicia (Legendario)"
    }
    // context: legend_barbarian_prisoner_contract.create.m.DescriptionTemplates
    {
        en = "A barbarian prisoner, shackled and guarded, awaits transport to face judgment. His kin will not this make this easy."
        es = "Un prisionero bárbaro, encadenado y bajo custodia, espera su traslado para ser juzgado. Los suyos no se lo pondrán fácil."
    }
    // context: legend_barbarian_prisoner_contract.create.m.DescriptionTemplates
    {
        en = "Despite his captivity, the barbarian prisoner remains a formidable threat. Bulging muscles and furious eyes, not to mention the savage kin waiting to ambush you in the forest."
        es = "Pese a su cautiverio, el prisionero bárbaro sigue siendo una amenaza temible. Músculos abultados y ojos furiosos, por no hablar de los salvajes de su clan que esperan para emboscarte en el bosque."
    }
    // context: legend_barbarian_prisoner_contract.create.m.DescriptionTemplates
    {
        en = "Wrapped in thick chains, a hulking barbarian prisoner awaits transport. Nobody wants the job, for his savage kin are fiercely loyal and they will come for him."
        es = "Envuelto en gruesas cadenas, un enorme prisionero bárbaro espera su traslado. Nadie quiere el trabajo, pues los salvajes de su clan son ferozmente leales y vendrán a buscarlo."
    }
    // context: legend_barbarian_prisoner_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        en = "Escort prisoner to %objective% about %days% to the %direction%"
        es = "Escolta al prisionero hasta %objective%, a unos %days% al %direction%"
    }
    // en = "Provisions for the way are provided to your men"
    // en base_es
    // context: legend_barbarian_prisoner_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        en = "Provisions for the journey are provided to your mercenaries"
        es = "Se proporcionarán provisiones para el viaje a tus mercenarios"
    }
    // context: legend_barbarian_prisoner_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        en = "Destroy camp of prisoner's enemies"
        es = "Destruye el campamento de los enemigos del prisionero"
    }
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_100.png[/img] {%employer%'s crosses his arms and purses his lips.%SPEECH_ON%Ordinarily I wouldn't ask some sellswords to guard a caravan, but my usual crew is a little out of it - sickness, drunkenness, licentiousness... I think you understand. What's important is that I have important cargo going to %objective% about %days% to the %direction% and I need someone watching it... someone specialized in that sort of 'cargo'. I've heard your particular company has 'individuals' that are skilled in handling savages. The mountain of muscles in my dungeon is the most wanted bastard in %objective%. Rumor is they killed a whole patrol with their bare hands...but come, let's not dwell on those grisly details. Are you interested or not?%SPEECH_OFF% }"
        es = "[img]gfx/ui/events/event_100.png[/img] {%employer% se cruza de brazos y frunce los labios.%SPEECH_ON%Normalmente no le pediría a unos mercenarios que custodiaran una caravana, pero mi gente de siempre no está muy en forma: enfermedad, borrachera, libertinaje... Creo que me entiendes. Lo que importa es que tengo un cargamento importante que va a %objective%, a unos %days% al %direction%, y necesito a alguien que lo vigile... alguien especializado en esa clase de 'cargamento'. He oído que tu compañía en particular tiene 'individuos' hábiles en el trato con salvajes. La montaña de músculos que tengo en mi mazmorra es el bastardo más buscado de %objective%. Se rumorea que mató a una patrulla entera con sus propias manos... pero vamos, no nos detengamos en esos detalles macabros. ¿Te interesa o no?%SPEECH_OFF% }"
    }
    // en = "\x7bLet's talk money. | How many crowns are we talking about? | What does it pay?\x7d"
    // en base_es
    // en = "\x7bNot interested. | This is not the kind of work we're looking for.\x7d"
    // en base_es
    // en = "At %objective%"
    // en base_es
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_65.png[/img] {You've made it, having delivered the prison cart just as you promised %employer% you would. The caravan leader claims the reward for the criminal you delivered, and quickly hands over most of it. The sight of a monstrous savage beast finally in chains causes noticeable joy and relief to the local populace of %objective%. You wonder whether to stay around for a while to enjoy the show scheduled for tomorrow, but the common folk across streets have already started celebrating. Either way the job is done, the reward is paid and you can move out at any time.}"
        es = "[img]gfx/ui/events/event_65.png[/img] {Lo has logrado: has entregado el carro de prisioneros tal como le prometiste a %employer%. El jefe de la caravana cobra la recompensa por el criminal que trajiste y te pasa enseguida la mayor parte. Ver por fin encadenada a una monstruosa bestia salvaje provoca una alegría y un alivio evidentes entre la población de %objective%. Te preguntas si quedarte un tiempo para disfrutar del espectáculo previsto para mañana, pero la gente de a pie ya ha empezado a celebrarlo por las calles. En cualquier caso, el trabajo está hecho, la recompensa pagada y puedes partir cuando quieras.}"
    }
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().Options.getResult.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation()
    {
        en = "Protected a prisoner wagon as promised"
        es = "Protegió un carro de prisioneros como prometió"
    }
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().start.List.push().text
    {
        // text = "You gain [color=" + this.Const.UI.Color.PositiveEventValue + "]" + money + "[/color] Crowns."
        mode = "pattern"
        en = "You gain [color=<color:str>]<money:int>[/color] Crowns."
        es = "Obtienes [color=<color>]<money>[/color] coronas."
    }
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_145.png[/img] {This battle was more bloody than the usual skirmishes your men are involved in. %randombrother% looks over wounded companions. %randombrother2% inspects the prison cart to ensure the recent encounter left it in a decent condition to resume the journey, then approaches you. %SPEECH_ON%These barbarians were serious business, cap - that big brute we have in custody must be someone important. Maybe… I don't know boss… but maybe let's see what the prisoner has to say? This might be their king or some kind of famed warrior! Who cares about %employer%'s opinion on the matter? We got paid already and I don't think we'll find any more crowns waiting for us in %objective%.%SPEECH_OFF% }"
        es = "[img]gfx/ui/events/event_145.png[/img] {Esta batalla fue más sangrienta que las escaramuzas habituales en las que se meten tus hombres. %randombrother% revisa a los compañeros heridos. %randombrother2% inspecciona el carro de prisioneros para asegurarse de que el reciente encuentro lo ha dejado en condiciones decentes para reanudar el viaje y luego se te acerca. %SPEECH_ON%Estos bárbaros iban en serio, capitán; ese bruto enorme que tenemos bajo custodia debe de ser alguien importante. Quizá… no sé, jefe… pero ¿y si vemos qué tiene que decir el prisionero? ¡Podría ser su rey o algún guerrero famoso! ¿A quién le importa lo que opine %employer% al respecto? Ya nos han pagado y no creo que encontremos más coronas esperándonos en %objective%.%SPEECH_OFF% }"
    }
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "No. Execution is only solution to the crimes of this savage! (Increase Moral Reputation)"
        es = "No. ¡La ejecución es la única solución a los crímenes de este salvaje! (Aumenta la reputación moral)"
    }
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "Good idea. Let's speak with the prisoner. (Decrease Moral Reputation)"
        es = "Buena idea. Hablemos con el prisionero. (Reduce la reputación moral)"
    }
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_139.png[/img] {Those of the company who are still strong enough to fight gather around the wagon. %randombrother% holds a weapon tight, ready to strike if need be. As you approach, the presence of the half naked northerner grows more and more menacing. What is left of %employer%'s men are upset about this but after the recent battle they aren't looking for another fight. Finally the prisoner speaks. %SPEECH_ON%HAHA!! That was an impressive brawl! I didn't expect you'd manage to kill them all. A few, maybe, but here I thought I'd have to deal with the bulk of them myself, and I nary lifted a finger! Ha!%SPEECH_OFF%Seeing the surprise on your face, the barbarian raises an eyebrow and explains.%SPEECH_ON%You look surprised. Did you think those curs were here to rescue me? No, those were my enemies - and I assure you, there are more of them, and deadlier ones too. Still, killing these warriors was proof you're not just a bunch of milk drinking rabble like these so-called 'nobles'.%SPEECH_OFF%The barbarian pauses, spits, eyes your for a moment longer. They continue.%SPEECH_ON%I have a score to settle with the chieftain of Reaver's Hold. Kill the guards. Free me. Take me there. It will be a worthy battle against real warriors, not some piddling skirmish surrounded by a bunch of fops in fancy armor. The chieftain is my kill, but the rest are fair game. You do that, and I'd consider it an honor to join your band. What say you?%SPEECH_OFF% }"
        es = "[img]gfx/ui/events/event_139.png[/img] {Los miembros de la compañía que aún tienen fuerzas para pelear se reúnen alrededor del carro. %randombrother% aferra un arma con fuerza por si hay que golpear. A medida que te acercas, la presencia del norteño medio desnudo se vuelve cada vez más amenazante. A lo que queda de los hombres de %employer% esto no les hace ninguna gracia, pero tras la reciente batalla no buscan otra pelea. Por fin, el prisionero habla. %SPEECH_ON%¡¡JAJA!! ¡Qué pelea tan impresionante! No esperaba que lograras matarlos a todos. A unos pocos, quizá, pero creía que tendría que encargarme de la mayoría por mi cuenta, ¡y no he movido ni un dedo! ¡Ja!%SPEECH_OFF%Al ver la sorpresa en tu cara, el bárbaro arquea una ceja y se explica.%SPEECH_ON%Pareces sorprendido. ¿Creías que esos perros venían a rescatarme? No, eran mis enemigos, y te aseguro que hay más, y aún más letales. Aun así, matar a esos guerreros demuestra que tu gente no es una simple chusma que bebe leche, como estos supuestos 'nobles'.%SPEECH_OFF%El bárbaro hace una pausa, escupe y te observa un momento más. Luego continúa.%SPEECH_ON%Tengo una cuenta pendiente con el caudillo del Bastión del Saqueador. Mata a los guardias. Libérame. Llévame allí. Será una batalla digna contra guerreros de verdad, no una escaramuza de poca monta entre un montón de petimetres con armaduras lujosas. El caudillo es mío, pero los demás son todos tuyos. Haz eso y consideraré un honor unirme a tu banda. ¿Qué me dices?%SPEECH_OFF% }"
    }
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "Back to the cage! (Increase Moral Reputation)"
        es = "¡De vuelta a la jaula! (Aumenta la reputación moral)"
    }
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "Very well, you have a deal. (Decrease Moral Reputation)"
        es = "Muy bien, trato hecho. (Reduce la reputación moral)"
    }
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().Options.getResult.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation()
    {
        en = "Failed to protect a prisoner wagon"
        es = "No logró proteger un carro de prisioneros"
    }
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().Title
    {
        en = "Retreat..."
        es = "Retirada..."
    }
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_60.png[/img] {The prison cart is opened. There is no sight of the prisoner anywhere. You failed.}"
        es = "[img]gfx/ui/events/event_60.png[/img] {El carro de prisioneros está abierto. No hay rastro del prisionero por ninguna parte. Has fracasado.}"
    }
    // en = "Darn it!"
    // en base_es
    // en = "After the battle"
    // en base_es
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_145.png[/img] {The battle was hard fought, but you prevailed. Your mercenaries finish all those who have not reached the afterlife yet. As the plundering begins, the barbarian who convinced you to betray %employer% emerges victorious from the chieftain's hut, carrying a helmet with a bloody head still inside it. A fancy helm - too fancy for ordinary barbarians. The warrior tosses the gruesome trophy to your feet. The helm slips off and rolls aside, leaving the bloody stump facing up at you. From the wound you can tell the head was not cut off with a weapon, but ripped off by hand.%SPEECH_ON%I am done here. I hope I can count on you to find better challenges for me than this.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_145.png[/img] {La batalla fue reñida, pero has vencido. Tus mercenarios rematan a todos los que aún no han llegado al más allá. Mientras empieza el saqueo, el bárbaro que te convenció para traicionar a %employer% sale victorioso de la choza del caudillo, cargando un yelmo con una cabeza ensangrentada todavía dentro. Un yelmo lujoso, demasiado lujoso para un bárbaro corriente. El guerrero arroja el macabro trofeo a tus pies. El yelmo se suelta y rueda a un lado, dejando el muñón ensangrentado vuelto hacia ti. Por la herida se nota que la cabeza no la cortó un arma, sino que la arrancaron a mano.%SPEECH_ON%Aquí he terminado. Espero poder contar contigo para encontrarme retos mejores que este.%SPEECH_OFF%}"
    }
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().start.Options.push().Text
    {
        en = "We can't hire you."
        es = "No podemos contratarte."
    }
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().start.Options.push().Text
    {
        en = "You better be worth it."
        es = "Más te vale valer la pena."
    }
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().start.Options.push().getResult
    // en = "Hired"  // identificador de la pantalla siguiente (getResult), no se muestra
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_139.png[/img]An outstanding capacity for violence is well-suited to a mercenary band. You agree to take the freed prisoner on."
        es = "[img]gfx/ui/events/event_139.png[/img]Una capacidad excepcional para la violencia le viene como anillo al dedo a una banda de mercenarios. Aceptas acoger al prisionero liberado."
    }
    // en = "Welcome to the company."
    // en base_es
    // en = "the Beast"
    // en base_es
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().start.Contract.m.Dude.getBackground().m.RawDescription
    {
        en = "%name% was 'saved' by you from execution. You decided that this killing machine is a worthy acquisition, ignoring the fact it is also the most wanted criminal in the north."
        es = "Fuiste tú quien 'salvó' a %name% de la ejecución. Decidiste que semejante máquina de matar era una adquisición valiosa, sin importarte que además encabece la lista de criminales más buscados del norte."
    }
    // context: legend_barbarian_prisoner_contract.createScreens.m.Screens.push().start.Contract.m.Dude.getBackground().m.RawDescription
    {
        en = "%name% was 'saved' by you from a death sentence. Recruiting this savage barbarian has put you in bad terms with the nobles of the north."
        es = "Tú 'salvaste' a %name% de una condena a muerte. Reclutar a semejante salvaje te ha enemistado con los nobles del norte."
    }
    // context: legend_barbarian_prisoner_contract.spawnEnemies.party.World.FactionManager.getFactionOfType(this.Const.FactionType.Barbarians).spawnEntity()
    {
        en = "Barbarian Retaliation"
        es = "Represalia bárbara"
    }
    // context: legend_barbarian_prisoner_contract.spawnEnemies.party.setDescription()
    {
        en = "These savages would like to have their buddy back."
        es = "Estos salvajes quieren recuperar a su compinche."
    }
    // en = "Escort Caravan"
    // en base_es
    // context: legend_barbarian_prisoner_contract.spawnCaravan.party.setDescription()
    {
        // party.setDescription("A prison cart from " + this.m.Home.getName() + " that is transporting a dangerous barbarian.");
        mode = "pattern"
        en = "A prison cart from <home:str> that is transporting a dangerous barbarian."
        es = "Un carro de prisioneros de <home> que transporta a un bárbaro peligroso."
    }
    // en = "objective"
    // en = "a day"
    // en base_es
    // en = "<days:int> days"
    // en base_es
    // FILE: scripts\contracts\contracts\legend_camp_legion_defend_cemetery_contract.nut
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().create.m.Name
    {
        en = "Defend burial site"
        es = "Defiende el camposanto"
    }
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().create.m.DescriptionTemplates
    {
        en = "Sacred burial site is threatened, action should be taken."
        es = "Un lugar sagrado de enterramiento está amenazado; hay que actuar."
    }
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().create.m.DescriptionTemplates
    {
        en = "Reports indicate a band of hired blades looting tombs for valuables."
        es = "Los informes hablan de una banda de espadas a sueldo que saquea tumbas en busca de objetos de valor."
    }
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().create.m.DescriptionTemplates
    {
        en = "Grave robbers under mercenary contract are stripping the crypts bare."
        es = "Unos saqueadores de tumbas a sueldo están vaciando las criptas."
    }
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().createStates.m.States.push().start.Contract.m.BulletpointsObjectives.::format()
    {
        // ::format("Travel to %s", this.Flags.get("DestinationName")),
        mode = "pattern"
        en = "Travel to <destination:str>"
        es = "Viaja a <destination>"
    }
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().createStates.m.States.push().start.Contract.m.BulletpointsObjectives.::format()
    {
        // ::format("Defend %s from invaders", this.Flags.get("DestinationName")),
        mode = "pattern"
        en = "Defend <destination:str> from invaders"
        es = "Defiende <destination> de los invasores"
    }
    // en = "Arrival"
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().createStates.m.States.push().ID
    // en = "Defending"  // identificador de estado del contrato (ID), no se muestra
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        en = "Wait for messenger to contact you."
        es = "Espera a que el mensajero se ponga en contacto contigo."
    }
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_camp_hunt.png[/img]{ %employer% approaches you and gives you a sealed scroll. You break the seal and read. %SPEECH_ON%There has been suspicious activity near %location%. Tracks of graverobbers sniffing around were found. You're to investigate this matter. Go out to the cemetery and end this nuisance once and for all!%SPEECH_OFF% }"
        es = "[img]gfx/ui/events/legend_camp_hunt.png[/img]{ %employer% se te acerca y te entrega un pergamino sellado. Rompes el sello y lees. %SPEECH_ON%Ha habido actividad sospechosa cerca de %location%. Se han encontrado huellas de saqueadores de tumbas husmeando por la zona. Debes investigar el asunto. ¡Ve al cementerio y acaba con esta molestia de una vez por todas!%SPEECH_OFF% }"
    }
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().createScreens.m.Screens.push().Options.Text
    {
        en = "We'll need compensation."
        es = "Necesitaremos una compensación."
    }
    // en = "Not interested."
    // en base_es
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_73.png[/img]For glory! It looks like they learned their lesson. %location% will be safe for a while. Meanwhile carriage sent by %employer% arrived and you start unloading."
        es = "[img]gfx/ui/events/event_73.png[/img]¡Por la gloria! Parece que han aprendido la lección. %location% estará a salvo por un tiempo. Mientras tanto, ha llegado el carruaje enviado por %employer% y empiezas a descargarlo."
    }
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().createScreens.m.Screens.push().Options.Text
    {
        en = "For glory!"
        es = "¡Por la gloria!"
    }
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_46.png[/img]%location% has fallen, graves robbed, crypts plundered. %SPEECH_ON%I suppose that's it, then.%SPEECH_OFF%%randombrother% says. %employer% will { not be pleased | be furious }."
        es = "[img]gfx/ui/events/event_46.png[/img]%location% ha caído: tumbas profanadas, criptas saqueadas. %SPEECH_ON%Supongo que ya está, entonces.%SPEECH_OFF%Eso dice %randombrother%. %employer% { no se alegrará | montará en cólera }."
    }
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().createScreens.m.Screens.push().Options.Text
    {
        en = "A shame."
        es = "Una lástima."
    }
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_57.png[/img]As you arrived near burial place, you see signs of recent human activity. Best we can do now is to stay around and fend off any graverobbers."
        es = "[img]gfx/ui/events/event_57.png[/img]Al llegar cerca del camposanto, ves señales de actividad humana reciente. Lo mejor que podemos hacer ahora es quedarnos por aquí y rechazar a cualquier saqueador de tumbas."
    }
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().createScreens.m.Screens.push().Options.Text
    {
        en = "Let's take a look around."
        es = "Echemos un vistazo."
    }
    // context: legend_camp_legion_defend_cemetery_contract.::inherit().spawnMercenaries.party.setDescription()
    {
        en = "A party of graberobbers and pillagers."
        es = "Una partida de saqueadores de tumbas y salteadores."
    }
    // en = "location"
    // FILE: scripts\contracts\contracts\legend_camp_legion_hunt_nobles_contract.nut
    // context: legend_camp_legion_hunt_nobles_contract.create.m.Name
    {
        en = "Hunt: Nobles"
        es = "Caza: nobles"
    }
    // context: legend_camp_legion_hunt_nobles_contract.create.m.DescriptionTemplates
    {
        en = "A Noble house patrol is too close to discovering a nearby camp of ours."
        es = "Una patrulla de una casa noble está a punto de descubrir uno de nuestros campamentos cercanos."
    }
    // context: legend_camp_legion_hunt_nobles_contract.create.m.DescriptionTemplates
    {
        en = "Cause infighting between the Noble houses by murdering one of their patrols."
        es = "Siembra la discordia entre las casas nobles asesinando a una de sus patrullas."
    }
    // context: legend_camp_legion_hunt_nobles_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        en = "Destroy the Noble house patrol"
        es = "Destruye la patrulla de la casa noble"
    }
    // context: legend_camp_legion_hunt_nobles_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        en = "Do not leave any survivors"
        es = "No dejes supervivientes"
    }
    // context: legend_camp_legion_hunt_nobles_contract.createStates.m.States.push().update.Contract.setState()
    // en = "Chase"  // identificador de estado del contrato (setState), no se muestra
    // context: legend_camp_legion_hunt_nobles_contract.createStates.m.States.push().start.Contract.m.BulletpointsObjectives
    {
        en = "Wait for your employer to contact you."
        es = "Espera a que tu patrón se ponga en contacto contigo."
    }
    // context: legend_camp_legion_hunt_nobles_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_camp_hunt.png[/img]{%employer% approaches you in camp. %SPEECH_ON%A patrol is nearby. It has been getting closer and closer to one of our larger camps. Destroy the patrol and place this shield at the battlefield to misdirect the enemy into fighting one another.%SPEECH_OFF% The messenger pauses as both of your hands at at the brim of the shield. An important message follows. %SPEECH_ON%Do not allow any to escape.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/legend_camp_hunt.png[/img]{%employer% se te acerca en el campamento. %SPEECH_ON%Hay una patrulla cerca. Se ha ido acercando cada vez más a uno de nuestros campamentos más grandes. Destruye la patrulla y deja este escudo en el campo de batalla para engañar al enemigo y que se enfrenten entre ellos.%SPEECH_OFF% El mensajero hace una pausa mientras las manos de ambos sujetan el borde del escudo. Sigue un mensaje importante. %SPEECH_ON%No dejes que nadie escape.%SPEECH_OFF%}"
    }
    // context: legend_camp_legion_hunt_nobles_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{Let's talk business.}"
        es = "{Hablemos de negocios.}"
    }
    // context: legend_camp_legion_hunt_nobles_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "{We can't take this on right now.}"
        es = "{Ahora mismo no podemos encargarnos de esto.}"
    }
    // context: legend_camp_legion_hunt_nobles_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_55.png[/img]{You find the patrol %employer% was talking about. They sit completely unprepared for your arrival. The words ring through your hollow mind again... %SPEECH_ON%Do not allow any to escape.%SPEECH_OFF%}"
        es = "[img]gfx/ui/events/event_55.png[/img]{Encuentras la patrulla de la que hablaba %employer%. Están sentados, sin esperar en absoluto tu llegada. Las palabras resuenan de nuevo en tu mente vacía... %SPEECH_ON%No dejes que nadie escape.%SPEECH_OFF%}"
    }
    // en = "Charge!"
    // en base_es
    // context: legend_camp_legion_hunt_nobles_contract.createScreens.m.Screens.push().Title
    {
        en = "Closing in..."
        es = "El cerco se estrecha..."
    }
    // context: legend_camp_legion_hunt_nobles_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_90.png[/img]{The few survivors that escaped your attack have gotten word out. In the distance, a much larger, more prepared forces tightens the noose around you...}"
        es = "[img]gfx/ui/events/event_90.png[/img]{Los pocos supervivientes que escaparon de tu ataque han dado la voz de alarma. A lo lejos, una fuerza mucho mayor y mejor preparada estrecha el cerco a tu alrededor...}"
    }
    // context: legend_camp_legion_hunt_nobles_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_60.png[/img]{The battlefield is lain astrew with gore and metal. You take what you can and leave a shield belonging to another Noble house in a treeline not far from the battle.}"
        es = "[img]gfx/ui/events/event_60.png[/img]{El campo de batalla está sembrado de vísceras y metal. Tomas lo que puedes y dejas un escudo de otra casa noble en la linde del bosque, no lejos de la batalla.}"
    }
    // context: legend_camp_legion_hunt_nobles_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "Time to return."
        es = "Hora de volver."
    }
    // context: legend_camp_legion_hunt_nobles_contract.createScreens.m.Screens.push().start.Text
    {
        en = "[img]gfx/ui/events/event_22.png[/img]{You perform a brief headcount, first of your own fighters, then a slower, more methodical count of the patrol.\n\n Some are missing.}"
        es = "[img]gfx/ui/events/event_22.png[/img]{Haces un recuento rápido, primero de tus propios combatientes y luego, más despacio y con método, de la patrulla.\n\n Faltan algunos.}"
    }
    // context: legend_camp_legion_hunt_nobles_contract.createScreens.m.Screens.push().start.Options.Text
    {
        en = "We need to leave."
        es = "Tenemos que irnos."
    }
    // context: legend_camp_legion_hunt_nobles_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/event_36.png[/img]{You return to %employer%. Little is said, but a mutual understanding is held.\n\n They silently pass you the reward and depart.}"
        es = "[img]gfx/ui/events/event_36.png[/img]{Vuelves con %employer%. Se dice poco, pero hay un entendimiento mutuo.\n\n En silencio te entrega la recompensa y se marcha.}"
    }
    // en = "After battle..."
    // en base_es
    // context: legend_camp_legion_hunt_nobles_contract.createScreens.m.Screens.push().Text
    {
        en = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{Some memmbers of the patrol escaped. You sense there will be repercussions for this.}"
        es = "[img]gfx/ui/events/legend_rock_unhold.png[/img]{Algunos miembros de la patrulla escaparon. Intuyes que habrá repercusiones.}"
    }
    // context: legend_camp_legion_hunt_nobles_contract.createScreens.m.Screens.push().Options.Text
    {
        en = "Unfortunate."
        es = "Mala suerte."
    }
