    // en = "<giver:str_tag> gives Strange Mushrooms to <receiver:str_tag>"
    // en base_es
    // FILE: mod_legends\hooks\skills\actives\break_ally_free_skill.nut
    // context: break_ally_free_skill.o.getTooltip.tooltip.text
    {
        // text = "Has a [color=%positive%]" + this.getChance() + "%[/color] chance to succeed, based on Melee Skill, or higher if there\'s been attempts to free the ally before."
        mode = "pattern"
        en = "Has a [color=%positive%]<chance:int>%[/color] chance to succeed, based on Melee Skill, or higher if there's been attempts to free the ally before."
        es = "Tiene un [color=%positive%]<chance>%[/color] de probabilidad de éxito, basada en la Habilidad cuerpo a cuerpo, o mayor si ya se ha intentado liberar al aliado antes."
    }
    // context: break_ally_free_skill.o.getTooltip.tooltip.push().text
    {
        en = "Net Mastery makes this signficantly easier"
        es = "Dominio de la Red lo hace considerablemente más fácil"
    }
    // FILE: mod_legends\hooks\skills\actives\break_free_skill.nut
    // context: break_free_skill.o.getTooltip.tooltip.text
    {
        // text = "Has a [color=%positive%]" + this.getChance() + "%[/color] chance to succeed, based on Melee Skill. Each failed attempt will increase the chance to succeed for subsequent attempts."
        mode = "pattern"
        en = "Has a [color=%positive%]<chance:int>%[/color] chance to succeed, based on Melee Skill. Each failed attempt will increase the chance to succeed for subsequent attempts."
        es = "Tiene un [color=%positive%]<chance>%[/color] de probabilidad de éxito, basada en la Habilidad cuerpo a cuerpo. Cada intento fallido aumenta la probabilidad de éxito de los siguientes intentos."
    }
    // context: break_free_skill.o.getTooltip.tooltip.push().text
    {
        en = "Net Mastery makes this significantly easier"
        es = "Dominio de la Red lo hace considerablemente más fácil"
    }
    // context: break_free_skill.o.getTooltip.tooltip.push().text
    {
        en = "Escape Artist makes this significantly easier"
        es = "Escapista lo hace considerablemente más fácil"
    }
    // context: break_free_skill.o.getTooltip.tooltip.push().text
    {
        en = "The size of this character makes this significantly easier"
        es = "El tamaño de este personaje lo hace considerablemente más fácil"
    }
    // context: break_free_skill.o.onUse.Tactical.EventLog.logEx()
    {
        // this.Tactical.EventLog.logEx(this.Const.UI.getColorizedEntityName(_user) + " effortlessly breaks free (Chance: " + toHit + ", Rolled: " + rolled + ")");
        mode = "pattern"
        en = "<name:str> effortlessly breaks free (Chance: <chance:int>, Rolled: <roll:int>)"
        es = "<name> se libera sin esfuerzo (Probabilidad: <chance>, Tirada: <roll>)"
