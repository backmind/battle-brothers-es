    // context: legend_mummy_shield.create.m.Description
    {
        en = "A small shield made of wood and reinforced with bronze. Time has taken its toll and the wood has become brittle, but it is still an agile parrying tool."
        es = "Un pequeño escudo de madera reforzado con bronce. El tiempo ha hecho mella y la madera se ha vuelto quebradiza, pero sigue siendo una herramienta ágil para parar golpes."
    }
    // FILE: scripts\items\shields\ancient\legend_mummy_tower_shield.nut
    // context: legend_mummy_tower_shield.create.m.Name
    {
        en = "Ancient Southern Tower Shield"
        es = "Escudo de torre sureño antiguo"
    }
    // context: legend_mummy_tower_shield.create.m.Description
    {
        en = "A tall and heavy southern tower shield that offers good protection at the cost of being very bulky to handle. Covers a whole man with ease despite being tall and narrow."
        es = "Un pavés sureño alto y pesado que ofrece buena protección a costa de ser muy aparatoso de manejar. Cubre a un hombre entero con facilidad pese a ser alto y estrecho."
    }
    // FILE: scripts\items\shields\beasts\legend_greenwood_schrat_shield.nut
    // context: legend_greenwood_schrat_shield.create.m.Name
    {
        en = "Greenwood Schrat's Shield"
        es = "Corteza de Schrat verde"
    }
    // FILE: scripts\items\shields\legend_faction_tower_shield.nut
    // context: legend_faction_tower_shield.create.m.Name
    {
        en = "Noble Tower Shield"
        es = "Escudo de torre de noble"
    }
    // context: legend_faction_tower_shield.create.m.Description
    {
        en = "A large square shield that offers excellent protection for yourself and others, very heavy and hard to maneuver"
        es = "Un gran escudo cuadrado que ofrece una protección excelente para ti y para los demás; muy pesado y difícil de manejar"
    }
    // FILE: scripts\items\shields\legend_tower_shield.nut
    // context: legend_tower_shield.create.m.Name
    {
        en = "Tower Shield"
        es = "Escudo de torre"
    }
    // context: legend_tower_shield.create.m.Description
    {
        en = "A large square shield that offers excellent protection for yourself and others. It is stout, heavy and broad - offering excellent protection from attacks aimed at the sides."
        es = "Un gran escudo cuadrado que ofrece una protección excelente para ti y para los demás. Es robusto, pesado y ancho, y protege de maravilla de los ataques dirigidos a los flancos."
    }
    // FILE: scripts\items\shields\special\legend_craftable_greenwood_schrat_shield.nut
    // context: legend_craftable_greenwood_schrat_shield.create.m.Name
    {
        en = "Living Greenwood Tree Shield"
        es = "Escudo de árbol viviente verde"
    }
    // context: legend_craftable_greenwood_schrat_shield.create.m.Description
    {
        en = "This shield carved out of the remains of a living tree is lighter and sturdier than those made of common wood. At a glance, it almost looks as if its grotesque face is still moving."
        es = "Este escudo tallado a partir de los restos de un árbol vivo es más ligero y resistente que los de madera común. A primera vista, casi parece como si su grotesco rostro todavía se estuviera moviendo."
    }
    // context: legend_craftable_greenwood_schrat_shield.getTooltip.result.push().text
    {
        // text = "Regenerates itself by up to [color=%positive%]" + this.Math.floor(this.getConditionMax() * 0.2) + "[/color] of maximum durability each turn."
        mode = "pattern"
        en = "Regenerates itself by up to [color=%positive%]<amount:int>[/color] of maximum durability each turn."
        es = "Se regenera cada turno hasta [color=%positive%]<amount>[/color] de su durabilidad máxima."
    }
    // context: legend_craftable_greenwood_schrat_shield.onTurnStart.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(actor) + "\'s shield restores " + shieldAdded + " durability");
        mode = "pattern"
        en = "<name:str>'s shield restores <amount:int> durability"
        es = "El escudo de <name> recupera <amount> de durabilidad"
    }
    // FILE: scripts\items\shields\special\legend_craftable_kraken_shield.nut
    // en = "Kraken Shield"
    // en base_es
    // en = "This shield, carved out of a horn plate taken from a giant kraken, is stronger than any common shield."
    // en base_es
    // FILE: scripts\items\shields\special\legend_craftable_schrat_shield.nut
    // en = "Living Tree Shield"
    // en base_es
    // en = "This shield carved out of the remains of a living tree slowly regrows if it sustains any damage. At a glance, it almost looks as if its grotesque face is still moving."
    // en base_es
    // FILE: scripts\items\spawns\legend_cart_large_item.nut
    // context: legend_cart_large_item.create.m.Name
    {
        en = "Large Cart"
        es = "Carro grande"
    }
    // context: legend_cart_large_item.create.m.Description
    {
        en = "A large cart and donkey, excellent for carrying many things, but must be protected in battle."
        es = "Un carro grande con su burro, excelente para cargar muchas cosas, aunque hay que protegerlo en combate."
    }
    // FILE: scripts\items\spawns\legend_cart_small_item.nut
    // context: legend_cart_small_item.create.m.Name
    {
        en = "Small cart"
        es = "Carro pequeño"
    }
    // context: legend_cart_small_item.create.m.Description
    {
        en = "A small cart and donkey, excellent for carrying more things, but must be protected in battle."
        es = "Un carro pequeño con su burro, excelente para cargar más cosas, aunque hay que protegerlo en combate."
    }
    // FILE: scripts\items\spawns\legend_donkey_item.nut
    // en = "Donkey"
    // en base_es
    // context: legend_donkey_item.create.m.Description
    {
        en = "A donkey. Smelly, stubborn, drooling and eating your shirt right now."
        es = "Un burro. Apestoso, terco, babeante y comiéndose tu camisa ahora mismo."
    }
    // FILE: scripts\items\spawns\legend_skeleton_item.nut
    // context: legend_skeleton_item.create.m.Name
    {
        en = "Human Bones"
        es = "Huesos humanos"
    }
    // context: legend_skeleton_item.create.m.Description
    {
        en = "A pile of human bones picked perfectly clean. They creak and shudder at your presence, somehow conscious that you hold the power to rouse them once again. Requires diligent maintenance as brittle bones make poor means for your ends."
        es = "Un montón de huesos humanos limpios a la perfección. Crujen y se estremecen ante tu presencia, como si supieran que tienes el poder de volver a alzarlos. Requiere un mantenimiento diligente, pues los huesos quebradizos son un mal medio para tus fines."
    }
    // FILE: scripts\items\spawns\legend_spawn_item.nut
    // context: legend_spawn_item.getTooltip.desc
    {
        // local desc = this.getDescription() + " Requires [color=%negative%]" + this.getMedicinePerDay() + "[/color] units of medicine per day to maintain.";
        mode = "pattern"
        en = "<desc:str> Requires [color=%negative%]<medicine:int>[/color] units of medicine per day to maintain."
        es = "<desc> Requiere [color=%negative%]<medicine>[/color] unidades de medicina al día para su mantenimiento."
    }
    // en = "Usable in Combat"
    // en base_es
    // context: legend_spawn_item.getTooltip.result.push().text
    {
        // text = "Decayed [color=%negative%]" + (100 - this.m.Condition * 100) + "%[/color] due to lack of medical parts"
        mode = "pattern"
        en = "Decayed [color=%negative%]<pct:str>%[/color] due to lack of medical parts"
        es = "Se ha deteriorado un [color=%negative%]<pct>%[/color] por falta de suministros médicos"
    }
    // FILE: scripts\items\spawns\legend_zombie_item.nut
    // context: legend_zombie_item.create.m.Name
    {
        en = "Human Carrion"
        es = "Carroña humana"
    }
    // context: legend_zombie_item.create.m.Description
    {
        en = "A heap of human offal; limbs, skin, and gore, all salvaged from your fellow man, the perfect medium for your grim work. Requires constant preservation as the encroaching rot threatens to stall your efforts."
        es = "Un montón de despojos humanos: miembros, piel y vísceras, todo recuperado de tus semejantes, el medio perfecto para tu macabra labor. Requiere una conservación constante, pues la podredumbre que avanza amenaza con frenar tus esfuerzos."
    }
    // FILE: scripts\items\supplies\legend_ammo_small_item.nut
    // context: legend_ammo_small_item.create.m.Name
    {
        en = "Small Ammunition"
        es = "Poca munición"
    }
    // context: legend_ammo_small_item.getTooltip.result.text
    {
        // text = "A good [color=%positive%]" + this.m.Amount + "[/color] units of assorted ammunition - arrows, bolts and javelins. Used to automatically refill your quivers after battle. Will be added to your global stock once you\'re back on the worldmap."
        mode = "pattern"
        en = "A good [color=%positive%]<amount:int>[/color] units of assorted ammunition - arrows, bolts and javelins. Used to automatically refill your quivers after battle. Will be added to your global stock once you're back on the worldmap."
        es = "Unas buenas [color=%positive%]<amount>[/color] unidades de munición variada: flechas, virotes y jabalinas. Se usan para rellenar automáticamente tus carcajes después de la batalla. Se añadirán a tus reservas globales en cuanto vuelvas al mapa del mundo."
    }
    // FILE: scripts\items\supplies\legend_armor_parts_small_item.nut
    // context: legend_armor_parts_small_item.create.m.Name
    {
        en = "Small Tools and Supplies"
        es = "Pocas herramientas y suministros"
    }
    // context: legend_armor_parts_small_item.getTooltip.result.text
    {
        // text = "A good [color=%positive%]" + this.m.Amount + "[/color] assorted tools and supplies to repair weapons, armor, helmets and shields with after battle. Will be added to your global stock once you\'re back on the worldmap."
        mode = "pattern"
        en = "A good [color=%positive%]<amount:int>[/color] assorted tools and supplies to repair weapons, armor, helmets and shields with after battle. Will be added to your global stock once you're back on the worldmap."
        es = "Unas buenas [color=%positive%]<amount>[/color] herramientas y suministros variados para reparar armas, armaduras, yelmos y escudos después de la batalla. Se añadirán a tus reservas globales en cuanto vuelvas al mapa del mundo."
    }
    // FILE: scripts\items\supplies\legend_bear_meat_item.nut
    // context: legend_bear_meat_item.create.m.Name
    {
        en = "Bear Meat"
        es = "Carne de oso"
    }
    // context: legend_bear_meat_item.create.m.Description
    {
        en = "Provisions. Large chunks of foul smelling meat from a ferocious bear. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Grandes trozos de carne maloliente de un oso feroz. Se puede comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irá usando como provisiones si se deja en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_beef_item.nut
    // context: legend_beef_item.create.m.Name
    {
        en = "Beef"
        es = "Carne de vaca"
    }
    // context: legend_beef_item.create.m.Description
    {
        en = "Provisions. Luxurious slab of meat from an ox or cow. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Una lujosa pieza de carne de buey o vaca. Se puede comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irá usando como provisiones si se deja en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_boar_meat_item.nut
    // context: legend_boar_meat_item.create.m.Name
    {
        en = "Boar Meat"
        es = "Carne de jabalí"
    }
    // context: legend_boar_meat_item.create.m.Description
    {
        en = "Provisions. The rewards of a good hunt, savory meat from a wild boar. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. La recompensa de una buena cacería: sabrosa carne de jabalí. Se puede comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irá usando como provisiones si se deja en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_bug_meat_item.nut
    // context: legend_bug_meat_item.create.m.Name
    {
        en = "Bug Meat"
        es = "Carne de insecto"
    }
    // context: legend_bug_meat_item.create.m.Description
    {
        en = "Provisions. Disgusting fat writhing bugs... A pitiful meal sure to make any weep. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Bichos gordos y asquerosos que no paran de retorcerse... Una comida lamentable que haría llorar a cualquiera. Se pueden comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irán usando como provisiones si se dejan en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_clams_item.nut
    // context: legend_clams_item.create.m.Description
    {
        en = "Provisions. Shelled fish, a bit slimy but a filling meal favored by fishmongers. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Marisco con concha, algo baboso, pero una comida que llena y que gusta a los pescaderos. Se puede comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irá usando como provisiones si se deja en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_crab_meat_item.nut
    // context: legend_crab_meat_item.create.m.Description
    {
        en = "Provisions. Strange shelled fish with eight legs and a pair of claws. Tough but tasty once cooked. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Un extraño pez con caparazón, ocho patas y un par de pinzas. Duro, pero sabroso una vez cocinado. Se puede comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irá usando como provisiones si se deja en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_cured_rations_item.nut
    // context: legend_cured_rations_item.create.m.Name
    {
        en = "Poorly Cured Rations"
        es = "Raciones mal curadas"
    }
    // context: legend_cured_rations_item.create.m.Description
    {
        en = "These rations have been hastily made for the purpose of survival, not taste. They will serve the same purpose but are unlikely to get much of a price at a market. Can be eaten in battle to provide up to 5 healing and fatigue recovery over ten turns, based on the amount remaining. Will be used as provisions if left in the company stash."
        es = "Estas raciones se prepararon a toda prisa pensando en sobrevivir, no en el sabor. Cumplen la misma función, pero es poco probable que saquen buen precio en un mercado. Se pueden comer en combate para obtener hasta 5 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se usarán como provisiones si se dejan en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_curry_item.nut
    // context: legend_curry_item.create.m.Name
    {
        en = "Curry"
        es = "Curry"
    }
    // context: legend_curry_item.create.m.Description
    {
        en = "Provisions. A delicious meal. Can be eaten in battle to grant morale, and gradually restore health and fatigue over ten turns. The amount restored per turn is determined by how much of the curry remains when eaten."
        es = "Provisiones. Una comida deliciosa. Se puede comer en combate para ganar moral y recuperar poco a poco salud y fatiga durante diez turnos. La cantidad recuperada por turno depende de cuánto curry quede al comerlo."
    }
    // FILE: scripts\items\supplies\legend_dog_meat_item.nut
    // context: legend_dog_meat_item.create.m.Name
    {
        en = "Dog Meat"
        es = "Carne de perro"
    }
    // context: legend_dog_meat_item.create.m.Description
    {
        en = "Provisions. The meat of the desperate and poor... Or sick and depraved. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. La carne de los desesperados y los pobres... O de los enfermos y los depravados. Se puede comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irá usando como provisiones si se deja en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_fresh_dates_item.nut
    // context: legend_fresh_dates_item.create.m.Name
    {
        en = "Fresh Dates"
        es = "Dátiles frescos"
    }
    // context: legend_fresh_dates_item.create.m.Description
    {
        en = "Provisions. Sweet and delicious, dates are common in the South. Will not last long unless preserved. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Dulces y deliciosos, los dátiles son comunes en el Sur. No durarán mucho si no se conservan. Se pueden comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irán usando como provisiones si se dejan en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_fresh_fish_item.nut
    // context: legend_fresh_fish_item.create.m.Name
    {
        en = "Fresh Fish"
        es = "Pescado fresco"
    }
    // context: legend_fresh_fish_item.create.m.Description
    {
        en = "Provisions. Freshly caught and butchered, this fish tastes good but will not last long without curing. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Recién capturado y limpiado, este pescado sabe bien, pero no durará mucho si no se cura. Se puede comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irá usando como provisiones si se deja en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_fresh_fruit_item.nut
    // context: legend_fresh_fruit_item.create.m.Name
    {
        en = "Fresh Fruit"
        es = "Fruta fresca"
    }
    // context: legend_fresh_fruit_item.create.m.Description
    {
        en = "Provisions. Freshly picked, this fruit tastes great but will not last long. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Recién recolectada, esta fruta sabe de maravilla, pero no durará mucho. Se puede comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irá usando como provisiones si se deja en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_fresh_meat_item.nut
    // context: legend_fresh_meat_item.create.m.Name
    {
        en = "Fresh Meat"
        es = "Carne fresca"
    }
    // context: legend_fresh_meat_item.create.m.Description
    {
        en = "Provisions. Freshly caught and butchered, this meat tastes good but will not last long without curing. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Recién cazada y despiezada, esta carne sabe bien, pero no durará mucho si no se cura. Se puede comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irá usando como provisiones si se deja en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_fresh_milk_item.nut
    // context: legend_fresh_milk_item.create.m.Name
    {
        en = "Fresh Milk"
        es = "Leche fresca"
    }
    // context: legend_fresh_milk_item.create.m.Description
    {
        en = "Provisions. Freshly milked, it tastes good but will not last long without being turned into cheese. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Recién ordeñada, sabe bien, pero no durará mucho si no se convierte en queso. Se puede consumir en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irá usando como provisiones si se deja en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_fresh_mushrooms_item.nut
    // context: legend_fresh_mushrooms_item.create.m.Name
    {
        en = "Fresh Mushrooms"
        es = "Champiñones frescos"
    }
    // context: legend_fresh_mushrooms_item.create.m.Description
    {
        en = "Provisions. Mushrooms are aplenty in swampy regions. They will last much longer if preserved. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Los champiñones abundan en las regiones pantanosas. Duran mucho más si se conservan. Se pueden comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irán usando como provisiones si se dejan en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_fresh_poultry_item.nut
    // context: legend_fresh_poultry_item.create.m.Name
    {
        en = "Fresh Poultry"
        es = "Aves frescas"
    }
    // context: legend_fresh_poultry_item.create.m.Description
    {
        en = "Provisions. Game hens, pheasants and ducks. All make for a delightful meal or soup stock. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Gallinas de caza, faisanes y patos. Todos dan para una comida deliciosa o un buen caldo. Se pueden comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irán usando como provisiones si se dejan en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_fresh_roots_and_berries_item.nut
    // context: legend_fresh_roots_and_berries_item.create.m.Name
    {
        en = "Fresh Roots and Berries"
        es = "Raíces y bayas frescas"
    }
    // context: legend_fresh_roots_and_berries_item.create.m.Description
    {
        en = "Provisions. Fresh roots and berries are easy to find and fairly common, but require preservation to last longer. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Las raíces y bayas frescas son fáciles de encontrar y bastante comunes, pero hay que conservarlas para que duren más. Se pueden comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irán usando como provisiones si se dejan en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_human_parts.nut
    // context: legend_human_parts.create.m.Name
    {
        en = "Human Parts"
        es = "Despojos humanos"
    }
    // context: legend_human_parts.create.m.Description
    {
        en = "Provisions. Ehh.. you're not sure you should be eating this."
        es = "Provisiones. Eh... no tienes claro que debas comerte esto."
    }
    // FILE: scripts\items\supplies\legend_liquor_item.nut
    // context: legend_liquor_item.create.m.Name
    {
        en = "Liquor"
        es = "Licor"
    }
    // context: legend_liquor_item.create.m.Description
    {
        en = "Provisions. Can be consumed in battle to grant +12 resolve, melee and ranged skill. At the expense of -24 initiative and -12% melee defense and ranged defense, the effect lasts for two turns. Will be used as provisions while travelling if left in the company inventory."
        es = "Provisiones. Se puede consumir en combate para obtener +12 de Resolución, de habilidad cuerpo a cuerpo y de habilidad a distancia, a costa de -24 de Iniciativa y -12% de defensa cuerpo a cuerpo y a distancia. El efecto dura dos turnos. Se usará como provisiones durante los viajes si se deja en el inventario de la compañía."
    }
    // FILE: scripts\items\supplies\legend_medicine_small_item.nut
    // context: legend_medicine_small_item.create.m.Name
    {
        en = "Small Medical Supplies"
        es = "Pocos suministros médicos"
    }
    // context: legend_medicine_small_item.getTooltip.result.text
    {
        // text = "A good [color=%positive%]" + this.m.Amount + "[/color] units of herbs, salves, bandages and the like to help your mercenaries recover from injuries sustained in battle. Will be added to your global stock once you\'re back on the worldmap."
        mode = "pattern"
        en = "A good [color=%positive%]<amount:int>[/color] units of herbs, salves, bandages and the like to help your mercenaries recover from injuries sustained in battle. Will be added to your global stock once you're back on the worldmap."
        es = "Unas buenas [color=%positive%]<amount>[/color] unidades de hierbas, ungüentos, vendas y similares para ayudar a tus mercenarios a recuperarse de las heridas sufridas en combate. Se añadirán a tus reservas globales en cuanto vuelvas al mapa del mundo."
    }
    // FILE: scripts\items\supplies\legend_mutton_item.nut
    // context: legend_mutton_item.create.m.Name
    {
        en = "Mutton"
        es = "Carne de carnero"
    }
    // context: legend_mutton_item.create.m.Description
    {
        en = "Provisions. Tender meat from a goat or lamb, succulent and flavorful. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Carne tierna de cabra o cordero, suculenta y sabrosa. Se puede comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irá usando como provisiones si se deja en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_nuts_and_seeds_item.nut
    // context: legend_nuts_and_seeds_item.create.m.Description
    {
        en = "Provisions. Feast for a squirrel, well kept snack for any wayward traveller. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Un festín para una ardilla y un tentempié que se conserva bien para cualquier viajero errante. Se pueden comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irán usando como provisiones si se dejan en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_pie_item.nut
    // context: legend_pie_item.create.m.Name
    {
        en = "Pie"
        es = "Pastel"
    }
    // context: legend_pie_item.create.m.Description
    {
        en = "A large pie made from freshly sourced ingredients. Can be eaten in battle to provide up to 4 healing and fatigue recovery each turn for five turns, based on the amount remaining. Will be used as provisions if left in the company stash."
        es = "Un gran pastel hecho con ingredientes frescos. Se puede comer en combate para obtener hasta 4 de curación y recuperación de fatiga cada turno durante cinco turnos, según la cantidad restante. Se usará como provisiones si se deja en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_porridge_item.nut
    // context: legend_porridge_item.create.m.Description
    {
        en = "Provisions. A staple meal that can be made from whatever ingredients are to hand. Can be eaten in battle to provide up to 4 healing recovery each turn for ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Un plato básico que se puede preparar con lo que se tenga a mano. Se puede comer en combate para obtener hasta 4 de curación cada turno durante diez turnos, según la cantidad restante. Se irá usando como provisiones si se deja en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_pudding_item.nut
    // context: legend_pudding_item.create.m.Name
    {
        en = "Pudding"
        es = "Pudin"
    }
    // context: legend_pudding_item.create.m.Description
    {
        en = "Provisions. A huge pudding made from fresh ingredients. Can be eaten in battle to grant morale, and gradually restore health and fatigue over ten turns. The amount restored per turn is determined by how much of the pudding remains when eaten."
        es = "Provisiones. Un pudin enorme hecho con ingredientes frescos. Se puede comer en combate para ganar moral y recuperar poco a poco salud y fatiga durante diez turnos. La cantidad recuperada por turno depende de cuánto pudin quede al comerlo."
    }
    // FILE: scripts\items\supplies\legend_rabbit_meat_item.nut
    // context: legend_rabbit_meat_item.create.m.Name
    {
        en = "Rabbit Meat"
        es = "Carne de conejo"
    }
    // context: legend_rabbit_meat_item.create.m.Description
    {
        en = "Provisions. Common game meat, the perfect meal for peasant and poacher alike. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Carne de caza común, la comida perfecta tanto para campesinos como para cazadores furtivos. Se puede comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irá usando como provisiones si se deja en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_snake_meat_item.nut
    // context: legend_snake_meat_item.create.m.Name
    {
        en = "Snake Meat"
        es = "Carne de serpiente"
    }
    // context: legend_snake_meat_item.create.m.Description
    {
        en = "Provisions. Odd textured meat from a snake. Tastes like chicken? Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Carne de serpiente de textura extraña. ¿Sabe a pollo? Se puede comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irá usando como provisiones si se deja en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_squirrel_meat_item.nut
    // context: legend_squirrel_meat_item.create.m.Name
    {
        en = "Squirrel Meat"
        es = "Carne de ardilla"
    }
    // context: legend_squirrel_meat_item.create.m.Description
    {
        en = "Provisions. Tasty morsels of squirrel, once fattened on acorns make a decent meal. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Sabrosos bocados de ardilla que, una vez engordada a base de bellotas, dan para una comida decente. Se pueden comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irán usando como provisiones si se dejan en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_wolf_meat_item.nut
    // context: legend_wolf_meat_item.create.m.Name
    {
        en = "Wolf Meat"
        es = "Carne de lobo"
    }
    // context: legend_wolf_meat_item.create.m.Description
    {
        en = "Provisions. Foul smelling meat from the howling bane of shepherds. Can be eaten in battle to provide up to 1 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. Carne maloliente del aullador azote de los pastores. Se puede comer en combate para obtener hasta 1 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irá usando como provisiones si se deja en el alijo de la compañía."
    }
    // FILE: scripts\items\supplies\legend_yummy_sausages.nut
    // context: legend_yummy_sausages.create.m.Name
    {
        en = "Yummy Sausages"
        es = "Salchichas deliciosas"
    }
    // context: legend_yummy_sausages.create.m.Description
    {
        en = "Provisions. These sausages sure look yummy! Can be eaten in battle to provide up to 3 healing and fatigue recovery over ten turns, based on the amount remaining. Will be gradually used as provisions if left in the company stash."
        es = "Provisiones. ¡Estas salchichas tienen una pinta deliciosa! Se pueden comer en combate para obtener hasta 3 de curación y recuperación de fatiga durante diez turnos, según la cantidad restante. Se irán usando como provisiones si se dejan en el alijo de la compañía."
    }
    // FILE: scripts\items\tents\legend_tent_craft.nut
    // context: legend_tent_craft.create.m.Name
    {
        en = "Craft Tent"
        es = "Tienda de artesanía"
    }
    // context: legend_tent_craft.create.m.Description
    {
        en = "A tent for storing and processing crafting supplies. Comes with the sewing equipment, bottles and mundane ingredients used in crafting. Having this in your stash upgrades your camp."
        es = "Una tienda para guardar y procesar suministros de fabricación. Incluye el equipo de costura, las botellas y los ingredientes corrientes que se usan para fabricar. Tenerla en el alijo mejora tu campamento."
    }
    // FILE: scripts\items\tents\legend_tent_enchant.nut
    // context: legend_tent_enchant.create.m.Name
    {
        en = "Enchanter's Tent"
        es = "Tienda del encantador"
    }
    // context: legend_tent_enchant.create.m.Description
    {
        en = "A tent for storing and processing rune stones. Comes with the stones, chisels and songbooks used for enchanting. Having this in your stash upgrades your camp."
        es = "Una tienda para guardar y trabajar piedras rúnicas. Incluye las piedras, los cinceles y los cancioneros que se usan para encantar. Tenerla en el alijo mejora tu campamento."
    }
    // FILE: scripts\items\tents\legend_tent_fletcher.nut
    // context: legend_tent_fletcher.create.m.Name
    {
        en = "Fletcher's Tent"
        es = "Tienda del flechero"
    }
    // context: legend_tent_fletcher.create.m.Description
    {
        en = "Cloth tent woven from hemp and wood, comes with feathers, shafts, arrow heads and bindings. Having this in your stash upgrades your camp."
        es = "Tienda de tela de cáñamo y madera; incluye plumas, astiles, puntas de flecha y ataduras. Tenerla en el alijo mejora tu campamento."
    }
    // FILE: scripts\items\tents\legend_tent_gather.nut
    // context: legend_tent_gather.create.m.Name
    {
        en = "Gatherer's tools"
        es = "Herramientas del recolector"
    }
    // context: legend_tent_gather.create.m.Description
    {
        en = "A collection of tools for gathering plants, comes with shelves, woven baskets, sickles, drying racks and bags. Having this in your stash upgrades your camp."
        es = "Un conjunto de herramientas para recolectar plantas; incluye estantes, cestas de mimbre, hoces, secaderos y bolsas. Tenerlo en el alijo mejora tu campamento."
    }
    // FILE: scripts\items\tents\legend_tent_heal.nut
    // context: legend_tent_heal.create.m.Name
    {
        en = "Healer's Tent"
        es = "Tienda del sanador"
    }
    // context: legend_tent_heal.create.m.Description
    {
        en = "Cloth tent woven from sheep wool and wood, comes with healer tools, salves and cots. Having this in your stash upgrades your camp, increasing your healing rate and reducing medicine consumption."
        es = "Tienda de tela de lana de oveja y madera; incluye instrumental de sanador, ungüentos y catres. Tenerla en el alijo mejora tu campamento: aumenta la velocidad de curación y reduce el consumo de medicina."
    }
    // FILE: scripts\items\tents\legend_tent_hunter.nut
    // context: legend_tent_hunter.create.m.Name
    {
        en = "Kitchen Tent"
        es = "Tienda de cocina"
    }
    // context: legend_tent_hunter.create.m.Description
    {
        en = "A collection of tools and equipment for hunting and cooking. Having this in your stash upgrades your camp, allowing skilled backgrounds to produce food, alcohol and treats"
        es = "Un conjunto de herramientas y equipo para cazar y cocinar. Tenerlo en el alijo mejora tu campamento y permite que los trasfondos cualificados produzcan comida, alcohol y golosinas"
    }
    // FILE: scripts\items\tents\legend_tent_repair.nut
    // context: legend_tent_repair.create.m.Description
    {
        en = "Wooden cart for carrying tools, comes with sharpening wheel, tools and anvil. Having this in your stash upgrades your camp, increasing repair speed and reducing repair costs"
        es = "Carro de madera para transportar herramientas; incluye piedra de afilar, herramientas y yunque. Tenerlo en el alijo mejora tu campamento: aumenta la velocidad de reparación y reduce su coste"
    }
    // FILE: scripts\items\tents\legend_tent_scout.nut
    // context: legend_tent_scout.create.m.Name
    {
        en = "Scout's station"
        es = "Puesto del explorador"
    }
    // context: legend_tent_scout.create.m.Description
    {
        en = "A station for organising scouting parties, comes with maps, compasses and spyglasses. Having this in your stash upgrades your camp."
        es = "Un puesto para organizar partidas de exploración; incluye mapas, brújulas y catalejos. Tenerlo en el alijo mejora tu campamento."
    }
    // FILE: scripts\items\tents\legend_tent_scrap.nut
    // context: legend_tent_scrap.create.m.Name
    {
        en = "Scrap Tent"
        es = "Tienda de chatarra"
    }
    // context: legend_tent_scrap.create.m.Description
    {
        en = "One mercenary's trash is another's treasure. This collection of spare parts will help you turn broken armor and weapons into usable armor scraps and tools. Having this in your stash upgrades your camp."
        es = "La basura de un mercenario es el tesoro de otro. Este conjunto de piezas de repuesto te ayudará a convertir armaduras y armas rotas en restos de armadura y herramientas aprovechables. Tenerlo en el alijo mejora tu campamento."
    }
    // FILE: scripts\items\tents\legend_tent_train.nut
    // context: legend_tent_train.create.m.Name
    {
        en = "Training equipment"
        es = "Equipo de entrenamiento"
    }
    // context: legend_tent_train.create.m.Description
    {
        en = "A collection of equipment for training mercenaries, comes with a training dummy, wooden weapons and ring pegs. Having this in your stash upgrades your camp."
        es = "Un conjunto de equipo para entrenar mercenarios; incluye un muñeco de entrenamiento, armas de madera y estacas con anillas. Tenerlo en el alijo mejora tu campamento."
    }
    // FILE: scripts\items\tools\legend_broken_throwing_net.nut
    // context: legend_broken_throwing_net.create.m.Description
    {
        en = "A broken net that may be repaired if you have the knowledge, or sold for scrap"
        es = "Una red rota que se puede reparar si tienes los conocimientos, o vender como chatarra"
    }
    // context: legend_broken_throwing_net.getTooltip.result.push().text
    {
        en = "Cannot be equipped until fixed"
        es = "No se puede equipar hasta que se repare"
    }
    // FILE: scripts\items\tools\legend_unhold_throwing_net.nut
    // context: legend_unhold_throwing_net.create.m.Name
    {
        en = "Unhold bindings"
        es = "Ataduras de trol"
    }
    // context: legend_unhold_throwing_net.create.m.Description
    {
        en = "A net provided by barbarian tribe, used to bind unholds. Tainted with secret poison, it makes [color=%negative%]dazed[/color], [color=%negative%]baffled[/color] or with less than 25% Healthpoints Unholds docile when trapped."
        es = "Una red proporcionada por una tribu bárbara, usada para atar troles. Impregnada de un veneno secreto, vuelve dóciles al quedar atrapados a los Troles [color=%negative%]atontados[/color], [color=%negative%]desconcertados[/color] o con menos del 25% de Puntos de vida."
    }
    // context: legend_unhold_throwing_net.getTooltip.result.push().text
    {
        en = "Will root a [color=%negative%]dazed[/color], [color=%negative%]baffled[/color] or with less than 25% Healthpoints Unhold in place and make it docile"
        es = "Inmoviliza a un Trol [color=%negative%]atontado[/color], [color=%negative%]desconcertado[/color] o con menos del 25% de Puntos de vida y lo vuelve dócil"
    }
    // en = "Is destroyed on use"
    // en base_es
    // FILE: scripts\items\trade\legend_cooking_spices_trade_item.nut
    // context: legend_cooking_spices_trade_item.create.m.Name
    {
        en = "Cooking Spices"
        es = "Especias de cocina"
    }
    // context: legend_cooking_spices_trade_item.create.m.Description
    {
        en = "Combining salts, dried herbs and roots. Can be combined with other food in the crafting tent to cook recipes"
        es = "Una mezcla de sales, hierbas secas y raíces. Se puede combinar con otros alimentos en la tienda de fabricación para cocinar recetas"
    }
    // context: legend_cooking_spices_trade_item.getTooltip.result.push().text
    {
        en = "Can be used in recipes 8 times"
        es = "Se puede usar en recetas 8 veces"
    }
    // context: legend_cooking_spices_trade_item.getTooltip.result.push().text
    {
        // text = "Uses remaining: " + this.m.Uses + "/8"
        mode = "pattern"
        en = "Uses remaining: <uses:int>/8"
        es = "Usos restantes: <uses>/8"
    }
    // FILE: scripts\items\trade\legend_gem_shards_item.nut
    // context: legend_gem_shards_item.create.m.Name
    {
        en = "Gem Shards"
        es = "Fragmentos de gemas"
    }
    // context: legend_gem_shards_item.create.m.Description
    {
        en = "Rough gemstones too broken to be cut and polished. "
        es = "Gemas en bruto demasiado rotas para tallarlas y pulirlas. "
    }
    // FILE: scripts\items\trade\legend_gold_dust_item.nut
    // context: legend_gold_dust_item.create.m.Name
    {
        en = "Gold Dust"
        es = "Polvo de oro"
    }
    // context: legend_gold_dust_item.create.m.Description
    {
        en = "A small pile of gold dust used for decoration or smelting, worth something to the right buyer"
        es = "Un pequeño montón de polvo de oro que se usa para decorar o fundir; vale algo para el comprador adecuado"
    }
    // FILE: scripts\items\trade\legend_gold_ingots_item.nut
    // context: legend_gold_ingots_item.create.m.Name
    {
        en = "Gold Ingots"
        es = "Lingotes de oro"
    }
    // context: legend_gold_ingots_item.create.m.Description
    {
        en = "Gold smolten and cast into ingots for easy transportation. Traders will pay good coin for this."
        es = "Oro fundido y vertido en lingotes para transportarlo con facilidad. Los comerciantes pagarán buen dinero por esto."
    }
    // FILE: scripts\items\trade\legend_gold_nugget_item.nut
    // context: legend_gold_nugget_item.create.m.Name
    {
        en = "Gold Nugget"
        es = "Pepita de oro"
    }
    // context: legend_gold_nugget_item.create.m.Description
    {
        en = "A sizeable nugget of gold, traders will pay good coin for this."
        es = "Una pepita de oro de buen tamaño; los comerciantes pagarán buen dinero por ella."
    }
    // FILE: scripts\items\trade\legend_iron_ingots_item.nut
    // context: legend_iron_ingots_item.create.m.Name
    {
        en = "Iron Ingots"
        es = "Lingotes de hierro"
    }
    // context: legend_iron_ingots_item.create.m.Description
    {
        en = "Iron smolten and cast into ingots for easy transportation. Traders will pay good coin for this."
        es = "Hierro fundido y vertido en lingotes para transportarlo con facilidad. Los comerciantes pagarán buen dinero por esto."
    }
    // FILE: scripts\items\trade\legend_raw_wood_item.nut
    // context: legend_raw_wood_item.create.m.Name
    {
        en = "Raw Wood"
        es = "Madera en bruto"
    }
    // context: legend_raw_wood_item.create.m.Description
    {
        en = "Freshly cut unfinished wood"
        es = "Madera recién cortada y sin trabajar"
    }
    // FILE: scripts\items\trade\legend_seashells_item.nut
    // context: legend_seashells_item.create.m.Name
    {
        en = "Sea shells"
        es = "Conchas marinas"
    }
    // context: legend_seashells_item.create.m.Description
    {
        en = "Pretty sea shells used in cheap necklaces and rings, often collected while looking for amber on beaches. Folks inland will pay something for these"
        es = "Bonitas conchas marinas que se usan en collares y anillos baratos; a menudo se recogen mientras se busca ámbar en las playas. La gente del interior pagará algo por ellas"
    }
    // FILE: scripts\items\trade\legend_silver_ingots_item.nut
    // context: legend_silver_ingots_item.create.m.Name
    {
        en = "Silver Ingots"
        es = "Lingotes de plata"
    }
    // context: legend_silver_ingots_item.create.m.Description
    {
        en = "Silver smolten and cast into ingots for easy transportation. Traders will pay good coin for this."
        es = "Plata fundida y vertida en lingotes para transportarla con facilidad. Los comerciantes pagarán buen dinero por esto."
    }
    // FILE: scripts\items\trade\legend_small_furs_item.nut
    // context: legend_small_furs_item.create.m.Name
    {
        en = "Fur Scraps"
        es = "Retales de piel"
    }
    // context: legend_small_furs_item.create.m.Description
    {
        en = "Furs from small wild animals, and offcuts from larger skins"
        es = "Pieles de pequeños animales salvajes y recortes de pieles más grandes"
    }
    // FILE: scripts\items\trade\legend_tin_ingots_item.nut
    // context: legend_tin_ingots_item.create.m.Name
    {
        en = "Tin Ingot"
        es = "Lingote de estaño"
    }
    // context: legend_tin_ingots_item.create.m.Description
    {
        en = "Tin smolten and cast into an ingot for easy transportation. Used together with Copper to make Bronze."
        es = "Estaño fundido y vertido en un lingote para transportarlo con facilidad. Se usa junto con el cobre para hacer bronce."
    }
    // FILE: scripts\items\trade\legend_wax_item.nut
    // context: legend_wax_item.create.m.Name
    {
        en = "Wax"
        es = "Cera"
    }
    // context: legend_wax_item.create.m.Description
    {
        en = "Beeswax has a variety of uses in food preservation and candle making. Traders will pay good coin for this."
        es = "La cera de abeja tiene múltiples usos en la conservación de alimentos y la fabricación de velas. Los comerciantes pagarán buen dinero por esto."
    }
    // FILE: scripts\items\weapons\ancient\legend_broad_warscythe.nut
    // context: legend_broad_warscythe.create.m.Name
    {
        en = "Ancient Broad Warscythe"
        es = "Guadaña de guerra ancha antigua"
    }
    // context: legend_broad_warscythe.create.m.Description
    {
        en = "A broad and heavy warscythe, characterised by a much longer blade. This weapon demands much room to use and is difficult to wield, but the havoc it can cause against attackers on both two legs or four is unparalleled."
        es = "Una guadaña de guerra ancha y pesada, caracterizada por una hoja mucho más larga. Esta arma exige mucho espacio y es difícil de manejar, pero los estragos que puede causar entre los atacantes, vayan a dos patas o a cuatro, no tienen parangón."
    }
    // FILE: scripts\items\weapons\ancient\legend_broadhead_spear.nut
    // context: legend_broadhead_spear.create.m.Name
    {
        en = "Ancient Broadhead Spear"
        es = "Lanza de punta ancha antigua"
    }
    // context: legend_broadhead_spear.create.m.Description
    {
        en = "A larger, broader ancient spear with a leaf-shaped head. It is much heavier than it's counterparts, but leaves a significantly larger wound at the cost of penetrating power."
        es = "Una lanza antigua más grande y ancha, con punta en forma de hoja. Es mucho más pesada que sus homólogas, pero abre heridas considerablemente mayores a costa de perder capacidad de penetración."
    }
    // FILE: scripts\items\weapons\ancient\legend_broken_decorated_sword.nut
    // context: legend_broken_decorated_sword.create.m.Name
    {
        en = "Broken Ancient Decorated Sword"
        es = "Espada decorada antigua rota"
    }
    // context: legend_broken_decorated_sword.create.m.Description
    {
        en = "A broken ceremonial sword with few sharp edges outside of the breakpoint. It is, however, still more than a lethal weapon in the hands of a cunning fighter."
        es = "Una espada ceremonial rota con pocos bordes afilados aparte del punto de rotura. Aun así, sigue siendo un arma más que letal en manos de un luchador astuto."
    }
    // FILE: scripts\items\weapons\ancient\legend_broken_spatha.nut
    // context: legend_broken_spatha.create.m.Name
    {
        en = "Broken Ancient Royal Sword"
        es = "Espada real antigua rota"
    }
    // context: legend_broken_spatha.create.m.Description
    {
        en = "A broken and heavy sword that has snapped despite it's durability. The damage of this blade has only converted it into a killing tool of a different form."
        es = "Una espada pesada y rota que se partió pese a su resistencia. El daño sufrido por esta hoja solo la ha convertido en una herramienta para matar de otra forma."
    }
    // FILE: scripts\items\weapons\ancient\legend_decorated_crypt_cleaver.nut
    // context: legend_decorated_crypt_cleaver.create.m.Name
    {
        en = "Decorated Crypt Cleaver"
        es = "Cuchilla de cripta decorada"
    }
    // context: legend_decorated_crypt_cleaver.create.m.Description
    {
        en = "A light, ceremonial version of a two-handed cleaver with a curved end, adorned with gold inlay and odd motifs."
        es = "Una versión ligera y ceremonial de una cuchilla a dos manos con el extremo curvo, adornada con incrustaciones de oro y extraños motivos."
    }
    // FILE: scripts\items\weapons\ancient\legend_decorated_rhomphaia.nut
    // context: legend_decorated_rhomphaia.create.m.Name
    {
        en = "Decorated Rhomphaia"
        es = "Rhomphaia decorada"
    }
    // context: legend_decorated_rhomphaia.create.m.Description
    {
        en = "A long curved blade adorned with gold inlays depicting a variety of subjects from harvests to battles. It is a much lighter weapon than expected and clearly served a ceremonial purpose."
        es = "Una larga hoja curva adornada con incrustaciones de oro que representan escenas variadas, desde cosechas hasta batallas. Es un arma mucho más ligera de lo esperado y claramente tuvo un propósito ceremonial."
    }
    // FILE: scripts\items\weapons\ancient\legend_decorated_sword.nut
    // context: legend_decorated_sword.create.m.Name
    {
        en = "Ancient Decorated Sword"
        es = "Espada decorada antigua"
    }
    // context: legend_decorated_sword.create.m.Description
    {
        en = "A straight blade of ancient origin. The grip and pommel are decorated and more effort has been made to hone the blade's balance, despite it's clearly ceremonial purposes."
        es = "Una hoja recta de origen antiguo. La empuñadura y el pomo están decorados, y se ha puesto más empeño en afinar el equilibrio de la hoja, pese a su propósito claramente ceremonial."
    }
    // FILE: scripts\items\weapons\ancient\legend_fan_axe.nut
    // context: legend_fan_axe.create.m.Name
    {
        en = "Ancient Fan Axe"
        es = "Hacha de abanico antigua"
    }
    // context: legend_fan_axe.create.m.Description
    {
        en = "A long, two-handed axe that doubles as a very heavy fan"
        es = "Un hacha larga a dos manos que también sirve de abanico muy pesado"
    }
    // FILE: scripts\items\weapons\ancient\legend_gladius.nut
    // context: legend_gladius.create.m.Name
    {
        en = "Ancient Gladius"
        es = "Gladius antiguo"
    }
    // context: legend_gladius.create.m.Description
    {
        en = "A straight blade of ancient origin. The grip and pommel are very plain, from a simpler time."
        es = "Una hoja recta de origen antiguo. La empuñadura y el pomo son muy sencillos, propios de una época más simple."
    }
    // FILE: scripts\items\weapons\ancient\legend_great_khopesh.nut
    // context: legend_great_khopesh.create.m.Name
    {
        en = "Great Khopesh"
        es = "Gran khopesh"
    }
    // context: legend_great_khopesh.create.m.Description
    {
        en = "With the weight and size like the leg of a large animal this mysterious weapon is both large as it is intimidating. Its outside curved edge bares a sharpness that makes it whistle through the air when swung."
        es = "Con el peso y el tamaño de la pata de un animal grande, esta misteriosa arma es tan grande como intimidante. Su filo curvo exterior es tan agudo que silba al cortar el aire."
    }
    // FILE: scripts\items\weapons\ancient\legend_honed_warscythe.nut
    // context: legend_honed_warscythe.create.m.Name
    {
        en = "Ancient Honed Warscythe"
        es = "Guadaña de guerra afilada antigua"
    }
    // context: legend_honed_warscythe.create.m.Description
    {
        en = "A warscythe with a leaner, more curved blade that is ideal against single targets. What it lacks in stopping power it makes up for in weight and accuracy."
        es = "Una guadaña de guerra de hoja más fina y curva, ideal contra objetivos individuales. Lo que le falta en contundencia lo compensa con peso y precisión."
    }
    // FILE: scripts\items\weapons\ancient\legend_kopis.nut
    // context: legend_kopis.create.m.Name
    {
        en = "Kopis"
        es = "Kopis"
    }
    // context: legend_kopis.create.m.Description
    {
        en = "A lightweight, curved sword good at piercing armor and delivering wicked strikes."
        es = "Una espada curva y ligera, buena para perforar armaduras y asestar golpes brutales."
    }
    // FILE: scripts\items\weapons\ancient\legend_military_crypt_cleaver.nut
    // context: legend_military_crypt_cleaver.create.m.Name
    {
        en = "Military Crypt Cleaver"
        es = "Cuchilla de cripta militar"
    }
    // context: legend_military_crypt_cleaver.create.m.Description
    {
        en = "A significantly hefty two-handed cleaver with a recurved end. Despite being worn and blunted, the titanic weight of this weapon makes up for it's age."
        es = "Una cuchilla a dos manos considerablemente pesada, con el extremo recurvado. Aunque está gastada y roma, el titánico peso de esta arma compensa su edad."
    }
    // FILE: scripts\items\weapons\ancient\legend_military_rhomphaia.nut
    // context: legend_military_rhomphaia.create.m.Description
    {
        en = "A straighter, heavier than usual Rhomphaia that appears to be specially constructed and refined for dueling. This weapon lacks a reaping edge but is significantly easier to handle, despite it's weight."
        es = "Una Rhomphaia más recta y pesada de lo habitual que parece construida y refinada expresamente para el duelo. Esta arma carece de filo de siega, pero es mucho más fácil de manejar pese a su peso."
    }
    // FILE: scripts\items\weapons\ancient\legend_oxtongue_spear.nut
    // context: legend_oxtongue_spear.create.m.Name
    {
        en = "Ancient Ox Tongue Spear"
        es = "Lanza lengua de buey antigua"
    }
    // context: legend_oxtongue_spear.create.m.Description
    {
        en = "A double edged spear with a sleek yet wide profile compared to other spears, it excels at penetrating armour whilst remaining light enough for skirmishing."
        es = "Una lanza de doble filo con un perfil esbelto pero ancho en comparación con otras lanzas; destaca perforando armaduras sin dejar de ser lo bastante ligera para las escaramuzas."
    }
    // FILE: scripts\items\weapons\ancient\legend_royal_lance.nut
    // context: legend_royal_lance.create.m.Name
    {
        en = "Royal Lance"
        es = "Lanzón real"
    }
    // context: legend_royal_lance.create.m.Description
    {
        en = "Well crafted and withstanding age this spear manages to impress craftsmen even today. Used for thrusting over some distance and keeping the enemy at bay."
        es = "Bien forjada y resistente al paso del tiempo, esta lanza sigue impresionando a los artesanos hoy en día. Se usa para dar estocadas a cierta distancia y mantener a raya al enemigo."
    }
    // FILE: scripts\items\weapons\ancient\legend_sica.nut
    // context: legend_sica.create.m.Name
    {
        en = "Ancient Sica"
        es = "Sica antigua"
    }
    // context: legend_sica.create.m.Description
    {
        en = "An ancient weapon resembling a mix between a short sword and a large dagger. It's original purpose has been lost to time, but it's intended purpose still has staying power."
        es = "Un arma antigua que parece una mezcla entre espada corta y daga grande. Su propósito original se perdió con el tiempo, pero la función para la que se concibió sigue vigente."
    }
    // FILE: scripts\items\weapons\ancient\legend_spatha.nut
    // context: legend_spatha.create.m.Name
    {
        en = "Ancient Royal Sword"
        es = "Espada real antigua"
    }
    // context: legend_spatha.create.m.Description
    {
        en = "A simple yet deadly straight sword held by Centurions for the purpose of cutting through several attackers in a single day. It's durability lies in the weight whilst lacking armour piercing advantages."
        es = "Una espada recta, sencilla pero letal, que portaban los centuriones para abrirse paso entre varios atacantes en un solo día. Su resistencia reside en su peso, aunque carece de ventajas para perforar armaduras."
    }
    // FILE: scripts\items\weapons\barbarians\legend_barbarian_sling.nut
    // context: legend_barbarian_sling.create.m.Name
    {
        en = "Wild Sling"
        es = "Honda salvaje"
    }
    // context: legend_barbarian_sling.create.m.Description
    {
        en = "A crude and heavy sling, for hurling rocks at your rivals. With stones abundant everywhere, it will never run out of ammunition."
        es = "Una honda tosca y pesada para lanzar piedras a tus rivales. Con piedras por todas partes, nunca se quedará sin munición."
    }
    // FILE: scripts\items\weapons\greenskins\legend_blowgun.nut
    // context: legend_blowgun.create.m.Name
    {
        en = "Blowgun"
        es = "Cerbatana"
    }
    // context: legend_blowgun.create.m.Description
    {
        en = "A hollowed out reed used to shoot (toxic) darts. "
        es = "Una caña hueca para disparar dardos (tóxicos). "
    }
    // FILE: scripts\items\weapons\greenskins\legend_bone_carver.nut
    // context: legend_bone_carver.create.m.Name
    {
        en = "Bone Carver"
        es = "Tallahuesos"
    }
    // context: legend_bone_carver.create.m.Description
    {
        en = "A sharpened stone head secured to a large bone. Not well suited for human hands."
        es = "Una cabeza de piedra afilada sujeta a un hueso grande. No es muy adecuada para manos humanas."
    }
    // FILE: scripts\items\weapons\greenskins\legend_bough.nut
    // context: legend_bough.create.m.Name
    {
        en = "Bough"
        es = "Rama gruesa"
    }
    // context: legend_bough.create.m.Description
    {
        en = "Almost a whole tree uprooted, haphazardly reinforced with protruding iron rivets. Too heavy to be used effectively by the average human."
        es = "Casi un árbol entero arrancado de raíz, reforzado de cualquier manera con remaches de hierro que sobresalen. Demasiado pesado para que un humano normal lo use con eficacia."
    }
    // FILE: scripts\items\weapons\greenskins\legend_goblin_infantry_axe.nut
    // context: legend_goblin_infantry_axe.create.m.Name
    {
        en = "Goblin Harrier Axe"
        es = "Hacha de hostigador goblin"
    }
    // context: legend_goblin_infantry_axe.create.m.Description
    {
        en = "A relatively small blade on a very long shaft used to deliver quick devastating attacks."
        es = "Una hoja relativamente pequeña sobre un mango muy largo que sirve para lanzar ataques rápidos y devastadores."
    }
    // en = "Axe, Two-Handed"
    // en base_es
    // FILE: scripts\items\weapons\greenskins\legend_limb_lopper.nut
    // context: legend_limb_lopper.create.m.Name
    {
        en = "Limb Lopper"
        es = "Cortamiembros"
    }
    // context: legend_limb_lopper.create.m.Description
    {
        en = "A colossal cleaving weapon made of several overlapping crude blades wedged into a tree limb. Too heavy to be used effectively by the average human."
        es = "Un arma colosal de tajo hecha con varias hojas toscas superpuestas, encajadas en una rama de árbol. Demasiado pesada para que un humano normal la use con eficacia."
    }
    // FILE: scripts\items\weapons\greenskins\legend_man_mangler.nut
    // context: legend_man_mangler.create.m.Name
    {
        en = "Man Mangler"
        es = "Destrozahombres"
    }
    // context: legend_man_mangler.create.m.Description
    {
        en = "A massive, crudely sharpened shard of metal that makes up for its stunted length through sheer weight. So heavy no average human can use it effectively."
        es = "Un enorme fragmento de metal toscamente afilado que compensa su escasa longitud con puro peso. Tan pesado que ningún humano normal puede usarlo con eficacia."
    }
    // FILE: scripts\items\weapons\greenskins\legend_meat_hacker.nut
    // context: legend_meat_hacker.create.m.Name
    {
        en = "Meat Hacker"
        es = "Tajacarnes"
    }
    // context: legend_meat_hacker.create.m.Description
    {
        en = "A long shard of sharpened rock firmly wedged into a massive bone. Not well suited for human hands. "
        es = "Un largo fragmento de roca afilada firmemente encajado en un hueso enorme. No es muy adecuado para manos humanas. "
    }
    // FILE: scripts\items\weapons\greenskins\legend_orc_throwing_spear.nut
    // context: legend_orc_throwing_spear.create.m.Name
    {
        en = "Crude Throwing Spear"
        es = "Lanza arrojadiza tosca"
    }
    // context: legend_orc_throwing_spear.create.m.Description
    {
        en = "Crudely made light throwing spear, this weapon is intended to be thrown over short distances. The tip will bend on impact, potentially rendering shields unusable. Can be used against unshielded opponents as well for great effect."
        es = "Lanza arrojadiza ligera de factura tosca, pensada para lanzarse a corta distancia. La punta se dobla al impactar y puede inutilizar los escudos. También resulta muy eficaz contra oponentes sin escudo."
    }
    // FILE: scripts\items\weapons\greenskins\legend_skin_flayer.nut
    // context: legend_skin_flayer.create.m.Name
    {
        en = "Skin Flayer"
        es = "Desollador"
    }
    // context: legend_skin_flayer.create.m.Description
    {
        en = "A razor sharp length of crude metal with a wrapped grip. Not well suited for human hands."
        es = "Una tira de metal tosco, afilada como una navaja, con la empuñadura envuelta. Poco adecuada para manos humanas."
    }
    // FILE: scripts\items\weapons\greenskins\legend_skullbreaker.nut
    // context: legend_skullbreaker.create.m.Name
    {
        en = "Skull Breaker"
        es = "Quiebracráneos"
    }
    // context: legend_skullbreaker.create.m.Description
    {
        en = "A massive crude hammer with a head fashioned from a chunk of solid iron. Too heavy to be used effectively by the average human."
        es = "Un enorme martillo tosco con una cabeza hecha de un trozo de hierro macizo. Demasiado pesado para ser utilizado eficazmente por un humano promedio."
    }
    // FILE: scripts\items\weapons\greenskins\legend_skullsmasher.nut
    // context: legend_skullsmasher.create.m.Name
    {
        en = "Skull Smasher"
        es = "Machacacráneos"
    }
    // context: legend_skullsmasher.create.m.Description
    {
        en = "A massive crude hammer with a head fashioned from a chunk of solid iron. Not well suited for human hands."
        es = "Un enorme martillo tosco con una cabeza hecha de un trozo de hierro macizo. Poco adecuado para manos humanas."
    }
    // FILE: scripts\items\weapons\legend_battle_glaive.nut
    // context: legend_battle_glaive.create.m.Name
    {
        en = "Battle Glaive"
        es = "Guja de batalla"
    }
    // context: legend_battle_glaive.create.m.Description
    {
        en = "A long and sturdy glaive built for heavy combat, used to thrust, deal sweeping strikes over some distance and slashes in close range."
        es = "Una guja larga y robusta hecha para el combate duro; sirve para dar estocadas, asestar golpes amplios a cierta distancia y dar tajos en el cuerpo a cuerpo."
    }
    // FILE: scripts\items\weapons\legend_cat_o_nine_tails.nut
    // context: legend_cat_o_nine_tails.create.m.Name
    {
        en = "Cat o nine tails"
        es = "Gato de nueve colas"
    }
    // context: legend_cat_o_nine_tails.create.m.Description
    {
        en = "A short leather whip with multiple heads, used for punishment not fighting"
        es = "Un látigo corto de cuero con varias colas, hecho para castigar, no para pelear"
    }
    // FILE: scripts\items\weapons\legend_chain.nut
    // context: legend_chain.create.m.Name
    {
        // El extractor lo dejó solo como clave o ID interno, que Rosetta no toca.
        en = "Chain"
        es = "Cadena"
    }
    // context: legend_chain.create.m.Description
    {
        en = "A length of intertwined metal links. As a weapon it's ungainly and rather unpredictable but useful to spin, strike around shield cover and pull in enemies."
        es = "Un tramo de eslabones de metal entrelazados. Como arma es torpe y bastante impredecible, pero útil para hacerla girar, golpear rodeando la cobertura del escudo y atraer a los enemigos."
    }
    // FILE: scripts\items\weapons\legend_crusader_sword.nut
    // context: legend_crusader_sword.create.m.Name
    {
        en = "Crusader Sword"
        es = "Espada de cruzado"
    }
    // context: legend_crusader_sword.create.m.Description
    {
        en = "A two-handed holy sword. Almost perfectly balanced and honed, it has no equal as it hunts the heads of the wicked."
        es = "Una espada sagrada a dos manos. Casi perfectamente equilibrada y afilada, no tiene igual cuando va a la caza de las cabezas de los malvados."
    }
    // FILE: scripts\items\weapons\legend_dilapitated_sling.nut
    // context: legend_dilapitated_sling.create.m.Name
    {
        en = "Dilapitated Sling"
        es = "Honda desvencijada"
    }
    // context: legend_dilapitated_sling.create.m.Description
    {
        en = "A very simple sling, for hurling rocks at your rivals. Time and use have taken it's toll on this item and you're surprised it doesn't fall apart. With stones abundant everywhere, it will never run out of ammunition."
        es = "Una honda muy sencilla para lanzar piedras a tus rivales. El tiempo y el uso le han pasado factura y te sorprende que no se caiga a pedazos. Con piedras de sobra por todas partes, nunca se quedará sin munición."
    }
    // FILE: scripts\items\weapons\legend_drum.nut
    // en = "Drum"
    // en base_es
    // context: legend_drum.create.m.Description
    {
        en = "A musical instrument, can produce inspiring rythms, if you have the skill. The drum sticks make weak maces in a pinch."
        es = "Un instrumento musical que puede producir ritmos inspiradores, si tienes la habilidad. En un apuro, las baquetas sirven de mazas débiles."
    }
    // FILE: scripts\items\weapons\legend_grisly_scythe.nut
    // context: legend_grisly_scythe.create.m.Name
    {
        en = "Grisly Scythe"
        es = "Guadaña espantosa"
    }
    // context: legend_grisly_scythe.create.m.Description
    {
        en = "While looking like a regular agricultural tool from a distance, this scythe has an otherworldy aura that draws you in. Resurrects humans it kills, if they aren't too damaged."
        es = "Aunque de lejos parece una herramienta agrícola corriente, esta guadaña tiene un aura de otro mundo que te atrae. Resucita a los humanos que mata, si no están demasiado destrozados."
    }
    // context: legend_grisly_scythe.onDamageDealt.isKindOf()
    // en = "<!this.isKindOf(_target, , , player)&&!this.isKindOf(_target, , , human)>"  // expresión de código (comprobación de tipo), no es texto visible
    // FILE: scripts\items\weapons\legend_halberd.nut
    // context: legend_halberd.create.m.Name
    {
        en = "Halberd"
        es = "Alabarda"
    }
    // context: legend_halberd.create.m.Description
    {
        en = "A pike-like weapon with a spike for stabbing over some distance and an axe blade for delivering devastating strikes."
        es = "Un arma parecida a una pica, con una punta para clavar a cierta distancia y una hoja de hacha para asestar golpes devastadores."
    }
    // FILE: scripts\items\weapons\legend_hammer.nut
    // context: legend_hammer.create.m.Name
    {
        en = "Blacksmith's hammer"
        es = "Martillo de herrero"
    }
    // context: legend_hammer.create.m.Description
    {
        en = "A simple hammer, now everything looks like a nail"
        es = "Un simple martillo; ahora todo parece un clavo"
    }
    // FILE: scripts\items\weapons\legend_hand_crossbow.nut
    // context: legend_hand_crossbow.create.m.Name
    {
        en = "Hand Crossbow"
        es = "Ballesta de mano"
    }
    // context: legend_hand_crossbow.create.m.Description
    {
        en = "A miniature pull-lever crossbow that can propel bolts over medium distances attached to the wrist. The small size reduces power, but doesn't impede the hands so a melee weapon can be held in both hands. Requires almost a full turn to reload."
        es = "Una ballesta de palanca en miniatura, sujeta a la muñeca, que dispara virotes a media distancia. Su pequeño tamaño reduce la potencia, pero no estorba a las manos, así que se puede empuñar un arma cuerpo a cuerpo con ambas. Necesita casi un turno entero para recargar."
    }
    // FILE: scripts\items\weapons\legend_hoe.nut
    // context: legend_hoe.create.m.Name
    {
        en = "Hoe"
        es = "Azada"
    }
    // context: legend_hoe.create.m.Description
    {
        en = "An agricultural tool with a thin, flat blade attached to a long handle used to till soil and harvest root crops. The blade has been sharpened as to fashion it into a crude and oddly shaped chopping weapon."
        es = "Una herramienta agrícola con una hoja fina y plana unida a un mango largo, que se usa para labrar la tierra y cosechar tubérculos. La hoja se ha afilado hasta convertirla en un arma de tajo tosca y de forma extraña."
    }
    // FILE: scripts\items\weapons\legend_infantry_axe.nut
    // context: legend_infantry_axe.create.m.Name
    {
        en = "Infantry Axe"
        es = "Hacha de infantería"
    }
    // context: legend_infantry_axe.create.m.Description
    {
        en = "A long, two-handed axe used by footmen in the noble wars"
        es = "Un hacha larga a dos manos que usaban los soldados de infantería en las guerras nobiliarias"
    }
    // FILE: scripts\items\weapons\legend_katar.nut
    // context: legend_katar.create.m.Name
    {
        en = "Katar"
        es = "Katar"
    }
    // context: legend_katar.create.m.Description
    {
        en = "An H-shaped horizontal blade sitting above the knuckles. Has a thickened tip that is particularily effective at piercing armor but its construction prevents it from being gripped with two hands."
        es = "Una hoja horizontal en forma de H que queda sobre los nudillos. Tiene una punta reforzada especialmente eficaz para perforar armaduras, pero su construcción impide empuñarla con las dos manos."
    }
    // FILE: scripts\items\weapons\legend_military_goedendag.nut
    // context: legend_military_goedendag.create.m.Name
    {
        en = "Military Goedendag"
        es = "Goedendag militar"
    }
    // context: legend_military_goedendag.create.m.Description
    {
        en = "A military grade metal-reinforced club with a spike at the top. Can be used to thrust at the enemy, or pummel them into submission."
        es = "Un garrote de calidad militar reforzado con metal, con una púa en la punta. Sirve para dar estocadas al enemigo o molerlo a golpes hasta someterlo."
    }
    // FILE: scripts\items\weapons\legend_military_warscythe.nut
    // en = "Warscythe"
    // en base_es
    // context: legend_military_warscythe.create.m.Description
    {
        en = "A sharp curved blade attached to a long pole, used to deliver deep sweeping strikes over some distance. Mass produced for militias and noble armies, the sturdy design still betrays its farming origin."
        es = "Una hoja curva y afilada unida a un asta larga, usada para asestar golpes amplios y profundos a cierta distancia. Fabricada en masa para milicias y ejércitos nobles, su diseño robusto aún delata su origen campesino."
    }
    // FILE: scripts\items\weapons\legend_militia_glaive.nut
    // context: legend_militia_glaive.create.m.Name
    {
        en = "Militia Glaive"
        es = "Guja de milicia"
    }
    // context: legend_militia_glaive.create.m.Description
    {
        en = "A simple glaive improvised from a scramasax."
        es = "Una guja sencilla improvisada a partir de un scramasax."
    }
    // FILE: scripts\items\weapons\legend_mystic_staff.nut
    // context: legend_mystic_staff.create.m.Name
    {
        en = "Mystic staff"
        es = "Bastón místico"
    }
    // context: legend_mystic_staff.create.m.Description
    {
        en = "A sturdy staff with a crystal ball on its tip, it catches the light in mysterious ways"
        es = "Un bastón robusto con una bola de cristal en la punta, que capta la luz de formas misteriosas"
    }
    // FILE: scripts\items\weapons\legend_northern_sling.nut
    // context: legend_northern_sling.create.m.Name
    {
        en = "Northern Sling"
        es = "Honda norteña"
    }
    // context: legend_northern_sling.create.m.Description
    {
        en = "A sling adapted by the nothern houses for warfare. It features a bigger pouch for heavier rocks, but trades off precision for damage and range. With rocks abundant everywhere it will never run out of ammunition."
        es = "Una honda que las casas del norte adaptaron para la guerra. Tiene una bolsa más grande para piedras más pesadas, pero sacrifica precisión a cambio de daño y alcance. Con piedras de sobra por todas partes, nunca se quedará sin munición."
    }
    // FILE: scripts\items\weapons\legend_parrying_dagger.nut
    // context: legend_parrying_dagger.create.m.Name
    {
        en = "Parrying dagger"
        es = "Daga de parada"
    }
    // context: legend_parrying_dagger.create.m.Description
    {
        en = "An offhand dagger for actively parrying an opponent.\n\n When parried or if an opponent misses you, their defences will be lowered.\n\n The 'Split Shield' skill only does 20% damage against this dagger"
        es = "Una daga de mano secundaria para parar activamente los ataques de un oponente.\n\n Cuando paras su ataque o el oponente falla contra ti, sus defensas bajan.\n\n La habilidad 'Romper escudo' solo hace un 20% de daño contra esta daga"
    }
    // context: legend_parrying_dagger.getTooltip.result.insert().text
    {
        mode = "pattern"
        en = "Damage of [color=%damage%]<min:int>[/color] - [color=%damage%]<max:int>[/color]"
        es = "Daño de [color=%damage%]<min>[/color] - [color=%damage%]<max>[/color]"
    }
    // context: legend_parrying_dagger.getTooltip.result.insert().text
    {
        mode = "pattern"
        en = "[color=%damage%]<pct:int>%[/color] of damage ignores armor"
        es = "El [color=%damage%]<pct>%[/color] del daño ignora la armadura"
    }
    // context: legend_parrying_dagger.getTooltip.result.insert().text
    {
        mode = "pattern"
        en = "[color=%damage%]<pct:int>%[/color] effective against armor"
        es = "[color=%damage%]<pct>%[/color] de eficacia contra la armadura"
    }
    // context: legend_parrying_dagger.getTooltip.result.insert().text
    {
        mode = "pattern"
        en = "Chance to hit head [color=%positive%]+<chance:int>%[/color]"
        es = "Probabilidad de golpear en la cabeza [color=%positive%]+<chance>%[/color]"
    }
    // context: legend_parrying_dagger.getTooltip.result.push().text
    {
        en = "Grants [color=%positive%]+10%[/color] melee damage if having a dagger on your mainhand"
        es = "Otorga [color=%positive%]+10%[/color] de daño cuerpo a cuerpo si llevas una daga en la mano principal"
    }
    // FILE: scripts\items\weapons\legend_ranged_flail.nut
    // context: legend_ranged_flail.create.m.Name
    {
        en = "Pole Flail"
        es = "Mayal de asta"
    }
    // context: legend_ranged_flail.create.m.Description
    {
        en = "A separate striking head attached to a pole by a chain. A rather unpredictable weapon, but useful to strike over or around shield cover."
        es = "Una cabeza contundente unida a un asta mediante una cadena. Un arma bastante impredecible, pero útil para atacar por encima o alrededor de la cobertura del escudo."
    }
    // FILE: scripts\items\weapons\legend_ranged_wooden_flail.nut
    // context: legend_ranged_wooden_flail.create.m.Name
    {
        en = "Peasant Flail"
        es = "Mayal de campesino"
    }
    // context: legend_ranged_wooden_flail.create.m.Description
    {
        en = "A large stick attached with a short chain to a long pole, the Peasant Flail is an agricultural tool used to strike piles of grain to loosen the husks. As an improvised weapon it's rather unpredictable but useful to strike over or around shield cover."
        es = "Un palo grande unido con una cadena corta a un asta larga; el Mayal de campesino es una herramienta agrícola que se usa para golpear montones de grano y soltar la cascarilla. Como arma improvisada es bastante impredecible, pero útil para golpear por encima o alrededor de la cobertura del escudo."
    }
    // FILE: scripts\items\weapons\legend_redback_dagger.nut
    // context: legend_redback_dagger.create.m.Name
    {
        en = "Redback Dagger"
        es = "Daga de lomo rojo"
    }
    // context: legend_redback_dagger.create.m.Description
    {
        en = "A dagger made from the fang and poison gland of a redback spider, it can inject redback poison into a target"
        es = "Una daga hecha con el colmillo y la glándula venenosa de una araña de lomo rojo; puede inyectar veneno de lomo rojo en un objetivo"
    }
    // context: legend_redback_dagger.getTooltip.result.push().text
    {
        en = "Applies redback poison to the target on any successful attack, dealing [color=%damage%]55[/color] damage over [color=%damage%]10[/color] turns."
        es = "Aplica veneno de lomo rojo al objetivo con cualquier ataque exitoso, infligiendo [color=%damage%]55[/color] de daño a lo largo de [color=%damage%]10[/color] turnos."
    }
    // context: legend_redback_dagger.getTooltip.result.push().text
    {
        en = "Puncture damage is increased by [color=%positive%]33%[/color] vs rooted targets"
        es = "El daño de Punción aumenta un [color=%positive%]33%[/color] contra objetivos inmovilizados"
    }
    // en = "<actor:str_tag> is poisoned"
    // en base_es
    // FILE: scripts\items\weapons\legend_reinforced_flail.nut
    // context: legend_reinforced_flail.create.m.Name
    {
        en = "Reinforced Improvised Warflail"
        es = "Mayal de guerra improvisado reforzado"
    }
    // context: legend_reinforced_flail.create.m.Description
    {
        en = "A farmer's flail that has been bolstered with thicker sections of wood and bound with iron. Sharp spikes protrude from its frame, as if to mockingly imitate it's military counterpart."
        es = "Un mayal de granjero reforzado con secciones de madera más gruesas y sujeto con hierro. De su armazón sobresalen púas afiladas, como si imitara burlonamente a su equivalente militar."
    }
    // FILE: scripts\items\weapons\legend_saw.nut
    // context: legend_saw.create.m.Name
    {
        en = "Handsaw"
        es = "Serrucho"
    }
    // context: legend_saw.create.m.Description
    {
        en = "A toothed blade attached to a wooden grip used to saw through timber. While it is difficult to cut through flesh, the teeth leave a nasty gash."
        es = "Una hoja dentada unida a un mango de madera, usada para serrar troncos. Aunque cuesta cortar la carne con ella, los dientes dejan un tajo muy feo."
    }
    // FILE: scripts\items\weapons\legend_scythe.nut
    // context: legend_scythe.create.m.Description
    {
        en = "An agricultural tool originally used for mowing grass or reaping crops that can be used as an improvised two handed weapon. The edge has been sharpened and will easily rip through unarmored individuals."
        es = "Una herramienta agrícola usada en origen para segar hierba o cosechar, que puede emplearse como arma improvisada a dos manos. El filo se ha afilado y desgarrará con facilidad a quien no lleve armadura."
    }
    // FILE: scripts\items\weapons\legend_shiv.nut
    // en = "Shank"
    // en base_es
    // context: legend_shiv.create.m.Description
    {
        en = "A makeshift weapon fashioned from a rusty metal scrap wrapped in cloth. Fit only for the desperate or deranged."
        es = "Un arma improvisada hecha con un trozo de metal oxidado envuelto en tela. Solo apta para desesperados o trastornados."
    }
    // FILE: scripts\items\weapons\legend_shovel.nut
    // context: legend_shovel.create.m.Name
    {
        en = "Shovel"
        es = "Pala"
    }
    // context: legend_shovel.create.m.Description
    {
        en = "A tool meant for digging holes, not maiming men. A shovel's wide blade lends accuracy when aiming for the head, but almost anything else would be better."
        es = "Una herramienta pensada para cavar hoyos, no para mutilar hombres. La hoja ancha de una pala da precisión al apuntar a la cabeza, pero casi cualquier otra cosa sería mejor."
    }
    // FILE: scripts\items\weapons\legend_sickle.nut
    // en = "Sickle"
    // en base_es
    // context: legend_sickle.create.m.Description
    {
        en = "A tool for gathering plants, can also gather ears"
        es = "Una herramienta para segar mieses; también siega orejas"
    }
    // FILE: scripts\items\weapons\legend_slingshot.nut
    // context: legend_slingshot.create.m.Name
    {
        en = "Slingshot"
        es = "Tirachinas"
    }
    // context: legend_slingshot.create.m.Description
    {
        en = "A primitive yet effective weapon for troublesome children and grown killers alike. With stones abundant everywhere, it will never run out of ammunition. Can target the head to daze enemies."
        es = "Un arma primitiva pero eficaz, tanto para niños traviesos como para asesinos hechos y derechos. Con piedras de sobra por todas partes, nunca se quedará sin munición. Puede apuntar a la cabeza para atontar a los enemigos."
    }
    // FILE: scripts\items\weapons\legend_staff.nut
    // en = "Staff"
    // en base_es
    // context: legend_staff.create.m.Description
    {
        en = "A sturdy staff, good for walking and whacking"
        es = "Un bastón robusto, bueno para caminar y para dar garrotazos"
    }
    // FILE: scripts\items\weapons\legend_staff_gnarled.nut
    // context: legend_staff_gnarled.create.m.Name
    {
        en = "Gnarled Staff"
        es = "Bastón nudoso"
    }
    // context: legend_staff_gnarled.create.m.Description
    {
        en = "A twisted staff made from withered roots"
        es = "Un bastón retorcido hecho de raíces marchitas"
    }
    // FILE: scripts\items\weapons\legend_staff_vala.nut
    // context: legend_staff_vala.create.m.Name
    {
        en = "Vala Staff"
        es = "Bastón de vala"
    }
    // context: legend_staff_vala.create.m.Description
    {
        en = "A beautiful staff with the distinctive twisted design of a vala."
        es = "Un hermoso bastón con el característico diseño retorcido de una vala."
    }
    // FILE: scripts\items\weapons\legend_sturdy_sling.nut
    // context: legend_sturdy_sling.create.m.Name
    {
        en = "Sturdy Sling"
        es = "Honda robusta"
    }
    // context: legend_sturdy_sling.create.m.Description
    {
        en = "Well crafted and reinforced sling, for hurling rocks at your rivals. With stones abundant everywhere, it will never run out of ammunition."
        es = "Una honda bien hecha y reforzada para lanzar piedras a tus rivales. Con piedras de sobra por todas partes, nunca se quedará sin munición."
    }
    // FILE: scripts\items\weapons\legend_swordstaff.nut
    // context: legend_swordstaff.create.m.Name
    {
        en = "Swordstaff"
        es = "Bastón de espada"
    }
    // context: legend_swordstaff.create.m.Description
    {
        en = "A cross between a spear and a sword, making for a good dueling weapon. Used for attacking at range and closing the gap."
        es = "Un cruce entre lanza y espada que la convierte en una buena arma de duelo. Sirve para atacar desde lejos y para cerrar distancias."
    }
    // FILE: scripts\items\weapons\legend_tipstaff.nut
    // context: legend_tipstaff.create.m.Name
    {
        en = "Tipstaff"
        es = "Bastón herrado"
    }
    // context: legend_tipstaff.create.m.Description
    {
        en = "A sturdy staff with metal tips, good for walking and whacking"
        es = "Un bastón robusto con contera de metal, bueno para caminar y para dar garrotazos"
    }
    // FILE: scripts\items\weapons\legend_two_handed_club.nut
    // context: legend_two_handed_club.create.m.Name
    {
        en = "Two-Handed Club"
        es = "Estaca de guerra a dos manos"
    }
    // context: legend_two_handed_club.create.m.Description
    {
        en = "A massive wooden club with a spiked head. Receiving a blow from this weapon will leave anyone dazed and gasping for air."
        es = "Un enorme garrote de madera con una cabeza con púas. Recibir un golpe de esta arma dejará a cualquiera aturdido y sin aliento."
    }
    // FILE: scripts\items\weapons\legend_wooden_pitchfork.nut
    // context: legend_wooden_pitchfork.create.m.Name
    {
        en = "Wooden pitchfork"
        es = "Horca de madera"
    }
    // context: legend_wooden_pitchfork.create.m.Description
    {
        en = "An irregular pitchfork carved from a single tree branch. As an improvised weapon it can be used to keep an opponent at bay, but it won't inflict the deadliest of injuries and will perform poorly against armor. Liable to snap at any moment."
        es = "Una horca irregular tallada en una sola rama de árbol. Como arma improvisada sirve para mantener a raya a un oponente, pero no causará las heridas más mortales y rendirá mal contra la armadura. Puede partirse en cualquier momento."
    }
    // FILE: scripts\items\weapons\legend_wooden_spear.nut
    // context: legend_wooden_spear.create.m.Name
    {
        en = "Wooden Spear"
        es = "Lanza de madera"
    }
    // context: legend_wooden_spear.create.m.Description
    {
        en = "A large branch whittled to a fine point. It's so unbalanced and irregular you need to use two hands just to keep it steady. Liable to snap at any moment. Deals additional damage to vampires"
        es = "Una rama grande tallada hasta dejarle una punta fina. Está tan desequilibrada y es tan irregular que necesitas las dos manos solo para mantenerla firme. Puede partirse en cualquier momento. Inflige daño adicional a los vampiros"
    }
    // FILE: scripts\items\weapons\legend_wooden_stake.nut
    // context: legend_wooden_stake.create.m.Name
    {
        en = "Wooden Stake"
        es = "Estaca de madera"
    }
    // context: legend_wooden_stake.create.m.Description
    {
        en = "A roughly sharpened wooden shaft, usually used for tents and carpentry. Can be applied to other more visceral tasks. Very effective against vampires."
        es = "Una estaca de madera afilada a lo bruto, que suele usarse para tiendas y carpintería. Puede servir para otras tareas más viscerales. Muy eficaz contra los vampiros."
    }
    // FILE: scripts\items\weapons\legend_zweihander.nut
    // en = "Zweihander"
    // en base_es
    // context: legend_zweihander.create.m.Description
    {
        en = "A massive two-handed blade as good for carving swathes through the enemy as for battering them into submission."
        es = "Una enorme hoja a dos manos, tan buena para abrir surcos entre el enemigo como para molerlo a golpes hasta someterlo."
    }
    // en = "Sword, Two-Handed"
    // en base_es
    // FILE: scripts\items\weapons\legendary\legend_blooddrinker.nut
    // context: legend_blooddrinker.create.m.Description
    {
        en = "A very large double edged executioner's song with a flared blade at the top. You don't understand what kind of craftsmanship could've crafted such a blade, as despite the unwieldy length and weight it handles well. The blade sings a bitter song of mountains of beheaded corpses."
        es = "Una espada de verdugo de doble filo muy grande, con la hoja ensanchada en la punta. No entiendes qué clase de artesanía pudo forjar semejante hoja, pues, pese a su longitud y su peso descomunales, se maneja con soltura. La hoja canta una amarga canción de montañas de cadáveres decapitados."
    }
    // context: legend_blooddrinker.getTooltip.result.push().text
    {
        en = "On killing blow recovers [color=%positive%]10%[/color] of your maximum Hitpoints"
        es = "Al asestar un golpe mortal recupera el [color=%positive%]10%[/color] de tus Puntos de vida máximos"
    }
    // FILE: scripts\items\weapons\legendary\legend_mage_swordstaff.nut
    // context: legend_mage_swordstaff.create.m.Name
    {
        en = "Bladed Magestaff"
        es = "Bastón mágico con hoja"
    }
    // context: legend_mage_swordstaff.create.m.Description
    {
        en = "While the nature of its construction remains a myth, this unique mage's swordstaff is permeated with magic. The blade almost hums through the air and it can slice through armor like butter."
        es = "Aunque cómo se forjó sigue siendo un mito, este singular bastón de espada de mago está impregnado de magia. La hoja casi zumba al cortar el aire y atraviesa la armadura como si fuera mantequilla."
    }
    // FILE: scripts\items\weapons\legendary\legend_ram_hammer.nut
    // context: legend_ram_hammer.create.m.Name
    {
        en = "The Ram's Head"
        es = "La Cabeza de Carnero"
    }
    // context: legend_ram_hammer.create.m.Description
    {
        en = "A massive ancient hammer with two ram heads making up both faces of the weapon. It is deceptively heavy and somehow increases in weight between each swing."
        es = "Un enorme martillo antiguo con dos cabezas de carnero que forman ambas caras del arma. Es engañosamente pesado y, de algún modo, gana peso con cada golpe."
    }
    // FILE: scripts\items\weapons\named\legend_named_flamberge.nut
    // context: legend_named_flamberge.create.m.Description
    {
        en = "This greatsword shows great craftmanship. It is of great length and strength, holding a great balance in the hands."
        es = "Este mandoble muestra una gran maestría. Es de gran longitud y fuerza, y guarda un gran equilibrio en las manos."
    }
    // context: legend_named_flamberge.getTooltip.result.push().text
    {
        // corrige base: falta "de" entre la cifra y "daño" ("Inflige 2 daño" es agramatical; debe ser "Inflige <bleeddamage> de daño de sangrado...")
        en = "Inflicts additional stacking [color=%damage%]2[/color] bleeding damage per turn, for 2 turns"
        es = "Inflige [color=%damage%]2[/color] de daño de sangrado acumulable adicional por turno, durante 2 turnos"
    }
    // FILE: scripts\items\weapons\named\legend_named_gladius.nut
    // context: legend_named_gladius.create.m.Description
    {
        en = "A straight blade of ancient origin. The grip and pommel are ornate and most likely from a nobleman."
        es = "Una hoja recta de origen antiguo. La empuñadura y el pomo son ornamentados y lo más probable es que pertenecieran a un noble."
    }
    // FILE: scripts\items\weapons\named\legend_named_glaive.nut
    // context: legend_named_glaive.create.m.Description
    {
        en = "A masterfully crafted glaive that feels surprisingly light, yet sturdy."
        es = "Una guja magistralmente elaborada que resulta sorprendentemente ligera, pero resistente."
    }
    // FILE: scripts\items\weapons\named\legend_named_goblin_axe_2h.nut
    // context: legend_named_goblin_axe_2h.create.m.Name
    {
        en = "Manfeller"
        es = "Abatehombres"
    }
    // context: legend_named_goblin_axe_2h.create.m.Description
    {
        en = "As some of the goblins grew to nearly human size, they took the time to recreate their greenskin cousin's huge axe, but with a well crafted slim edge. Suited for human hands, it can easily cut a man in two ."
        es = "Cuando algunos goblins crecieron hasta alcanzar casi el tamaño humano, se tomaron el tiempo de recrear la enorme hacha de sus primos pieles verdes, pero con un filo fino y bien trabajado. Adecuada para manos humanas, parte a un hombre en dos con facilidad."
    }
    // FILE: scripts\items\weapons\named\legend_named_goblin_crossbow.nut
    // context: legend_named_goblin_crossbow.create.m.Description
    {
        en = "A large and heavy crossbow with menacing spikes in front. It's a mystery how goblins could improve upon a miniature ballista, but here we are. It shoots stakes with enough force to knock back a target hit. Very effective against vampires."
        es = "Una ballesta grande y pesada con amenazantes púas en la parte delantera. Es un misterio cómo los goblins pudieron mejorar una balista en miniatura, pero aquí está. Dispara estacas con fuerza suficiente para hacer retroceder al objetivo alcanzado. Muy eficaz contra los vampiros."
    }
    // en = "Crossbow, Two-Handed"
    // en base_es
    // FILE: scripts\items\weapons\named\legend_named_goblin_gruesome_falchion.nut
    // context: legend_named_goblin_gruesome_falchion.create.m.Description
    {
        en = "Fashioned from sharpened black rock, this wavy blade and can cause gruesome injuries. Even if it's crafted by goblins, the crafstmanship is amazing."
        es = "Hecha de roca negra afilada, esta hoja ondulada puede causar heridas espantosas. Aunque la hayan forjado goblins, la factura es asombrosa."
    }
    // en = "Sword, One-Handed"
    // en base_es
    // FILE: scripts\items\weapons\named\legend_named_goblin_notched_blade.nut
    // context: legend_named_goblin_notched_blade.create.m.Description
    {
        en = "The goblins crafted this curved sax into a wavy pattern, making the blade particularly good for slitting throats and puncturing weak spots."
        es = "Los goblins dieron a este sax curvo un patrón ondulado, lo que hace la hoja especialmente buena para degollar y perforar puntos débiles."
    }
    // FILE: scripts\items\weapons\named\legend_named_goblin_staff.nut
    // context: legend_named_goblin_staff.create.m.Name
    {
        en = "Adorned Gnarly Staff"
        es = "Palo retorcido adornado"
    }
    // context: legend_named_goblin_staff.create.m.Description
    {
        en = "A gnarly staff carved from old and hard wood, decorated with a menacing skull, feathers and small bones. The runes on the head are intricate and tell a story that only the goblins can read."
        es = "Un bastón nudoso tallado en madera vieja y dura, decorado con una calavera amenazante, plumas y huesecillos. Las runas de la cabeza son intrincadas y cuentan una historia que solo los goblins saben leer."
    }
    // FILE: scripts\items\weapons\named\legend_named_great_khopesh.nut
    // en = "A massive cleaver that can cut through flesh and armor alike. This piece is in good condition despite its old age."
    // en base_es
    // FILE: scripts\items\weapons\named\legend_named_heavy_javelin.nut
    // context: legend_named_heavy_javelin.create.m.Description
    {
        en = "A jagged harpoon, that flies true despite it's weight and size. Harder to throw and hit with, but more impactful."
        es = "Un arpón dentado que vuela certero a pesar de su peso y tamaño. Cuesta más lanzarlo y acertar con él, pero golpea con más fuerza."
    }
    // en = "<bowyer:str>'s <name:str>"
    // en base_es
    // FILE: scripts\items\weapons\named\legend_named_heavy_southern_mace.nut
    // context: legend_named_heavy_southern_mace.create.m.Description
    {
        en = "A heavy winged mace from the south. The smith who forged this weapon certainly knew what he was doing."
        es = "Una pesada maza de aletas del sur. El herrero que forjó esta arma sabía sin duda lo que hacía."
    }
    // FILE: scripts\items\weapons\named\legend_named_heavy_throwing_axe.nut
    // context: legend_named_heavy_throwing_axe.create.m.Description
    {
        en = "While you wouldn't use these for juggling, the craftsmanship is astounding for heavy barbarian axes. Difficult to throw and hit with, but deadly."
        es = "Aunque no las usarías para hacer malabares, la factura es asombrosa para ser pesadas hachas bárbaras. Difíciles de lanzar y de acertar con ellas, pero mortíferas."
    }
    // FILE: scripts\items\weapons\named\legend_named_horn_decorated_mace.nut
    // context: legend_named_horn_decorated_mace.create.m.Description
    {
        en = "A huge club decorated with skulls and horns, woven in patterns that betray strange meaning. For the average mercenary you just need to know that a blow will leave a person reeling and struggling for breath."
        es = "Un enorme garrote decorado con calaveras y cuernos, entretejidos en patrones que dejan entrever un extraño significado. Al mercenario corriente le basta con saber que un golpe deja a cualquiera tambaleándose y luchando por respirar."
    }
    // en = "Mace, Two-Handed"
    // en base_es
    // FILE: scripts\items\weapons\named\legend_named_infantry_axe.nut
    // context: legend_named_infantry_axe.create.m.Description
    {
        en = "A long, exceptionally well crafted two-handed axe used by footmen in the noble wars"
        es = "Un hacha larga a dos manos, de factura excepcional, que usaban los soldados de infantería en las guerras nobiliarias"
    }
    // FILE: scripts\items\weapons\named\legend_named_longsword.nut
    // context: legend_named_longsword.create.m.Description
    {
        en = "This longsword is a marvel to look at. The long blade is rigid and sturdy, but trades nothing in balance. Lends itself well to a diverse array of fighting moves."
        es = "Esta espada larga es una maravilla para la vista. La hoja, larga, es rígida y robusta, pero no sacrifica nada de equilibrio. Se presta bien a un variado repertorio de movimientos de combate."
    }
    // FILE: scripts\items\weapons\named\legend_named_lute.nut
    // context: legend_named_lute.create.m.Description
    {
        en = "A beautiful lute with a ornate body and strong neck. The artisan who made this instrument certainly knew what they were doing."
        es = "Un hermoso laúd con el cuerpo ornamentado y un mástil resistente. Quien hizo este instrumento sabía sin duda lo que hacía."
    }
    // FILE: scripts\items\weapons\named\legend_named_military_goedendag.nut
    // context: legend_named_military_goedendag.create.m.Description
    {
        en = "An ornate military grade metal-reinforced club with a spike at the top. Can be used to thrust at the enemy, or pummel them into submission."
        es = "Un garrote ornamentado de calidad militar reforzado con metal, con una púa en la punta. Sirve para dar estocadas al enemigo o molerlo a golpes hasta someterlo."
    }
    // FILE: scripts\items\weapons\named\legend_named_military_warscythe.nut
    // context: legend_named_military_warscythe.create.m.Description
    {
        en = "A heavy cleaver blade on top of a long shaft, used to deliver deep sweeping strikes over some distance. It might be confused for a simple and crude from weapon a layman, but the artisan who crafted this knew how to balance it perfectly."
        es = "Una pesada hoja de cuchilla sobre un asta larga, usada para asestar golpes amplios y profundos a cierta distancia. Un profano podría tomarla por un arma simple y tosca, pero el artesano que la forjó supo equilibrarla a la perfección."
    }
    // FILE: scripts\items\weapons\named\legend_named_nomad_sling.nut
    // context: legend_named_nomad_sling.create.m.Description
    {
        en = "A reinforced sling on a metal staff of the highest craftsmanship. It features a bigger pouch for heavier rocks, but trades off precision for damage and range. With rocks being everywhere it will never run out of ammunition."
        es = "Una honda reforzada montada en un asta de metal de la mejor factura. Tiene una bolsa más grande para piedras más pesadas, pero sacrifica precisión a cambio de daño y alcance. Con piedras por todas partes, nunca se quedará sin munición."
    }
    // FILE: scripts\items\weapons\named\legend_named_northern_sling.nut
    // context: legend_named_northern_sling.create.m.Description
    {
        en = "An exquisite slingstaff for true marksmen. It features a bigger pouch for heavier rocks, but trades off precision for damage and range. With rocks being everywhere it will never run out of ammunition."
        es = "Un exquisito fustíbalo para auténticos tiradores. Tiene una bolsa más grande para piedras más pesadas, pero sacrifica precisión a cambio de daño y alcance. Con piedras por todas partes, nunca se quedará sin munición."
    }
    // FILE: scripts\items\weapons\named\legend_named_orc_axe_2h.nut
    // context: legend_named_orc_axe_2h.create.m.Name
    {
        en = "Unhold Splitter"
        es = "Partetroles"
    }
    // context: legend_named_orc_axe_2h.create.m.Description
    {
        en = "A huge and sturdy double headed battleaxe too heavy to be used effectively by the average human."
        es = "Un hacha de batalla de dos cabezas, enorme y robusta, demasiado pesada para ser utilizada eficazmente por un humano promedio."
    }
    // FILE: scripts\items\weapons\named\legend_named_orc_flail_2h.nut
    // context: legend_named_orc_flail_2h.create.m.Name
    {
        en = "Brutal Chain"
        es = "Cadena brutal"
    }
    // context: legend_named_orc_flail_2h.create.m.Description
    {
        // corrige base: falta de concordancia, "Demasiado pesado para ser utilizado" se refiere a "cadena" (femenino); debe ser "Demasiado pesada para ser utilizada"
        en = "A massive iron chain with a heavy piece at the end. Too heavy to be used effectively by the average human."
        es = "Una enorme cadena de hierro con una pieza pesada en el extremo. Demasiado pesada para ser utilizada eficazmente por el ser humano promedio."
    }
    // FILE: scripts\items\weapons\named\legend_named_parrying_dagger.nut
    // context: legend_named_parrying_dagger.create.m.Description
    {
        en = "An exquisite offhand dagger for actively parrying an opponent.\n\n When parried or if an opponent misses you, their defences will be lowered.\n\n The 'Split Shield' skill only does 20% damage against this dagger"
        es = "Una exquisita daga de mano secundaria para parar activamente los ataques de un oponente.\n\n Cuando paras su ataque o el oponente falla contra ti, sus defensas bajan.\n\n La habilidad 'Romper escudo' solo hace un 20% de daño contra esta daga"
    }
    // FILE: scripts\items\weapons\named\legend_named_ranged_flail.nut
    // context: legend_named_ranged_flail.create.m.Description
    {
        en = "A metal weight attached with a short chain to a long pole, the War Flail is a brutal weapon. Deadly enough to fell most men with a good hit to the head, and useful to strike over or around shield cover."
        es = "Un peso de metal unido con una cadena corta a un asta larga; el Mayal de guerra es un arma brutal. Lo bastante mortífero para derribar a la mayoría de los hombres con un buen golpe en la cabeza, y útil para golpear por encima o alrededor de la cobertura del escudo."
    }
    // context: legend_named_ranged_flail.getTooltip.result.push().text
    {
        en = "Applies [color=%positive%]Daze[/color] to Targets Hit"
        es = "Aplica [color=%positive%]Atontado[/color] a los objetivos alcanzados"
    }
    // FILE: scripts\items\weapons\named\legend_named_royal_lance.nut
    // context: legend_named_royal_lance.create.m.Description
    {
        en = "This Spear is especially well-crafted, withstanding the tests of time, and its blade would be worthy of even a noble. Used for thrusting over some distance and keeping the enemy at bay."
        es = "Esta lanza está especialmente bien hecha, ha resistido el paso del tiempo y su hoja sería digna incluso de un noble. Se usa para dar estocadas a cierta distancia y mantener a raya al enemigo."
    }
    // en = "<bowyer:str>'s <name:str>"
    // en base_es
    // en = "<bowyer:str>'s <name:str>"
    // en base_es
    // FILE: scripts\items\weapons\named\legend_named_rusty_greatsword.nut
    // context: legend_named_rusty_greatsword.create.m.Description
    {
        en = "This massive and exceptionally well-crafted warblade is built like a cleaver, but has a surprisingly light blade that allows wielding it like a sword."
        es = "Esta enorme cuchilla de guerra, de factura excepcional, está hecha como un cuchillo de carnicero, pero tiene una hoja sorprendentemente ligera que permite empuñarla como una espada."
    }
    // FILE: scripts\items\weapons\named\legend_named_rusty_serrated_axe.nut
    // context: legend_named_rusty_serrated_axe.create.m.Description
    {
        en = "The rust on this axe could fool you that the blade is dull, but just checking its edge almost cost you your thumb. The serrated teeth can cause horrific wounds, while the axe itself is uniquely suited to decapitations."
        es = "El óxido de esta hacha podría hacerte creer que la hoja está roma, pero solo con comprobar el filo casi te cuesta el pulgar. Los dientes serrados pueden causar heridas horribles, y el hacha en sí es como ninguna para decapitar."
    }
    // context: legend_named_rusty_serrated_axe.getTooltip.result.push().text
    {
        en = "Has a [color=%negative%]33%[/color] lower threshold to inflict injuries"
        es = "Tiene un umbral un [color=%positive%]33%[/color] más bajo para infligir heridas"
    }
    // FILE: scripts\items\weapons\named\legend_named_rusty_warcleaver.nut
    // context: legend_named_rusty_warcleaver.create.m.Description
    {
        en = "An uncommonly curved blade shape for the warriors of the north, this savage warcleaver is heavy and sturdy. The strange material can decapitate, as well as it can destroy shields."
        es = "De hoja inusualmente curva para los guerreros del norte, esta salvaje gran cuchilla es pesada y robusta. Su extraño material decapita igual de bien que destroza escudos."
    }
    // FILE: scripts\items\weapons\named\legend_named_sling.nut
    // context: legend_named_sling.create.m.Description
    {
        en = "This sling is reinforced and features a high quality leather pouch. Used to pelt your enemies with rocks. With stones abundant everywhere, it will never run out of ammunition."
        es = "Esta honda está reforzada y tiene una bolsa de cuero de gran calidad. Sirve para acribillar a pedradas a tus enemigos. Con piedras de sobra por todas partes, nunca se quedará sin munición."
    }
    // FILE: scripts\items\weapons\named\legend_named_staff_vala.nut
    // context: legend_named_staff_vala.create.m.Description
    {
        en = "A gnarled staff no more, the twisted roots reformed into a beautiful pattern that only the Vala can create."
        es = "Ya no es un bastón nudoso: las raíces retorcidas se han reformado en un hermoso patrón que solo la Vala puede crear."
    }
    // FILE: scripts\items\weapons\named\legend_named_swordstaff.nut
    // context: legend_named_swordstaff.create.m.Description
    {
        en = "This Swordstaff is especially well-crafted, and its blade would be worthy of even a noble"
        es = "Este Bastón de espada está especialmente bien hecho, y su hoja sería digna incluso de un noble"
    }
    // FILE: scripts\items\weapons\named\legend_named_warhammer.nut
    // context: legend_named_warhammer.create.m.Description
    {
        en = "An ornate iron mastercrafted warhammer that easily destroys armor and breaks bones. "
        es = "Un ornamentado martillo de guerra de hierro, obra de un maestro, que destroza armaduras y rompe huesos con facilidad. "
    }
    // FILE: scripts\items\weapons\named\legend_named_zweihander.nut
    // context: legend_named_zweihander.create.m.Description
    {
        en = "This zweihander is a true masterpiece, with a blade that is both flexible and easy to swing, but also delivers devastating blows to whoever is unlucky enough to get in range."
        es = "Este zweihander es una auténtica obra maestra, con una hoja flexible y fácil de blandir que, además, asesta golpes devastadores a quien tenga la mala suerte de ponerse a su alcance."
    }
    // FILE: scripts\preload.nut
    // en = "<scriptsConfigPath>global"
    // en = "<scriptsConfigPath>ui"
    // en = "<scriptsConfigPath>strings"
    // FILE: scripts\retinue\followers\arena_follower.nut
    // context: arena_follower.create.m.Name
    {
        en = "Gladiator's Tools"
        es = "Herramientas del gladiador"
    }
    // context: arena_follower.create.m.Description
    {
        en = "Winning fights in the arena can be tough, however with these tools one can entertain the croud for many more hours."
        es = "Ganar combates en la arena puede ser duro, pero con estas herramientas se puede entretener al público durante muchas horas más."
    }
    // context: arena_follower.create.m.Effects
    {
        en = "Increase winnings from the arena by 25%"
        es = "Aumenta un 25% las ganancias de la arena"
    }
    // context: arena_follower.create.m.Effects
    {
        en = "Fight up to 3 arena matches per day"
        es = "Lucha hasta 3 combates de arena al día"
    }
    // context: arena_follower.create.addRequirement()
    {
        en = "Triumph in 5 arena fights "
        es = "Triunfa en 5 combates de arena "
    }
    // FILE: scripts\scenarios\tactical\legend_scenario_basilisks.nut
    // en = "ScenarioDefendTheHill::generate()"
    // FILE: scripts\scenarios\tactical\legend_scenario_wall_battle.nut
    // en = "ScenarioEarlyGame::generate()"
    // FILE: scripts\scenarios\world\legend_random_3_scenario.nut
    // context: legend_random_3_scenario.create.m.Name
    {
        en = "Random Trio"
        es = "Trío aleatorio"
    }
    // context: legend_random_3_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_80.png[/img][/p][p]Having fled a raid, three fellows decide to forge out a new path.\n\n[color=#bcad8c]Random Backgrounds:[/color] The backgrounds are different each time you start.\n[color=#bcad8c]Random equipment:[/color] The equipment you begin with is different each time.\n[color=#bcad8c]Random perks:[/color] The abilities of your mercenaries will be different each time.[/p]"
        es = "[p=c][img]gfx/ui/events/event_80.png[/img][/p][p]Tras huir de un saqueo, tres compañeros deciden abrirse un nuevo camino.\n\n[color=#dda21f]Trasfondos aleatorios:[/color] Los trasfondos cambian cada vez que empiezas.\n[color=#dda21f]Equipo aleatorio:[/color] El equipo con el que empiezas es distinto cada vez.\n[color=#dda21f]Ventajas aleatorias:[/color] Las capacidades de tus mercenarios serán distintas cada vez.[/p]"
    }
    // FILE: scripts\scenarios\world\legend_random_party_scenario.nut
    // context: legend_random_party_scenario.create.m.Name
    {
        en = "Random Party"
        es = "Grupo aleatorio"
    }
    // context: legend_random_party_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_80.png[/img][/p][p]A wild new adventure each time, 1-6 party members randomly chosen from all backgrounds.\n\n[color=#bcad8c]Random Backgrounds:[/color] The backgrounds are different each time you start.\n[color=#bcad8c]Random equipment:[/color] The equipment you begin with is different each time.\n[color=#bcad8c]Random perks:[/color] The abilities of your mercenaries will be different each time.\n[color=#bcad8c]Random supplies:[/color] Randomly get 3 times less to 3 times more money, tools, meds and ammo.[/p]"
        es = "[p=c][img]gfx/ui/events/event_80.png[/img][/p][p]Una aventura nueva y descabellada cada vez, con 1-6 miembros elegidos al azar entre todos los trasfondos.\n\n[color=#dda21f]Trasfondos aleatorios:[/color] Los trasfondos cambian cada vez que empiezas.\n[color=#dda21f]Equipo aleatorio:[/color] El equipo con el que empiezas es distinto cada vez.\n[color=#dda21f]Ventajas aleatorias:[/color] Las capacidades de tus mercenarios serán distintas cada vez.\n[color=#dda21f]Suministros aleatorios:[/color] Recibes al azar entre 3 veces menos y 3 veces más dinero, herramientas, medicina y munición.[/p]"
    }
    // FILE: scripts\scenarios\world\legend_random_solo_scenario.nut
    // context: legend_random_solo_scenario.create.m.Name
    {
        en = "Random Solo"
        es = "Solitario aleatorio"
    }
    // context: legend_random_solo_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_35.png[/img][/p][p]Striking out on your own, who knows what the world has in store?\n\n[color=#bcad8c]Random Backgrounds:[/color] Your background will be different each time you start.\n[color=#bcad8c]Random Equipment:[/color] The equipment you begin with is different each time.\n[color=#bcad8c]Avatar:[/color] If you die, it is game over.[/p]"
        es = "[p=c][img]gfx/ui/events/event_35.png[/img][/p][p]Te lanzas a la aventura por tu cuenta: ¿quién sabe qué te depara el mundo?\n\n[color=#dda21f]Trasfondos aleatorios:[/color] Tu trasfondo será distinto cada vez que empieces.\n[color=#dda21f]Equipo aleatorio:[/color] El equipo con el que empiezas es distinto cada vez.\n[color=#dda21f]Avatar:[/color] Si mueres, se acaba la partida.[/p]"
    }
    // FILE: scripts\scenarios\world\legend_risen_legion_scenario.nut
    // context: legend_risen_legion_scenario.create.m.Name
    {
        en = "Risen Legion"
        es = "Legión alzada"
    }
    // context: legend_risen_legion_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_73.png[/img][/p]An ancient legion risen from the dead with orders to reclaim the world.\n\n[color=#bcad8c]Dreaded:[/color] All towns will begin and stay hostile to you.\n[color=#bcad8c]Fighting Legion:[/color] Higher than average marching speed across difficult terrain, begin with 8 fighters and field up to 25.\n[color=#bcad8c]Dead Walking:[/color] You cannot hire in towns, but you may find recruits by patrolling near Mass graves, Sunken Castles and The Monolith. Ancient dead are allied to you.\n"
        es = "[p=c][img]gfx/ui/events/event_73.png[/img][/p]Una antigua legión alzada de entre los muertos con órdenes de reconquistar el mundo.\n\n[color=#dda21f]Temidos:[/color] Todas las ciudades te serán hostiles desde el principio y para siempre.\n[color=#dda21f]Legión combatiente:[/color] Velocidad de marcha superior a la media en terreno difícil; empiezas con 8 combatientes y puedes desplegar hasta [color=#1e861e]25[/color].\n[color=#dda21f]Muertos andantes:[/color] No puedes contratar en las ciudades, pero puedes encontrar reclutas patrullando cerca de fosas comunes, castillos hundidos y el Monolito. Los antiguos muertos son tus aliados.\n"
    }
    // context: legend_risen_legion_scenario.onSpawnPlayer.n.addPlayerRelation()
    {
        en = "For the empire!"
        es = "¡Por el imperio!"
    }
    // FILE: scripts\scenarios\world\legends_assassin_scenario.nut
    // context: legends_assassin_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_51.png[/img][/p][p] An assassin down on their luck with limited supplies. \n\n[color=#bcad8c]Dirty Deeds:[/color] You will grant the Backstabber perk to anyone who joins you. \n[color=#bcad8c]Underworld:[/color] You have a small chance of finding other Assassins for hire. Outlaws are 50% cheaper to hire and maintain, all other backgrounds are the same cost.\n[color=#bcad8c]Avatar:[/color] Begin alone. If you die, it is game over.[/p]"
        es = "[p=c][img]gfx/ui/events/event_51.png[/img][/p][p] Te dedicas al asesinato, pero la suerte te ha dado la espalda y apenas tienes provisiones. \n\n[color=#dda21f]Trabajos sucios:[/color] Concederás la ventaja Oportunista a todo el que se te una. \n[color=#dda21f]Bajos fondos:[/color] Tienes una pequeña probabilidad de encontrar otros Asesinos a sueldo. Los Proscritos cuestan un [color=#1e861e]50%[/color] menos de contratar y mantener; los demás trasfondos cuestan lo mismo.\n[color=#dda21f]Avatar:[/color] Empiezas en solitario. Si mueres, se acaba la partida.[/p]"
    }
    // context: legends_assassin_scenario.onHiredByScenario._bro.worsenMood()
    {
        en = "Is uncomfortable with joining an assassin"
        es = "Le incomoda servir a quien asesina por encargo"
    }
    // context: legends_assassin_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "Is excited at becoming part of outlaw company"
        es = "Le entusiasma formar parte de una compañía de proscritos"
    }
    // FILE: scripts\scenarios\world\legends_beggar_scenario.nut
    // context: legends_beggar_scenario.create.m.Name
    {
        en = "Original Beggar Challenge"
        es = "Desafío del mendigo original"
    }
    // context: legends_beggar_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_70.png[/img][/p][p]A lowly unskilled beggar, you witnessed something in an alley and now a noble house wants you dead. This is a challenge run with a very weak starting character. \n\n[color=#bcad8c]Knows Too Much:[/color] All noble houses hate you.\n[color=#bcad8c]Begin alone Avatar[/color]: If the beggar dies, the campaign ends.\n[color=#bcad8c]Dirty Peasant[/color]: You can only hire lowerborn backgrounds.[/p]"
        es = "[p=c][img]gfx/ui/events/event_70.png[/img][/p][p]Vives de pedir limosna, sin oficio alguno; viste algo en un callejón y ahora una casa noble quiere tu cabeza. Es una partida de desafío con un personaje inicial muy débil. \n\n[color=#dda21f]Sabe demasiado:[/color] Todas las casas nobles te odian.\n[color=#dda21f]Avatar en solitario[/color]: Si tu personaje muere, la campaña termina.\n[color=#dda21f]Mugre campesina[/color]: Solo puedes contratar trasfondos de baja cuna.[/p]"
    }
    // context: legends_beggar_scenario.onSpawnAssets.bro.worsenMood()
    {
        en = "Saw something awful"
        es = "Vio algo horrible"
    }
    // context: legends_beggar_scenario.onSpawnPlayer.f.addPlayerRelation()
    {
        en = "You know too much"
        es = "Sabes demasiado"
    }
    // context: legends_beggar_scenario.onHiredByScenario._bro.worsenMood()
    {
        en = "Fell sick after joining you"
        es = "Enfermó tras unirse a ti"
    }
    // FILE: scripts\scenarios\world\legends_berserker_scenario.nut
    // context: legends_berserker_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_139.png[/img][/p][p]You are a barbarian berserker, driven by an unbound rage. Watching your family be slaughtered drove you into a self-destructive frenzy of violence and revenge.\n\n[color=#bcad8c]Berserker Madness:[/color] Unlock powerful abilities that allow you to fight naked and bare-handed.\n[color=#bcad8c]Infectious Rage:[/color] Only the insane, violent or desperate will join you. You will grant the Berserk perk to anyone who joins you in battle. You have a tiny chance of finding other berserkers for hire.\n[color=#bcad8c]Avatar:[/color] Begin alone. If you die, it is game over.[/p]"
        es = "[p=c][img]gfx/ui/events/event_139.png[/img][/p][p]Eres un berserker bárbaro movido por una furia sin límites. Ver cómo masacraban a tu familia te arrojó a un frenesí autodestructivo de violencia y venganza.\n\n[color=#dda21f]Locura berserker:[/color] Desbloqueas capacidades poderosas para luchar desnudo y a mano limpia.\n[color=#dda21f]Furia contagiosa:[/color] Solo se te unirán dementes, violentos o desesperados. Todo el que se te una en batalla obtiene la ventaja Berserker. Hay una probabilidad ínfima de encontrar otros berserkers a sueldo.\n[color=#dda21f]Avatar:[/color] Empiezas en solitario. Si mueres, se acaba la partida.[/p]"
    }
    // context: legends_berserker_scenario.onSpawnPlayer.houses[i].Faction.addPlayerRelation()
    {
        en = "You are considered a barbarian"
        es = "Te consideran de estirpe bárbara"
    }
    // context: legends_berserker_scenario.onHiredByScenario._bro.worsenMood()
    {
        en = "Disturbed by your wild and erratic nature"
        es = "Le perturba tu carácter salvaje y errático"
    }
    // context: legends_berserker_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "Excited by your lust for battle"
        es = "Le entusiasma tu sed de batalla"
    }
    // context: legends_berserker_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "Learned a new skill"
        es = "Aprendió una nueva habilidad"
    }
    // FILE: scripts\scenarios\world\legends_crusader_scenario.nut
    // context: legends_crusader_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_35.png[/img][/p][p]Sent on a holy quest to rid the world of undead, you walk a righteous path. \n\n[color=#bcad8c]Pure of Heart:[/color] You cannot recruit outlaw backgrounds, while pious recruits and squires cost less.\n[color=#bcad8c]Strict Sermons:[/color] You will grant the Fortified Mind perk to any pious background that joins you. Find Pilgrims to aid you on your journey.\n[color=#bcad8c]Avatar:[/color] If your crusader dies, the campaign ends.[/p]"
        es = "[p=c][img]gfx/ui/events/event_35.png[/img][/p][p]Te enviaron en una misión sagrada para librar al mundo de los no muertos, y recorres una senda justa. \n\n[color=#dda21f]Pureza de corazón:[/color] No puedes reclutar trasfondos proscritos, y los reclutas piadosos y los escuderos cuestan menos.\n[color=#dda21f]Sermones estrictos:[/color] Concederás la ventaja Mentalidad fuerte a cualquier trasfondo piadoso que se te una. Encuentra Peregrinos que te ayuden en tu viaje.\n[color=#dda21f]Avatar:[/color] Si mueres, la campaña termina.[/p]"
    }
    // context: legends_crusader_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "Joined a righteous cause"
        es = "Se unió a una causa justa"
    }
    // context: legends_crusader_scenario.onHiredByScenario._bro.worsenMood()
    {
        en = "Dislikes your sermons"
        es = "Le desagradan tus sermones"
    }
    // FILE: scripts\scenarios\world\legends_custom_scenario.nut
    // context: legends_custom_scenario.create.m.Name
    {
        en = "Build your own "
        es = "A tu medida"
    }
    // context: legends_custom_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_80.png[/img][/p]Build and customize your company roster (Your very own pick and choose adventure!)"
        es = "[p=c][img]gfx/ui/events/event_80.png[/img][/p]Forma y personaliza la plantilla de tu compañía (¡tu propia aventura a la carta!)"
    }
    // FILE: scripts\scenarios\world\legends_debug_scenario.nut
    // context: legends_debug_scenario.create.m.Name
    {
        en = "(Developer Debug)"
        es = "(Depuración de desarrollo)"
    }
    // context: legends_debug_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_80.png[/img][/p]Debug mode for legends developers"
        es = "[p=c][img]gfx/ui/events/event_80.png[/img][/p]Modo de depuración para los desarrolladores de Legends"
    }
    // context: legends_debug_scenario.onSpawnAssets.weapons
    // en = "bardiche"  // identificador de arma para construir la ruta del objeto en el escenario de depuración, no se muestra
    // context: legends_debug_scenario.onSpawnAssets.weapons
    // en = "billhook"  // identificador de arma para construir la ruta del objeto en el escenario de depuración, no se muestra
    // context: legends_debug_scenario.onSpawnAssets.weapons
    // en = "crossbow"  // identificador de arma para construir la ruta del objeto en el escenario de depuración, no se muestra
    // context: legends_debug_scenario.onSpawnAssets.weapons
    // en = "greataxe"  // identificador de arma para construir la ruta del objeto en el escenario de depuración, no se muestra
    // context: legends_debug_scenario.onSpawnAssets.weapons
    // en = "javelin"  // identificador de arma para construir la ruta del objeto en el escenario de depuración, no se muestra
    // context: legends_debug_scenario.onSpawnAssets.weapons
    // en = "estoc"  // identificador de arma para construir la ruta del objeto en el escenario de depuración, no se muestra
    // context: legends_debug_scenario.onSpawnAssets.weapons
    // en = "scimitar"  // identificador de arma para construir la ruta del objeto en el escenario de depuración, no se muestra
    // context: legends_debug_scenario.onSpawnAssets.weapons
    // en = "shamshir"  // identificador de arma para construir la ruta del objeto en el escenario de depuración, no se muestra
    // context: legends_debug_scenario.onSpawnAssets.weapons
    // en = "spetum"  // identificador de arma para construir la ruta del objeto en el escenario de depuración, no se muestra
    // FILE: scripts\scenarios\world\legends_druid_scenario.nut
    // context: legends_druid_scenario.create.m.Name
    {
        en = "Druid [Legacy]"
        es = "Druida [Antiguo]"
    }
    // context: legends_druid_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_25.png[/img][/p][p]The druids of the wild woods are wary of humans, prefering the company of beasts \n\n[color=#bcad8c]Wildform:[/color] Can take on the form of beasts in battle.\n[color=#bcad8c]Solitary:[/color] The Druid hates nearly all humans except wildlings, herbalists and practictioners of wild magic \n[color=#bcad8c]Avatar:[/color] If your druid dies, its game over.[/p]"
        es = "[p=c][img]gfx/ui/events/event_25.png[/img][/p][p]Los druidas de los bosques salvajes recelan de los humanos y prefieren la compañía de las bestias \n\n[color=#dda21f]Forma salvaje:[/color] Puede adoptar forma de bestia en combate.\n[color=#dda21f]Vida solitaria:[/color] Odia a casi todos los humanos, excepto a los salvajes, los herbolarios y quienes practican la magia salvaje \n[color=#dda21f]Avatar:[/color] Si tu druida muere, se acaba la partida.[/p]"
    }
    // context: legends_druid_scenario.onSpawnAssets.bros[0].getBackground().m.RawDescription
    {
        en = "%name% has only ever known the wild woods, the worlds of men are strange and disgusting"
        es = "%name% solo ha conocido los bosques salvajes; los mundos de los hombres le resultan extraños y repugnantes"
    }
    // FILE: scripts\scenarios\world\legends_escaped_slaves_scenario.nut
    // context: legends_escaped_slaves_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_166.png[/img][/p][p]You lead a group of slaves trying to escape their cruel fate, but you cannot run forever. Can you keep your band intact and start a new life as mercenaries?\n\n[color=#bcad8c]Escapees:[/color] Start with five escaped Indebted and find others held in captivity.\n[color=#bcad8c]Brothers in Chains:[/color] Your newfound family of Indebted are stronger together and gain skill based on how many you field.\n[color=#bcad8c]Downtrodden and Discarded:[/color] Good relations with any faction decay 15% faster and bad relations recover 15% slower.[/p]"
        es = "[p=c][img]gfx/ui/events/event_166.png[/img][/p][p]Lideras a un grupo de esclavos que intenta escapar de su cruel destino, pero no puedes huir para siempre. ¿Lograrás mantener unida a tu banda y empezar una nueva vida como mercenarios?\n\n[color=#dda21f]Fugitivos:[/color] Empiezas con cinco Endeudados fugados y encuentras a otros en cautiverio.\n[color=#dda21f]Hermanos encadenados:[/color] Tu nueva familia de Endeudados es más fuerte unida y gana destreza según cuántos despliegues.\n[color=#dda21f]Oprimidos y desechados:[/color] Las buenas relaciones con cualquier facción se deterioran un [color=#a22424]15%[/color] más rápido y las malas se recuperan un [color=#a22424]15%[/color] más despacio.[/p]"
    }
    // context: legends_escaped_slaves_scenario.onSpawnAssets.bros[0].getBackground().m.RawDescription
    {
        en = "%name% was a sellsword like yourself before being enslaved and made a pit fighter. The arena was where you first met, the two of you saving each other several times in a bout against an unhold. You have been as close as siblings ever since. When you escaped, %name% was the first to pick up arms and follow and you know %name% will be the last to put them down, too."
        es = "%name% vivía de la espada, como tú, hasta caer en la esclavitud y acabar luchando en los fosos. Se conocieron en la arena, donde se salvaron la vida varias veces en un combate contra un trol. Desde entonces son uña y carne, como si fueran familia. Cuando escaparon, %name% fue quien primero tomó las armas para seguirte, y sabes que nadie las dejará después de %name%."
    }
    // context: legends_escaped_slaves_scenario.onSpawnAssets.bros[0].improveMood()
    {
        en = "Escaped a life of slavery"
        es = "Escapó de una vida de esclavitud"
    }
    // context: legends_escaped_slaves_scenario.onSpawnAssets.bros[1].getBackground().m.RawDescription
    {
        en = "A truly massive figure, %name% hulks like a boulder and has a face about as pretty. The night you escaped, you personally witnessed the savage rip a nomad's arm out of its socket and beat an ifrit to rubble with it. When you asked the barbarian what the newly-earned freedom meant, %name% simply responded  'I must slay a god. Fight with you for now.' You decided it was prudent not to press for details."
        es = "Una figura realmente descomunal: %name% se alza como una roca y tiene una cara igual de bonita. La noche de la fuga viste con tus propios ojos cómo arrancaba de cuajo el brazo a un nómada y con él reducía a escombros a un ifrit. Cuando le preguntaste qué significaba la libertad recién ganada, %name% se limitó a responder: 'Debo matar a un dios. Por ahora, luchar contigo.' Te pareció prudente no insistir en los detalles."
    }
    // context: legends_escaped_slaves_scenario.onSpawnAssets.potentialTitles
    {
        en = "the Reticent"
        es = "el Reticente"
    }
    // en = "the Cursed"
    // en base_es
    // context: legends_escaped_slaves_scenario.onSpawnAssets.bros[2].getBackground().m.RawDescription
    {
        en = "Formerly a gunner in a city-state regiment, %name% has never quite fit in with the rest of the Indebted. Cast out of the army and branded a heretic for some religious slight %name% refuses to talk about. The gunner was relegated to a disdained social strata and never managed to truly lose that distaste. Regardless, %name% is one of you now and shows enough talent that you are willing to overlook that personality."
        es = "Tras servir con armas de fuego en un regimiento de una ciudad estado, %name% nunca ha terminado de encajar con el resto de los Endeudados. Le costó la expulsión del ejército y el estigma de hereje alguna ofensa religiosa de la que %name% se niega a hablar. Acabó en un estrato social despreciado y nunca ha logrado sacudirse del todo ese desdén. En cualquier caso, %name% ahora es de los tuyos y muestra el talento suficiente como para que pases por alto su carácter."
    }
    // context: legends_escaped_slaves_scenario.onSpawnAssets.bros[2].worsenMood()
    {
        en = "Misses life in the army"
        es = "Echa de menos la vida en el ejército"
    }
    // context: legends_escaped_slaves_scenario.onSpawnAssets.bros[3].getBackground().m.RawDescription
    {
        en = "If you had to describe %name% in one word, it would be 'ornery.' Bitter about life before becoming indebted, bitter about life as a slave, and now bitter about life on the run. Perhaps that bitterness is what compels %name% to cling to life so, having taken enough lashings and beatings for three men, endured punishments meant to kill and even gotten back up after catching an ifrit toss square in the chest. %name% is pretty bitter about that one, too."
        es = "Si tuvieras que describir a %name% con una palabra, sería 'cascarrabias'. Le amargaba la vida que llevaba antes de endeudarse, le amargó la vida de esclavitud y ahora le amarga la vida a la fuga. Quizá sea esa amargura lo que hace que %name% se aferre tanto a la vida: ha recibido latigazos y palizas como para tres hombres, ha soportado castigos pensados para matar e incluso se levantó tras encajar de lleno en el pecho una roca lanzada por un ifrit. Eso también le amarga bastante a %name%."
    }
    // context: legends_escaped_slaves_scenario.onSpawnAssets.bros[3].worsenMood()
    {
        en = "Feels he deserves better in life"
        es = "Cree que merece algo mejor en la vida"
    }
    // context: legends_escaped_slaves_scenario.onSpawnAssets.bros[4].getBackground().m.RawDescription
    {
        en = "A scholar in a previous life, %name% was cast into slavery for research that was deemed offensive to the Gilder. The scholar accepted a new life with a grace few can muster. When the opportunity came to escape with you however, there was no hesitation, simply stating that this was the next fated path to take. It does not really make sense to you, but you do not care to debate after seeing the gruesome death of the conscript whose equipment %name% now wears."
        es = "En otra vida, %name% se dedicaba al estudio y acabó en la esclavitud por unas investigaciones que se consideraron ofensivas para el Dorado. Aceptó su nueva vida con una entereza que pocos logran reunir. Sin embargo, cuando surgió la ocasión de escapar contigo, no hubo vacilación: se limitó a decir que ese era el siguiente camino que le marcaba el destino. A ti no te acaba de cuadrar, pero no tienes ganas de discutirlo después de ver la espantosa muerte del recluta cuyo equipo lleva ahora %name%."
    }
    // context: legends_escaped_slaves_scenario.onSpawnAssets.bros[4].setTitle()
    {
        en = "the Sage"
        es = "el Sabio"
    }
    // context: legends_escaped_slaves_scenario.onSpawnPlayer.cityStateFaction.addPlayerRelation()
    {
        en = "You escaped before repaying your debts to the Gilder"
        es = "Escaparon antes de saldar sus deudas con el Dorado"
    }
    // context: legends_escaped_slaves_scenario.onSpawnPlayer.c.addPlayerRelation()
    {
        en = "You are rumored to be escaped Indebted"
        es = "Se rumorea que son Endeudados fugados"
    }
    // context: legends_escaped_slaves_scenario.setRetireText._bro.getBackground().m.GoodEnding
    {
        en = "You freed the indebted %name% and helped them find a new life as a sellsword. %name% did become an effective fighter, no doubt believing it was better to fight and live free than to fight and die. After your departure, you heard that the %companyname% traveled south on a campaign and the indebted got a good chance to exact a fair bit of revenge on a number of enemies from the past. You count yourself lucky to have served in the same company."
        es = "Liberaste a %name% de las cadenas de la deuda y le ayudaste a encontrar una nueva vida vendiendo su espada. %name% aprendió a luchar con eficacia, sin duda porque creía que era mejor luchar y vivir libre que luchar y morir. Después de tu marcha, te enteraste de que la %companyname% viajó al sur en campaña y que aquella alma antes esclavizada tuvo buena ocasión de cobrarse cumplida venganza de unos cuantos enemigos del pasado. Para ti fue una suerte haber servido en la misma compañía."
    }
    // context: legends_escaped_slaves_scenario.setRetireText._bro.getBackground().m.BadEnding
    {
        en = "You found %name% as an indebted and after your retiring, they went on with the %companyname%. Word of the mercenary band's problems have trickled in, but nothing about the indebted's current situation. Knowing how this world works, the slave has either been put into the vanguard as fodder or forced out to distract manhunters on the company's trail. Either way, the world isn't easy on a sellsword, and it isn't easy on an indebted, and this mercenary is unfortunately both."
        es = "Encontraste a %name% en la esclavitud por deudas y, tras tu retiro, siguió con la %companyname%. Te han llegado con cuentagotas noticias de los problemas de la banda de mercenarios, pero nada sobre su situación actual. Sabiendo cómo funciona este mundo, o habrá acabado en la vanguardia como carne de cañón o tuvo que salir a distraer a los cazadores de hombres que seguían el rastro de la compañía. Sea como sea, el mundo no es amable con quien vende su espada ni con quien vive endeudado, y por desgracia este caso reúne ambas cosas."
    }
    // context: legends_escaped_slaves_scenario.setRetireText._bro.getBackground().m.GoodEnding
    {
        en = "%name% the indebted has had a rough life and you've both contributed to that and helped alleviate it in some way. You found them as a slave, far from family and home, and put them to work as a sellsword. After you left the %companyname%, they stayed on and has been rising through its ranks ever since. You hear they were so ferocious in a battle with manhunters that the city-states have reconsidered sending men after the company at all, fearing what might happen if %name% took the fight to them more directly."
        es = "%name% ha tenido una vida dura, sometida a la deuda, y tú has contribuido a ello y a la vez has ayudado a aliviarla de algún modo. Cuando diste con esta alma esclava, lejos de su familia y su hogar, la pusiste a trabajar vendiendo su espada. Tras tu marcha de la %companyname%, se quedó y desde entonces no ha dejado de ascender en sus filas. Dicen que luchó con tal ferocidad en una batalla contra cazadores de hombres que las ciudades estado se están replanteando si enviar a nadie tras la compañía, por miedo a lo que podría pasar si %name% llevara la lucha hasta ellas de forma más directa."
    }
    // context: legends_escaped_slaves_scenario.setRetireText._bro.getBackground().m.BadEnding
    {
        en = "With your retiring from the unsuccessful %companyname%, %name% the indebted from the north carried on with the company for a time. You got wind that the mercenary band ran into troubles with manhunters and had to leave behind both 'man and material' to escape. %name%'s time with the company presumably ended sometime there. You hope %name%'s time as a slave never started again."
        es = "Tras tu retiro de la fracasada %companyname%, %name%, aquella alma endeudada del norte, siguió un tiempo en la compañía. Te llegó el rumor de que la banda de mercenarios tuvo problemas con cazadores de hombres y tuvo que dejar atrás 'hombres y material' para escapar. Es de suponer que el paso de %name% por la compañía terminó en algún momento de aquello. Esperas que %name% no haya vuelto nunca a la esclavitud."
    }
    // context: legends_escaped_slaves_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "Joined a mercenary company of freed slaves"
        es = "Unirse a una compañía mercenaria de esclavos liberados"
    }
    // context: legends_escaped_slaves_scenario.onHiredByScenario._bro.worsenMood()
    {
        mode = "pattern"
        en = "You hired <name:str> the manhunter"
        es = "Contrataste a <name>, que caza hombres"
    }
    // FILE: scripts\scenarios\world\legends_free_company_scenario.nut
    // context: legends_free_company_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_65.png[/img][/p][p]No desperate circumstances or fates to be rewritten. Take control of a successful mercenary company on the brink of becoming famous. \n[color=#bcad8c]Professional Army:[/color] Start with a roster of 5 experienced fighters in a well rounded company.\n[color=#bcad8c]Almost famous:[/color] Start with a larger roster size and professional renown.\n[color=#bcad8c]Soldiers of fortune:[/color] Can recruit everyone except unique backgrounds from other origins. No effect on trade, recruiting or upkeep.\n[color=#bcad8c]Recommended for newer players fresh from vanilla or who want a jump start.[/color][/p]"
        es = "[p=c][img]gfx/ui/events/event_65.png[/img][/p][p]Ni circunstancias desesperadas ni destinos que reescribir. Toma el mando de una compañía mercenaria de éxito a punto de hacerse famosa. \n[color=#dda21f]Ejército profesional:[/color] Empiezas con 5 combatientes con experiencia en una compañía equilibrada.\n[color=#dda21f]Casi famosos:[/color] Empiezas con una plantilla más amplia y renombre de nivel profesional.\n[color=#dda21f]Soldados de fortuna:[/color] Puedes reclutar a cualquiera salvo los trasfondos únicos de otros orígenes. Sin efecto en el comercio, el reclutamiento ni la manutención.\n[color=#dda21f]Recomendado para quienes llegan del juego base o quieren empezar con ventaja.[/color][/p]"
    }
    // FILE: scripts\scenarios\world\legends_horse_scenario.nut
    // context: legends_horse_scenario.create.m.Name
    {
        en = "Horse party"
        es = "Grupo a caballo"
    }
    // context: legends_horse_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_41.png[/img][/p][p]You are running a small trading caravan and have most of your crowns invested into trading goods. But the roads have become dangerous - brigands and greenskins lay in ambush, and there are rumors of even worse things out there.\n\n[color=#bcad8c]Caravan:[/color] Start with a trader and a donkey.\n[color=#bcad8c]Trader:[/color] Get 10% better prices for buying and selling.\n[color=#bcad8c]Not a Warrior:[/color] Start with no renown, and gain renown at half the normal rate.\n[color=#bcad8c]Bribery:[/color] Pay off human enemies instead of fighting them[/p]"
        es = "[p=c][img]gfx/ui/events/event_41.png[/img][/p][p]Diriges una pequeña caravana comercial y tienes casi todas tus coronas invertidas en mercancías. Pero los caminos se han vuelto peligrosos: bandidos y pielesverdes acechan emboscados, y se rumorea que ahí fuera hay cosas aún peores.\n\n[color=#dda21f]Caravana:[/color] Empiezas con tu comerciante y un burro.\n[color=#dda21f]Comerciante:[/color] Obtienes precios un [color=#1e861e]10%[/color] mejores al comprar y vender.\n[color=#dda21f]Sin madera de guerrero:[/color] Empiezas sin renombre y ganas renombre a la mitad del ritmo normal.\n[color=#dda21f]Soborno:[/color] Paga a los enemigos humanos en lugar de combatirlos[/p]"
    }
    // FILE: scripts\scenarios\world\legends_inquisition_scenario.nut
    // context: legends_inquisition_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_40.png[/img][/p]There is a great evil in the world, the undead walk the earth and cultists hide in every town. The holy must purge the filth.\n\n[color=#bcad8c]Endless Dead:[/color] Begins with the Undead Crisis already underway, and it can repeat \n\n[color=#bcad8c]Righteous Cause:[/color] Can't recruit outlaw backgrounds but more holy backgrounds available to hire\n[color=#bcad8c]Penitence:[/color] Anyone you hire gains the Mind over Body perk.\n"
        es = "[p=c][img]gfx/ui/events/event_40.png[/img][/p]Hay un gran mal en el mundo: los no muertos caminan sobre la tierra y hay cultistas escondidos en cada pueblo. Los santos deben purgar la inmundicia.\n\n[color=#dda21f]Muertos sin fin:[/color] Empieza con la crisis de los no muertos ya en marcha, y puede repetirse \n\n[color=#dda21f]Causa justa:[/color] No puedes reclutar trasfondos de forajido, pero hay más trasfondos sagrados disponibles para contratar\n[color=#dda21f]Penitencia:[/color] Todo el que contrates obtiene la ventaja Mente sobre cuerpo.\n"
    }
    // context: legends_inquisition_scenario.onSpawnAssets.bros[0].getBackground().m.RawDescription
    {
        en = "{%name% has no greater joy than suffering in the name of the old gods. Pain and pleasure and intimately linked, just as creation and desctruction are intwined. Each lash of the whip is like the caress of an angel, and their belief is that in only through suffering can we find salvation. Few laymen understand this viewpoint, but it is respected by other servants of the old gods.}"
        es = "{Para %name% no hay mayor dicha que sufrir en nombre de los viejos dioses. El dolor y el placer están íntimamente ligados, igual que la creación y la destrucción están entrelazadas. Cada latigazo es como la caricia de un ángel, y cree que solo a través del sufrimiento podemos hallar la salvación. Pocos legos entienden este punto de vista, pero otros siervos de los viejos dioses lo respetan.}"
    }
    // context: legends_inquisition_scenario.onSpawnAssets.bros[1].getBackground().m.RawDescription
    {
        en = "{%name% has seen well the damage magic can bring to the world. The witches who steal the minds of men, the nightmares that end lives, and the necromancers who bring them back again. Hunting these foul creatures is the duty of all who serve the good of the gods. If the war is to be won, %name% will need a witch hunter army.}"
        es = "{%name% ha visto bien el daño que la magia puede causar al mundo. Las brujas que roban la mente de los hombres, las pesadillas que siegan vidas y los nigromantes que las devuelven otra vez. Cazar a estas criaturas inmundas es deber de todo el que sirve al bien de los dioses. Si se quiere ganar la guerra, %name% necesitará un ejército de cazadores de brujas.}"
    }
    // context: legends_inquisition_scenario.onSpawnAssets.bros[1].improveMood()
    {
        en = "Recently purged the unworthy"
        es = "Purgó hace poco a los indignos"
    }
    // context: legends_inquisition_scenario.onSpawnAssets.bros[2].getBackground().m.RawDescription
    {
        en = "{%name% is a huge figure, who spent many years in a temple healing and carrying the sick, learning the power of both strength and compassion. It was clear the ills of the world must be sought out and healed at their source. While healing a witch hunter, %name% was convinced to join the hunt to heal the world. }"
        es = "{%name% es una figura enorme que pasó muchos años en un templo curando y cargando a los enfermos, y aprendió el poder tanto de la fuerza como de la compasión. Estaba claro que había que buscar los males del mundo y curarlos en su origen. Mientras curaba a un cazador de brujas, %name% se dejó convencer para unirse a la cacería y sanar el mundo. }"
    }
    // FILE: scripts\scenarios\world\legends_mage_scenario.nut
    // context: legends_mage_scenario.create.m.Name
    {
        en = "Mage"
        es = "Mago"
    }
    // context: legends_mage_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_120.png[/img][/p][p]You have always been different from those around you. By training your spirit, you discovered that you could concentrate the magic that normally only exists as a whisper in the background. Bring together those who would support you and make good use of your power.\n\n[color=#bcad8c]Sage:[/color] Educated people want to work for you, the uneducated fear you.\n[color=#bcad8c]Teacher[/color] Anyone you fight with gains the Student perk.\n[color=#bcad8c]Avatar:[/color] If your mage dies, the campaign ends.[/p]"
        es = "[p=c][img]gfx/ui/events/event_120.png[/img][/p][p]Siempre te has diferenciado de quienes te rodean. Al entrenar tu espíritu, descubriste que podías concentrar la magia que normalmente solo existe como un susurro de fondo. Reúne a quienes estén dispuestos a apoyarte y haz buen uso de tu poder.\n\n[color=#dda21f]Sabiduría:[/color] La gente instruida quiere trabajar para ti; la que no lo es te teme.\n[color=#dda21f]Mentor[/color] Todo el que luche contigo obtiene la ventaja Estudiante.\n[color=#dda21f]Avatar:[/color] Si tu personaje muere, la campaña termina.[/p]"
    }
    // context: legends_mage_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "Excited to study under you"
        es = "Le entusiasma estudiar contigo"
    }
    // context: legends_mage_scenario.onHiredByScenario._bro.worsenMood()
    {
        en = "Scared of your magic"
        es = "Le asusta tu magia"
    }
    // context: legends_mage_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "Keen to learn from a master"
        es = "Tiene ganas de aprender de quien domina su arte"
    }
    // context: legends_mage_scenario.onHiredByScenario._bro.worsenMood()
    {
        en = "Thinks you are a boring nerd"
        es = "Te considera un ratón de biblioteca sin gracia"
    }
    // context: legends_mage_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "Thinks magic is pretty useful"
        es = "Cree que la magia es bastante útil"
    }
    // context: legends_mage_scenario.onHiredByScenario.bro.worsenMood()
    {
        en = "Thinks your magic will bring them ruin"
        es = "Cree que tu magia le traerá la ruina"
    }
    // FILE: scripts\scenarios\world\legends_necro_scenario.nut
    // context: legends_necro_scenario.create.m.Name
    {
        en = "The Cabal"
        es = "La Camarilla"
    }
    // context: legends_necro_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_29.png[/img][/p][p] Death is no barrier, others flee from its yawning abyss, but we embrace the other side. \n\n[color=#bcad8c]Dark arts:[/color] Start with three apprentice necromancers, each with their own strengths and weaknesses. Killed fighters in your employ have a chance to survive as undead.\n[color=#bcad8c]Gruesome harvest:[/color] Collect human corpses to fashion new minions, maintain them with medical supplies.\n[color=#bcad8c]Blood magic:[/color] Cultists and other macabre backgrounds will flock to join you and cost 25% less to maintain. Cannot hire pious backgrounds. Everyone else costs 50% more to upkeep.\n[color=#bcad8c]Avatars:[/color] If all three necromancers die, the spell is broken and the story ends.[/p]"
        es = "[p=c][img]gfx/ui/events/event_29.png[/img][/p][p] La muerte no es ninguna barrera; otros huyen de su abismo insondable, pero nosotros abrazamos el otro lado. \n\n[color=#dda21f]Artes oscuras:[/color] Empiezas con tres aprendices de nigromante, cada uno con sus propias virtudes y defectos. Los combatientes a tu servicio que mueran tienen una probabilidad de sobrevivir como no muertos.\n[color=#dda21f]Cosecha macabra:[/color] Recoge cadáveres humanos para fabricar nuevos esbirros y mantenlos con medicina.\n[color=#dda21f]Magia de sangre:[/color] Los cultistas y otros trasfondos macabros acudirán en masa a unirse a ti y su mantenimiento costará un [color=#1e861e]25%[/color] menos. No puedes contratar trasfondos piadosos. El mantenimiento de todos los demás cuesta un [color=#a22424]50%[/color] más.\n[color=#dda21f]Avatares:[/color] Si los tres nigromantes mueren, el hechizo se rompe y la historia termina.[/p]"
    }
    // context: legends_necro_scenario.onSpawnAssets.bros[3].getBackground().m.RawDescription
    {
        en = "Once a proud necromancer, %name% took three pupils under their wing to train the next generation of great necromancers. What %name% did not seeing coming is a heart attack - one that left them like a corpse like they used to command. With this macabre irony in mind, they now serve their students in unlife as little more than fodder."
        es = "Cuando aún presumía de su nigromancia, %name% tomó a tres pupilos bajo su ala para formar a la próxima generación de grandes nigromantes. Lo que %name% no vio venir fue un ataque al corazón, que dejó su cuerpo como uno de los cadáveres que antes comandaba. Con esta macabra ironía presente, ahora sirve a sus alumnos en la no muerte como poco más que carne de cañón."
    }
    // context: legends_necro_scenario.onCombatFinished.bro.getBackground().m.RawDescription
    {
        en = "{While a death like any other, %name% cannot help but feel a greater sense of loss at their fallen friend - should we raise them like we do everyone else? How are we supposed to know? One thing is for sure, this time it feels differant... }"
        es = "{Aunque es una muerte como cualquier otra, %name% no puede evitar sentir con más fuerza la pérdida de alguien tan cercano: ¿deberíamos alzar su cuerpo como hacemos con todos los demás? ¿Cómo vamos a saberlo? Una cosa es segura: esta vez se siente distinto... }"
    }
    // context: legends_necro_scenario.onCombatFinished.bro.getBackground().m.RawDescription
    {
        en = "{And then there was one, alone and adrift in a merciless world. %name% mourns the passing of their two closest friends. Maybe they weren't cut out for this...maybe none of them were? What if this is just one giant mistake?}"
        es = "{Y al final no quedó más que una persona, sola y a la deriva en un mundo despiadado. %name% llora la muerte de sus dos amigos más cercanos. Quizá esto no era lo suyo... ¿quizá no lo era para ninguno de ellos? ¿Y si todo esto no es más que un error enorme?}"
    }
    // context: legends_necro_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "These people really understand me!"
        es = "¡Esta gente me entiende de verdad!"
    }
    // context: legends_necro_scenario.onHiredByScenario._bro.worsenMood()
    {
        en = "Something doesn't feel right here..."
        es = "Aquí hay algo que no me da buena espina..."
    }
    // context: legends_necro_scenario.onGetBackgroundTooltip._tooltip.push().text
    {
        en = "[color=%positive%]+10[/color] Melee Skill from being in a necromancer's employ"
        es = "[color=#135213]+10[/color] Habilidad cuerpo a cuerpo por estar al servicio de un nigromante"
    }
    // FILE: scripts\scenarios\world\legends_noble_scenario.nut
    // context: legends_noble_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_96.png[/img][/p][p] You are a noble on the run from your house with your retainers. \n\n[color=#bcad8c]Usurper:[/color] Can unlock noble contracts from the start.\n[color=#bcad8c]Highborn:[/color] Nobles will cost 25% less, lowborns will cost 50% more, can't hire outlaws\n[color=#bcad8c]Trained leader:[/color] Your studies at the academy gave tactical skills, everyone begins with Tactical Maneuvers and future hires have Tactical Maneuvers as well.\n[color=#bcad8c]Avatar:[/color] if your character dies, it is game over.[/p]"
        es = "[p=c][img]gfx/ui/events/event_96.png[/img][/p][p] Perteneces a la nobleza y huyes de tu casa junto a tus vasallos. \n\n[color=#dda21f]Usurpación:[/color] Puedes desbloquear contratos de nobles desde el principio.\n[color=#dda21f]De alta cuna:[/color] Los nobles costarán un [color=#1e861e]25%[/color] menos y los de baja cuna un [color=#a22424]50%[/color] más; no puedes contratar forajidos\n[color=#dda21f]Formación de mando:[/color] Tus estudios en la academia te dieron conocimientos tácticos: todos empiezan con la ventaja Maniobras tácticas, y los futuros reclutas también lo tendrán.\n[color=#dda21f]Avatar:[/color] si tu personaje muere, se acaba la partida.[/p]"
    }
    // context: legends_noble_scenario.onSpawnAssets.bros[1].getBackground().m.RawDescription
    {
        en = "Though a lowly foot soldier %name% has one of the most upbeat outlooks on life you've ever encountered. Unfortunately that extends to an over evaluation of self worth, expecting more pay than most."
        es = "A pesar de servir como simple infantería, %name% tiene una de las visiones de la vida más optimistas que hayas visto nunca. Por desgracia, eso incluye una valoración exagerada de su propia valía, y espera cobrar más que la mayoría."
    }
    // context: legends_noble_scenario.onSpawnAssets.bros[2].getBackground().m.RawDescription
    {
        en = "%name% is a hulking figure, both upward and outward. Not much of a talker, but a big eater."
        es = "%name% es una figura descomunal, tanto a lo alto como a lo ancho. De pocas palabras, pero de mucho comer."
    }
    // context: legends_noble_scenario.onSpawnAssets.bros[3].getBackground().m.RawDescription
    {
        en = "%name%'s parents both served your family, it runs in the blood. While %name% is dependable in a fight and would never dream of leaving you, it also reduces their %name%'s ambition and drive"
        es = "Los padres de %name% sirvieron a tu familia; lo lleva en la sangre. Aunque %name% es de fiar en combate y jamás soñaría con abandonarte, eso también merma la ambición y el empuje de %name%"
    }
    // context: legends_noble_scenario.onSpawnAssets.bros[4].getBackground().m.RawDescription
    {
        en = "%name% has been a servant in your family for 5 generations now, it is unclear how anyone has survived this long, but there are no indications of the old coot giving up any time soon."
        es = "%name% lleva ya 5 generaciones sirviendo a tu familia; nadie sabe cómo alguien ha podido sobrevivir tanto tiempo, pero nada indica que esa reliquia vaya a rendirse pronto."
    }
    // context: legends_noble_scenario.onSpawnAssets.bros[5].getBackground().m.RawDescription
    {
        en = "%name% has won the house archery contest several years running, but never shuts up about it. The constant stream of narration makes the great aim easy to dodge."
        es = "%name% ha ganado el concurso de tiro con arco de la casa varios años seguidos, pero no deja de hablar de ello. Ese torrente constante de palabras hace que su gran puntería sea fácil de esquivar."
    }
    // context: legends_noble_scenario.onSpawnPlayer.f.addPlayerRelation()
    {
        en = "You chose the wrong faction"
        es = "Elegiste el bando equivocado"
    }
    // context: legends_noble_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "Supports your cause as a usurper, will cost less to maintain."
        es = "Apoya tu usurpación; su mantenimiento costará menos."
    }
    // context: legends_noble_scenario.onHiredByScenario._bro.worsenMood()
    {
        en = "Resents you as nobility, will try to squeeze money from you."
        es = "Te guarda rencor por ser de la nobleza; intentará sacarte dinero."
    }
    // FILE: scripts\scenarios\world\legends_nomad_scenario.nut
    // context: legends_nomad_scenario.create.m.Name
    {
        en = "Nomad Tribe"
        es = "Tribu nómada"
    }
    // context: legends_nomad_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_170.png[/img][/p][p]Displaced from your land, take control of 4 nomads and a conscript hunted in the desert. \n[color=#bcad8c]Hunted:[/color] Start in the desert away from civilisation. City States are hostile and will always decline in favour with you while Northern Nobles will have a cold relationship with you but will not decline. The more nomads in your party the stronger this effect will be.\n[color=#bcad8c]Nomadic:[/color] Vision radius is increased by 30% on the world map. Settlements may contain Nomads and Bladedancers displaced from their lands willing to fight for you. Nomads, Muladis and Bladedancers cost 25% less to hire and upkeep.\n[color=#bcad8c]The Path of the Interloper:[/color] Nomads and Muladis gain the 'Wind Reader' perk when recruited. Bladedancers gain the 'Dodge' perk. Other Nomads are friendly to you.[/p]"
        es = "[p=c][img]gfx/ui/events/event_170.png[/img][/p][p]Lejos de la tierra que te arrebataron, toma el mando de 4 nómadas y un recluta perseguidos en el desierto. \n[color=#dda21f]Perseguidos:[/color] Empiezas en el desierto, lejos de la civilización. Las Ciudades Estado son hostiles y su favor hacia ti no dejará de caer, mientras que los nobles del norte mantendrán contigo una relación fría, pero no irá a peor. Cuantos más nómadas haya en tu grupo, más fuerte será este efecto.\n[color=#dda21f]Vida nómada:[/color] El radio de visión aumenta un [color=#1e861e]30%[/color] en el mapa del mundo. En los asentamientos puede haber nómadas y Danzadores de la Espada desplazados de sus tierras y dispuestos a luchar por ti. Los nómadas, muladíes y Danzadores de la Espada cuestan un [color=#1e861e]25%[/color] menos de contratar y mantener.\n[color=#dda21f]La senda del intruso:[/color] Los nómadas y muladíes obtienen la ventaja 'Lector del viento' al ser reclutados. Los Danzadores de la Espada obtienen la ventaja 'Esquivar'. Los demás nómadas te son amistosos.[/p]"
    }
    // context: legends_nomad_scenario.onSpawnAssets.bros[0].getBackground().m.RawDescription
    {
        en = "{%name% is someone who you have known since they were a child. They always had a keen eye but had more interest in shooting things point blank with their sling instead. Their discovery of maces and swords changed their world for the better.}"
        es = "{Conoces a %name% desde la infancia. Siempre tuvo buen ojo, pero le interesaba más disparar a las cosas a quemarropa con su honda. Descubrir las mazas y las espadas cambió su mundo para bien.}"
    }
    // context: legends_nomad_scenario.onSpawnAssets.bros[1].getBackground().m.RawDescription
    {
        en = "{%name% came from another tribe that merged with yours not too long ago. Their family was butched in the night by 'skin men' who could travel thirty paces in a blink of the eye. While many think them unsettled by what appears to be a raid, you can't help but notice how they always sleep closest to the fire every night.}"
        es = "{%name% procede de otra tribu que se fusionó con la tuya no hace mucho. Su familia fue masacrada de noche por 'hombres de piel' capaces de recorrer treinta pasos en un abrir y cerrar de ojos. Aunque muchos atribuyen su inquietud a lo que parece una simple incursión, no puedes evitar fijarte en que todas las noches duerme lo más cerca posible del fuego.}"
    }
    // context: legends_nomad_scenario.onSpawnAssets.bros[2].getBackground().m.RawDescription
    {
        en = "{This outsider was close to death when you found them in the sands. While they lack the mindset and resolve you have come to expect from others, their training from the City States makes %them% a useful weapon to use against them.}"
        es = "{%Ese% foraster%o% estaba al borde de la muerte cuando %lo% encontraste en las arenas. Aunque le faltan la mentalidad y la resolución que esperas de los demás, su entrenamiento en las Ciudades Estado %lo% convierte en un arma útil contra ellas.}"
    }
    // context: legends_nomad_scenario.onSpawnAssets.bros[3].getBackground().m.RawDescription
    {
        en = "{You know little about %name%, they prefer to stay quiet and keep to themselves. However their loyalty to the tribe has never come into question.}"
        es = "{Sabes poco de %name%, que prefiere guardar silencio y no relacionarse con nadie. Sin embargo, su lealtad a la tribu nunca se ha puesto en duda.}"
    }
    // context: legends_nomad_scenario.onSpawnAssets.bros[4].getBackground().m.RawDescription
    {
        en = "{Be it rabbit, snake or hyena - little stands a chance against %name% who readily hits their target with all the same precision. The change to conscripts over wildlife came as a challenge at first until they realised they just needed to aim slightly lower than normal.}"
        es = "{Ya sea conejo, serpiente o hiena, pocas presas tienen alguna oportunidad contra %name%, que acierta a su blanco siempre con la misma precisión. Pasar de la fauna salvaje a los reclutas fue un desafío al principio, hasta que se dio cuenta de que solo tenía que apuntar un poco más bajo de lo normal.}"
    }
    // context: legends_nomad_scenario.onSpawnPlayer.n.addPlayerRelation()
    {
        en = "You are an outlaw to the City States"
        es = "Las Ciudades Estado te consideran fuera de la ley"
    }
    // context: legends_nomad_scenario.onSpawnPlayer.n.addPlayerRelation()
    {
        en = "You walk the same path, but should not be seeing this message"
        es = "Caminas por la misma senda, pero no deberías ver este mensaje"
    }
    // context: legends_nomad_scenario.onSpawnPlayer.n.addPlayerRelation()
    {
        en = "You are considered an outlaw"
        es = "Te consideran fuera de la ley"
    }
    // context: legends_nomad_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "I walk with those on the path of the Interloper"
        es = "Camino junto a quienes siguen la senda del Intruso"
    }
    // context: legends_nomad_scenario.onHiredByScenario._bro.worsenMood()
    {
        en = "Nomadic life isn't for me..."
        es = "La vida nómada no es para mí..."
    }
    // FILE: scripts\scenarios\world\legends_party_scenario.nut
    // context: legends_party_scenario.create.m.Name
    {
        en = "Adventuring Party"
        es = "Grupo de aventureros"
    }
    // context: legends_party_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_134.png[/img][/p][p]After an unlikely meeting in a tavern, an unlikely group of strangers has formed an adventuring party. They have set out in search of both dragons and dungeons.\n\n[color=#bcad8c]A party of six overpowered adventurers, each with their own skills and increased chances of encountering hostile champions[/color][/p]"
        es = "[p=c][img]gfx/ui/events/event_134.png[/img][/p][p]Tras un encuentro improbable en una taberna, un grupo improbable de desconocidos ha formado un grupo de aventureros. Han partido en busca tanto de dragones como de mazmorras.\n\n[color=#dda21f]Un grupo de seis aventureros desmesuradamente poderosos, cada uno con sus propias habilidades, y más probabilidades de encontrarse con campeones hostiles[/color][/p]"
    }
    // context: legends_party_scenario.onSpawnAssets.bro.improveMood()
    {
        en = "Joined an adventuring party"
        es = "Se unió a un grupo de aventureros"
    }
    // context: legends_party_scenario.onSpawnAssets.bros[0].getBackground().m.RawDescription
    {
        en = "{%name% was drunk when they agreed to join the party, now that they have sobered up you are not sure if hiring this brute was a good idea. The mercenary seems disturbed, unstable and prone to extreme violence. On the other hand, that could be very useful.}"
        es = "{%name% llevaba unas cuantas copas de más cuando aceptó unirse al grupo y, ahora que se le ha pasado la borrachera, no tienes claro si contratar a semejante bestia fue buena idea. Parece una persona perturbada, inestable y propensa a la violencia extrema. Por otro lado, eso podría resultar muy útil.}"
    }
    // context: legends_party_scenario.onSpawnAssets.bros[1].getBackground().m.RawDescription
    {
        en = "{%name% was acting weird when you met the hooded figure. After some time traveling with your party you found out %name% was hired to assassinate a local lord. %name% wanted to use your company as a temporary disguise but decided to stay.}"
        es = "{%name% se comportaba de forma extraña cuando conociste a aquella figura encapuchada. Tras viajar un tiempo con tu grupo, descubriste que habían contratado a %name% para asesinar a un señor local. %name% quería usar tu compañía como disfraz temporal, pero decidió quedarse.}"
    }
    // context: legends_party_scenario.onSpawnAssets.bros[2].getBackground().m.RawDescription
    {
        en = "{%name% is a righteous fighter, constantly chanting religious hymns and psalms. The crusader exists to fight the undead and has a burning passion against any kind of necromancy. How the holy warrior ever agreed to join forces with those who do not share a similar zeal remains a mystery.}"
        es = "{%name% lucha por la rectitud y no deja de entonar himnos religiosos y salmos. Vive para combatir a los no muertos y siente una pasión ardiente contra cualquier forma de nigromancia. Sigue siendo un misterio cómo llegó a aceptar unir fuerzas con quienes no comparten un fervor parecido.}"
    }
    // context: legends_party_scenario.onSpawnAssets.bros[3].getBackground().m.RawDescription
    {
        en = "{Druids are from the wild lands and are ardent defenders of nature.}"
        es = "{Los druidas proceden de las tierras salvajes y son ardientes defensores de la naturaleza.}"
    }
    // context: legends_party_scenario.onSpawnAssets.bros[4].getBackground().m.RawDescription
    {
        en = "{You can tell %name% is nobleborn from a thousand yards. The posture, the upper class mannerisms and the uncanny ability to never get as dirty as the rest of the party. A conniving, selfish liar with a silver tongue to boot, like any noble. Despite this, the blue-blood denies all connections to nobility and claims to be a commoner like everyone else.}"
        es = "{Se nota a mil pasos que %name% es de cuna noble. La postura, los modales de clase alta y esa asombrosa habilidad para no ensuciarse nunca tanto como el resto del grupo. Tiene la falsedad, el egoísmo y las intrigas de cualquier noble, y además un pico de oro. Aun así, niega cualquier vínculo con la nobleza y asegura ser del pueblo llano como todo el mundo.}"
    }
    // context: legends_party_scenario.onSpawnAssets.bros[5].getBackground().m.RawDescription
    {
        en = "{There is a quiet calm to %name%, with an intense gaze that seems to see more details than anyone else. A person of few words, it is clear the ranger holds a deep affinity with the land and sees orcs as a symbol of all that is wrong with the world.}"
        es = "{%name% transmite una calma silenciosa, con una mirada intensa que parece captar más detalles que la de nadie. Es una persona de pocas palabras, pero está claro que siente una profunda afinidad con la tierra y ve en los orcos el símbolo de todo lo que está mal en el mundo.}"
    }
    // FILE: scripts\scenarios\world\legends_rangers_scenario.nut
    // context: legends_rangers_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_115.png[/img][/p][p]Originally hailing from far afield, the rangers are sworn to protect their ancestral woodlands. Increasing intrusions have led the rangers to these lands. \n\n[color=#bcad8c]Outdoorsmen:[/color] Not everyone is cut out for the Rangers, some love nature and are eager to join, others will need more coin to convince. Outdoor recruits gain Pathfinder.\n[color=#bcad8c]Expert Scouts:[/color] You move faster on the campaign map and can always get a scouting report for any enemies near you.\n[color=#bcad8c]Guardians:[/color] If your ranger and druid die, its game over.[/p]"
        es = "[p=c][img]gfx/ui/events/event_115.png[/img][/p][p]Originarios de tierras lejanas, los guardabosques han jurado proteger los bosques de sus ancestros. Las crecientes intrusiones los han traído a estas tierras. \n\n[color=#dda21f]Gente de campo:[/color] No todo el mundo vale para los Guardabosques: a algunos les encanta la naturaleza y están deseando unirse, y a otros hará falta convencerlos con más monedas. Los reclutas acostumbrados a la vida al aire libre obtienen Rastreador.\n[color=#dda21f]Batidores expertos:[/color] Te mueves más rápido en el mapa de campaña y siempre puedes obtener un informe de exploración de cualquier enemigo cercano.\n[color=#dda21f]Guardianes:[/color] Si tu guardabosques y tu druida mueren, se acaba la partida.[/p]"
    }
    // context: legends_rangers_scenario.onSpawnAssets.bros[0].getBackground().m.RawDescription
    {
        en = "{%name% grew up in the rangers and was taught the ways of the forest by veteran foresters. Running through the woods for a lifetime has made %name% particularly good at tracking enemies, or tumbling into the homes of wild druids trying to escape from the modern world}"
        es = "{%name% se crio entre los guardabosques y aprendió los secretos del bosque de manos de veteranos guardas forestales. Toda una vida corriendo por los bosques ha hecho que a %name% se le dé especialmente bien rastrear enemigos, o caerse de bruces en el hogar de druidas salvajes que intentan huir del mundo moderno}"
    }
    // context: legends_rangers_scenario.onSpawnAssets.bros[0].improveMood()
    {
        en = "Narrowly escaped a bear"
        es = "Escapó por los pelos de un oso"
    }
    // context: legends_rangers_scenario.onSpawnAssets.bros[1].getBackground().m.RawDescription
    {
        en = "{%name% was the bastard of a noblewoman who left them in a ditch at the edge of the forest to be taken by wolves. It worked, but instead left %name% being cared for by a wolfmother with no cubs of her own. When the she-wolf was slain by vengeful poachers %name% took it upon themselves to be as far away from society as possible. Right up until a certain ranger fell headfirst into their hovel}"
        es = "{%name% nació de los amoríos ilegítimos de una noble, que abandonó a la criatura en una zanja al borde del bosque para que se la llevaran los lobos. Funcionó, aunque no como esperaba: %name% acabó al cuidado de una loba sin cachorros propios. Cuando unos cazadores furtivos vengativos mataron a la loba, %name% se propuso vivir lo más lejos posible de la sociedad. Hasta el día en que alguien de los guardabosques cayó de cabeza en su choza}"
    }
    // context: legends_rangers_scenario.onSpawnAssets.bros[1].worsenMood()
    {
        en = "Had my home destroyed by an idiot"
        es = "Alguien con muy pocas luces me destrozó la casa"
    }
    // context: legends_rangers_scenario.onCombatFinished.bro.getBackground().m.RawDescription
    {
        en = "{We didn't start on the best of terms but I feel as if I have lost a part of myself. The forest is quiet and the nights are darker without my companion...}"
        es = "{No empezamos con buen pie, pero siento que he perdido una parte de mí. El bosque está en silencio y las noches son más oscuras sin quien me acompañaba...}"
    }
    // context: legends_rangers_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "Supports the ranger cause"
        es = "Apoya la causa de los guardabosques"
    }
    // context: legends_rangers_scenario.onHiredByScenario._bro.worsenMood()
    {
        en = "Does not like sleeping in the woods"
        es = "No le gusta dormir en el bosque"
    }
    // FILE: scripts\scenarios\world\legends_scaling_beggar_scenario.nut
    // context: legends_scaling_beggar_scenario.create.m.Name
    {
        en = "Scaling Beggar Challenge"
        es = "Desafío del mendigo progresivo"
    }
    // context: legends_scaling_beggar_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_70.png[/img][/p][p]A lowly unskilled beggar, you witnessed something in an alley and now a noble house wants you dead. This is a challenge run with a very weak starting character. Can you awaken the true power of your avatar? \n\n[color=#bcad8c]Knows Too Much:[/color] All noble houses hate you.\n[color=#bcad8c]Learning in battles[/color]:  The beggar can gain stats and perks by defeating enemies.\n[color=#bcad8c]Begin alone Avatar[/color]: If the beggar dies, the campaign ends.\n[color=#bcad8c]Dirty Peasant[/color]: You can only hire lowerborn backgrounds.[/p]"
        es = "[p=c][img]gfx/ui/events/event_70.png[/img][/p][p]Malvives mendigando sin oficio alguno; presenciaste algo en un callejón y ahora una casa noble quiere acabar contigo. Es una partida de desafío con un personaje inicial muy débil. ¿Lograrás despertar el verdadero poder de tu avatar? \n\n[color=#dda21f]Sabe demasiado:[/color] Todas las casas nobles te odian.\n[color=#dda21f]Aprender en batalla[/color]:  Tu personaje puede ganar atributos y ventajas derrotando enemigos.\n[color=#dda21f]Avatar en solitario[/color]: Si tu personaje muere, la campaña termina.\n[color=#dda21f]Mugre campesina[/color]: Solo puedes contratar trasfondos de baja cuna.[/p]"
    }
    // FILE: scripts\scenarios\world\legends_seer_scenario.nut
    // context: legends_seer_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_120.png[/img][/p][p]After studying alchemy and mystic secrets for years, you have set out to confront the evils of the world \n\n[color=#bcad8c]Bookworm:[/color] Educated people want to work for you, the uneducated find you boring to be around.\n[color=#bcad8c]Teacher[/color] Anyone you fight with gains the Student perk.\n[color=#bcad8c]Avatar:[/color] If your seer dies, the campaign ends.[/p]"
        es = "[p=c][img]gfx/ui/events/event_120.png[/img][/p][p]Tras estudiar alquimia y secretos místicos durante años, te has puesto en marcha para enfrentarte a los males del mundo \n\n[color=#dda21f]Ratón de biblioteca:[/color] La gente instruida quiere trabajar para ti; a la que no lo es le aburre tu compañía.\n[color=#dda21f]Mentor[/color] Todo el que luche contigo obtiene la ventaja Estudiante.\n[color=#dda21f]Avatar:[/color] Si tu vidente muere, la campaña termina.[/p]"
    }
    // context: legends_seer_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "Excited to study from you"
        es = "Le entusiasma aprender de ti"
    }
    // context: legends_seer_scenario.onHiredByScenario._bro.worsenMood()
    {
        en = "Wishes you would stop using big words"
        es = "Desearía que dejaras de usar palabras tan rebuscadas"
    }
    // FILE: scripts\scenarios\world\legends_sisterhood_scenario.nut
    // context: legends_sisterhood_scenario.create.m.Name
    {
        en = "Sisterhood"
        es = "Las Hermanas"
    }
    // context: legends_sisterhood_scenario.create.m.Description
    {
        // this.m.Description = "[p=c][img]gfx/ui/events/event_91.png[/img][/p][p]Born into a world dominated by kings and bishops, you have studied the old ways of the wise women. Now you lead a band of powerful women shaping their own destinies. \n\n[color=#bcad8c]Sisterhood:[/color] You can only hire women and each gains the [color=" + this.Const.UI.Color.Perk + "]Resillient[/color] perk.\n[color=#bcad8c]Threads of fate:[/color] Your chants and trances alter the minds of your allies and enemies.\n[color=#bcad8c]Rune stones:[/color] You can craft powerful items imbued with ancient runes.\n[color=#bcad8c]Avatar:[/color] If you die, it is game over.[/p]";
        mode = "pattern"
        en = "[p=c][img]gfx/ui/events/event_91.png[/img][/p][p]Born into a world dominated by kings and bishops, you have studied the old ways of the wise women. Now you lead a band of powerful women shaping their own destinies. \n\n[color=#bcad8c]Sisterhood:[/color] You can only hire women and each gains the [color=<color:str>]Resillient[/color] perk.\n[color=#bcad8c]Threads of fate:[/color] Your chants and trances alter the minds of your allies and enemies.\n[color=#bcad8c]Rune stones:[/color] You can craft powerful items imbued with ancient runes.\n[color=#bcad8c]Avatar:[/color] If you die, it is game over.[/p]"
        es = "[p=c][img]gfx/ui/events/event_91.png[/img][/p][p]Nacida en un mundo dominado por reyes y obispos, has estudiado las viejas costumbres de las mujeres sabias. Ahora lideras a un grupo de mujeres poderosas que forjan su propio destino. \n\n[color=#dda21f]Las Hermanas:[/color] Solo puedes contratar mujeres y cada una obtiene la ventaja [color=<color>]Resiliente[/color].\n[color=#dda21f]Hilos del destino:[/color] Tus cánticos y trances alteran la mente de tus aliados y enemigos.\n[color=#dda21f]Piedras rúnicas:[/color] Puedes fabricar objetos poderosos imbuidos de runas antiguas.\n[color=#dda21f]Avatar:[/color] Si mueres, se acaba la partida.[/p]"
    }
    // context: legends_sisterhood_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "Joined the righteous cause of the Sisterhood"
        es = "Se unió a la justa causa de Las Hermanas"
    }
    // FILE: scripts\scenarios\world\legends_solo_necro_scenario.nut
    // context: legends_solo_necro_scenario.create.m.Name
    {
        en = "Master Necromancer"
        es = "Maestro nigromante"
    }
    // context: legends_solo_necro_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_29.png[/img][/p][p] What is there to do when you have reached the top? Perhaps more dangers and intrigue await? \n\n[color=#bcad8c]Dark sway:[/color] Start with a master necromancer, two puppets and three mortals.\n[color=#bcad8c]Not a fighter:[/color] The master necromancer gains martial perks later into their development, but gains experience faster. If the master necromancer dies, the binds are broken and the journey ends. Puppets under your control gain bonuses to health, while mortals wither away from sickness. There is a chance mortals in your party will be risen again as undead if killed.\n[color=#bcad8c]Dark company:[/color] Cultists, Gravediggers, Graverobbers and Anatomists will flock to join you and gain the 'Siphon' skill. Most other backgrounds cost 20% more to recruit and maintain. Cannot hire pious backgrounds.\n[color=#bcad8c]A terrible reputation:[/color] Recruits cannot hate the undead, relationships are poor with all factions and degrade slowly each day. Undead are passive towards you, and will steadily gain in relationship over time if attacked.[/p]"
        es = "[p=c][img]gfx/ui/events/event_29.png[/img][/p][p] ¿Qué queda por hacer cuando has llegado a la cima? ¿Quizá te esperan más peligros e intrigas? \n\n[color=#dda21f]Dominio oscuro:[/color] Empiezas con tu nigromante, ya en plena maestría, dos marionetas y tres mortales.\n[color=#dda21f]Sin madera de luchador:[/color] Tu nigromante obtiene ventajas marciales más adelante en su desarrollo, pero gana experiencia más rápido. Si tu nigromante muere, los lazos se rompen y el viaje termina. Las marionetas bajo tu control obtienen bonificaciones de salud, mientras que los mortales se consumen por la enfermedad. Hay una probabilidad de que los mortales de tu grupo se levanten de nuevo como no muertos si mueren.\n[color=#dda21f]Compañía oscura:[/color] Los cultistas, sepultureros, ladrones de tumbas y anatomistas acudirán en masa a unirse a ti y obtendrán la habilidad 'Absorber'. La mayoría de los demás trasfondos cuestan un [color=#a22424]20%[/color] más de reclutar y mantener. No puedes contratar trasfondos piadosos.\n[color=#dda21f]Una reputación terrible:[/color] Los reclutas no pueden odiar a los no muertos, las relaciones con todas las facciones son malas y empeoran poco a poco cada día. Los no muertos se muestran pasivos contigo y su relación mejorará de forma constante con el tiempo si son atacados.[/p]"
    }
    // context: legends_solo_necro_scenario.onSpawnAssets.bros[1].getBackground().m.RawDescription
    {
        en = "You found %name% down on their luck behind an Inn in the middle of nowhere... they had long since fallen alseep from the dagger between their ribs. But you took pity and offered them a place in your latest scheme. They would be a fool to refuse, after all."
        es = "Encontraste a %name% en plena mala racha detrás de una posada en medio de la nada... hacía mucho que había caído en un sueño profundo por culpa de la daga que tenía entre las costillas. Pero te dio lástima y le ofreciste un lugar en tu último plan. Al fin y al cabo, habría que estar loco para negarse."
    }
    // context: legends_solo_necro_scenario.onSpawnAssets.bros[2].getBackground().m.RawDescription
    {
        en = "%name% is a character of stunning vocal range - when you heard them sing in that graveyard you couldn't resist to allure them with the promise of fame and glory on the stage!"
        es = "%name% tiene un registro vocal asombroso: cuando oíste su canto en aquel cementerio, ¡no pudiste resistirte a tentarle con la promesa de fama y gloria sobre el escenario!"
    }
    // context: legends_solo_necro_scenario.onSpawnAssets.bros[3].getBackground().m.RawDescription
    {
        en = "A loyal servant and helper, you tasked %name% with keeping and distributing the 'wages' for the actors. Until recently this was an easy task."
        es = "Encargaste a %name%, siempre leal y servicial, guardar y repartir la 'paga' de los actores. Hasta hace poco, era una tarea fácil."
    }
    // context: legends_solo_necro_scenario.onSpawnPlayer.n.addPlayerRelation()
    {
        en = "Wary of necromancers"
        es = "Recela de los nigromantes"
    }
    // context: legends_solo_necro_scenario.onSpawnPlayer.n.addPlayerRelation()
    {
        en = "To whom it may concern, my nuts hang"
        es = "A quien pueda interesar: me cuelgan los huevos"
    }
    // context: legends_solo_necro_scenario.onHiredByScenario._bro.improveMood()
    {
        en = "I feel strange...but better!"
        es = "¡Siento algo extraño... pero estoy mejor!"
    }
    // context: legends_solo_necro_scenario.onHiredByScenario._bro.worsenMood()
    {
        en = "Feels very sick all of a sudden..."
        es = "De repente se encuentra muy mal..."
    }
    // context: legends_solo_necro_scenario.onGetBackgroundTooltip._tooltip.push().text
    {
        en = "[color=%positive%]+12[/color] Hitpoints due to being under the control of a powerful necromancer"
        es = "[color=#135213]+12[/color] Puntos de vida por estar bajo el control de un poderoso nigromante"
    }
    // FILE: scripts\scenarios\world\legends_troupe_scenario.nut
    // context: legends_troupe_scenario.create.m.Description
    {
        en = "[p=c][img]gfx/ui/events/event_26.png[/img][/p]The life of an artist is not an easy one, misunderstood and under appreciated. Perhaps performers will have more luck together, find an audience, travel the world, or at least stop having things thrown at you. \n\n[color=#bcad8c]Acrobatics:[/color] Anyone you hire gains the Leap ability \n[color=#bcad8c]Exposure:[/color] You will encounter more performers, and they will be cheaper to hire.\n[color=#bcad8c]Busking:[/color] You gain 10 crowns each day for each member of the troupe. Tavern rumors and drinks are cheaper."
        es = "[p=c][img]gfx/ui/events/event_26.png[/img][/p]La vida de artista no es fácil: incomprendida e infravalorada. Quizá los intérpretes tengan más suerte juntos: encontrar público, recorrer el mundo o, al menos, dejar de recibir cosas lanzadas a la cabeza. \n\n[color=#dda21f]Acrobacias:[/color] Todo el que contrates obtiene la habilidad Salto \n[color=#dda21f]Notoriedad:[/color] Te encontrarás con más artistas, y serán más baratos de contratar.\n[color=#dda21f]Actuar en la calle:[/color] Ganas [color=#1e861e]10[/color] coronas al día por cada miembro de la compañía. Los rumores y las bebidas de la taberna son más baratos."
    }
    // context: legends_troupe_scenario.onSpawnAssets.bros[0].getBackground().m.RawDescription
    {
        en = "{%name% learned how to entertain on the streets, using slight of hand and magic tricks to dupe unwitting punters out of their coin. Illusion is easier with a distraction, so the choice to join others was easy.}"
        es = "{%name% aprendió a entretener en la calle, valiéndose de juegos de manos y trucos de magia para sacarles las monedas a los incautos. La ilusión es más fácil con una distracción, así que la decisión de unirse a otros fue sencilla.}"
    }
    // context: legends_troupe_scenario.onSpawnAssets.bros[1].getBackground().m.RawDescription
    {
        en = "{%name% worked providing entertainment at inns around the country, but the bar fights and road bandits make it no life for a solo artist. Joining with others was for safety as much as the show.}"
        es = "{%name% se ganaba la vida entreteniendo en posadas de todo el país, pero con las peleas de taberna y los bandidos de los caminos, no es vida para quien actúa en solitario. Unirse a otros fue tanto por seguridad como por el espectáculo.}"
    }
    // context: legends_troupe_scenario.onSpawnAssets.bros[2].getBackground().m.RawDescription
    {
        en = "{%name% has been in the court of a local noble for years, but the same audience every night grows tiresome. It was time to find a band, hit the road and find some new audiences for their art.}"
        es = "{%name% ha pasado años en la corte de un noble local, pero el mismo público cada noche acaba cansando. Era hora de buscar un grupo, echarse al camino y encontrar nuevos públicos para su arte.}"
    }
    // context: legends_troupe_scenario.onSpawnAssets.bros[2].improveMood()
    {
        en = "Got the band back together"
        es = "Volvió a reunir a la banda"
    }
    // context: legends_troupe_scenario.onSpawnAssets.bros[3].getBackground().m.RawDescription
    {
        en = "{%name% was juggling and throwing knives in markets, and agreed to join the troupe to improve the show with the skills of others}"
        es = "{%name% hacía malabares y lanzaba cuchillos en los mercados, y aceptó unirse a la compañía para mejorar el espectáculo con las destrezas de otros}"
    }
    // FILE: scripts\skills\actives\legend_albedo_skill.nut
    // context: legend_albedo_skill.create.m.Description
    {
        en = "Repair up to 25 armor."
        es = "Repara hasta [color=#135213]25[/color] de armadura."
    }
    // context: legend_albedo_skill.getTooltip.ret.push().text
    {
        // text = "Has a range of [color=%positive%]" + this.m.MaxRange + "[/color]."
        mode = "pattern"
        en = "Has a range of [color=%positive%]<range:int>[/color]."
        es = "Tiene un alcance de [color=%positive%]<range>[/color]."
    }
    // FILE: scripts\skills\actives\legend_alp_nightmare_manifestation_skill.nut
    // context: legend_alp_nightmare_manifestation_skill.onUse.type.::MSU.Array.rand()
    // en = "direwolf"  // tipo de pesadilla elegido al azar para generar la entidad; identificador interno, no se muestra
    // context: legend_alp_nightmare_manifestation_skill.onUse.type.::MSU.Array.rand()
    // en = "human"  // tipo de pesadilla elegido al azar para generar la entidad; identificador interno, no se muestra
    // context: legend_alp_nightmare_manifestation_skill.onUse.type.::MSU.Array.rand()
    // en = "serpent"  // tipo de pesadilla elegido al azar para generar la entidad; identificador interno, no se muestra
    // context: legend_alp_nightmare_manifestation_skill.onUse.type.::MSU.Array.rand()
    // en = "tentacle"  // tipo de pesadilla elegido al azar para generar la entidad; identificador interno, no se muestra
    // context: legend_alp_nightmare_manifestation_skill.onUse.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(_targetTile.getEntity()) + "\'s nightmare becomes real!");
        mode = "pattern"
        en = "<name:str>'s nightmare becomes real!"
        es = "¡La pesadilla de <name> se hace realidad!"
    }
    // FILE: scripts\skills\actives\legend_alp_realm_of_shadow_skill.nut
    // context: legend_alp_realm_of_shadow_skill.onUse.p.Type
    // en = "shadows"  // tipo del efecto de casilla, identificador interno, no se muestra
    // context: legend_alp_realm_of_shadow_skill.onUse.p.Tooltip
    {
        en = "A pitch black mist lingers here, eminating a bone chilling air from within"
        es = "Aquí flota una niebla negra como la boca del lobo que desprende un aire que hiela los huesos"
    }
    // FILE: scripts\skills\actives\legend_alp_serpent_hook_skill.nut
    // en = "<user:str_tag> drags in <entity:str_tag>"
    // en base_es
    // context: legend_alp_serpent_hook_skill.onUse.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(_user) + " has staggered " + this.Const.UI.getColorizedEntityName(target) + " for one turn");
        mode = "pattern"
        en = "<user:str> has staggered <target:str> for one turn"
        es = "<user> ha hecho tambalear a <target> durante un turno"
    }
    // FILE: scripts\skills\actives\legend_alp_summon_nightmare_skill.nut
    // context: legend_alp_summon_nightmare_skill.onUse.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(_targetTile.getEntity()) + " creates monsters from the shadow");
        mode = "pattern"
        en = "<name:str> creates monsters from the shadow"
        es = "<name> crea monstruos a partir de las sombras"
    }
    // FILE: scripts\skills\actives\legend_apothecary_mushrooms_skill.nut
    // context: legend_apothecary_mushrooms_skill.create.m.Description
    {
        en = "Give these strange mushrooms to an adjacent ally, or eat them yourself to enter a state of trance-like state with otherworldy dodging and no sense of pain. May result in sickness. The effect will slowly wear off over 4 turns. Can not be used while engaged in melee, and anyone receiving the item needs to have a free bag slot."
        es = "Da estos extraños champiñones a un aliado adyacente, o cómetelos para entrar en un estado de trance con una capacidad de esquiva sobrenatural y sin sentir dolor. Puede provocar enfermedad. El efecto se disipa poco a poco a lo largo de [color=#135213]4[/color] turnos. No se puede usar mientras se está trabado en combate cuerpo a cuerpo, y quien reciba el objeto necesita tener una ranura libre en la bolsa."
    }
    // context: legend_apothecary_mushrooms_skill.getTooltip.ret.text
    {
        en = "Grants [color=%negative%]-40%[/color] Damage in Melee"
        es = "Otorga [color=%negative%]-40%[/color] de daño cuerpo a cuerpo"
    }
    // context: legend_apothecary_mushrooms_skill.getTooltip.ret.text
    {
        en = "Grants [color=%positive%]+40%[/color] Melee Defense"
        es = "Otorga [color=%positive%]+40%[/color] de Defensa cuerpo a cuerpo"
    }
    // context: legend_apothecary_mushrooms_skill.getTooltip.ret.text
    {
        en = "Grants [color=%positive%]+40%[/color] Ranged Defense"
        es = "Otorga [color=%positive%]+40%[/color] de Defensa a distancia"
    }
    // en = "No morale check triggered upon losing hitpoints"
    // en base_es
    // context: legend_apothecary_mushrooms_skill.onUse.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(user) + " eats Magic Mushrooms");
        mode = "pattern"
        en = "<name:str> eats Magic Mushrooms"
        es = "<name> se come los Champiñones mágicos"
    }
    // context: legend_apothecary_mushrooms_skill.onUse.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(_user) + " gives Magic Mushrooms to " + this.Const.UI.getColorizedEntityName(user));
        mode = "pattern"
        en = "<user:str> gives Magic Mushrooms to <target:str>"
        es = "<user> da los Champiñones mágicos a <target>"
    }
    // FILE: scripts\skills\actives\legend_attack_target_skill.nut
    // context: legend_attack_target_skill.create.m.Description
    {
        en = "Orders your pet to prioritize attacking a specific target."
        es = "Ordena a tu mascota que dé prioridad a atacar a un objetivo concreto."
    }
    // context: legend_attack_target_skill.getTooltip.ret.text
    {
        en = "Set a target for your unleased animals"
        es = "Fija un objetivo para tus animales sueltos"
    }
    // context: legend_attack_target_skill.getTooltip.ret.text
    {
        en = "[color=%negative%]Pet(s) still on guarding will ignore this command[/color]"
        es = "[color=%negative%]Las mascotas que sigan en guardia ignorarán esta orden[/color]"
    }
    // context: legend_attack_target_skill.setTarget.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(pet) + " has a new prey,  " + this.Const.UI.getColorizedEntityName(_t));
        mode = "pattern"
        en = "<pet:str> has a new prey,  <target:str>"
        es = "<pet> tiene una nueva presa: <target>"
    }
    // FILE: scripts\skills\actives\legend_bandage_skill.nut
    // en = "Removes the Bleeding status effect"
    // en base_es
