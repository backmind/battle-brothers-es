        // text = "[color=%positive%]+" + this.Math.floor(bonus / 2) + "[/color] helmet condition added at start of combat"
        mode = "pattern"
        en = "[color=%positive%]+<bonus:int>[/color] helmet condition added at start of combat"
        es = "[color=%positive%]+<bonus>[/color] de estado del casco al inicio del combate"
    }
