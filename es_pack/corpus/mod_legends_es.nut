        en = "Only receive [color=%positive%]<pct:int>%[/color] of any damage to Armor from attacks"
        es = "Solo recibe el [color=%positive%]<pct>%[/color] del daño a la armadura causado por ataques"
    }
    // context: perk_legend_lithe.getTooltip.tooltip.push().text
