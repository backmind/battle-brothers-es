        es = "Un par de guanteletes blindados con pinchos en los nudillos que sin duda pegan fuerte, pero que también ayudan a desviar los golpes de los puntos débiles."
    }
    // context: legend_spiked_gauntlets_item.getTooltip.result.extend().text
