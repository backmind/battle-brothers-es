        en = "An exquisite closed metal helm with golden winged neck plate. Outstanding protection at the expense of breathing"
        es = "Un exquisito yelmo de metal cerrado con placa de cuello alada y dorada. Protección excepcional a costa de la respiración"
    }
    // FILE: scripts\items\helmets\named\legend_mountain_helmet_named.nut
    // context: legend_mountain_helmet_named.create.m.Name
