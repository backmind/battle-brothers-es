    // FILE: mod_legends\hooks\entity\world\attached_location\amber_collector_location.nut
    // en = "The collectors living in these huts search for valuable amber shards along the shore."
    // en base_es
    // FILE: mod_legends\hooks\entity\world\attached_location\beekeeper_location.nut
    // context: beekeeper_location.o.create.m.Description
    {
        en = "Surrounded by humming bees, these small huts are home to beekeepers. The honey they produce is a precious ingredient to sweeten pastries and other foods. Contributes mead and farmhands to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\brewery_location.nut
    // context: brewery_location.o.create.m.Description
    {
        en = "This brewery produces large quantities of beer for both local taverns and traders. Contributes beer, brawlers, monks and gamblers to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\dye_maker_location.nut
    // context: dye_maker_location.o.create.m.Description
    {
        en = "This dye maker creates precious dies from all kinds of ingredients. The recipes for these expensive goods are well-kept secrets. Contributes dyes, paints and colourful clothes to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\fishing_huts_location.nut
    // context: fishing_huts_location.o.create.m.Description
    {
        en = "A small group of huts surrounded by nets, spears, hooks and other fishing equipment. The smell from baskets of fish guts travels quite a distance. Contributes fish, fishermen and nets to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\fletchers_hut_location.nut
    // context: fletchers_hut_location.o.create.m.Description
    {
        en = "The arrow makers in these sheds produce all kinds of ranged ammunition which they then sell at the nearest settlement. Contributes bows, crossbows, arrows, bolts, bowyers and archers to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\fortified_outpost_location.nut
    // context: fortified_outpost_location.o.create.m.Description
    {
        en = "Large barracks housing a host of professional soldiers. Contributes military weapons, armor, soldiers and knights to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\gatherers_hut_location.nut
    // context: gatherers_hut_location.o.create.m.Description
    {
        en = "Even in sparse environments an experienced gatherer can find berries, roots and other edible things. Although not the most delicious, it can still keep a man fed. Contributes roots, berries, spices, sickles, puddings, herbalists and daytalers to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\gem_mine_location.nut
    // context: gem_mine_location.o.create.m.Description
    {
        en = "The shiny gems found in this mine are usually brought directly to the next settlement in well-guarded caravans for further refinement. Contributes gems, miners, pickaxes, sellswords, caravan hands and thieves to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\goat_herd_location.nut
    // context: goat_herd_location.o.create.m.Description
    {
        en = "The goats held here are mainly used for their milk which is then turned into cheese to make it more durable. Contributes cheese, staves, slings, shepherds, farmhands and butchers to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\gold_mine_location.nut
    // context: gold_mine_location.o.create.m.Description
    {
        en = "A deep mine built atop a gold ore vein. This rare metal has a tendency to bring out the worst in people. Contributes gold and silver ingots, miners, caravan hands, sellswords and thieves to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\guarded_checkpoint_location.nut
    // context: guarded_checkpoint_location.o.create.m.Description
    {
        en = "A road checkpoint manned by professional soldiers. Contributes military weapons, armor and soldiers to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\harbor_location.nut
    // context: harbor_location.o.create.m.Description
    {
        en = "A harbor that serves both foreign trading ships and local fishermen. Contributes fish, nets, fishermen and fishmongers to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\hunters_cabin_location.nut
    // context: hunters_cabin_location.o.create.m.Description
    {
        en = "Hunters take shelter in these small huts while on the hunt. Chopped up game, venison and hides hung up to dry in the sun surround the huts. Contributes meat, furs, bows, poachers and hunters to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\incense_dryer_location.nut
    // context: incense_dryer_location.o.create.m.Description
    {
        en = "Tree sap is gathered from the surrounding trees and dried in the sun to create valuable incense. Contributes incense, spices, medicine and daytalers to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\leather_tanner_location.nut
    // en = "This leather tanner's workshop produces durable leather pieces from hides. The supply of this leather will increase the availability of light armor in the nearest settlement."
    // en base_es
    // FILE: mod_legends\hooks\entity\world\attached_location\lumber_camp_location.nut
    // context: lumber_camp_location.o.create.m.Description
    {
        en = "This lumber camp is used as a base for lumberjacks on the search for the most precious and durable materials in the nearby woods. Contributes wood, wood products and lumberjacks to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\militia_trainingcamp_location.nut
    // context: militia_trainingcamp_location.o.create.m.Description
    {
        en = "A large compound of militia barracks. This camp will turn ordinary peasants into somewhat able soldiers that can defend their home and their loved ones. Contributes weapons, armor and militia to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\militia_trainingcamp_oriental_location.nut
    // context: militia_trainingcamp_oriental_location.o.create.m.Description
    {
        en = "A large compound of militia barracks. This camp will turn ordinary peasants into somewhat able soldiers that can defend their home and their loved ones. Contributes ammo, conscripts and dervish to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\mushroom_grove_location.nut
    // context: mushroom_grove_location.o.create.m.Description
    {
        en = "Hidden in the mud and reed, the expert gatherer can find groves and caves full of precious mushrooms like these. Contributes spices, mushrooms, cultists, herbalists, wildmen and their tools to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\orchard_location.nut
    // context: orchard_location.o.create.m.Description
    {
        en = "Dense rows of trees with ripe fruit frame a small warehouse where everything is stored until offered on local markets. Contributes fruit, blades and laborers to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\ore_smelters_location.nut
    // context: ore_smelters_location.o.create.m.Description
    {
        en = "The burning hot ore smelters produce high quality metal ingots used by able weapon smiths to create the most sophisticated of arms. Contributes blacksmiths, ingots and hammers to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\peat_pit_location.nut
    // context: peat_pit_location.o.create.m.Description
    {
        en = "These peat pits produce a valuable fuel source once the peat has been dug up and dried. Contributes peat bricks, daytalers, peddlers and farming tools to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\pig_farm_location.nut
    // en = "The smell of this pig farm is just as distinct as the squeeking sounds coming from the muddy pits. The pork chops produced here are usually sold in the nearby settlement."
    // en base_es
    // FILE: mod_legends\hooks\entity\world\attached_location\plantation_location.nut
    // context: plantation_location.o.create.m.Description
    {
        en = "All kinds of wonderous spices and herbs are cultivated in this plantation. A small and rare fruitful spot in the barren desert. Contributes spices, dates and slaves to the nearby town"
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\salt_mine_location.nut
    // context: salt_mine_location.o.create.m.Description
    {
        en = "A mine in which precious rock salt is extracted and shipped off to only the most trustworthy traders. Contributes salt, pickaxes and miners to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\silk_farm_location.nut
    // context: silk_farm_location.o.create.m.Description
    {
        en = "In these huts the precious silk is spun from cocoons of small insects by secret methods. Contributes silk, daytalers and qiyan to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\stone_watchtower_location.nut
    // context: stone_watchtower_location.o.create.m.Description
    {
        en = "A stone watchtower occupied by well trained soldiers on guard duty. Contributes soldiers, shield, weapons and armor to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\stone_watchtower_oriental_location.nut
    // context: stone_watchtower_oriental_location.o.create.m.Description
    {
        en = "A stone watchtower occupied by well trained soldiers on guard duty. Contributes soldiers, nomads, shield, weapons and armor to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\trapper_location.nut
    // context: trapper_location.o.create.m.Description
    {
        en = "Small huts provide shelter for the trappers living here and setting traps for animals with valuable furs. Contributes furs, meat and poachers to the town"
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\wheat_fields_location.nut
    // context: wheat_fields_location.o.create.m.Description
    {
        en = "Golden wheat can be seen glistening in the sun from afar. Many people from the nearby settlement work here. Contributes bread, grains, poridge, farmhands, daytalers, millers and bakers to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\winery_location.nut
    // context: winery_location.o.create.m.Description
    {
        en = "This winery is surrounded by a large vineyard. The wine produced here is a prized commodity in wealthier circles."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location\workshop_location.nut
    // context: workshop_location.o.create.m.Description
    {
        en = "The workshop is proficient in making all kinds of tools and other supplies needed to keep carts and machines working. Contributes armor parts, ironmongers and blacksmiths to the local town."
        es = ""
    }
    // FILE: mod_legends\hooks\entity\world\attached_location.nut
    // context: attached_location.o.getName.s
