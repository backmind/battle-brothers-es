    // context: big_game_hunt_contract.o.createStates.s.start.Contract.m.BulletpointsObjectives.push()
    {
        en = "Hunt around the %regiontype% region of %worldmapregion% %distance% to the %direction% and other regions"
        es = "Caza alrededor de la región de %regiontype% en %worldmapregion%, %distance% al %direction%, y otras regiones"
    }
    // en = "Return to %townname% at any time to get paid"
    // en base_es
    // en = "Hunt for Direwolves, Webknechts, Nachzehrers, Hyenas and Serpents around the %regiontype% region of %worldmapregion% (%killcount%/%maxcount%)"
