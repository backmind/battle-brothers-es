    {
        en = "Stag Pauldrons"
        es = "Espaldares de ciervo"
    }
    // context: legend_pauldron_stag_upgrade.create.m.Description
    {
        en = "Spiky segments of worked iron shaped like antlers, excellent for protecting shoulders and arms. Worn over armor, they can help deflect incoming blows."
        es = "Segmentos puntiagudos de hierro trabajado con forma de astas, excelentes para proteger hombros y brazos. Llevados sobre la armadura, ayudan a desviar los golpes."
    }
    // context: legend_pauldron_stag_upgrade.create.m.ArmorDescription
