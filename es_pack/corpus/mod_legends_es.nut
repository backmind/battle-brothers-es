    // context: perk_legend_last_stand.getTooltip.tooltip.push().text
    {
        en = "Immune to the effects of fresh injuries, and not upset by health losses."
        es = "Inmune a los efectos de las heridas recientes; perder salud no le afecta."
    }
    // FILE: scripts\skills\perks\perk_legend_lithe.nut
    // context: perk_legend_lithe.create.m.Description
    {
        en = "Lithe like a lizard! %name% is able to partially deflect attacks at the last moment, turning them into glancing hits."
        es = "¡Grácil como un lagarto! %name% es capaz de desviar parcialmente los ataques en el último momento y convertirlos en golpes de refilón."
    }
    // context: perk_legend_lithe.getTooltip.tooltip.push().text
