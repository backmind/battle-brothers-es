    // context: legend_aggressive_trait.getTooltip.text
    {
        en = "[color=%negative%]-5[/color] Defense from each surrounding enemy"
        es = "[color=%negative%]-5[/color] Defensa por cada enemigo adyacente"
    }
    // context: legend_aggressive_trait.getTooltip.text
    {
        en = "Will never start combat at wavering morale"
        es = "Nunca empezará un combate con la moral vacilante"
