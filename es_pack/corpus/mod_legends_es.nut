    // FILE: scripts\skills\traits\legend_ambitious_trait.nut
    // context: legend_ambitious_trait.create.m.Name
    {
        en = "Ambitious"
        es = "Ambicioso"
    }
    // context: legend_ambitious_trait.create.m.Description
    {
        en = "Determined to be a hero."
        es = "Tiene la firme determinación de convertirse en leyenda."
    }
    // context: legend_ambitious_trait.create.m.Titles
    {
        en = "the Talented"
        es = "el Talentoso"
    }
    // context: legend_ambitious_trait.create.m.Titles
    {
        en = "the Smart"
        es = "el Listo"
    }
    // context: legend_ambitious_trait.create.m.Titles
    {
        en = "the Future"
        es = "el Futuro"
    }
    // context: legend_ambitious_trait.create.m.Titles
