    // FILE: scripts\entity\world\camp\buildings\healer_building.nut
    // context: healer_building.create.m.Slot
    // en = "heal"  // identificador interno de la casilla del edificio en el campamento, no se muestra
    // context: healer_building.create.m.Description
    {
        en = "Place brothers in reserves in order to heal from wounds."
        es = "Coloca a hermanos en la reserva para que sanen sus heridas."
    }
    // context: healer_building.getDescription
    {
        // @composicion: desc += ... (5 trozos).
        // La suma llega entera a Rosetta; los trozos de abajo no llegan nunca solos.
        en = "Injuries are a prerequisite for any self respecting battle brother. The quicker temporary injuries are patched up, the quicker a battle brother can get some more! Assigning brothers to this tent allows them to treat any wounds in the company roster and also help restore health points of any injured brother by +10%. Treating an injury requires a cost of medicine and time (vs coin in a temple). The more people assigned to the tent, the quicker injuries will be treated and healthpoints restored. \n\nThe healing tent can be upgraded by purchasing a crafting cart from a settlement merchant. An upgraded tent provides a 66% increase in hitpoint recovery speed, 33% increase in wound treatment speed and a 25% decrease in medicine cost for each injury."
        es = "Las heridas son un requisito para cualquier hermano de armas que se precie. ¡Cuanto antes se curen las heridas temporales, antes podrá un hermano de armas ganarse otras nuevas! Asignar hermanos a esta tienda les permite tratar las heridas de cualquier miembro de la compañía y además ayuda a recuperar un +10% de los puntos de vida de cualquier hermano herido. Tratar una herida cuesta medicina y tiempo (en vez de coronas, como en un templo). Cuantas más personas asignadas a la tienda, antes se tratarán las heridas y se recuperarán los puntos de vida. \n\nLa tienda de curación puede mejorarse comprando un carro de fabricación a un mercader de algún asentamiento. Una tienda mejorada recupera los puntos de vida un 66% más rápido, trata las heridas un 33% más rápido y reduce un 25% el gasto de medicina de cada herida."
    }
    // context: healer_building.getDescription
    {
        en = "Injuries are a prerequisite for any self respecting battle brother. The quicker temporary injuries are patched up, the quicker a battle brother can get some more! "
        es = "Las heridas son un requisito para cualquier hermano de armas que se precie. ¡Cuanto antes se curen las heridas temporales, antes podrá un hermano de armas ganarse otras nuevas! "
    }
    // context: healer_building.getDescription
    {
        en = "Assigning brothers to this tent allows them to treat any wounds in the company roster and also help restore health points of any injured brother by +10%. "
        es = "Asignar hermanos a esta tienda les permite tratar las heridas de cualquier miembro de la compañía y además ayuda a recuperar un +10% de los puntos de vida de cualquier hermano herido. "
    }
    // context: healer_building.getDescription
    {
        en = "Treating an injury requires a cost of medicine and time (vs coin in a temple). The more people assigned to the tent, the quicker injuries will be treated and healthpoints restored. "
        es = "Tratar una herida cuesta medicina y tiempo (en vez de coronas, como en un templo). Cuantas más personas asignadas a la tienda, antes se tratarán las heridas y se recuperarán los puntos de vida. "
    }
    // context: healer_building.getDescription
    {
        en = "The healing tent can be upgraded by purchasing a crafting cart from a settlement merchant. An upgraded tent provides a 66% increase in hitpoint recovery speed, 33% increase in wound treatment speed and a 25% decrease in medicine cost for each injury."
        es = "La tienda de curación puede mejorarse comprando un carro de fabricación a un mercader de algún asentamiento. Una tienda mejorada recupera los puntos de vida un 66% más rápido, trata las heridas un 33% más rápido y reduce un 25% el gasto de medicina de cada herida."
    }
    // context: healer_building.getModifierToolip.ret.text
    {
        // text = "There are [color=%positive%]" + this.m.Queue.len() + "[/color] injuries queued to be treated."
        mode = "pattern"
        en = "There are [color=%positive%]<count:int>[/color] injuries queued to be treated."
        es = "Hay [color=%positive%]<count>[/color] heridas en cola para tratar."
    }
    // context: healer_building.getModifierToolip.ret.text
    {
        // text = "It will take [color=%positive%]" + this.getRequiredTime() + "[/color] hours to treat all queued injuries."
        mode = "pattern"
