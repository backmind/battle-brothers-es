    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.text
    {
        // text = "The total amount of provisions you carry. The average mercenary requires 2 provisions per day, more on difficult terrain or when in reserve. Your mercenaries will eat the provisions closest to expiring first. Running out of provisions will lower morale and will eventually lead to your people deserting you before dying of starvation.\n\nYou use [color=%positive%]" + dailyFood + "[/color] provisions per day. Your [color=%positive%]" + food + "[/color] provisions will last you for [color=%positive%]" + time + "[/color] more days at most. Keep in mind that individual provisions will eventually turn bad!"
        mode = "pattern"
        // corrige base: falta «primero» ("first"): los hombres se comen primero las raciones más cercanas a pudrirse; además, «de los hombres» tras «moral» no está en el inglés.
        en = "The total amount of provisions you carry. The average mercenary requires 2 provisions per day, more on difficult terrain or when in reserve. Your mercenaries will eat the provisions closest to expiring first. Running out of provisions will lower morale and will eventually lead to your people deserting you before dying of starvation.\n\nYou use [color=%positive%]<dailyFood:int>[/color] provisions per day. Your [color=%positive%]<food:int>[/color] provisions will last you for [color=%positive%]<time:int>[/color] more days at most. Keep in mind that individual provisions will eventually turn bad!"
        es = "La cantidad total de raciones que llevas. El mercenario promedio necesita 2 raciones al día, más en terreno difícil o cuando está en la reserva. Tus mercenarios se comerán primero las raciones más cercanas a pudrirse. Quedarse sin raciones bajará la moral y acabará haciendo que tu gente te abandone antes de morir de hambre.\n\nUsas [color=%positive%]<dailyFood>[/color] raciones al día. Tus [color=%positive%]<food>[/color] raciones te alcanzarán para [color=%positive%]<time>[/color] días más a lo sumo. ¡Ten en cuenta que las raciones individuales se pudrirán tarde o temprano!"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.text
    {
        // text = "The total amount of provisions you carry. The average mercenary requires 2 provisions per day and more on difficult terrain. Your mercenaries will eat the provisions closest to expiring first. Running out of provisions will lower morale and will eventually lead to your people deserting you before dying of starvation.\n\nYou use [color=%positive%]" + dailyFood + "[/color] provisions per day.\n\n[color=%negative%]You are almost out of provisions to feed your company! Buy new provisions as fast as possible or your mercenaries will desert you one by one before they starve![/color]"
        mode = "pattern"
        en = "The total amount of provisions you carry. The average mercenary requires 2 provisions per day and more on difficult terrain. Your mercenaries will eat the provisions closest to expiring first. Running out of provisions will lower morale and will eventually lead to your people deserting you before dying of starvation.\n\nYou use [color=%positive%]<dailyFood:int>[/color] provisions per day.\n\n[color=%negative%]You are almost out of provisions to feed your company! Buy new provisions as fast as possible or your mercenaries will desert you one by one before they starve![/color]"
        es = "La cantidad total de raciones que llevas. El mercenario promedio necesita 2 raciones al día, y más en terreno difícil. Tus mercenarios se comerán primero las raciones más cercanas a pudrirse. Quedarse sin raciones bajará la moral y acabará haciendo que tu gente te abandone antes de morir de hambre.\n\nUsas [color=%positive%]<dailyFood>[/color] raciones al día.\n\n[color=%negative%]¡Casi no te quedan raciones para alimentar a tu compañía! ¡Compra raciones nuevas lo antes posible o tus mercenarios te abandonarán uno a uno antes de morir de hambre![/color]"
