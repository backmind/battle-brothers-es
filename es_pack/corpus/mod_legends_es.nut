    // context: ::Const.Strings.PerkDescription.LegendAnchor
    {
        // ::Const.Strings.PerkDescription.LegendAnchor <- "\nHold your ground!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain a stacking Melee Skill, Ranged Skill and Melee Defense as long as you have not moved during your turn. You will start combat with 1 stack.\n\n• The first stack grants [color=%positive%]5[/color] bonus, and each subsequent stack grants 1 less up to a maximum of [color=%positive%]15[/color] granted at 5 stacks.\n\n• If you were to receive [color=%status%]Stagger[/color] instead remove a stack.\n";
        mode = "pattern"
        en = "\nHold your ground!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain a stacking Melee Skill, Ranged Skill and Melee Defense as long as you have not moved during your turn. You will start combat with 1 stack.\n\n• The first stack grants [color=%positive%]5[/color] bonus, and each subsequent stack grants 1 less up to a maximum of [color=%positive%]15[/color] granted at 5 stacks.\n\n• If you were to receive [color=%status%]Stagger[/color] instead remove a stack.\n"
        es = "\n¡Mantente firme!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes una bonificación acumulable a la Habilidad cuerpo a cuerpo, la Habilidad a distancia y la Defensa cuerpo a cuerpo mientras no te hayas movido durante tu turno. Empiezas el combate con 1 acumulación.\n\n• La primera acumulación otorga [color=%positive%]5[/color] de bonificación y cada una de las siguientes otorga 1 menos, hasta un máximo de [color=%positive%]15[/color] con 5 acumulaciones.\n\n• Si fueras a quedar [color=%status%]Tambaleante[/color], en su lugar pierdes una acumulación.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendFirstBlood
    {
        // ::Const.Strings.PerkDescription.LegendFirstBlood <- "\nEarly bird gets the worm!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]20%[/color] Damage and Lowers the threshold to inflict [color=%status%]Injuries[/color] by [color=%negative%]50%[/color] for both melee and ranged attacks on enemies with full hitpoints.\n";
        mode = "pattern"
        en = "\nEarly bird gets the worm!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]20%[/color] Damage and Lowers the threshold to inflict [color=%status%]Injuries[/color] by [color=%negative%]50%[/color] for both melee and ranged attacks on enemies with full hitpoints.\n"
        es = "\n¡A quien madruga, Dios lo ayuda!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes un [color=%positive%]20%[/color] más de daño y reduces en un [color=%negative%]50%[/color] el umbral para infligir [color=%status%]Heridas[/color], tanto con ataques cuerpo a cuerpo como a distancia, contra enemigos con los Puntos de vida al máximo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBallistics
    {
        // ::Const.Strings.PerkDescription.LegendBallistics <- "\nThrough familiarity and training with your weapon, you know just how your projectiles will fly.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Crossbows gain a scaling bonus to armor penetration depending on the distance to the target with the highest bonus in melee and the lowest at maximum range for the relevant skill. [color=%skill%]Shoot Bolt[/color] gains up to 20%, while [color=%skill%]Shoot Heavy Bolt[/color] and [color=%skill%]Shoot Stake[/color] gain up to [color=%positive%]+30%[/color] instead.\n\n• The range penalty to hitchance is reduced by [color=%negative%]-2[/color] per tile for all ranged weapons.\n\n• Additionally, Handgonnes gain [color=%positive%]+1[/color] range.\n";
        mode = "pattern"
        en = "\nThrough familiarity and training with your weapon, you know just how your projectiles will fly.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Crossbows gain a scaling bonus to armor penetration depending on the distance to the target with the highest bonus in melee and the lowest at maximum range for the relevant skill. [color=%skill%]Shoot Bolt[/color] gains up to 20%, while [color=%skill%]Shoot Heavy Bolt[/color] and [color=%skill%]Shoot Stake[/color] gain up to [color=%positive%]+30%[/color] instead.\n\n• The range penalty to hitchance is reduced by [color=%negative%]-2[/color] per tile for all ranged weapons.\n\n• Additionally, Handgonnes gain [color=%positive%]+1[/color] range.\n"
        es = "\nGracias a la familiaridad y el entrenamiento con tu arma, sabes exactamente cómo volarán tus proyectiles.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Las ballestas obtienen una bonificación escalonada a la penetración de armadura según la distancia al objetivo: la mayor, cuerpo a cuerpo, y la menor, al alcance máximo de la habilidad correspondiente. [color=%skill%]Disparar virote[/color] obtiene hasta un 20%, mientras que [color=%skill%]Disparar virote pesado[/color] y [color=%skill%]Disparar estaca[/color] obtienen hasta un [color=%positive%]+30%[/color].\n\n• La penalización por distancia a la probabilidad de impacto se reduce en [color=%negative%]-2[/color] por casilla para todas las armas a distancia.\n\n• Además, los cañones de mano obtienen [color=%positive%]+1[/color] de alcance.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBackswing
    {
        // ::Const.Strings.PerkDescription.LegendBackswing <- "\nUse your built up inertia to wreak havoc on the second swing.\n\n[color=%passive%][u]Passive:[/u][/color]\n• After performing [color=%skill%]Round Swing[/color], [color=%skill%]Swing[/color], [color=%skill%]Thresh[/color], [color=%skill%]Reap[/color], [color=%skill%]Castigate[/color], [color=%skill%]Shatter[/color], [color=%skill%]Harvest[/color] and [color=%skill%]Double Swing[/color] you can perform a followup for [color=%negative%]-50%[/color] Fatigue and Action Points. [color=%skill%]Swing[/color] Damage is reduced by [color=%negative%]-25%[/color] and for the rest of the skills by [color=%negative%]-50%[/color].\n\n• Moving, ending your turn or waiting will all remove this effect.\n";
        mode = "pattern"
        en = "\nUse your built up inertia to wreak havoc on the second swing.\n\n[color=%passive%][u]Passive:[/u][/color]\n• After performing [color=%skill%]Round Swing[/color], [color=%skill%]Swing[/color], [color=%skill%]Thresh[/color], [color=%skill%]Reap[/color], [color=%skill%]Castigate[/color], [color=%skill%]Shatter[/color], [color=%skill%]Harvest[/color] and [color=%skill%]Double Swing[/color] you can perform a followup for [color=%negative%]-50%[/color] Fatigue and Action Points. [color=%skill%]Swing[/color] Damage is reduced by [color=%negative%]-25%[/color] and for the rest of the skills by [color=%negative%]-50%[/color].\n\n• Moving, ending your turn or waiting will all remove this effect.\n"
        es = "\nAprovecha la inercia acumulada para causar estragos con el segundo golpe.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Tras realizar [color=%skill%]Golpe circular[/color], [color=%skill%]Corte amplio[/color], [color=%skill%]Trillar[/color], [color=%skill%]Segar[/color], [color=%skill%]Castigar[/color], [color=%skill%]Destrozar[/color], [color=%skill%]Cosechar[/color] y [color=%skill%]Doble corte amplio[/color], puedes realizar un golpe de seguimiento con un [color=%negative%]-50%[/color] de Fatiga y Puntos de acción. El daño de [color=%skill%]Corte amplio[/color] se reduce en un [color=%negative%]-25%[/color] y el del resto de habilidades en un [color=%negative%]-50%[/color].\n\n• Moverte, terminar tu turno o esperar elimina este efecto.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendDebilitate
    {
        // ::Const.Strings.PerkDescription.LegendDebilitate <- "\nAnkles, hands, elbows and knees, you've learned how to fight dirty to secure victory.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Debilitate[/color] skill which can prime your next attack to [color=%status%]Cripple[/color] a target for three turns, reducing their ability to inflict damage by [color=%negative%]-25%[/color] and increasing the damage they take by [color=%positive%]+15%[/color].\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]10[/color] Fatigue. Works on all enemy targets hit.\n";
        mode = "pattern"
        en = "\nAnkles, hands, elbows and knees, you've learned how to fight dirty to secure victory.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Debilitate[/color] skill which can prime your next attack to [color=%status%]Cripple[/color] a target for three turns, reducing their ability to inflict damage by [color=%negative%]-25%[/color] and increasing the damage they take by [color=%positive%]+15%[/color].\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]10[/color] Fatigue. Works on all enemy targets hit.\n"
        es = "\nTobillos, manos, codos y rodillas: has aprendido a pelear sucio para asegurarte la victoria.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Debilitar[/color], que prepara tu siguiente ataque para [color=%status%]Lisiar[/color] a un objetivo durante tres turnos, lo que reduce su capacidad de infligir daño en un [color=%negative%]-25%[/color] y aumenta el daño que recibe en un [color=%positive%]+15%[/color].\n\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]10[/color] de Fatiga. Afecta a todos los objetivos enemigos alcanzados.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendReturnFavor
    {
        // ::Const.Strings.PerkDescription.LegendReturnFavor <- "\nStrike back with interest!\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Return Favor[/color] skill which when activated has a [color=%positive%]75%[/color] chance to [color=%status%]Stun[/color] any opponent missing a melee attack against this character in retaliation.\n\n• Immunities and resistances against being [color=%status%]Stunned[/color] still apply.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]30[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nStrike back with interest!\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Return Favor[/color] skill which when activated has a [color=%positive%]75%[/color] chance to [color=%status%]Stun[/color] any opponent missing a melee attack against this character in retaliation.\n\n• Immunities and resistances against being [color=%status%]Stunned[/color] still apply.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]30[/color] Fatigue.\n"
        es = "\n¡Devuelve el golpe con intereses!\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Devolver el favor[/color], que al activarse otorga un [color=%positive%]75%[/color] de probabilidad de [color=%status%]aturdir[/color] como represalia a cualquier oponente que falle un ataque cuerpo a cuerpo contra este personaje.\n\n• Las inmunidades y resistencias al estado [color=%status%]Aturdido[/color] siguen aplicándose.\n\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]30[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPerfectFocus
    {
        // ::Const.Strings.PerkDescription.LegendPerfectFocus <- "\nTake a deep breath, then get to work.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Perfect Focus[/color] skill which grants stacking [color=%effect%]Perfect Focus[/color]. Each stack increases your Action Points by [color=%positive%]3[/color] on use.\n\n• Undead characters can not use this ability, but instead gain [color=%positive%]+3[/color] Action Points.\n\n• Costs [color=%negative%]0[/color] AP and [color=%negative%]30[/color] Fatigue, but Fatigue cost will increase by [color=%positive%]50%[/color] for each subsequent use this combat. The Fatigue cost will be reduced by [color=%negative%]50%[/color] at the start of each turn down to [color=%negative%]30[/color].\n";
        mode = "pattern"
        en = "\nTake a deep breath, then get to work.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Perfect Focus[/color] skill which grants stacking [color=%effect%]Perfect Focus[/color]. Each stack increases your Action Points by [color=%positive%]3[/color] on use.\n\n• Undead characters can not use this ability, but instead gain [color=%positive%]+3[/color] Action Points.\n\n• Costs [color=%negative%]0[/color] AP and [color=%negative%]30[/color] Fatigue, but Fatigue cost will increase by [color=%positive%]50%[/color] for each subsequent use this combat. The Fatigue cost will be reduced by [color=%negative%]50%[/color] at the start of each turn down to [color=%negative%]30[/color].\n"
        es = "\nRespira hondo y ponte manos a la obra.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Enfoque perfecto[/color], que otorga acumulaciones de [color=%effect%]Enfoque perfecto[/color]. Cada acumulación aumenta tus Puntos de acción en [color=%positive%]3[/color] al usarla.\n\n• Los personajes no muertos no pueden usar esta habilidad, pero en su lugar obtienen [color=%positive%]+3[/color] Puntos de acción.\n\n• Cuesta [color=%negative%]0[/color] PA y [color=%negative%]30[/color] de Fatiga, pero el coste de Fatiga aumenta un [color=%positive%]50%[/color] con cada uso posterior en este combate. El coste de Fatiga se reduce un [color=%negative%]50%[/color] al inicio de cada turno, hasta un mínimo de [color=%negative%]30[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBloodyHarvest
    {
        en = "\nThere's wolves, bears, nachzehrers, and you. All beings of vicious slaughter.\n\n[color=%passive%][u]Passive:[/u][/color]\n• [color=%positive%]50%[/color] of the skill's fatigue cost is translated to Damage and Chance to hit. This accounts for any fatigue reduction or increase.\n"
        es = "\nEstán los lobos, los osos, los nachzehrers y tú. Todos seres de matanza despiadada.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• El [color=%positive%]50%[/color] del coste de Fatiga de la habilidad se convierte en daño y probabilidad de impactar. Tiene en cuenta cualquier reducción o aumento de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendImmovableObject
    {
        en = "\nHeavy armor, a trusty shield and your heels dug into the ground and you can weather any storm.\n\n[color=%passive%][u]Passive:[/u][/color]\n• For every 10 points of gear weight from all slots gain [color=%positive%]1[/color] Resolve and [color=%negative%]1%[/color] less damage ignoring armor.\n\n• If you have at least 50 gear weight any attack that would stun you will instead daze you.\n\n• If you have at least 80 gear weight and [color=%perk%]Steel Brow[/color] become immune to knockback and grab.\n"
        es = "\nCon armadura pesada, un escudo de confianza y los talones clavados en el suelo, puedes capear cualquier tormenta.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Por cada 10 puntos de peso del equipo en todas las ranuras, obtienes [color=%positive%]1[/color] de Resolución y un [color=%positive%]1%[/color] menos de daño que ignora la armadura.\n\n• Si tienes al menos 50 de peso de equipo, cualquier ataque que fuera a aturdirte te atontará en su lugar.\n\n• Si tienes al menos 80 de peso de equipo y [color=%perk%]Cabeza dura[/color], te vuelves inmune a los empujones y los agarres.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendDoubleStrike
    {
        // ::Const.Strings.PerkDescription.LegendDoubleStrike <- "\nMaster chaining your attacks for a devastating effect.\n\n[color=%passive%][u]Passive:[/u][/color]\n• After landing a hit, gain a [color=%positive%]25%[/color] bonus to damage and recover [color=%positive%]1-2[/color] fatigue with each further hit.\n\n• Missing or ending your turn will remove the effect.\n\n• When [color=%status%]Dual Wielding[/color] daggers, the bonus to damage is increased to [color=%positive%]35%[/color].\n";
        mode = "pattern"
        en = "\nMaster chaining your attacks for a devastating effect.\n\n[color=%passive%][u]Passive:[/u][/color]\n• After landing a hit, gain a [color=%positive%]25%[/color] bonus to damage and recover [color=%positive%]1-2[/color] fatigue with each further hit.\n\n• Missing or ending your turn will remove the effect.\n\n• When [color=%status%]Dual Wielding[/color] daggers, the bonus to damage is increased to [color=%positive%]35%[/color].\n"
        es = "\nDomina el encadenamiento de ataques para lograr un efecto devastador.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Tras acertar un golpe, obtienes una bonificación del [color=%positive%]25%[/color] al daño y recuperas [color=%positive%]1-2[/color] de Fatiga con cada golpe posterior.\n\n• Fallar o terminar tu turno elimina el efecto.\n\n• Cuando luchas [color=%status%]Con dos armas[/color] con dagas, la bonificación al daño aumenta al [color=%positive%]35%[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendVengeance
    {
        en = "\n'You've done it now!'\n\n[color=%passive%][u]Passive:[/u][/color]\n• After receiving a hit, or a death of a party member or a pet, gain a stack of [color=%effect]Vengeance[/color], which allows you to deal [color=%positive%]20%[/color] extra Damage.\n\n• The damage does not stack and each attack consumes one charge.\n"
        es = "\n'¡Ahora sí que la hiciste!'\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Al recibir un golpe, o al morir un miembro del grupo o una mascota, obtienes una acumulación de [color=%effect]Venganza[/color], que te permite infligir un [color=%positive%]20%[/color] más de daño.\n\n• El daño no se acumula y cada ataque consume una carga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBruiser
    {
        en = "\nYour muscles are an unstoppable force, shattering armor with every strike!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Effectiveness vs. Armor is increased by [color=%positive%]+10%[/color] for any weapon used.\n"
        es = "\n¡Tus músculos son una fuerza imparable que destroza la armadura con cada golpe!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• La eficacia contra la armadura aumenta en un [color=%positive%]+10%[/color] con cualquier arma.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendCrusher
    {
        en = "\nPut full force in your every blow!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Shield damage is increased by [color=%positive%]+50%[/color] when using the Split Shield skill.\n"
        es = "\n¡Pon toda tu fuerza en cada golpe!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• El daño a los escudos aumenta en un [color=%positive%]+50%[/color] al usar la habilidad Romper escudo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPointBlank
    {
        en = "\nDon't fire until you see the whites of their eyes!\n\n[color=%passive%][u]Passive:[/u][/color]\n• When using a ranged weapon against a target 4 or less tiles away, inflict additional damage, scaling based on [color=%positive%]30%[/color] of Ranged Defense.\n\n• When using Throwing Weapons additionally inflict additional damage [color=%positive%]30%[/color] of Melee Skill and [color=%positive%]50%[/color] of Ranged Defense combined.\n\n• Allows you to use Throwing Weapons in melee.\n"
        es = "\n¡No disparen hasta que les vean el blanco de los ojos!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Al usar un arma a distancia contra un objetivo a 4 casillas o menos, infliges daño adicional en función del [color=%positive%]30%[/color] de tu Defensa a distancia.\n\n• Con armas arrojadizas, infliges además un daño adicional igual al [color=%positive%]30%[/color] de tu Habilidad cuerpo a cuerpo y al [color=%positive%]50%[/color] de tu Defensa a distancia combinados.\n\n• Te permite usar armas arrojadizas cuerpo a cuerpo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSlaughterer
    {
        en = "\n'I powdered my pigeon for the ribcage slaughter!!!'\n\n[color=%passive%][u]Passive:[/u][/color]\n• Melee kills are always fatalities (if the weapon allows).\n\n• Fatalities have a [color=%negative%]-5[/color] penalty to enemy Resolve checks.\n\n• Having the 'Bloodthirsty' trait allows you to trigger an additional positive morale check when killing an enemy.\n"
        es = "\n'¡¡¡Empolvé a mi pichón para la matanza de costillares!!!'\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Las muertes cuerpo a cuerpo son siempre muertes brutales (si el arma lo permite).\n\n• Las muertes brutales imponen una penalización de [color=%positive%]-5[/color] a las tiradas de Resolución del enemigo.\n\n• Tener el rasgo 'Sediento de sangre' te permite provocar una tirada de moral positiva adicional al matar a un enemigo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBetweenTheEyes
    {
        en = "\nBlows to the head hurt!\n\n[color=%passive%][u]Passive:[/u][/color]The chance to hit the head for critical damage is increased by [color=%positive%]+10%[/color] for all attacks.\n\n[color=%passive%][u]Passive:[/u][/color]\n"
        es = "\n¡Los golpes en la cabeza duelen!\n\n[color=%passive%][u]Pasivo:[/u][/color]La probabilidad de golpear en la cabeza para causar daño crítico aumenta en un [color=%positive%]+10%[/color] en todos los ataques.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendDeflect
    {
        en = "\nLearn to better deflect hits to the side instead of blocking them head on.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Shield damage received is reduced by [color=%negative%]-50%[/color] to a minimum of [color=%damage%]1[/color].\n"
        es = "\nAprende a desviar mejor los golpes hacia un lado en lugar de bloquearlos de frente.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• El daño que recibe el escudo se reduce en un [color=%positive%]-50%[/color], hasta un mínimo de [color=%damage%]1[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendLastStand
    {
        // ::Const.Strings.PerkDescription.LegendLastStand <- "\nWhen pushed to the brink, unleash unmatched resilience and determination.\n\n[color=%passive%][u]Passive:[/u][/color]\n• For every [color=%negative%]2%[/color] of missing Hitpoints below [color=%negative%]66%[/color] total Hitpoints, gain [color=%positive%]1[/color] additional Melee and Ranged Defense.\n\n• When below [color=%negative%]33%[/color] total Hitpoints, this character becomes immune to the effects of fresh [color=%status%]Injuries[/color] and does not lose morale when losing Hitpoints.\n";
        mode = "pattern"
        en = "\nWhen pushed to the brink, unleash unmatched resilience and determination.\n\n[color=%passive%][u]Passive:[/u][/color]\n• For every [color=%negative%]2%[/color] of missing Hitpoints below [color=%negative%]66%[/color] total Hitpoints, gain [color=%positive%]1[/color] additional Melee and Ranged Defense.\n\n• When below [color=%negative%]33%[/color] total Hitpoints, this character becomes immune to the effects of fresh [color=%status%]Injuries[/color] and does not lose morale when losing Hitpoints.\n"
        es = "\nCuando te llevan al límite, desatas una resistencia y una determinación sin igual.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Por cada [color=%negative%]2%[/color] de Puntos de vida perdidos por debajo del [color=%negative%]66%[/color] del total de Puntos de vida, obtienes [color=%positive%]1[/color] de Defensa cuerpo a cuerpo y de Defensa a distancia adicional.\n\n• Por debajo del [color=%negative%]33%[/color] del total de Puntos de vida, este personaje se vuelve inmune a los efectos de las [color=%status%]Heridas[/color] recientes y no pierde moral al perder Puntos de vida.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendIronside
    {
        en = "\nAll damage received is reduced.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Reduced by [color=%negative%]-5%[/color] for every opponent adjacent and in melee range.\n\n• Up to a [color=%negative%]-30%[/color] total damage reduction.\n"
        es = "\nTodo el daño recibido se reduce.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Se reduce un [color=%positive%]-5%[/color] por cada oponente adyacente y a distancia cuerpo a cuerpo.\n\n• Hasta una reducción total del daño del [color=%positive%]-30%[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendRebound
    {
        en = "\nSurpass your limits!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Fatigue regeneration is increased by [color=%positive%]10%[/color] of your currently accumulated Fatigue rounded up.\n"
        es = "\n¡Supera tus límites!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• La recuperación de Fatiga aumenta en un [color=%positive%]10%[/color] de tu Fatiga acumulada actual, redondeado hacia arriba.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendFeint
    {
        // ::Const.Strings.PerkDescription.LegendFeint <- "\nA well placed feint can leave your enemy Vulnerable!\n\n[color=%passive%][u]Passive:[/u][/color]\n• If an attack misses, it costs [color=%negative%]-20%[/color] less Fatigue than normal.\n\n• After missing an attack you leave your opponent [color=%status%]Parried[/color], lowering their defenses by [color=%negative%]10[/color].\n";
        mode = "pattern"
        en = "\nA well placed feint can leave your enemy Vulnerable!\n\n[color=%passive%][u]Passive:[/u][/color]\n• If an attack misses, it costs [color=%negative%]-20%[/color] less Fatigue than normal.\n\n• After missing an attack you leave your opponent [color=%status%]Parried[/color], lowering their defenses by [color=%negative%]10[/color].\n"
        es = "\n¡Un amago bien colocado puede dejar vulnerable a tu enemigo!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Si un ataque falla, cuesta un [color=%negative%]-20%[/color] menos de Fatiga de lo normal.\n\n• Tras fallar un ataque, dejas a tu oponente [color=%status%]Contrarrestado[/color], lo que reduce sus defensas en [color=%negative%]10[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendLookout
    {
        // ::Const.Strings.PerkDescription.LegendLookout <- "\nLearn to find your enemies before they find you.\n\n[color=%passive%][u]Passive:[/u][/color]\n• This Character's Vision is increased by [color=%positive%]+1[/color].\n\n• While on duty in the scout tent they grant [color=%positive%]+10%[/color] scouting.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Mark Target[/color] skill which afflicts your target with [color=%status%]Marked[/color], reducing their Melee and Ranged defense by [color=%negative%]10[/color] and increasing Damage Received from all sources by up to [color=%negative%]20%[/color] depending on the targets max Hitpoints.\n\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]15[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nLearn to find your enemies before they find you.\n\n[color=%passive%][u]Passive:[/u][/color]\n• This Character's Vision is increased by [color=%positive%]+1[/color].\n\n• While on duty in the scout tent they grant [color=%positive%]+10%[/color] scouting.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Mark Target[/color] skill which afflicts your target with [color=%status%]Marked[/color], reducing their Melee and Ranged defense by [color=%negative%]10[/color] and increasing Damage Received from all sources by up to [color=%negative%]20%[/color] depending on the targets max Hitpoints.\n\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\nAprende a encontrar a tus enemigos antes de que te encuentren a ti.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• La Visión de este personaje aumenta en [color=%positive%]+1[/color].\n\n• Mientras está de servicio en la tienda de exploradores, otorga un [color=%positive%]+10%[/color] de exploración.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Marcar objetivo[/color], que aplica [color=%status%]Marcado[/color] a tu objetivo, lo que reduce su Defensa cuerpo a cuerpo y su Defensa a distancia en [color=%negative%]10[/color] y aumenta el daño que recibe de todas las fuentes hasta en un [color=%negative%]20%[/color] según los Puntos de vida máximos del objetivo.\n\n• Cuesta [color=%negative%]2[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBoondockBlade
    {
        en = "\nCatch your enemies by surprise.\n\n[color=%passive%][u]Passive:[/u][/color]\n• When in a hiding place, such as high grass, gain a bonus of [color=%positive%]+10[/color] to Melee Skill, Ranged Skill, and Melee and Ranged Defense.\n"
        es = "\nToma por sorpresa a tus enemigos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Al estar en un escondite, como la hierba alta, obtienes una bonificación de [color=%positive%]+10[/color] a la Habilidad cuerpo a cuerpo, la Habilidad a distancia, la Defensa cuerpo a cuerpo y la Defensa a distancia.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendArtfulDodger
    {
        en = "\nZone of Control is ignored when moving away from enemy combatants in melee.\n\n[color=%passive%][u]Passive:[/u][/color]\n"
        es = "\nIgnoras la zona de control al alejarte de los combatientes enemigos cuerpo a cuerpo.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendInspire
    {
        // ::Const.Strings.PerkDescription.LegendInspire <- "\nPush your allies beyond their limits!\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Inspire[/color] skill which allows you to target any ally within four tiles, and grant them [color=%positive%]4[/color] Action Points.\n\n• Costs [color=%negative%]8[/color] AP and [color=%negative%]30[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nPush your allies beyond their limits!\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Inspire[/color] skill which allows you to target any ally within four tiles, and grant them [color=%positive%]4[/color] Action Points.\n\n• Costs [color=%negative%]8[/color] AP and [color=%negative%]30[/color] Fatigue.\n"
        es = "\n¡Lleva a tus aliados más allá de sus límites!\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Inspirar[/color], que te permite elegir a cualquier aliado a cuatro casillas o menos y otorgarle [color=%positive%]4[/color] Puntos de acción.\n\n• Cuesta [color=%negative%]8[/color] PA y [color=%negative%]30[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSprint
    {
        // ::Const.Strings.PerkDescription.LegendSprint <- "\nBurst forth like a bolt of lightning, leaving all in your wake.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Sprint[/color] skill which allows you to quickly cover 4 tiles in a straight line\n• does not work across rough terrain or through enemy zones of control.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]25[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nBurst forth like a bolt of lightning, leaving all in your wake.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Sprint[/color] skill which allows you to quickly cover 4 tiles in a straight line\n• does not work across rough terrain or through enemy zones of control.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]25[/color] Fatigue.\n"
        es = "\nLánzate como un rayo y deja a todos atrás.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Carrera[/color], que te permite recorrer rápidamente 4 casillas en línea recta\n• no funciona en terreno abrupto ni a través de zonas de control enemigas.\n\n• Cuesta [color=%negative%]5[/color] PA y [color=%negative%]25[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendQuickStep
    {
        // ::Const.Strings.PerkDescription.LegendQuickStep <- "\nExert yourself to move one tile at an unusually quick speed.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlock the [color=%skill%]Quick Step[/color] skill which allows you to move one tile for only [color=%negative%]1[/color] AP and [color=%negative%]7[/color] Fatigue.\n\n• Only can be used once per turn.\n";
        mode = "pattern"
        en = "\nExert yourself to move one tile at an unusually quick speed.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlock the [color=%skill%]Quick Step[/color] skill which allows you to move one tile for only [color=%negative%]1[/color] AP and [color=%negative%]7[/color] Fatigue.\n\n• Only can be used once per turn.\n"
        es = "\nEsfuérzate para moverte una casilla a una velocidad inusualmente rápida.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Paso rápido[/color], que te permite moverte una casilla por solo [color=%negative%]1[/color] PA y [color=%negative%]7[/color] de Fatiga.\n\n• Solo puede usarse una vez por turno.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendAthlete
    {
        en = "\nYou're a well-rounded athlete!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Reduce the Fatigue cost of all your skills and movement by a percentage equal to [color=%negative%]20%[/color] of your maximum usable Fatigue after gear weight is accounted for.\n"
        es = "\n¡Tienes un físico completo!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Reduce el coste de Fatiga de todas tus habilidades y del movimiento en un porcentaje igual al [color=%positive%]20%[/color] de tu Fatiga máxima utilizable tras descontar el peso del equipo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecPoison
    {
        // ::Const.Strings.PerkDescription.LegendSpecPoison <- "\nUnlock the deadly art of poisoning and be able to lick your poisoned weapon without dying.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Renders the character immune to poison.\n\n• Unlocks the [color=%skill%]Use Poison[/color] skill which allows you to coat your weapons with poison for your next four attacks.\n\n• [color=%status%]Poisoned[/color] enemies have their AP and Vision reduced by [color=%negative%]1[/color] per turns left on the status effect. It also lowers Initiative by [color=%negative%]10[/color] per turns left on the status effect.\n\n• Base [color=%status%]Poison[/color] duration is three turns.\n\n• AP cost is reduced to [color=%negative%]0[/color] on first round of combat.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]15[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nUnlock the deadly art of poisoning and be able to lick your poisoned weapon without dying.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Renders the character immune to poison.\n\n• Unlocks the [color=%skill%]Use Poison[/color] skill which allows you to coat your weapons with poison for your next four attacks.\n\n• [color=%status%]Poisoned[/color] enemies have their AP and Vision reduced by [color=%negative%]1[/color] per turns left on the status effect. It also lowers Initiative by [color=%negative%]10[/color] per turns left on the status effect.\n\n• Base [color=%status%]Poison[/color] duration is three turns.\n\n• AP cost is reduced to [color=%negative%]0[/color] on first round of combat.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\nDesbloquea el arte mortal del envenenamiento y podrás lamer tu arma envenenada sin morir.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Vuelve al personaje inmune al veneno.\n\n• Desbloquea la habilidad [color=%skill%]Usar veneno[/color], que te permite impregnar tus armas con veneno para tus cuatro siguientes ataques.\n\n• Los enemigos [color=%status%]Envenenados[/color] ven reducidos sus PA y su Visión en [color=%negative%]1[/color] por cada turno restante del efecto. También se reduce su Iniciativa en [color=%negative%]10[/color] por cada turno restante del efecto.\n\n• La duración base del [color=%status%]Veneno[/color] es de tres turnos.\n\n• El coste en PA se reduce a [color=%negative%]0[/color] en la primera ronda del combate.\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendEvasion
    {
        en = "\n'Excuse me'\n\n[color=%active%][u]Active:[/u][/color]\n• Enables the character to move swiftly and safely through any Zone of Control for one turn. The first attack against you will be an automatic miss. Can only be used if your total armor weight is 30 or less.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = "\n'Con permiso'\n\n[color=%active%][u]Activo:[/u][/color]\n• Permite al personaje moverse con rapidez y seguridad a través de cualquier zona de control durante un turno. El primer ataque contra ti fallará automáticamente. Solo puede usarse si el peso total de tu armadura es de 30 o menos.\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]20[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendRust
    {
        // ::Const.Strings.PerkDescription.LegendRust <- "\nCorrode enemy armor with arcane rust, weakening their defenses.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Rust[/color] skill which inflicts damage to armor based on the caster's current Initiative. Additionally, it deals [color=%damage%]10[/color] damage to Hitpoints, bypassing armor.\n\n• Hitchance is based on Ranged Skill and has a range of three tiles.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]10[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nCorrode enemy armor with arcane rust, weakening their defenses.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Rust[/color] skill which inflicts damage to armor based on the caster's current Initiative. Additionally, it deals [color=%damage%]10[/color] damage to Hitpoints, bypassing armor.\n\n• Hitchance is based on Ranged Skill and has a range of three tiles.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]10[/color] Fatigue.\n"
        es = "\nCorroe la armadura enemiga con óxido arcano y debilita sus defensas.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Oxidar[/color], que inflige daño a la armadura en función de la Iniciativa actual del lanzador. Además, inflige [color=%damage%]10[/color] de daño a los Puntos de vida, ignorando la armadura.\n\n• La probabilidad de impacto se basa en la Habilidad a distancia y tiene un alcance de tres casillas.\n\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]10[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendWither
    {
        // ::Const.Strings.PerkDescription.LegendWither <- "\nUnleash a spell that ages with a touch, causing withering decay upon your target\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Wither[/color] skill which ages a target for three turns, reducing their Damage, Initiative and Fatigue by [color=%negative%]-30%[/color].\n\n• This effect is reduced by [color=%negative%]10%[/color] each turn.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]15[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nUnleash a spell that ages with a touch, causing withering decay upon your target\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Wither[/color] skill which ages a target for three turns, reducing their Damage, Initiative and Fatigue by [color=%negative%]-30%[/color].\n\n• This effect is reduced by [color=%negative%]10%[/color] each turn.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\nDesata un hechizo que envejece con solo tocar y marchita a tu objetivo\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Marchitar[/color], que envejece a un objetivo durante tres turnos y reduce su daño, su Iniciativa y su Fatiga en un [color=%negative%]-30%[/color].\n\n• Este efecto se reduce un [color=%negative%]10%[/color] cada turno.\n\n• Cuesta [color=%negative%]5[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendDeathtouch
    {
        // ::Const.Strings.PerkDescription.LegendDeathtouch <- "\nYour fingers turn ghostly and pass through steel and flesh, tearing at the soul of your victim.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Death Touch[/color] skill which uses your Melee Skill to hit.\n\n• Damage scales with current Initiative and ignores armor.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]20[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nYour fingers turn ghostly and pass through steel and flesh, tearing at the soul of your victim.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Death Touch[/color] skill which uses your Melee Skill to hit.\n\n• Damage scales with current Initiative and ignores armor.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = "\nTus dedos se vuelven espectrales y atraviesan el acero y la carne, desgarrando el alma de tu víctima.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Toque mortal[/color], que usa tu Habilidad cuerpo a cuerpo para impactar.\n\n• El daño escala con la Iniciativa actual e ignora la armadura.\n\n• Cuesta [color=%negative%]5[/color] PA y [color=%negative%]20[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHex
    {
        // ::Const.Strings.PerkDescription.LegendHex <- "\nYou tie your soul to your enemy, your pain becomes their pain.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Hex[/color] skill\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]10[/color] Fatigue\n";
        mode = "pattern"
        en = "\nYou tie your soul to your enemy, your pain becomes their pain.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Hex[/color] skill\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]10[/color] Fatigue\n"
        es = "\nAtas tu alma a la de tu enemigo: tu dolor se convierte en su dolor.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Maleficio[/color]\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]10[/color] de Fatiga\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMiasma
    {
        // ::Const.Strings.PerkDescription.LegendMiasma <- "\nRelease a cloud of noxious gasses that are harmful to any living being.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Miasma[/color] skill which targets an enemy imbuing the surrounding tiles with noxious ground.\n\n• Noxious ground lasts for four turns proccing when an enemy ends their turn in the miasma, dealing [color=%damage%]5-10[/color] damage per turn.\n\n• Costs [color=%negative%]8[/color] AP and [color=%negative%]40[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nRelease a cloud of noxious gasses that are harmful to any living being.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Miasma[/color] skill which targets an enemy imbuing the surrounding tiles with noxious ground.\n\n• Noxious ground lasts for four turns proccing when an enemy ends their turn in the miasma, dealing [color=%damage%]5-10[/color] damage per turn.\n\n• Costs [color=%negative%]8[/color] AP and [color=%negative%]40[/color] Fatigue.\n"
        es = "\nLibera una nube de gases nocivos, dañinos para cualquier ser vivo.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Miasma[/color], que apunta a un enemigo e impregna las casillas circundantes de suelo nocivo.\n\n• El suelo nocivo dura cuatro turnos y se activa cuando un enemigo termina su turno en el miasma, infligiendo [color=%damage%]5-10[/color] de daño por turno.\n\n• Cuesta [color=%negative%]8[/color] PA y [color=%negative%]40[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendDarkflight
    {
        // ::Const.Strings.PerkDescription.LegendDarkflight <- "\nDisapparate from your current location and reappear on the other side of the battlefield\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Darkflight[/color] skill which lets you teleport up to six tiles away.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]40[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nDisapparate from your current location and reappear on the other side of the battlefield\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Darkflight[/color] skill which lets you teleport up to six tiles away.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]40[/color] Fatigue.\n"
        es = "\nDesaparécete de tu ubicación actual y reaparece al otro lado del campo de batalla\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Vuelo oscuro[/color], que te permite teletransportarte hasta a seis casillas de distancia.\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]40[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendDaze
    {
        // ::Const.Strings.PerkDescription.LegendDaze <- "\nAssault the senses of your target with a flurry of colorful movement and sounds.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Daze[/color] skill which applies the [color=%status%]Stupefied[/color] effect on hit.\n\n• Chance to hit is based on Ranged Skill and has a range of six tiles.\n\n• [color=%status%]Stupefied[/color] enemies have their Initiative, Fatigue, and damage reduced by [color=%negative%]-50%[/color].\n\n• If you have the [color=%perk%]Battlefield Control[/color] perk, the chance to hit is [color=%positive%]doubled[/color].\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]20[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nAssault the senses of your target with a flurry of colorful movement and sounds.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Daze[/color] skill which applies the [color=%status%]Stupefied[/color] effect on hit.\n\n• Chance to hit is based on Ranged Skill and has a range of six tiles.\n\n• [color=%status%]Stupefied[/color] enemies have their Initiative, Fatigue, and damage reduced by [color=%negative%]-50%[/color].\n\n• If you have the [color=%perk%]Battlefield Control[/color] perk, the chance to hit is [color=%positive%]doubled[/color].\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = "\nAsalta los sentidos de tu objetivo con un torbellino de movimientos y sonidos llamativos.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Atontar[/color], que aplica el efecto [color=%status%]Pasmado[/color] al impactar.\n\n• La probabilidad de impactar se basa en la Habilidad a distancia y tiene un alcance de seis casillas.\n\n• Los enemigos [color=%status%]Pasmados[/color] ven reducidos su Iniciativa, su Fatiga y su daño en un [color=%negative%]-50%[/color].\n\n• Si tienes la ventaja [color=%perk%]Control del campo de batalla[/color], la probabilidad de impactar se [color=%positive%]duplica[/color].\n\n• Cuesta [color=%negative%]5[/color] PA y [color=%negative%]20[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendStun
    {
        // ::Const.Strings.PerkDescription.LegendStun <- "\nUnleash a brilliant flash of white light aimed directly at the eyes of your target in an attempt to blind and incapacitate.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%status%]Stun[/color] skill which has a [color=%positive%]100%[/color] chance to [color=%status%]Stun[/color] on hit.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]25[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nUnleash a brilliant flash of white light aimed directly at the eyes of your target in an attempt to blind and incapacitate.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%status%]Stun[/color] skill which has a [color=%positive%]100%[/color] chance to [color=%status%]Stun[/color] on hit.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]25[/color] Fatigue.\n"
        es = "\nDesata un destello brillante de luz blanca dirigido directamente a los ojos de tu objetivo para cegarlo e incapacitarlo.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%status%]Deslumbrar[/color], que tiene un [color=%positive%]100%[/color] de probabilidad de [color=%status%]aturdir[/color] al impactar.\n\n• Cuesta [color=%negative%]6[/color] PA y [color=%negative%]25[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorrify
    {
        // ::Const.Strings.PerkDescription.LegendHorrify <- "\nBlare out a piercing, unworldly sound that is more than likely to distress anyone unfortunate enough to hear it.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Horrify[/color] skill which has a [color=%positive%]100%[/color] chance to Horrify on hit.\n\n• Horrified enemies are unable to act next turn.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]15[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nBlare out a piercing, unworldly sound that is more than likely to distress anyone unfortunate enough to hear it.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Horrify[/color] skill which has a [color=%positive%]100%[/color] chance to Horrify on hit.\n\n• Horrified enemies are unable to act next turn.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\nEmite un sonido penetrante, de otro mundo, que con toda probabilidad angustiará a cualquiera que tenga la desgracia de oírlo.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Horrorizar[/color], que tiene un [color=%positive%]100%[/color] de probabilidad de horrorizar al impactar.\n\n• Los enemigos horrorizados no pueden actuar en su siguiente turno.\n\n• Cuesta [color=%negative%]6[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPush
    {
        // ::Const.Strings.PerkDescription.LegendPush <- "\nConcoct a mixture of smells so fetid and noxious, you force your target to retreat just so they can breathe.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Revolt[/color] skill which knocks the target back a tile and inflicts [color=%positive%]10[/color] Fatigue.\n\n• Chance to hit is based on Ranged Skill and has a range of six tiles.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]30[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nConcoct a mixture of smells so fetid and noxious, you force your target to retreat just so they can breathe.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Revolt[/color] skill which knocks the target back a tile and inflicts [color=%positive%]10[/color] Fatigue.\n\n• Chance to hit is based on Ranged Skill and has a range of six tiles.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]30[/color] Fatigue.\n"
        es = "\nPrepara una mezcla de olores tan fétida y nociva que obligas a tu objetivo a retroceder solo para poder respirar.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Repugnar[/color], que hace retroceder al objetivo una casilla y le inflige [color=%positive%]10[/color] de Fatiga.\n\n• La probabilidad de impactar se basa en la Habilidad a distancia y tiene un alcance de seis casillas.\n\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]30[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendEntice
    {
        // ::Const.Strings.PerkDescription.LegendEntice <- "\nWith a trick of the light, captivate your target in such a way that they can't help but approach you.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Entice[/color] skill which pulls your target one tile towards you with a [color=%positive%]100%[/color] chance to [color=%status%]Stagger[/color] on hit.\n\n• Chance to hit is based on Ranged Skill and has a range of nine tiles.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]10[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nWith a trick of the light, captivate your target in such a way that they can't help but approach you.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Entice[/color] skill which pulls your target one tile towards you with a [color=%positive%]100%[/color] chance to [color=%status%]Stagger[/color] on hit.\n\n• Chance to hit is based on Ranged Skill and has a range of nine tiles.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]10[/color] Fatigue.\n"
        es = "\nCon un juego de luces, cautiva a tu objetivo de tal manera que no pueda evitar acercarse a ti.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Tentar[/color], que atrae a tu objetivo una casilla hacia ti con un [color=%positive%]100%[/color] de probabilidad de dejarlo [color=%status%]Tambaleante[/color] al impactar.\n\n• La probabilidad de impactar se basa en la Habilidad a distancia y tiene un alcance de nueve casillas.\n\n• Cuesta [color=%negative%]6[/color] PA y [color=%negative%]10[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSleep
    {
        // ::Const.Strings.PerkDescription.LegendSleep <- "\nEnshroud the area with thick smoke that draws the vigor out of your foes. Those that breathe in too much are forced into a light sleep.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Sleep[/color] skill.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]5[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nEnshroud the area with thick smoke that draws the vigor out of your foes. Those that breathe in too much are forced into a light sleep.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Sleep[/color] skill.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]5[/color] Fatigue.\n"
        es = "\nCubre la zona con un humo espeso que arrebata el vigor a tus enemigos. Quienes lo respiran en exceso caen en un sueño ligero.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Dormir[/color].\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]5[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendFirefield
    {
        // ::Const.Strings.PerkDescription.LegendFirefield <- "\nUnleash a raging inferno at the target location that explodes and then sets the ground alight.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Firefield[/color] skill which inflicts [color=%damage%]10[/color] - [color=%damage%]20[/color] damage twice and set the area ablaze.\n\n• Anyone ending their turn inside the burning area will catch fire for two turns and take damage - friend and foe alike. Requires a staff.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]50[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nUnleash a raging inferno at the target location that explodes and then sets the ground alight.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Firefield[/color] skill which inflicts [color=%damage%]10[/color] - [color=%damage%]20[/color] damage twice and set the area ablaze.\n\n• Anyone ending their turn inside the burning area will catch fire for two turns and take damage - friend and foe alike. Requires a staff.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]50[/color] Fatigue.\n"
        es = "\nDesata un infierno furioso en el lugar elegido, que explota y luego prende fuego al suelo.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Campo de fuego[/color], que inflige [color=%damage%]10[/color] - [color=%damage%]20[/color] de daño dos veces y prende fuego a la zona.\n\n• Quien termine su turno dentro de la zona en llamas arderá durante dos turnos y recibirá daño, sea amigo o enemigo. Requiere un bastón.\n\n• Cuesta [color=%negative%]5[/color] PA y [color=%negative%]50[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPossessUndead
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]Allows you to boost the attacks of an undead minion.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]10[/color] Fatigue.\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]Te permite potenciar los ataques de un esbirro no muerto.\n\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]10[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSprint
    {
        en = "\nRun as fast as you can!\n\n[color=%active%][u]Active:[/u][/color]\n• For the remainder of this turn, the Action Point cost for movement is reduced by [color=%positive%]1[/color] for each tile, but the Fatigue cost is doubled.\n"
        es = "\n¡Corre tan rápido como puedas!\n\n[color=%active%][u]Activo:[/u][/color]\n• Durante el resto de este turno, el coste en Puntos de acción del movimiento se reduce en [color=%positive%]1[/color] por casilla, pero el coste de Fatiga se duplica.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecBandage
    {
        // ::Const.Strings.PerkDescription.LegendSpecBandage <- "\nMaster the art of bandaging mid battle using any cloth available.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Unlocks the [color=%skill%]Bandage[/color] skill which allows you to bandage allies without a bandage.\n\n• Can bandage while in a zone of control.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]5[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nMaster the art of bandaging mid battle using any cloth available.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Unlocks the [color=%skill%]Bandage[/color] skill which allows you to bandage allies without a bandage.\n\n• Can bandage while in a zone of control.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]5[/color] Fatigue.\n"
        es = "\nDomina el arte de vendar en plena batalla con cualquier tela que tengas a mano.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Vendar[/color], que te permite vendar a tus aliados sin necesidad de vendas.\n\n• Puedes vendar estando en una zona de control.\n\n• Cuesta [color=%negative%]6[/color] PA y [color=%negative%]5[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHoldTheLine
    {
        // ::Const.Strings.PerkDescription.LegendHoldTheLine <- "\n'DON'T LET THEM BREAK THROUGH!'\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Hold the Line[/color] skill which allows you to direct your troops to stand their ground, granting [color=%positive%]+10[/color] Melee Defense, reducing damage taken by [color=%negative%]10%[/color] to all allies within four tiles for one turn.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]20[/color] Fatigue.\n";
        mode = "pattern"
        en = "\n'DON'T LET THEM BREAK THROUGH!'\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Hold the Line[/color] skill which allows you to direct your troops to stand their ground, granting [color=%positive%]+10[/color] Melee Defense, reducing damage taken by [color=%negative%]10%[/color] to all allies within four tiles for one turn.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = "\n'¡NO DEJEN QUE ROMPAN LA LÍNEA!'\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Mantener la línea[/color], que te permite ordenar a tus tropas que se mantengan firmes, lo que otorga [color=%positive%]+10[/color] de Defensa cuerpo a cuerpo y reduce el daño recibido en un [color=%negative%]10%[/color] a todos los aliados a cuatro casillas o menos durante un turno.\n\n• Cuesta [color=%negative%]5[/color] PA y [color=%negative%]20[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendCoordinatedVolleys
    {
        // ::Const.Strings.PerkDescription.LegendCoordinatedVolleys <- "\n'Archers HOLD!'\n\n[color=%active%][u]Active:[/u][/color]\n• Grants the [color=%skill%]Coordinated Volleys[/color] skill which grants[color=%positive%]+10[/color] ranged attack to all allies within [color=%positive%]4[/color] tiles for one turn.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]20[/color] Fatigue.\n";
        mode = "pattern"
        en = "\n'Archers HOLD!'\n\n[color=%active%][u]Active:[/u][/color]\n• Grants the [color=%skill%]Coordinated Volleys[/color] skill which grants[color=%positive%]+10[/color] ranged attack to all allies within [color=%positive%]4[/color] tiles for one turn.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = "\n'¡Arqueros, AGUANTEN!'\n\n[color=%active%][u]Activo:[/u][/color]\n• Otorga la habilidad [color=%skill%]Descargas coordinadas[/color], que otorga [color=%positive%]+10[/color] de ataque a distancia a todos los aliados a [color=%positive%]4[/color] casillas o menos durante un turno.\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]20[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendRaiseUndead
    {
        // ::Const.Strings.PerkDescription.LegendRaiseUndead <- "\nRaise the dead, and turn them into your own personal army.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Unlocks [color=%skill%]Conduct Seance[/color] skill which allows you to summon zombies from dead enemies.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]20[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nRaise the dead, and turn them into your own personal army.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Unlocks [color=%skill%]Conduct Seance[/color] skill which allows you to summon zombies from dead enemies.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = "\nAlza a los muertos y conviértelos en tu propio ejército personal.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Celebrar sesión[/color], que te permite invocar zombis a partir de enemigos muertos.\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]20[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendInsects
    {
        // ::Const.Strings.PerkDescription.LegendInsects <- "\nUnleash a horde of insects on your enemy!\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Insect Swarm[/color] skill which reduces the targets Melee Skill, Melee Defense, Ranged Skill, Ranged Defense and Initiative by [color=%negative%]50%[/color] for three turns.\n\n• Has a range of seven tiles\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]15[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nUnleash a horde of insects on your enemy!\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Insect Swarm[/color] skill which reduces the targets Melee Skill, Melee Defense, Ranged Skill, Ranged Defense and Initiative by [color=%negative%]50%[/color] for three turns.\n\n• Has a range of seven tiles\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\n¡Desata una horda de insectos sobre tu enemigo!\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Enjambre de insectos[/color], que reduce la Habilidad cuerpo a cuerpo, la Defensa cuerpo a cuerpo, la Habilidad a distancia, la Defensa a distancia y la Iniciativa del objetivo en un [color=%negative%]50%[/color] durante tres turnos.\n\n• Tiene un alcance de siete casillas\n\n• Cuesta [color=%negative%]6[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendForwardPush
    {
        // ::Const.Strings.PerkDescription.LegendForwardPush <- "\n'PUSH NOW! FINISH THEM!'\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Forward Push[/color] and [color=%skill%]Coordinated Volleys[/color] skills.\n\n• [color=%skill%]Forward Push[/color] grants [color=%positive%]+10[/color] Melee Skill, [color=%positive%]+5[/color] Resolve and [color=%positive%]+3[/color] Melee Defense to all allies within four tiles for one turn.\n\n• [color=%skill%]Coordinated Volleys[/color] grants [color=%positive%]+10[/color] ranged attack and [color=%positive%]5%[/color] Ranged Damage Bonus to all allies within [color=%positive%]4[/color] tiles for one turn.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]20[/color] Fatigue.\n";
        mode = "pattern"
        en = "\n'PUSH NOW! FINISH THEM!'\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Forward Push[/color] and [color=%skill%]Coordinated Volleys[/color] skills.\n\n• [color=%skill%]Forward Push[/color] grants [color=%positive%]+10[/color] Melee Skill, [color=%positive%]+5[/color] Resolve and [color=%positive%]+3[/color] Melee Defense to all allies within four tiles for one turn.\n\n• [color=%skill%]Coordinated Volleys[/color] grants [color=%positive%]+10[/color] ranged attack and [color=%positive%]5%[/color] Ranged Damage Bonus to all allies within [color=%positive%]4[/color] tiles for one turn.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = "\n'¡EMPUJEN AHORA! ¡ACABEN CON ELLOS!'\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea las habilidades [color=%skill%]Empuje adelante[/color] y [color=%skill%]Descargas coordinadas[/color].\n\n• [color=%skill%]Empuje adelante[/color] otorga [color=%positive%]+10[/color] de Habilidad cuerpo a cuerpo, [color=%positive%]+5[/color] de Resolución y [color=%positive%]+3[/color] de Defensa cuerpo a cuerpo a todos los aliados a cuatro casillas o menos durante un turno.\n\n• [color=%skill%]Descargas coordinadas[/color] otorga [color=%positive%]+10[/color] de ataque a distancia y un [color=%positive%]5%[/color] de bonificación al daño a distancia a todos los aliados a [color=%positive%]4[/color] casillas o menos durante un turno.\n\n• Cuesta [color=%negative%]5[/color] PA y [color=%negative%]20[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendChainLightning
    {
        // ::Const.Strings.PerkDescription.LegendChainLightning <- "\nUnleash an arcing barrage of lightning!\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Chain Lightning[/color] skill which inflicts damage to up to 3 enemies, dealing [color=%damage%]15-40[/color] damage which ignores armor.\n\n• Requires a staff.\n\n• Costs [color=%negative%]8[/color] AP and [color=%negative%]50[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nUnleash an arcing barrage of lightning!\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Chain Lightning[/color] skill which inflicts damage to up to 3 enemies, dealing [color=%damage%]15-40[/color] damage which ignores armor.\n\n• Requires a staff.\n\n• Costs [color=%negative%]8[/color] AP and [color=%negative%]50[/color] Fatigue.\n"
        es = "\n¡Desata una descarga de rayos en arco!\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Rayo en cadena[/color], que alcanza hasta a 3 enemigos e inflige [color=%damage%]15-40[/color] de daño que ignora la armadura.\n\n• Requiere un bastón.\n\n• Cuesta [color=%negative%]8[/color] PA y [color=%negative%]50[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendComposure
    {
        // ::Const.Strings.PerkDescription.LegendComposure <- "\nTrain to keep your cool, under even the most challenging circumstances.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Makes you immune to [color=%status%]Stuns[/color]\n";
        mode = "pattern"
        en = "\nTrain to keep your cool, under even the most challenging circumstances.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Makes you immune to [color=%status%]Stuns[/color]\n"
        es = "\nEntrénate para mantener la calma incluso en las circunstancias más difíciles.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Te vuelve inmune a los [color=%status%]aturdimientos[/color]\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendNightvision
    {
        // ::Const.Strings.PerkDescription.LegendNightvision <- "\nUse your superior vision and training to spot targets in the gloom, and grant that vision to your allies.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Night Vision[/color] skill which removes nighttime penalties to vision for all allies within four tiles.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]20[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nUse your superior vision and training to spot targets in the gloom, and grant that vision to your allies.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Night Vision[/color] skill which removes nighttime penalties to vision for all allies within four tiles.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = "\nUsa tu vista superior y tu entrenamiento para detectar objetivos en la penumbra, y concede esa visión a tus aliados.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Visión Nocturna[/color], que elimina las penalizaciones nocturnas a la visión de todos los aliados a cuatro casillas o menos.\n\n• Cuesta [color=%negative%]6[/color] PA y [color=%negative%]20[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMasteryStaves
    {
        // ::Const.Strings.PerkDescription.LegendMasteryStaves <- "\nLearn to channel your energy through staves and deliver powerful spells.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Build up [color=%negative%]25%[/color] less Fatigue when using [color=%skill%]Chain Lightning[/color], [color=%skill%]Firefield[/color], [color=%skill%]Magic Missile[/color] or [color=%skill%]Root[/color].\n\n• Reduces AP cost of [color=%skill%]Chain Lightning[/color], [color=%skill%]Firefield[/color], [color=%skill%]Magic Missile[/color] or [color=%skill%]Root[/color] by [color=%negative%]1[/color].\n\n• Increases the maximum range of [color=%skill%]Magic Missile[/color] by [color=%negative%]1[/color].\n";
        mode = "pattern"
        en = "\nLearn to channel your energy through staves and deliver powerful spells.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Build up [color=%negative%]25%[/color] less Fatigue when using [color=%skill%]Chain Lightning[/color], [color=%skill%]Firefield[/color], [color=%skill%]Magic Missile[/color] or [color=%skill%]Root[/color].\n\n• Reduces AP cost of [color=%skill%]Chain Lightning[/color], [color=%skill%]Firefield[/color], [color=%skill%]Magic Missile[/color] or [color=%skill%]Root[/color] by [color=%negative%]1[/color].\n\n• Increases the maximum range of [color=%skill%]Magic Missile[/color] by [color=%negative%]1[/color].\n"
        es = "\nAprende a canalizar tu energía a través de bastones y a lanzar hechizos poderosos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Acumulas un [color=%negative%]25%[/color] menos de Fatiga al usar [color=%skill%]Rayo en cadena[/color], [color=%skill%]Campo de fuego[/color], [color=%skill%]Proyectil mágico[/color] o [color=%skill%]Enraizar[/color].\n\n• Reduce en [color=%negative%]1[/color] el coste en PA de [color=%skill%]Rayo en cadena[/color], [color=%skill%]Campo de fuego[/color], [color=%skill%]Proyectil mágico[/color] o [color=%skill%]Enraizar[/color].\n\n• Aumenta en [color=%negative%]1[/color] el alcance máximo de [color=%skill%]Proyectil mágico[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMasteryMusic
    {
        // ::Const.Strings.PerkDescription.LegendMasteryMusic <- "\nProperly tuned with the endurance to play it.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Build up [color=%negative%]25%[/color] less Fatigue when using songs and reduce their AP cost by [color=%negative%]1[/color].\n\n• [color=%skill%]Revolt[/color] and [color=%skill%]Entice[/color] build up [color=%negative%]25%[/color] less Fatigue when using songs and reduce their AP cost by [color=%negative%]1[/color]. Additionally [color=%skill%]Revolt[/color] will no longer have a penalty to hit chance when used in melee.\n\n• Increases the effects of [color=%skill%]Song of Life[/color] and [color=%skill%]War Chant[/color] by [color=%positive%]3[/color] Hitpoints and [color=%positive%]2[/color] Fatigue, respectively.\n";
        mode = "pattern"
        en = "\nProperly tuned with the endurance to play it.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Build up [color=%negative%]25%[/color] less Fatigue when using songs and reduce their AP cost by [color=%negative%]1[/color].\n\n• [color=%skill%]Revolt[/color] and [color=%skill%]Entice[/color] build up [color=%negative%]25%[/color] less Fatigue when using songs and reduce their AP cost by [color=%negative%]1[/color]. Additionally [color=%skill%]Revolt[/color] will no longer have a penalty to hit chance when used in melee.\n\n• Increases the effects of [color=%skill%]Song of Life[/color] and [color=%skill%]War Chant[/color] by [color=%positive%]3[/color] Hitpoints and [color=%positive%]2[/color] Fatigue, respectively.\n"
        es = "\nBien afinado y con el aguante para tocarlo.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Acumulas un [color=%negative%]25%[/color] menos de Fatiga al usar canciones y su coste en PA se reduce en [color=%negative%]1[/color].\n\n• [color=%skill%]Repugnar[/color] y [color=%skill%]Tentar[/color] acumulan un [color=%negative%]25%[/color] menos de Fatiga al usar canciones y su coste en PA se reduce en [color=%negative%]1[/color]. Además, [color=%skill%]Repugnar[/color] ya no tiene penalización a la probabilidad de impactar cuando se usa cuerpo a cuerpo.\n\n• Aumenta los efectos de [color=%skill%]Canción de vida[/color] y [color=%skill%]Canto de guerra[/color] en [color=%positive%]3[/color] Puntos de vida y [color=%positive%]2[/color] de Fatiga, respectivamente.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendGruesomeFeast
    {
        // ::Const.Strings.PerkDescription.LegendGruesomeFeast <- "\nTaste of the forbidden flesh.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Gruesome Feast[/color] skill which allows you to devour a recently departed corpse to gain strength and restore your own Hitpoints by [color=%positive%]50[/color].\n\n• Costs [color=%negative%]7[/color] AP and [color=%negative%]40[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nTaste of the forbidden flesh.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Gruesome Feast[/color] skill which allows you to devour a recently departed corpse to gain strength and restore your own Hitpoints by [color=%positive%]50[/color].\n\n• Costs [color=%negative%]7[/color] AP and [color=%negative%]40[/color] Fatigue.\n"
        es = "\nSaborea la carne prohibida.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Festín espantoso[/color], que te permite devorar un cadáver reciente para ganar fuerza y restaurar [color=%positive%]50[/color] de tus propios Puntos de vida.\n\n• Cuesta [color=%negative%]7[/color] PA y [color=%negative%]40[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendRelax
    {
        // ::Const.Strings.PerkDescription.LegendRelax <- "\nSooth an ally, halving their Fatigue.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Relax[/color] skill which reduces accumulated Fatigue by [color=%negative%]50%[/color] for any ally within three tiles.\n\n• Costs [color=%negative%]9[/color] AP and [color=%negative%]30[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nSooth an ally, halving their Fatigue.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Relax[/color] skill which reduces accumulated Fatigue by [color=%negative%]50%[/color] for any ally within three tiles.\n\n• Costs [color=%negative%]9[/color] AP and [color=%negative%]30[/color] Fatigue.\n"
        es = "\nCalma a un aliado y reduce su Fatiga a la mitad.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Relajar[/color], que reduce la Fatiga acumulada en un [color=%negative%]50%[/color] a cualquier aliado a tres casillas o menos.\n\n• Cuesta [color=%negative%]9[/color] PA y [color=%negative%]30[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendUberNimble
    {
        en = "\nReal berserkers don't need pants.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain another stack of nimble when wearing no armor and helmet.\n"
        es = "\nLos auténticos berserkers no necesitan pantalones.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes otra acumulación de Ligero cuando no llevas ni armadura ni casco.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMuscularity
    {
        en = "\nPut your full weight into every blow!\n\n[color=%passive%][u]Passive:[/u][/color]\n• When using Melee Weapons, Unarmed, Throwing and Bows inflict additional damage, scaling based on [color=%positive%]10%[/color] of your current Hitpoints and [color=%positive%]15%[/color] of your currently available Fatigue (Maximum Fatigue - currently accumulated Fatigue).\n\n• Fatigue calculations are done after gear and values might change in combat.\n"
        es = "\n¡Pon todo tu peso en cada golpe!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Al usar armas cuerpo a cuerpo, Sin armas, armas arrojadizas y arcos, infliges daño adicional en función del [color=%positive%]10%[/color] de tus Puntos de vida actuales y del [color=%positive%]15%[/color] de tu Fatiga disponible actual (Fatiga máxima - Fatiga acumulada actual).\n\n• Los cálculos de Fatiga se hacen después de contar el equipo y los valores pueden cambiar en combate.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBattleheart
    {
        en = "\nWade into the thick of battle, dodging blades from behind and above, aware of all around you at the heart of the battle.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Being surrounded no longer affects this character's defences at all.\n\n• Upgraded version of [color=%perk%]Underdog[/color], immune to [color=%perk%]Strength In Numbers[/color].\n"
        es = "\nAdéntrate en lo más reñido de la batalla, esquivando hojas por detrás y por arriba, consciente de todo lo que te rodea en el corazón del combate.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• La cantidad de enemigos alrededor ya no afecta en absoluto a las defensas de este personaje.\n\n• Versión mejorada de [color=%perk%]Desvalido[/color], inmune a [color=%perk%]La unión hace la fuerza[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendTrueBeliever
    {
        // ::Const.Strings.PerkDescription.LegendTrueBeliever <- "\nLesser men may cower and flee, but you are unassuageable in your commitment.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Allies [color=%status%]Fleeing[/color] or dying no longer lowers this character's morale.\n\n• This character gains [color=%positive%]+5%[/color] Resolve for every [color=%status%]Fleeing[/color] character on the field, friend or foe.\n\n• Taking this perk also removes the superstitious, insecure, craven, and dastard traits.\n";
        mode = "pattern"
        en = "\nLesser men may cower and flee, but you are unassuageable in your commitment.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Allies [color=%status%]Fleeing[/color] or dying no longer lowers this character's morale.\n\n• This character gains [color=%positive%]+5%[/color] Resolve for every [color=%status%]Fleeing[/color] character on the field, friend or foe.\n\n• Taking this perk also removes the superstitious, insecure, craven, and dastard traits.\n"
        es = "\nLos hombres de menor talla pueden acobardarse y huir, pero tu entrega es inquebrantable.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Que los aliados estén [color=%status%]Huyendo[/color] o mueran ya no reduce la moral de este personaje.\n\n• Este personaje obtiene un [color=%positive%]+5%[/color] de Resolución por cada personaje [color=%status%]Huyendo[/color] en el campo, sea amigo o enemigo.\n\n• Elegir esta ventaja también elimina los rasgos supersticioso, inseguro, cobarde y medroso.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPoisonImmunity
    {
        en = "\nWith a well developed immune system and incredible fitness, a warrior's system can shrug off even powerful toxins.\n\n[color=%passive%][u]Passive:[/u][/color]\n• This character becomes immune to all poisons.\n"
        es = "\nCon un sistema inmunitario bien desarrollado y una forma física increíble, el organismo de un guerrero puede resistir incluso toxinas poderosas.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Este personaje se vuelve inmune a todos los venenos.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSummonCat
    {
        en = "\nSummon feline familiar to your aide. Don't worry, this particular cat has nine times a million lives.\n\n[color=%active%][u]Active:[/u][/color]\n• Summons a feline familiar to your side in battle.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\nInvoca a un familiar felino en tu ayuda. No te preocupes: este gato en concreto tiene siete veces un millón de vidas.\n\n[color=%active%][u]Activo:[/u][/color]\n• Invoca a un familiar felino a tu lado en batalla.\n\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpawnZombieLow
    {
        en = "\nRaise a half-formed thrall from a pile of mismatched dead flesh. Though lacking in strength or bodily integrity, it shall obey.\n\n[color=%active%][u]Active:[/u][/color]\n• Requires [color=%negative%]15[/color] Hitpoints to summon and [color=%negative%]1[/color] human carrion.\n\n• Taking this perk grants [color=%positive%]+20[/color] Hitpoints.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]10[/color] Fatigue.\n"
        es = "\nAlza a un siervo a medio formar a partir de un montón de carne muerta dispar. Aunque carezca de fuerza o integridad corporal, obedecerá.\n\n[color=%active%][u]Activo:[/u][/color]\n• Requiere [color=%negative%]15[/color] Puntos de vida para invocar y [color=%negative%]1[/color] unidad de carroña humana.\n\n• Elegir esta ventaja otorga [color=%positive%]+20[/color] Puntos de vida.\n\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]10[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpawnZombieMed
    {
        en = "\nOrganize the remains before you raise it so that your creation is better suited to the work it is given. Sturdier in both form and function.\n\n[color=%active%][u]Active:[/u][/color]\n• Requires [color=%negative%]20[/color] Hitpoints to summon and [color=%negative%]1[/color] human carrion.\n\n• Taking this perk adds [color=%positive%]+30[/color] medicine to your stash and increases total medicine by [color=%positive%]+30[/color].\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = "\nOrdena los restos antes de alzarlos para que tu creación se adapte mejor a la tarea que se le encomiende. Más resistente tanto en forma como en función.\n\n[color=%active%][u]Activo:[/u][/color]\n• Requiere [color=%negative%]20[/color] Puntos de vida para invocar y [color=%negative%]1[/color] unidad de carroña humana.\n\n• Elegir esta ventaja añade [color=%positive%]+30[/color] de medicina a tu inventario y aumenta la medicina total en [color=%positive%]+30[/color].\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]20[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpawnZombieHigh
    {
        en = "\nStitch the body together with such precision so that, once raised, it could pass as alive. A magnum opus of flesh, unsurpassed in power.\n\n[color=%active%][u]Active:[/u][/color]\n• Requires [color=%negative%]30[/color] Hitpoints to summon and [color=%negative%]1[/color] human carrion.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]25[/color] Fatigue.\n"
        es = "\nCose el cuerpo con tal precisión que, una vez alzado, podría pasar por vivo. Una obra maestra de carne, de un poder sin igual.\n\n[color=%active%][u]Activo:[/u][/color]\n• Requiere [color=%negative%]30[/color] Puntos de vida para invocar y [color=%negative%]1[/color] unidad de carroña humana.\n\n• Cuesta [color=%negative%]6[/color] PA y [color=%negative%]25[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpawnSkeletonLow
    {
        en = "\nRaise a ramshackle thrall from some bones only barely ordered. Though lacking in strength or bodily integrity, it shall obey.\n\n[color=%active%][u]Active:[/u][/color]\n• Requires a small flesh sacrifice to perform the ritual.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]10[/color] Fatigue.\n"
        es = "\nAlza a un siervo destartalado a partir de unos huesos apenas ordenados. Aunque carezca de fuerza o integridad corporal, obedecerá.\n\n[color=%active%][u]Activo:[/u][/color]\n• Requiere un pequeño sacrificio de carne para realizar el ritual.\n\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]10[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpawnSkeletonMed
    {
        en = "\nPlace the bones where they belong before you raise them so that it's less liable to fall apart. Sturdier in both form and function.\n\n[color=%active%][u]Active:[/u][/color]\n• Requires a minor flesh sacrifice to perform the ritual.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\nColoca los huesos en su sitio antes de alzarlos para que sea menos propenso a desmoronarse. Más resistente tanto en forma como en función.\n\n[color=%active%][u]Activo:[/u][/color]\n• Requiere un sacrificio menor de carne para realizar el ritual.\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpawnSkeletonHigh
    {
        en = "\nPainstakingly reorganize each bone such that, once raised, no tarsus is out of place. A magnum opus of bone, unsurpassed in power.\n\n[color=%active%][u]Active:[/u][/color]\n• Requires a moderate flesh sacrifice to perform the ritual.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = "\nReorganiza meticulosamente cada hueso para que, una vez alzado, ningún tarso quede fuera de lugar. Una obra maestra de hueso, de un poder sin igual.\n\n[color=%active%][u]Activo:[/u][/color]\n• Requiere un sacrificio moderado de carne para realizar el ritual.\n\n• Cuesta [color=%negative%]5[/color] PA y [color=%negative%]20[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendExtendendAura
    {
        en = "\nYield to the dark power, let it ooze from your pores. With the fell energy now unrestrained, you can further project your art of rousing the dead.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increases range of all skills that raise dead by one tile.\n"
        es = "\nRíndete al poder oscuro y deja que rezume por tus poros. Con esa energía funesta ya sin freno, puedes proyectar aún más lejos tu arte de despertar a los muertos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aumenta en una casilla el alcance de todas las habilidades que alzan a los muertos.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendChanneledPower
    {
        en = "\nLearn to better focus your art so it is less draining on your body.\n\n[color=%passive%][u]Passive:[/u][/color]\n• All skills that raise dead build up [color=%negative%]30%[/color] less Fatigue.\n"
        es = "\nAprende a concentrar mejor tu arte para que agote menos tu cuerpo.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Todas las habilidades que alzan a los muertos acumulan un [color=%positive%]30%[/color] menos de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendReclamation
    {
        en = "\nWeave a bit of your magic through the waste of a corpse so more means may be salvaged.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increases how frequently you gain Human Carrion and Human Bones as loot.\n"
        es = "\nTeje un poco de tu magia entre los despojos de un cadáver para poder aprovechar más recursos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aumenta la frecuencia con la que obtienes Carroña humana y Huesos humanos como botín.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendConservation
    {
        en = "\nConduct profane rituals meant to stave off the passage of time, further preserving the means of your craft.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Reduces the daily medicine cost of maintaining Human Corpses, Bones, and other Carrion by [color=%negative%]50%[/color].\n"
        es = "\nCelebra rituales profanos destinados a frenar el paso del tiempo y preserva aún más los recursos de tu oficio.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Reduce en un [color=%positive%]50%[/color] el coste diario de medicina para conservar cadáveres humanos, huesos y demás carroña.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendEnthrall
    {
        en = "\nPull at the strings of a single creation, compelling them to linger among you as an obedient guardian.\n\n[color=%active%][u]Active:[/u][/color]\n• Enthralled dead act defensively and attempt to protect you from threats.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\nTira de los hilos de una sola de tus creaciones y oblígala a quedarse a tu lado como guardián obediente.\n\n[color=%active%][u]Activo:[/u][/color]\n• Los muertos esclavizados actúan a la defensiva e intentan protegerte de las amenazas.\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendViolentDecomposition
    {
        // ::Const.Strings.PerkDescription.LegendViolentDecomposition <- "\nCorrupt the force sustaining one of your fashioned thralls\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Violent Decomposition[/color] skill which causes a thrall to detonate destructively after the corruption has time to build. Affected dead explode at the end of their turn next round, dealing damage in a one tile radius. The less HP they have, the more damage the explosion inflicts. If they are killed before they explode, the effect no longer triggers.\n\n• Only works on minions fashioned from corpses.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]25[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nCorrupt the force sustaining one of your fashioned thralls\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Violent Decomposition[/color] skill which causes a thrall to detonate destructively after the corruption has time to build. Affected dead explode at the end of their turn next round, dealing damage in a one tile radius. The less HP they have, the more damage the explosion inflicts. If they are killed before they explode, the effect no longer triggers.\n\n• Only works on minions fashioned from corpses.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]25[/color] Fatigue.\n"
        es = "\nCorrompe la fuerza que sostiene a uno de tus siervos creados\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Descomposición violenta[/color], que hace que un siervo detone de forma destructiva cuando la corrupción ha tenido tiempo de acumularse. Los muertos afectados explotan al final de su turno en la ronda siguiente e infligen daño en un radio de una casilla. Cuantos menos PV tengan, más daño inflige la explosión. Si mueren antes de explotar, el efecto ya no se activa.\n\n• Solo funciona con esbirros creados a partir de cadáveres.\n\n• Cuesta [color=%negative%]5[/color] PA y [color=%negative%]25[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPossession
    {
        // ::Const.Strings.PerkDescription.LegendPossession <- "\nEnter the mind of a thrall and lend your power for one turn.\n\n[color=%active%][u]Active:[/u][/color]\n• Increases thralls combat prowess. Only works on allied undead. Possessing a thrall makes them immune to being [color=%status%]Charmed[/color] for the duration of the possession.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]15[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nEnter the mind of a thrall and lend your power for one turn.\n\n[color=%active%][u]Active:[/u][/color]\n• Increases thralls combat prowess. Only works on allied undead. Possessing a thrall makes them immune to being [color=%status%]Charmed[/color] for the duration of the possession.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\nEntra en la mente de un siervo y préstale tu poder durante un turno.\n\n[color=%active%][u]Activo:[/u][/color]\n• Aumenta la destreza en combate de los siervos. Solo funciona con no muertos aliados. Poseer a un siervo lo vuelve inmune al estado [color=%status%]Encantado[/color] mientras dure la posesión.\n\n• Cuesta [color=%negative%]5[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSiphon
    {
        // ::Const.Strings.PerkDescription.LegendSiphon <- "\nSiphon their lifeforce into yourself!\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Siphon[/color] skill which allows you to draw from the lifeforce of your victim and transfer up to [color=%positive%]30%[/color] of their Hitpoints to yourself.\n\n• You may not drain more Hitpoints than you are missing nor drain a victim to their death.\n\n• Effectiveness is reduced by [color=%negative%]5%[/color] for each tile away from your target.\n\n• Chance to hit is based on Melee Attack.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]10[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nSiphon their lifeforce into yourself!\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Siphon[/color] skill which allows you to draw from the lifeforce of your victim and transfer up to [color=%positive%]30%[/color] of their Hitpoints to yourself.\n\n• You may not drain more Hitpoints than you are missing nor drain a victim to their death.\n\n• Effectiveness is reduced by [color=%negative%]5%[/color] for each tile away from your target.\n\n• Chance to hit is based on Melee Attack.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]10[/color] Fatigue.\n"
        es = "\n¡Absorbe su fuerza vital!\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Absorber[/color], que te permite extraer la fuerza vital de tu víctima y transferirte hasta un [color=%positive%]30%[/color] de sus Puntos de vida.\n\n• No puedes drenar más Puntos de vida de los que te faltan ni drenar a una víctima hasta matarla.\n\n• La eficacia se reduce un [color=%negative%]5%[/color] por cada casilla de distancia a tu objetivo.\n\n• La probabilidad de impactar se basa en el ataque cuerpo a cuerpo.\n\n• Cuesta [color=%negative%]5[/color] PA y [color=%negative%]10[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendValaInscriptionMastery
    {
        en = "\nThe Vala becomes is a master at the intricate and lost art of inscribing signs and sigils.\n\n[color=%passive%][u]Passive:[/u][/color]\n• When taking [color=%perk%]Polearm Mastery[/color], the Vala will become able to inscribe shields and weapons.\n\n• When taking [color=%perk%]Nimble[/color] or [color=%perk%]Lithe[/color], the Vala will become able to inscribe Armor and Helmets.\n\n• When she achieves level 11, she will also increase the speed at which she can craft runes by [color=%positive%]30%[/color].\n"
        es = "\nLa Vala es una maestra del intrincado y olvidado arte de inscribir signos y sellos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Al elegir [color=%perk%]Dominio de las Armas de asta[/color], la Vala podrá inscribir escudos y armas.\n\n• Al elegir [color=%perk%]Ligero[/color] o [color=%perk%]Grácil[/color], la Vala podrá inscribir armaduras y cascos.\n\n• Al alcanzar el nivel 11, también aumentará en un [color=%positive%]30%[/color] la velocidad a la que puede fabricar runas.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendValaInscribeWeapon
    {
        en = "\nLearn to inscribe rune sigils for weapons.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Allows the Vala to inscribe rocks with weapon specific rune sigils while encamped to create powerful rune stones.\n\n• Possibilities: accuracy, bleeding, feeding, poison, power.\n"
        es = "\nAprende a inscribir sellos rúnicos para armas.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Permite a la Vala inscribir en piedras sellos rúnicos específicos para armas mientras está en el campamento, para crear poderosas piedras rúnicas.\n\n• Posibilidades: precisión, sangrado, alimentación, veneno, poder.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendValaInscribeHelmet
    {
        en = "\nLearn to inscribe rune sigils for helmets.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Allows the Vala to inscribe rocks with helmet specific rune sigils while encamped to create powerful rune stones.\n\n• Possibilities: bravery, clarity, luck.\n"
        es = "\nAprende a inscribir sellos rúnicos para cascos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Permite a la Vala inscribir en piedras sellos rúnicos específicos para cascos mientras está en el campamento, para crear poderosas piedras rúnicas.\n\n• Posibilidades: valentía, claridad, suerte.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendValaInscribeArmor
    {
        en = "\nLearn to inscribe rune sigils for armor.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Allows the Vala to inscribe rocks with armor specific rune sigils while encamped to create powerful rune stones.\n\n• Possibilities: endurance, resilience, safety.\n"
        es = "\nAprende a inscribir sellos rúnicos para armaduras.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Permite a la Vala inscribir en piedras sellos rúnicos específicos para armaduras mientras está en el campamento, para crear poderosas piedras rúnicas.\n\n• Posibilidades: aguante, resiliencia, seguridad.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendValaInscribeShield
    {
        en = "\nLearn to inscribe rune sigils for shields\n\n[color=%passive%][u]Passive:[/u][/color]\n• Allows the Vala to inscribe rocks with shield specific rune sigils while encamped to create powerful rune stones.\n\n• Possibilities: defense, radiance.\n"
        es = "\nAprende a inscribir sellos rúnicos para escudos\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Permite a la Vala inscribir en piedras sellos rúnicos específicos para escudos mientras está en el campamento, para crear poderosas piedras rúnicas.\n\n• Posibilidades: defensa, resplandor.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendValaChantMastery
    {
        // ::Const.Strings.PerkDescription.LegendValaChantMastery <- "\nObtain mastery over chants.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Chants build up [color=%negative%]25%[/color] less Fatigue.\n\n• The effects of the [color=%skill%]Heightened Senses[/color], [color=%skill%]Disharmony[/color] and [color=%skill%]Fury[/color] chants are increased by [color=%positive%]10%[/color].\n";
        mode = "pattern"
        en = "\nObtain mastery over chants.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Chants build up [color=%negative%]25%[/color] less Fatigue.\n\n• The effects of the [color=%skill%]Heightened Senses[/color], [color=%skill%]Disharmony[/color] and [color=%skill%]Fury[/color] chants are increased by [color=%positive%]10%[/color].\n"
        es = "\nAlcanza el dominio de los cantos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Los cantos acumulan un [color=%negative%]25%[/color] menos de Fatiga.\n\n• Los efectos de los cantos [color=%skill%]Sentidos agudizados[/color], [color=%skill%]Disonancia[/color] y [color=%skill%]Furia[/color] aumentan un [color=%positive%]10%[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendValaChantDisharmony
    {
        // ::Const.Strings.PerkDescription.LegendValaChantDisharmony <- "\nA very disagreeable and cacophonous chant can makes it almost impossible for enemies to focus and concentrate properly.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Disharmony[/color] chant which afflicts enemies within 4 tiles of the Vala will be afflicted by a malus to Initiative.\n\n• The debuff to Initiative increases by [color=%negative%]1%[/color] for every 5 points of Resolve the Vala has.\n\n• The reduction weakens by [color=%negative%]25%[/color] per one tile the target is away from the Vala.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]30[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nA very disagreeable and cacophonous chant can makes it almost impossible for enemies to focus and concentrate properly.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Disharmony[/color] chant which afflicts enemies within 4 tiles of the Vala will be afflicted by a malus to Initiative.\n\n• The debuff to Initiative increases by [color=%negative%]1%[/color] for every 5 points of Resolve the Vala has.\n\n• The reduction weakens by [color=%negative%]25%[/color] per one tile the target is away from the Vala.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]30[/color] Fatigue.\n"
        es = "\nUn canto muy desagradable y cacofónico puede hacer casi imposible que los enemigos se concentren como es debido.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea el canto [color=%skill%]Disonancia[/color], que aplica una penalización a la Iniciativa a los enemigos a 4 casillas o menos de la Vala.\n\n• La penalización a la Iniciativa aumenta un [color=%negative%]1%[/color] por cada 5 puntos de Resolución que tenga la Vala.\n\n• La reducción se debilita un [color=%negative%]25%[/color] por cada casilla que separe al objetivo de la Vala.\n\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]30[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendValaChantFury
    {
        // ::Const.Strings.PerkDescription.LegendValaChantFury <- "\nA chant that gets the blood boiling, making your allies eager to fight.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Fury[/color] chant which grants all allies within three tiles of the Vala, including the Vala herself, a scaling increase in damage based on [color=%positive%]5%[/color] of the Vala's resolve.\n\n• Also grants a chance for allies to retaliate against attackers that hit them in melee range that is equal to [color=%positive%]40%[/color] of the Vala's Resolve.\n\n• Retaliation damage is scales by [color=%positive%]30%[/color] of the Vala's resolve.\n\n• This chants effectiveness is decreased by [color=%negative%]25%[/color] per one tile away from the Vala.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]30[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nA chant that gets the blood boiling, making your allies eager to fight.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Fury[/color] chant which grants all allies within three tiles of the Vala, including the Vala herself, a scaling increase in damage based on [color=%positive%]5%[/color] of the Vala's resolve.\n\n• Also grants a chance for allies to retaliate against attackers that hit them in melee range that is equal to [color=%positive%]40%[/color] of the Vala's Resolve.\n\n• Retaliation damage is scales by [color=%positive%]30%[/color] of the Vala's resolve.\n\n• This chants effectiveness is decreased by [color=%negative%]25%[/color] per one tile away from the Vala.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]30[/color] Fatigue.\n"
        es = "\nUn canto que hace hervir la sangre y vuelve a tus aliados ansiosos por luchar.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea el canto [color=%skill%]Furia[/color], que otorga a todos los aliados a tres casillas o menos de la Vala, incluida la propia Vala, un aumento escalonado del daño basado en el [color=%positive%]5%[/color] de la Resolución de la Vala.\n\n• También otorga a los aliados una probabilidad de devolver el golpe a los atacantes que los golpeen cuerpo a cuerpo, igual al [color=%positive%]40%[/color] de la Resolución de la Vala.\n\n• El daño de represalia escala con el [color=%positive%]30%[/color] de la Resolución de la Vala.\n\n• La eficacia de este canto disminuye un [color=%negative%]25%[/color] por cada casilla de distancia a la Vala.\n\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]30[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendValaChantSenses
    {
        // ::Const.Strings.PerkDescription.LegendValaChantSenses <- "\nAn intriguing chant that stimulates the senses.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Heightened Senses[/color] chant which grants all allies within three tiles of the Vala, including the Vala herself, a bonus to Melee Defense and Ranged Defense.\n\n• The bonus defense is increased by [color=%positive%]1[/color] for every 15 points of Resolve the vala has, as well as every 15 points of avaliable Fatigue the recipient has.\n\n• The bonus is reduced by [color=%negative%]25%[/color] per one tile the target is away from the Vala.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]30[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nAn intriguing chant that stimulates the senses.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Heightened Senses[/color] chant which grants all allies within three tiles of the Vala, including the Vala herself, a bonus to Melee Defense and Ranged Defense.\n\n• The bonus defense is increased by [color=%positive%]1[/color] for every 15 points of Resolve the vala has, as well as every 15 points of avaliable Fatigue the recipient has.\n\n• The bonus is reduced by [color=%negative%]25%[/color] per one tile the target is away from the Vala.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]30[/color] Fatigue.\n"
        es = "\nUn canto intrigante que estimula los sentidos.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea el canto [color=%skill%]Sentidos agudizados[/color], que otorga a todos los aliados a tres casillas o menos de la Vala, incluida la propia Vala, una bonificación a la Defensa cuerpo a cuerpo y a la Defensa a distancia.\n\n• La bonificación de defensa aumenta en [color=%positive%]1[/color] por cada 15 puntos de Resolución que tenga la Vala, así como por cada 15 puntos de Fatiga disponible que tenga quien la recibe.\n\n• La bonificación se reduce un [color=%negative%]25%[/color] por cada casilla que separe al objetivo de la Vala.\n\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]30[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendValaTranceMastery
    {
        en = "\nIncrease your mastery over trances.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Entering trances builds up [color=%negative%]25%[/color] less Fatigue.\n\n• Gain a [color=%positive%]50%[/color] chance to not drop out of trance when receiving damage.\n\n• Trances gain [color=%positive%]+15%[/color] chance to succeed.\n"
        es = "\nAumenta tu dominio de los trances.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Entrar en trance acumula un [color=%positive%]25%[/color] menos de Fatiga.\n\n• Obtienes un [color=%positive%]50%[/color] de probabilidad de no salir del trance al recibir daño.\n\n• Los trances obtienen un [color=%positive%]+15%[/color] de probabilidad de éxito.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendValaTrancePerspective
    {
        // ::Const.Strings.PerkDescription.LegendValaTrancePerspective <- "\nIncorporeal Perspective.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Incorporeal Perspective[/color] skill.\n\n•\n";
        mode = "pattern"
        en = "\nIncorporeal Perspective.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Incorporeal Perspective[/color] skill.\n\n•\n"
        es = "\nPerspectiva incorpórea.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Perspectiva incorpórea[/color].\n\n•\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendValaTranceMalevolent
    {
        // ::Const.Strings.PerkDescription.LegendValaTranceMalevolent <- "\nThe spirit world is home to many malevolent beings, and the Vala knows how to contact them.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Malevolent Spirits[/color] trance which calls spirits to harass, torment, and weaken any target within seven tiles.\n\n• The spirits increase the Fatigue use of the victim by [color=%positive%]1%[/color] for every 25 Resolve, decreases their maximum Fatigue by [color=%positive%]1%[/color] for every 5 Resolve, and decrease damage dealt by [color=%positive%]1%[/color] for every 10 Resolve the Vala has.\n\n• Each turn, the spirits have a chance to spread to additional enemies within two tiles. This chance is equal to the Vala's Resolve minus the victim's Resolve. The chance is [color=%negative%]halved[/color] if the target is more than one tile away.\n\n• Chance to hit is determined by the Vala's Resolve and each failure increases her chance to hit.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]30[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nThe spirit world is home to many malevolent beings, and the Vala knows how to contact them.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Malevolent Spirits[/color] trance which calls spirits to harass, torment, and weaken any target within seven tiles.\n\n• The spirits increase the Fatigue use of the victim by [color=%positive%]1%[/color] for every 25 Resolve, decreases their maximum Fatigue by [color=%positive%]1%[/color] for every 5 Resolve, and decrease damage dealt by [color=%positive%]1%[/color] for every 10 Resolve the Vala has.\n\n• Each turn, the spirits have a chance to spread to additional enemies within two tiles. This chance is equal to the Vala's Resolve minus the victim's Resolve. The chance is [color=%negative%]halved[/color] if the target is more than one tile away.\n\n• Chance to hit is determined by the Vala's Resolve and each failure increases her chance to hit.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]30[/color] Fatigue.\n"
        es = "\nEl mundo de los espíritus alberga a muchos seres malévolos, y la Vala sabe cómo contactar con ellos.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea el trance [color=%skill%]Espíritus malévolos[/color], que llama a los espíritus para hostigar, atormentar y debilitar a cualquier objetivo a siete casillas o menos.\n\n• Los espíritus aumentan el uso de Fatiga de la víctima un [color=%positive%]1%[/color] por cada 25 de Resolución, reducen su Fatiga máxima un [color=%positive%]1%[/color] por cada 5 de Resolución y reducen el daño que inflige un [color=%positive%]1%[/color] por cada 10 de Resolución que tenga la Vala.\n\n• Cada turno, los espíritus tienen una probabilidad de propagarse a otros enemigos a dos casillas o menos. Esta probabilidad es igual a la Resolución de la Vala menos la Resolución de la víctima. La probabilidad se [color=%negative%]reduce a la mitad[/color] si el objetivo está a más de una casilla.\n\n• La probabilidad de impactar depende de la Resolución de la Vala, y cada fallo aumenta su probabilidad de impactar.\n\n• Cuesta [color=%negative%]6[/color] PA y [color=%negative%]30[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendValaWarden
    {
        en = "\nEach individual has a Warden spirit that follows their soul from birth to death.\n\n[color=%passive%][u]Passive:[/u][/color]\n• The Vala has a remarkable connection with her Warden which allows it to manifest itself in a semi-physical form and help her out during battle.\n\n• Automatically summons the Warden at the start of a fight. It can be beaten, but it never dies.\n\n• The Warden's stats scale with the Vala's Resolve.\n"
        es = "\nCada individuo tiene un espíritu Guardián que acompaña a su alma desde el nacimiento hasta la muerte.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• La Vala tiene una conexión extraordinaria con su Guardián, que le permite manifestarse en una forma semifísica y ayudarla durante la batalla.\n\n• Invoca automáticamente al Guardián al inicio de cada combate. Puede ser derrotado, pero nunca muere.\n\n• Los atributos del Guardián escalan con la Resolución de la Vala.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendValaSpiritualBond
    {
        en = "\nThe bond between the Vala and her Warden has grown strong with the passing of time.\n\n[color=%passive%][u]Passive:[/u][/color]\n• A percentage of the Vala's incoming Hitpoints damage is dealt to the Warden instead. The Warden also gains a scaling damage bonus.\n\n•  The redirected damage starts at [color=%positive%]10%[/color] and increases by [color=%positive%]1%[/color] for every 4 points of Resolve up to a maximum of [color=%positive%]50%[/color].\n\n• Additionally, the Warden gains [color=%positive%]5%[/color] of the Vala's Resolve as a scaling damage bonus.\n"
        es = "\nEl vínculo entre la Vala y su Guardián se ha fortalecido con el paso del tiempo.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Un porcentaje del daño a los Puntos de vida que recibe la Vala lo recibe el Guardián en su lugar. El Guardián también obtiene una bonificación escalonada al daño.\n\n•  El daño redirigido empieza en un [color=%positive%]10%[/color] y aumenta un [color=%positive%]1%[/color] por cada 4 puntos de Resolución, hasta un máximo del [color=%positive%]50%[/color].\n\n• Además, el Guardián obtiene el [color=%positive%]5%[/color] de la Resolución de la Vala como bonificación escalonada al daño.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendValaThreads
    {
        en = "\nAs the Vala swings and weaves her staff she spins and twines the threads of fate of those she hits with it.\n\n[color=%passive%][u]Passive:[/u][/color]\n• The Vala needs her staff equipped for this perk to work\n\n• When the Vala hits a target, gain a chance based on Resolve, to apply a stacking debuff that lowers maximum Hitpoints and increases the amount of damage taken.\n\n• Each stack reduces maximum Hitpoints by [color=%negative%]10%[/color] and increases damage taken by [color=%positive%]10%[/color], up to a maximum of 5 stacks.\n"
        es = "\nAl blandir y hacer girar su bastón, la Vala hila y entrelaza los hilos del destino de aquellos a quienes golpea con él.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• La Vala necesita tener equipado su bastón para que esta ventaja funcione\n\n• Cuando la Vala golpea a un objetivo, obtiene una probabilidad, basada en la Resolución, de aplicar una penalización acumulable que reduce los Puntos de vida máximos y aumenta el daño recibido.\n\n• Cada acumulación reduce los Puntos de vida máximos en un [color=%positive%]10%[/color] y aumenta el daño recibido en un [color=%positive%]10%[/color], hasta un máximo de 5 acumulaciones.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendValaPremonition
    {
        en = "\nAs if being warned by some higher being, the Vala occasionally gets glimpses of the immediate future and any dangers it may hold, letting her prepare herself accordingly.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants a chance that an attacker will need two successful rolls to damage the Vala.\n\n• This chance begins at [color=%positive%]9%[/color] and scales with levels, up to a maximum of [color=%positive%]33%[/color] at level 12.\n\n• Additionally, reduces chance to be targeted by enemies by [color=%negative%]9%[/color], scaling with levels up to a maximum of [color=%negative%]33%[/color] at level 12.\n"
        es = "\nComo si algún ser superior la advirtiera, la Vala vislumbra de vez en cuando el futuro inmediato y los peligros que pueda encerrar, lo que le permite prepararse en consecuencia.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga una probabilidad de que un atacante necesite dos tiradas con éxito para dañar a la Vala.\n\n• Esta probabilidad empieza en un [color=%positive%]9%[/color] y escala con el nivel, hasta un máximo del [color=%positive%]33%[/color] en el nivel 12.\n\n• Además, reduce la probabilidad de que los enemigos la elijan como objetivo en un [color=%positive%]9%[/color], que escala con el nivel hasta un máximo del [color=%positive%]33%[/color] en el nivel 12.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendInventorAnatomy
    {
        // ::Const.Strings.PerkDescription.LegendInventorAnatomy <- "\nThrough extensive study of the human form, you learn how to fashion replacement parts from wood and metal.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Unlocks the creation of prosthetic body parts in the crafting tent to help your mercenaries resolve their permanent [color=%status%]Injuries[/color].\n";
        mode = "pattern"
        en = "\nThrough extensive study of the human form, you learn how to fashion replacement parts from wood and metal.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Unlocks the creation of prosthetic body parts in the crafting tent to help your mercenaries resolve their permanent [color=%status%]Injuries[/color].\n"
        es = "\nGracias a un extenso estudio de la forma humana, aprendes a fabricar piezas de repuesto de madera y metal.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Desbloquea la creación de prótesis en la tienda de fabricación para ayudar a tus mercenarios a superar sus [color=%status%]Heridas[/color] permanentes.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendGuideSteps
    {
        // ::Const.Strings.PerkDescription.LegendGuideSteps <- "\nUnlocks the [color=%skill%]Guide Steps[/color] skill, that grants pathfinder to all allies within [color=%positive%]4[/color] tiles.\n";
        mode = "pattern"
        en = "\nUnlocks the [color=%skill%]Guide Steps[/color] skill, that grants pathfinder to all allies within [color=%positive%]4[/color] tiles.\n"
        es = "\nDesbloquea la habilidad [color=%skill%]Guiar los pasos[/color], que otorga Rastreador a todos los aliados a [color=%positive%]4[/color] casillas o menos.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBerserkerRage
    {
        en = "\nGain rage stacks over the course of a battle.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Each stack increases Damage by [color=%positive%]1%[/color], Initiative by [color=%positive%]1[/color], Resolve by [color=%positive%]1[/color] and reduces damage received by [color=%positive%]2%[/color].\n\n• Gain [color=%positive%]1[/color] stack each time you take damage, and [color=%positive%]3[/color] stacks each time you kill.\n\n• Lose [color=%negative%]2[/color] rage stacks per turn.\n\n• Can only accumulate a maximum of 40 stacks and 70% damage reduction.\n"
        es = "\nAcumula furia a lo largo de una batalla.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Cada acumulación aumenta el daño en un [color=%positive%]1%[/color], la Iniciativa en [color=%positive%]1[/color] y la Resolución en [color=%positive%]1[/color], y reduce el daño recibido en un [color=%positive%]2%[/color].\n\n• Obtienes [color=%positive%]1[/color] acumulación cada vez que recibes daño y [color=%positive%]3[/color] acumulaciones cada vez que matas.\n\n• Pierdes [color=%negative%]2[/color] acumulaciones de furia por turno.\n\n• Solo puedes reunir un máximo de 40 acumulaciones y un 70% de reducción del daño.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendAssuredConquest
    {
        // ::Const.Strings.PerkDescription.LegendAssuredConquest <- "\nYour confidence affects your performance.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+10%[/color] Melee Skill, Ranged Skill, Melee Defense, and Ranged Defense when at [color=%status%]Confident[/color] morale.\n\n• These bonuses reduce as your morale state decreases: [color=%positive%]+5%[/color] at [color=%status%]Steady[/color], [color=%negative%]-5%[/color] when [color=%status%]Breaking[/color] and [color=%negative%]-10%[/color] when [color=%status%]Fleeing[/color]. Removes the negative effects of the 'Cocky' trait.\n";
        mode = "pattern"
        en = "\nYour confidence affects your performance.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+10%[/color] Melee Skill, Ranged Skill, Melee Defense, and Ranged Defense when at [color=%status%]Confident[/color] morale.\n\n• These bonuses reduce as your morale state decreases: [color=%positive%]+5%[/color] at [color=%status%]Steady[/color], [color=%negative%]-5%[/color] when [color=%status%]Breaking[/color] and [color=%negative%]-10%[/color] when [color=%status%]Fleeing[/color]. Removes the negative effects of the 'Cocky' trait.\n"
        es = "\nTu confianza influye en tu rendimiento.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes un [color=%positive%]+10%[/color] de Habilidad cuerpo a cuerpo, Habilidad a distancia, Defensa cuerpo a cuerpo y Defensa a distancia cuando tu moral está en [color=%status%]Confiado[/color].\n\n• Estas bonificaciones se reducen a medida que empeora tu estado de moral: [color=%positive%]+5%[/color] en [color=%status%]Firme[/color], [color=%negative%]-5%[/color] en [color=%status%]Viniéndose abajo[/color] y [color=%negative%]-10%[/color] en [color=%status%]Huyendo[/color]. Elimina los efectos negativos del rasgo 'Engreído'.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendTasteThePain
    {
        en = "\nYou are invigorated by pain.\n\n[color=%passive%][u]Passive:[/u][/color]Whenever getting hurt would normally trigger a morale check, instead gain [color=%positive%]10[/color] morale.\n"
        es = "\nEl dolor te revitaliza.\n\n[color=%passive%][u]Pasivo:[/u][/color]Siempre que recibir daño fuera a provocar una tirada de moral, en su lugar obtienes [color=%positive%]10[/color] de moral.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBecomeBerserker
    {
        en = "\nBecome a berserker\n\n[color=%passive%][u]Passive:[/u][/color]This character background changes into a berserker, losing all current perks.\n"
        es = "\nConviértete en berserker\n\n[color=%passive%][u]Pasivo:[/u][/color]El trasfondo de este personaje cambia a berserker y pierde todas sus ventajas actuales.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSkillfulStacking
    {
        en = "\nBy creating neat stacks and tying them down well you can carry more gear.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants [color=%positive%]12[/color] additional stash spaces and [color=%positive%]+9[/color] Fatigue.\n"
        es = "\nApilando el equipo con orden y atándolo bien puedes cargar con más.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga [color=%positive%]12[/color] espacios de inventario adicionales y [color=%positive%]+9[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendEfficientPacking
    {
        en = "\nArranging gear in just the right way, you're able to squeeze more things into the same space.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants [color=%positive%]8[/color] additional stash spaces and [color=%positive%]+6[/color] Fatigue.\n"
        es = "\nColocando el equipo de la manera justa, consigues meter más cosas en el mismo espacio.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga [color=%positive%]8[/color] espacios de inventario adicionales y [color=%positive%]+6[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendAmmoBinding
    {
        en = "\nExpertise in making ammunition lets you strip it down to pack the parts for storage, it also lets you draw out arrows faster.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increases maximum ammunition storage by [color=%positive%]10[/color] and Ranged skill by [color=%positive%]+5%[/color].\n"
        es = "\nTu pericia fabricando munición te permite desmontarla para guardar sus piezas, y también sacar las flechas más rápido.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aumenta el almacenamiento máximo de munición en [color=%positive%]10[/color] y la Habilidad a distancia en un [color=%positive%]+5%[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendAmmoBundles
    {
        en = "\nUsing blankets and ropes to group large bundles of ammunition together you are able to carry far more. These bundles can also be used to shield yourself from enemy fire.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increases maximum ammunition storage by [color=%positive%]20[/color] and Ranged Defense by [color=%positive%]+5%[/color].\n"
        es = "\nUsando mantas y cuerdas para agrupar grandes fardos de munición, puedes cargar mucho más. Estos fardos también sirven para protegerte del fuego enemigo.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aumenta el almacenamiento máximo de munición en [color=%positive%]20[/color] y la Defensa a distancia en un [color=%positive%]+5%[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMedPackages
    {
        en = "\nNot all of a plant is required for healing, your knowledge of the active ingredients lets you throw away excess leaves and roots. Your knowledge of medicines lets you repack them into more efficient packages.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increases maximum medicine storage by [color=%positive%]30[/color] and Resolve by [color=%positive%]+5%[/color].\n"
        es = "\nNo hace falta toda la planta para curar: conocer los principios activos te permite desechar las hojas y raíces sobrantes. Tu conocimiento de los remedios te permite reempaquetarlos de forma más eficiente.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aumenta el almacenamiento máximo de medicina en [color=%positive%]30[/color] y la Resolución en un [color=%positive%]+5%[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMedIngredients
    {
        en = "\nLearning the plants of the healing trade allows you to fashion crude healing supplies from common ingredients.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Unlocks crafting bandages and medicine.\n\n• Increases maximum medicine storage by [color=%positive%]10[/color] and Resolve by [color=%positive%]+5%[/color].\n"
        es = "\nConocer las plantas del oficio de sanador te permite elaborar suministros médicos rudimentarios con ingredientes comunes.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Desbloquea la fabricación de vendas y medicina.\n\n• Aumenta el almacenamiento máximo de medicina en [color=%positive%]10[/color] y la Resolución en un [color=%positive%]+5%[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendToolsDrawers
    {
        en = "\nOrganising your tools into labeled compartments lets you carry more.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increases maximum tool storage by [color=%positive%]10[/color]\n• Reduces global tool usage by [color=%positive%]4%[/color].\n• Increases Fatigue by [color=%positive%]+3[/color].\n"
        es = "\nOrganizar tus herramientas en compartimentos etiquetados te permite cargar más.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aumenta el almacenamiento máximo de herramientas en [color=%positive%]10[/color]\n• Reduce el consumo global de herramientas en un [color=%positive%]4%[/color].\n• Aumenta la Fatiga en [color=%positive%]+3[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendToolsSpares
    {
        en = "\nYour experience with repairs has taught you to save your scraps and left over parts. These spares take up little space but are often just what you need for field repairs.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increases maximum tool storage by [color=%positive%]20[/color].\n• Reduces global tool usage by [color=%positive%]6%[/color].\n• Increases Fatigue by [color=%positive%]+6[/color].\n"
        es = "\nTu experiencia con las reparaciones te ha enseñado a guardar los restos y las piezas sobrantes. Estos repuestos ocupan poco espacio, pero a menudo son justo lo que necesitas para las reparaciones sobre el terreno.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aumenta el almacenamiento máximo de herramientas en [color=%positive%]20[/color].\n• Reduce el consumo global de herramientas en un [color=%positive%]6%[/color].\n• Aumenta la Fatiga en [color=%positive%]+6[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBarterConvincing
    {
        en = "\nThis characters skill with words makes their trade proposals more acceptable.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increases Barter skill by [color=%positive%]+1%[/color], improving all buy and sell prices and rewards from trade contracts.\n\n• They also generate [color=%positive%]+10 Crowns[/color] each day through their investments and an additional [color=%positive%]+1 Crowns[/color] per level.\n\n• Unfortunately, their negotiation skill also increases their daily pay rate by [color=%negative%]+25%[/color].\n"
        es = "\nLa destreza de este personaje con las palabras hace que sus propuestas comerciales resulten más aceptables.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aumenta la habilidad de Regateo en un [color=%positive%]+1%[/color], lo que mejora todos los precios de compra y venta y las recompensas de los contratos comerciales.\n\n• Además, genera [color=%positive%]+10 coronas[/color] al día gracias a sus inversiones, y [color=%positive%]+1 corona[/color] adicional por nivel.\n\n• Por desgracia, su destreza negociadora también aumenta su paga diaria en un [color=%negative%]+25%[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBarterTrustworthy
    {
        en = "\nThis character's body language makes people believe them, leading to more favourable trade agreements.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants [color=%positive%]+2%[/color] barter skill.\n\n• Barter skill begins falling off at higher total rates.\n"
        es = "\nEl lenguaje corporal de este personaje hace que la gente le crea, lo que da lugar a acuerdos comerciales más favorables.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga un [color=%positive%]+2%[/color] a la habilidad de Regateo.\n\n• La habilidad de Regateo empieza a perder efecto a partir de totales más altos.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBribe
    {
        en = "\nYou've never met a problem that money couldn't solve.\n\n[color=%active%][u]Active:[/u][/color]\n• Throw coins at your enemies to bribe them away from battle, only works on humans. The cost is the XP that would be granted by killing the enemy, to the power of 1.3.\n\n• Costs [color=%negative%]variable[/color] AP and [color=%negative%]variable[/color] Fatigue based on the XP.\n"
        es = "\nNunca has encontrado un problema que el dinero no pudiera resolver.\n\n[color=%active%][u]Activo:[/u][/color]\n• Lanza monedas a tus enemigos para sobornarlos y que abandonen la batalla; solo funciona con humanos. El coste es la experiencia que se obtendría al matar al enemigo, elevada a 1,3.\n\n• Cuesta una cantidad [color=%negative%]variable[/color] de PA y una cantidad [color=%negative%]variable[/color] de Fatiga según la experiencia.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendOffBookDeal
    {
        en = "\nConvince anyone into selling you their priciest possession. Even if that means paying extra.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Reduces Barter by [color=%negative%]-1%[/color].\n\n• When entering a town that has no active situation, apply the 'Off-Book Deal' situation for 3 days.\n\n• This situation grants [color=%positive%]+10%[/color] to available items and [color=%positive%]+10%[/color] to buying price for each brother with this perk.\n"
        es = "\nConvence a cualquiera para que te venda su posesión más valiosa. Aunque eso suponga pagar de más.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Reduce el Regateo en un [color=%negative%]-1%[/color].\n\n• Al entrar en una ciudad sin ninguna situación activa, aplica la situación 'Trato bajo cuerda' durante 3 días.\n\n• Esta situación otorga un [color=%positive%]+10%[/color] de objetos disponibles y un [color=%positive%]+10%[/color] al precio de compra por cada hermano con esta ventaja.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPatientHunter
    {
        en = "\nCarefully evaluate your enemies and bide your time.\n\n[color=%passive%][u]Passive:[/u][/color]\n• When ending your turn, excess Action Points will be transfered to your next turn with a maximum of 3.\n"
        es = "\nEvalúa con cuidado a tus enemigos y espera tu momento.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Al terminar tu turno, los Puntos de acción sobrantes se transfieren a tu siguiente turno, con un máximo de 3.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBarrage
    {
        // ::Const.Strings.PerkDescription.LegendBarrage <- "\nLets hope your enemies like fighting in the shade.\n\n[color=%passive%][u]Passive:[/u][/color]\n• [color=%skill%]Sling Stone[/color] will now [color=%status%]Debilitate[/color] on headshots, [color=%status%]Baffle[/color] on body shots and ignore shield bonuses.\n\n• [color=%skill%]Fire Handgonne[/color] will apply [color=%status%]Shellshocked[/color] on headshots.\n\n• [color=%skill%]Sling Heavy Stone[/color] will stun on headshots.\n\n• [color=%skill%]Shoot Bolt[/color], [color=%skill%]Piercing Bolt[/color] and [color=%skill%]Shoot Stake[/color] headshots reduces the cost of [color=%skill%]Reload Bolt[/color] to [color=%negative%]0[/color] AP and [color=%negative%]10[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nLets hope your enemies like fighting in the shade.\n\n[color=%passive%][u]Passive:[/u][/color]\n• [color=%skill%]Sling Stone[/color] will now [color=%status%]Debilitate[/color] on headshots, [color=%status%]Baffle[/color] on body shots and ignore shield bonuses.\n\n• [color=%skill%]Fire Handgonne[/color] will apply [color=%status%]Shellshocked[/color] on headshots.\n\n• [color=%skill%]Sling Heavy Stone[/color] will stun on headshots.\n\n• [color=%skill%]Shoot Bolt[/color], [color=%skill%]Piercing Bolt[/color] and [color=%skill%]Shoot Stake[/color] headshots reduces the cost of [color=%skill%]Reload Bolt[/color] to [color=%negative%]0[/color] AP and [color=%negative%]10[/color] Fatigue.\n"
        es = "\nEsperemos que a tus enemigos les guste combatir a la sombra.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• [color=%skill%]Lanzar piedra[/color] ahora [color=%status%]debilitará[/color] con los disparos a la cabeza, [color=%status%]desconcertará[/color] con los disparos al cuerpo e ignorará las bonificaciones de escudo.\n\n• [color=%skill%]Disparar cañón de mano[/color] aplicará [color=%status%]Conmocionado[/color] con los disparos a la cabeza.\n\n• [color=%skill%]Lanzar piedra pesada[/color] aturdirá con los disparos a la cabeza.\n\n• Los disparos a la cabeza con [color=%skill%]Disparar virote[/color], [color=%skill%]Virote perforante[/color] y [color=%skill%]Disparar estaca[/color] reducen el coste de [color=%skill%]Recargar virote[/color] a [color=%negative%]0[/color] PA y [color=%negative%]10[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendStaffBlock
    {
        // ::Const.Strings.PerkDescription.LegendStaffBlock <- "\nGive them no quarter!\n\n[color=%active%][u]Active:[/u][/color]\n• Grants the [color=%skill%]Staff Riposte[/color] ability which allows counterattack any opponent that misses you in melee.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Additionally, while wielding a staff, the defense malus due to being surrounded by opponents is reduced by [color=%negative%]3[/color].\n\n• If you have [color=%perk%]Underdog[/color] or [color=%perk%]Battleheart[/color], this perk will instead increase defenses by [color=%positive%]5[/color].\n";
        mode = "pattern"
        en = "\nGive them no quarter!\n\n[color=%active%][u]Active:[/u][/color]\n• Grants the [color=%skill%]Staff Riposte[/color] ability which allows counterattack any opponent that misses you in melee.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Additionally, while wielding a staff, the defense malus due to being surrounded by opponents is reduced by [color=%negative%]3[/color].\n\n• If you have [color=%perk%]Underdog[/color] or [color=%perk%]Battleheart[/color], this perk will instead increase defenses by [color=%positive%]5[/color].\n"
        es = "\n¡No les des cuartel!\n\n[color=%active%][u]Activo:[/u][/color]\n• Otorga la habilidad [color=%skill%]Contraataque con bastón[/color], que permite contraatacar a cualquier oponente que te falle cuerpo a cuerpo.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Además, mientras empuñas un bastón, la penalización a la defensa por tener oponentes alrededor se reduce en [color=%negative%]3[/color].\n\n• Si tienes [color=%perk%]Desvalido[/color] o [color=%perk%]Corazón de batalla[/color], esta ventaja aumentará en su lugar tus defensas en [color=%positive%]5[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMinnesanger
    {
        // ::Const.Strings.PerkDescription.LegendMinnesanger <- "\n'Step outside mine walls, wearing an expensive tunic. Thee sayeth thou art highborn, but I heareth thou art eunich.'\n\n[color=%passive%][u]Passive:[/u][/color]\n• Fatigue cost for Song skills is reduced by [color=%negative%]25%[/color] and AP cost by [color=%negative%]1[/color].\n\n• Increases the effects of [color=%skill%]Song of Life[/color] and [color=%skill%]War Chant[/color] by [color=%positive%]3[/color] Hitpoints and [color=%positive%]2[/color] Fatigue, respectively.\n";
        mode = "pattern"
        en = "\n'Step outside mine walls, wearing an expensive tunic. Thee sayeth thou art highborn, but I heareth thou art eunich.'\n\n[color=%passive%][u]Passive:[/u][/color]\n• Fatigue cost for Song skills is reduced by [color=%negative%]25%[/color] and AP cost by [color=%negative%]1[/color].\n\n• Increases the effects of [color=%skill%]Song of Life[/color] and [color=%skill%]War Chant[/color] by [color=%positive%]3[/color] Hitpoints and [color=%positive%]2[/color] Fatigue, respectively.\n"
        es = "\n'Sal de mis muros, ataviado con túnica costosa. Dícesme que eres de alta cuna, mas oigo decir que eres eunuco.'\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• El coste de Fatiga de las habilidades de canción se reduce en un [color=%negative%]25%[/color] y el coste en PA en [color=%negative%]1[/color].\n\n• Aumenta los efectos de [color=%skill%]Canción de vida[/color] y [color=%skill%]Canto de guerra[/color] en [color=%positive%]3[/color] Puntos de vida y [color=%positive%]2[/color] de Fatiga, respectivamente.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMeistersanger
    {
        // ::Const.Strings.PerkDescription.LegendMeistersanger <- "\nYou have stepped up above playing shameful songs, ridiculing nobles and are a musician of some renown, whos fine melodies can whip any company into a battle frenzy.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Martial March[/color] skill which increases AP by [color=%negative%]1[/color] for one turn to all allies within an 8 tile range.\n\n• Costs [color=%negative%]9[/color] AP and [color=%negative%]45[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nYou have stepped up above playing shameful songs, ridiculing nobles and are a musician of some renown, whos fine melodies can whip any company into a battle frenzy.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Martial March[/color] skill which increases AP by [color=%negative%]1[/color] for one turn to all allies within an 8 tile range.\n\n• Costs [color=%negative%]9[/color] AP and [color=%negative%]45[/color] Fatigue.\n"
        es = "\nHas dejado atrás las canciones vergonzosas que ridiculizan a los nobles y te has ganado cierto renombre como intérprete, con melodías refinadas capaces de llevar a cualquier compañía al frenesí de la batalla.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Marcha marcial[/color], que aumenta los PA en [color=%negative%]1[/color] durante un turno a todos los aliados en un radio de 8 casillas.\n\n• Cuesta [color=%negative%]9[/color] PA y [color=%negative%]45[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistButcher
    {
        en = "\nYour skill on the butcher's block seems to be easily translated to chopping limbs on the battlefield.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit and [color=%positive%]+2[/color] Bleed damage while using a Butcher's Cleaver.\n\n• When taking [color=%perk%]Cleaver Mastery[/color] you will also gain [color=%positive%]10%[/color] bonus damage.\n\n• For other weapons classified as Cleavers, but not Whips, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n"
        es = "\nTu destreza en el tajo de carnicero parece trasladarse con facilidad a cortar miembros en el campo de batalla.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] de probabilidad de impactar y [color=%positive%]+2[/color] de daño por sangrado al usar una Cuchilla de carnicero.\n\n• Al elegir [color=%perk%]Dominio de la Cuchilla[/color] también obtienes un [color=%positive%]10%[/color] de daño adicional.\n\n• Con otras armas clasificadas como cuchillas, salvo los látigos, puedes obtener un porcentaje escalonado de estas bonificaciones, que empieza en un 25% y aumenta gradualmente un 5% por nivel hasta el 100%, con la bonificación máxima en el nivel 15.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistBlacksmith
    {
        en = "\nDiligent practice with the hammer each day has proven to be equally good at crafting armor and finding it's weak points.\n\n[color=%passive%][u]Passive:[/u][/color]\n• While using a Blacksmith's Hammer gain [color=%positive%]+12[/color] chance to hit and [color=%positive%]+30%[/color] effectiveness vs armor.\n\n• When taking [color=%perk%]Hammer Mastery[/color] you will also gain [color=%positive%]10%[/color] bonus damage.\n\n• For other weapons classified as One Handed Hammers, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n"
        es = "\nLa práctica diligente con el martillo cada día ha resultado igual de útil para forjar armaduras que para encontrar sus puntos débiles.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Al usar un Martillo de herrero obtienes [color=%positive%]+12[/color] de probabilidad de impactar y un [color=%positive%]+30%[/color] de eficacia contra la armadura.\n\n• Al elegir [color=%perk%]Dominio del Martillo[/color] también obtienes un [color=%positive%]10%[/color] de daño adicional.\n\n• Con otras armas clasificadas como martillos a una mano, puedes obtener un porcentaje escalonado de estas bonificaciones, que empieza en un 25% y aumenta gradualmente un 5% por nivel hasta el 100%, con la bonificación máxima en el nivel 15.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistPrisoner
    {
        en = "\nLife on the streets has shown you how to properly bury a knife in another person.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit while using any Knife.\n\n• When taking [color=%perk%]Dagger Mastery[/color] you will also gain [color=%positive%]10%[/color] bonus damage.\n\n• For other weapons classified as Daggers, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n\n• You will also receive the Deathblow skill and Daggers that already have Deathblow, like Qatal Daggers, will have a buffed version.\n"
        es = "\nLa vida en las calles te ha enseñado a clavar bien un cuchillo en otra persona.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] de probabilidad de impactar al usar cualquier cuchillo.\n\n• Al elegir [color=%perk%]Dominio de la Daga[/color] también obtienes un [color=%positive%]10%[/color] de daño adicional.\n\n• Con otras armas clasificadas como dagas, puedes obtener un porcentaje escalonado de estas bonificaciones, que empieza en un 25% y aumenta gradualmente un 5% por nivel hasta el 100%, con la bonificación máxima en el nivel 15.\n\n• También recibes la habilidad Golpe mortal, y las dagas que ya tienen Golpe mortal, como las dagas Qatal, tendrán una versión mejorada.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistMusician
    {
        // ::Const.Strings.PerkDescription.LegendSpecialistMusician <- "\nTaverns have taught you that instruments can be used to make spin tunes, bash heads and block a thrown vegetable.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increases the effects of [color=%skill%]Song of Life[/color] and [color=%skill%]War Chant[/color] by [color=%positive%]3[/color] Hitpoints and [color=%positive%]2[/color] Fatigue, respectively.\n\n• Gain [color=%positive%]+10[/color] Melee Defense when using Musical Instruments.\n";
        mode = "pattern"
        en = "\nTaverns have taught you that instruments can be used to make spin tunes, bash heads and block a thrown vegetable.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increases the effects of [color=%skill%]Song of Life[/color] and [color=%skill%]War Chant[/color] by [color=%positive%]3[/color] Hitpoints and [color=%positive%]2[/color] Fatigue, respectively.\n\n• Gain [color=%positive%]+10[/color] Melee Defense when using Musical Instruments.\n"
        es = "\nLas tabernas te han enseñado que los instrumentos sirven para tocar melodías, partir cabezas y parar una verdura lanzada.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aumenta los efectos de [color=%skill%]Canción de vida[/color] y [color=%skill%]Canto de guerra[/color] en [color=%positive%]3[/color] Puntos de vida y [color=%positive%]2[/color] de Fatiga, respectivamente.\n\n• Obtienes [color=%positive%]+10[/color] de Defensa cuerpo a cuerpo al usar instrumentos musicales.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistMilitia
    {
        en = "\nYou have mastered the trusty spear and you can use it both for dealing damage and keeping enemies at bay.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit and [color=%positive%]15%[/color] Melee Damage on Attacks of Opportunity while using a Militia Spear, Wooden Spear and Ancient spear.\n\n• When taking [color=%perk%]Spear Mastery[/color] you will also gain [color=%positive%]10%[/color] bonus damage.\n\n• For other weapons classified as Spears you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n"
        es = "\nHas dominado la fiel lanza y puedes usarla tanto para infligir daño como para mantener a raya a los enemigos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] de probabilidad de impactar y un [color=%positive%]15%[/color] de daño cuerpo a cuerpo en los ataques de oportunidad al usar una Lanza de milicia, una Lanza de madera o una Lanza antigua.\n\n• Al elegir [color=%perk%]Dominio de la Lanza[/color] también obtienes un [color=%positive%]10%[/color] de daño adicional.\n\n• Con otras armas clasificadas como lanzas, puedes obtener un porcentaje escalonado de estas bonificaciones, que empieza en un 25% y aumenta gradualmente un 5% por nivel hasta el 100%, con la bonificación máxima en el nivel 15.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistMiner
    {
        en = "\nCracking rocks and cracking skulls aren't that much different.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit while using a Two Handed Hammer, Pickaxe or Military Pick.\n\n• When taking [color=%perk%]Hammer Mastery[/color] you will also gain [color=%positive%]10%[/color] bonus damage.\n\n• For other weapons classified as Two Handed Hammers, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n\n• The bonus will be doubled against Ifrits and Rock Unholds.\n"
        es = "\nPartir rocas y partir cráneos no es tan distinto.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar al usar un Martillo a dos manos, un Pico o un Pico militar.\n\n• Al adquirir [color=%perk%]Dominio del Martillo[/color] también obtienes un [color=%positive%]10%[/color] de daño adicional.\n\n• Con otras armas clasificadas como Martillos a dos manos, obtienes un porcentaje progresivo de estas bonificaciones, que empieza en el 25% y aumenta un 5% por nivel hasta llegar al 100% en el nivel 15.\n\n• La bonificación se duplica contra Ifrits y Troles de roca.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistFarmhand
    {
        en = "\nYears of using farming tools have given you an understanding of how to stab true and slash in smooth strokes.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit and [color=%positive%]+25%[/color] Armor Damage while using a Pitchfork, Wooden Pitchfork, Hoe, Scythe or Wooden Flail.\n\n• When taking [color=%perk%]Polearm Mastery[/color] you will also gain [color=%positive%]10%[/color] bonus damage.\n\n• For other weapons classified as Polearms, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n"
        es = "\nAños usando aperos de labranza te han enseñado a apuñalar con tino y a tajar con trazos limpios.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar y [color=%positive%]+25%[/color] de daño a la armadura al usar una Horca, una Horca de madera, una Azada, una Guadaña o un Mayal de madera.\n\n• Al adquirir [color=%perk%]Dominio de las Armas de asta[/color] también obtienes un [color=%positive%]10%[/color] de daño adicional.\n\n• Con otras armas clasificadas como Armas de asta, obtienes un porcentaje progresivo de estas bonificaciones, que empieza en el 25% y aumenta un 5% por nivel hasta llegar al 100% en el nivel 15.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistPoacher
    {
        // ::Const.Strings.PerkDescription.LegendSpecialistPoacher <- "\nFrom small game to big bounties.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit while using a Wonky Bow or Short Bow.\n\n• When using Armor Piercing Arrows gain [color=%positive%]+25%[/color] armor penetration.\n\n• When using Broad Head Arrows gain [color=%positive%]10%[/color] Bonus Damage and cause minor but long-lasting [color=%status%]Bleeding[/color] on any target you deal direct Hitpoints damage to with any weapon.\n\n• The [color=%status%]Bleed[/color] deals [color=%damage%]2[/color] damage per turn and lasts five turns.\n\n• When taking [color=%perk%]Bow Mastery[/color] you will also gain [color=%positive%]10%[/color] bonus damage.\n\n• For other weapons classified as Bows, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n\n• The bonus will be doubled against Wolves and Hyenas.\n";
        mode = "pattern"
        en = "\nFrom small game to big bounties.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit while using a Wonky Bow or Short Bow.\n\n• When using Armor Piercing Arrows gain [color=%positive%]+25%[/color] armor penetration.\n\n• When using Broad Head Arrows gain [color=%positive%]10%[/color] Bonus Damage and cause minor but long-lasting [color=%status%]Bleeding[/color] on any target you deal direct Hitpoints damage to with any weapon.\n\n• The [color=%status%]Bleed[/color] deals [color=%damage%]2[/color] damage per turn and lasts five turns.\n\n• When taking [color=%perk%]Bow Mastery[/color] you will also gain [color=%positive%]10%[/color] bonus damage.\n\n• For other weapons classified as Bows, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n\n• The bonus will be doubled against Wolves and Hyenas.\n"
        es = "\nDe la caza menor a las grandes recompensas.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar al usar un Arco torcido o un Arco corto.\n\n• Al usar Flechas antiarmadura obtienes [color=%positive%]+25%[/color] de penetración de armadura.\n\n• Al usar Flechas de punta ancha obtienes un [color=%positive%]10%[/color] de daño adicional y causas un [color=%status%]Sangrado[/color] leve pero duradero a cualquier objetivo al que inflijas daño directo a los Puntos de vida con cualquier arma.\n\n• El [color=%status%]Sangrado[/color] inflige [color=%damage%]2[/color] de daño por turno y dura cinco turnos.\n\n• Al adquirir [color=%perk%]Dominio del Arco[/color] también obtienes un [color=%positive%]10%[/color] de daño adicional.\n\n• Con otras armas clasificadas como Arcos, obtienes un porcentaje progresivo de estas bonificaciones, que empieza en el 25% y aumenta un 5% por nivel hasta llegar al 100% en el nivel 15.\n\n• La bonificación se duplica contra Lobos y Hienas.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistGravedigger
    {
        en = "\nYou used to dig up graves, now you're digging graves.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit while using a Shovel.\n\n• When taking [color=%perk%]Mace Mastery[/color] you will also gain [color=%positive%]10%[/color] bonus damage.\n\n• For other weapons classified as Two Handed Mace, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n\n• If you are using a Shovel you will also receive the Knock Out skill.\n\n• While using a Two Handed Mace, you will also receive the Gravedigging effect, which provides bonuses to Initiative, Damage and Resolve based on the amount of corpses on the battlefield.\n"
        es = "\nAntes desenterrabas tumbas; ahora las cavas.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar al usar una Pala.\n\n• Al adquirir [color=%perk%]Dominio de la Maza[/color] también obtienes un [color=%positive%]10%[/color] de daño adicional.\n\n• Con otras armas clasificadas como Mazas a dos manos, obtienes un porcentaje progresivo de estas bonificaciones, que empieza en el 25% y aumenta un 5% por nivel hasta llegar al 100% en el nivel 15.\n\n• Si usas una Pala, también recibes la habilidad Aturdir.\n\n• Al usar una Maza a dos manos, también recibes el efecto Cavando tumbas, que otorga bonificaciones a la Iniciativa, el daño y la Resolución según la cantidad de cadáveres que haya en el campo de batalla.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistWoodsman
    {
        en = "\nTimber!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit while using a Woodcutter's Axe or Handsaw.\n\n• When taking [color=%perk%]Axe Mastery[/color] you will also gain [color=%positive%]10%[/color] bonus damage.\n\n• For non-specialist weapons classified as Two Handed Axes, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n\n• Allows this character to harvest wood while in camp.\n\n• The bonus will be doubled against Schrats.\n"
        es = "\n¡Árbol va!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar al usar un Hacha de leñador o un Serrucho.\n\n• Al adquirir [color=%perk%]Dominio del Hacha[/color] también obtienes un [color=%positive%]10%[/color] de daño adicional.\n\n• Con armas no especializadas clasificadas como Hachas a dos manos, obtienes un porcentaje progresivo de estas bonificaciones, que empieza en el 25% y aumenta un 5% por nivel hasta llegar al 100% en el nivel 15.\n\n• Permite a este personaje recoger madera mientras está en el campamento.\n\n• La bonificación se duplica contra Schrats.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistHerbalist
    {
        en = "\nCall an 'erbalist...But not for me!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit and [color=%positive%]30%[/color] of lowered threshold to inflict injuries as additional damage to hitpoints while using a Sickle.\n\n• When taking [color=%perk%]Sword Mastery[/color] you will also gain [color=%positive%]10%[/color] bonus damage.\n\n• For other weapons classified as One Handed Swords, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n"
        es = "\nLlamen a un herbolario... ¡pero no para mí!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar y un [color=%positive%]30%[/color] de la reducción del umbral para infligir heridas como daño adicional a los Puntos de vida al usar una Hoz.\n\n• Al adquirir [color=%perk%]Dominio de la Espada[/color] también obtienes un [color=%positive%]10%[/color] de daño adicional.\n\n• Con otras armas clasificadas como Espadas a una mano, obtienes un porcentaje progresivo de estas bonificaciones, que empieza en el 25% y aumenta un 5% por nivel hasta llegar al 100% en el nivel 15.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistReaper
    {
        en = "\nPracticing with the unwieldy scythe has taught you how to twist your torso to produce repeatable smooth strokes.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+15[/color] chance to hit while using a Scythe or Warscythe.\n\n• When taking [color=%perk%]Polearm Mastery[/color] or [color=%perk%]Cleaver Mastery[/color] you will also gain [color=%positive%]15%[/color] bonus damage.\n"
        es = "\nPracticar con la aparatosa guadaña te ha enseñado a girar el torso para lograr trazos limpios y repetibles.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes [color=%positive%]+15[/color] a la probabilidad de impactar al usar una Guadaña o una Guadaña de guerra.\n\n• Al adquirir [color=%perk%]Dominio de las Armas de asta[/color] o [color=%perk%]Dominio de la Cuchilla[/color] también obtienes un [color=%positive%]15%[/color] de daño adicional.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistCultist
    {
        en = "\nPractice in the arts of punishment makes the tips of the cattail to inflict horrible injuries with greater accuracy.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit and [color=%positive%]+15%[/color] Chance to hit the head and while using Cat o nine tails.\n\n• When taking [color=%perk%]Flail Mastery[/color] or [color=%positive%]Cleaver Mastery[/color] you will also gain [color=%positive%]10%[/color] bonus damage.\n\n• For other weapons classified as Flails or Whips, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n"
        es = "\nLa práctica en las artes del castigo hace que las puntas del gato inflijan heridas horribles con mayor precisión.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar y [color=%positive%]+15%[/color] a la probabilidad de impactar en la cabeza al usar el Gato de nueve colas.\n\n• Al adquirir [color=%perk%]Dominio del Mayal[/color] o [color=%positive%]Dominio de la Cuchilla[/color] también obtienes un [color=%positive%]10%[/color] de daño adicional.\n\n• Con otras armas clasificadas como Mayales o Látigos, obtienes un porcentaje progresivo de estas bonificaciones, que empieza en el 25% y aumenta un 5% por nivel hasta llegar al 100% en el nivel 15.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistShepherd
    {
        en = "\nSlinger? I hardly knew 'er!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit and [color=%positive%]25%[/color] additional armor damage when using a Sling or Slingshot.\n\n• When taking [color=%perk%]Sling Mastery[/color] you will also gain [color=%positive%]10%[/color] bonus damage.\n\n• For other weapons classified as Slings, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n"
        es = "\n¿Hondero? ¡Es una honda vocación!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar y un [color=%positive%]25%[/color] de daño adicional a la armadura al usar una Honda o un Tirachinas.\n\n• Al adquirir [color=%perk%]Dominio de la Honda[/color] también obtienes un [color=%positive%]10%[/color] de daño adicional.\n\n• Con otras armas clasificadas como Hondas, obtienes un porcentaje progresivo de estas bonificaciones, que empieza en el 25% y aumenta un 5% por nivel hasta llegar al 100% en el nivel 15.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistInventor
    {
        // ::Const.Strings.PerkDescription.LegendSpecialistInventor <- "\nUsing your wits and tools, you've managed to create aids, which help you use unwieldy mechanical weapons with skill and dexterity.\n\n[color=%passive%][u]Specialist Weapon Perk:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit while using a Firearm.\n\n• Reduce AP cost for Handgonne [color=%skill%]Reload[/color] by [color=%negative%]1[/color] and [color=%positive%]10%[/color] bonus damage when taking [color=%perk%]Crossbow Mastery[/color].\n\n• Gain [color=%positive%]+12[/color] chance to hit while using a Firelance.\n\n• When taking [color=%perk%]Spear Mastery[/color] you will also gain [color=%positive%]10%[/color] bonus damage.\n\n• For other weapons classified as Firearms, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n";
        mode = "pattern"
        en = "\nUsing your wits and tools, you've managed to create aids, which help you use unwieldy mechanical weapons with skill and dexterity.\n\n[color=%passive%][u]Specialist Weapon Perk:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit while using a Firearm.\n\n• Reduce AP cost for Handgonne [color=%skill%]Reload[/color] by [color=%negative%]1[/color] and [color=%positive%]10%[/color] bonus damage when taking [color=%perk%]Crossbow Mastery[/color].\n\n• Gain [color=%positive%]+12[/color] chance to hit while using a Firelance.\n\n• When taking [color=%perk%]Spear Mastery[/color] you will also gain [color=%positive%]10%[/color] bonus damage.\n\n• For other weapons classified as Firearms, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n"
        es = "\nCon ingenio y herramientas, has logrado fabricar accesorios que te ayudan a manejar con habilidad y destreza las aparatosas armas mecánicas.\n\n[color=%passive%][u]Ventaja de arma de especialista:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar al usar un arma de fuego.\n\n• Reduce en [color=%negative%]1[/color] el coste en PA de [color=%skill%]Recargar[/color] del Cañón de mano y otorga un [color=%positive%]10%[/color] de daño adicional al adquirir [color=%perk%]Dominio de Ballestas y armas de fuego[/color].\n\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar al usar una Lanza de fuego.\n\n• Al adquirir [color=%perk%]Dominio de la Lanza[/color] también obtienes un [color=%positive%]10%[/color] de daño adicional.\n\n• Con otras armas clasificadas como armas de fuego, obtienes un porcentaje progresivo de estas bonificaciones, que empieza en el 25% y aumenta un 5% por nivel hasta llegar al 100% en el nivel 15.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistBodyguard
    {
        // ::Const.Strings.PerkDescription.LegendSpecialistBodyguard <- "\nEating and sleeping with your blade has turned it into an extension of your arm.\n\n[color=%passive%][u]Specialist Weapon Perk:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit, [color=%positive%]10%[/color] damage for all Melee area of effect attacks and [color=%positive%]20%[/color] damage when [color=%status%]Riposting[/color] when using a Longsword.\n\n• When taking [color=%perk%]Sword Mastery[/color] gain [color=%positive%]10%[/color] damage.\n\n• For other weapons classified as a Two-Handed Sword, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n";
        mode = "pattern"
        en = "\nEating and sleeping with your blade has turned it into an extension of your arm.\n\n[color=%passive%][u]Specialist Weapon Perk:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit, [color=%positive%]10%[/color] damage for all Melee area of effect attacks and [color=%positive%]20%[/color] damage when [color=%status%]Riposting[/color] when using a Longsword.\n\n• When taking [color=%perk%]Sword Mastery[/color] gain [color=%positive%]10%[/color] damage.\n\n• For other weapons classified as a Two-Handed Sword, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n"
        es = "\nComer y dormir con tu espada la ha convertido en una extensión de tu brazo.\n\n[color=%passive%][u]Ventaja de arma de especialista:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar, un [color=%positive%]10%[/color] de daño en todos los ataques cuerpo a cuerpo de área y un [color=%positive%]20%[/color] de daño al estar [color=%status%]Contraatacando[/color] al usar una Espada larga.\n\n• Al adquirir [color=%perk%]Dominio de la Espada[/color] obtienes un [color=%positive%]10%[/color] de daño.\n\n• Con otras armas clasificadas como Espadas a dos manos, obtienes un porcentaje progresivo de estas bonificaciones, que empieza en el 25% y aumenta un 5% por nivel hasta llegar al 100% en el nivel 15.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistInquisition
    {
        en = "\nNobody expects the Inquisition!\n\n[color=%passive%][u]Specialist Weapon Perk:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit while using Hand Crossbow or Spiked Impaler.\n\n• When taking [color=%perk%]Crossbow Mastery[/color] gain [color=%positive%]10%[/color] damage.\n\n• Gain [color=%positive%]+12[/color] chance to hit while using a Wooden Stake.\n\n• For other weapons classified as Crossbows, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n\n• While using Crossbows the bonus will be doubled against Hexe and Alps.\n"
        es = "\n¡Nadie espera a la Inquisición!\n\n[color=%passive%][u]Ventaja de arma de especialista:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar al usar una Ballesta de mano o un Empalador puntiagudo.\n\n• Al adquirir [color=%perk%]Dominio de Ballestas y armas de fuego[/color] obtienes un [color=%positive%]10%[/color] de daño.\n\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar al usar una Estaca de madera.\n\n• Con otras armas clasificadas como Ballestas, obtienes un porcentaje progresivo de estas bonificaciones, que empieza en el 25% y aumenta un 5% por nivel hasta llegar al 100% en el nivel 15.\n\n• Al usar Ballestas, la bonificación se duplica contra Hexe y Alps.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistClub
    {
        en = "\nMastering the art of leaning against a wall with a big stick has it's benefits.\n\n[color=%passive%][u]Specialist Weapon Perk:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit and [color=%positive%]+5[/color] fatigue per hit while using a Wooden Stick or Bludgeon.\n\n• When taking [color=%perk%]Mace Mastery[/color] gain [color=%positive%]10%[/color] damage.\n\n• For other weapons classified as One-Handed Mace, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n"
        es = "\nDominar el arte de apoyarse en una pared con un palo bien grande tiene sus ventajas.\n\n[color=%passive%][u]Ventaja de arma de especialista:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar y [color=%positive%]+5[/color] de fatiga por impacto al usar un Garrote de madera o una Maza barreteada.\n\n• Al adquirir [color=%perk%]Dominio de la Maza[/color] obtienes un [color=%positive%]10%[/color] de daño.\n\n• Con otras armas clasificadas como Mazas a una mano, obtienes un porcentaje progresivo de estas bonificaciones, que empieza en el 25% y aumenta un 5% por nivel hasta llegar al 100% en el nivel 15.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistSelfdefense
    {
        en = "\nTwist and thrust with your staff to deflect blows and intercept strikes.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+16[/color] Melee Skill and [color=%positive%]+16[/color] Defense while wielding a staff or a magic staff.\n\n• When wielding slingstaves, musical instruments and other hybrid staves the bonus is only [color=%positive%]+8[/color].\n"
        es = "\nGira y empuja con tu bastón para desviar golpes e interceptar ataques.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes [color=%positive%]+16[/color] a la Habilidad cuerpo a cuerpo y [color=%positive%]+16[/color] a la Defensa al empuñar un bastón o un bastón mágico.\n\n• Al empuñar fustíbalos, instrumentos musicales y otros bastones híbridos, la bonificación es solo de [color=%positive%]+8[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistRaider
    {
        en = "\nAn axe to the back of the head solves many issues, you even get to keep the loot!\n\n[color=%passive%][u]Specialist Weapon Perk:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit while using a Crude Axe or Throwing Axe.\n\n• When taking [color=%perk%]Axe Mastery[/color] or [color=%perk%]Throwing Mastery[/color] gain [color=%positive%]10%[/color] damage.\n\n• For other weapons classified as One-Handed Axes, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n"
        es = "\nUn hachazo en la nuca resuelve muchos problemas, ¡y encima te quedas con el botín!\n\n[color=%passive%][u]Ventaja de arma de especialista:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar al usar un Hacha tosca o un Hacha arrojadiza.\n\n• Al adquirir [color=%perk%]Dominio del Hacha[/color] o [color=%perk%]Dominio de Armas arrojadizas[/color] obtienes un [color=%positive%]10%[/color] de daño.\n\n• Con otras armas clasificadas como Hachas a una mano, obtienes un porcentaje progresivo de estas bonificaciones, que empieza en el 25% y aumenta un 5% por nivel hasta llegar al 100% en el nivel 15.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistSpearfisher
    {
        // ::Const.Strings.PerkDescription.LegendSpecialistSpearfisher <- "\nThrowing a spear and throwing a net is just muscle memory at this point.\n\n[color=%passive%][u]Specialist Weapon Perk:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit while using a Javelin.\n\n• When taking [color=%perk%]Throwing Specialization[/color] gain [color=%positive%]10%[/color] damage.\n\n• Each time you use a throwing weapon, you can use [color=%skill%]Throw Net[/color] for free.\n\n• For other weapons classified as Throwing, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n";
        mode = "pattern"
        en = "\nThrowing a spear and throwing a net is just muscle memory at this point.\n\n[color=%passive%][u]Specialist Weapon Perk:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit while using a Javelin.\n\n• When taking [color=%perk%]Throwing Specialization[/color] gain [color=%positive%]10%[/color] damage.\n\n• Each time you use a throwing weapon, you can use [color=%skill%]Throw Net[/color] for free.\n\n• For other weapons classified as Throwing, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n"
        es = "\nA estas alturas, lanzar una lanza y lanzar una red es pura memoria muscular.\n\n[color=%passive%][u]Ventaja de arma de especialista:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar al usar una Jabalina.\n\n• Al adquirir [color=%perk%]Dominio de Armas arrojadizas[/color] obtienes un [color=%positive%]10%[/color] de daño.\n\n• Cada vez que usas un arma arrojadiza, puedes usar [color=%skill%]Lanzar red[/color] gratis.\n\n• Con otras armas clasificadas como Armas arrojadizas, obtienes un porcentaje progresivo de estas bonificaciones, que empieza en el 25% y aumenta un 5% por nivel hasta llegar al 100% en el nivel 15.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistSharpshooter
    {
        en = "\nThread the needle from this distance? No sweat.\n\n[color=%passive%][u]Specialist Weapon Perk:[/u][/color]\n• Gain [color=%positive%]+12[/color] chance to hit and [color=%positive%]1[/color] additional range while using a Warbow.\n\n• When taking [color=%perk%]Bow Mastery[/color] gain [color=%positive%]10%[/color] damage.\n\n• For other weapons classified as Longbows, you can get a scaling percentage of these bonuses, starting from 25% and increasing gradually to 100% by 5% for each level with the maximum bonus gained at level 15.\n\n• The additional range gained is still subject to vision penalties.\n"
        es = "\n¿Enhebrar la aguja desde esta distancia? Pan comido.\n\n[color=%passive%][u]Ventaja de arma de especialista:[/u][/color]\n• Obtienes [color=%positive%]+12[/color] a la probabilidad de impactar y [color=%positive%]1[/color] de alcance adicional al usar un Arco de guerra.\n\n• Al adquirir [color=%perk%]Dominio del Arco[/color] obtienes un [color=%positive%]10%[/color] de daño.\n\n• Con otras armas clasificadas como Arcos largos, obtienes un porcentaje progresivo de estas bonificaciones, que empieza en el 25% y aumenta un 5% por nivel hasta llegar al 100% en el nivel 15.\n\n• El alcance adicional sigue sujeto a las penalizaciones de visión.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBigGameHunter
    {
        en = "\nThe bigger they are...\n\n[color=%passive%][u]Passive:[/u][/color]\n• When fighting beasts, gain an additional modifier that deals bonus damage based on the percentage of the target's missing Hitpoints. The more Hitpoints the target has lost, the more bonus damage is dealt, up to the total damage of the attack.\n\n• When not fighting beasts, gain [color=%positive%]+10%[/color] ranged weapon damage but no additional modifier.\n\n• Only works with ranged weapons.\n"
        es = "\nCuanto más grandes son...\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Al luchar contra bestias, obtienes un modificador adicional que inflige daño extra según el porcentaje de Puntos de vida que le falten al objetivo. Cuantos más Puntos de vida haya perdido el objetivo, más daño extra se inflige, hasta el daño total del ataque.\n\n• Si no luchas contra bestias, obtienes [color=%positive%]+10%[/color] de daño con armas a distancia, pero no el modificador adicional.\n\n• Solo funciona con armas a distancia.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSecondWind
    {
        // ::Const.Strings.PerkDescription.LegendSecondWind <- "\nEven the fiercest battles can't keep you down.\n\n[color=%passive%][u]Passive:[/u][/color]\n• When falling below [color=%negative%]50%[/color] Hitpoints for the first time in each combat, fully refresh your Fatigue, and grant [color=%positive%]+5[/color] Fatigue Recovery for 3 turns.\n\n• Additionally, remove any [color=%status%]Stun[/color], [color=%status%]Daze[/color], [color=%status%]Stagger[/color], [color=%status%]Baffle[/color], [color=%status%]Charmed[/color] or [color=%status%]Sleeping[/color] status.\n\n• Only occurs once per combat.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Second Wind[/color] skill with the same effects as the passive.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]0[/color] Fatigue. Can only be used once per combat when accumulated fatigue is more than 50% of maximum. If the passive effect activates the active can't be used.\n";
        mode = "pattern"
        en = "\nEven the fiercest battles can't keep you down.\n\n[color=%passive%][u]Passive:[/u][/color]\n• When falling below [color=%negative%]50%[/color] Hitpoints for the first time in each combat, fully refresh your Fatigue, and grant [color=%positive%]+5[/color] Fatigue Recovery for 3 turns.\n\n• Additionally, remove any [color=%status%]Stun[/color], [color=%status%]Daze[/color], [color=%status%]Stagger[/color], [color=%status%]Baffle[/color], [color=%status%]Charmed[/color] or [color=%status%]Sleeping[/color] status.\n\n• Only occurs once per combat.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Second Wind[/color] skill with the same effects as the passive.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]0[/color] Fatigue. Can only be used once per combat when accumulated fatigue is more than 50% of maximum. If the passive effect activates the active can't be used.\n"
        es = "\nNi las batallas más feroces pueden contigo.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• La primera vez en cada combate que bajes del [color=%negative%]50%[/color] de los Puntos de vida, recuperas por completo la Fatiga y obtienes [color=%positive%]+5[/color] a la recuperación de Fatiga durante 3 turnos.\n\n• Además, elimina cualquier estado de [color=%status%]Aturdido[/color], [color=%status%]Atontado[/color], [color=%status%]Tambaleante[/color], [color=%status%]Desconcertado[/color], [color=%status%]Encantado[/color] o [color=%status%]Durmiendo[/color].\n\n• Solo ocurre una vez por combate.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Segundo aliento[/color], con los mismos efectos que la pasiva.\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]0[/color] de Fatiga. Solo se puede usar una vez por combate, cuando la fatiga acumulada supera el 50% del máximo. Si se activa el efecto pasivo, no se puede usar la activa.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMarkTarget
    {
        // ::Const.Strings.PerkDescription.LegendMarkTarget <- "\n'The ugly one, right there! Take him out!'\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Mark Target[/color] skill which marks any target within nine tiles and reduces their Melee and Ranged Defenses by [color=%negative%]-10[/color] for three turns.\n\n• Provides increased damage against the target up to 20%.\n\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]10[/color] Fatigue.\n";
        mode = "pattern"
        en = "\n'The ugly one, right there! Take him out!'\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Mark Target[/color] skill which marks any target within nine tiles and reduces their Melee and Ranged Defenses by [color=%negative%]-10[/color] for three turns.\n\n• Provides increased damage against the target up to 20%.\n\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]10[/color] Fatigue.\n"
        es = "\n'¡El feo, ese de ahí! ¡Acaben con él!'\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Marcar objetivo[/color], que marca a cualquier objetivo a nueve casillas o menos y reduce su Defensa cuerpo a cuerpo y su Defensa a distancia en [color=%negative%]-10[/color] durante tres turnos.\n\n• Otorga hasta un 20% más de daño contra el objetivo.\n\n• Cuesta [color=%negative%]2[/color] PA y [color=%negative%]10[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendFieldTriage
    {
        // ::Const.Strings.PerkDescription.LegendFieldTriage <- "\nSpend medicine to heal a unit on the battlefield.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Field Triage[/color] skill which heals any adjacent ally by up to [color=%positive%]20[/color] Hitpoints.\n\n• Uses [color=%negative%]1[/color] medicine per [color=%positive%]2[/color] Hitpoints healed.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]16[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nSpend medicine to heal a unit on the battlefield.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Field Triage[/color] skill which heals any adjacent ally by up to [color=%positive%]20[/color] Hitpoints.\n\n• Uses [color=%negative%]1[/color] medicine per [color=%positive%]2[/color] Hitpoints healed.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]16[/color] Fatigue.\n"
        es = "\nGasta medicina para curar a una unidad en el campo de batalla.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Triaje de campaña[/color], que cura hasta [color=%positive%]20[/color] Puntos de vida a cualquier aliado adyacente.\n\n• Usa [color=%negative%]1[/color] de medicina por cada [color=%positive%]2[/color] Puntos de vida curados.\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]16[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendFieldRepairs
    {
        // ::Const.Strings.PerkDescription.LegendFieldRepairs <- "\nSpend armor parts to repair armor on the battlefield.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Field Repairs[/color] skill which repairs up to [color=%positive%]20[/color] armor durability for any adjacent ally.\n\n• Uses [color=%negative%]1[/color] tool per [color=%positive%]5[/color] durability repaired.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]16[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nSpend armor parts to repair armor on the battlefield.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Field Repairs[/color] skill which repairs up to [color=%positive%]20[/color] armor durability for any adjacent ally.\n\n• Uses [color=%negative%]1[/color] tool per [color=%positive%]5[/color] durability repaired.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]16[/color] Fatigue.\n"
        es = "\nGasta piezas de armadura para reparar armaduras en el campo de batalla.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Reparaciones de campaña[/color], que repara hasta [color=%positive%]20[/color] de durabilidad de la armadura de cualquier aliado adyacente.\n\n• Usa [color=%negative%]1[/color] de herramientas por cada [color=%positive%]5[/color] de durabilidad reparada.\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]16[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendDangerPay
    {
        // ::Const.Strings.PerkDescription.LegendDangerPay <- "\nEvery person has their price.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Danger Pay[/color] skill which allows you to target any ally that is paid a wage within three tiles and Spend [color=%positive%]10[/color] times the unit's daily wage to set them at [color=%status%]Confident[/color] morale.\n\n• Upon receiving extra payment, the recipient becomes [color=%status%]Motivated[/color] for three turns.\n\n• [color=%status%]Motivated[/color] grants [color=%positive%]10%[/color] more damage, [color=%positive%]5%[/color] more Ranged and Melee Skill, and [color=%positive%]15%[/color] more Resolve.\n\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]4[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nEvery person has their price.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Danger Pay[/color] skill which allows you to target any ally that is paid a wage within three tiles and Spend [color=%positive%]10[/color] times the unit's daily wage to set them at [color=%status%]Confident[/color] morale.\n\n• Upon receiving extra payment, the recipient becomes [color=%status%]Motivated[/color] for three turns.\n\n• [color=%status%]Motivated[/color] grants [color=%positive%]10%[/color] more damage, [color=%positive%]5%[/color] more Ranged and Melee Skill, and [color=%positive%]15%[/color] more Resolve.\n\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]4[/color] Fatigue.\n"
        es = "\nTodo el mundo tiene un precio.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Paga de riesgo[/color], que te permite elegir como objetivo a cualquier aliado asalariado a tres casillas o menos y gastar [color=%positive%]10[/color] veces su paga diaria para poner su moral en [color=%status%]Confiado[/color].\n\n• Al recibir el pago extra, quien lo recibe obtiene el estado [color=%status%]Motivado[/color] durante tres turnos.\n\n• [color=%status%]Motivado[/color] otorga un [color=%positive%]10%[/color] más de daño, un [color=%positive%]5%[/color] más de Habilidad a distancia y de Habilidad cuerpo a cuerpo, y un [color=%positive%]15%[/color] más de Resolución.\n\n• Cuesta [color=%negative%]2[/color] PA y [color=%negative%]4[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPreparedForAnything
    {
        en = "\nInstruct your mercenaries how to secret additional supplies about their person during battle.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants the 'Bags and Belts' perk to anyone you fight with.\n"
        es = "\nEnseña a tus mercenarios a esconder suministros adicionales encima durante la batalla.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga la ventaja 'Bolsas y bolsillos' a todos los que luchen contigo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBrinkOfDeath
    {
        en = "\nUse your knowledge of undeath to bring your mercenaries back from the dead.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gives 66% chance for ally to come back as undead\n"
        es = "\nUsa tu conocimiento de la no muerte para devolver a tus mercenarios de entre los muertos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Da un 66% de probabilidad de que los aliados caídos regresen como no muertos\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendStrictSermons
    {
        en = "\nEndlessly repeating the lessons of the old gods to your mercenaries will imbue them with faith in the heat of battle.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants the 'Fortified Mind' perk to anyone you fight with.\n"
        es = "\nRepetir sin cesar a tus mercenarios las enseñanzas de los viejos dioses los imbuirá de fe en el fragor de la batalla.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga la ventaja 'Mentalidad fuerte' a todos los que luchen contigo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendInfectiousRage
    {
        en = "\nThe frenzy of the berserker rage is aided with clouds of herbs and ritual dances. These can be spread to your allies.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants the 'Berserk' perk to anyone you fight with.\n"
        es = "\nEl frenesí de la furia berserker se alimenta de nubes de hierbas y danzas rituales, que pueden contagiarse a tus aliados.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga la ventaja 'Berserker' a todos los que luchen contigo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendTeacher
    {
        en = "\nThe techniques you have mastered are inspirational and inspire curiosity in those who behold.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants the 'Student' perk to anyone you fight with.\n"
        es = "\nLas técnicas que dominas son inspiradoras y despiertan la curiosidad de quienes las contemplan.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga la ventaja 'Estudiante' a todos los que luchen contigo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendResurrectionist
    {
        en = "\nThis character's experience with corpses gives an additional chance to retrieve each human body or skeleton from the battlefield.\n\n[color=%passive%][u]Passive:[/u][/color]\n• If you are already collecting them, increases the chance by [color=%positive%]5%[/color].\n"
        es = "\nLa experiencia de este personaje con los cadáveres da una probabilidad adicional de recuperar cada cuerpo humano o esqueleto del campo de batalla.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Si ya los estás recogiendo, aumenta la probabilidad en un [color=%positive%]5%[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendScry
    {
        // ::Const.Strings.PerkDescription.LegendScry <- "\nUse your extraordinary senses to notice things no one else can.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Scry[/color] skill which reveals everything within twelve tiles.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]15[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nUse your extraordinary senses to notice things no one else can.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Scry[/color] skill which reveals everything within twelve tiles.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\nUsa tus sentidos extraordinarios para percibir lo que nadie más puede.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Escrutar[/color], que revela todo lo que hay a doce casillas o menos.\n\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendLevitate
    {
        en = "\nLevitate a person above the ground, making movement across any terrain cost less.\n\n[color=%active%][u]Active:[/u][/color]\n• Movement across any terrain cost [color=%negative%]1[/color] AP and [color=%negative%]2[/color] Fatigue per tile.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = "\nHaz levitar a una persona sobre el suelo, lo que abarata el movimiento por cualquier terreno.\n\n[color=%active%][u]Activo:[/u][/color]\n• Moverse por cualquier terreno cuesta [color=%positive%]1[/color] PA y [color=%positive%]2[/color] de Fatiga por casilla.\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]20[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendTeleport
    {
        // ::Const.Strings.PerkDescription.LegendTeleport <- "\nStep through the world, disappearing from one place and reappearing in another place immediately.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Teleport[/color] skill which allows you to teleport up to eight tiles.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]40[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nStep through the world, disappearing from one place and reappearing in another place immediately.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Teleport[/color] skill which allows you to teleport up to eight tiles.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]40[/color] Fatigue.\n"
        es = "\nAtraviesa el mundo: desaparece de un lugar y reaparece al instante en otro.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Teletransporte[/color], que te permite teletransportarte hasta ocho casillas.\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]40[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistShieldSkill
    {
        // ::Const.Strings.PerkDescription.LegendSpecialistShieldSkill <- "\nLearn to keep your shield up.\n\n[color=%passive%][u]Passive:[/u][/color]\n• The first two times you end a turn without [color=%skill%]Shieldwall[/color] activated, gain [color=%skill%]Shieldwall[/color].\n\n• Gain [color=%positive%]10%[/color] damage reduction while using a shield.\n";
        mode = "pattern"
        en = "\nLearn to keep your shield up.\n\n[color=%passive%][u]Passive:[/u][/color]\n• The first two times you end a turn without [color=%skill%]Shieldwall[/color] activated, gain [color=%skill%]Shieldwall[/color].\n\n• Gain [color=%positive%]10%[/color] damage reduction while using a shield.\n"
        es = "\nAprende a mantener el escudo en alto.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Las dos primeras veces que termines un turno sin [color=%skill%]Muro de escudos[/color] activado, obtienes [color=%skill%]Muro de escudos[/color].\n\n• Obtienes un [color=%positive%]10%[/color] de reducción de daño al usar un escudo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecialistShieldPush
    {
        // ::Const.Strings.PerkDescription.LegendSpecialistShieldPush <- "\nLearn to use your shield without wasted movement.\n\n[color=%passive%][u]Passive:[/u][/color]\n• The [color=%skill%]Knock Back[/color] skill costs [color=%positive%]25%[/color] less Fatigue and Action Points.\n";
        mode = "pattern"
        en = "\nLearn to use your shield without wasted movement.\n\n[color=%passive%][u]Passive:[/u][/color]\n• The [color=%skill%]Knock Back[/color] skill costs [color=%positive%]25%[/color] less Fatigue and Action Points.\n"
        es = "\nAprende a usar el escudo sin malgastar movimientos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• La habilidad [color=%skill%]Golpe de escudo[/color] cuesta un [color=%positive%]25%[/color] menos de Fatiga y de Puntos de acción.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMasteryNets
    {
        en = "\nMaster the ability to ensnare others and to disentangle yourself.\n\n[color=%passive%][u]Passive:[/u][/color]\n• When throwing nets reduce Fatigue cost by [color=%negative%]25%[/color] and AP cost to [color=%negative%]3[/color].\n\n• When freeing yourself or allies gain a baseline [color=%positive%]99%[/color] chance to succeed in removing rooting effects, such as nets, vines, webs, and ensnarement by some beasts.\n\n• Reduces Fatigue cost of freeing yourself or allies by [color=%negative%]66%[/color] and AP cost to [color=%negative%]3[/color].\n\n• Can now double grip with a net in your offhand and unlocks Hand to Hand abilities that might be locked from holding a net in offhand.\n"
        es = "\nDomina la técnica de atrapar a otros y de desenredarte.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Al lanzar redes, reduce el coste de Fatiga en un [color=%positive%]25%[/color] y el coste en PA a [color=%positive%]3[/color].\n\n• Al liberarte a ti o a tus aliados, obtienes una probabilidad base del [color=%positive%]99%[/color] de eliminar efectos de inmovilización, como redes, enredaderas, telarañas y las trampas de algunas bestias.\n\n• Reduce en un [color=%positive%]66%[/color] el coste de Fatiga de liberarte a ti o a tus aliados, y el coste en PA a [color=%positive%]3[/color].\n\n• Ahora puedes usar el doble agarre con una red en la mano secundaria, y se desbloquean las habilidades de Mano a mano que llevar una red en la mano secundaria podría bloquear.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMasterySlings
    {
        // ::Const.Strings.PerkDescription.LegendMasterySlings <- "\nMaster the difficult angles and timings of slinging rocks from afar.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Fatigue cost for Sling skills is reduced by [color=%negative%]25%[/color].\n\n• Accuracy with slings and slingshots is increased by [color=%positive%]+10%[/color], accuracy with Staff Slings is increased by [color=%positive%]+5%[/color] and maximum firing range with slings and slingshots is increased by [color=%positive%]+1[/color].\n\n• When using One Handed slings, waiting during your turn or using [color=%skill%]Wind Up[/color] will add the [color=%skill%]Prepare Bullet[/color] effect, which will increase damage by [color=%positive%]10%[/color] of your Initiative and the Range of attacks by [color=%positive%]+1[/color]\n\n• Additionally allows you to launch bombs and flasks with a Staff Sling.\n";
        mode = "pattern"
        en = "\nMaster the difficult angles and timings of slinging rocks from afar.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Fatigue cost for Sling skills is reduced by [color=%negative%]25%[/color].\n\n• Accuracy with slings and slingshots is increased by [color=%positive%]+10%[/color], accuracy with Staff Slings is increased by [color=%positive%]+5%[/color] and maximum firing range with slings and slingshots is increased by [color=%positive%]+1[/color].\n\n• When using One Handed slings, waiting during your turn or using [color=%skill%]Wind Up[/color] will add the [color=%skill%]Prepare Bullet[/color] effect, which will increase damage by [color=%positive%]10%[/color] of your Initiative and the Range of attacks by [color=%positive%]+1[/color]\n\n• Additionally allows you to launch bombs and flasks with a Staff Sling.\n"
        es = "\nDomina los difíciles ángulos y tiempos de lanzar piedras desde lejos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• El coste de Fatiga de las habilidades de Honda se reduce en un [color=%negative%]25%[/color].\n\n• La precisión con hondas y tirachinas aumenta en [color=%positive%]+10%[/color], la precisión con Fustíbalos aumenta en [color=%positive%]+5%[/color] y el alcance máximo de disparo con hondas y tirachinas aumenta en [color=%positive%]+1[/color].\n\n• Al usar hondas a una mano, esperar durante tu turno o usar [color=%skill%]Tomar impulso[/color] añade el efecto [color=%skill%]Preparar disparo[/color], que aumenta el daño en un [color=%positive%]10%[/color] de tu Iniciativa y el alcance de los ataques en [color=%positive%]+1[/color]\n\n• Además, permite lanzar bombas y frascos con un Fustíbalo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendFavouredEnemyBeast
    {
        en = "\nEnforce your position at the top of the food chain.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants bonuses to Melee Skill, Ranged Skill and maximum damage while fighting Beasts. This bonus increases with every Beast kill made by this character.\n\n• Increase per kill:\n  - Nachzehrers | [color=%positive%]+0.16%[/color]\n  - Skin Ghoul | [color=%positive%]+0.5%[/color]\n  - Unhold (all types) | [color=%positive%]+0.5%[/color]\n  - Rock Unhold | [color=%positive%]+2%[/color]\n  - Lindwurm | [color=%positive%]+1%[/color]\n  - Serpent | [color=%positive%]+0.5%[/color]\n  - Stollwurm | [color=%positive%]+2.5%[/color]\n  - Direwolf | [color=%positive%]+0.2%[/color]\n  - White Direwolf | [color=%positive%]+0.5%[/color]\n  - Hyena | [color=%positive%]+0.2%[/color]\n  - Enraged Hyena | [color=%positive%]+0.5%[/color]\n  - Webknecht | [color=%positive%]+0.125%[/color]\n  - Spider Eggs | [color=%positive%]+0.5%[/color]\n  - Redback | [color=%positive%]+1%[/color]\n\n• At 15% or more increases the likelihood of receiving extremely difficult legendary contracts to hunt the following legendary Beasts: Redback Spiders, Rock Unholds, Skin Ghouls, Stollwurms and White Direwolfs.\n"
        es = "\nReafirma tu lugar en la cima de la cadena alimentaria.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga bonificaciones a la Habilidad cuerpo a cuerpo, la Habilidad a distancia y el daño máximo al luchar contra Bestias. La bonificación aumenta con cada Bestia que mate este personaje.\n\n• Aumento por muerte:\n  - Nachzehrers | [color=%positive%]+0.16%[/color]\n  - Necrófago desollado | [color=%positive%]+0.5%[/color]\n  - Trol (todos los tipos) | [color=%positive%]+0.5%[/color]\n  - Trol de roca | [color=%positive%]+2%[/color]\n  - Lindwurm | [color=%positive%]+1%[/color]\n  - Serpiente | [color=%positive%]+0.5%[/color]\n  - Stollwurm | [color=%positive%]+2.5%[/color]\n  - Lobo huargo | [color=%positive%]+0.2%[/color]\n  - Lobo huargo blanco | [color=%positive%]+0.5%[/color]\n  - Hiena | [color=%positive%]+0.2%[/color]\n  - Hiena enfurecida | [color=%positive%]+0.5%[/color]\n  - Webknecht | [color=%positive%]+0.125%[/color]\n  - Huevos de araña | [color=%positive%]+0.5%[/color]\n  - Araña de lomo rojo | [color=%positive%]+1%[/color]\n\n• Con un 15% o más, aumenta la probabilidad de recibir contratos legendarios extremadamente difíciles para cazar a las siguientes Bestias legendarias: Arañas de lomo rojo, Troles de roca, Necrófagos desollados, Stollwurms y Lobos huargos blancos.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendFavouredEnemyOccult
    {
        en = "\nA skeptical mindset cuts through the tricks of the occult, leaving only brittle shapes to steel.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants bonuses to Melee Skill, Ranged Skill, maximum damage and Resolve while fighting the Occult. This bonus increases with every Occult kill made by this character.\n\n• Increase per kill:\n  - Alp | [color=%positive%]+0.25%[/color]\n  - Demon Alp | [color=%positive%]+1%[/color]\n  - Hexe | [color=%positive%]+0.5%[/color]\n  - Coven Leader | [color=%positive%]+2%[/color]\n  - Geist | [color=%positive%]+0.125%[/color]\n  - Höllenhound | [color=%positive%]+0.125%[/color]\n  - Winselmutter | [color=%positive%]+0.25%[/color]\n  - Schrat | [color=%positive%]+1%[/color]\n  - Sapling | [color=%positive%]+0.2%[/color]\n  - Ifrit | [color=%positive%]+0.125%[/color]\n  - Greenwood Schrat | [color=%positive%]+1%[/color]\n  - Greenwood Sapling | [color=%positive%]+0.4%[/color]\n\n• At 15% or more increases the likelihood of receiving extremely difficult legendary contracts to hunt the following Occult leaders: Demon Alps, Greenwood Schrats and Hexe Coven Leaders.\n"
        es = "\nUna mente escéptica atraviesa los trucos del Ocultismo y solo deja formas frágiles para el acero.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga bonificaciones a la Habilidad cuerpo a cuerpo, la Habilidad a distancia, el daño máximo y la Resolución al luchar contra el Ocultismo. La bonificación aumenta con cada criatura del Ocultismo que mate este personaje.\n\n• Aumento por muerte:\n  - Alp | [color=%positive%]+0.25%[/color]\n  - Alp demoníaco | [color=%positive%]+1%[/color]\n  - Hexe | [color=%positive%]+0.5%[/color]\n  - Líder del aquelarre | [color=%positive%]+2%[/color]\n  - Geist | [color=%positive%]+0.125%[/color]\n  - Höllenhound | [color=%positive%]+0.125%[/color]\n  - Winselmutter | [color=%positive%]+0.25%[/color]\n  - Schrat | [color=%positive%]+1%[/color]\n  - Árbol joven | [color=%positive%]+0.2%[/color]\n  - Ifrit | [color=%positive%]+0.125%[/color]\n  - Schrat del bosque verde | [color=%positive%]+1%[/color]\n  - Árbol joven del bosque verde | [color=%positive%]+0.4%[/color]\n\n• Con un 15% o más, aumenta la probabilidad de recibir contratos legendarios extremadamente difíciles para cazar a los siguientes líderes del Ocultismo: Alps demoníacos, Schrats del bosque verde y Líderes del aquelarre de Hexen.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendFavouredEnemyGreenskin
    {
        en = "\nBig or small, greenskins lack the strength of will.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants bonuses to Melee Skill, Ranged Skill, maximum damage while fighting Greenskins. This bonus increases with every Greenskin kill made by this character.\n\n• Increase per kill:\n  - Orc Young | [color=%positive%]+0.125%[/color]\n  - Orc Berserker | [color=%positive%]+0.2%[/color]\n  - Orc Warrior | [color=%positive%]+0.2%[/color]\n  - Orc Elite | [color=%positive%]+0.25%[/color]\n  - Orc Behemoth | [color=%positive%]+0.5%[/color]\n  - Orc Warlord | [color=%positive%]+1%[/color]\n  - Goblin Ambusher | [color=%positive%]+0.125%[/color]\n  - Goblin Fighter | [color=%positive%]+0.125%[/color]\n  - Goblin Wolfrider | [color=%positive%]+0.2%[/color]\n  - Goblin Shaman | [color=%positive%]+0.25%[/color]\n  - Goblin Overseer | [color=%positive%]+0.25%[/color]\n\n• Increases the likelihood of encountering Greenskin champions.\n"
        es = "\nGrandes o pequeños, a los pieles verdes les falta fuerza de voluntad.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga bonificaciones a la Habilidad cuerpo a cuerpo, la Habilidad a distancia y el daño máximo al luchar contra Pieles verdes. La bonificación aumenta con cada Piel verde que mate este personaje.\n\n• Aumento por muerte:\n  - Orco joven | [color=%positive%]+0.125%[/color]\n  - Berserker orco | [color=%positive%]+0.2%[/color]\n  - Guerrero orco | [color=%positive%]+0.2%[/color]\n  - Orco de élite | [color=%positive%]+0.25%[/color]\n  - Behemot orco | [color=%positive%]+0.5%[/color]\n  - Señor de la guerra orco | [color=%positive%]+1%[/color]\n  - Emboscador goblin | [color=%positive%]+0.125%[/color]\n  - Escaramuzador goblin | [color=%positive%]+0.125%[/color]\n  - Jinete lobo goblin | [color=%positive%]+0.2%[/color]\n  - Chamán goblin | [color=%positive%]+0.25%[/color]\n  - Capataz goblin | [color=%positive%]+0.25%[/color]\n\n• Aumenta la probabilidad de encontrar campeones de los Pieles verdes.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendFavouredEnemyUndead
    {
        en = "\nShambling corpses come wave on wave, rising sleepless from their graves.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants bonuses to Melee Skill, Ranged Skill, maximum damage and Resolve while fighting the Undead. This bonus increases with every Undead kill made by this character.\n\n• Increase per kill:\n  - Wiederganger | [color=%positive%]+0.01%[/color]\n  - Wiederganger Yeoman | [color=%positive%]+0.1%[/color]\n  - Fallen Hero | [color=%positive%]+0.2%[/color]\n  - Necromancer | [color=%positive%]+0.25%[/color]\n  - Ancient Auxiliary | [color=%positive%]+0.01%[/color]\n  - Ancient Legionary | [color=%positive%]+0.2%[/color]\n  - Honor Guard | [color=%positive%]+0.5%[/color]\n  - Ancient Priest | [color=%positive%]+0.5%[/color]\n  - Phylactery | [color=%positive%]+1%[/color]\n  - Ancient Gladiator | [color=%positive%]+0.5%[/color]\n  - Flying Skull | [color=%positive%]+0.04%[/color]\n  - Necrosavant | [color=%positive%]+0.25%[/color]\n  - Necrosavant Lord | [color=%positive%]+0.5%[/color]\n  - Höllenhound | [color=%positive%]+0.125%[/color]\n  - Embalmed Slave | [color=%positive%]+0.25%[/color]\n  - Embalmed Soldier | [color=%positive%]+0.5%[/color]\n  - Embalmed Noble | [color=%positive%]+1%[/color]\n  - Embalmed Priest | [color=%positive%]+1.25%[/color]\n  - Embalmed Queen | [color=%positive%]+2%[/color]\n\n• Increases the likelihood of encountering Undead champions.\n"
        es = "\nLos cadáveres tambaleantes llegan en oleadas, alzándose insomnes de sus tumbas.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga bonificaciones a la Habilidad cuerpo a cuerpo, la Habilidad a distancia, el daño máximo y la Resolución al luchar contra los No muertos. La bonificación aumenta con cada No muerto que mate este personaje.\n\n• Aumento por muerte:\n  - Wiederganger | [color=%positive%]+0.01%[/color]\n  - Wiederganger campesino | [color=%positive%]+0.1%[/color]\n  - Héroe caído | [color=%positive%]+0.2%[/color]\n  - Nigromante | [color=%positive%]+0.25%[/color]\n  - Soldado auxiliar ancestral | [color=%positive%]+0.01%[/color]\n  - Legionario ancestral | [color=%positive%]+0.2%[/color]\n  - Guardia de honor | [color=%positive%]+0.5%[/color]\n  - Sacerdote ancestral | [color=%positive%]+0.5%[/color]\n  - Filacteria | [color=%positive%]+1%[/color]\n  - Gladiador ancestral | [color=%positive%]+0.5%[/color]\n  - Calavera voladora | [color=%positive%]+0.04%[/color]\n  - Necrosavante | [color=%positive%]+0.25%[/color]\n  - Señor necrosavante | [color=%positive%]+0.5%[/color]\n  - Höllenhound | [color=%positive%]+0.125%[/color]\n  - Esclavo embalsamado | [color=%positive%]+0.25%[/color]\n  - Soldado embalsamado | [color=%positive%]+0.5%[/color]\n  - Noble embalsamado | [color=%positive%]+1%[/color]\n  - Sacerdote embalsamado | [color=%positive%]+1.25%[/color]\n  - Reina embalsamada | [color=%positive%]+2%[/color]\n\n• Aumenta la probabilidad de encontrar campeones No muertos.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendFavouredEnemyCivilization
    {
        en = "\nWe live in a society.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants bonuses to Melee Skill, Ranged Skill and maximum damage while fighting law-abiding citizens. This bonus increases with every Lawful kill made by this character.\n\n• Increase per kill:\n  - Footman | [color=%positive%]+0.125%[/color]\n  - Zweihander | [color=%positive%]+0.25%[/color]\n  - Billman | [color=%positive%]+0.125%[/color]\n  - Arbalester | [color=%positive%]+0.125%[/color]\n  - Standard Bearer | [color=%positive%]+0.5%[/color]\n  - Sergeant | [color=%positive%]+0.5%[/color]\n  - Fencer | [color=%positive%]+0.25%[/color]\n  - Halberdier | [color=%positive%]+0.25%[/color]\n  - Slinger | [color=%positive%]+0.125%[/color]\n  - Knight | [color=%positive%]+1%[/color]\n  - Elite Footman | [color=%positive%]+0.125%[/color]\n  - Pollaxe | [color=%positive%]+0.125%[/color]\n  - Sureshot | [color=%positive%]+0.125%[/color]\n\n• Increases the likelihood of encountering Lawful champions.\n\n• [color=%positive%]5%[/color] chance to get any items from slain enemies, that otherwise might not be available to loot. Stacks with itself and effects of a similar nature.\n"
        es = "\nVivimos en una sociedad.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga bonificaciones a la Habilidad cuerpo a cuerpo, la Habilidad a distancia y el daño máximo al luchar contra ciudadanos respetuosos de la ley. La bonificación aumenta con cada enemigo Legal que mate este personaje.\n\n• Aumento por muerte:\n  - Soldado a pie | [color=%positive%]+0.125%[/color]\n  - Zweihander | [color=%positive%]+0.25%[/color]\n  - Soldado de guja | [color=%positive%]+0.125%[/color]\n  - Arbalestero | [color=%positive%]+0.125%[/color]\n  - Abanderado | [color=%positive%]+0.5%[/color]\n  - Sargento | [color=%positive%]+0.5%[/color]\n  - Esgrimista | [color=%positive%]+0.25%[/color]\n  - Alabardero | [color=%positive%]+0.25%[/color]\n  - Hondero | [color=%positive%]+0.125%[/color]\n  - Caballero | [color=%positive%]+1%[/color]\n  - Soldado a pie de élite | [color=%positive%]+0.125%[/color]\n  - Hacha de armas | [color=%positive%]+0.125%[/color]\n  - Tiroseguro | [color=%positive%]+0.125%[/color]\n\n• Aumenta la probabilidad de encontrar campeones Legales.\n\n• [color=%positive%]5%[/color] de probabilidad de obtener de los enemigos abatidos cualquier objeto que de otro modo no se podría saquear. Se acumula consigo mismo y con efectos de naturaleza similar.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendFavouredEnemyOutlaw
    {
        en = "\nThe uncivilized are a plague to be uprooted.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants bonuses to Melee Skill, Ranged Skill and maximum damage while fighting outlaws and criminals. This bonus increases with every Outlaw kill made by this character.\n\n• Increase per kill:\n  - Rabble | [color=%positive%]+0.025%[/color]\n  - Thug | [color=%positive%]+0.0625%[/color]\n  - Poacher | [color=%positive%]+0.0625%[/color]\n  - Marksman | [color=%positive%]+0.125%[/color]\n  - Raider | [color=%positive%]+0.125%[/color]\n  - Veteran | [color=%positive%]+0.2%[/color]\n  - Bandit Leader | [color=%positive%]+0.25%[/color]\n  - Warlord | [color=%positive%]+1%[/color]\n  - Warhound | [color=%positive%]+0.0625%[/color]\n  - Thrall | [color=%positive%]+0.1%[/color]\n  - Reaver | [color=%positive%]+0.25%[/color]\n  - Chosen | [color=%positive%]+0.25%[/color]\n  - Drummer | [color=%positive%]+0.25%[/color]\n  - Beastmaster | [color=%positive%]+0.125%[/color]\n  - King | [color=%positive%]+1%[/color]\n  - Indebted | [color=%positive%]+0.04%[/color]\n  - Cutthroat | [color=%positive%]+0.0625%[/color]\n  - Outlaw | [color=%positive%]+0.125%[/color]\n  - Nomad Slinger | [color=%positive%]+0.1%[/color]\n  - Nomad Archer | [color=%positive%]+0.0625%[/color]\n  - Nomad Leader | [color=%positive%]+0.25%[/color]\n\n• Increases the likelihood of encountering Outlaw champions.\n\n• At 15% or more increases the likelihood of receiving extremely difficult legendary contracts to stop a brigand army from taking over a settlement and to escort an important barbarian prisoner.\n"
        es = "\nLos incivilizados son una plaga que hay que arrancar de raíz.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga bonificaciones a la Habilidad cuerpo a cuerpo, la Habilidad a distancia y el daño máximo al luchar contra forajidos y criminales. La bonificación aumenta con cada Forajido que mate este personaje.\n\n• Aumento por muerte:\n  - Chusma | [color=%positive%]+0.025%[/color]\n  - Matón | [color=%positive%]+0.0625%[/color]\n  - Cazador furtivo | [color=%positive%]+0.0625%[/color]\n  - Tirador | [color=%positive%]+0.125%[/color]\n  - Asaltante | [color=%positive%]+0.125%[/color]\n  - Veterano | [color=%positive%]+0.2%[/color]\n  - Líder bandido | [color=%positive%]+0.25%[/color]\n  - Señor de la guerra | [color=%positive%]+1%[/color]\n  - Mastín de guerra | [color=%positive%]+0.0625%[/color]\n  - Thrall | [color=%positive%]+0.1%[/color]\n  - Saqueador | [color=%positive%]+0.25%[/color]\n  - Elegido | [color=%positive%]+0.25%[/color]\n  - Tamborilero | [color=%positive%]+0.25%[/color]\n  - Maestro de bestias | [color=%positive%]+0.125%[/color]\n  - Rey | [color=%positive%]+1%[/color]\n  - Endeudado | [color=%positive%]+0.04%[/color]\n  - Degollador | [color=%positive%]+0.0625%[/color]\n  - Proscrito | [color=%positive%]+0.125%[/color]\n  - Hondero nómada | [color=%positive%]+0.1%[/color]\n  - Arquero nómada | [color=%positive%]+0.0625%[/color]\n  - Líder nómada | [color=%positive%]+0.25%[/color]\n\n• Aumenta la probabilidad de encontrar campeones Forajidos.\n\n• Con un 15% o más, aumenta la probabilidad de recibir contratos legendarios extremadamente difíciles para impedir que un ejército de bandidos se apodere de un asentamiento y para escoltar a un importante prisionero bárbaro.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendFavouredEnemySwordmaster
    {
        en = "\nThe path to martial prowess is beset by the fake and the weak. Only one can stand to be the greatest.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants bonuses to Melee Skill, Ranged Skill and maximum damage while fighting elite melee combatants. This bonus increases with every Swordmaster kill made by this character.\n\n• Increase per kill:\n  - Hedge Knight | [color=%positive%]+0.25%[/color]\n  - Knight | [color=%positive%]+1%[/color]\n  - Zweihander | [color=%positive%]+0.25%[/color]\n  - Swordmaster | [color=%positive%]+0.5%[/color]\n  - Bandit Leader | [color=%positive%]+0.25%[/color]\n  - Robber Baron | [color=%positive%]+1%[/color]\n  - Fencer | [color=%positive%]+0.25%[/color]\n  - Barbarian King | [color=%positive%]+1%[/color]\n  - Sergeant | [color=%positive%]+0.0125%[/color]\n  - Officer | [color=%positive%]+0.5%[/color]\n  - Gladiator | [color=%positive%]+0.5%[/color]\n  - Assassin | [color=%positive%]+0.5%[/color]\n  - Nomad Leader | [color=%positive%]+0.25%[/color]\n  - Executioner | [color=%positive%]+0.5%[/color]\n  - Desert Devil | [color=%positive%]+0.5%[/color]\n\n• Increases the likelihood of encountering Swordmaster champions.\n\n• Unlocks a very difficult recurring encounter in which a Swordmaster champion challenges a brother to single combat.\n"
        es = "\nEl camino hacia la maestría marcial está plagado de impostores y débiles. Solo uno puede alzarse como el más grande.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga bonificaciones a la Habilidad cuerpo a cuerpo, la Habilidad a distancia y el daño máximo al luchar contra combatientes cuerpo a cuerpo de élite. La bonificación aumenta con cada Maestro espadachín que mate este personaje.\n\n• Aumento por muerte:\n  - Caballero errante | [color=%positive%]+0.25%[/color]\n  - Caballero | [color=%positive%]+1%[/color]\n  - Zweihander | [color=%positive%]+0.25%[/color]\n  - Maestro espadachín | [color=%positive%]+0.5%[/color]\n  - Líder bandido | [color=%positive%]+0.25%[/color]\n  - Barón Ladrón | [color=%positive%]+1%[/color]\n  - Esgrimista | [color=%positive%]+0.25%[/color]\n  - Rey Bárbaro | [color=%positive%]+1%[/color]\n  - Sargento | [color=%positive%]+0.0125%[/color]\n  - Oficial | [color=%positive%]+0.5%[/color]\n  - Gladiador | [color=%positive%]+0.5%[/color]\n  - Asesino | [color=%positive%]+0.5%[/color]\n  - Líder nómada | [color=%positive%]+0.25%[/color]\n  - Verdugo | [color=%positive%]+0.5%[/color]\n  - Diablo del desierto | [color=%positive%]+0.5%[/color]\n\n• Aumenta la probabilidad de encontrar campeones Maestros espadachines.\n\n• Desbloquea un encuentro recurrente muy difícil en el que un campeón Maestro espadachín desafía a un hermano a un combate singular.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendForcefulSwing
    {
        en = "\nUse the power of your hips and core to imbue more force into your swings.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Melee AOE skills do [color=%positive%]+10%[/color] damage.\n"
        es = "\nUsa la fuerza de tus caderas y tu tronco para imprimir más potencia a tus tajos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Las habilidades cuerpo a cuerpo de área infligen [color=%positive%]+10%[/color] de daño.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecSpearWall
    {
        // ::Const.Strings.PerkDescription.LegendSpecSpearWall <- "\nEndless training in holding the line in a spear wall has made it a second nature.\n\n[color=%passive%][u]Passive:[/u][/color]\n• [color=%skill%]Spearwall[/color] costs [color=%negative%]-50%[/color] less Fatigue.\n\n• [color=%skill%]Spearwall[/color] AP cost is reduced by [color=%negative%]1[/color].\n\n• [color=%skill%]Spearwall[/color] does [color=%positive%]+25%[/color] damage.\n";
        mode = "pattern"
        en = "\nEndless training in holding the line in a spear wall has made it a second nature.\n\n[color=%passive%][u]Passive:[/u][/color]\n• [color=%skill%]Spearwall[/color] costs [color=%negative%]-50%[/color] less Fatigue.\n\n• [color=%skill%]Spearwall[/color] AP cost is reduced by [color=%negative%]1[/color].\n\n• [color=%skill%]Spearwall[/color] does [color=%positive%]+25%[/color] damage.\n"
        es = "\nEl entrenamiento incansable para mantener la línea en un muro de lanzas lo ha convertido en algo natural.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• [color=%skill%]Muro de lanzas[/color] cuesta un [color=%negative%]-50%[/color] menos de Fatiga.\n\n• El coste en PA de [color=%skill%]Muro de lanzas[/color] se reduce en [color=%negative%]1[/color].\n\n• [color=%skill%]Muro de lanzas[/color] inflige [color=%positive%]+25%[/color] de daño.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBalance
    {
        en = "\nBalancing your armor can allow protect against different threats.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+15[/color] Ranged Defense. For every 5 points of armor and helmet weight decrease this bonus by [color=%negative%]1[/color], but gain [color=%positive%]1[/color] Melee Defense up to a maximum of 15.\n"
        es = "\nEquilibrar tu armadura te permite protegerte de distintas amenazas.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes [color=%positive%]+15[/color] a la Defensa a distancia. Por cada 5 puntos de peso de armadura y casco, esta bonificación se reduce en [color=%negative%]1[/color], pero obtienes [color=%positive%]1[/color] de Defensa cuerpo a cuerpo, hasta un máximo de 15.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPerfectFit
    {
        en = "\nWell fitting armor lets you strike faster and fight longer.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Reduce the Fatigue cost of all your skills and movement by [color=%negative%]15%[/color], and gain [color=%positive%]30%[/color] Initiative.\n\n• The bonus decreases if the combined Weight penalties of your body and head armor exceed half of your maximum Fatigue. Maximum fatigue is influenced by the weight of all your combined gear, not just armor.\n"
        es = "\nUna armadura bien ajustada te permite golpear más rápido y luchar más tiempo.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Reduce en un [color=%positive%]15%[/color] el coste de Fatiga de todas tus habilidades y movimientos, y obtienes un [color=%positive%]30%[/color] de Iniciativa.\n\n• La bonificación disminuye si la suma de las penalizaciones de peso de tu armadura de cuerpo y de cabeza supera la mitad de tu Fatiga máxima. La Fatiga máxima depende del peso de todo tu equipo, no solo de la armadura.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendThrustMaster
    {
        // ::Const.Strings.PerkDescription.LegendThrustMaster <- "\nPoking things where they don't belong is just a natural inclination for some.\n\n[color=%passive%][u]Passive:[/u][/color]\n• [color=%skill%]Thrust[/color], [color=%skill%]Prong[/color], [color=%skill%]Skewer[/color], [color=%skill%]Impale[/color], [color=%skill%]Rupture[/color], [color=%skill%]Heartseeker[/color] and [color=%skill%]Glaive Strike[/color] do [color=%positive%]+15%[/color] damage.\n\n• Also removes the hitchance penalty per tile when throwing Spears and Javelins.\n";
        mode = "pattern"
        en = "\nPoking things where they don't belong is just a natural inclination for some.\n\n[color=%passive%][u]Passive:[/u][/color]\n• [color=%skill%]Thrust[/color], [color=%skill%]Prong[/color], [color=%skill%]Skewer[/color], [color=%skill%]Impale[/color], [color=%skill%]Rupture[/color], [color=%skill%]Heartseeker[/color] and [color=%skill%]Glaive Strike[/color] do [color=%positive%]+15%[/color] damage.\n\n• Also removes the hitchance penalty per tile when throwing Spears and Javelins.\n"
        es = "\nPinchar cosas donde no se debe es una inclinación natural para algunos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• [color=%skill%]Lanzazo[/color], [color=%skill%]Ensartar[/color], [color=%skill%]Espetón[/color], [color=%skill%]Empalar[/color], [color=%skill%]Ruptura[/color], [color=%skill%]Buscacorazones[/color] y [color=%skill%]Golpe de guja[/color] infligen [color=%positive%]+15%[/color] de daño.\n\n• Además, elimina la penalización a la probabilidad de impactar por casilla al lanzar Lanzas y Jabalinas.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendLithe
    {
        en = "\nMedium armor provides a sweet spot between movement and protection.\n\n[color=%passive%][u]Passive:[/u][/color]\n• All incoming damage to your Armor and Hitpoints is reduced by [color=%negative%]30%[/color], when the combined weight of head and body armor is between 25 and 35.\n\n• Outside this range, the bonus drops exponentially.\n\n• As your armor takes damage, the damage mitigation to Armor drops slowly to half its maximum value, but remains unchanged for Hitpoint damage mitigation.\n"
        es = "\nLa armadura media ofrece el punto justo entre movilidad y protección.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Todo el daño recibido en tu armadura y tus Puntos de vida se reduce en un [color=%positive%]30%[/color] cuando el peso combinado de la armadura de cabeza y de cuerpo está entre 25 y 35.\n\n• Fuera de ese rango, la bonificación cae de forma exponencial.\n\n• A medida que tu armadura recibe daño, la reducción del daño a la armadura baja poco a poco hasta la mitad de su valor máximo, pero la reducción del daño a los Puntos de vida no cambia.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendInTheZone
    {
        en = "\nUse your armor's blend of protection and mobility to punish your foes' mistakes!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain a stacking buff that boosts your Melee Skill and Melee Damage by [color=%positive%]0.5%[/color] up to a maximum of [color=%positive%]12.5%[/color].\n\n• You gain [color=%positive%]0.5%[/color] when you dodge a Melee attack and lose [color=%negative%]1%[/color] when you get hit by any attack.\n\n• When engaged in Melee, the Melee Damage bonus is doubled, up to a maximum of [color=%positive%]25%[/color].\n\n• If your Initiative is higher than twice your armor's weight (penalty to Maximum Fatigue), you start the battle with stacks equal to your armor's weight above 15.\n"
        es = "\n¡Aprovecha la mezcla de protección y movilidad de tu armadura para castigar los errores de tus enemigos!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes una mejora acumulable que aumenta tu Habilidad cuerpo a cuerpo y tu daño cuerpo a cuerpo en un [color=%positive%]0.5%[/color], hasta un máximo del [color=%positive%]12.5%[/color].\n\n• Ganas un [color=%positive%]0.5%[/color] cada vez que esquivas un ataque cuerpo a cuerpo y pierdes un [color=%negative%]1%[/color] cada vez que te alcanza cualquier ataque.\n\n• Mientras combatas cuerpo a cuerpo, la bonificación de daño cuerpo a cuerpo se duplica, hasta un máximo del [color=%positive%]25%[/color].\n\n• Si tu Iniciativa es mayor que el doble del peso de tu armadura (penalización a la Fatiga máxima), empiezas la batalla con tantas acumulaciones como puntos de peso tenga tu armadura por encima de 15.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHidden
    {
        // ::Const.Strings.PerkDescription.LegendHidden <- "\nMaster the art of concealment.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Camoflauge[/color] skill which allows you to blend in with your surroundings and remain [color=%status%]Hidden[/color] from the enemy for three turns, or until your next attack.\n\n• Costs [color=%negative%]8[/color] AP and [color=%negative%]40[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nMaster the art of concealment.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks [color=%skill%]Camoflauge[/color] skill which allows you to blend in with your surroundings and remain [color=%status%]Hidden[/color] from the enemy for three turns, or until your next attack.\n\n• Costs [color=%negative%]8[/color] AP and [color=%negative%]40[/color] Fatigue.\n"
        es = "\nDomina el arte de ocultarte.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Camuflaje[/color], que te permite fundirte con el entorno y permanecer en estado [color=%status%]Oculto[/color] ante el enemigo durante tres turnos o hasta tu próximo ataque.\n\n• Cuesta [color=%negative%]8[/color] PA y [color=%negative%]40[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecStaffStun
    {
        // ::Const.Strings.PerkDescription.LegendSpecStaffStun <- "\nMaster the movements required to spin your staff in a great flourish that lands with additional force.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Any strike with a staff that would normally [color=%status%]Daze[/color], also [color=%status%]Stuns[/color] and [color=%status%]Staggers[/color].\n";
        mode = "pattern"
        en = "\nMaster the movements required to spin your staff in a great flourish that lands with additional force.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Any strike with a staff that would normally [color=%status%]Daze[/color], also [color=%status%]Stuns[/color] and [color=%status%]Staggers[/color].\n"
        es = "\nDomina los movimientos necesarios para girar el bastón en una gran floritura que golpea con más fuerza.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Cualquier golpe con bastón que normalmente [color=%status%]Atontaría[/color] también [color=%status%]Aturde[/color] y [color=%status%]Hace tambalear[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendDrumsOfWar
    {
        // ::Const.Strings.PerkDescription.LegendDrumsOfWar <- "\nLearn powerful rhythms that drive your allies on.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]War Chant[/color] skill which restores [color=%positive%]+3[/color] Fatigue to every ally within eight tiles.\n\n• Can only be used with a Drum or Lute equipped.\n\n• Costs [color=%negative%]8[/color] AP and [color=%negative%]30[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nLearn powerful rhythms that drive your allies on.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]War Chant[/color] skill which restores [color=%positive%]+3[/color] Fatigue to every ally within eight tiles.\n\n• Can only be used with a Drum or Lute equipped.\n\n• Costs [color=%negative%]8[/color] AP and [color=%negative%]30[/color] Fatigue.\n"
        es = "\nAprende ritmos poderosos que impulsan a tus aliados.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Canto de guerra[/color], que restaura [color=%positive%]+3[/color] de Fatiga a todos los aliados a ocho casillas o menos.\n\n• Solo se puede usar con un Tambor o un Laúd equipado.\n\n• Cuesta [color=%negative%]8[/color] PA y [color=%negative%]30[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecUnarmed
    {
        // ::Const.Strings.PerkDescription.LegendSpecUnarmed <- "\nMaster the martial arts of unarmed combat.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Reduces the Fatigue costs of [color=%skill%]Hand to Hand[/color], [color=%skill%]Kick[/color], [color=%skill%]Grapple[/color], [color=%skill%]Choke[/color], and [color=%skill%]Tackle[/color] by [color=%negative%]25%[/color].\n\n• Increases Fatigue inflicted for [color=%skill%]Hand to Hand[/color] by [color=%positive%]5[/color] and reduce AP cost by [color=%negative%]1[/color].\n\n• [color=%skill%]Kick[/color] has [color=%status%]Daze[/color] chance increased to [color=%positive%]50%[/color] and hit chance increased by [color=%positive%]15%[/color].\n\n• [color=%skill%]Grapple[/color] now has a [color=%positive%]100%[/color] chance to be disarm on hit and hit chance is increased by [color=%positive%]+10%[/color].\n\n• [color=%skill%]Tackle[/color] gains [color=%positive%]+10%[/color] chance to hit.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Tackle[/color] skill which on a hit knocks over your opponent.\n\n• [color=%status%]Knocked Over[/color] enemies have their Melee Defense reduced by [color=%negative%]-50%[/color], their Initiative reduced by [color=%negative%]-70%[/color], and increases damage they take by [color=%positive%]25%[/color].\n\n• Hit chance determined by how Fatigued the target is.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]30[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nMaster the martial arts of unarmed combat.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Reduces the Fatigue costs of [color=%skill%]Hand to Hand[/color], [color=%skill%]Kick[/color], [color=%skill%]Grapple[/color], [color=%skill%]Choke[/color], and [color=%skill%]Tackle[/color] by [color=%negative%]25%[/color].\n\n• Increases Fatigue inflicted for [color=%skill%]Hand to Hand[/color] by [color=%positive%]5[/color] and reduce AP cost by [color=%negative%]1[/color].\n\n• [color=%skill%]Kick[/color] has [color=%status%]Daze[/color] chance increased to [color=%positive%]50%[/color] and hit chance increased by [color=%positive%]15%[/color].\n\n• [color=%skill%]Grapple[/color] now has a [color=%positive%]100%[/color] chance to be disarm on hit and hit chance is increased by [color=%positive%]+10%[/color].\n\n• [color=%skill%]Tackle[/color] gains [color=%positive%]+10%[/color] chance to hit.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Tackle[/color] skill which on a hit knocks over your opponent.\n\n• [color=%status%]Knocked Over[/color] enemies have their Melee Defense reduced by [color=%negative%]-50%[/color], their Initiative reduced by [color=%negative%]-70%[/color], and increases damage they take by [color=%positive%]25%[/color].\n\n• Hit chance determined by how Fatigued the target is.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]30[/color] Fatigue.\n"
        es = "\nDomina las artes marciales del combate sin armas.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Reduce en un [color=%negative%]25%[/color] el coste de Fatiga de [color=%skill%]Mano a mano[/color], [color=%skill%]Patada[/color], [color=%skill%]Agarre[/color], [color=%skill%]Estrangular[/color] y [color=%skill%]Placaje[/color].\n\n• Aumenta en [color=%positive%]5[/color] la Fatiga infligida por [color=%skill%]Mano a mano[/color] y reduce su coste en PA en [color=%negative%]1[/color].\n\n• [color=%skill%]Patada[/color] aumenta al [color=%positive%]50%[/color] su probabilidad de [color=%status%]Atontar[/color] y en un [color=%positive%]15%[/color] su probabilidad de impactar.\n\n• [color=%skill%]Agarre[/color] tiene ahora un [color=%positive%]100%[/color] de probabilidad de desarmar al impactar, y su probabilidad de impactar aumenta en [color=%positive%]+10%[/color].\n\n• [color=%skill%]Placaje[/color] obtiene [color=%positive%]+10%[/color] a la probabilidad de impactar.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Placaje[/color], que al impactar derriba a tu oponente.\n\n• Los enemigos en estado [color=%status%]Derribado[/color] ven reducida su Defensa cuerpo a cuerpo en [color=%negative%]-50%[/color] y su Iniciativa en [color=%negative%]-70%[/color], y reciben un [color=%positive%]25%[/color] más de daño.\n\n• La probabilidad de impactar depende de lo fatigado que esté el objetivo.\n\n• Cuesta [color=%negative%]6[/color] PA y [color=%negative%]30[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendGrappler
    {
        // ::Const.Strings.PerkDescription.LegendGrappler <- "\nA time tested tradition of getting your opponent to the ground, disarmed and reeling!\n\n[color=%passive%][u]Passive:[/u][/color]\n• [color=%skill%]Grapple[/color] will no longer have a chance to hit malus. Any hit with [color=%skill%]Hand to Hand[/color] has a [color=%positive%]25%[/color] to apply [color=%status%]Grapple[/color].\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Choke[/color] skill when both hands are free.\n\n• [color=%status%]Choked[/color] enemies have their Fatigue Recovery reduced by [color=%negative%]15[/color].\n\n• Damage inflicted is determined by the difference in Fatigue between you and your target.\n\n• Hit chance determined by your target's Fatigue, [color=%negative%]0%[/color] if they are fresh and [color=%positive%]100%[/color] if they are exhausted.\n\n• Hit chance is increased by [color=%positive%]+10%[/color] if your target is [color=%status%]Dazed[/color] or [color=%status%]Parried[/color], [color=%positive%]+25%[/color] if they are [color=%status%]Stunned[/color] or [color=%status%]Netted[/color], and  [color=%positive%]+50%[/color] If they are [color=%status%]Grappled[/color] or [color=%status%]Sleeping[/color].\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]20[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nA time tested tradition of getting your opponent to the ground, disarmed and reeling!\n\n[color=%passive%][u]Passive:[/u][/color]\n• [color=%skill%]Grapple[/color] will no longer have a chance to hit malus. Any hit with [color=%skill%]Hand to Hand[/color] has a [color=%positive%]25%[/color] to apply [color=%status%]Grapple[/color].\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Choke[/color] skill when both hands are free.\n\n• [color=%status%]Choked[/color] enemies have their Fatigue Recovery reduced by [color=%negative%]15[/color].\n\n• Damage inflicted is determined by the difference in Fatigue between you and your target.\n\n• Hit chance determined by your target's Fatigue, [color=%negative%]0%[/color] if they are fresh and [color=%positive%]100%[/color] if they are exhausted.\n\n• Hit chance is increased by [color=%positive%]+10%[/color] if your target is [color=%status%]Dazed[/color] or [color=%status%]Parried[/color], [color=%positive%]+25%[/color] if they are [color=%status%]Stunned[/color] or [color=%status%]Netted[/color], and  [color=%positive%]+50%[/color] If they are [color=%status%]Grappled[/color] or [color=%status%]Sleeping[/color].\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = "\nUna tradición probada por el tiempo: ¡llevar a tu oponente al suelo, desarmado y tambaleándose!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• [color=%skill%]Agarre[/color] ya no tiene penalización a la probabilidad de impactar. Cualquier impacto con [color=%skill%]Mano a mano[/color] tiene un [color=%positive%]25%[/color] de probabilidad de aplicar [color=%status%]Agarre[/color].\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Estrangular[/color] cuando tienes ambas manos libres.\n\n• Los enemigos en estado [color=%status%]Estrangulado[/color] ven reducida su recuperación de Fatiga en [color=%negative%]15[/color].\n\n• El daño infligido depende de la diferencia de Fatiga entre tú y tu objetivo.\n\n• La probabilidad de impactar depende de la Fatiga del objetivo: [color=%negative%]0%[/color] si está fresco y [color=%positive%]100%[/color] si está exhausto.\n\n• La probabilidad de impactar aumenta en [color=%positive%]+10%[/color] si tu objetivo está [color=%status%]Atontado[/color] o [color=%status%]Contrarrestado[/color], en [color=%positive%]+25%[/color] si está [color=%status%]Aturdido[/color] o [color=%status%]Atrapado en red[/color], y en [color=%positive%]+50%[/color] si está [color=%status%]Agarrado[/color] o [color=%status%]Durmiendo[/color].\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]20[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendAmbidextrous
    {
        // ::Const.Strings.PerkDescription.LegendAmbidextrous <- "\nYou're as capable with one hand as the other!\n\n[color=%passive%][u]Passive:[/u][/color]\n• When your offhand is free, follow up attacks with [color=%skill%]Hand to Hand[/color]. Gain [color=%positive%]+5[/color] Melee Skill and [color=%positive%]+10[/color] Melee Defense if both hands are free.\n\n• If using a Buckler or Mummy Shield, follow up attacks with [color=%skill%]Buckler Bash[/color] instead.\n\n• When dual wielding other weapons, the weight penalty is reduced by [color=%positive%]33%[/color].\n";
        mode = "pattern"
        en = "\nYou're as capable with one hand as the other!\n\n[color=%passive%][u]Passive:[/u][/color]\n• When your offhand is free, follow up attacks with [color=%skill%]Hand to Hand[/color]. Gain [color=%positive%]+5[/color] Melee Skill and [color=%positive%]+10[/color] Melee Defense if both hands are free.\n\n• If using a Buckler or Mummy Shield, follow up attacks with [color=%skill%]Buckler Bash[/color] instead.\n\n• When dual wielding other weapons, the weight penalty is reduced by [color=%positive%]33%[/color].\n"
        es = "\n¡Eres igual de hábil con una mano que con la otra!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Si tu mano secundaria está libre, rematas tus ataques con [color=%skill%]Mano a mano[/color]. Obtienes [color=%positive%]+5[/color] a la Habilidad cuerpo a cuerpo y [color=%positive%]+10[/color] a la Defensa cuerpo a cuerpo si tienes ambas manos libres.\n\n• Si usas una Rodela o un Escudo de momia, rematas tus ataques con [color=%skill%]Golpe de broquel[/color] en su lugar.\n\n• Al llevar otras armas en ambas manos, la penalización por peso se reduce en un [color=%positive%]33%[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPugilist
    {
        // ::Const.Strings.PerkDescription.LegendPugilist <- "\nThe first rule of...\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increase [color=%skill%]Hand to Hand[/color] damage by [color=%positive%]25%[/color]. [color=%skill%]Kick[/color] can now be used without a free hand and will do [color=%positive%]10-15[/color] Damage.\n";
        mode = "pattern"
        en = "\nThe first rule of...\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increase [color=%skill%]Hand to Hand[/color] damage by [color=%positive%]25%[/color]. [color=%skill%]Kick[/color] can now be used without a free hand and will do [color=%positive%]10-15[/color] Damage.\n"
        es = "\nLa primera regla de...\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aumenta en un [color=%positive%]25%[/color] el daño de [color=%skill%]Mano a mano[/color]. [color=%skill%]Patada[/color] ahora se puede usar sin una mano libre e inflige [color=%positive%]10-15[/color] de daño.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPummelIntoSubmission
    {
        en = "\nStrike while they're down!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Attacks deal an additional [color=%positive%]5%[/color] of the enemy's maximum fatigue per hit.\n\n• Each point of fatigue damage over the target's maximum fatigue will be translated to additional damage done.\n"
        es = "\n¡Golpéalos mientras están en el suelo!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Los ataques infligen por impacto un [color=%positive%]5%[/color] adicional de la fatiga máxima del enemigo.\n\n• Cada punto de daño de fatiga por encima de la fatiga máxima del objetivo se convierte en daño adicional.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendFieldTreats
    {
        // ::Const.Strings.PerkDescription.LegendFieldTreats <- "\nMake liberal use of alcohol and food to motivate your mercenaries.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Field Treats[/color] skill which allows you to spend [color=%negative%]20[/color] food to improve an adjacent allies morale from [color=%status%]Wavering[/color] to [color=%status%]Steady[/color].\n\n• Cannot be applied to someone who has already been rallied.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]16[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nMake liberal use of alcohol and food to motivate your mercenaries.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Field Treats[/color] skill which allows you to spend [color=%negative%]20[/color] food to improve an adjacent allies morale from [color=%status%]Wavering[/color] to [color=%status%]Steady[/color].\n\n• Cannot be applied to someone who has already been rallied.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]16[/color] Fatigue.\n"
        es = "\nHaz uso generoso del alcohol y la comida para motivar a tus mercenarios.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Agasajos de campaña[/color], que te permite gastar [color=%negative%]20[/color] de comida para mejorar la moral de un aliado adyacente de [color=%status%]Vacilante[/color] a [color=%status%]Firme[/color].\n\n• No se puede aplicar a nadie a quien ya se le haya levantado la moral.\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]16[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSmashingShields
    {
        // ::Const.Strings.PerkDescription.LegendSmashingShields <- "\nSome folks take joy in the simple pleasures of destroying shields.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants an additional [color=%positive%]+50%[/color] damage to shields when using [color=%skill%]Split Shield[/color] or a Throwing Spear.\n• If the shield is destroyed, gain [color=%positive%]4[/color] additional AP and any damage above the max durability of the target's shield will hit the target.\n\n• When [color=%status%]Dual Wielding[/color] axes, [color=%skill%]Split Shield[/color] uses the combined shield damage from both weapons.\n";
        mode = "pattern"
        en = "\nSome folks take joy in the simple pleasures of destroying shields.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants an additional [color=%positive%]+50%[/color] damage to shields when using [color=%skill%]Split Shield[/color] or a Throwing Spear.\n• If the shield is destroyed, gain [color=%positive%]4[/color] additional AP and any damage above the max durability of the target's shield will hit the target.\n\n• When [color=%status%]Dual Wielding[/color] axes, [color=%skill%]Split Shield[/color] uses the combined shield damage from both weapons.\n"
        es = "\nHay quien disfruta del sencillo placer de destrozar escudos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga un [color=%positive%]+50%[/color] adicional de daño a los escudos al usar [color=%skill%]Romper escudo[/color] o una Lanza arrojadiza.\n• Si el escudo queda destruido, obtienes [color=%positive%]4[/color] PA adicionales, y cualquier daño que supere la durabilidad máxima del escudo del objetivo alcanza al objetivo.\n\n• Al ir [color=%status%]Con dos armas[/color] con hachas, [color=%skill%]Romper escudo[/color] usa el daño a escudos combinado de ambas armas.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSmackdown
    {
        // ::Const.Strings.PerkDescription.LegendSmackdown <- "\nUse your size and strength to dominate the battlefield, combining the best of both worlds in offense and defense.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Effectiveness vs Armor is increased by [color=%positive%]30%[/color] for any weapon used.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Wind Up[/color] skill which allows you to knock back and [color=%status%]Baffle[/color] an opponent on your next swing.\n• [color=%status%]Baffled[/color] enemies suffer [color=%negative%]-15%[/color] Damage, Max Fatigue, and Initiative.\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]15[/color] Fatigue.\n• When wielding a two-handed weapon, reduces AP cost to [color=%negative%]1[/color]. Works only with melee weapons, unarmed attacks and one handed slings. With one handed slings it will grant the [color=%skill%]Prepare Bullet[/color] effect.\n";
        mode = "pattern"
        en = "\nUse your size and strength to dominate the battlefield, combining the best of both worlds in offense and defense.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Effectiveness vs Armor is increased by [color=%positive%]30%[/color] for any weapon used.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Wind Up[/color] skill which allows you to knock back and [color=%status%]Baffle[/color] an opponent on your next swing.\n• [color=%status%]Baffled[/color] enemies suffer [color=%negative%]-15%[/color] Damage, Max Fatigue, and Initiative.\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]15[/color] Fatigue.\n• When wielding a two-handed weapon, reduces AP cost to [color=%negative%]1[/color]. Works only with melee weapons, unarmed attacks and one handed slings. With one handed slings it will grant the [color=%skill%]Prepare Bullet[/color] effect.\n"
        es = "\nUsa tu tamaño y tu fuerza para dominar el campo de batalla, combinando lo mejor de ambos mundos en ataque y defensa.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• La eficacia contra armadura aumenta en un [color=%positive%]30%[/color] con cualquier arma.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Tomar impulso[/color], que te permite hacer retroceder y [color=%status%]Desconcertar[/color] a un oponente con tu siguiente golpe.\n• Los enemigos en estado [color=%status%]Desconcertado[/color] sufren [color=%negative%]-15%[/color] al daño, la Fatiga máxima y la Iniciativa.\n• Cuesta [color=%negative%]2[/color] PA y [color=%negative%]15[/color] de Fatiga.\n• Al empuñar un arma a dos manos, reduce el coste en PA a [color=%negative%]1[/color]. Solo funciona con armas cuerpo a cuerpo, ataques sin armas y hondas a una mano. Con hondas a una mano, otorga el efecto [color=%skill%]Preparar disparo[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBoneBreaker
    {
        en = "\nEven if your strikes don't penetrate the opponent's armor, you'll make sure they feel it.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increases hitpoint damage and always inflict a minimum amount of damage to hitpoints equal to [color=%positive%]10%[/color] of the armor damage done to the target. Attacks that don't deal armor damage or fully penetrate the target's armor will not receive any bonuses, and the bonus damage is subject to damage reductions from the target.\n"
        es = "\nAunque tus golpes no atraviesen la armadura del oponente, te asegurarás de que los sienta.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aumenta el daño a los Puntos de vida e inflige siempre a los Puntos de vida un daño mínimo igual al [color=%positive%]10%[/color] del daño causado a la armadura del objetivo. Los ataques que no causen daño a la armadura o que atraviesen por completo la armadura del objetivo no reciben ninguna bonificación, y el daño adicional está sujeto a las reducciones de daño del objetivo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendClarity
    {
        // ::Const.Strings.PerkDescription.LegendClarity <- "\nA well honed mind can perceive more in each instant, making time appear slower in key instants of need.\n\n[color=%passive%][u]Passive:[/u][/color]\n• An additional [color=%positive%]+10%[/color] of any damage ignores armor.\n\n• Does not work if you are [color=%status%]Dazed[/color], [color=%status%]Drunk[/color], [color=%status%]Hungover[/color], [color=%status%]Taunted[/color], [color=%status%]Staggered[/color], [color=%status%]Horrified[/color], [color=%status%]Concussed[/color] or [color=%status%]Wavering[/color].\n\n• Doubles the armor ignore bonus if under the effect of the following potions: Iron Will, Lionheart, Cat, Second Wind or Hexen Ichor.\n";
        mode = "pattern"
        en = "\nA well honed mind can perceive more in each instant, making time appear slower in key instants of need.\n\n[color=%passive%][u]Passive:[/u][/color]\n• An additional [color=%positive%]+10%[/color] of any damage ignores armor.\n\n• Does not work if you are [color=%status%]Dazed[/color], [color=%status%]Drunk[/color], [color=%status%]Hungover[/color], [color=%status%]Taunted[/color], [color=%status%]Staggered[/color], [color=%status%]Horrified[/color], [color=%status%]Concussed[/color] or [color=%status%]Wavering[/color].\n\n• Doubles the armor ignore bonus if under the effect of the following potions: Iron Will, Lionheart, Cat, Second Wind or Hexen Ichor.\n"
        es = "\nUna mente bien afilada percibe más en cada instante, y hace que el tiempo parezca ralentizarse en los momentos clave.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Un [color=%positive%]+10%[/color] adicional de cualquier daño ignora la armadura.\n\n• No funciona bajo los estados [color=%status%]Atontado[/color], [color=%status%]Ebrio[/color], [color=%status%]Con resaca[/color], [color=%status%]Provocado[/color], [color=%status%]Tambaleante[/color], [color=%status%]Horrorizado[/color], [color=%status%]Con conmoción[/color] o [color=%status%]Vacilante[/color].\n\n• Duplica la bonificación de ignorar armadura si estás bajo el efecto de alguna de estas pociones: Voluntad de Hierro, Corazón de León, Gato, Segundo aliento o Icor de Hexen.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendAlert
    {
        en = "\nPay close attention at all times, surveying the surroundings and assessing every clue for an insight.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+20%[/color] Initiative.\n"
        es = "\nPresta mucha atención en todo momento, examinando el entorno y analizando cada indicio en busca de una pista.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes [color=%positive%]+20%[/color] de Iniciativa.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBloodbath
    {
        // ::Const.Strings.PerkDescription.LegendBloodbath <- "\nTake joy in the suffering of others.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain Melee Skill, Ranged Skill, Fatigue Recovery and Resolve for each character that is [color=%status%]Bleeding[/color] or has a temporary [color=%status%]Injury[/color] on the field. Double the bonus if you're adjacent to bleeding enemies.\n\n• The fatigue recovery bonus cannot exceed 5.\n";
        mode = "pattern"
        en = "\nTake joy in the suffering of others.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain Melee Skill, Ranged Skill, Fatigue Recovery and Resolve for each character that is [color=%status%]Bleeding[/color] or has a temporary [color=%status%]Injury[/color] on the field. Double the bonus if you're adjacent to bleeding enemies.\n\n• The fatigue recovery bonus cannot exceed 5.\n"
        es = "\nDisfruta con el sufrimiento ajeno.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes Habilidad cuerpo a cuerpo, Habilidad a distancia, recuperación de Fatiga y Resolución por cada personaje en el campo que esté [color=%status%]Sangrando[/color] o tenga una [color=%status%]Herida[/color] temporal. La bonificación se duplica si estás adyacente a enemigos que sangran.\n\n• La bonificación a la recuperación de fatiga no puede superar 5.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendTerrifyingVisage
    {
        en = "\nThe mere sight of this character sends enemies fleeing.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Reduces Resolve of adjacent enemies by [color=%negative%]-15[/color].\n"
        es = "\nCon solo ver a este personaje, los enemigos huyen.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Reduce en [color=%positive%]-15[/color] la Resolución de los enemigos adyacentes.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendFreedomOfMovement
    {
        // ::Const.Strings.PerkDescription.LegendFreedomOfMovement <- "\nA skilled mercenary has unimpeded movement regardless of armor.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Reduces Fatigue cost of [color=%skill%]Climb[/color], [color=%skill%]Lunge[/color], [color=%skill%]Footwork[/color], [color=%skill%]Rotation[/color], [color=%skill%]Leap[/color], [color=%skill%]Quick Step[/color], [color=%skill%]Evasion[/color] by [color=%negative%]50%[/color].\n\n• The Action Point cost of [color=%skill%]Climb[/color], [color=%skill%]Footwork[/color] and [color=%skill%]Rotation[/color] is reduced by [color=%negative%]1[/color], [color=%skill%]Leap[/color] by [color=%negative%]3[/color] and [color=%skill%]Evasion[/color] by [color=%negative%]2[/color].\n\n• Picking this perk will also add [color=%perk%]Tactical Maneuvers[/color] and [color=%perk%]Quick Step[/color] to your perk tree.\n";
        mode = "pattern"
        en = "\nA skilled mercenary has unimpeded movement regardless of armor.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Reduces Fatigue cost of [color=%skill%]Climb[/color], [color=%skill%]Lunge[/color], [color=%skill%]Footwork[/color], [color=%skill%]Rotation[/color], [color=%skill%]Leap[/color], [color=%skill%]Quick Step[/color], [color=%skill%]Evasion[/color] by [color=%negative%]50%[/color].\n\n• The Action Point cost of [color=%skill%]Climb[/color], [color=%skill%]Footwork[/color] and [color=%skill%]Rotation[/color] is reduced by [color=%negative%]1[/color], [color=%skill%]Leap[/color] by [color=%negative%]3[/color] and [color=%skill%]Evasion[/color] by [color=%negative%]2[/color].\n\n• Picking this perk will also add [color=%perk%]Tactical Maneuvers[/color] and [color=%perk%]Quick Step[/color] to your perk tree.\n"
        es = "\nUn mercenario hábil se mueve sin trabas, lleve la armadura que lleve.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Reduce en un [color=%negative%]50%[/color] el coste de Fatiga de [color=%skill%]Trepar[/color], [color=%skill%]Estocada[/color], [color=%skill%]Juego de pies[/color], [color=%skill%]Rotación[/color], [color=%skill%]Salto[/color], [color=%skill%]Paso rápido[/color] y [color=%skill%]Evasión[/color].\n\n• El coste en Puntos de acción de [color=%skill%]Trepar[/color], [color=%skill%]Juego de pies[/color] y [color=%skill%]Rotación[/color] se reduce en [color=%negative%]1[/color], el de [color=%skill%]Salto[/color] en [color=%negative%]3[/color] y el de [color=%skill%]Evasión[/color] en [color=%negative%]2[/color].\n\n• Elegir esta ventaja también añade [color=%perk%]Maniobras tácticas[/color] y [color=%perk%]Paso rápido[/color] a tu árbol de ventajas.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendOnslaught
    {
        // ::Const.Strings.PerkDescription.LegendOnslaught <- "\nDon't slow down!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants a [color=%positive%]50%[/color] chance to apply [color=%status%]Baffled[/color] on every hit with any weapon, when your Initiative is higher than that of your opponent.\n\n• [color=%status%]Baffled[/color] enemies suffer [color=%negative%]-15%[/color] Damage, Max Fatigue, and Initiative.\n\n• Increase melee damage by [color=%positive%]2%[/color] for every 100 points of armor.\n";
        mode = "pattern"
        en = "\nDon't slow down!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants a [color=%positive%]50%[/color] chance to apply [color=%status%]Baffled[/color] on every hit with any weapon, when your Initiative is higher than that of your opponent.\n\n• [color=%status%]Baffled[/color] enemies suffer [color=%negative%]-15%[/color] Damage, Max Fatigue, and Initiative.\n\n• Increase melee damage by [color=%positive%]2%[/color] for every 100 points of armor.\n"
        es = "\n¡No aflojes!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga un [color=%positive%]50%[/color] de probabilidad de aplicar [color=%status%]Desconcertado[/color] con cada impacto de cualquier arma cuando tu Iniciativa es mayor que la de tu oponente.\n\n• Los enemigos en estado [color=%status%]Desconcertado[/color] sufren [color=%negative%]-15%[/color] al daño, la Fatiga máxima y la Iniciativa.\n\n• Aumenta el daño cuerpo a cuerpo en un [color=%positive%]2%[/color] por cada 100 puntos de armadura.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBackToBasics
    {
        // ::Const.Strings.PerkDescription.LegendBackToBasics <- "\nYears of practice lead this character to fall back to their instincts and basic training under extreme stress.\n\n[color=%passive%][u]Passive:[/u][/color]\n• When this character takes damage, they will gain a stacking [color=%positive%]+5[/color] Melee Defense until the start of their next turn.\n\n• If they take damage while [color=%status%]Fleeing[/color], they have a chance to rally. The chance is equal to half their Resolve.\n\n• Also grants [color=%positive%]+10%[/color] training speed in camp.\n";
        mode = "pattern"
        en = "\nYears of practice lead this character to fall back to their instincts and basic training under extreme stress.\n\n[color=%passive%][u]Passive:[/u][/color]\n• When this character takes damage, they will gain a stacking [color=%positive%]+5[/color] Melee Defense until the start of their next turn.\n\n• If they take damage while [color=%status%]Fleeing[/color], they have a chance to rally. The chance is equal to half their Resolve.\n\n• Also grants [color=%positive%]+10%[/color] training speed in camp.\n"
        es = "\nAños de práctica hacen que este personaje recurra a sus instintos y a su entrenamiento básico bajo un estrés extremo.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Cuando este personaje recibe daño, obtiene [color=%positive%]+5[/color] acumulable a la Defensa cuerpo a cuerpo hasta el inicio de su siguiente turno.\n\n• Si recibe daño mientras está [color=%status%]Huyendo[/color], tiene una probabilidad de reagruparse igual a la mitad de su Resolución.\n\n• También otorga [color=%positive%]+10%[/color] de velocidad de entrenamiento en el campamento.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPushTheAdvantage
    {
        // ::Const.Strings.PerkDescription.LegendPushTheAdvantage <- "\nCarpe juggular!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain an additional [color=%positive%]20%[/color] damage on hits to the head and chance to hit the head against targets that are [color=%status%]Debilitated[/color], [color=%status%]Knocked Over[/color] or have sustained any injury effects, like a broken arm.\n\n• Also grants [color=%positive%]+10%[/color] damage on hits to the head and chance to hit the head against targets who suffer from any of the following effects: [color=%status%]Baffled[/color], [color=%status%]Dazed[/color], [color=%status%]Distracted[/color], [color=%status%]Grappled[/color], [color=%status%]Netted[/color], [color=%status%]Rooted[/color], [color=%status%]Shellshocked[/color], [color=%status%]Sleeping[/color], [color=%status%]Staggered[/color], [color=%status%]Stunned[/color], [color=%status%]Vulnerable[/color], [color=%status%]Webbed[/color], or [color=%status%]Withered[/color].\n";
        mode = "pattern"
        en = "\nCarpe juggular!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain an additional [color=%positive%]20%[/color] damage on hits to the head and chance to hit the head against targets that are [color=%status%]Debilitated[/color], [color=%status%]Knocked Over[/color] or have sustained any injury effects, like a broken arm.\n\n• Also grants [color=%positive%]+10%[/color] damage on hits to the head and chance to hit the head against targets who suffer from any of the following effects: [color=%status%]Baffled[/color], [color=%status%]Dazed[/color], [color=%status%]Distracted[/color], [color=%status%]Grappled[/color], [color=%status%]Netted[/color], [color=%status%]Rooted[/color], [color=%status%]Shellshocked[/color], [color=%status%]Sleeping[/color], [color=%status%]Staggered[/color], [color=%status%]Stunned[/color], [color=%status%]Vulnerable[/color], [color=%status%]Webbed[/color], or [color=%status%]Withered[/color].\n"
        es = "\n¡Carpe yugular!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes un [color=%positive%]20%[/color] adicional de daño en los impactos a la cabeza y de probabilidad de impactar en la cabeza contra objetivos en estado [color=%status%]Debilitado[/color] o [color=%status%]Derribado[/color], o que sufran cualquier efecto de herida, como un brazo roto.\n\n• También otorga [color=%positive%]+10%[/color] de daño en los impactos a la cabeza y de probabilidad de impactar en la cabeza contra objetivos que sufran cualquiera de los siguientes efectos: [color=%status%]Desconcertado[/color], [color=%status%]Atontado[/color], [color=%status%]Distraído[/color], [color=%status%]Agarrado[/color], [color=%status%]Atrapado en red[/color], [color=%status%]Inmovilizado[/color], [color=%status%]Conmocionado[/color], [color=%status%]Durmiendo[/color], [color=%status%]Tambaleante[/color], [color=%status%]Aturdido[/color], [color=%status%]Vulnerable[/color], [color=%status%]Atrapado en telaraña[/color] o [color=%status%]Marchito[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMindOverBody
    {
        en = "\nPush your body beyond what is humanly possible through your sheer force of will.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain scaling Fatigue reduction on skills and Fatigue cost of getting hit for each point of Resolve over 60.\n\n70 Resolve: [color=%negative%]7%[/color] Fatigue reduction\n80 Resolve: [color=%negative%]10%[/color] Fatigue reduction\n90 Resolve: [color=%negative%]18%[/color] Fatigue reduction\n100 Resolve: [color=%negative%]22%[/color] Fatigue reduction\n120 Resolve: [color=%negative%]29%[/color] Fatigue reduction\n140 Resolve: [color=%negative%]34%[/color] Fatigue reduction\n160 Resolve: [color=%negative%]39%[/color] Fatigue reduction\n"
        es = "\nLleva tu cuerpo más allá de lo humanamente posible con la pura fuerza de tu voluntad.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes una reducción progresiva de la Fatiga de las habilidades y del coste de Fatiga de recibir golpes por cada punto de Resolución por encima de 60.\n\n70 de Resolución: [color=%positive%]7%[/color] de reducción de Fatiga\n80 de Resolución: [color=%positive%]10%[/color] de reducción de Fatiga\n90 de Resolución: [color=%positive%]18%[/color] de reducción de Fatiga\n100 de Resolución: [color=%positive%]22%[/color] de reducción de Fatiga\n120 de Resolución: [color=%positive%]29%[/color] de reducción de Fatiga\n140 de Resolución: [color=%positive%]34%[/color] de reducción de Fatiga\n160 de Resolución: [color=%positive%]39%[/color] de reducción de Fatiga\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendEscapeArtist
    {
        // ::Const.Strings.PerkDescription.LegendEscapeArtist <- "\nOthers see it as magic, but your deft hands know better.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants a baseline 99% chance to [color=%skill%]Break Free[/color] from rooting effects, such as nets and webs.\n\n• Reduces the Action Point cost of [color=%skill%]Break Free[/color] by [color=%negative%]1[/color].\n";
        mode = "pattern"
        en = "\nOthers see it as magic, but your deft hands know better.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants a baseline 99% chance to [color=%skill%]Break Free[/color] from rooting effects, such as nets and webs.\n\n• Reduces the Action Point cost of [color=%skill%]Break Free[/color] by [color=%negative%]1[/color].\n"
        es = "\nOtros lo ven como magia, pero tus hábiles manos saben la verdad.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga una probabilidad base del 99% de [color=%skill%]Liberarte[/color] de efectos de inmovilización, como redes y telarañas.\n\n• Reduce en [color=%negative%]1[/color] el coste en Puntos de acción de [color=%skill%]Liberarte[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendGatherer
    {
        en = "\nKnowledge of the landscape and vegetation provides a wealth of opportunities when gathering in camp.\n\n[color=%passive%][u]Passive:[/u][/color]\n• [color=%positive%]Doubles[/color] the bonus of characters with this perk finding special items while assigned to gathering in camp.\n\n• When the total bonus from all characters with or without this perk is above 10% while assigned to gathering in camp, they can find mushrooms, poisons, antidotes and powders without crafting them.\n"
        es = "\nConocer el paisaje y la vegetación brinda multitud de oportunidades al recolectar en el campamento.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• [color=%positive%]Duplica[/color] la bonificación de los personajes con esta ventaja para encontrar objetos especiales mientras están asignados a la recolección en el campamento.\n\n• Cuando la bonificación total de todos los personajes asignados a la recolección en el campamento, con o sin esta ventaja, supera el 10%, pueden encontrar setas, venenos, antídotos y polvos sin fabricarlos.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPotionBrewer
    {
        en = "\nExpertise in potions and tinctures allows the creation of potions while gathering in camp.\n\n[color=%passive%][u]Passive:[/u][/color]\n• This skill unlocks the chance to create lionheart, ironwill, recovery and cat potions while gathering. An apothecary, druid, alchemist or vala must gather the ingredients for the potion brewer.\n\n• When the total level of all brewers ([color=%perk%]Potion Brewer[/color] perk) is above [color=%positive%]35[/color] and Apothecaries (backgrounds or [color=%perk%]Gathering[/color] perk) is above [color=%positive%]45[/color], gain a chance to create potions of knowledge when gathering tent is upgraded.\n\n• Unlocks alcohol crafting in the crafting tent.\n"
        es = "\nLa pericia en pociones y tinturas permite crear pociones al recolectar en el campamento.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Esta ventaja desbloquea la probabilidad de crear pociones de corazón de león, voluntad de hierro, recuperación y gato al recolectar. Un boticario, druida, alquimista o vala debe recolectar los ingredientes para el preparador de pociones.\n\n• Cuando el nivel total de todos los preparadores (ventaja [color=%perk%]Preparador de pociones[/color]) supera [color=%positive%]35[/color] y el de los boticarios (trasfondos o ventaja [color=%perk%]Recolector[/color]) supera [color=%positive%]45[/color], obtienes una probabilidad de crear pociones de conocimiento cuando la tienda de recolección está mejorada.\n\n• Desbloquea la fabricación de alcohol en la tienda de fabricación.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecCultHood
    {
        en = "\nIn Pain we find the truth of ourselves. We have no identity beyond servitude, our glory is agony.\n\n[color=%passive%][u]Passive:[/u][/color]\n• While your face is obscured by a cultist hood, gain [color=%positive%]+15%[/color] of your total Resolve as a bonus to melee and Ranged Defense.\n\n• Also works with cultist leather hood, leather helmet, sack, decayed sack helm, warlock hood or mask of davkul.\n\n• Unlocks a crafting recipe to make cultist hoods and sacks.\n"
        es = "\nEn el Dolor hallamos la verdad de nosotros mismos. No tenemos identidad más allá de la servidumbre; nuestra gloria es la agonía.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Mientras una capucha de cultista te cubra el rostro, obtienes el [color=%positive%]+15%[/color] de tu Resolución total como bonificación a la Defensa cuerpo a cuerpo y a distancia.\n\n• También funciona con la capucha de cuero de cultista, el yelmo de cuero, el saco, el yelmo de saco podrido, la capucha de brujo o la máscara de Davkul.\n\n• Desbloquea una receta de fabricación para hacer capuchas y sacos de cultista.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecCultArmor
    {
        en = "\nOnly in suffering can we know truth.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+75%[/color] of your missing Hitpoints as Resolve, while wearing cultist robes, barbarian hide, bone armor or warlock robes.\n\n• Adds [color=%positive%]+5%[/color] maximum damage for every hostile entity adjacent to you.\n\n• Unlocks a crafting recipe to make cultist robes.\n"
        es = "\nSolo en el sufrimiento podemos conocer la verdad.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes como Resolución el [color=%positive%]+75%[/color] de los Puntos de vida que te falten mientras lleves túnicas de cultista, pieles de bárbaro, armadura de hueso o túnicas de brujo.\n\n• Añade [color=%positive%]+5%[/color] de daño máximo por cada entidad hostil adyacente a ti.\n\n• Desbloquea una receta de fabricación para hacer túnicas de cultista.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPrepareBleed
    {
        // ::Const.Strings.PerkDescription.LegendPrepareBleed <- "\nTime spent assessing an enemy, finding the arteries, will pay off in blood shed on the field.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Prepare to Bleed[/color] skill which primes your next strike to inflict [color=%damage%]5[/color] [color=%status%]Bleed[/color] damage for the next two turns.\n\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]15[/color] Fatigue.\n\n• When [color=%status%]Dual Wielding[/color] cleavers or whips, both attacks apply [color=%status%]Bleed[/color].\n";
        mode = "pattern"
        en = "\nTime spent assessing an enemy, finding the arteries, will pay off in blood shed on the field.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Prepare to Bleed[/color] skill which primes your next strike to inflict [color=%damage%]5[/color] [color=%status%]Bleed[/color] damage for the next two turns.\n\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]15[/color] Fatigue.\n\n• When [color=%status%]Dual Wielding[/color] cleavers or whips, both attacks apply [color=%status%]Bleed[/color].\n"
        es = "\nEl tiempo dedicado a estudiar al enemigo y a buscarle las arterias se cobrará en sangre derramada en el campo.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Preparar sangrado[/color], que prepara tu siguiente golpe para infligir [color=%damage%]5[/color] de daño por [color=%status%]Sangrado[/color] durante los dos turnos siguientes.\n\n• Cuesta [color=%negative%]2[/color] PA y [color=%negative%]15[/color] de Fatiga.\n\n• Al ir [color=%status%]Con dos armas[/color] con cuchillas o látigos, ambos ataques aplican [color=%status%]Sangrado[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPrepareGraze
    {
        // ::Const.Strings.PerkDescription.LegendPrepareGraze <- "\nLong, slow, deep rending scratches that leave many bleeding grazes.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Prepare to Graze[/color] skill which primes your next strike to inflict [color=%damage%]2[/color] [color=%status%]Bleed[/color] damage for the next five turns.\n\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]15[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nLong, slow, deep rending scratches that leave many bleeding grazes.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Prepare to Graze[/color] skill which primes your next strike to inflict [color=%damage%]2[/color] [color=%status%]Bleed[/color] damage for the next five turns.\n\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\nArañazos largos, lentos y profundos que dejan muchas rozaduras sangrantes.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Preparar rozaduras[/color], que prepara tu siguiente golpe para infligir [color=%damage%]2[/color] de daño por [color=%status%]Sangrado[/color] durante los cinco turnos siguientes.\n\n• Cuesta [color=%negative%]2[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendCarnage
    {
        // ::Const.Strings.PerkDescription.LegendCarnage <- "\nIf it bleeds, we can kill it.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]20%[/color] damage when attacking a [color=%status%]Bleeding[/color] enemy.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Prepare to Bleed[/color] skill which primes your next strike to inflict [color=%damage%]5[/color] [color=%status%]Bleed[/color] damage for the next two turns.\n\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]15[/color] Fatigue.\n\n• When [color=%status%]Dual Wielding[/color] cleavers or whips, both attacks apply [color=%status%]Bleed[/color].\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Prepare to Graze[/color] skill which primes your next strike to inflict [color=%damage%]2[/color] [color=%status%]Bleed[/color] damage for the next five turns.\n\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]15[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nIf it bleeds, we can kill it.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]20%[/color] damage when attacking a [color=%status%]Bleeding[/color] enemy.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Prepare to Bleed[/color] skill which primes your next strike to inflict [color=%damage%]5[/color] [color=%status%]Bleed[/color] damage for the next two turns.\n\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]15[/color] Fatigue.\n\n• When [color=%status%]Dual Wielding[/color] cleavers or whips, both attacks apply [color=%status%]Bleed[/color].\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Prepare to Graze[/color] skill which primes your next strike to inflict [color=%damage%]2[/color] [color=%status%]Bleed[/color] damage for the next five turns.\n\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\nSi sangra, podemos matarlo.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes un [color=%positive%]20%[/color] de daño al atacar a un enemigo que esté [color=%status%]Sangrando[/color].\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Preparar sangrado[/color], que prepara tu siguiente golpe para infligir [color=%damage%]5[/color] de daño por [color=%status%]Sangrado[/color] durante los dos turnos siguientes.\n\n• Cuesta [color=%negative%]2[/color] PA y [color=%negative%]15[/color] de Fatiga.\n\n• Al ir [color=%status%]Con dos armas[/color] con cuchillas o látigos, ambos ataques aplican [color=%status%]Sangrado[/color].\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Preparar rozaduras[/color], que prepara tu siguiente golpe para infligir [color=%damage%]2[/color] de daño por [color=%status%]Sangrado[/color] durante los cinco turnos siguientes.\n\n• Cuesta [color=%negative%]2[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendUntouchable
    {
        en = "\nStaying hidden is about more than just clever disguise, one must be prepared to avoid stray blows and arrows in the heat of battle.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Extends your camouflage by two turns.\n"
        es = "\nPasar desapercibido exige algo más que un disfraz ingenioso: hay que saber esquivar golpes y flechas perdidas en el fragor de la batalla.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Prolonga tu camuflaje dos turnos.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendAssassinate
    {
        // ::Const.Strings.PerkDescription.LegendAssassinate <- "\n Striking from the shadows allows you to bypass enemy defenses and strike for their undefended weak points.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants [color=%positive%]+20%[/color] maximum and minimum damage while [color=%status%]Hidden[/color] by being within a bush or smoke.\n\n• Assassins who specialize in the art of stealth gain [color=%positive%]+30%[/color] instead.\n\n• Master assassins more deadly in stealth and killing gain [color=%positive%]+50%[/color].\n";
        mode = "pattern"
        en = "\n Striking from the shadows allows you to bypass enemy defenses and strike for their undefended weak points.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants [color=%positive%]+20%[/color] maximum and minimum damage while [color=%status%]Hidden[/color] by being within a bush or smoke.\n\n• Assassins who specialize in the art of stealth gain [color=%positive%]+30%[/color] instead.\n\n• Master assassins more deadly in stealth and killing gain [color=%positive%]+50%[/color].\n"
        es = "\n Atacar desde las sombras te permite sortear las defensas enemigas y golpear sus puntos débiles desprotegidos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga [color=%positive%]+20%[/color] de daño máximo y mínimo en estado [color=%status%]Oculto[/color] por estar dentro de un arbusto o del humo.\n\n• Los Asesinos especializados en el arte del sigilo obtienen [color=%positive%]+30%[/color] en su lugar.\n\n• Los maestros asesinos, más letales en el sigilo y en la matanza, obtienen [color=%positive%]+50%[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMealPreperation
    {
        en = "\nA good company chef can make a meal from whatever can be scrounged up, and have it in your belly before camp breaks.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Unlocks a chance to get better food rewards when this character is assigned to the Camp Kitchen in camp.\n\n• The chance and rewards increase as you level up. Includes porridge, pies and puddings.\n"
        es = "\nUn buen cocinero de compañía puede preparar una comida con lo que se pueda rapiñar y tenértela en la barriga antes de levantar el campamento.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Desbloquea la probabilidad de obtener mejores recompensas de comida cuando este personaje está asignado a la Cocina del campamento.\n\n• La probabilidad y las recompensas aumentan al subir de nivel. Incluye gachas, pasteles y budines.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendAlcoholBrewing
    {
        en = "\nAny camp worth its salt will have an alcohol still fashioned out of whatever can be pulled together.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Unlocks a chance to get alcohol as a reward when this character is assigned to the Camp Kitchen in camp.\n\n• The rewards increase as you level up. Includes beer, wine and mead.\n\n• Allows alcohol crafting in the Crafting Tent.\n"
        es = "\nTodo campamento que se precie tiene un alambique improvisado con lo que se haya podido reunir.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Desbloquea la probabilidad de obtener alcohol como recompensa cuando este personaje está asignado a la Cocina del campamento.\n\n• Las recompensas aumentan al subir de nivel. Incluye cerveza, vino e hidromiel.\n\n• Permite fabricar alcohol en la Tienda de fabricación.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorseCharge
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Use the great weight and speed of the horse to charge forward. Move up to four spaces and attack an enemy.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Usa el gran peso y la velocidad del caballo para cargar hacia delante. Muévete hasta cuatro casillas y ataca a un enemigo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorsePirouette
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• Learning to turn quickly allows quick changes in direction required to escape enemies.\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aprender a girar rápido permite los cambios bruscos de dirección necesarios para escapar de los enemigos.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorseBitting
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• Getting a horse accustomed to the feel of a bit and a bridle, makes it easier to control the movements. This increases defenses in battle by 25% of the rider's Melee Defense.\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Acostumbrar a un caballo al bocado y la brida facilita controlar sus movimientos. Aumenta las defensas en batalla en un 25% de la Defensa cuerpo a cuerpo del jinete.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorseDesensitization
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• Using loud noises and sudden movements, the horse is trained to not react to the sounds of battle until the rider tells it to. This increases melee attack in battle by 25% of the rider's melee attack\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Con ruidos fuertes y movimientos bruscos, se entrena al caballo para que no reaccione a los sonidos de la batalla hasta que el jinete se lo indique. Aumenta el ataque cuerpo a cuerpo en batalla en un 25% del ataque cuerpo a cuerpo del jinete\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHippology
    {
        en = "\nKnowledge of an animal's physiology allows for better diet, exercise and care.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increases Hitpoints by [color=%positive%]25%[/color] for donkeys in the company and their carrying capacity by [color=%positive%]+12[/color].\n\n• Does not stack with the same perk on multiple mercenaries.\n"
        es = "\nConocer la fisiología de un animal permite darle mejor dieta, ejercicio y cuidados.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aumenta en un [color=%positive%]25%[/color] los Puntos de vida de los burros de la compañía y en [color=%positive%]+12[/color] su capacidad de carga.\n\n• No se acumula con la misma ventaja en varios mercenarios.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorseImpulsion
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• Effective leverage of equestrian physiology relaxes the spinal column and allows the hindquarters to engage effectively. Increases Initiative by 25%\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aprovechar bien la fisiología equina relaja la columna y permite que los cuartos traseros trabajen con eficacia. Aumenta la Iniciativa en un 25%\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorseLeadChange
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• A horse's lead leg can tire, by training a horse to swap legs it is possible to prevent the horse from tiring. Movement costs 25% less Fatigue.\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• La pata guía de un caballo puede cansarse; si se le enseña a cambiar de pata, se evita que se agote. El movimiento cuesta un 25% menos de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorseLegControl
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• it is not possible to hold the reins while firing a bow. Horse and rider must learn to communicate through the rider's legs. Increases ranged attack in battle by 25%\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• No es posible sujetar las riendas mientras se dispara un arco. Caballo y jinete deben aprender a comunicarse mediante las piernas del jinete. Aumenta el ataque a distancia en batalla en un 25%\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorseLiberty
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• Though extensive roundpenning training, the horse gains trust in the movements of the rider. This increases Resolve in battle by 25% of the rider's Resolve\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Mediante un extenso adiestramiento en corral redondo, el caballo aprende a confiar en los movimientos del jinete. Aumenta la Resolución en batalla en un 25% de la Resolución del jinete\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorseLongeing
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• Time spent working on a long rope helps build trust between horse and rider. Increases Resolve by 25%\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• El tiempo dedicado a trabajar con la cuerda larga ayuda a crear confianza entre caballo y jinete. Aumenta la Resolución en un 25%\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorseParthianShot
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• shooting from a moving horse is not easy, extensive practice is required to reliably achieve such a feat. Increases ranged attack by 25%\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Disparar desde un caballo en movimiento no es fácil; hace falta mucha práctica para lograrlo con fiabilidad. Aumenta el ataque a distancia en un 25%\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorsePiaffe
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• Keeping a horse moving can retain their focus and prepare them for an oncoming battle. Increases melee attack in battle by 25%\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Mantener a un caballo en movimiento le permite conservar la concentración y prepararse para la batalla que se avecina. Aumenta el ataque cuerpo a cuerpo en combate un 25%\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorseTempiChange
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• the most challenging form of lead change, a tempi change requires shifting back and forth between lead legs. This form of training can allow the horse to change lead leg according to the situation, useful when under fire. Increases Ranged Defense by 25%\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• La forma más exigente de cambio de pie, el cambio de pie a tiempo exige alternar una y otra vez el pie de galope. Este entrenamiento permite al caballo cambiar de pie según la situación, algo útil cuando está bajo fuego. Aumenta la Defensa a distancia un 25%\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorseCollection
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• By training the horse's posture, advanced movements become easier to perform and less draining. Increases Fatigue by 25%\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Al trabajar la postura del caballo, los movimientos avanzados resultan más fáciles de ejecutar y menos agotadores. Aumenta la Fatiga un 25%\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorseFlyingChange
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• Changing lead legs at high speeds is an advanced move that can allow horses to cover much larger distances. Gain 1 action point.\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Cambiar de pie a gran velocidad es un movimiento avanzado que permite a los caballos recorrer distancias mucho mayores. Otorga 1 punto de acción.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorsePassage
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• Training the legs to raise higher and push harder can prepare horses for rough or muddy terrain. Decreases movement costs on rough terrain.\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Entrenar las patas para que se eleven más y empujen con más fuerza prepara a los caballos para terrenos abruptos o embarrados. Reduce el coste de movimiento en terreno abrupto.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendDrumsOfLife
    {
        // ::Const.Strings.PerkDescription.LegendDrumsOfLife <- "\nLearn powerful rhythms that drive your allies on.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Drums of Life[/color] skill which restores [color=%positive%]+4[/color] Hitpoints to every ally within eight tiles.\n\n• Can only be used with a Drum or Lute equipped.\n\n• Costs [color=%negative%]8[/color] AP and [color=%negative%]30[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nLearn powerful rhythms that drive your allies on.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Drums of Life[/color] skill which restores [color=%positive%]+4[/color] Hitpoints to every ally within eight tiles.\n\n• Can only be used with a Drum or Lute equipped.\n\n• Costs [color=%negative%]8[/color] AP and [color=%negative%]30[/color] Fatigue.\n"
        es = "\nAprende ritmos poderosos que impulsan a tus aliados.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Tambores de Vida[/color], que restaura [color=%positive%]+4[/color] Puntos de vida a cada aliado en un radio de ocho casillas.\n\n• Solo se puede usar con un Tambor o un Laúd equipado.\n\n• Cuesta [color=%negative%]8[/color] PA y [color=%negative%]30[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendLacerate
    {
        // ::Const.Strings.PerkDescription.LegendLacerate <- "\nLust for blood courses through your veins, each stroke rips and tears with a ferocity unmatched.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Cause minor but long-lasting [color=%status%]Bleeding[/color] on any target you deal direct Hitpoints damage to with any weapon.\n\n• The [color=%status%]Bleed[/color] deals [color=%damage%]2[/color] damage per turn and lasts five turns.\n\n• This effect stacks.\n";
        mode = "pattern"
        en = "\nLust for blood courses through your veins, each stroke rips and tears with a ferocity unmatched.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Cause minor but long-lasting [color=%status%]Bleeding[/color] on any target you deal direct Hitpoints damage to with any weapon.\n\n• The [color=%status%]Bleed[/color] deals [color=%damage%]2[/color] damage per turn and lasts five turns.\n\n• This effect stacks.\n"
        es = "\nLa sed de sangre corre por tus venas; cada golpe desgarra y despedaza con una ferocidad sin igual.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Provoca un [color=%status%]Sangrado[/color] leve pero duradero en cualquier objetivo al que inflijas daño directo a los Puntos de vida con cualquier arma.\n\n• El [color=%status%]Sangrado[/color] inflige [color=%damage%]2[/color] de daño por turno y dura cinco turnos.\n\n• Este efecto es acumulable.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPeaceful
    {
        en = "\nNot all folks are built for war, some find contentment in contemplation or practicing a trade.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants [color=%positive%]+20[/color] Resolve and [color=%positive%]+5%[/color] experience gain, in exchange for [color=%negative%]-20[/color] Melee and Ranged Skill.\n\n• Becomes content with being in reserve, and consumes half rations while there.\n\n• When in combat, this character grants [color=%positive%]+3[/color] Resolve and [color=%positive%]+1%[/color] XP gain to allies.\n"
        es = "\nNo todo el mundo está hecho para la guerra; hay quien encuentra la dicha en la contemplación o en ejercer un oficio.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga [color=%positive%]+20[/color] de Resolución y [color=%positive%]+5%[/color] de experiencia obtenida, a cambio de [color=%negative%]-20[/color] de Habilidad cuerpo a cuerpo y Habilidad a distancia.\n\n• Se conforma con estar en la reserva y allí consume media ración.\n\n• En combate, este personaje otorga a sus aliados [color=%positive%]+3[/color] de Resolución y [color=%positive%]+1%[/color] de experiencia obtenida.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSummonHound
    {
        en = "\nForming close bonds with hounds grants the ability to call to them.\n\n[color=%active%][u]Active:[/u][/color]\n• Summon a loyal hound to your side in battle.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\nForjar lazos estrechos con los sabuesos te permite llamarlos.\n\n[color=%active%][u]Activo:[/u][/color]\n• Invoca a un sabueso leal a tu lado en combate.\n\n• Cuesta [color=%negative%]5[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSummonWolf
    {
        en = "\nCultivating a relationship with the wolves allows you to call them to your side.\n\n[color=%active%][u]Active:[/u][/color]\n• Summon a wolf to aid you in battle.\n\n• Costs [color=%negative%]7[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\nCultivar una relación con los lobos te permite llamarlos a tu lado.\n\n[color=%active%][u]Activo:[/u][/color]\n• Invoca a un lobo para que te ayude en combate.\n\n• Cuesta [color=%negative%]7[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSummonFalcon
    {
        en = "\nYears spent feeding and caring for falcons has made them your friends.\n\n[color=%active%][u]Active:[/u][/color]\n• Summon a falcon to guide you in battle.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\nLos años que has pasado alimentando y cuidando halcones los han convertido en tus amigos.\n\n[color=%active%][u]Activo:[/u][/color]\n• Invoca a un halcón para que te guíe en combate.\n\n• Cuesta [color=%negative%]6[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSummonBear
    {
        en = "\nEndless communion with the animals has won you the trust of the bears.\n\n[color=%active%][u]Active:[/u][/color]\n• Adds a pet bear to your stash, make sure you have space before taking this perk.\n\n• Unlocks an event to tame bears in the woods.\n"
        es = "\nTu comunión constante con los animales te ha ganado la confianza de los osos.\n\n[color=%active%][u]Activo:[/u][/color]\n• Añade un oso domesticado a tu inventario; asegúrate de tener espacio antes de elegir esta ventaja.\n\n• Desbloquea un evento para domar osos en el bosque.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSummonCatapult
    {
        en = "\nPut to use your skill in the creation and maintenance of siege weapons.\n\n[color=%passive%][u]Passive:[/u][/color]\n Unlocks crafting Catapults in the crafting tent.\n"
        es = "\nPon a trabajar tu destreza en la construcción y el mantenimiento de armas de asedio.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n Desbloquea la fabricación de Catapultas en la tienda de fabricación.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendNetRepair
    {
        en = "\nMany years spent repairing and packing nets allows you to create nets and wield them more effectively.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Reduces the refill cost of nets to 10.\n\n• Grants[color=%positive%]+10[/color] Melee Defense while holding a net.\n\n• Ignore the weight of nets, both when equipped or in your bag.\n"
        es = "\nLos muchos años reparando y plegando redes te permiten fabricarlas y manejarlas con más eficacia.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Reduce a 10 el coste de recarga de las redes.\n\n• Otorga [color=%positive%]+10[/color] de Defensa cuerpo a cuerpo mientras sostienes una red.\n\n• Ignora el peso de las redes, tanto equipadas como en la bolsa.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendNetCasting
    {
        en = "\nPerfect the art of casting nets.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increases the throwing range of nets and reinforced nets by [color=%positive%]2[/color] and the throwing range of bombs by [color=%positive%]1[/color].\n\n• Chance based on your Ranged Skill and Ranged Defense to trap additional adjacent targets when throwing a net. The chance decreases with each target you ensnare.\n"
        es = "\nPerfecciona el arte de lanzar redes.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aumenta en [color=%positive%]2[/color] el alcance de lanzamiento de las redes y las redes reforzadas, y en [color=%positive%]1[/color] el de las bombas.\n\n• Probabilidad, basada en tu Habilidad a distancia y tu Defensa a distancia, de atrapar a objetivos adyacentes adicionales al lanzar una red. La probabilidad disminuye con cada objetivo que atrapas.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPacifist
    {
        en = "\nFighting is a brutal thuggish pastime, most folk prefer a life without frequent bouts of extreme violence.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants [color=%positive%]+10%[/color] Resolve.\n\n• This character now gains experience from battle while in reserves.\n\n• Additionally, this character does not count towards your party strength when determining game difficulty.\n\n• Become content with being in reserve, and each battle in which they are forced to attack in worsens their mood.\n"
        es = "\nLuchar es un pasatiempo brutal propio de matones; la mayoría de la gente prefiere una vida sin frecuentes arrebatos de violencia extrema.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga [color=%positive%]+10%[/color] de Resolución.\n\n• Este personaje ahora gana experiencia de los combates mientras está en la reserva.\n\n• Además, este personaje no cuenta para la fuerza de tu compañía a la hora de determinar la dificultad de la partida.\n\n• Se conforma con estar en la reserva, y cada combate en el que se le obliga a atacar empeora su ánimo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicMissile
    {
        en = "\n\n\n[color=%active%][u]Active:[/u][/color]\n• Release a controlled forceful bolt, leaping towards a foe. Damage based on current Initiative, accuracy based on ranged attack skill.\n"
        es = "\n\n\n[color=%active%][u]Activo:[/u][/color]\n• Libera un proyectil de fuerza controlado que salta hacia un enemigo. El daño se basa en la Iniciativa actual y la precisión, en la Habilidad a distancia.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHorseMovement
    {
        en = "\n\n\n[color=%passive%][u]Passive:[/u][/color]\nMove like a horse, quickly across flat terrain, but slowly through bogs and mountains.\n"
        es = "\n\n\n[color=%passive%][u]Pasivo:[/u][/color]\nMuévete como un caballo: rápido por terreno llano, pero lento por ciénagas y montañas.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendCampCook
    {
        en = "\nThere is a fine art to cooking, skills and ingredients that are not obvious but unlock a world of flavor or preserve food for longer.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Unlocks food crafting in the crafting tent.\n\n• Allows the creation of porridge, puddings, pies, meat curing, fruit drying and ration making.\n"
        es = "\nCocinar es todo un arte, con técnicas e ingredientes que no saltan a la vista pero que abren un mundo de sabores o conservan la comida durante más tiempo.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Desbloquea la fabricación de comida en la tienda de fabricación.\n\n• Permite preparar gachas, budines y empanadas, curar carne, secar fruta y hacer raciones.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPackleader
    {
        en = "\nDogs can instinctively identify a pack leader, knowledge of their habits allows you to become the leader of their pack.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Unlocks the ability to store additional dog items in your bags and use them in battle.\n"
        es = "\nLos perros reconocen por instinto al líder de la manada; conocer sus hábitos te permite convertirte en el líder de su manada.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Desbloquea la capacidad de guardar objetos de perro adicionales en tu bolsa y usarlos en combate.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendDogWhisperer
    {
        en = "\nYou have a way with dogs, the bond you form with them imbues each dog with more confidence and strength, knowing that you are there gives them strength.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants each dog you unleash the perks: [color=%perk%]Colossus[/color], [color=%perk%]Fortified Mind[/color], and [color=%perk%]Underdog[/color].\n"
        es = "\nTienes buena mano con los perros; el vínculo que formas con ellos infunde a cada uno más confianza y fuerza, y saber que estás ahí los fortalece.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga a cada perro que sueltas las ventajas [color=%perk%]Coloso[/color], [color=%perk%]Mentalidad fuerte[/color] y [color=%perk%]Desvalido[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendDogBreeder
    {
        en = "\nIntimate knowledge of dog care and conditions required for breeding allows you to successfully breed dogs.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Unlocks a recipe in the crafting tent for breeding dogs.\n"
        es = "\nUn conocimiento profundo del cuidado de los perros y de las condiciones necesarias para su cría te permite criarlos con éxito.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Desbloquea en la tienda de fabricación una receta para criar perros.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendDogHandling
    {
        en = "\nYou have mastered the art of training dogs.\n\n[color=%active%][u]Active:[/u][/color]\n• In the heat of battle your hounds will respond and react to your commands, order them to attack or defend allies.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]0[/color] Fatigue.\n"
        es = "\nDominas el arte de adiestrar perros.\n\n[color=%active%][u]Activo:[/u][/color]\n• En el fragor del combate tus sabuesos responderán a tus órdenes; ordénales atacar o defender a los aliados.\n\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]0[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendDogMaster
    {
        en = "\nYour way with animals extends so far as turning those dogs that would do you harm.\n\n[color=%active%][u]Active:[/u][/color]\n• By spending [color=%negative%]1[/color] item of food you can make a dog flee from battle.\n\n• The food item is chosen at random and the perk does not work if you have less than 25 food.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]0[/color] Fatigue.\n"
        es = "\nTu mano con los animales llega al punto de poner de tu parte a los perros que querrían hacerte daño.\n\n[color=%active%][u]Activo:[/u][/color]\n• Gastando [color=%negative%]1[/color] unidad de comida puedes hacer que un perro huya del combate.\n\n• La comida se elige al azar y la ventaja no funciona si tienes menos de 25 de comida.\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]0[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHeightenedReflexes
    {
        en = "\nYour heightened senses leads your strikes to vitals.\n\n[color=%passive%][u]Passive:[/u][/color]\n• [color=%positive%]15%[/color] of your current Initiative will be translated into damage done.\n"
        es = "\nTus sentidos agudizados dirigen tus golpes a los puntos vitales.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• El [color=%positive%]15%[/color] de tu Iniciativa actual se convierte en daño infligido.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendWindReader
    {
        en = "\nYou have learned to read the wind, estimating the path of arrows in uncertain conditions.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain a third of your character's base Ranged Defense as Ranged Skill, with a minimum bonus of [color=%positive%]3[/color].\n\n• Gain [color=%positive%]+5%[/color] Ranged Damage for each level difference when you have the high ground.\n"
        es = "\nHas aprendido a leer el viento y a calcular la trayectoria de las flechas en condiciones inciertas.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes como Habilidad a distancia un tercio de la Defensa a distancia base de tu personaje, con una bonificación mínima de [color=%positive%]3[/color].\n\n• Obtienes [color=%positive%]+5%[/color] de daño a distancia por cada nivel de diferencia cuando estás en terreno elevado.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPaymaster
    {
        en = "\nShifting numbers is a fine art, by negotiating pay terms and usury it is possible to drive down mercenary pay.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Lowers daily wages for all mercenaries in the company by a percentage equal to your barter skill.\n\n• This perk is only counted once per company.\n"
        es = "\nMover cifras es todo un arte; negociando las condiciones de pago y con usura se puede rebajar la paga de los mercenarios.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Reduce el salario diario de todos los mercenarios de la compañía en un porcentaje igual a tu habilidad de Regateo.\n\n• Esta ventaja solo cuenta una vez por compañía.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendQuartermaster
    {
        en = "\nBy cooking bulk meals, using scraps, and saving leftovers you can save food for the company.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Reduces food consumption by [color=%negative%]1[/color] for every mercenary.\n\n• This perk is only counted once per company.\n"
        es = "\nCocinando en grandes cantidades, aprovechando los restos y guardando las sobras, puedes ahorrar comida a la compañía.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Reduce en [color=%positive%]1[/color] el consumo de comida de cada mercenario.\n\n• Esta ventaja solo cuenta una vez por compañía.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBarterGreed
    {
        en = "\nThis character is keen to guard the horde of gold the company has accumulated — and intends to protect it with their life.\n\n[color=%passive%][u]Passive:[/u][/color]\n• For every 10,000 crowns you have in your stash:\n- Gain [color=%positive%]+1[/color] to Melee Skill and Ranged Skill.\n- Gain [color=%positive%]+1[/color] as Melee Defense and Ranged Defense.\n- Gain [color=%positive%]+1.5[/color] to Resolve.\n- Gain [color=%positive%]+1.5[/color] to Initiative.\n\n• The Bonus gained from Crowns is capped at 160000.\n\n• Additionally, your global Barter is divided by [color=%negative%](1 + Brothers with this perk)[/color] at all times.\n"
        es = "\nEste personaje vela con celo por el tesoro de oro que ha acumulado la compañía, y piensa protegerlo con su vida.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Por cada 10,000 coronas que tengas en tu inventario:\n- Obtienes [color=%positive%]+1[/color] de Habilidad cuerpo a cuerpo y Habilidad a distancia.\n- Obtienes [color=%positive%]+1[/color] de Defensa cuerpo a cuerpo y Defensa a distancia.\n- Obtienes [color=%positive%]+1.5[/color] de Resolución.\n- Obtienes [color=%positive%]+1.5[/color] de Iniciativa.\n\n• La bonificación obtenida por las coronas tiene un límite de 160000.\n\n• Además, tu Regateo global se divide en todo momento entre [color=%negative%](1 + hermanos con esta ventaja)[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPrayerOfLife
    {
        // ::Const.Strings.PerkDescription.LegendPrayerOfLife <- "\nA prayer of hope and love restores wellbeing to your allies and tears at the undead.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Prayer of Hope[/color] skill.\n\n• When activated adjacent allies gain [color=%positive%]+20%[/color] of your current Resolve as Hitpoints spread out over several turns. Can not heal more than 10 Hitpoints per turn.\n\n• Inflicts a disintegrating ailment on each adjacent undead dealing [color=%damage%]10[/color] damage per turn for two turns.\n\n• Does not work on cultists.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]30[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nA prayer of hope and love restores wellbeing to your allies and tears at the undead.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Prayer of Hope[/color] skill.\n\n• When activated adjacent allies gain [color=%positive%]+20%[/color] of your current Resolve as Hitpoints spread out over several turns. Can not heal more than 10 Hitpoints per turn.\n\n• Inflicts a disintegrating ailment on each adjacent undead dealing [color=%damage%]10[/color] damage per turn for two turns.\n\n• Does not work on cultists.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]30[/color] Fatigue.\n"
        es = "\nUna plegaria de esperanza y amor devuelve el bienestar a tus aliados y desgarra a los no muertos.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Plegaria de esperanza[/color].\n\n• Al activarla, los aliados adyacentes obtienen como Puntos de vida un [color=%positive%]+20%[/color] de tu Resolución actual, repartidos a lo largo de varios turnos. No puede curar más de 10 Puntos de vida por turno.\n\n• Inflige a cada no muerto adyacente un mal desintegrador que causa [color=%damage%]10[/color] de daño por turno durante dos turnos.\n\n• No funciona contra los cultistas.\n\n• Cuesta [color=%negative%]6[/color] PA y [color=%negative%]30[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPrayerOfFaith
    {
        // ::Const.Strings.PerkDescription.LegendPrayerOfFaith <- "\nA prayer of devotion grants strength to your allies and baffles the undead.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Prayer of Faith[/color] skill.\n\n• When activated adjacent allies gain [color=%positive%]20%[/color] of your current Resolve as a bonus to Melee and Ranged Defense.\n\n• Adjacent cultists and undead are [color=%status%]Baffled[/color].\n\n• [color=%status%]Baffled[/color] enemies suffer [color=%negative%]-15%[/color] Damage, Max Fatigue, and Initiative.\n\n•  Costs [color=%negative%]6[/color] AP and [color=%negative%]30[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nA prayer of devotion grants strength to your allies and baffles the undead.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Prayer of Faith[/color] skill.\n\n• When activated adjacent allies gain [color=%positive%]20%[/color] of your current Resolve as a bonus to Melee and Ranged Defense.\n\n• Adjacent cultists and undead are [color=%status%]Baffled[/color].\n\n• [color=%status%]Baffled[/color] enemies suffer [color=%negative%]-15%[/color] Damage, Max Fatigue, and Initiative.\n\n•  Costs [color=%negative%]6[/color] AP and [color=%negative%]30[/color] Fatigue.\n"
        es = "\nUna plegaria de devoción da fuerza a tus aliados y desconcierta a los no muertos.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Plegaria de fe[/color].\n\n• Al activarla, los aliados adyacentes obtienen el [color=%positive%]20%[/color] de tu Resolución actual como bonificación a la Defensa cuerpo a cuerpo y a la Defensa a distancia.\n\n• Los cultistas y no muertos adyacentes reciben el estado [color=%status%]Desconcertado[/color].\n\n• Los enemigos con el estado [color=%status%]Desconcertado[/color] sufren [color=%negative%]-15%[/color] de daño, Fatiga máxima e Iniciativa.\n\n• Cuesta [color=%negative%]6[/color] PA y [color=%negative%]30[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHolyFlame
    {
        // ::Const.Strings.PerkDescription.LegendHolyFlame <- "\nThe old gods have allowed you to wield their light.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Holy Flame[/color] skill.\n\n• When activated imbues a tile and its surrounding tiles with the Sanctified Ground effect for two turns.\n\n• Human allies within the area become [color=%status%]Sanctified[/color], gaining immunity to [color=%status%]Injuries[/color], [color=%status%]Bleeding[/color], [color=%status%]Poisoned[/color], and [color=%status%]Morale checks[/color] when taking damage.\n\n• Cultists and Undead become [color=%status%]Consecrated[/color], taking [color=%damage%]10[/color] to [color=%damage%]20[/color] damage each turn, and lose any immunity to [color=%status%]Injuries[/color], [color=%status%]Bleeding[/color], and [color=%status%]Poison[/color].\n\n• Consecrated Wichts will lose [color=%status%]Battle Forged[/color].\n\n• Additionally, Undead cannot resurrect in the area while the flame is active.\n\n• Costs [color=%negative%]7[/color] AP and [color=%negative%]30[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nThe old gods have allowed you to wield their light.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Holy Flame[/color] skill.\n\n• When activated imbues a tile and its surrounding tiles with the Sanctified Ground effect for two turns.\n\n• Human allies within the area become [color=%status%]Sanctified[/color], gaining immunity to [color=%status%]Injuries[/color], [color=%status%]Bleeding[/color], [color=%status%]Poisoned[/color], and [color=%status%]Morale checks[/color] when taking damage.\n\n• Cultists and Undead become [color=%status%]Consecrated[/color], taking [color=%damage%]10[/color] to [color=%damage%]20[/color] damage each turn, and lose any immunity to [color=%status%]Injuries[/color], [color=%status%]Bleeding[/color], and [color=%status%]Poison[/color].\n\n• Consecrated Wichts will lose [color=%status%]Battle Forged[/color].\n\n• Additionally, Undead cannot resurrect in the area while the flame is active.\n\n• Costs [color=%negative%]7[/color] AP and [color=%negative%]30[/color] Fatigue.\n"
        es = "\nLos viejos dioses te han permitido empuñar su luz.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Llama sagrada[/color].\n\n• Al activarla, imbuye una casilla y las casillas que la rodean con el efecto Suelo santificado durante dos turnos.\n\n• Los aliados humanos dentro del área reciben el estado [color=%status%]Santificado[/color] y obtienen inmunidad a las [color=%status%]Heridas[/color], al [color=%status%]Sangrado[/color], al estado [color=%status%]Envenenado[/color] y a las [color=%status%]tiradas de moral[/color] al recibir daño.\n\n• Los cultistas y los no muertos reciben el estado [color=%status%]Consagrado[/color], sufren de [color=%damage%]10[/color] a [color=%damage%]20[/color] de daño cada turno y pierden cualquier inmunidad a las [color=%status%]Heridas[/color], al [color=%status%]Sangrado[/color] y al [color=%status%]Veneno[/color].\n\n• Los Wichts consagrados pierden [color=%status%]Forjado en batalla[/color].\n\n• Además, los no muertos no pueden resucitar en el área mientras la llama esté activa.\n\n• Cuesta [color=%negative%]7[/color] PA y [color=%negative%]30[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendShieldsUp
    {
        // ::Const.Strings.PerkDescription.LegendShieldsUp <- "\nDrilling your troops in a shieldwall prepares their reaction time to avoid early deaths on the battlefield.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Taking this perk ensures every mercenary with a shield will use [color=%skill%]shieldwall[/color] before the start of each battle.\n";
        mode = "pattern"
        en = "\nDrilling your troops in a shieldwall prepares their reaction time to avoid early deaths on the battlefield.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Taking this perk ensures every mercenary with a shield will use [color=%skill%]shieldwall[/color] before the start of each battle.\n"
        es = "\nAdiestrar a tus tropas en el muro de escudos agiliza sus reflejos y evita muertes tempranas en el campo de batalla.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Con esta ventaja, todo mercenario con escudo usará [color=%skill%]Muro de escudos[/color] antes del comienzo de cada combate.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendIncoming
    {
        // ::Const.Strings.PerkDescription.LegendIncoming <- "\nDirect allies to attack at once, granting enhanced skills and defense.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Incoming![/color] skill which Grants [color=%positive%]+5[/color] Ranged Skill, [color=%positive%]+5[/color] Resolve and [color=%positive%]+10[/color] Ranged Defense to all allies within four tiles for one turn.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]20[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nDirect allies to attack at once, granting enhanced skills and defense.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Incoming![/color] skill which Grants [color=%positive%]+5[/color] Ranged Skill, [color=%positive%]+5[/color] Resolve and [color=%positive%]+10[/color] Ranged Defense to all allies within four tiles for one turn.\n\n• Costs [color=%negative%]5[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = "\nOrdena a tus aliados atacar a la vez, lo que mejora sus habilidades y su defensa.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]¡A cubierto![/color], que otorga [color=%positive%]+5[/color] de Habilidad a distancia, [color=%positive%]+5[/color] de Resolución y [color=%positive%]+10[/color] de Defensa a distancia a todos los aliados en un radio de cuatro casillas durante un turno.\n\n• Cuesta [color=%negative%]5[/color] PA y [color=%negative%]20[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendZombieBite
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• braaaains\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• ceeeerebrooos\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendCheerOn
    {
        // ::Const.Strings.PerkDescription.LegendCheerOn <- "\nUse your way with song to cheer on an ally.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Cheer On[/color] skill which Grants [color=%positive%]+2[/color] Action Points to an ally adjacent to you.\n\n• Can only be used with an Instrument or Banner equipped.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]30[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nUse your way with song to cheer on an ally.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Cheer On[/color] skill which Grants [color=%positive%]+2[/color] Action Points to an ally adjacent to you.\n\n• Can only be used with an Instrument or Banner equipped.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]30[/color] Fatigue.\n"
        es = "\nUsa tu don para el canto y anima a un aliado.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Animar[/color], que otorga [color=%positive%]+2[/color] Puntos de acción a un aliado adyacente.\n\n• Solo puede usarse con un instrumento o un estandarte equipado.\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]30[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendLeap
    {
        // ::Const.Strings.PerkDescription.LegendLeap <- "\nUse your athletic skill to leap high and far.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Leap[/color] skill which allows you to quickly cover two tiles distance.\n\n• Fatigue cost is increased by the weight of your armor.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]15[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nUse your athletic skill to leap high and far.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Leap[/color] skill which allows you to quickly cover two tiles distance.\n\n• Fatigue cost is increased by the weight of your armor.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\nUsa tus dotes atléticas para saltar alto y lejos.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Salto[/color], que te permite recorrer rápidamente una distancia de dos casillas.\n\n• El coste de Fatiga aumenta con el peso de tu armadura.\n\n• Cuesta [color=%negative%]6[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendTumble
    {
        en = "\nMake use of your acrobatic skill to dodge attacks and move out of trouble.\n\n[color=%passive%][u]Passive:[/u][/color]\n• As long as there's a free tile adjacent to you grant a chance to have any attacker require two successful attack rolls in order to hit. If the attack is ranged you will use your Melee Defense and if the attack is melee you will use your Ranged Defense for the reroll. On a successful reroll you will be moved to a random tile.\n\n• Disabled if you are rooted or stunned.\n\n• Stacks with 'Lucky' or [color=%perk%]Premonition[/color] with the chance of either being added to the chance to reroll.\n"
        es = "\nAprovecha tu destreza acrobática para esquivar ataques y salir de apuros.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Mientras haya una casilla libre adyacente a ti, otorga una probabilidad de que cualquier atacante necesite dos tiradas de ataque con éxito para impactarte. Si el ataque es a distancia, usarás tu Defensa cuerpo a cuerpo para repetir la tirada, y si el ataque es cuerpo a cuerpo, tu Defensa a distancia. Si la repetición tiene éxito, te desplazarás a una casilla al azar.\n\n• Se desactiva si sufres inmovilización o aturdimiento.\n\n• Se acumula con 'Afortunado' o con [color=%perk%]Premonición[/color], y la probabilidad de cualquiera de ellos se suma a la de repetir la tirada.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHairSplitter
    {
        en = "\nYears of practice throwing things at apples above heads have granted a magnetic attraction to the cranium.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Grants [color=%positive%]+30%[/color] chance to hit the head.\n"
        es = "\nAños de práctica lanzando cosas a manzanas sobre cabezas te han dado una atracción magnética por el cráneo.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga [color=%positive%]+30%[/color] de probabilidad de impactar en la cabeza.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBearform
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Transform into a powerful bear, doubles your Hitpoints. Requires free hands.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Transfórmate en un oso poderoso, lo que duplica tus Puntos de vida. Requiere tener las manos libres.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendRoots
    {
        // ::Const.Strings.PerkDescription.LegendRoots <- "\nSummon roots and vines to entangle your enemies.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Root[/color] skill which allows you to [color=%status%]Root[/color] any enemy within eight tiles.\n\n• [color=%status%]Rooted[/color] enemies have their Melee Defense, Ranged Defense, and Initiative reduced by [color=%negative%]35%[/color].\n\n• If affected by rain AP cost is reduced by [color=%negative%]1[/color] and Fatigue cost is reduced by [color=%negative%]10[/color].\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]15[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nSummon roots and vines to entangle your enemies.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Root[/color] skill which allows you to [color=%status%]Root[/color] any enemy within eight tiles.\n\n• [color=%status%]Rooted[/color] enemies have their Melee Defense, Ranged Defense, and Initiative reduced by [color=%negative%]35%[/color].\n\n• If affected by rain AP cost is reduced by [color=%negative%]1[/color] and Fatigue cost is reduced by [color=%negative%]10[/color].\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]15[/color] Fatigue.\n"
        es = "\nInvoca raíces y enredaderas para atrapar a tus enemigos.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Enraizar[/color], que te permite [color=%status%]Enraizar[/color] a cualquier enemigo en un radio de ocho casillas.\n\n• Los enemigos con el estado [color=%status%]Enraizado[/color] ven reducidas un [color=%negative%]35%[/color] su Defensa cuerpo a cuerpo, su Defensa a distancia y su Iniciativa.\n\n• Bajo los efectos de la lluvia, el coste de PA se reduce en [color=%negative%]1[/color] y el de Fatiga en [color=%negative%]10[/color].\n\n• Cuesta [color=%negative%]6[/color] PA y [color=%negative%]15[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendWolfform
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Transform into a nimble wolf, decreasing movement costs. Requires free hands.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Transfórmate en un lobo ágil, lo que reduce el coste de movimiento. Requiere tener las manos libres.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendTrueForm
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• Increases the length of your transformations to six turns.\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aumenta a seis turnos la duración de tus transformaciones.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSummonStorm
    {
        // ::Const.Strings.PerkDescription.LegendSummonStorm <- "\nControl the elements, calling down the rain.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Summon Storm[/color] skill.\n\n• The first cast brings on light rain, the second cast brings a heavy storm.\n\n• Must have empty hands.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]20[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nControl the elements, calling down the rain.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Summon Storm[/color] skill.\n\n• The first cast brings on light rain, the second cast brings a heavy storm.\n\n• Must have empty hands.\n\n• Costs [color=%negative%]4[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = "\nControla los elementos y haz que caiga la lluvia.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Invocar tormenta[/color].\n\n• El primer lanzamiento trae una lluvia ligera; el segundo, una fuerte tormenta.\n\n• Debes tener las manos vacías.\n\n• Cuesta [color=%negative%]4[/color] PA y [color=%negative%]20[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendCallLightning
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Call down lightning upon your enemies. Grants a 10% chance to unleash lightning on each unit within 4 tiles. Must have empty hands and it must be raining.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Haz caer rayos sobre tus enemigos. Otorga un 10% de probabilidad de desatar un rayo sobre cada unidad en un radio de 4 casillas. Debes tener las manos vacías y tiene que estar lloviendo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendScryTrance
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Scries an area of 12 tiles around the user. The user will be unable to move or act during the trance until cancelled. Minimum of one turn channel.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Escruta un área de 12 casillas alrededor del usuario. Durante el trance, el usuario no podrá moverse ni actuar hasta que lo cancele. Canalización mínima de un turno.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendReadOmensTrance
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• The user enters a trance, telling all allies of their future. Grants [color=%positive%]10%[/color] chance to have any attacker require two successful attack rolls in order to hit.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• El usuario entra en trance y revela a todos los aliados su futuro. Otorga un [color=%positive%]10%[/color] de probabilidad de que cualquier atacante necesite dos tiradas de ataque con éxito para impactar.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendDistantVisions
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• This character spends a lot of time alone outside camp, staring into the distance and smoking strange bark. Allows the user to have distant visions of towns.  Each morning this character is in reserves grants you insight into a specific town's current events and buildings.\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Este personaje pasa mucho tiempo a solas fuera del campamento, con la mirada perdida en la distancia y fumando una corteza extraña. Permite al usuario tener visiones lejanas de ciudades. Cada mañana que este personaje está en la reserva te revela los sucesos actuales y los edificios de una ciudad concreta.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendScrollIngredients
    {
        // ::Const.Strings.PerkDescription.LegendScrollIngredients <- "\nAll those years of studying ancient languages finally has a use.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Allows the user to create Scrolls when given Cloth and Dyes.\n\n• Created scrolls can randomly be one of the following: 'Scroll of .Nut'in', 'Scroll of Natural Talent', 'Battle Scroll', 'Scroll of Experience', 'Scroll of Training'. They will be a trade item, gain the user a Gifted level up, gain [color=%positive%]50%[/color] additional experience for 3 battles, instantly gain [color=%positive%]100-150[/color] experience or instantly gain [color=%positive%]1[/color] training point, respectively.\n\n• These scrolls will make the user [color=%status%]Irritable[/color] but with a significantly lower day cooldown than reading a book or scroll. They also do not negatively impact how many books or scrolls you can read.\n";
        mode = "pattern"
        en = "\nAll those years of studying ancient languages finally has a use.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Allows the user to create Scrolls when given Cloth and Dyes.\n\n• Created scrolls can randomly be one of the following: 'Scroll of .Nut'in', 'Scroll of Natural Talent', 'Battle Scroll', 'Scroll of Experience', 'Scroll of Training'. They will be a trade item, gain the user a Gifted level up, gain [color=%positive%]50%[/color] additional experience for 3 battles, instantly gain [color=%positive%]100-150[/color] experience or instantly gain [color=%positive%]1[/color] training point, respectively.\n\n• These scrolls will make the user [color=%status%]Irritable[/color] but with a significantly lower day cooldown than reading a book or scroll. They also do not negatively impact how many books or scrolls you can read.\n"
        es = "\nTantos años estudiando lenguas antiguas por fin sirven para algo.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Permite al usuario crear pergaminos con rollos de tela y tintes.\n\n• Los pergaminos creados pueden ser, al azar, uno de los siguientes: 'Scroll of .Nut'in', 'Pergamino de talento natural', 'Pergamino de batalla', 'Pergamino de experiencia', 'Pergamino de entrenamiento'. Darán, respectivamente, un objeto para comerciar, una subida de nivel de Dotado al usuario, un [color=%positive%]50%[/color] de experiencia adicional durante 3 batallas, [color=%positive%]100-150[/color] de experiencia al instante o [color=%positive%]1[/color] punto de entrenamiento intensivo al instante.\n\n• Estos pergaminos dejan al usuario [color=%status%]Irritable[/color], pero con un tiempo de espera en días mucho menor que leer un libro o un pergamino. Además, no reducen el número de libros o pergaminos que puedes leer.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendScholar
    {
        en = "\nPut your all into your studies.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Allows the user to be counted as 'educated' for events, regardless if other conditions are met or they have the 'dumb' trait.\n\n• [color=%positive%]10%[/color] chance to get any items from slain enemies, that might not otherwise be available to loot.\n\n• Stacks with itself and effects of a similar nature. Does not need to be in combat for this perk to work.\n"
        es = "\nVuélcate por completo en tus estudios.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Permite que el usuario cuente como 'con estudios' en los eventos, aunque no se cumplan otras condiciones o tenga el rasgo 'tonto'.\n\n• [color=%positive%]10%[/color] de probabilidad de obtener de los enemigos abatidos cualquier objeto que de otro modo no estaría disponible como botín.\n\n• Se acumula consigo mismo y con efectos de naturaleza similar. No es necesario estar en combate para que esta ventaja funcione.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendCitrinitas
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• A powerful cocktail of ingredients provides a trance like state, granting the banner effect, and drums of war effects to everyone in the company at the end of the user's turn.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Un potente cóctel de ingredientes induce un estado similar al trance y otorga a todos los miembros de la compañía los efectos del estandarte y de los tambores de guerra al final del turno del usuario.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendAlbedo
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• A concoction of secret materials that allows the user to restore up to 25 armor to a target.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Un brebaje de materiales secretos que permite al usuario restaurar hasta 25 de armadura a un objetivo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendNigredo
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• An alchemical mixture of acidic vapours, encased in flasks that can be thrown at the enemy to dissolves their armor.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Una mezcla alquímica de vapores ácidos, encerrada en frascos que pueden lanzarse al enemigo para disolver su armadura.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHerbcraft
    {
        en = "\nKnowledge of the properties of various roots and herbs lets you construct medicines from base ingredients.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Allows the creation of medicine, antidotes and poisons in the crafting tent.\n"
        es = "\nConocer las propiedades de diversas raíces y hierbas te permite elaborar medicinas a partir de ingredientes básicos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Permite fabricar medicina, antídotos y venenos en la tienda de fabricación.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendWoodworking
    {
        en = "\nThe ability to cut and shape wood is a craft few master.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Allows the creation of fine wood from rough wood in the crafting tent.\n\n• Allows this character to harvest wood while in camp.\n"
        es = "\nCortar y dar forma a la madera es un oficio que pocos dominan.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Permite obtener madera fina a partir de madera basta en la tienda de fabricación.\n\n• Permite a este personaje recoger madera mientras está en el campamento.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendOreHunter
    {
        en = "\n'Come all you young fellers, so young and so fine, and seek not your fortune in the dark dreary mine'.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Allows this character to mine for minerals while assigned to the Supply Tent in camp.\n"
        es = "\n'Vengan todos, muchachos, tan jóvenes y apuestos, y no busquen fortuna en la mina oscura y lúgubre'.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Permite a este personaje extraer minerales mientras está asignado a la Tienda de suministros del campamento.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSurpressUrges
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• Allows this character to control shapeshifting to some extent, no longer deliberately striking allies and foes alike while transformed.\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Permite a este personaje controlar hasta cierto punto sus transformaciones, de modo que ya no ataca deliberadamente por igual a aliados y enemigos mientras dura la transformación.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendControlInstincts
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• Gives character self control while transformed.\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Otorga al personaje autocontrol durante la transformación.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMasterAnger
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• Allows the character to transform at will, no longer randomly transforming during battle.\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Permite al personaje transformarse a voluntad; ya no se transforma al azar durante el combate.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicBurningHands
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Unleash a cone of blistering heat from your palms, can hit up to 9 targets for 10-15 damage.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Desata desde tus palmas un cono de calor abrasador que puede alcanzar hasta 9 objetivos e infligir 10-15 de daño.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicChainLightning
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Fire a bolt of lightning at an enemy that can arc to two adjacent enemies.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Lanza contra un enemigo un rayo que puede saltar a dos enemigos adyacentes.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicCircleOfProtection
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• A magic circle that protects all allies within casting. Leaving the circle breaks the protection.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Un círculo mágico que protege a todos los aliados que estén dentro al lanzarlo. Salir del círculo rompe la protección.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicDaze
    {
        // ::Const.Strings.PerkDescription.LegendMagicDaze <- "\n[color=%active%][u]Active:[/u][/color]\n• Assault the senses of your target with a conjured flurry of colorful sparks, whirs, and pops. Such an astonishing display is sure to leave anyone too [color=%status%]Bewildered[/color] to fight effectively.\n\n Does no damage.\n";
        mode = "pattern"
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Assault the senses of your target with a conjured flurry of colorful sparks, whirs, and pops. Such an astonishing display is sure to leave anyone too [color=%status%]Bewildered[/color] to fight effectively.\n\n Does no damage.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Asalta los sentidos de tu objetivo con una lluvia conjurada de chispas de colores, zumbidos y chasquidos. Semejante espectáculo dejará a cualquiera demasiado [color=%status%]Perplejo[/color] para luchar con eficacia.\n\n No inflige daño.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicHailstone
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Conjure a heavy ball of ice to crush your enemies.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Conjura una pesada bola de hielo para aplastar a tus enemigos.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicHealingWind
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Restore the Hitpoints of all allies within 4 tiles. Must be holding a magic staff to use.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Restaura los Puntos de vida de todos los aliados en un radio de 4 casillas. Requiere sostener un bastón mágico.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicImbue
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Imbue someone with magical power, temporarily increasing accuracy and damage.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Imbuye a alguien de poder mágico, lo que aumenta temporalmente su precisión y su daño.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicLevitate
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Levitate someone off the ground, granting them the ability to move freely across all terrain for a short duration.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Haz levitar a alguien sobre el suelo, lo que le permite moverse libremente por cualquier terreno durante un breve tiempo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicMissile
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• A burst of force, leaping forward into a foe.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Un estallido de fuerza que salta hacia adelante contra un enemigo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicPsybeam
    {
        // ::Const.Strings.PerkDescription.LegendMagicPsybeam <- "\n[color=%active%][u]Active:[/u][/color]\n• Launch a mental attack in the form of a ray at an enemy to [color=%status%]Stun[/color] or [color=%status%]Daze[/color] them. Does no damage.\n";
        mode = "pattern"
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Launch a mental attack in the form of a ray at an enemy to [color=%status%]Stun[/color] or [color=%status%]Daze[/color] them. Does no damage.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Lanza contra un enemigo un ataque mental en forma de rayo para [color=%status%]Aturdir[/color] o [color=%status%]Atontar[/color] al objetivo. No inflige daño.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicSleep
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Use soothing vapours to lull an enemy to sleep. The chance of success is determined by the Resolves of the user and target.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Usa vapores sedantes para sumir a un enemigo en el sueño. La probabilidad de éxito depende de la Resolución del usuario y del objetivo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicSoothingWind
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Restore the Fatigue of all allies within 4 tiles. Must be holding a magic staff to use.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Restaura la Fatiga de todos los aliados en un radio de 4 casillas. Requiere sostener un bastón mágico.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicTeleport
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Teleport a short distance away.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Teletranspórtate a corta distancia.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicWebBolt
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Send a web of silk out to ensnare an opponent, rooting them in place halving their damage, defenses and Initiative.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Lanza una telaraña de seda para atrapar a un adversario, inmovilizándolo en el sitio y reduciendo a la mitad su daño, sus defensas y su Iniciativa.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMasteryBurningHands
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Increases the intensity of your heat, doubles the damage of burning hands.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Aumenta la intensidad de tu calor y duplica el daño de las manos ardientes.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMasteryChainLightning
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Lightning gains +10% chance to hit and +1 range.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• El rayo obtiene +10% de probabilidad de impactar y +1 de alcance.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMasteryHailstone
    {
        en = "\n[color=%active%][u]Active:[/u][/color]\n• Hailstone can now ignore 65% of armor and inflicts 125% damage to armor.\n"
        es = "\n[color=%active%][u]Activo:[/u][/color]\n• Pedrisco ahora ignora el 65% de la armadura e inflige el 125% de daño a la armadura.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicMissileFocus
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• Reduce AP cost of Magic Missile by 1.\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Reduce en 1 el coste de PA de Proyectil mágico.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMagicMissileMastery
    {
        en = "\n[color=%passive%][u]Passive:[/u][/color]\n• Reduce AP and cost of Magic Missile by 1. Reduce the base Fatigue cost of Magic Missile by 6.\n"
        es = "\n[color=%passive%][u]Pasivo:[/u][/color]\n• Reduce en 1 el coste de PA de Proyectil mágico. Reduce en 6 el coste base de Fatiga de Proyectil mágico.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendUnarmedLunge
    {
        // ::Const.Strings.PerkDescription.LegendUnarmedLunge <- "\nIn one motion take a step forward and land a blow on your enemy.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Unarmed Lunge[/color] skill which lets you move a tile and attack in a single action while unarmed.\n\n• Does [color=%positive%]10-20[/color] damage without Unarmed Training.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]30[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nIn one motion take a step forward and land a blow on your enemy.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Unarmed Lunge[/color] skill which lets you move a tile and attack in a single action while unarmed.\n\n• Does [color=%positive%]10-20[/color] damage without Unarmed Training.\n\n• Costs [color=%negative%]6[/color] AP and [color=%negative%]30[/color] Fatigue.\n"
        es = "\nEn un solo movimiento, da un paso adelante y asesta un golpe a tu enemigo.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Estocada sin armas[/color], que te permite moverte una casilla y atacar en una sola acción mientras luchas sin armas.\n\n• Inflige [color=%positive%]10-20[/color] de daño sin Entrenamiento sin armas.\n\n• Cuesta [color=%negative%]6[/color] PA y [color=%negative%]30[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendThrowSand
    {
        // ::Const.Strings.PerkDescription.LegendThrowSand <- "\nIts hard to fight with sand in your eyes.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Throw Dirt[/color] skill which allows you to throw dirt in the eyes of an enemy to distract them.\n\n• [color=%status%]Distracted[/color] enemies have their Initiative and damage reduced by [color=%negative%]35%[/color].\n\n• Can only be used once per fight.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]5[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nIts hard to fight with sand in your eyes.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Throw Dirt[/color] skill which allows you to throw dirt in the eyes of an enemy to distract them.\n\n• [color=%status%]Distracted[/color] enemies have their Initiative and damage reduced by [color=%negative%]35%[/color].\n\n• Can only be used once per fight.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]5[/color] Fatigue.\n"
        es = "\nCuesta pelear con arena en los ojos.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Lanzar tierra[/color], que te permite arrojar tierra a los ojos de un enemigo para distraerlo.\n\n• Los enemigos con el estado [color=%status%]Distraído[/color] ven reducidos su Iniciativa y su daño en un [color=%negative%]35%[/color].\n\n• Solo puede usarse una vez por combate.\n\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]5[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBackflip
    {
        en = "\nExtensive training in circus maneuvers allows you to move out of harm's way with astonishing speed.\n\n[color=%passive%][u]Passive:[/u][/color]\n• If you have taken the [color=%perk%]Footwork[/color] or [color=%perk%]Leap[/color] perk, they gain [color=%positive%]1[/color] range.\n"
        es = "\nUn entrenamiento intensivo en maniobras circenses te permite apartarte del peligro con una rapidez asombrosa.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Si tienes la ventaja [color=%perk%]Juego de pies[/color] o [color=%perk%]Salto[/color], su alcance aumenta en [color=%positive%]1[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendTwirl
    {
        // ::Const.Strings.PerkDescription.LegendTwirl <- "\nPractice in physical movement with a partner has given the ability to take the lead and move someone's body in a twirling movement.\n\n[color=%passive%][u]Passive:[/u][/color]\n• [color=%skill%]Rotation[/color] can now target enemies.\n";
        mode = "pattern"
        en = "\nPractice in physical movement with a partner has given the ability to take the lead and move someone's body in a twirling movement.\n\n[color=%passive%][u]Passive:[/u][/color]\n• [color=%skill%]Rotation[/color] can now target enemies.\n"
        es = "\nLa práctica de movimientos en pareja te ha dado la capacidad de llevar a tu pareja y hacer girar su cuerpo.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• [color=%skill%]Rotación[/color] ahora puede usarse sobre enemigos.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendOpportunist
    {
        // ::Const.Strings.PerkDescription.LegendOpportunist <- "\nMake the most of the opportunity's presented to you in battle.\n\n[color=%passive%][u]Passive:[/u][/color]\n• When successfully landing a hit on an enemy who is [color=%status%]Bleeding[/color] or [color=%status%]Poisoned[/color], apply [color=%status%]Dazed[/color] to them.\n\n• If you are within a smoke cloud, you will gain [color=%positive%]+10%[/color] Melee Skill and no penalty to Ranged Skill.\n";
        mode = "pattern"
        en = "\nMake the most of the opportunity's presented to you in battle.\n\n[color=%passive%][u]Passive:[/u][/color]\n• When successfully landing a hit on an enemy who is [color=%status%]Bleeding[/color] or [color=%status%]Poisoned[/color], apply [color=%status%]Dazed[/color] to them.\n\n• If you are within a smoke cloud, you will gain [color=%positive%]+10%[/color] Melee Skill and no penalty to Ranged Skill.\n"
        es = "\nAprovecha al máximo las oportunidades que se te presentan en combate.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Al impactar a un enemigo con [color=%status%]Sangrado[/color] o en estado [color=%status%]Envenenado[/color], le aplicas el estado [color=%status%]Atontado[/color].\n\n• Si estás dentro de una nube de humo, obtienes [color=%positive%]+10%[/color] de Habilidad cuerpo a cuerpo y ninguna penalización a la Habilidad a distancia.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPrepared
    {
        en = "\nCoat your blade with posion.\n\n[color=%passive%][u]Passive:[/u][/color]\n• While using a dagger, dealing Hitpoints damage to an enemy has a [color=%positive%]+33%[/color] chance of poisoning them.\n\n• You will also gain [color=%positive%]+12[/color] Melee Skill and [color=%positive%]+3[/color] Fatigue recovery per turn while holding a dagger in your mainhand.\n"
        es = "\nUnta tu hoja con veneno.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Mientras usas una daga, infligir daño a los Puntos de vida de un enemigo tiene un [color=%positive%]+33%[/color] de probabilidad de envenenarlo.\n\n• Además, obtienes [color=%positive%]+12[/color] de Habilidad cuerpo a cuerpo y [color=%positive%]+3[/color] de recuperación de Fatiga por turno mientras sostienes una daga en la mano principal.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendLurker
    {
        // ::Const.Strings.PerkDescription.LegendLurker <- "\n'I work better alone.'\n\n[color=%passive%][u]Passive:[/u][/color]\n• When neither ally nor enemy is within 2 tiles, gain [color=%positive%]+30%[/color] Ranged Defense, [color=%positive%]+20[/color] Initiative, and [color=%positive%]+3[/color] Action Points.\n\n• If you are under the effects of [color=%status%]Hidden[/color], gain [color=%positive%]+10[/color] Fatigue recovery per turn and [color=%positive%]+20%[/color] Ranged Skill.\n\n• If you are within a smoke cloud, gain [color=%positive%]+2[/color] maximum Action Points.\n";
        mode = "pattern"
        en = "\n'I work better alone.'\n\n[color=%passive%][u]Passive:[/u][/color]\n• When neither ally nor enemy is within 2 tiles, gain [color=%positive%]+30%[/color] Ranged Defense, [color=%positive%]+20[/color] Initiative, and [color=%positive%]+3[/color] Action Points.\n\n• If you are under the effects of [color=%status%]Hidden[/color], gain [color=%positive%]+10[/color] Fatigue recovery per turn and [color=%positive%]+20%[/color] Ranged Skill.\n\n• If you are within a smoke cloud, gain [color=%positive%]+2[/color] maximum Action Points.\n"
        es = "\n'Trabajo mejor por mi cuenta.'\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Cuando no hay ningún aliado ni enemigo en un radio de 2 casillas, obtienes [color=%positive%]+30%[/color] de Defensa a distancia, [color=%positive%]+20[/color] de Iniciativa y [color=%positive%]+3[/color] Puntos de acción.\n\n• Si estás bajo los efectos de [color=%status%]Oculto[/color], obtienes [color=%positive%]+10[/color] de recuperación de Fatiga por turno y [color=%positive%]+20%[/color] de Habilidad a distancia.\n\n• Si estás dentro de una nube de humo, obtienes [color=%positive%]+2[/color] Puntos de acción máximos.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendNightRaider
    {
        en = "\nGain enhanced vision and tactical advantages at night.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain [color=%positive%]+1[/color] vision and become unaffected by night time penalties.\n\n• When attacking at night, adjacent enemies will lose [color=%negative%]10[/color] Resolve.\n\n• Gain [color=%positive%]+10%[/color] Melee and Ranged Skill while fighting at night.\n"
        es = "\nObtén una visión mejorada y ventajas tácticas de noche.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes [color=%positive%]+1[/color] de visión y no te afectan las penalizaciones nocturnas.\n\n• Al atacar de noche, los enemigos adyacentes pierden [color=%positive%]10[/color] de Resolución.\n\n• Obtienes [color=%positive%]+10%[/color] de Habilidad cuerpo a cuerpo y Habilidad a distancia al combatir de noche.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendAdaptive
    {
        en = "\nWho says you can't teach an old dog new tricks?\n\n[color=%passive%][u]Passive:[/u][/color]\n Add a new Perk Group to this character's Perk Tree based on what is currently equipped in their hands, which is checked in the following order...\n\n• [color=%positive%]Mainhand items:[/color] always checked first, giving priority to 'Specialist' Classes before Weapon Perk Groups.\n\n• [color=%positive%]Hybrid Weapons:[/color] the character will be given the Perk Group they do not have, or be given one randomly from the applicable Weapon Types if they have neither.\n\n• [color=%positive%]Offhand items:[/color] same as above.\n\n• [color=%positive%]Unarmed:[/color] If no items are equipped, they will gain the Unarmed Perk Group if they do not have it.\n\n•[color=%positive%]Armor:[/color] If armor weight is between [color=%negative%]0[/color] and [color=%negative%]15[/color] they will receive Light armor perk group. If weight is between [color=%negative%]16[/color] and [color=%negative%]35[/color] they will receive Medium armor perk group. If weight is over [color=%negative%]35[/color] they will receive Heavy armor perk group.\n\n• [color=%negative%]If the character has all the Perk Groups of their equipped items, they will be given a random Trait Perk Group they do not have.[/color]\n\n• When this character reaches level [color=%positive%]15[/color], the perk point spent is refunded.\n"
        es = "\n¿Quién dice que a perro viejo no se le pueden enseñar trucos nuevos?\n\n[color=%passive%][u]Pasivo:[/u][/color]\n Añade un nuevo grupo de ventajas al árbol de ventajas de este personaje según lo que tenga equipado en las manos, comprobando en el siguiente orden...\n\n• [color=%positive%]Objetos de la mano principal:[/color] siempre se comprueban primero, dando prioridad a las clases de 'Especialista' sobre los grupos de ventajas de armas.\n\n• [color=%positive%]Armas híbridas:[/color] el personaje recibirá el grupo de ventajas que no tenga, o uno al azar entre los tipos de arma aplicables si no tiene ninguno.\n\n• [color=%positive%]Objetos de la mano secundaria:[/color] igual que el anterior.\n\n• [color=%positive%]Sin armas:[/color] si no tiene ningún objeto equipado, recibirá el grupo de ventajas Sin armas si no lo tiene.\n\n•[color=%positive%]Armadura:[/color] si el peso de la armadura está entre [color=%negative%]0[/color] y [color=%negative%]15[/color], recibirá el grupo de ventajas de armadura liviana. Si el peso está entre [color=%negative%]16[/color] y [color=%negative%]35[/color], recibirá el grupo de ventajas de armadura media. Si el peso supera [color=%negative%]35[/color], recibirá el grupo de ventajas de armadura pesada.\n\n• [color=%negative%]Si el personaje ya tiene todos los grupos de ventajas de los objetos que lleva equipados, recibirá al azar un grupo de ventajas de rasgo que no tenga.[/color]\n\n• Cuando este personaje alcanza el nivel [color=%positive%]15[/color], se le reembolsa el punto de ventaja gastado.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendRecuperation
    {
        en = "\nHeal more effectively over time.\n\n[color=%passive%][u]Passive:[/u][/color]\n• At the end of combat recover [color=%positive%]30%[/color] of your missing health and injuries recover [color=%positive%]1[/color] day faster.\n"
        es = "\nTe curas con más eficacia con el paso del tiempo.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Al final del combate recuperas el [color=%positive%]30%[/color] de la salud perdida y las heridas sanan [color=%positive%]1[/color] día antes.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendClimb
    {
        // ::Const.Strings.PerkDescription.LegendClimb <- "\nLearn to scale cliffs with unmatched speed!\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Climb[/color] skill which allows you to climb sheer cliffs up to five levels of height in one action.\n\n• Does not trigger attacks of opportunity.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]20[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nLearn to scale cliffs with unmatched speed!\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Climb[/color] skill which allows you to climb sheer cliffs up to five levels of height in one action.\n\n• Does not trigger attacks of opportunity.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = "\n¡Aprende a escalar acantilados con una rapidez sin igual!\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Trepar[/color], que te permite trepar por acantilados escarpados de hasta cinco niveles de altura en una sola acción.\n\n• No provoca ataques de oportunidad.\n\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]20[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendBlendIn
    {
        en = "\nHold yourself in a way that makes you seem more trouble than its worth, lean into trees, place objects between you and an enemy, and hide behind allies.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Makes enemies [color=%positive%]50%[/color] less likely to attack you instead of an ally.\n\n• Grants [color=%positive%]+5[/color] Ranged Defense and [color=%positive%]+3[/color] Melee Defense.\n"
        es = "\nAdopta una postura que te haga parecer más problemático de lo que vale la pena: apóyate en los árboles, interpón objetos entre tú y el enemigo y escóndete detrás de tus aliados.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Reduce en un [color=%positive%]50%[/color] la probabilidad de que los enemigos te ataquen a ti en lugar de a un aliado.\n\n• Otorga [color=%positive%]+5[/color] de Defensa a distancia y [color=%positive%]+3[/color] de Defensa cuerpo a cuerpo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendFashionable
    {
        en = "\nStyle over substance.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Tabards, cloaks and helmet vanity layers weigh nothing. This impacts [color=%perk%]Nimble[/color] and [color=%perk%]Lithe[/color].\n"
        es = "\nEl estilo antes que la sustancia.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Los tabardos, las capas y los adornos de yelmo no pesan nada. Esto afecta a [color=%perk%]Ligero[/color] y a [color=%perk%]Grácil[/color].\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHimshaw
    {
        en = "\n'In short, we tailored.'\n\n[color=%passive%][u]Passive:[/u][/color]\n• This mercenary will care for their own equipment. Once a day, at the end of combat repair [color=%negative%]20%[/color] of their body and helmet.\n\n• At the start of each day additionally repair [color=%negative%]10%[/color] of their body and helmet.\n"
        es = "\n'En pocas palabras, cosimos.'\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Este personaje cuidará de su propio equipo. Una vez al día, al final del combate, repara el [color=%positive%]20%[/color] de su armadura y su yelmo.\n\n• Además, al comienzo de cada día repara el [color=%positive%]10%[/color] de su armadura y su yelmo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSwagger
    {
        en = "\nHaving an expensive, well polished armor seems to deflect blows and turn away arrows. Or at least that's what most mercenaries think.\n\n[color=%passive%][u]Passive:[/u][/color]\n• At the start of combat gain [color=%positive%]0.2%[/color] of your helmet and armor's value as armor condition and half that to the helmet. Will be removed at the end of combat.\n\n• The final armor bonus value will be increased by [color=%positive%]1%[/color] for every point of armor weight (if you have 50 armor weight then you'll receive 50% more armor).\n"
        es = "\nUna armadura cara y bien bruñida parece desviar los golpes y apartar las flechas. O eso cree la mayoría de los mercenarios.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Al comienzo del combate, obtienes como estado de la armadura el [color=%positive%]0.2%[/color] del valor de tu yelmo y tu armadura, y la mitad de eso en el yelmo. Se retira al final del combate.\n\n• El valor final de la bonificación de armadura aumenta un [color=%positive%]1%[/color] por cada punto de peso de la armadura (si tu armadura pesa 50, recibirás un 50% más de armadura).\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendHelpful
    {
        // ::Const.Strings.PerkDescription.LegendHelpful <- "\nEnhance your logistical support in battle.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Pass Item[/color] skill which allows you to give items from your bag. Taking [color=%skill%]Quick Hands[/color] reduces the Action Point cost by [color=%negative%]2[/color].\n\n• Does not work when receiving items.\n\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]5[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nEnhance your logistical support in battle.\n\n[color=%active%][u]Active:[/u][/color]\n• Unlocks the [color=%skill%]Pass Item[/color] skill which allows you to give items from your bag. Taking [color=%skill%]Quick Hands[/color] reduces the Action Point cost by [color=%negative%]2[/color].\n\n• Does not work when receiving items.\n\n• Costs [color=%negative%]2[/color] AP and [color=%negative%]5[/color] Fatigue.\n"
        es = "\nMejora tu apoyo logístico en combate.\n\n[color=%active%][u]Activo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Pasar objeto[/color], que te permite entregar objetos de tu bolsa. Con [color=%skill%]Manos ágiles[/color], el coste en Puntos de acción se reduce en [color=%negative%]2[/color].\n\n• No funciona al recibir objetos.\n\n• Cuesta [color=%negative%]2[/color] PA y [color=%negative%]5[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendLionheart
    {
        en = "\nA lion's heart beats with unyielding strength, facing every challenge with with fearless resolve!\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increases your resolve by [color=%positive%]10%[/color].\n\n• Being surrounded by enemies no longer affects your morale.\n"
        es = "\n¡Un corazón de león late con una fuerza inquebrantable y afronta cada desafío con una determinación intrépida!\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aumenta tu Resolución un [color=%positive%]10%[/color].\n\n• Que te rodeen los enemigos ya no afecta a tu moral.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendStrengthInNumbers
    {
        en = "\nSurround, distract and strike true.\n\n[color=%passive%][u]Passive:[/u][/color]\n• The bonus to hitchance in melee is doubled to [color=%positive%]+10%[/color] for each ally surrounding and distracting your target.\n"
        es = "\nRodea, distrae y golpea con precisión.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• La bonificación a la probabilidad de impacto cuerpo a cuerpo se duplica hasta [color=%positive%]+10%[/color] por cada aliado que rodee y distraiga a tu objetivo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendKeenEyesight
    {
        en = "\nLearn how to use your superb eyesight to notice the smallest movements and predict your opponent's next attack, to hit distant targets and to avoid incoming projectiles.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Gain a [color=%positive%]+3/+5[/color] bonus to Melee/Ranged Skill for each point of vision above 7.\n\n• Gain a [color=%positive%]+3/+4[/color] bonus to Melee/Ranged Defense for each point of vision above 7.\n\n• If your helmet reduces your vision score by at least 3/5 these bonuses are reduced by [color=%negative%]10%/20%[/color].\n\n• For the purposes of this perk, your current vision is calculated as if you had no helmet, only the above penalty applies.\n"
        es = "\nAprende a usar tu vista excepcional para percibir los movimientos más leves y prever el siguiente ataque de tu oponente, alcanzar objetivos lejanos y esquivar los proyectiles.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Obtienes una bonificación de [color=%positive%]+3/+5[/color] a la Habilidad cuerpo a cuerpo/Habilidad a distancia por cada punto de visión por encima de 7.\n\n• Obtienes una bonificación de [color=%positive%]+3/+4[/color] a la Defensa cuerpo a cuerpo/Defensa a distancia por cada punto de visión por encima de 7.\n\n• Si tu yelmo reduce tu visión en al menos 3/5, estas bonificaciones se reducen un [color=%negative%]10%/20%[/color].\n\n• A efectos de esta ventaja, tu visión actual se calcula como si no llevaras yelmo; solo se aplica la penalización anterior.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSleightOfHand
    {
        en = "\nAn ace up your sleeve.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Currently equipped throwing items that use ammo regain 1 ammo each turn.\n"
        es = "\nUn as en la manga.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Los objetos arrojadizos equipados que usan munición recuperan 1 de munición cada turno.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendPromisedPotential
    {
        en = "\nA natural talent, realized.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Upon picking up increase every attribute by [color=%positive%]1-6[/color] depending on how many stars each attribute has. Untalented attributes are increased by [color=%positive%]1[/color], while talented are increased by [color=%positive%]2[/color] for every star.\n"
        es = "\nUn don natural, hecho realidad.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Al elegirlo, aumenta cada atributo en [color=%positive%]1-6[/color] según cuántas estrellas tenga. Los atributos sin estrellas aumentan en [color=%positive%]1[/color], y los que tienen estrellas, en [color=%positive%]2[/color] por cada estrella.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendWheelMaintenance
    {
        en = "\nTrue caravaneers know that regular wheel maintenance is vital on the road and wilderness.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Increases movement speed on the world map by [color=%positive%]5%[/color]. Stacks with itself.\n"
        es = "\nLos verdaderos caravaneros saben que el mantenimiento regular de las ruedas es vital en los caminos y en tierras salvajes.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Aumenta la velocidad de movimiento en el mapa del mundo un [color=%positive%]5%[/color]. Se acumula consigo mismo.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendMasterTrainer
    {
        en = "\nMy sword is my best friend. It is my life. I must master it as I must master my life.\n\n[color=%passive%][u]Passive:[/u][/color]\n• As long as this character is in the training tent every character training receives an additional [color=%positive%]+10%[/color] training speed in camp.\n"
        es = "\nMi espada es mi mejor amiga. Es mi vida. Debo dominarla como debo dominar mi vida.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Mientras este personaje esté en la tienda de entrenamiento, cada personaje que entrene recibe [color=%positive%]+10%[/color] de velocidad de entrenamiento adicional en el campamento.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendWhipThemInShape
    {
        en = "\n'You maggots may yet earn my respect'.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Kills made by veteran mercenaries in the company earn [color=%positive%]+100%[/color] shared XP for mercenaries who are not yet veteran.\n\n• Veterans are level 12 and over. This character does not need to be in combat for the effect to work.\n"
        es = "\n'Puede que ustedes, gusanos, aún se ganen mi respeto'.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Las muertes que causan los mercenarios veteranos de la compañía otorgan un [color=%positive%]+100%[/color] de experiencia compartida a los mercenarios que aún no son veteranos.\n\n• Se consideran veteranos los de nivel 12 o superior. Este personaje no necesita estar en combate para que el efecto funcione.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendTacticalManeuvers
    {
        // ::Const.Strings.PerkDescription.LegendTacticalManeuvers <- "\nEvery fight is like a dance, and you have just the right moves.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Unlocks the [color=%skill%]Rotation[/color] skill which allows two characters to switch places while ignoring Zone of Control, as long as neither character is [color=%status%]Stunned[/color], [color=%status%]Rooted[/color] or otherwise disabled.\n\n• Unlocks the [color=%skill%]Footwork[/color] skill which allows you to leave a Zone of Control without triggering free attacks.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]20[/color] Fatigue.\n";
        mode = "pattern"
        en = "\nEvery fight is like a dance, and you have just the right moves.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Unlocks the [color=%skill%]Rotation[/color] skill which allows two characters to switch places while ignoring Zone of Control, as long as neither character is [color=%status%]Stunned[/color], [color=%status%]Rooted[/color] or otherwise disabled.\n\n• Unlocks the [color=%skill%]Footwork[/color] skill which allows you to leave a Zone of Control without triggering free attacks.\n\n• Costs [color=%negative%]3[/color] AP and [color=%negative%]20[/color] Fatigue.\n"
        es = "\nCada combate es como un baile, y tú tienes los pasos justos.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Desbloquea la habilidad [color=%skill%]Rotación[/color], que permite a dos personajes intercambiar sus posiciones ignorando la Zona de control, siempre que ninguno esté en estado [color=%status%]Aturdido[/color], [color=%status%]Enraizado[/color] o incapacitado de otro modo.\n\n• Desbloquea la habilidad [color=%skill%]Juego de pies[/color], que te permite abandonar una Zona de control sin provocar ataques gratuitos.\n\n• Cuesta [color=%negative%]3[/color] PA y [color=%negative%]20[/color] de Fatiga.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendVersatile
    {
        en = "\nOftentimes better than a master of one.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Confers a [color=%positive%]25%[/color] damage bonus to Ranged Damage on next attack when attacking with a Melee Attack and a [color=%positive%]25%[/color] damage bonus to Melee Damage on next attack when attacking with a Ranged Attack. If the attack misses, the effect is lost.\n\n• Gain [color=%positive%]10%[/color] of your base Ranged Skill as Melee Skill and [color=%positive%]10%[/color] of your base Melee Skill as Ranged Skill.\n"
        es = "\nA menudo, mejor que el maestro de una sola cosa.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Al atacar cuerpo a cuerpo, otorga una bonificación de [color=%positive%]25%[/color] al daño a distancia del siguiente ataque, y al atacar a distancia, una bonificación de [color=%positive%]25%[/color] al daño cuerpo a cuerpo del siguiente ataque. Si el ataque falla, el efecto se pierde.\n\n• Obtienes el [color=%positive%]10%[/color] de tu Habilidad a distancia base como Habilidad cuerpo a cuerpo y el [color=%positive%]10%[/color] de tu Habilidad cuerpo a cuerpo base como Habilidad a distancia.\n"
    }
    // context: ::Const.Strings.PerkDescription.LegendSpecDualWield
    {
        en = "\nMaster the art of fighting with a weapon in each hand.\n\n[color=%passive%][u]Passive:[/u][/color]\n• Reduces off-hand weapon damage malus from [color=%negative%]-66%[/color] to [color=%negative%]-50%[/color] when dual wielding.\n"
        es = "\nDomina el arte de luchar con un arma en cada mano.\n\n[color=%passive%][u]Pasivo:[/u][/color]\n• Reduce la penalización al daño del arma de la mano secundaria de [color=%negative%]-66%[/color] a [color=%negative%]-50%[/color] al combatir con dos armas.\n"
    }
