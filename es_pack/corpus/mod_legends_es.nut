    // FILE: scripts\skills\actives\legend_charge_skill.nut
    // context: legend_charge_skill.create.m.Description
    {
        en = "Leap into your enemies, stunning them on contact."
        es = "Lánzate de un salto contra tus enemigos y atúrdelos al contacto."
    }
    // en = "<actor:str_tag> charges and is repelled"
    // en base_es
    // en = "<actor:str_tag> charges and stuns <victim:str_tag>"
    // en base_es
    // en = "<actor:str_tag> charges"
    // en base_es
    // FILE: scripts\skills\actives\legend_cheer_on_skill.nut
    // context: legend_cheer_on_skill.create.m.Description
    {
        en = "Give it your all! Put your support behind an ally, granting them two Actions Points. Targets can only be inspired once per turn and you must be adjacent."
        es = "¡Dalo todo! Respalda a un aliado y concédele dos Puntos de acción. Cada objetivo solo puede recibir ánimos una vez por turno y debes estar adyacente."
    }
    // context: legend_cheer_on_skill.getTooltip.ret.text
    {
        en = "Grants the target 2 additional Action Points for their next turn."
        es = "Otorga al objetivo [color=#135213]2[/color] Puntos de acción adicionales en su siguiente turno."
    }
    // FILE: scripts\skills\actives\legend_choke_skill.nut
    // context: legend_choke_skill.create.m.Description
    {
        en = "A well-placed attack at an opponent's neck. Ignores all armor but is harder to hit with. Hit chance is based on target's fatigue. Damage is based on the difference in fatigue. Deals 50% damage against grappled or choked enemies. Hit chance is increased against grappled, stunned, netted, dazed, parried or sleeping enemies. Requires both hands to be free."
        es = "Un ataque bien colocado al cuello de un oponente. Ignora toda la armadura, pero es más difícil acertar con él. La probabilidad de acierto depende de la fatiga del objetivo. El daño depende de la diferencia de fatiga. Inflige un 50% del daño contra enemigos agarrados o estrangulados. La probabilidad de acierto aumenta contra enemigos agarrados, aturdidos, enredados en una red, atontados, contrarrestados o dormidos. Requiere tener ambas manos libres."
    }
    // context: legend_choke_skill.getTooltip.tooltip.extend().text
    {
        en = "[color=%positive%]+50%[/color] damage to Choked, Tackled or Grappled enemies"
        es = "[color=%positive%]+50%[/color] de daño contra enemigos Estrangulados, Derribados o Agarrados"
    }
    // context: legend_choke_skill.getTooltip.tooltip.extend().text
    {
        en = "Adds the Choked effect which reduces enemy fatigue recovery by [color=%negative%]15[/color]"
        es = "Aplica el efecto Estrangulado, que reduce la recuperación de fatiga del enemigo en [color=%positive%]15[/color]"
    }
    // context: legend_choke_skill.onGetHitFactors._tooltip.push().text
    {
        // text = "[color=%positive%]" + bonus + "%[/color] damage due to the difference in fatigue"
        mode = "pattern"
        en = "[color=%positive%]<bonus:str>%[/color] damage due to the difference in fatigue"
        es = "[color=%positive%]<bonus>%[/color] de daño por la diferencia de fatiga"
    }
    // context: legend_choke_skill.onUse.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(_user) + " choked " + this.Const.UI.getColorizedEntityName(target) + " ");
        mode = "pattern"
        en = "<user:str> choked <target:str> "
        es = "<user> estranguló a <target> "
    }
    // FILE: scripts\skills\actives\legend_citrinitas_trance_skill.nut
    // context: legend_citrinitas_trance_skill.create.m.Description
    {
        en = "Toggle Citrinitas On (Grants Drums of War and Drums of Life effects to all allies at the end of turn)"
        es = "Activar Citrinitas (otorga los efectos de Tambores de Guerra y Tambores de Vida a todos los aliados al final del turno)"
    }
    // context: legend_citrinitas_trance_skill.create.m.ToggleOffDescription
    {
        en = "Toggle Citrinitas Off"
        es = "Desactivar Citrinitas"
    }
    // FILE: scripts\skills\actives\legend_climb_skill.nut
    // context: legend_climb_skill.create.m.Description
    {
        en = "Allows you to move up or down levels. Does not trigger attacks of opportunity. Can not be used on flat ground."
        es = "Permite subir o bajar niveles de altura. No provoca ataques de oportunidad. No se puede usar en terreno llano."
    }
    // context: legend_climb_skill.getTooltip.ret.push().text
    {
        en = "[color=%negative%]Can not be used while rooted[/color]"
        es = "[color=%negative%]No se puede usar mientras se está inmovilizado[/color]"
    }
    // FILE: scripts\skills\actives\legend_command_legion_skill.nut
    // context: legend_command_legion_skill.create.m.Description
    {
        en = "Command a fighter of Centurion rank or lower to do your bidding. Targets can only be inspired once per turn. Does not work on Legates."
        es = "Ordena a un combatiente de rango Centurión o inferior que cumpla tus órdenes. Cada objetivo solo puede ser inspirado una vez por turno. No funciona con los Legados."
    }
    // context: legend_command_legion_skill.getTooltip.ret.text
    {
        en = "Grants the target Grants the target [color=%positive%]+4[/color] additional Action Points for their next turn."
        es = "Otorga al objetivo [color=%positive%]+4[/color] Puntos de acción adicionales durante su siguiente turno."
    }
    // context: legend_command_legion_skill.getTooltip.ret.text
    {
        en = "Grants the target an additional [color=%positive%]+50[/color] Initiative for their next turn."
        es = "Otorga al objetivo [color=%positive%]+50[/color] de Iniciativa adicional durante su siguiente turno."
    }
    // context: legend_command_legion_skill.getTooltip.ret.text
    {
        en = "Grants the target an additional [color=%positive%]+10[/color] Melee Skill for their next turn"
        es = "Otorga al objetivo [color=%positive%]+10[/color] de Habilidad cuerpo a cuerpo adicional durante su siguiente turno"
    }
    // context: legend_command_legion_skill.getTooltip.ret.text
    {
        en = "Grants the target an additional [color=%positive%]+5[/color] Melee Defense for their next turn"
        es = "Otorga al objetivo [color=%positive%]+5[/color] de Defensa cuerpo a cuerpo adicional durante su siguiente turno"
    }
    // context: legend_command_legion_skill.getTooltip.ret.text
    {
        en = "Grants the target an additional [color=%positive%]+15[/color] Ranged Skill for their next turn"
        es = "Otorga al objetivo [color=%positive%]+15[/color] de Habilidad a distancia adicional durante su siguiente turno"
    }
    // context: legend_command_legion_skill.getTooltip.ret.text
    {
        en = "Grants the target an additional [color=%positive%]+5[/color] Ranged Defense for their next turn"
        es = "Otorga al objetivo [color=%positive%]+5[/color] de Defensa a distancia adicional durante su siguiente turno"
    }
    // context: legend_command_legion_skill.getTooltip.ret.text
    {
        en = "Reduces damage received by [color=%positive%]50%[/color] for their next turn"
        es = "Reduce el daño recibido en un [color=%positive%]50%[/color] durante su siguiente turno"
    }
    // FILE: scripts\skills\actives\legend_coordinated_volleys_skill.nut
    // context: legend_coordinated_volleys_skill.create.m.Description
    {
        en = "Time and call the shots for archers, increasing their chance to hit."
        es = "Marca el ritmo y da la orden de disparo a los arqueros, lo que aumenta su probabilidad de acertar."
    }
    // context: legend_coordinated_volleys_skill.getTooltip.text
    {
        en = "[color=%positive%]10[/color] ranged attack to all allies within [color=%positive%]4[/color] tiles for one turn"
        es = "[color=%positive%]10[/color] de ataque a distancia para todos los aliados en un radio de [color=%positive%]4[/color] casillas durante un turno"
    }
    // context: legend_coordinated_volleys_skill.getTooltip.text
    {
        en = "[color=%positive%]5%[/color] damage bonus to all allies within [color=%positive%]4[/color] tiles for one turn"
        es = "[color=%positive%]5%[/color] de bonificación al daño para todos los aliados en un radio de [color=%positive%]4[/color] casillas durante un turno"
    }
    // FILE: scripts\skills\actives\legend_curseofyears_skill.nut
    // context: legend_curseofyears_skill.create.m.Description
    {
        en = "This curse gives the victim a glimpse of their own mortality, briefly aging them. Imagining itself with an infirm body of advanced age, the afflicted believes it is no longer capable of youthful exertions."
        es = "Esta maldición le muestra a la víctima un atisbo de su propia mortalidad y la envejece brevemente. Al imaginarse en un cuerpo achacoso de edad avanzada, quien la sufre cree que ya no es capaz de los esfuerzos propios de la juventud."
    }
    // context: legend_curseofyears_skill.getTooltip.ret.text
    {
        en = "The damage being applied in next turn has a [color=%positive%]17%[/color] chance to cause a wound. An additional stack is added in each turn, to a maximum of [color=%positive%]83%[/color]. The damage pierces armor."
        es = "El daño que se aplica en el siguiente turno tiene un [color=%positive%]17%[/color] de probabilidad de causar una herida. Cada turno se añade una acumulación más, hasta un máximo del [color=%positive%]83%[/color]. El daño atraviesa la armadura."
    }
    // context: legend_curseofyears_skill.getTooltip.ret.text
    {
        en = "Before damage is applied, the target has a [color=%damage%]30%[/color] chance to break the effect."
        es = "Antes de que se aplique el daño, el objetivo tiene un [color=%damage%]30%[/color] de probabilidad de romper el efecto."
    }
    // context: legend_curseofyears_skill.getTooltip.ret.text
    {
        en = "Decrepify has a cooldown of [color=%damage%]4[/color] turns."
        es = "Avejentar tiene un tiempo de recarga de [color=%damage%]4[/color] turnos."
    }
    // context: legend_curseofyears_skill.onDelayedEffect.Tactical.EventLog.log()
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(target) + " Died over time");
        mode = "pattern"
        en = "<target:str> Died over time"
        es = "<target> murió por el daño continuado"
    }
    // FILE: scripts\skills\actives\legend_danger_pay_skill.nut
    // context: legend_danger_pay_skill.create.m.Description
    {
        // this.m.Description = "Pay a unit " + this.m.Multiplier + "x their daily wage to set their morale to Confident and grants them the buff 'Motivated' for three turns. This skill cannot be used on brothers that don\'t have a daily wage.";
        mode = "pattern"
        en = "Pay a unit <mult:str>x their daily wage to set their morale to Confident and grants them the buff 'Motivated' for three turns. This skill cannot be used on brothers that don't have a daily wage."
        es = "Paga a una unidad <mult> veces su paga diaria para poner su moral en Confiado y otorgarle el efecto 'Motivado' durante tres turnos. Esta habilidad no se puede usar con hermanos que no tengan paga diaria."
    }
    // context: legend_danger_pay_skill.getTooltip.ret.push().text
    {
        // text = "This will cost between [color=%positive%]" + this.m.MinCost + "[/color] and [color=%positive%]" + this.m.MaxCost + "[/color]"
        mode = "pattern"
        en = "This will cost between [color=%positive%]<min:str>[/color] and [color=%positive%]<max:str>[/color]"
        es = "Costará entre [color=%positive%]<min>[/color] y [color=%positive%]<max>[/color]"
