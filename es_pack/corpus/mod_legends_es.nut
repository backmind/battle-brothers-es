    // en = "Horn and Bone"
    // en base_es
    // context: legend_barbarian_horn_upgrade.create.m.Description
    {
        en = "The ceremonial adornment of a self-proclaimed barbarian king. The rare and durable horns act as an surprisingly effective armor."
        es = "El adorno ceremonial de un autoproclamado rey bárbaro. Los raros y duraderos cuernos actúan como una armadura sorprendentemente eficaz."
    }
    // context: legend_barbarian_horn_upgrade.create.m.ArmorDescription
    {
        en = "Includes a ceremonial horn adornment."
        es = "Incluye un adorno ceremonial de cuernos."
