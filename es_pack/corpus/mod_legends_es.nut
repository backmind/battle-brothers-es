        es = "[img]gfx/ui/icons/bravery_va11.png[/img] <res_min> a <res_max>&nbsp;&nbsp;&nbsp;[img]gfx/ui/icons/melee_defense_va11.png[/img] <mdef_min> a <mdef_max>"
    }
    // context: character_background.o.getAttributesTooltip.tooltip.text
    {
        // text = "[img]gfx/ui/icons/initiative_va11.png[/img] " + a.Initiative[0] + " to " + a.Initiative[1] + bufferInitiative + "&nbsp;&nbsp;&nbsp;[img]gfx/ui/icons/ranged_defense_va11.png[/img] " + a.RangedDefense[0] + " to " + a.RangedDefense[1]
        mode = "pattern"
        en = "[img]gfx/ui/icons/initiative_va11.png[/img] <ini_min:int> to <ini_max:str>&nbsp;&nbsp;&nbsp;[img]gfx/ui/icons/ranged_defense_va11.png[/img] <rdef_min:int> to <rdef_max:int>"
        es = "[img]gfx/ui/icons/initiative_va11.png[/img] <ini_min> a <ini_max>&nbsp;&nbsp;&nbsp;[img]gfx/ui/icons/ranged_defense_va11.png[/img] <rdef_min> a <rdef_max>"
    }
    // context: character_background.o.getPerkTreeDescription
    {
        // text += "\nTier " + (i + 1) + ": ";
        mode = "pattern"
        en = "\nTier <tier:int>: "
        es = "\nNivel <tier>: "
    }
    // en = "randomcity"
    // en = "randomvizier"
    // context: character_background.o.buildDescription.vars
    // en = "randomnamefemale"  // nombre de la variable de texto %randomnamefemale%, no se muestra
    // en = "fullname"
    // context: character_background.o.buildAttributes.weighted.calc()
    // en = "Bravery"  // clave interna de atributo en buildAttributes, no se muestra
    // context: character_background.o.buildAttributes.weighted.calc()
    // en = "Stamina"  // clave interna de atributo en buildAttributes, no se muestra
    // context: character_background.o.getBackgroundTypes
    {
        // return "[color=%negative%]Background Type: " + ret.slice(0, ret.len() - 2) + "[/color]";
        mode = "pattern"
        en = "[color=%negative%]Background Type: <types:str>[/color]"
        es = "[color=%negative%]Tipo de trasfondo: <types>[/color]"
    }
    // FILE: mod_legends\hooks\skills\backgrounds\companion_1h_background.nut
    // en = "Companion"
    // en base_es
    // en = "He was with you from the start, %name%, and he was with you in retirement, leaving the company not long after you did. But he wasn't yet done with the fighting life and took up fighting for another company - his own. Having learned so much from your leadership, he is making you about as proud as any son could. Ironically, he hates the notion of you being a father figure to him, and you always tell him you'd never father a son so ugly to begin with. You keep in touch to this day."
    // en base_es
    // en = "With you from the start, %name% was as loyal as he was talented. He stayed with the company for a time before eventually leaving to forge out a path for himself. The other day, you received a letter from the mercenary stating that he had started his own company and was in dire need of help. Unfortunately, the message was dated to nearly a full year ago. When you investigated the existence of his company, you learned that it had been completely annihilated in a battle between nobles."
    // en base_es
    // en = "%name% is not known to be a big talker, but he has every right to be. \x7bHe's saved the lives of both %2h% and %ranged%. | He once spared you from an orc's wicked chain. | An assassin would have killed you in a pub were it not for this man. | A misfired crossbow nearly took out your eye - hadn't %name%'s shield been there to stop it. | He once pushed two men off a cliff using only his shield and two strong legs. | He learned how to fight from his father, a vanguard at the Battle of Many Names. | Sacrificing his family's heirloom - an old shield of wood and studded iron - he saved your life. | A man of rather consistent heroism, he pulled a drunken %2h% from a pub fire. | Faced with a horde of goblins, he used his shield and strength to push a hole in their lines, opening the way for %2h% and %ranged% to kill them all.\x7d With quick whirls and whips of his shield, the man's deflected all manner of mortal danger. Although rather quiet, you've found %name%'s place in a shield-wall to be rather indispensable."
    // en base_es
    // en = "1h"
    // context: companion_1h_background.o.onPrepareVariables._vars.push()
    // en = "2h"  // nombre de la variable %2h% en onPrepareVariables, no se muestra
    // en = "ranged"
    // FILE: mod_legends\hooks\skills\backgrounds\companion_2h_background.nut
    // en = "Brooding and at times suicidal, it's no surprise that %name% is frequently found diving into battle with nothing more than a large two-hander. \x7bClothed in murderous intent, you once saw him cleave a man in two - top to bottom. | It is said that he once cleaved a warrior orc in two, leaving the trunk of its legs still standing. | The man is known to ignore the fragility of his own mortality just to end the life of another. | He thrives being in the thick of battle where he can swing his weapons with little regard for safety or accuracy. | Supposedly, he once won a jousting tournament, but had to flee after bedding a watching nobleman's wife. | The man is not a murderer, but he would have made a fine one. | Seemingly unstoppable at times, you are glad to have the man on your side. | In a fit of bloodthirsty rage he once impaled two goblins on one pike. | A strong brute, you once saw %name% kill someone just on his backswing.\x7d He'll use any weapon you give him, but %name% has a proclivity towards those that can make calamitous ruin out of a man's body."
    // en base_es
    // FILE: mod_legends\hooks\skills\backgrounds\companion_ranged_background.nut
    // en = "%name% is one of the more talented marksman you've encountered in your travels. \x7bAfter he saved your life with an arrow into the heart of a would-be assassin, you hired the man on the spot. | Learning of the man was easy - you just had to find the winner of a local shooting competition. | He once won an archery contest that had over a hundred participants from all the lands. | It is said that he can split an arrow - mid-flight. | You found the man on a farm where, obviously, you thought his shooting talents were going to waste. | A poacher, a bowyer, an archer, the man's skills have gotten plenty of use. You suspect he readily accepted your offer for mercenary work just to say 'he's done it all'. | You once saw him shoot the moon, but that may have been some sort of trick. | A clever bowman, he once loosed two arrows simultaneously to kill a charging set of brigands.\x7d While he has a fondness for killing from afar, %name%'s no slouch in close-quarters combat."
    // en base_es
    // FILE: mod_legends\hooks\skills\backgrounds\converted_cultist_background.nut
    // en = "the Cultist"
    // en base_es
    // en = "the Mad"
    // en base_es
    // en = "the Believer"
    // en base_es
    // en = "the Insane"
    // en base_es
    // context: converted_cultist_background.o.onBuildDescription
    {
        en = "Who this figure was no longer matters. They now bear the mark of Davkul on their forehead and while their lips do not yet know the words of his newfound religion, they speak of the cult's fascination in a familiar tongue. Darkness, they say, is coming."
        es = "Quién era esta figura ya no importa. Ahora lleva la marca de Davkul en la frente y, aunque sus labios aún no conocen las palabras de su nueva religión, habla de la fascinación del culto en una lengua conocida. La oscuridad, dice, se acerca."
    }
    // FILE: mod_legends\hooks\skills\backgrounds\cripple_background.nut
    // en = "Cripple"
    // en base_es
    // context: cripple_background.o.create.m.BackgroundDescription
    {
        en = "The only thing swift about a cripple is their expected demise in a real battle."
        es = "Lo único rápido de un lisiado es su predecible muerte en una batalla real."
    }
    // context: cripple_background.o.create.m.GoodEnding
    {
        en = "It's shocking that a person of %name%'s stature survived at all, but the cripple did retire from the %companyname% with a sizeable stack of crowns. He runs an orphanage these days, spending his crowns to help the world's broken and abandoned children. That, or it's just a front for cheap labor. Can't be too sure these days."
        es = "Es impactante que alguien de la estatura de %name% llegara siquiera a sobrevivir, pero el lisiado sí se retiró de %companyname% con una buena pila de coronas. Actualmente dirige un orfanato y gasta sus coronas en ayudar a los niños rotos y abandonados del mundo. Eso, o es solo una tapadera para conseguir mano de obra barata. Hoy en día no se puede estar muy seguro."
    }
    // en = "When you left the %companyname%, there was one thing you were almost certain of: that damned cripple, %name%, wouldn't last long. Despite all odds, he did survive. Long enough in fact to retire himself, albeit departing with about as many crowns as he had when he joined up. You've no idea what became of him, but surely he's dead by now. Surely, right?"
    // en base_es
    // en = "the Cripple"
    // en base_es
    // en = "the Maimed"
    // en base_es
    // en = "the Broken"
    // en base_es
    // en = "the Grotesque"
    // en base_es
    // context: cripple_background.o.setGender.m.GoodEnding
    {
        en = "It's shocking that a woman of %name%'s stature survived at all, but the cripple did retire from the %companyname% with a sizeable stack of crowns. She runs an orphanage these days, spending her crowns to help the world's broken and abandoned children. That, or it's just a front for cheap labor. Can't be too sure these days."
        es = "Es impactante que una mujer de la estatura de %name% llegara siquiera a sobrevivir, pero la lisiada sí se retiró de %companyname% con una buena pila de coronas. Actualmente dirige un orfanato y gasta sus coronas en ayudar a los niños rotos y abandonados del mundo. Eso, o es solo una tapadera para conseguir mano de obra barata. Hoy en día no se puede estar muy seguro."
    }
    // context: cripple_background.o.setGender.m.BadEnding
    {
        en = "When you left the %companyname%, there was one thing you were almost certain of: that damned cripple, %name%, wouldn't last long. Despite all odds, she did survive. Long enough in fact to retire herself, albeit departing with about as many crowns as she had when she joined up. You've no idea what became of her, but surely she's dead by now. Surely, right?"
        es = "Cuando dejaste %companyname%, había una cosa de la que estabas casi seguro: esa maldita lisiada, %name%, no duraría mucho. Contra todo pronóstico, sobrevivió. De hecho, lo bastante como para llegar a retirarse, aunque se marchó con más o menos las mismas coronas que tenía al unirse. No tienes ni idea de qué fue de ella, pero seguro que a estas alturas ya está muerta. Seguro, ¿verdad?"
    }
    // en = "Is always content with being in reserve"
    // en base_es
    // context: cripple_background.o.onBuildDescription
    {
        en = "%name% {hobbles toward you like a mangy dog | greets you with a hand missing numerous fingers | smiles at you with a toothless grin | carries the slouching posture of a woman with a broken back | wobbles on two very stiff, possibly even wooden legs | uses a cane to walk toward you | crawls toward you at first, but then rises to her feet with all the grace of a drunk on church steps | has bones that creak and croak with every step | carries an arm in a sling, and has a cane standing in support for one of her legs | has a smashed nose and two blackened eyes | looks like someone tried to scalp and burn her alive | has flesh that smells partly cooked, her eyes wincing with every step she takes toward you | is missing two ears, though the holes she still hears | reeks of shit and urine | is missing one eye, and the other wanders severely | has two lazy eyes and a crooked, gap-filled smile}. She explains that {she was once a mason, but that she was attacked by a madman for trying to replicate his work | she once donned the atire of a belly dancer, but that cruel fate has taken all of that from her | once upon a time she was a Vizier's wife, but her poor vocabulary suggests this may be a lie | she was a peddler once, but the sale of a lobo-rail ended with her at the mercy of an angry town mob | she dabbled in cultism, but when she bailed they punished her for it | she used to wash and cook for decadent traders, but a beatdown by nomad raiders left her crippled | she used to serve food in the arena, but a bad match ended with her horribly crippled | she used to rob graves, but when she got caught a parishioner broke more of her bones than she knew a skeleton even had | she dabbled in {the arcane arts | necromancy} but, made obvious by her near-deathly state, that experiment was shortlived | she was once a successful gambler, but as it turns out not paying back your debts is bad for business - and your bones | she used to catch rats for a living, but apparently a giant rat paid her a vengeful visit in the night | she once served a vizier of %randomcitystate%, but after dropping a plate of food she was sent to the dungeons where she was promptly forgotten for years | she once killed a man, sure, but that she deserved a better fate than the irreversible torture she received as punishment | she used to hunt witches, but a cruel mistress tricked her into drinking a concoction which crippled her very bones | she once deserted an a master and, obviously, got caught | she used to dance for the rich until she accidentally fell down some steps in the middle of a performance. The steps proved rather edgy against her bones, it seems | she was born with a horrific deformity | her father brutally attacked her for not finding a husband early enough | her mother scarred her with endless torture | her siblings tortured hr all her life}. {The woman looks so weak you can almost see her mortal coil flapping in the wind. | Hiring her would almost certainly be the woman's doom. How merciful! | You don't want to be seen as hiring just anybody, but if this woman is a nobody, does that still count as 'anybody'? | You've seen dead people who look better than this woman. | This woman is wolf-lunch on two legs. | The good news is that if she comes back from the dead she shouldn't be too hard to put down a second time. | Dreams and inanimate objects are more threatening than this poor wench. | To be honest, you'd rather hire a child, but apparently people look down on that so here we are instead. | And you thought %randombrother% smelled bad. | Hiring a woman such as this would send anyone's moral compass spinning. | Oh c'mon, look at her! Are the %companyname% really that in need of warm bodies? | Hiring this woman just wouldn't be right. Whelp, here goes. | A pair of crutches has more value than this poor woman. | This woman is in such a sorry state she can play dead standing up.}"
        es = "%name% {cojea hacia ti como un perro sarnoso | te saluda con una mano a la que le faltan varios dedos | te dedica una sonrisa desdentada | tiene la postura encorvada de una mujer con la espalda rota | se tambalea sobre dos piernas muy rígidas, puede que incluso de madera | se acerca a ti apoyándose en un bastón | al principio se arrastra hacia ti, pero luego se pone en pie con toda la gracia de un borracho en las escaleras de una iglesia | tiene unos huesos que crujen y chirrían a cada paso | lleva un brazo en cabestrillo y un bastón que le sirve de apoyo para una de las piernas | tiene la nariz aplastada y los dos ojos morados | parece que alguien intentó arrancarle el cuero cabelludo y quemarla viva | tiene una carne que huele a medio cocinar, y entrecierra los ojos de dolor a cada paso que da hacia ti | le faltan las dos orejas, aunque por los agujeros todavía oye | apesta a mierda y a orines | le falta un ojo, y el otro se le va sin remedio hacia cualquier lado | tiene los dos ojos vagos y una sonrisa torcida y mellada}. Explica que {antes era albañil, pero un loco la atacó por intentar imitar su obra | en otro tiempo vistió el atuendo de bailarina de danza del vientre, pero el cruel destino se lo ha arrebatado todo | hubo un tiempo en que fue la esposa de un visir, aunque su pobre vocabulario sugiere que puede ser mentira | antes fue buhonera, pero la venta de un lobo-riel terminó con ella a merced de una turba furiosa del pueblo | coqueteó con los cultos, pero cuando lo dejó la castigaron por ello | lavaba y cocinaba para mercaderes decadentes, pero una paliza de unos saqueadores nómadas la dejó lisiada | servía comida en la arena, pero un mal combate la dejó horriblemente lisiada | saqueaba tumbas, pero cuando la atraparon, un feligrés le rompió más huesos de los que ella creía que tenía un esqueleto | se inició en {las artes arcanas | la nigromancia}, pero, como deja claro su estado casi cadavérico, el experimento duró poco | fue una jugadora de éxito, pero resulta que no pagar tus deudas es malo para el negocio, y para tus huesos | se ganaba la vida cazando ratas, pero, por lo visto, una rata gigante le hizo una visita vengativa por la noche | sirvió a un visir de %randomcitystate%, pero después de que se le cayera un plato de comida la mandaron a las mazmorras, donde la olvidaron enseguida durante años | una vez mató a un hombre, sí, pero que merecía mejor destino que la tortura irreversible que recibió como castigo | cazaba brujas, pero una dama cruel la engañó para que bebiera un brebaje que la dejó tullida hasta los huesos | una vez huyó de su amo y, evidentemente, la atraparon | bailaba para los ricos hasta que, en mitad de una actuación, se cayó sin querer por unas escaleras. Al parecer, los peldaños resultaron tener demasiadas aristas para sus huesos | nació con una deformidad horrible | su padre la atacó brutalmente por no encontrar marido a tiempo | su madre la marcó con torturas interminables | sus hermanos la torturaron toda la vida}. {La mujer parece tan débil que casi puedes ver su envoltura mortal ondeando al viento. | Contratarla sería casi con certeza la perdición de esta mujer. ¡Qué misericordioso! | No quieres que te vean contratando a cualquiera, pero si esta mujer es una don nadie, ¿cuenta igualmente como 'cualquiera'? | Has visto muertos con mejor aspecto que esta mujer. | Esta mujer es comida para lobos con dos piernas. | La buena noticia es que, si vuelve de entre los muertos, no debería costar mucho acabar con ella por segunda vez. | Los sueños y los objetos inanimados resultan más amenazadores que esta pobre desgraciada. | A decir verdad, preferirías contratar a un niño, pero al parecer la gente lo ve con malos ojos, así que aquí estamos. | Y tú que creías que %randombrother% olía mal. | Contratar a una mujer así volvería loca la brújula moral de cualquiera. | ¡Vamos, mírala! ¿De verdad le hacen tanta falta cuerpos calientes a %companyname%? | Contratar a esta mujer no estaría bien, sin más. Bueno, allá vamos. | Un par de muletas vale más que esta pobre mujer. | Esta mujer está en un estado tan lamentable que puede hacerse la muerta de pie.}"
    }
    // context: cripple_background.o.onBuildDescription
    {
        // corrige base: el es de la 1.0 no corresponde al en. Tiene variantes que el en no trae (monje, con su grupo anidado, y juglar) y cambia otras: guardia del visir por caballero, noble por visir, guerras para señores por peleas para mercaderes decadentes, torneos de justas por la arena, ricos por realeza, y un señor por un visir de %randomcitystate%, con lo que además pierde el token. Corrige también "patas" por piernas, el punto suelto tras "ciudad", "nerviosos" por edgy (aristas), la mayúscula de "Solía" y "mírenlo" en plural.
        en = "%name% {hobbles toward you like a mangy dog | greets you with a hand missing numerous fingers | smiles at you with a toothless grin | carries the slouching posture of a man with a broken back | wobbles on two very stiff, possibly even wooden legs | uses a cane to walk toward you | crawls toward you at first, but then rises to his feet with all the grace of a drunk on church steps | has bones that creak and croak with every step | carries an arm in a sling, and has a cane standing in support for one of his legs | has a smashed nose and two blackened eyes | looks like someone tried to scalp and burn him alive | has flesh that smells partly cooked, his eyes wincing with every step he takes toward you | is missing two ears, though the holes he still hears | reeks of shit and urine | is missing one eye, and the other wanders severely | has two lazy eyes and a crooked, gap-filled smile}. He explains that {he was once a mason, but that he was attacked by a madman for trying to replicate his work | he once donned armor as a knight, but that cruel fate has taken all of that from him | once upon a time he was a Vizier, but his poor vocabulary suggests this may be a lie | he was a peddler once, but the sale of a lobo-rail ended with him at the mercy of an angry town mob | he dabbled in cultism, but when he bailed they punished him for it | he used to brawl for decadent traders, but a beatdown by other fighters left him crippled | he used to fight in the arena, but a bad match ended with him horribly crippled | he used to rob graves, but when he got caught a parishioner broke more of his bones than he knew a skeleton even had | he dabbled in {the arcane arts | necromancy} but, made obvious by his near-deathly state, that experiment was shortlived | he was once a successful gambler, but as it turns out not paying back your debts is bad for business - and your bones | he used to catch rats for a living, but apparently a giant rat paid him a vengeful visit in the night | he once served a vizier of %randomcitystate%, but after dropping a plate of food he was sent to the dungeons where he was promptly forgotten for years | he once killed a man, sure, but that he deserved a better fate than the irreversible torture he received as punishment | he used to hunt witches, but a cruel mistress tricked him into drinking a concoction which crippled his very bones | he once deserted an army and, obviously, got caught | he used to juggle for the rich until he accidentally fell down some steps in the middle of a stunt. The steps proved rather edgy against his bones, it seems | he was born with a horrific deformity | his father brutally attacked him for not living up to his image | his mother scarred him with endless torture | his siblings tortured him all his life}. {The man looks so weak you can almost see his mortal coil flapping in the wind. | Hiring him would almost certainly be the man's doom. How merciful! | You don't want to be seen as hiring just anybody, but if this guy is a nobody, does that still count as 'anybody'? | You've seen dead people who look better than this man. | This guy is wolf-lunch on two legs. | The good news is that if he comes back from the dead he shouldn't be too hard to put down a second time. | Dreams and inanimate objects are more threatening than this poor git. | To be honest, you'd rather hire a child, but apparently people look down on that so here we are instead. | And you thought %randombrother% smelled bad. | Hiring a man such as this would send anyone's moral compass spinning. | Oh c'mon, look at him! Are the %companyname% really that in need of warm bodies? | Hiring this man just wouldn't be right. Whelp, here goes. | A pair of crutches has more value than this poor man. | This man is in such a sorry state he can play dead standing up.}"
        es = "%name% {cojea hacia ti como un perro sarnoso | te saluda con una mano a la que le faltan varios dedos | te dedica una sonrisa desdentada | tiene la postura encorvada de un hombre con la espalda rota | se tambalea sobre dos piernas muy rígidas, puede que incluso de madera | se acerca a ti apoyándose en un bastón | al principio se arrastra hacia ti, pero luego se pone en pie con toda la gracia de un borracho en las escaleras de una iglesia | tiene unos huesos que crujen y chirrían a cada paso | lleva un brazo en cabestrillo y un bastón que le sirve de apoyo para una de las piernas | tiene la nariz aplastada y los dos ojos morados | parece que alguien intentó arrancarle el cuero cabelludo y quemarlo vivo | tiene una carne que huele a medio cocinar, y entrecierra los ojos de dolor a cada paso que da hacia ti | le faltan las dos orejas, aunque por los agujeros todavía oye | apesta a mierda y a orines | le falta un ojo, y el otro se le va sin remedio hacia cualquier lado | tiene los dos ojos vagos y una sonrisa torcida y mellada}. Explica que {antes era albañil, pero un loco lo atacó por intentar imitar su obra | en otro tiempo vistió armadura de caballero, pero el cruel destino se lo ha arrebatado todo | hubo un tiempo en que fue visir, aunque su pobre vocabulario sugiere que puede ser mentira | antes fue buhonero, pero la venta de un lobo-riel terminó con él a merced de una turba furiosa del pueblo | coqueteó con los cultos, pero cuando lo dejó lo castigaron por ello | peleaba a puñetazos para mercaderes decadentes, pero una paliza de otros luchadores lo dejó lisiado | luchaba en la arena, pero un mal combate lo dejó horriblemente lisiado | saqueaba tumbas, pero cuando lo atraparon, un feligrés le rompió más huesos de los que él creía que tenía un esqueleto | se inició en {las artes arcanas | la nigromancia}, pero, como deja claro su estado casi cadavérico, el experimento duró poco | fue un jugador de éxito, pero resulta que no pagar tus deudas es malo para el negocio, y para tus huesos | se ganaba la vida cazando ratas, pero, por lo visto, una rata gigante le hizo una visita vengativa por la noche | sirvió a un visir de %randomcitystate%, pero después de que se le cayera un plato de comida lo mandaron a las mazmorras, donde lo olvidaron enseguida durante años | una vez mató a un hombre, sí, pero que merecía mejor destino que la tortura irreversible que recibió como castigo | cazaba brujas, pero una dama cruel lo engañó para que bebiera un brebaje que lo dejó tullido hasta los huesos | una vez desertó de un ejército y, evidentemente, lo atraparon | hacía malabares para los ricos hasta que, en mitad de un número, se cayó sin querer por unas escaleras. Al parecer, los peldaños resultaron tener demasiadas aristas para sus huesos | nació con una deformidad horrible | su padre lo atacó brutalmente por no estar a la altura de su imagen | su madre lo marcó con torturas interminables | sus hermanos lo torturaron toda la vida}. {El hombre parece tan débil que casi puedes ver su envoltura mortal ondeando al viento. | Contratarlo sería casi con certeza la perdición de este hombre. ¡Qué misericordioso! | No quieres que te vean contratando a cualquiera, pero si este tipo es un don nadie, ¿cuenta igualmente como 'cualquiera'? | Has visto muertos con mejor aspecto que este hombre. | Este tipo es comida para lobos con dos piernas. | La buena noticia es que, si vuelve de entre los muertos, no debería costar mucho acabar con él por segunda vez. | Los sueños y los objetos inanimados resultan más amenazadores que este pobre infeliz. | A decir verdad, preferirías contratar a un niño, pero al parecer la gente lo ve con malos ojos, así que aquí estamos. | Y tú que creías que %randombrother% olía mal. | Contratar a un hombre así volvería loca la brújula moral de cualquiera. | ¡Vamos, míralo! ¿De verdad le hacen tanta falta cuerpos calientes a %companyname%? | Contratar a este hombre no estaría bien, sin más. Bueno, allá vamos. | Un par de muletas vale más que este pobre hombre. | Este hombre está en un estado tan lamentable que puede hacerse el muerto de pie.}"
    }
    // FILE: mod_legends\hooks\skills\backgrounds\cripple_southern_background.nut
    // context: cripple_southern_background.o.onBuildDescription
    {
        en = "%name% {hobbles toward you like a mangy dog | greets you with a hand missing numerous fingers | smiles at you with a toothless grin | carries the slouching posture of a woman with a broken back | wobbles on two very stiff, possibly even wooden legs | uses a cane to walk toward you | crawls toward you at first, but then rises to her feet with all the grace of a drunk on church steps | has bones that creak and croak with every step | carries an arm in a sling, and has a cane standing in support for one of her legs | has a smashed nose and two blackened eyes | looks like someone tried to scalp and burn her alive | has flesh that smells partly cooked, her eyes wincing with every step she takes toward you | is missing two ears, though the holes still hear | reeks of shit and urine | is missing one eye, and the other wanders severely | has two lazy eyes and a crooked, gap-filled smile}. She explains that {she was once a mason, but that she was attacked by a madman for trying to replicate his work | she once donned the atire of a belly dancer, but that cruel fate has taken all of that from her | once upon a time she was a Vizier's wife, but her poor vocabulary suggests this may be a lie | she was a peddler once, but the sale of a lobo-rail ended with her at the mercy of an angry town mob | she dabbled in cultism, but when she bailed they punished her for it | she used to wash and cook for decadent traders, but a beatdown by nomad raiders left her crippled | she used to serve food in the arena, but a bad match ended with her horribly crippled | she used to rob graves, but when she got caught a parishioner broke more of her bones than she knew a skeleton even had | she dabbled in {the arcane arts | necromancy} but, made obvious by her near-deathly state, that experiment was shortlived | she was once a successful gambler, but as it turns out not paying back your debts is bad for business - and your bones | she used to catch rats for a living, but apparently a giant rat paid her a vengeful visit in the night | she once served a vizier of %randomcitystate%, but after dropping a plate of food she was sent to the dungeons where she was promptly forgotten for years | she once killed a man, sure, but that she deserved a better fate than the irreversible torture she received as punishment | she used to hunt witches, but a cruel mistress tricked him into drinking a concoction which crippled her very bones | she once deserted an a master and, obviously, got caught | she used to dance for the rich until she accidentally fell down some steps in the middle of a performance. The steps proved rather edgy against her bones, it seems | she was born with a horrific deformity | her father brutally attacked her for not finding a husband early enough | her mother scarred her with endless torture | her siblings tortured hr all her life}. {The woman looks so weak you can almost see her mortal coil flapping in the wind. | Hiring her would almost certainly be the woman's doom. How merciful! | You don't want to be seen as hiring just anybody, but if this woman is a nobody, does that still count as 'anybody'? | You've seen dead people who look better than this woman. | This woman is wolf-lunch on two legs. | The good news is that if she comes back from the dead she shouldn't be too hard to put down a second time. | Dreams and inanimate objects are more threatening than this poor wench. | To be honest, you'd rather hire a child, but apparently people look down on that so here we are instead. | And you thought %randombrother% smelled bad. | Hiring a woman such as this would send anyone's moral compass spinning. | Oh c'mon, look at her! Are the %companyname% really that in need of warm bodies? | Hiring this woman just wouldn't be right. Whelp, here goes. | A pair of crutches has more value than this poor woman. | This woman is in such a sorry state she can play dead standing up.}"
        es = "%name% {cojea hacia ti como un perro sarnoso | te saluda con una mano a la que le faltan varios dedos | te dedica una sonrisa desdentada | tiene la postura encorvada de una mujer con la espalda rota | se tambalea sobre dos piernas muy rígidas, puede que incluso de madera | se acerca a ti apoyándose en un bastón | al principio se arrastra hacia ti, pero luego se pone en pie con toda la gracia de un borracho en las escaleras de una iglesia | tiene unos huesos que crujen y chirrían a cada paso | lleva un brazo en cabestrillo y un bastón que le sirve de apoyo para una de las piernas | tiene la nariz aplastada y los dos ojos morados | parece que alguien intentó arrancarle el cuero cabelludo y quemarla viva | tiene una carne que huele a medio cocinar, y entrecierra los ojos de dolor a cada paso que da hacia ti | le faltan las dos orejas, aunque por los agujeros todavía oye | apesta a mierda y a orines | le falta un ojo, y el otro se le va sin remedio hacia cualquier lado | tiene los dos ojos vagos y una sonrisa torcida y mellada}. Explica que {antes era albañil, pero un loco la atacó por intentar imitar su obra | en otro tiempo vistió el atuendo de bailarina de danza del vientre, pero el cruel destino se lo ha arrebatado todo | hubo un tiempo en que fue la esposa de un visir, aunque su pobre vocabulario sugiere que puede ser mentira | antes fue buhonera, pero la venta de un lobo-riel terminó con ella a merced de una turba furiosa del pueblo | coqueteó con los cultos, pero cuando lo dejó la castigaron por ello | lavaba y cocinaba para mercaderes decadentes, pero una paliza de unos saqueadores nómadas la dejó lisiada | servía comida en la arena, pero un mal combate la dejó horriblemente lisiada | saqueaba tumbas, pero cuando la atraparon, un feligrés le rompió más huesos de los que ella creía que tenía un esqueleto | se inició en {las artes arcanas | la nigromancia}, pero, como deja claro su estado casi cadavérico, el experimento duró poco | fue una jugadora de éxito, pero resulta que no pagar tus deudas es malo para el negocio, y para tus huesos | se ganaba la vida cazando ratas, pero, por lo visto, una rata gigante le hizo una visita vengativa por la noche | sirvió a un visir de %randomcitystate%, pero después de que se le cayera un plato de comida la mandaron a las mazmorras, donde la olvidaron enseguida durante años | una vez mató a un hombre, sí, pero que merecía mejor destino que la tortura irreversible que recibió como castigo | cazaba brujas, pero una dama cruel la engañó para que bebiera un brebaje que la dejó tullida hasta los huesos | una vez huyó de su amo y, evidentemente, la atraparon | bailaba para los ricos hasta que, en mitad de una actuación, se cayó sin querer por unas escaleras. Al parecer, los peldaños resultaron tener demasiadas aristas para sus huesos | nació con una deformidad horrible | su padre la atacó brutalmente por no encontrar marido a tiempo | su madre la marcó con torturas interminables | sus hermanos la torturaron toda la vida}. {La mujer parece tan débil que casi puedes ver su envoltura mortal ondeando al viento. | Contratarla sería casi con certeza la perdición de esta mujer. ¡Qué misericordioso! | No quieres que te vean contratando a cualquiera, pero si esta mujer es una don nadie, ¿cuenta igualmente como 'cualquiera'? | Has visto muertos con mejor aspecto que esta mujer. | Esta mujer es comida para lobos con dos piernas. | La buena noticia es que, si vuelve de entre los muertos, no debería costar mucho acabar con ella por segunda vez. | Los sueños y los objetos inanimados resultan más amenazadores que esta pobre desgraciada. | A decir verdad, preferirías contratar a un niño, pero al parecer la gente lo ve con malos ojos, así que aquí estamos. | Y tú que creías que %randombrother% olía mal. | Contratar a una mujer así volvería loca la brújula moral de cualquiera. | ¡Vamos, mírala! ¿De verdad le hacen tanta falta cuerpos calientes a %companyname%? | Contratar a esta mujer no estaría bien, sin más. Bueno, allá vamos. | Un par de muletas vale más que esta pobre mujer. | Esta mujer está en un estado tan lamentable que puede hacerse la muerta de pie.}"
    }
    // en = "%name% \x7bhobbles toward you like a mangy dog | greets you with a hand missing numerous fingers | smiles at you with a toothless grin | carries the slouching posture of a man with a broken back | wobbles on two very stiff, possibly even wooden legs | uses a cane to walk toward you | crawls toward you at first, but then rises to his feet with all the grace of a drunk on church steps | has bones that creak and croak with every step | carries an arm in a sling, and has a cane standing in support for one of his legs | has a smashed nose and two blackened eyes | looks like someone tried to scalp and burn him alive | has flesh that smells partly cooked, his eyes wincing with every step he takes toward you | is missing two ears, though the holes still hear | reeks of shit and urine | is missing one eye, and the other wanders severely | has two lazy eyes and a crooked, gap-filled smile\x7d. He explains that \x7bhe was once a mason, but that he was attacked by a madman for trying to replicate his work | he once donned armor as a knight, but that cruel fate has taken all of that from him | once upon a time he was a Vizier, but his poor vocabulary suggests this may be a lie | he was a peddler once, but the sale of a lobo-rail ended with him at the mercy of an angry town mob | he dabbled in cultism, but when he bailed they punished him for it | he used to brawl for decadent traders, but a beatdown by other fighters left him crippled | he used to fight in the arena, but a bad match ended with him horribly crippled | he used to rob graves, but when he got caught a parishioner broke more of his bones than he knew a skeleton even had | he dabbled in \x7bthe arcane arts | necromancy\x7d but, made obvious by his near-deathly state, that experiment was shortlived | he was once a successful gambler, but as it turns out not paying back your debts is bad for business - and your bones | he used to catch rats for a living, but apparently a giant rat paid him a vengeful visit in the night | he once served a vizier of %randomcitystate%, but after dropping a plate of food he was sent to the dungeons where he was promptly forgotten for years | he once killed a man, sure, but that he deserved a better fate than the irreversible torture he received as punishment | he used to hunt witches, but a cruel mistress tricked him into drinking a concoction which crippled his very bones | he once deserted an army and, obviously, got caught | he used to juggle for the rich until he accidentally fell down some steps in the middle of a stunt. The steps proved rather edgy against his bones, it seems | he was born with a horrific deformity | his father brutally attacked him for not living up to his image | his mother scarred him with endless torture | his siblings tortured him all his life\x7d. \x7bThe man looks so weak you can almost see his mortal coil flapping in the wind. | Hiring him would almost certainly be the man's doom. How merciful! | You don't want to be seen as hiring just anybody, but if this guy is a nobody, does that still count as 'anybody'? | You've seen dead people who look better than this man. | This guy is wolf-lunch on two legs. | The good news is that if he comes back from the dead he shouldn't be too hard to put down a second time. | Dreams and inanimate objects are more threatening than this poor git. | To be honest, you'd rather hire a child, but apparently people look down on that so here we are instead. | And you thought %randombrother% smelled bad. | Hiring a man such as this would send anyone's moral compass spinning. | Oh c'mon, look at him! Are the %companyname% really that in need of warm bodies? | Hiring this man just wouldn't be right. Whelp, here goes. | A pair of crutches has more value than this poor man. | This man is in such a sorry state he can play dead standing up.\x7d"
    // en base_es
    // FILE: mod_legends\hooks\skills\backgrounds\crucified_background.nut
    // en = "Converted Crusader"
    // en base_es
    // FILE: mod_legends\hooks\skills\backgrounds\crusader_background.nut
    // context: crusader_background.o.create.m.Titles
    {
        en = "the Exalted"
        es = "el Exaltado"
    }
    // en = "the Crusader"
    // en base_es
    // context: crusader_background.o.create.m.Titles
    {
        en = "the Argent"
        es = "el Argénteo"
    }
    // context: crusader_background.o.create.m.Titles
    {
        en = "the Holy Champion"
        es = "el Campeón Sagrado"
    }
    // context: crusader_background.o.create.m.Titles
    {
        en = "the Venerable"
        es = "el Venerable"
    }
    // en = "%name% joined your party during the undead scourge. Little is known about him and he almost never talks save for the occasional grunt while swinging his sword. His language seems to be codified into one simple structure: killing creatures of evil."
    // en base_es
    // FILE: mod_legends\hooks\skills\backgrounds\cultist_background.nut
    // en = "Cultists have a resolve to spread further their cult that is second to few."
    // en base_es
    // context: cultist_background.o.create.m.GoodEnding
    {
        en = "The cultist, %name%, left the company with a band of cloaked converts. You know not what became of the fanatic, but every so often they appear in your dreams. Often standing alone in a great void and there is always someone, or something, lingering in the black beyond. Every night, this image gets a little more clear, and each night you find yourself staying up later and later just to avoid dreaming at all."
        es = "Fiel a su culto, %name% dejó la compañía con una banda de conversos encapuchados. No sabes qué fue de aquella alma fanática, pero de vez en cuando se te aparece en sueños. Suele estar en medio de un gran vacío, sin nadie a su lado, y siempre hay alguien, o algo, acechando en la negrura del otro lado. Cada noche esa imagen se vuelve un poco más nítida, y cada noche te descubres quedándote despierto hasta más tarde solo para no soñar."
    }
    // context: cultist_background.o.create.m.BadEnding
    {
        // corrige base: la 1.0 añade al final "Francamente, al tipo le faltaban algunos tornillos.", que el en no tiene.
        en = "You heard that %name%, the cultist, left the company at some juncture and went out to spread the faith. There's no telling what became of the fanatic, but there was a recent inquisition against unholy faiths and hundreds of 'folk in dark cloaks with even darker intentions' were burned at the stake across the realm."
        es = "Oíste que %name% dejó la compañía en algún momento para ir a difundir la fe de su culto. No se sabe qué fue de aquella alma fanática, pero hace poco hubo una inquisición contra las creencias impías, y cientos de 'personas con capas oscuras y propósitos aún más oscuros' ardieron en la hoguera por todo el reino."
    }
    // en = "the Occultist"
    // en base_es
    // en = "the Follower"
    // en base_es
    // en = "the Lost"
    // en base_es
    // en = "the Odd"
    // en base_es
    // en = "the Misguided"
    // en base_es
    // en = "the Fanatic"
    // en base_es
    // en = "the Zealot"
    // en base_es
    // context: cultist_background.o.onBuildDescription
    {
        en = "{The cultist stands with a placard hanging from their neck. | Their face is wreathed in garish tattoos. They carry a note. | The face is hidden inside a deep cowl, an islanded tip of a nose all that you see in the darkness. They carry a placard around their neck. | Clothed in rags, it is strange they neither sweat nor shake in heat or cold. Clutching a scroll as if it protects from the very elements. | Scripture is written across their arm in scars, the coda of madness. | The stranger writes in the dirt as quick as someone who has done it a thousand times. The message is clear to see. | They stand with a tome nestled behind a crooked arm. They hand it to you. Opening it, the leather feels like none you've ever touched before. There is only one passage inside, written over and over.} It reads: \"Ph'nglui mglw'nafh Davkul R'lyeh wgah'nagl fhtagn. Nn'nilgh'ri, nn'nglui. Sgn'wahl sll'ha ep'shogg.\" Hmm... quaint."
        es = "{Se planta ante ti con un cartel colgado del cuello. | Tiene el rostro cubierto de tatuajes chillones. Lleva una nota. | El rostro queda oculto en una profunda capucha, y en la oscuridad solo asoma, como una isla, la punta de una nariz. Lleva un cartel colgado del cuello. | Viste harapos, y resulta extraño que ni sude con el calor ni tiemble con el frío. Aferra un pergamino como si fuera un escudo contra los mismísimos elementos. | Lleva unas escrituras grabadas a cicatrices en el brazo: la coda de la locura. | Escribe en la tierra con la soltura de quien lo ha hecho mil veces. El mensaje se lee con claridad. | Sostiene un tomo encajado tras un brazo torcido. Te lo tiende. Al abrirlo, el cuero tiene un tacto distinto a todo lo que has tocado antes. Dentro solo hay un pasaje, escrito una y otra vez.} Dice: \"Ph'nglui mglw'nafh Davkul R'lyeh wgah'nagl fhtagn. Nn'nilgh'ri, nn'nglui. Sgn'wahl sll'ha ep'shogg.\" Mmm... qué pintoresco."
    }
    // FILE: mod_legends\hooks\skills\backgrounds\daytaler_background.nut
    // en = "Daytalers are used to all kinds of physical work, but don't excel in any."
    // en base_es
    // en = "%name% the daytaler retired from fighting and, well, he keeps working with his hands. Now he's back to laying bricks and carrying hay instead of slaying beasts and crushing heads. He took all his mercenary money to purchase a bit of land and settle down. While not the richest man, word has it that there is hardly a happier man in the realm."
    // en base_es
    // en = "%name% retired from fighting while he still had most of his fingers and toes intact. He went back to working for the nobility. Last you heard he was out \x7bsouth | north | east | west\x7d building a great tower for some nobleman. Sadly, you also heard that tower collapsed halfway through its construction with many workers going down with it."
    // en base_es
    // context: daytaler_background.o.setGender.m.Name
    {
        en = "Washerwoman"
        es = "Lavandera"
    }
    // context: daytaler_background.o.setGender.m.BackgroundDescription
    {
        en = "Washerwomen are used to all kinds of physical work, scrubbing isn't easy work."
        es = "Las lavanderas están acostumbradas a todo tipo de trabajo físico; frotar la ropa no es tarea fácil."
    }
    // context: daytaler_background.o.setGender.m.GoodEnding
    {
        en = "%name% the washerwoman retired from fighting and, well, she keeps working with her hands. Now she's back to the scrubbing board and boiling water instead of slaying beasts and crushing heads. She took all his mercenary money to purchase a bit of land and settle down. While not the richest woman, word has it that there is hardly a happier woman in the realm."
        es = "%name%, la lavandera, dejó de luchar y, bueno, sigue trabajando con las manos. Ha vuelto a la tabla de lavar y al agua hirviendo en lugar de matar bestias y aplastar cabezas. Usó todo el dinero que ganó como mercenaria para comprar un pedazo de tierra y asentarse. No será la mujer más rica, pero dicen que no hay mujer más feliz en todo el reino."
    }
    // context: daytaler_background.o.setGender.m.BadEnding
    {
        en = "%name% retired from fighting while she still had most of his fingers and toes intact. She went back to working for the nobility. Last you heard she was out {south | north | east | west} running the laundry house for some nobleman. Sadly, you also heard that wash house collapsed halfway through its construction with many workers going down with it."
        es = "%name% dejó de luchar cuando aún conservaba intactos casi todos los dedos de las manos y los pies. Volvió a trabajar para la nobleza. Lo último que supiste es que estaba en el {sur | norte | este | oeste} llevando la lavandería de algún noble. Por desgracia, también te enteraste de que el lavadero se derrumbó a mitad de su construcción y se llevó consigo a muchos trabajadores."
    }
    // context: daytaler_background.o.onBuildDescription
    {
        en = "{Working here and there | With no steady work | Working on and off | Doing this and that | Having learned no craft}, %name% is known as a washerwoman, someone to ask whenever the linens need their rinse. {Work had been sparse for a while now, so | There was little work to be a had these past weeks, so | %name% wanted to do something she had not done before, so | Despite having no experience in battle, staring too deep into the bottle made her believe that | %name% considered the fighting profession one that doesn't run out of work these days, so | %name% lost her loved one to sickness, as befalls so many these days, and broke down. After weeks blurred by drinking her sorrows away,} a travelling mercenary company seemed a good opportunity {to seek redemption | to earn some coin | to see a bit of the world | to clear her head | to get her to the next village while filling her pockets}."
        es = "{Trabajando aquí y allá | Sin un trabajo estable | Trabajando de vez en cuando | Haciendo esto y aquello | Sin haber aprendido ningún oficio}, %name% es conocida como lavandera, alguien a quien acudir cuando la ropa blanca necesita un enjuague. {El trabajo escaseaba desde hacía tiempo, así que | Había habido poco trabajo estas últimas semanas, así que | %name% quería hacer algo que no hubiera hecho nunca, así que | Pese a no tener experiencia en batalla, mirar demasiado al fondo de la botella le hizo creer que | %name% pensaba que el oficio de las armas es de los que no se quedan sin trabajo hoy en día, así que | %name% perdió a su ser querido por una enfermedad, como les pasa a tantos hoy en día, y se vino abajo. Tras semanas borrosas ahogando sus penas en alcohol,} una compañía itinerante de mercenarios parecía una buena oportunidad {para buscar la redención | para ganar algo de dinero | para ver un poco de mundo | para despejarse la cabeza | para llegar al siguiente pueblo mientras se llenaba los bolsillos}."
    }
    // en = "\x7bWorking here and there | With no steady work | Working on and off | Doing this and that | Having learned no craft\x7d, %name% is known as a daytaler, someone to ask whenever an extra hand is needed. \x7bWork had been sparse for a while now, so | There was little work to be a had these past weeks, so | %name% wanted to do something he had not done before, so | Despite having no experience in battle, staring too deep into the bottle made him believe that | %name% considered the fighting profession one that doesn't run out of work these days, so | %name% lost his loved one to sickness, as befalls so many these days, and broke down. After weeks blurred by drinking his sorrows away,\x7d a travelling mercenary company seemed a good opportunity \x7bto stay with for a while | to earn some coin | to see a bit of the world | to clear his head | to get him to the next village while filling his pockets\x7d."
    // en base_es
    // FILE: mod_legends\hooks\skills\backgrounds\deserter_background.nut
    // en = "Deserter"
    // en base_es
    // en = "Deserters have received some martial training, but usually aren't eager to put it to use."
    // en base_es
    // en = "%name% the deserter continued fighting for the %companyname%, ever striving to redeem his name. Word has it that during a brutal fight with orcs, he dove headfirst into a crowd of greenskins, surfing across the top of their shocked heads. His heroism rallied the men to an incredible victory and he lives out his days getting toasted in every bar he enters."
    // en base_es
    // en = "You heard %name% the deserter actually renewed his title and fled a battle the %companyname% had with some greenskins. Goblins caught him out in the woods and turned his head into a goblet for an orc warlord."
    // en base_es
    // en = "Turncloak"
    // en base_es
    // en = "the Betrayer"
    // en base_es
    // en = "the Runner"
    // en base_es
    // en = "the Worm"
    // en base_es
    // context: deserter_background.o.setGender.m.GoodEnding
    {
        en = "%name% the deserter continued fighting for the %companyname%, ever striving to redeem her name. Word has it that during a brutal fight with orcs, she dove headfirst into a crowd of greenskins, surfing across the top of their shocked heads. Her heroism rallied the mercenaries to an incredible victory and she lives out her days getting toasted in every bar she enters."
        es = "%name%, la desertora, siguió luchando para %companyname%, siempre empeñada en redimir su nombre. Dicen que, durante una brutal pelea contra orcos, se lanzó de cabeza contra una multitud de verdes y surfeó por encima de sus cabezas atónitas. Su heroísmo llevó a los mercenarios a una victoria increíble, y pasa el resto de sus días recibiendo brindis en cada taberna a la que entra."
    }
    // context: deserter_background.o.setGender.m.BadEnding
    {
        en = "You heard %name% the deserter actually renewed her title and fled a battle the %companyname% had with some greenskins. Goblins caught her out in the woods and turned her head into a goblet for an orc warlord."
        es = "Oíste que %name%, la desertora, volvió a ganarse su título y huyó de una batalla que %companyname% libró contra unos verdes. Unos trasgos la atraparon en el bosque y convirtieron su cabeza en una copa para un señor de la guerra orco."
    }
    // context: deserter_background.o.onBuildDescription
    {
        en = "{%name% used to be a common soldier in a lord's army, but suffering loss after loss, | Once a watchwoman on the outskirts of %randomtown%, %name% watched all her friends die to the beasts that lurk there. After so many losses | When two lords quarreled over a petty matter of who owned a local pond, %name% was conscripted to help settle the matter. Being a nobody, it was clear her life was of little value. One slaughter later, | While employed in a lord's professional army, a horrible disease fell upon %name% and her comrades. Fearing its wrath, | While on a lengthy military campaign, %name% felt that there was too much marching and too little spoils to be had. So} she {stuck her weapons in the ground and walked off. | waited until night to desert her outfit. | and several others disbanded in protest. | volunteered for a patrol and, at the first opening, abandoned her soldiering career.} {It is no secret that deserters are widely despised - and %name% keeps her head hung low to stay out of others' eyes. | Most deserters spend the rest of their days avoiding the noose, and %name% is no different. | Donning the garb of the common folk, %name% has, for a time, avoided the deserter's punishment. | By total luck, %name% has, thus far, gotten away with her crime.} {But now broke and penniless, she seeks a return to his former field. | Perhaps compelled by lawmen closing in, she now finds herself joining another fighting force. | Unfortunately, she is not a smart woman. Lacking the imagination to pursue a safer career, %name% once again returns to fighting. | Feeling guilty about deserting her comrades in the field, she now seeks redemption in fighting for another outfit. But who is to say she won't flee again? | With an empty coin purse from drinking her memories away, she now considers any opportunity to make a living.}"
        es = "{%name% era soldado raso en el ejército de un señor, pero tras sufrir derrota tras derrota, | Cuando era vigilante en las afueras de %randomtown%, %name% vio morir a todos sus amigos a manos de las bestias que acechan allí. Tras tantas pérdidas, | Cuando dos señores se pelearon por la nimiedad de quién era el dueño de un estanque, reclutaron a la fuerza a %name% para zanjar el asunto. Como no era nadie, estaba claro que su vida valía poco. Una matanza después, | Mientras servía en el ejército profesional de un señor, una enfermedad horrible cayó sobre %name% y sus camaradas. Por miedo a su furia, | Durante una larga campaña militar, %name% sintió que había demasiada marcha y muy poco botín que sacar. Así que} {clavó sus armas en el suelo y se marchó. | esperó a la noche para desertar de su unidad. | se desbandó junto con otros cuantos en señal de protesta. | se ofreció voluntaria para una patrulla y, a la primera ocasión, abandonó su carrera de soldado.} {No es ningún secreto que los desertores son despreciados por todos, y %name% mantiene la cabeza gacha para no llamar la atención. | La mayoría de los desertores pasan el resto de sus días esquivando la horca, y %name% no es distinta. | Vestida como la gente corriente, %name% ha evitado durante un tiempo el castigo de los desertores. | Por pura suerte, %name% ha salido impune de su crimen hasta ahora.} {Pero ahora, arruinada y sin un cobre, busca volver a su antiguo oficio. | Quizá empujada por la ley, que le pisa los talones, ahora se ve uniéndose a otra fuerza armada. | Por desgracia, no es una mujer lista. Sin imaginación para buscarse un oficio más seguro, %name% vuelve una vez más a la lucha. | Se siente culpable por haber abandonado a sus camaradas en el campo de batalla, y ahora busca redimirse luchando para otro grupo. Pero ¿quién dice que no volverá a huir? | Con la bolsa vacía de tanto beber para olvidar, ahora se plantea cualquier oportunidad de ganarse la vida.}"
    }
    // en = "\x7b%name% used to be a common soldier in a lord's army, but suffering loss after loss, | Once a watchman on the outskirts of %randomtown%, %name% watched all his friends die to the beasts that lurk there. After so many losses | When two lords quarreled over a petty matter of who owned a local pond, %name% was conscripted to help settle the matter. Being a nobody, it was clear his life was of little value. One slaughter later, | While employed in a lord's professional army, a horrible disease fell upon %name% and his comrades. Fearing its wrath, | While on a lengthy military campaign, %name% felt that there was too much marching and too little spoils to be had. So\x7d he \x7bstuck his weapons in the ground and walked off. | waited until night to desert his outfit. | and several others disbanded in protest. | volunteered for a patrol and, at the first opening, abandoned his soldiering career.\x7d \x7bIt is no secret that deserters are widely despised - and %name% keeps his head hung low to stay out of others' eyes. | Most deserters spend the rest of their days avoiding the noose, and %name% is no different. | Donning the garb of the everyman, %name% has, for a time, avoided the deserter's punishment. | By total luck, %name% has, thus far, gotten away with his crime.\x7d \x7bBut now broke and penniless, he seeks a return to his former field. | Perhaps compelled by lawmen closing in, he now finds himself joining another fighting force. | Unfortunately, he is not a smart man. Lacking the imagination to pursue a safer career, %name% once again returns to fighting. | Feeling guilty about deserting his brothers in the field, he now seeks redemption in fighting for another outfit. But who is to say he won't flee again? | With an empty coin purse from drinking his memories away, he now considers any opportunity to make a living.\x7d"
    // en base_es
    // FILE: mod_legends\hooks\skills\backgrounds\disowned_noble_background.nut
    // en = "Disowned Noble"
    // en base_es
    // context: disowned_noble_background.o.create.m.BackgroundDescription
    {
        en = "Disowned nobles often have profited from some training in melee fighting at court and know the weaknesses of noble armies."
        es = "Los nobles desheredados a menudo se han beneficiado de algún entrenamiento en lucha cuerpo a cuerpo en la corte y conocen las debilidades de los ejércitos nobles."
    }
    // context: disowned_noble_background.o.create.m.GoodEnding
    {
        en = "A noble at heart, the disowned %noble% %name% returned to %their% family. Word has it %they% kicked in the doors and demanded a royal seat. An usurper challenged %them% in combat and, well, %name% learned a lot in %their% days with the %companyname% and %they% now sits on a very, very comfortable throne."
        es = "Noble de corazón, %name%, desheredad%o%, volvió con su familia. Dicen que echó las puertas abajo a patadas y exigió un asiento real. Un usurpador %lo% desafió en combate y, bueno, %name% aprendió mucho en sus días con %companyname%, y ahora se sienta en un trono muy, muy cómodo."
    }
    // context: disowned_noble_background.o.create.m.BadEnding
    {
        en = "A %person% of nobility at heart, %name% the disowned noble returned to %their% family home. Word has it an usurper arrested %them% at the gates. %Their% head currently rests on a pike with crows for a crown."
        es = "Noble de corazón, %name%, desheredad%o%, regresó a la casa de su familia. Dicen que un usurpador %lo% arrestó a las puertas. Ahora su cabeza descansa en una pica, con cuervos por corona."
    }
    // en = "the Disowned"
    // en base_es
    // en = "the Exiled"
    // en base_es
    // en = "the Disgraced"
    // en base_es
    // context: disowned_noble_background.o.setGender.m.Name
    {
        en = "Disowned Lady"
        es = "Dama desheredada"
    }
    // context: disowned_noble_background.o.setGender.m.BackgroundDescription
    {
        en = "Disowned ladies often have profited from some training in ranged warfare at court and know the weaknesses of noble armies."
        es = "Las damas desheredadas a menudo se han beneficiado de algún entrenamiento en combate a distancia en la corte y conocen las debilidades de los ejércitos nobles."
    }
    // context: disowned_noble_background.o.onBuildDescription
    {
        // return "{A constant disappointment to a delusional father | A victim of court intrigue involving poison and cake | After openly denouncing %their% own heritage | After an incestous relationship with %their% brother came to light | After a coup to dispose %their% older %sibling% failed | After pride and hubris had %their% leading %their% father\'s army to total defeat | For accidentally killing %their% oldest brother and heir to the throne on a hunt | As a price to be paid for choosing %their% allies poorly in a war of succession | For attempting to sell captured poachers as slaves | Caught bedding a fellow noble%person% | Discovered to be the head of a child stealing plot that shocked the peasantry | For turning %their% back on the gods and causing a riot amongst the laymen | Seen with the cultists\' book of Davkul tucked under an arm}, %name% {was disowned and cast away from %their% family\'s estate, never to return. | was stripped of %their% titles and exiled from the land. | was forcibly removed from %their% land and told never to return. | came to see, by the threat of an executioner\'s axe, that %they% no longer belonged in the court. | saw the hangman\'s noose, and only by a clever ploy did %they% slip it. | was branded with the symbol of shame and cast out from %their% lands. | was believed to have been involved in one too many conspiracies and was removed from the lands. | was seen as being too ambitious, a dangerous trait amongst the nobility.} {%name% now seeks to redeem %themselves% and live up to the family name. A bit selfish for a mercenary outfit, noble nonetheless. | %Their% posture slumped by scandal, %name%\'s resistance to difficulties has diminished. | A skilled fighter %they% may be, but %name% rarely talks about anyone but %themselves%. | Though quick with a sword, you get the feeling someone like %name% was disowned for a reason. | Down on %their% luck and essentially broke, %name% ventures in the field of sellswords. | Without title or land, %name% seeks to join the sort of people %they% used to lord over. | Well-geared this former noble may be, you do notice that the most used piece of equipment %name% has are %their% boots.}";
        mode = "pattern"
        en = "{A constant disappointment to a delusional father | A victim of court intrigue involving poison and cake | After openly denouncing %their% own heritage | After an incestous relationship with %their% brother came to light | After a coup to dispose %their% older %sibling% failed | After pride and hubris had %their% leading %their% father's army to total defeat | For accidentally killing %their% oldest brother and heir to the throne on a hunt | As a price to be paid for choosing %their% allies poorly in a war of succession | For attempting to sell captured poachers as slaves | Caught bedding a fellow noble%person% | Discovered to be the head of a child stealing plot that shocked the peasantry | For turning %their% back on the gods and causing a riot amongst the laymen | Seen with the cultists' book of Davkul tucked under an arm}, %name% {was disowned and cast away from %their% family's estate, never to return. | was stripped of %their% titles and exiled from the land. | was forcibly removed from %their% land and told never to return. | came to see, by the threat of an executioner's axe, that %they% no longer belonged in the court. | saw the hangman's noose, and only by a clever ploy did %they% slip it. | was branded with the symbol of shame and cast out from %their% lands. | was believed to have been involved in one too many conspiracies and was removed from the lands. | was seen as being too ambitious, a dangerous trait amongst the nobility.} {%name% now seeks to redeem %themselves% and live up to the family name. A bit selfish for a mercenary outfit, noble nonetheless. | %Their% posture slumped by scandal, %name%'s resistance to difficulties has diminished. | A skilled fighter %they% may be, but %name% rarely talks about anyone but %themselves%. | Though quick with a sword, you get the feeling someone like %name% was disowned for a reason. | Down on %their% luck and essentially broke, %name% ventures in the field of sellswords. | Without title or land, %name% seeks to join the sort of people %they% used to lord over. | Well-geared this former noble may be, you do notice that the most used piece of equipment %name% has are %their% boots.}"
        es = "{Una decepción constante para un padre delirante | Víctima de una intriga cortesana con veneno y pastel de por medio | Tras renegar públicamente de su propio linaje | Después de que saliera a la luz una relación incestuosa con su hermano | Tras fracasar un golpe contra quien %lo% precedía en la línea sucesoria | Tras llevar por orgullo y soberbia el ejército de su padre a una derrota total | Por matar sin querer durante una cacería a su hermano mayor, heredero al trono | Como precio por elegir mal a sus aliados en una guerra de sucesión | Por intentar vender como esclavos a unos cazadores furtivos capturados | Tras ser sorprendid%o% en la cama con otr%o% noble | Al descubrirse que encabezaba una trama de robo de niños que escandalizó al campesinado | Por dar la espalda a los dioses y provocar un motín entre los laicos | Tras ser vist%o% con el libro de Davkul de los cultistas bajo el brazo}, %name% {fue desheredad%o% y expulsad%o% de la hacienda familiar, para no volver jamás. | fue despojad%o% de sus títulos y desterrad%o% del reino. | fue sacad%o% a la fuerza de sus tierras con la orden de no volver nunca. | comprendió, bajo la amenaza del hacha del verdugo, que ya no tenía sitio en la corte. | llegó a ver la soga del verdugo, y solo una astuta artimaña %lo% libró de ella. | fue marcad%o% con el símbolo de la vergüenza y expulsad%o% de sus tierras. | fue tenid%o% por implicad%o% en una conspiración de más y apartad%o% de sus tierras. | fue considerad%o% demasiado ambicios%o%, un rasgo peligroso entre la nobleza.} {Ahora %name% busca redimirse y estar a la altura del apellido familiar. Algo egoísta para una banda de mercenarios, pero noble a fin de cuentas. | Con la postura hundida por el escándalo, %name% ha perdido aguante ante las dificultades. | Puede que luche con destreza, pero %name% rara vez habla de nadie más que de sí mism%o%. | Aunque sea rápid%o% con la espada, te da la impresión de que alguien como %name% no fue desheredad%o% sin motivo. | Sin suerte y prácticamente en la ruina, %name% se aventura en el oficio de mercenario. | Sin título ni tierras, %name% busca unirse a la clase de gente sobre la que antes mandaba. | Puede que vaya bien equipad%o%, pero te fijas en que lo más gastado del equipo de %name% son sus botas.}"
    }
    // FILE: mod_legends\hooks\skills\backgrounds\eunuch_background.nut
    // en = "Eunuch"
