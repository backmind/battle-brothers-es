    // FILE: mod_legends\hooks\config\tip_of_the_day.nut
    // context: ::Const.TipOfTheDay
    {
        en = "The arenas in the south do not sate the expectations of some - for that there is another place far, far away from prying eyes..."
        es = ""
    }
    // context: ::Const.TipOfTheDay
    {
        en = "If you are having trouble killing trees, try bringing axes."
        es = ""
    }
    // en = "You don't have to be a hero, you're running a business."
    // en base_es
    // en = "Success in Battle Brothers is also about picking the right fights."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "It is said there are wise women in the north who can commune with spirits and carve rune stones"
        es = ""
    }
    // context: ::Const.TipOfTheDay
    {
        en = "If you don't get hit, you can't be killed. Simple."
        es = ""
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Expect to lose some mercenaries."
        es = ""
    }
    // en = "Losing is fun."
    // en base_es
    // en = "Dying is part of a mercenary's job description."
    // en base_es
    // en = "Forests can hide many dangers within."
    // en base_es
    // en = "Not every battle can be won."
    // en base_es
    // en = "A life can be worth little in this world."
    // en base_es
    // en = "Wiedergangers are the dead walking again."
    // en base_es
    // en = "Geists are lost between the physical world and the world beyond, constantly shifting between the two."
    // en base_es
    // en = "Some people will use you and throw you away."
    // en base_es
    // en = "If your plan can fail with bad luck, maybe it isn't good enough of a plan."
    // en base_es
    // en = "Learn from your mistakes. Don't just repeat them and hope you'll get lucky this time."
    // en base_es
    // en = "Do the job. Survive. Get paid."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "All of the tips can be viewed by clicking the question mark icon in your camp."
        es = ""
    }
    // context: ::Const.TipOfTheDay
    {
        en = "You can hide Armor and Helmet layers by shift-clicking on the relevant layer."
        es = ""
    }
    // en = "Shields can be destroyed using axes and some two-handed weapons."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Different types of shields can be better suited against melee or ranged attacks."
        es = ""
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Bucklers and parry daggers are exceptional against small groups or single targets."
        es = ""
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Alt click on friendly caravans to attack them."
        es = ""
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Shields take minor damage each time they are used to deflect an attack, shield expert reduces this damage significantly."
        es = ""
    }
    // en = "Shrubbery can hide characters from being detected from afar."
    // en base_es
    // en = "A character with a height level advantage over their opponent is harder to hit."
    // en base_es
    // en = "Characters can see farther, the higher they are positioned."
    // en base_es
    // en = "Surrounding an opponent from multiple sides makes it easier to score a hit."
    // en base_es
    // en = "Consider putting injured characters in reserve until their wounds have healed."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Consider building up a reserve roster, so you can have a dedicated cook, paymaster or crafter."
        es = ""
    }
    // en = "A missed ranged attack can hit nearby characters, especially if they are in the direct line of fire."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Economic difficulty impacts recruit frequency. A more difficult economy will yield fewer recruits."
        es = ""
    }
    // en = "Ranged weapons work best when firing into groups of enemies - they are bound to hit someone."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Consider forming a shieldwall when overwhelmed."
        es = ""
    }
    // en = "Fulfilling ambitions will raise everyone's mood and grant you renown, as well as some unique rewards."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Use 'CTRL' + 'Left Click' to attack allied parties on the worldmap. This only works if you are currently unemployed."
        es = ""
    }
    // en = "Stunned characters get no attack of opportunity when someone moves inside their zone of control."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Try playing a campaign in legendary mode once you've gained some experience - it's the recommended difficulty."
        es = ""
    }
    // context: ::Const.TipOfTheDay
    {
        en = "The minimum hit chance for any attack is 5%, and the maximum hit chance for any attack is 95%. You can change this in mod options"
        es = ""
    }
    // en = "Characters may sometimes be struck down during combat, but not outright killed, and will survive with a permanent injury."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "If an opponent has better ranged skills than you, try attacking at night."
        es = ""
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Forests, swamps, and mountains can be used to create choke points to defend against greater numbers."
        es = ""
    }
    // context: ::Const.TipOfTheDay
    {
        en = "If your company can run faster than an enemy, eventually they will stop chasing you."
        es = ""
    }
    // en = "Conserve your stamina when in prolonged engagements."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "There is a button next to each character profile to put them into reserve."
        es = ""
    }
    // context: ::Const.TipOfTheDay
    {
        en = "The Black Market contains items otherwise hard to find - for the right price."
        es = ""
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Hunting beasts can get you powerful runes to upgrade your gear"
        es = ""
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Getting hit or dodging exhausts you. The same goes for most of your enemies"
        es = ""
    }
    // context: ::Const.TipOfTheDay
    {
        en = "You can instantly repair items for crowns at armorsmiths"
        es = ""
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Find the right terrain for your party - flat fields do not always make the best battlefields."
        es = ""
    }
    // en = "You can change camera height levels using the + and - keys."
    // en base_es
    // en = "Try to save some crowns for when things turn sour."
    // en base_es
    // en = "You can zoom in and out using the mouse wheel or Page Up and Page Down keys."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
