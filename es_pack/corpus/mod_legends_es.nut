    // FILE: scripts\skills\injury_permanent\legend_infected_injury.nut
    // context: legend_infected_injury.create.m.Name
    {
        en = "Vermesthrope"
        es = "Vermesántropo"
    }
    // context: legend_infected_injury.create.m.Description
    {
        en = "This character is cursed with vermesthropy and will transform into a rat, dropping all gear and attacking wildly unless controlled."
        es = "Este personaje sufre la maldición de la vermesantropía y se transformará en rata, soltando todo su equipo y atacando sin control salvo que logre dominarse."
    }
    // context: legend_infected_injury.getTooltip.ret.text
    {
        en = "The infection has unlocked a new set of perks which help manage the disease. These perks will give you control over their transformations, and let them wield weapons and armor while transformed."
        es = "La infección ha desbloqueado un nuevo conjunto de ventajas que ayudan a sobrellevar la enfermedad. Estas ventajas te darán control sobre sus transformaciones y le permitirán usar armas y armadura mientras dure la transformación."
    }
    // context: legend_infected_injury.getTooltip.ret.push().text
    {
        en = "10% chance to transform per turn during battle in daylight."
        es = "10% de probabilidad por turno de transformarse en las batallas de día."
    }
    // context: legend_infected_injury.getTooltip.ret.push().text
    {
        en = "20% chance to transform per turn during battle at night."
        es = "20% de probabilidad por turno de transformarse en las batallas de noche."
    }
    // context: legend_infected_injury.getTooltip.ret.push().text
    {
        en = "it is currently a full moon, the transformation will happen during any battle tonight"
        es = "ahora mismo hay luna llena: la transformación se producirá en cualquier batalla de esta noche"
    }
    // FILE: scripts\skills\injury_permanent\legend_lycanthropy_injury.nut
    // context: legend_lycanthropy_injury.create.m.Name
