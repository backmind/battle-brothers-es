        // text = "Contract Category: [color=%positive%]" + contract.getCategory() + "[/color]"
        mode = "pattern"
        en = "Contract Category: [color=%positive%]<cat:str>[/color]"
        es = "Categoría del contrato: [color=%positive%]<cat:t>[/color]"
