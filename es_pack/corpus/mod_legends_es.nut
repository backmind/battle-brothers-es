    // FILE: mod_legends\register\modsettings.nut
    // context: map.::Legends.Mod.ModSettings.addPage()
    {
        en = "Map Options"
        es = "Mapa"
    }
    // context: addNCSetting().::MSU.Class.RangeSetting()
    {
        en = "Land Mass Ratio"
        es = "Proporción de tierra"
    }
    // context: addNCSetting().::MSU.Class.RangeSetting()
    {
        en = "Minimum land to water ratio for an acceptable map. Default is 50. Going either extremes on this slider can result in map never getting generated."
        es = "Proporción mínima de tierra frente a agua para que un mapa se dé por válido. El valor por defecto es 50. Llevar este control a cualquiera de los dos extremos puede hacer que el mapa no llegue a generarse nunca."
    }
    // context: addNCSetting().::MSU.Class.RangeSetting()
    {
        en = "Water"
        es = "Agua"
    }
    // context: addNCSetting().::MSU.Class.RangeSetting()
    {
        en = "Impacts how much of the map is water. Small value results in patchy water around the corners of the map. Larger numbers can create a single large island given a low enough land mass ratio."
        es = "Determina qué parte del mapa es agua. Un valor bajo deja manchas de agua dispersas por las esquinas del mapa. Los valores altos pueden crear una única isla grande si la proporción de tierra es lo bastante baja."
    }
    // context: addNCSetting().::MSU.Class.RangeSetting()
    {
        en = "Snowline"
        es = "Límite de nieve"
    }
    // context: addNCSetting().::MSU.Class.RangeSetting()
    {
        en = "Determines where the snowline is generated. Default is 85. This value is inverted. A value of 10 would mean the top 90% of the map is snow."
        es = "Determina dónde se genera el límite de nieve. El valor por defecto es 85. Este valor va invertido: un valor de 10 significa que el 90% superior del mapa es nieve."
    }
    // context: addNCSetting().::MSU.Class.RangeSetting()
    {
        en = "Settlements"
        es = "Asentamientos"
    }
    // context: addNCSetting().::MSU.Class.RangeSetting()
    {
        en = "Maximum number of settlements. Depending on map size, this will try to add the number of settlements on the slider. It will keep the same ratio of settlement types as default Battle Brothers maps. Minimum distance between settlements is 12 tiles. Vanilla default is 19."
        es = "Número máximo de asentamientos. Según el tamaño del mapa, se intentará añadir el número de asentamientos que indique el control. Se mantiene la misma proporción de tipos de asentamiento que en los mapas por defecto de Battle Brothers. La distancia mínima entre asentamientos es de 12 casillas. El valor por defecto del juego base es 19."
    }
    // context: addNCSetting().::MSU.Class.RangeSetting()
    {
        en = "Factions"
        es = "Facciones"
    }
    // context: addNCSetting().::MSU.Class.RangeSetting()
    {
        en = "Maximum number of Factions to try and generate. Depending on map size, this may not add all the factions on the slider."
        es = "Número máximo de facciones que se intentará generar. Según el tamaño del mapa, puede que no se añadan todas las facciones que indique el control."
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "Decked Out Citadels"
        es = "Ciudadelas bien provistas"
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "If enabled, every Citadel will start with all those building attachments map scummers are re-rolling for."
        es = "Si se activa, cada ciudadela empezará con todos esos edificios anexos que buscan quienes regeneran el mapa una y otra vez."
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "All trade buildings available"
        es = "Todos los edificios comerciales"
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "If enabled, ensures there is at least one of each trade location building on the map."
        es = "Si se activa, garantiza que haya al menos uno de cada edificio comercial en el mapa."
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "(Debug) Show Entire Map"
        es = "(Depuración) Mostrar todo el mapa"
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "If enabled, the map will start completely revealed and all enemies and camps will be visible."
        es = "Si se activa, el mapa empezará totalmente descubierto y todos los enemigos y campamentos serán visibles."
    }
    // context: config.::Legends.Mod.ModSettings.addPage()
    {
        en = "Campaign Options"
        es = "Campaña"
    }
    // context: addNCSetting().::MSU.Class.EnumSetting()
    {
        en = "Enabled"
        es = "Activado"
    }
    // context: addNCSetting().::MSU.Class.EnumSetting()
    {
        en = "Disabled"
        es = "Desactivado"
    }
    // context: addNCSetting().::MSU.Class.EnumSetting()
    {
        en = "Enabled (Cosmetic)"
        es = "Activado (estético)"
    }
    // context: addNCSetting().::MSU.Class.EnumSetting()
    {
        en = "Battle Sisters"
        es = "Hermanas de batalla"
    }
    // context: addNCSetting().::MSU.Class.EnumSetting()
    {
        en = "When enabled, most backgrounds will be randomly assigned male or female. Some backgrounds will remain exclusively male or female. Female characters receive +10 fatigue, but -10 hit points.\n\n[u]Disabled[/u]\nNearly Vanilla experience. Regular backgrounds have no female variant, although special backgrounds like the Vala will still appear. No enemy encounters with females. (Yes, your friend the Hex is still here!)\n\n[u]Enabled[/u]\nBeing female has gameplay effects.\n\n[u]Enabled (Cosmetic)[/u]\nBeing female has no effect on stats."
        es = "Si se activa, a la mayoría de los trasfondos se les asignará al azar hombre o mujer. Algunos trasfondos seguirán siendo exclusivamente de hombres o de mujeres. Los personajes femeninos reciben +10 de Fatiga, pero -10 de Puntos de vida.\n\n[u]Desactivado[/u]\nExperiencia casi igual a la del juego base. Los trasfondos normales no tienen variante femenina, aunque seguirán apareciendo trasfondos especiales como la Vala. No te encontrarás con enemigas. (¡Sí, tu amiga la Hexe sigue aquí!)\n\n[u]Activado[/u]\nSer mujer tiene efectos en el juego.\n\n[u]Activado (estético)[/u]\nSer mujer no afecta a los atributos."
    }
    // context: myEnumTooltip
    {
        en = "Specialist Skills bonuses (in example Poacher's arm) count as 25% for non specialist weapons, but will grow by 5% according to the following rules.\n\n[u]Level[/u]\n5% per level (100% at level 16)\n\n[u]Week in company (SSU Style)[/u]\n5% per 7 days the mercenary has been in the company (100% at day 105)\n\n[u]Training[/u]\n5% per camp training level (100% when training completed)"
        es = "Las bonificaciones de las habilidades de especialista (por ejemplo, Brazo de cazador furtivo) cuentan al 25% con armas que no son de especialista, pero crecen un 5% según las siguientes reglas.\n\n[u]Nivel[/u]\n5% por nivel (100% en el nivel 16)\n\n[u]Semanas en la compañía (estilo SSU)[/u]\n5% por cada 7 días de permanencia en la compañía (100% el día 105)\n\n[u]Entrenamiento[/u]\n5% por nivel de entrenamiento en el campamento (100% al completar el entrenamiento)"
    }
    // context: addNCSetting().::MSU.Class.RangeSetting()
    {
        en = "Dynamic Troops Day To Skip"
        es = "Días a saltar (tropas dinámicas)"
    }
    // context: addNCSetting().::MSU.Class.RangeSetting()
    {
        en = "Impacts how fast elite enemies start appearing on the map. If you leave it at 150 they will by default choose according to difficulty: 30 - Legendary, 60 Expert, 90 Veteran and 120 beginner."
        es = "Determina lo pronto que empiezan a aparecer enemigos de élite en el mapa. Si lo dejas en 150, se elegirá por defecto según la dificultad: 30 - Legendario, 60 Experto, 90 Veterano y 120 Principiante."
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "Distance Scaling"
        es = "Escalado por distancia"
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "If enabled, enemies will be stronger the further they spawn from civilization. \n\n Detail: Begins at 14 tiles from the nearest town, enemies spawned at 28 tiles will be twice as strong. \n\n This is in addition to other difficulty settings."
        es = "Si se activa, los enemigos serán más fuertes cuanto más lejos de la civilización aparezcan. \n\n Detalle: empieza a 14 casillas del pueblo más cercano; los enemigos que aparezcan a 28 casillas serán el doble de fuertes. \n\n Esto se suma a los demás ajustes de dificultad."
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "Skip Camp Tutorial"
        es = "Saltar tutorial del campamento"
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "If disabled, you will gradually unlock camping activities by visiting towns. Useful for first playthroughs. \n\n Detail: skips the camp unlock events and ambition, you still need to buy upgrades."
        es = "Si se desactiva, irás desbloqueando poco a poco las actividades del campamento al visitar pueblos. Útil para las primeras partidas. \n\n Detalle: se salta los eventos y la ambición que desbloquean el campamento; las mejoras hay que seguir comprándolas."
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "Recruit Scaling"
        es = "Escalado de reclutas"
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "If enabled, new recruits will gain levels based on the levels in your party and your renown in the world. \n\n  Details: The maximum level of recruits is increased by half the average level of mercs in your company, averaged with your reputation divided by 1,000. \n\n For example: if your company were all level 10, and your renown was 10,000, new recruits could gain up to 7 levels rounded down. \n\n This in addition to normal recruit level variance."
        es = "Si se activa, los nuevos reclutas ganarán niveles en función de los niveles de tu grupo y de tu renombre en el mundo. \n\n  Detalles: el nivel máximo de los reclutas aumenta en la mitad del nivel medio de los mercenarios de tu compañía, promediado con tu renombre dividido entre 1.000. \n\n Por ejemplo: si toda tu compañía fuera de nivel 10 y tu renombre fuera 10.000, los nuevos reclutas podrían ganar hasta 7 niveles, redondeando hacia abajo. \n\n Esto se suma a la variación normal del nivel de los reclutas."
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "Effects Count As Kills"
        es = "Los efectos cuentan como bajas"
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "If enabled, kills by bleeding out, poisoned to death or consecrated are granted to the actor who caused the relevant effect."
        es = "Si se activa, las bajas por desangramiento, envenenamiento o consagración se atribuyen a quien causó el efecto correspondiente."
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "World Economy"
        es = "Economía mundial"
    }
    // context: addNCSetting().::MSU.Class.BooleanSetting()
    {
        en = "If enabled, Settlements will actively trade items and resources and can grow or decline in value \n\n  Details: The value of a settlement is now a dynamic value that grows and declines with caravan arrivals and departures, contracts fullfilled or failed, good or bad settlement events. \n\n The value of the settlement determines how valuable the caravans it creates are, as well as the strength of local militia. \n\n Very prosperous settlements will continue to grow and potentialy add new locations."
        es = "Si se activa, los asentamientos comerciarán activamente con objetos y recursos, y su valor podrá crecer o disminuir \n\n  Detalles: el valor de un asentamiento pasa a ser dinámico y sube o baja con las llegadas y salidas de caravanas, los contratos cumplidos o fallidos y los eventos buenos o malos del asentamiento. \n\n El valor del asentamiento determina cuánto valen las caravanas que crea y la fuerza de su milicia local. \n\n Los asentamientos muy prósperos seguirán creciendo y podrán añadir nuevas ubicaciones."
    }
    // context: tooltip.::Legends.Mod.ModSettings.addPage()
    {
        en = "Tooltips / UI"
        es = "Descripciones / Interfaz"
    }
    // context: tooltip.addTitle()
    {
        en = "Tooltips - Combat"
        es = "Descripciones emergentes - Combate"
    }
    // context: tooltip.addElement().::MSU.Class.BooleanSetting()
    {
        en = "Enhanced Enemy Tooltips"
        es = "Descripciones de enemigos ampliadas"
    }
    // context: tooltip.addElement().::MSU.Class.BooleanSetting()
    {
        en = "Enemy tooltips in tactical battles will show more information, like perks and statuses"
        es = "Las descripciones emergentes de los enemigos en combate táctico mostrarán más información, como ventajas y estados"
    }
    // context: tooltip.addTitle()
    {
        en = "Tooltips - Inventory"
        es = "Descripciones emergentes - Inventario"
    }
    // context: tooltip.addElement().::MSU.Class.BooleanSetting()
    {
        en = "Show Armor/Fatigue Efficiency"
        es = "Mostrar eficiencia armadura/Fatiga"
    }
    // context: tooltip.addElement().::MSU.Class.BooleanSetting()
    {
        en = "Show the Armor value gained per unit of Fatigue cost of an Armor/Helmet Piece/Layer in the Tooltip when the player mouses over an individual Armor/Helmet Piece/Layer.\n\nUseful for people who like to buy their groceries based on price per unit weight"
        es = "Muestra en la descripción emergente el valor de armadura que se obtiene por cada punto de Fatiga que cuesta una pieza/capa de armadura/casco cuando pasas el ratón sobre una pieza/capa individual de armadura/casco.\n\nÚtil para quienes hacen la compra fijándose en el precio por kilo"
    }
    // context: tooltip.addElement().::MSU.Class.BooleanSetting()
    {
        en = "Expanded Armor Layer Tooltips"
        es = "Descripciones de capas de armadura ampliadas"
    }
    // context: tooltip.addElement().::MSU.Class.BooleanSetting()
    {
        en = "Show the Armor value and Fatigue cost of each Armor/Helmet layer in the Tooltip when the player mouses over a combined Armor/Helmet set.\n\nDisabling this may help reduce the Tooltip length to fit better on lower resolution screens"
        es = "Muestra en la descripción emergente el valor de armadura y el costo de Fatiga de cada capa de armadura/casco cuando pasas el ratón sobre un conjunto combinado de armadura/casco.\n\nDesactivarlo puede ayudar a acortar la descripción emergente para que quepa mejor en pantallas de baja resolución"
    }
    // context: tooltip.addElement().::MSU.Class.BooleanSetting()
    {
        en = "Show Item Trade History"
        es = "Mostrar historial comercial"
    }
    // context: tooltip.addElement().::MSU.Class.BooleanSetting()
    {
        en = "Show the trade history of items, such as where they were produced or imported from.\n\nHas no effect if World Economy is disabled"
        es = "Muestra el historial comercial de los objetos, como dónde se produjeron o de dónde se importaron.\n\nNo tiene efecto si la Economía mundial está desactivada"
    }
    // context: tooltip.addTitle()
    {
