        en = "Spadefoot Helm"
        es = "Yelmo de sapo de espuelas"
    }
    // FILE: scripts\items\helmets\named\legend_helm_full_named.nut
    // context: legend_helm_full_named.create.m.NameList
    {
        en = "Bullwark"
        es = "Baluarte"
    }
    // context: legend_helm_full_named.create.m.NameList
    {
        en = "The Summit"
        es = "La cumbre"
    }
    // context: legend_helm_full_named.create.m.NameList
