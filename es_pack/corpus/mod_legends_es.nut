    // FILE: mod_legends\hooks\config\tactical.nut
    // context: ::Const.Tactical.TerrainEffectTooltip.text
    {
        en = "[color=%negative%]-25%[/color] Melee Skill"
        es = "[color=%negative%]-25%[/color] Habilidad cuerpo a cuerpo"
    }
    // context: ::Const.Tactical.TerrainEffectTooltip.text
    {
        en = "[color=%negative%]-25%[/color] Melee Defense"
        es = "[color=%negative%]-25%[/color] Defensa cuerpo a cuerpo"
    }
    // context: ::Const.Tactical.TerrainEffectTooltip.text
    {
        en = "[color=%negative%]-25%[/color] Ranged Defense"
        es = "[color=%negative%]-25%[/color] Defensa a distancia"
    }
    // FILE: mod_legends\hooks\config\tip_of_the_day.nut
    // context: ::Const.TipOfTheDay
    {
        en = "The arenas in the south do not sate the expectations of some - for that there is another place far, far away from prying eyes..."
        es = "Las arenas del sur no colman las expectativas de algunos; para eso existe otro lugar, muy, muy lejos de miradas indiscretas..."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "If you are having trouble killing trees, try bringing axes."
        es = "Si te cuesta matar árboles, intenta llevar hachas."
    }
    // en = "You don't have to be a hero, you're running a business."
    // en base_es
    // en = "Success in Battle Brothers is also about picking the right fights."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "It is said there are wise women in the north who can commune with spirits and carve rune stones"
        es = "Se dice que en el norte hay mujeres sabias capaces de comunicarse con los espíritus y tallar piedras rúnicas"
    }
    // context: ::Const.TipOfTheDay
    {
        en = "If you don't get hit, you can't be killed. Simple."
        es = "Si no te golpean, no te pueden matar. Así de simple."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Expect to lose some mercenaries."
        es = "Espera perder a algunos mercenarios."
    }
    // en = "Losing is fun."
    // en base_es
    // en = "Dying is part of a mercenary's job description."
    // en base_es
    // en = "Forests can hide many dangers within."
    // en base_es
    // en = "Not every battle can be won."
    // en base_es
    // en = "A life can be worth little in this world."
    // en base_es
    // en = "Wiedergangers are the dead walking again."
    // en base_es
    // en = "Geists are lost between the physical world and the world beyond, constantly shifting between the two."
    // en base_es
    // en = "Some people will use you and throw you away."
    // en base_es
    // en = "If your plan can fail with bad luck, maybe it isn't good enough of a plan."
    // en base_es
    // en = "Learn from your mistakes. Don't just repeat them and hope you'll get lucky this time."
    // en base_es
    // en = "Do the job. Survive. Get paid."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "All of the tips can be viewed by clicking the question mark icon in your camp."
        es = "Puedes ver todos los consejos haciendo clic en el icono del signo de interrogación de tu campamento."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "You can hide Armor and Helmet layers by shift-clicking on the relevant layer."
        es = "Puedes ocultar las capas de Armadura y Casco haciendo Mayús + clic en la capa correspondiente."
    }
    // en = "Shields can be destroyed using axes and some two-handed weapons."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Different types of shields can be better suited against melee or ranged attacks."
        es = "Diferentes tipos de escudos pueden ser más adecuados contra ataques cuerpo a cuerpo o ataques a distancia."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Bucklers and parry daggers are exceptional against small groups or single targets."
        es = "Las rodelas y las dagas de parada son excepcionales contra grupos pequeños u objetivos individuales."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Alt click on friendly caravans to attack them."
        es = "Haz ALT + clic en las caravanas amigas para atacarlas."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Shields take minor damage each time they are used to deflect an attack, shield expert reduces this damage significantly."
        es = "Los escudos sufren un daño leve cada vez que se usan para desviar un ataque; la ventaja Experto en escudos reduce considerablemente ese daño."
    }
    // en = "Shrubbery can hide characters from being detected from afar."
    // en base_es
    // en = "A character with a height level advantage over their opponent is harder to hit."
    // en base_es
    // en = "Characters can see farther, the higher they are positioned."
    // en base_es
    // en = "Surrounding an opponent from multiple sides makes it easier to score a hit."
    // en base_es
    // en = "Consider putting injured characters in reserve until their wounds have healed."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Consider building up a reserve roster, so you can have a dedicated cook, paymaster or crafter."
        es = "Considera formar una reserva para contar con un cocinero, un pagador o un artesano dedicados en exclusiva."
    }
    // en = "A missed ranged attack can hit nearby characters, especially if they are in the direct line of fire."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Economic difficulty impacts recruit frequency. A more difficult economy will yield fewer recruits."
        es = "La dificultad económica influye en la frecuencia de reclutas. Una economía más difícil dará menos reclutas."
    }
    // en = "Ranged weapons work best when firing into groups of enemies - they are bound to hit someone."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Consider forming a shieldwall when overwhelmed."
        es = "Considera formar un muro de escudos cuando el enemigo te supere."
    }
    // en = "Fulfilling ambitions will raise everyone's mood and grant you renown, as well as some unique rewards."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Use 'CTRL' + 'Left Click' to attack allied parties on the worldmap. This only works if you are currently unemployed."
        es = "Usa 'CTRL' + 'Clic izquierdo' para atacar a grupos aliados en el mapa mundial. Solo funciona si ahora mismo no trabajas para nadie."
    }
    // en = "Stunned characters get no attack of opportunity when someone moves inside their zone of control."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Try playing a campaign in legendary mode once you've gained some experience - it's the recommended difficulty."
        es = "Intenta jugar una campaña en modo Legendario una vez que hayas ganado algo de experiencia; es la dificultad recomendada."
    }
    // context: ::Const.TipOfTheDay
    {
        // corrige base: falta el verbo y el artículo en "de 5%"; debe ser "es del 5%", como en la segunda mitad de la frase.
        en = "The minimum hit chance for any attack is 5%, and the maximum hit chance for any attack is 95%. You can change this in mod options"
        es = "La probabilidad mínima de asestar cualquier ataque es del 5%, y la probabilidad máxima de asestarlo es del 95%. Puedes cambiarlo en las opciones del mod"
    }
    // en = "Characters may sometimes be struck down during combat, but not outright killed, and will survive with a permanent injury."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "If an opponent has better ranged skills than you, try attacking at night."
        es = "Si un rival es mejor que tú a distancia, intenta atacar de noche."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Forests, swamps, and mountains can be used to create choke points to defend against greater numbers."
        es = "Los bosques, pantanos y montañas pueden servir para crear cuellos de botella con los que defenderte de fuerzas más numerosas."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "If your company can run faster than an enemy, eventually they will stop chasing you."
        es = "Si tu compañía es más rápida que un enemigo, este acabará por dejar de perseguirte."
    }
    // en = "Conserve your stamina when in prolonged engagements."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "There is a button next to each character profile to put them into reserve."
        es = "Junto al perfil de cada personaje hay un botón para pasarlo a la reserva."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "The Black Market contains items otherwise hard to find - for the right price."
        es = "El Mercado Negro ofrece objetos difíciles de encontrar en otros sitios; a cambio de un buen precio."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Hunting beasts can get you powerful runes to upgrade your gear"
        es = "Cazar bestias puede darte runas poderosas para mejorar tu equipo"
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Getting hit or dodging exhausts you. The same goes for most of your enemies"
        es = "Recibir golpes o esquivarlos te agota. Lo mismo vale para la mayoría de tus enemigos"
    }
    // context: ::Const.TipOfTheDay
    {
        en = "You can instantly repair items for crowns at armorsmiths"
        es = "Puedes reparar objetos al instante a cambio de coronas en los armeros"
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Find the right terrain for your party - flat fields do not always make the best battlefields."
        es = "Busca el terreno adecuado para tu grupo; los campos llanos no siempre son los mejores campos de batalla."
    }
    // en = "You can change camera height levels using the + and - keys."
    // en base_es
    // en = "Try to save some crowns for when things turn sour."
    // en base_es
    // en = "You can zoom in and out using the mouse wheel or Page Up and Page Down keys."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "All legendary beasts have weaknesses."
        es = "Todas las bestias legendarias tienen puntos débiles."
    }
    // en = "Try the Ironman mode to experience Battle Brothers the way it's meant to be played."
    // en base_es
    // en = "Ranged weapons are less accurate at night - those of your enemies included."
    // en base_es
    // en = "Some parts of the world are more dangerous than others."
    // en base_es
    // en = "Use ports to fast travel around the world."
    // en base_es
    // en = "Use terrain and chokepoints to your advantage."
    // en base_es
    // en = "The higher their level, the more your men will demand in wages."
    // en base_es
    // en = "View range is decreased at night, both in combat and on the worldmap."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Heavy armor offers great protection, but also slows down the wearer and makes them tire more quickly."
        es = "La armadura pesada ofrece una gran protección, pero también ralentiza al portador y lo hace cansarse más rápido."
    }
    // en = "Heavy helmets can be hard to breathe in and limit the field of vision."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "You can change gamespeed in the gameplay tab of the 'Options' menu!"
        es = "¡Puedes cambiar la velocidad del juego en la pestaña de jugabilidad del menú 'Opciones'!"
    }
    // en = "Different types of enemies require different tactics to beat reliably."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Every enemy in the game can be beaten reliably with the right approach."
        es = "Cualquier enemigo en el juego puede ser vencido de manera segura con el enfoque adecuado."
    }
    // en = "A human is no match for an adult orc physically."
    // en base_es
    // en = "Orc Berserkers gain rage and get tougher to take down, the more blood they have drawn."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        // corrige base: "resolve" es el atributo, que la 1.0 fijó como "Resolución"; "determinación" no coincide con el término.
        en = "Geists test the resolve of your mercenaries - the lower, the more likely they are to panic and flee."
        es = "Los Geists ponen a prueba la Resolución de tus mercenarios; cuanto menor sea, más probabilidades tendrán de entrar en pánico y huir."
    }
    // en = "Orcs rely on raw power and physical prowess."
    // en base_es
    // en = "A goblin is no match for an adult human physically, so they rely on wit and dirty tricks."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Always keep a good stock of provisions - lest your company starve and desert you!"
        es = "¡Siempre mantén un buen suministro de provisiones, no sea que tu compañía pase hambre y te abandone!"
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Difficult terrain, such as mountains and swamp, has your mercenaries use more supplies on the worldmap."
        es = "Los terrenos difíciles, como montañas y pantanos, hacen que tus mercenarios consuman más suministros en el mapa mundial."
    }
    // en = "If you can not win, retreat to fight another day."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Try to reach the very edges of the map before retreating, or you'll risk your company sustaining serious injuries."
        es = "Intenta llegar hasta el borde mismo del mapa antes de retirarte, o te arriesgas a que tu compañía sufra heridas graves."
    }
    // en = "Retreat. Flee. Don't fight every battle to the death."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Use the 'spacebar' key to pause on the worldmap."
        es = "Usa la tecla 'Espacio' para poner en pausa el mapa mundial."
    }
    // en = "The natural habitat of direwolves is the forest."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "You can enable 'Faster AI turns' in the 'Options' menu."
        es = "Puedes habilitar 'Turnos de IA más rápidos' en el menú 'Opciones'."
    }
    // en = "Trees can be hidden in combat using the 'T' key."
    // en base_es
    // en = "Objects blocking tiles can be highlighted using the 'B' key."
    // en base_es
    // en = "Higher renown will unlock more difficult contracts and better pay."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "You need a minimum of 10% bonus across all your brothers for a favoured enemy perk to spawn champions or legendary beasts more frequently"
        es = "Necesitas una bonificación mínima del 10% entre todos tus hermanos para que una ventaja de enemigo predilecto haga aparecer campeones o bestias legendarias con más frecuencia"
    }
    // context: ::Const.TipOfTheDay
    {
        en = "You can change the styles of items in the painting tent, located in your camp. For a price, of course."
        es = "Puedes cambiar el estilo de los objetos en la tienda de pintura de tu campamento. Previo pago, claro."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Tower shields are cumbersome, but can be used to protect others in addition to the user."
        es = "Los escudos de torre son aparatosos, pero sirven para proteger a otros además de a quien los lleva."
    }
    // en = "If a character waits their turn, their position in the turn order of the next round is determined with a penalty of 25% to Initiative."
    // en base_es
    // en = "A 95% chance to hit is also a 5% chance to miss."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Glaives, while still spears, do not benefit from thrust master."
        es = "Las gujas, aunque siguen siendo lanzas, no se benefician de Maestro del lanzazo."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "With staff block, swordstaffs gain 50% of the bonus."
        es = "Con Bloqueo con bastón, los bastones de espada obtienen el 50% de la bonificación."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Just because a brother can't deal damage, doesn't mean they can't be useful."
        es = "Que un hermano no pueda hacer daño no significa que no pueda ser útil."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "There are things more sinister in the sands than the old empire..."
        es = "En las arenas hay cosas más siniestras que el antiguo imperio..."
    }
    // en = "Consider that enemy encampments on hills are harder to assault, especially if they are fortified."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "In the Inventory/Character Screen page, 'A' key selects previous brother, 'D' key selects next brother, the 'S' key toggles reserve status."
        es = "En la pantalla de Inventario/Personaje, la tecla 'A' selecciona al hermano anterior, la tecla 'D' al siguiente y la tecla 'S' activa o desactiva la reserva."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "At 15 points of intensive training will reward that brother with a free perk point and trait"
        es = "Al llegar a 15 puntos de entrenamiento intensivo, ese hermano obtiene un punto de ventaja gratis y un rasgo"
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Larger groups on the world map move more slowly - regardless of terrain."
        es = "En el mapa mundial, los grupos más grandes se mueven más despacio, sea cual sea el terreno."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "The 'Intensive Training' trait can be increased by spending time training with that brother"
        es = "El rasgo 'Entrenamiento intensivo' aumenta si pasas tiempo entrenando con ese hermano"
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Increase your roster size by gaining renown!"
        es = "¡Gana renombre para ampliar el número de miembros de tu compañía!"
    }
    // en = "If you keep losing to an enemy, change your tactics!"
    // en base_es
    // en = "The larger a party on the worldmap, the slower it moves. Yours included."
    // en base_es
    // en = "Use wardogs to hunt down elusive or fleeing enemies."
    // en base_es
    // en = "Use a trained falcon to discover hidden enemies on difficult terrain."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        // corrige base: "Mantén un ojo en" es un calco de "keep an eye on" ("Vigila"), y se perdió la exclamación final del inglés.
        en = "Keep an eye on the mood of your mercenaries. If they are angry for too long, they may desert!"
        es = "Vigila el estado de ánimo de tus mercenarios. Si están enojados durante demasiado tiempo, ¡pueden desertar!"
    }
    // en = "Elevated terrain like hills and mountains allow you to see farther on the worldmap."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "You can have your items repaired at the smith for a fee by using 'ALT' + 'Right Click'."
        es = "Puedes hacer que reparen tus objetos en la herrería por una tarifa usando 'ALT' + 'Clic derecho'."
    }
    // en = "You may find powerful named items far away from civilization by exploring or following tavern rumors."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Masterwork tools, cloth and metal can be found in the possession of difficult enemies and occasionally in shops."
        es = "Las herramientas, telas y metales de factura magistral pueden encontrarse en poder de enemigos difíciles y, de vez en cuando, en las tiendas."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "When hiring new mercenaries at a settlement, after you try out a recruit, you can open a screen to view their perks by clicking on their Character Perks icon."
        es = "Al contratar mercenarios en un asentamiento, después de probar a un recluta puedes abrir una pantalla con sus ventajas haciendo clic en su icono de Ventajas del personaje."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Food can be equipped and consumed in battle to restore health and fatigue."
        es = "La comida puede equiparse y consumirse en combate para recuperar salud y reducir la fatiga."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Ancient Scrolls can have random powerful effects when read. They can be identified by scholars."
        es = "Los pergaminos antiguos pueden tener efectos poderosos y aleatorios al leerse. Los eruditos pueden identificarlos."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Ranged weapon accuracy drops with distance, unless you are using a northern slingstaff."
        es = "La precisión de las armas a distancia baja cuanto más lejos está el objetivo, salvo si usas una honda de bastón norteña."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Slings have unlimited ammo, but still break from use."
        es = "Las hondas tienen munición ilimitada, pero aun así se rompen con el uso."
    }
    // en = "Bows perform better against unarmored targets."
    // en base_es
    // en = "Daggers can be used to attack weak spots in armor and deal damage directly to hitpoints."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Wooden stakes do extra damage against necrosavants."
        es = "Las estacas de madera hacen daño adicional contra los necrosavantes."
    }
    // en = "Crossbows require less skill to fire accurately than bows, but are slower to use."
    // en base_es
    // en = "Clubs and maces can stun or incapacitate targets."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Throwing weapons can be deadly on short distances, but their accuracy drops sharply the farther away the target is."
        es = "Las armas arrojadizas pueden ser mortales a corta distancia, pero su precisión disminuye considerablemente a medida que el objetivo está más lejos."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Longswords are more agile then Zweihanders or Greatswords - bigger is not always better!"
        es = "Las espadas largas son más ágiles que los Zweihanders o los mandobles; ¡más grande no siempre es mejor!"
    }
    // en = "Spears are good defensive weapons due to their Spearwall ability."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Spears and Swords are ideal for new recruits due to their simplicity."
        es = "Las lanzas y las espadas son ideales para los reclutas nuevos por su sencillez."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Estocs are strong fencing swords, but require two hands to use."
        es = "Los estoques son espadas de esgrima robustas, pero hay que usarlos a dos manos."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Consider using Warbrands or Longswords to better benefit from 'Double Strike' or 'Reach Advantage' perks."
        es = "Considera usar faussars o espadas largas para sacar más partido de las ventajas 'Doble golpe' o 'Ventaja del alcance'."
    }
    // en = "Use throwing nets to restrict the movement of particularly dangerous enemies."
    // en base_es
    // en = "Warhammers and Military Picks can make short work of heavy armor."
    // en base_es
    // en = "The Billhook, Pike and Longaxe can attack over 2 tiles, unlike most other melee weapons."
    // en base_es
    // en = "Flails ignore the defense bonus of shields."
    // en base_es
    // en = "Two-handed axes can hit both head and body with a single hit."
    // en base_es
    // en = "Two-handed axes can hit up to 6 targets with a single round swing."
    // en base_es
    // en = "Cleavers can inflict bleeding wounds."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Staves and slings are ideal supporting weapons for characters who are not fit for direct combat."
        es = "Los bastones y las hondas son armas de apoyo ideales para los personajes que no sirven para el combate directo."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Have you assigned all your characters to camp tasks recently?"
        es = "¿Has asignado últimamente tareas de campamento a todos tus personajes?"
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Training in camp will give you raw experience points - the longer you train the bigger the rewards and the risks."
        es = "Entrenar en el campamento te dará puntos de experiencia en bruto; cuanto más entrenes, mayores serán las recompensas y los riesgos."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "You can toggle repair twice in your inventory to set items to scrap."
        es = "En el inventario, puedes pulsar dos veces la opción de reparar para marcar objetos como chatarra."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Herbalists can gather medicine, poisons and mushrooms when assigned to gather in camp."
        es = "Los herbolarios pueden recolectar medicina, venenos y hongos cuando se les asigna la recolección en el campamento."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Make camp to have your company heal and repair their equipment faster."
        es = "Acampa para que tu compañía se cure y repare su equipo más rápido."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Use 'ALT' + 'Right Click' to mark items for repair in your stash. Items equipped by your mercenaries are repaired automatically."
        es = "Usa 'ALT' + 'Clic derecho' para marcar objetos de tu almacén para reparar. Los objetos que llevan equipados tus mercenarios se reparan automáticamente."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Training in camp may result in a temporary injury without the training tent upgrade - but training with a temporary injury could cause a permanent one!"
        es = "Sin la mejora de la tienda de entrenamiento, entrenar en el campamento puede causar una herida temporal; ¡pero entrenar con una herida temporal podría causar una permanente!"
    }
    // context: ::Const.TipOfTheDay
    {
        en = "'Duelist' has been changed in Legends. Check the 'Double Grip' tooltip."
        es = "'Duelista' ha cambiado en Legends. Consulta la descripción de 'Agarre a dos manos'."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "The 'Scholar' perk can allow characters to increase the amount of loot they find after battle."
        es = "La ventaja 'Erudito' puede permitir a los personajes aumentar el botín que encuentran tras el combate."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Unarmed is good at tiring out enemies who have roughly similar or lower total stamina than you, and puts them at a disadvantage."
        es = "El combate Sin armas es bueno para agotar a los enemigos con una resistencia total parecida o inferior a la tuya, y los pone en desventaja."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Perks are not exclusive to the group they came with."
        es = "Las ventajas no son exclusivas del grupo con el que llegaron."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Those with the 'Potion Brewer' perk can craft potions while gathering, including potions of knowledge."
        es = "Quienes tengan la ventaja 'Preparador de pociones' pueden fabricar pociones mientras recolectan, incluidas las pociones de conocimiento."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "The 'Steel Brow' perk can turn round-ending stuns into mere dazes."
        es = "La ventaja 'Cabeza dura' puede convertir los aturdimientos que te hacen perder el turno en simples atontamientos."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "The 'Perfect Focus' perk is a good way to deal a lot of damage quickly, for a price."
        es = "La ventaja 'Enfoque perfecto' es una buena forma de hacer mucho daño rápidamente, aunque tiene su precio."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "The 'Nimble' perk only protects hitpoints, not armour. Unless you also pick up 'Relentless'."
        es = "La ventaja 'Ligero' solo protege los Puntos de vida, no la armadura. A menos que también elijas 'Implacable'."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "The 'Ballistics' skill can greatly increase your chance to hit at far ranges."
        es = "La habilidad 'Balística' puede aumentar mucho tu probabilidad de acertar a gran distancia."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Learn the 'Tactical Maneuvers' perks for additional mobility in battle."
        es = "Aprende las ventajas de 'Maniobras tácticas' para tener más movilidad en combate."
    }
    // en = "The 'Lone Wolf' perk is not affected by nearby dogs or allies that are not part of your company."
    // en base_es
    // en = "The 'Fast Adaptation' perk reduces variance of randomness."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "A character dedicated to unarmed combat may lack damage, but they make up for it with utility."
        es = "A un personaje dedicado al combate sin armas puede faltarle daño, pero lo compensa con su utilidad."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Grappling an enemy sets them up to be choked and deal a large amount of damage."
        es = "Agarrar a un enemigo lo deja listo para estrangularlo e infligirle mucho daño."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Jugglers can leap and tumble, and have a great aim."
        es = "Los malabaristas pueden saltar y dar volteretas, y tienen una gran puntería."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Herbalists can create items and brew potions."
        es = "Los herbolarios pueden crear objetos y preparar pociones."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Peddlers trade bonuses stack, trade runs are possible."
        es = "Las bonificaciones de comercio de los vendedores ambulantes se acumulan, así que puedes hacer rutas comerciales."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "The Cabal uses medicine to keep their minions ready to summon."
        es = "La Camarilla usa medicina para tener a sus esbirros listos para ser invocados."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Valas are mystic women capable of inscribing powerful runes on your gear."
        es = "Las valas son mujeres místicas capaces de inscribir runas poderosas en tu equipo."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Hiring different backgrounds affects your healing rate, repair, trade, food and movement speed. Try a varied roster."
        es = "Contratar distintos trasfondos afecta a tu ritmo de curación, reparación, comercio, comida y velocidad de movimiento. Prueba con una compañía variada."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Apprentices, blacksmiths and ironmongers can help repair your equipment quickly."
        es = "Los aprendices, herreros y ferreteros pueden ayudar a reparar tu equipo rápidamente."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Your stash and resource size is determined by the people you hire."
        es = "El tamaño de tu almacén y de tus recursos depende de la gente que contrates."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Women have more fatigue but less health than their male counterparts."
        es = "Las mujeres tienen más fatiga pero menos salud que sus equivalentes masculinos."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Hunters and poachers will help you move through forests more quickly."
        es = "Los cazadores y los furtivos te ayudarán a moverte más rápido por los bosques."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Bakers and Servants can craft food into fresh pies and puddings."
        es = "Los panaderos y los sirvientes pueden convertir la comida en pasteles y budines recién hechos."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Houndmasters can improve the combat skills of dogs and breed them."
        es = "Los maestros de sabuesos pueden criarlos y mejorar sus habilidades de combate."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Fishermen and Ratcatchers can develop powerful net skills."
        es = "Los pescadores y los cazadores de ratas pueden desarrollar poderosas habilidades con la red."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Inventors can craft prosthetics to help permanent injuries be less of a burden."
        es = "Los inventores pueden fabricar prótesis para que las heridas permanentes sean una carga menor."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Minstrels can play powerful music to heal, restore and control the battlefield."
        es = "Los juglares pueden tocar música poderosa para curar, restablecer y controlar el campo de batalla."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Cultists have strong resolve and skills in the right conditions."
        es = "Los cultistas tienen una gran Resolución y buenas habilidades en las condiciones adecuadas."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Eunuchs are immune to the charms of hexen."
        es = "Los eunucos son inmunes a los encantos de las Hexen."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Avatars cannot be charmed."
        es = "Los avatares no pueden ser encantados."
    }
    // en = "Highly talented characters can come from all backgrounds."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Farmhands are skilled with a variety of farm tools."
        es = "Los peones de granja manejan con destreza muchos aperos de labranza."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Hiring cannibals can keep you well fed after battles with humans."
        es = "Contratar caníbales puede asegurarte comida abundante tras las batallas contra humanos."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Taxidermists are experts at crafting in camp."
        es = "Los taxidermistas son expertos en fabricar objetos en el campamento."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Tailors and seamstresses can unlock cloak crafting."
        es = "Los sastres y las costureras pueden desbloquear la fabricación de capas."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Warlocks require medicine to maintain their thralls, but food to occupy their puppets."
        es = "Los brujos necesitan medicina para mantener a sus siervos, pero comida para ocupar a sus marionetas."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Miners help you move quickly through mountains."
        es = "Los mineros te ayudan a moverte rápido por las montañas."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Indebted, Wildmen and Brawlers have the potential to become skilled unarmed combatants."
        es = "Los endeudados, los salvajes y los camorristas pueden llegar a ser hábiles luchadores sin armas."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "A Blacksmith can repair armour in battle...for a steep cost."
        es = "Un herrero puede reparar armaduras en combate... a un alto precio."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Herbalists and Monks can heal in battle...for a steep cost."
        es = "Los herbolarios y los monjes pueden curar en combate... a un alto precio."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Your mercenaries will interact with each other differently depending on their backgrounds and traits."
        es = "Tus mercenarios se relacionarán entre sí de forma distinta según sus trasfondos y rasgos."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Unholds and Rock Unhold regeneration can be countered with spider poison."
        es = "La regeneración de los Troles y del Trol de roca puede contrarrestarse con veneno de araña."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Defeating a Schrat may reward you with an enchanted shield rune."
        es = "Derrotar a un Schrat puede recompensarte con una runa encantada de escudo."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Defeating Hexe may reward you with an enchanted helm rune."
        es = "Derrotar a una Hexe puede recompensarte con una runa encantada de casco."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Defeating a Demon Alp will reward you with a weapon rune of unbreaking."
        es = "Derrotar a un Alp demoníaco te recompensará con una runa de arma de irrompibilidad."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "The Undead are unaffected by fatigue and morale."
        es = "Los no muertos no se ven afectados por la fatiga ni por la moral."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Alps, Schrats and Hexen can drop powerful runes to upgrade your gear."
        es = "Los Alps, los Schrats y las Hexen pueden soltar runas poderosas para mejorar tu equipo."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Spiders can ignore armor completely if their target is webbed."
        es = "Las arañas pueden ignorar por completo la armadura si su objetivo está atrapado en una telaraña."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Wiederganger's bite can infect the target, and being killed by it can even cause it to be risen to fight on their side."
        es = "El mordisco de un Wiederganger puede infectar al objetivo y, si muere por él, puede incluso alzarse para luchar en su bando."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Skeletons are highly resistant to ranged attacks and fire. But less so to throwing axes and crossbows."
        es = "Los esqueletos son muy resistentes a los ataques a distancia y al fuego. Pero no tanto a las hachas arrojadizas y las ballestas."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Every seven days settlements will increase in wealth naturally."
        es = "Cada siete días, los asentamientos aumentan su riqueza de forma natural."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Successful contracts and trade caravans will increase a settlement's wealth."
        es = "Los contratos cumplidos y las caravanas comerciales aumentan la riqueza de un asentamiento."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Raiding will decrease a settlement's wealth over time, if it falls below 50%, it may decrease in size."
        es = "Los saqueos reducen con el tiempo la riqueza de un asentamiento; si cae por debajo del 50%, puede reducirse de tamaño."
    }
    // context: ::Const.TipOfTheDay
    {
        en = "Greenskins and Undead can permamently destroy settlements, keep an eye on the frontier!"
        es = "Los pieles verdes y los no muertos pueden destruir asentamientos para siempre. ¡Vigila la frontera!"
    }
    // en = "Selling in rich and big cities will net you the most crowns for your goods."
    // en base_es
    // en = "Use trading to supplement your income."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "When a settlement's wealth is above 100%, it has a chance to grow and upgrade. Take care of your settlements...or don't."
        es = "Cuando la riqueza de un asentamiento supera el 100%, puede crecer y mejorar. Cuida de tus asentamientos... o no."
    }
    // en = "Roads are the fastest way to travel over land, but not always the safest."
    // en base_es
    // context: ::Const.TipOfTheDay
    {
        en = "Many threats are drawn to roads and will lie in ambush for any who come near."
        es = "Muchas amenazas acuden a los caminos y tienden emboscadas a quien se acerque."
    }
    // en = "Not every contract is worth the risk."
