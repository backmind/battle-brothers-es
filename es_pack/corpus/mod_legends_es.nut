    // FILE: scripts\skills\traits\legend_necromancer_trait.nut
    // context: legend_necromancer_trait.create.m.Description
    {
        en = "This trait is used to alter daily reputation decline for all factions."
        es = "Este rasgo sirve para modificar el descenso diario de reputación con todas las facciones."
    }
    // context: legend_necromancer_trait.getTooltip.text
    {
        en = "In theroy we could just tell you how to make mustard gas in this tooltip and the feds would be none the wiser"
        es = "En teoría podríamos explicarte cómo fabricar gas mostaza en este recuadro y los federales ni se enterarían"
    }
    // FILE: scripts\skills\traits\legend_noble_killer_trait.nut
    // context: legend_noble_killer_trait.create.m.Name
    {
        en = "Noble Killer"
        es = "Asesino de nobles"
    }
    // context: legend_noble_killer_trait.create.m.Description
    {
        en = "This character has learned from birth how to fight noble houses"
        es = "Este personaje ha aprendido desde la cuna a combatir a las casas nobles"
    }
    // context: legend_noble_killer_trait.getTooltip.text
    {
        en = "[color=%positive%]+10[/color] Melee Skill when in a battle against a noble house"
        es = "[color=%positive%]+10[/color] Habilidad cuerpo a cuerpo en combate contra una casa noble"
    }
    // context: legend_noble_killer_trait.getTooltip.text
    {
        en = "[color=%positive%]+10[/color] Ranged Skill when in a battle against a noble house"
        es = "[color=%positive%]+10[/color] Habilidad a distancia en combate contra una casa noble"
    }
    // FILE: scripts\skills\traits\legend_nomad_trait.nut
    // context: legend_nomad_trait.create.m.Description
    {
        en = "This trait is used to alter daily reputation decline for city state factions and increase nomad relatiosn per head. Stop using breditor you cheating fuck."
        es = "Este rasgo sirve para modificar el descenso diario de reputación con las facciones de las ciudades-estado y aumentar las relaciones con los nómadas por cabeza. Deja de usar el breditor, tramposo de mierda."
    }
    // context: legend_nomad_trait.getTooltip.text
    {
        en = "This trait is used to alter daily reputation decline for city state factions and increase that of the nomad faction. If you can see this tooltip then something is broken - or someone is fucking with things that they shouldn't be."
        es = "Este rasgo sirve para modificar el descenso diario de reputación con las facciones de las ciudades-estado y aumentar el de la facción nómada. Si puedes ver este recuadro, algo está roto, o alguien anda jodiendo con cosas que no debería."
    }
    // FILE: scripts\skills\traits\legend_peasant_trait.nut
    // context: legend_peasant_trait.create.m.Description
    {
        en = "This trait is used to alter daily reputation decline for noble factions."
        es = "Este rasgo sirve para modificar el descenso diario de reputación con las facciones nobles."
    }
    // context: legend_peasant_trait.getTooltip.text
    {
        en = "This trait is used to alter daily reputation decline for noble factions and remove the fear of nobles trait. If you can see this tooltip then something is broken - or someone is fucking with things they shouldn't be."
        es = "Este rasgo sirve para modificar el descenso diario de reputación con las facciones nobles y eliminar el rasgo de miedo a los nobles. Si puedes ver este recuadro, algo está roto, o alguien anda jodiendo con cosas que no debería."
    }
    // FILE: scripts\skills\traits\legend_pragmatic_trait.nut
    // context: legend_pragmatic_trait.create.m.Name
    {
        en = "Pragmatic"
        es = "Pragmático"
    }
    // context: legend_pragmatic_trait.create.m.Description
    {
        en = "Concerned more with matters of fact than with what could or should be."
        es = "Le preocupan más los hechos que lo que podría o debería ser."
    }
    // context: legend_pragmatic_trait.getTooltip.text
    {
        en = "[color=%negative%]-10%[/color] Chance To Hit Head"
        es = "[color=%negative%]-10%[/color] Probabilidad de golpear la cabeza"
    }
    // FILE: scripts\skills\traits\legend_predictable_trait.nut
    // context: legend_predictable_trait.create.m.Name
    {
        en = "Predictable"
        es = "Predecible"
    }
    // context: legend_predictable_trait.create.m.Description
    {
        en = "It is always quite clear what this character is about to do, announcing hits before they come and looking intently for a moment before deciding to move. This gives time for enemies to dodge away."
        es = "Siempre está bastante claro lo que este personaje va a hacer: anuncia sus golpes antes de darlos y se queda mirando fijamente un momento antes de decidirse a moverse. Eso da tiempo a los enemigos para esquivar."
    }
    // context: legend_predictable_trait.getTooltip.text
    {
        en = "[color=%negative%]-5[/color] Initiative"
        es = "[color=%negative%]-5[/color] Iniciativa"
    }
    // FILE: scripts\skills\traits\legend_prosthetic_ear.nut
    // context: legend_prosthetic_ear.create.m.Description
    {
        en = "A wax ear stitched into one's head. Hardly a proper replacement, but some sense of balance is returned and very faint noises can be heard."
        es = "Una oreja de cera cosida a la cabeza. Difícilmente es un sustituto digno, pero devuelve algo de equilibrio y permite oír ruidos muy débiles."
    }
    // context: legend_prosthetic_ear.create.m.Name
    {
        en = "Enhanced Prosthetic Ear"
        es = "Oreja protésica mejorada"
    }
    // context: legend_prosthetic_ear.create.m.Description
    {
        en = "Until you look closely this prosthetic is hard to distinguish from a real ear and seems to convey sound as good as a real ear. An otherworldly scream is a lot less frightening when one can choose if they want to hear it at all, so against your better judgement, a gate is installed to filter out noise. Sadly your orders also fall on deaf ears."
        es = "Hasta que uno se fija bien, cuesta distinguir esta prótesis de una oreja de verdad, y parece transmitir el sonido igual de bien que una. Un grito de otro mundo da mucho menos miedo cuando uno puede elegir si quiere oírlo o no, así que, en contra de tu buen juicio, se le instala una compuerta que filtra el ruido. Por desgracia, tus órdenes también caen en oídos sordos."
    }
    // context: legend_prosthetic_ear.getTooltip.ret.push().text
    {
        en = "[color=%negative%]-5%[/color] Initiative"
        es = "[color=%negative%]-5%[/color] Iniciativa"
    }
    // context: legend_prosthetic_ear.getTooltip.result.push().text
    {
        en = "[color=%positive%]+10[/color] Resolve at morale checks against fear, panic or mind control effects"
        es = "[color=%positive%]+10[/color] Resolución en las pruebas de moral contra efectos de miedo, pánico o control mental"
    }
    // FILE: scripts\skills\traits\legend_prosthetic_eye.nut
    // context: legend_prosthetic_eye.create.m.Description
    {
        en = "My, what pretty eyes! This one seems a bit off, however, and the owner has to constantly shift their pupil back into position to look straight."
        es = "¡Vaya, qué ojos tan bonitos! Aunque este parece un poco desviado, y quien lo lleva tiene que recolocarse la pupila constantemente para mirar al frente."
    }
    // context: legend_prosthetic_eye.getTooltip.ret.push().text
    {
        en = "[color=%negative%]-2[/color] Vision"
        es = "[color=%negative%]-2[/color] Visión"
    }
    // FILE: scripts\skills\traits\legend_prosthetic_finger.nut
    // context: legend_prosthetic_finger.getTooltip.ret.text
    {
        en = "[color=%negative%]-2%[/color] Melee Skill"
        es = "[color=%negative%]-2%[/color] Habilidad cuerpo a cuerpo"
    }
    // context: legend_prosthetic_finger.getTooltip.ret.text
    {
        en = "[color=%negative%]-2%[/color] Ranged Skill"
        es = "[color=%negative%]-2%[/color] Habilidad a distancia"
    }
    // FILE: scripts\skills\traits\legend_prosthetic_foot.nut
    // context: legend_prosthetic_foot.create.m.Description
    {
        en = "Amputation is a thing of life, and the wearer of this prosthetic foot was lucky enough to be given a replacement after the removal of their maimed one. It's awful to walk on, but at least you can walk."
        es = "La amputación es parte de la vida, y quien lleva este pie protésico tuvo la suerte de recibir un sustituto después de que le quitaran el mutilado. Caminar con él es horrible, pero al menos se puede caminar."
    }
    // context: legend_prosthetic_foot.create.m.Name
    {
        en = "Enhanced Prosthetic Foot"
        es = "Pie protésico mejorado"
    }
    // context: legend_prosthetic_foot.create.m.Description
    {
        en = "Amputation might be a part of mercenary life, but not only can the replacement be comfortable to walk with but also useful."
        es = "Puede que la amputación forme parte de la vida del mercenario, pero el sustituto no solo puede ser cómodo para caminar, sino también útil."
    }
    // context: legend_prosthetic_foot.getTooltip.text
    {
        // text = "Builds up [color=%negative%]"+ malusFat + "[/color] more fatigue for each tile travelled"
        mode = "pattern"
        en = "Builds up [color=%negative%]<fat:int>[/color] more fatigue for each tile travelled"
        es = "Acumula [color=%negative%]<fat>[/color] de Fatiga más por cada casilla recorrida"
    }
    // context: legend_prosthetic_foot.getTooltip.text
    {
        // text = "[color=%negative%]-"+ malusIni + "%[/color] Initiative"
        mode = "pattern"
        en = "[color=%negative%]-<ini:int>%[/color] Initiative"
        es = "[color=%negative%]-<ini>%[/color] Iniciativa"
    }
    // FILE: scripts\skills\traits\legend_prosthetic_forearm.nut
    // context: legend_prosthetic_forearm.create.m.Description
    {
        en = "A brand new arm for a sword to be swung with. Of course, the user loses most control in their arm, all feeling, and must manually change the position of their fingers with their other hand. But still, at least it's something."
        es = "Un brazo nuevecito con el que blandir una espada. Eso sí, quien lo lleva pierde casi todo el control del brazo y toda la sensibilidad, y tiene que recolocarse los dedos con la otra mano. Pero bueno, al menos es algo."
    }
    // FILE: scripts\skills\traits\legend_prosthetic_hand.nut
    // context: legend_prosthetic_hand.create.m.Description
    {
        en = "Fine craftsmanship allows the wearer of this prosthetic to articulate the joints with some effort, allowing the fingers to be bent to hold a shield or a sword. Of course, you lose quite a bit of finesse with such an item."
        es = "Su fina artesanía permite a quien lleva esta prótesis mover las articulaciones con cierto esfuerzo, de modo que puede doblar los dedos para sujetar un escudo o una espada. Por supuesto, con algo así se pierde bastante destreza."
    }
    // context: legend_prosthetic_hand.create.m.Name
    {
        en = "Enhanced Prosthetic Hand"
        es = "Mano protésica mejorada"
    }
    // context: legend_prosthetic_hand.create.m.Description
    {
        en = "A masterwork prosthetic hand which articulates joints without resistance. The fingers grip whatever they are holding very tightly, making it near impossible to knock a weapon from this hand. Spikes were added to make punches hurt even more."
        es = "Una mano protésica magistral cuyas articulaciones se mueven sin resistencia. Los dedos aprietan con mucha fuerza lo que sujetan, lo que hace casi imposible arrancar un arma de esta mano. Se le añadieron pinchos para que los puñetazos duelan aún más."
    }
    // context: legend_prosthetic_hand.getTooltip.ret.extend().text
    {
        // text = "[color=%negative%]-" + malus + "%[/color] Melee Defense when using a shield"
        mode = "pattern"
        en = "[color=%negative%]-<malus:int>%[/color] Melee Defense when using a shield"
        es = "[color=%negative%]-<malus>%[/color] Defensa cuerpo a cuerpo al usar escudo"
    }
    // context: legend_prosthetic_hand.getTooltip.ret.extend().text
    {
        // text = "[color=%negative%]-" + malus + "%[/color] Ranged Defense when using a shield"
        mode = "pattern"
        en = "[color=%negative%]-<malus:int>%[/color] Ranged Defense when using a shield"
        es = "[color=%negative%]-<malus>%[/color] Defensa a distancia al usar escudo"
    }
    // context: legend_prosthetic_hand.getTooltip.ret.extend().text
    {
        // text = "[color=%negative%]-" + malus + "%[/color] Melee Skill when NOT using a shield"
        mode = "pattern"
        en = "[color=%negative%]-<malus:int>%[/color] Melee Skill when NOT using a shield"
        es = "[color=%negative%]-<malus>%[/color] Habilidad cuerpo a cuerpo al NO usar escudo"
    }
    // context: legend_prosthetic_hand.getTooltip.ret.extend().text
    {
        // text = "[color=%negative%]-" + malus + "%[/color] Ranged Skill when NOT using a shield"
        mode = "pattern"
        en = "[color=%negative%]-<malus:int>%[/color] Ranged Skill when NOT using a shield"
        es = "[color=%negative%]-<malus>%[/color] Habilidad a distancia al NO usar escudo"
    }
    // FILE: scripts\skills\traits\legend_prosthetic_leg.nut
    // context: legend_prosthetic_leg.create.m.Description
    {
        en = "A fake leg of wood and metal. Not much to run on, but at least it'll let a man hobble. While it makes the most annoying clanking noise you've ever heard, it'll ensure a mercenary is able to walk."
        es = "Una pierna falsa de madera y metal. No da para correr, pero al menos permite a un hombre renquear. Aunque hace el repiqueteo metálico más molesto que hayas oído nunca, garantiza que un mercenario pueda caminar."
    }
    // context: legend_prosthetic_leg.create.m.Name
    {
        en = "Enhanced Prosthetic Leg"
        es = "Pierna protésica mejorada"
    }
    // context: legend_prosthetic_leg.create.m.Description
    {
        en = "Lovingly recrafted prosthetic leg, which due to some mechanical marvel moves almost like a real leg. It still doesn't perform like a normal leg, but walking with it doesn't resemble shambling. Some reinforced pieces with spikes allow the wearer's kicks to be very damaging."
        es = "Pierna protésica rehecha con mimo que, gracias a alguna maravilla mecánica, se mueve casi como una de verdad. Sigue sin rendir como una pierna normal, pero caminar con ella ya no parece un arrastrar de pies. Unas piezas reforzadas con pinchos hacen que las patadas de quien la lleva sean muy dañinas."
    }
    // context: legend_prosthetic_leg.getTooltip.ret.text
    {
        en = "[color=%negative%]-20%[/color] Initiative"
        es = "[color=%negative%]-20%[/color] Iniciativa"
    }
    // context: legend_prosthetic_leg.getTooltip.ret.push().text
    {
        en = "[color=#400080]Kick[/color] will now deal 15-30 damage"
        es = "[color=#400080]Patada[/color] ahora inflige 15-30 de daño"
    }
    // FILE: scripts\skills\traits\legend_prosthetic_nose.nut
    // context: legend_prosthetic_nose.create.m.Description
    {
        en = "A roughly made fake nose that does more to ensure the wearer can actually breath than actually make them look nice. Try not to lie."
        es = "Una nariz falsa de factura tosca que sirve más para que quien la lleva pueda respirar que para que luzca bien. Procura no mentir."
    }
    // context: legend_prosthetic_nose.create.m.Name
    {
        en = "Enhanced Prosthetic Nose"
        es = "Nariz protésica mejorada"
    }
    // context: legend_prosthetic_nose.create.m.Description
    {
        en = "Lovingly recrafted to both ensure the wearer can breath normally, but also has a mechanism that slowly releases vapors from berserker mushrooms that allows the user to enter a sort of combat trance. Will not feel injuries and has increased aggression."
        es = "Rehecha con mimo para que quien la lleva respire con normalidad, también tiene un mecanismo que libera poco a poco vapores de hongos berserker que permiten entrar en una especie de trance de combate. No siente las heridas y aumenta su agresividad."
    }
    // context: legend_prosthetic_nose.getTooltip.ret.push().text
    {
        en = "[color=%negative%]-5%[/color] Max Fatigue"
        es = "[color=%negative%]-5%[/color] Fatiga máxima"
    }
    // context: legend_prosthetic_nose.getTooltip.ret.extend().text
    {
        en = "[color=%positive%]+10%[/color] Damage in Melee"
        es = "[color=%positive%]+10%[/color] de daño cuerpo a cuerpo"
    }
    // FILE: scripts\skills\traits\legend_rotten_flesh_trait.nut
    // context: legend_rotten_flesh_trait.create.m.Name
    {
        en = "Rotting Flesh"
        es = "Carne putrefacta"
    }
    // context: legend_rotten_flesh_trait.create.m.Description
    {
        en = "With flesh is pale and gaunt, this one rots away as merely a souless animal."
        es = "De carne pálida y demacrada, se pudre como un simple animal sin alma."
    }
    // context: legend_rotten_flesh_trait.getTooltip.text
    {
        en = "-3 Action Points. Recovers hitpoints at only 10% of the normal rate. Requires 3 provisions a day."
        es = "-3 Puntos de acción. Recupera Puntos de vida a solo un 10% del ritmo normal. Necesita 3 provisiones al día."
    }
    // context: legend_rotten_flesh_trait.getTooltip.text
    {
        en = "Immune to bleeding, poison and most types of injuries."
        es = "Inmune al sangrado, al veneno y a la mayoría de las heridas."
    }
    // context: legend_rotten_flesh_trait.getTooltip.text
    {
        en = "Not effected by fatigue, but needs fatigue to equip items."
        es = "No le afecta la Fatiga, pero necesita Fatiga para equipar objetos."
    }
    // context: legend_rotten_flesh_trait.getTooltip.text
    {
        en = "Not affected by morale or allies fleeing and dying. Requires no pay."
        es = "No le afectan la moral ni que sus aliados huyan o mueran. No necesita paga."
    }
    // context: legend_rotten_flesh_trait.getTooltip.text
    {
        en = "Not affected by mood. Experience is gained at 75% normal rate."
        es = "No le afecta el estado de ánimo. Gana experiencia a un 75% del ritmo normal."
    }
    // FILE: scripts\skills\traits\legend_seductive_trait.nut
    // context: legend_seductive_trait.create.m.Name
    {
        en = "Seductive"
        es = "Seductor"
    }
    // context: legend_seductive_trait.create.m.Description
    {
        en = "Although many things can be taken at the point of a sword, some things will always be more potent than cold steel; the flash of an eyelash, the locking of a gaze..."
        es = "Aunque muchas cosas se consiguen a punta de espada, hay otras que siempre serán más poderosas que el frío acero: un batir de pestañas, una mirada sostenida..."
    }
    // context: legend_seductive_trait.getTooltip.text
    {
        en = "[color=%positive%]+0.3%[/color] barter skill"
        es = "[color=%positive%]+0.3%[/color] de habilidad de regateo"
    }
    // FILE: scripts\skills\traits\legend_slack_trait.nut
