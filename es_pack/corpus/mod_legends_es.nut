        en = "Melee Damage bonus [color=%negative%]halved[/color] due to not being engaged in melee"
        es = "Bonificación de daño cuerpo a cuerpo [color=%negative%]reducida a la mitad[/color] por no estar en combate cuerpo a cuerpo"
