    // en = "You lose <v:val_tag> Crowns"
    // en base_es
    // context: legend_preemptive_beasts_contract.createScreens.m.Screens.push().start.List.push().text.::Const.LegendMod.Language.arrayToText()
    {
        // text = ::Const.LegendMod.Language.arrayToText(poachers, "and", ::Const.UI.Color.getHighlightDarkBackgroundValue()) + " temporarily join your party",
        mode = "pattern"
        en = "<::Const.LegendMod.Language.arrayToText(poachers, and, ::Const.UI.Color.getHighlightDarkBackgroundValue())> temporarily join your party"
        es = ""
