    // FILE: scripts\items\legend_armor\armor_upgrades\legend_heraldic_plates_upgrade.nut
    // context: legend_heraldic_plates_upgrade.create.m.Description
    {
        en = "A set of large protective plates to be fixed at the shoulders of an armor, a neckguard and a belt."
        es = "Un juego de grandes placas protectoras para fijar en los hombros de una armadura, junto con una gorguera y un cinturón."
    }
    // context: legend_heraldic_plates_upgrade.create.m.ArmorDescription
    {
        en = "Includes a set of shoulderplates, a neckguard and a belt."
        es = "Incluye un juego de hombreras, una gorguera y un cinturón."
