    }
    // FILE: scripts\skills\actives\legend_entice_skill.nut
    // context: legend_entice_skill.create.m.Description
    {
        en = "With a trick of the light, captivate your target in such a way that they can't help but approach you."
        es = "Con un juego de luces, cautiva a tu objetivo de tal manera que no pueda evitar acercarse a ti."
    }
    // context: legend_entice_skill.create.m.Overlay
    // en = "entice"  // identificador del sprite de superposición (m.Overlay), no se muestra
    // context: legend_entice_skill.getTooltip.ret.push().text
    {
