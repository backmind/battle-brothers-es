    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.text
    {
        en = "Make or break camp. While encamped, time will go faster and your mercenaries will heal and repair their equipment at a faster rate. You'll also be able to make use of any camp tents you have unlocked. However, you're also more vulnerable to being caught in a surprise attack."
        es = "Hacer o deshacer el campamento. Mientras estés acampado, el tiempo pasará más rápido y tus mercenarios se curarán y repararán su equipo a un ritmo más rápido. Además, podrás usar las tiendas del campamento que hayas desbloqueado. Sin embargo, también eres más vulnerable a quedar atrapado en un ataque sorpresa."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.push().text
    {
        en = "[color=%negative%]Unable to camp while travelling with other parties[/color]"
        es = "[color=%negative%]No puedes acampar mientras viajas con otros grupos[/color]"
    }
    // en = "Retinue (P)"
    // en base_es
    // en = "See your retinue of non-combat followers that grant various advantages outside combat, and upgrade your cart for more inventory space."
    // en base_es
