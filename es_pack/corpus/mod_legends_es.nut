    // context: tooltip_events.o.general_queryUIElementTooltipData
    {
        en = "\nTool efficiency when repairing damaged items may be increased by recruiting specialized backgrounds. Tool efficiency is capped at [color=%negative%]50%[/color]."
        es = "\nLa eficiencia de las herramientas al reparar objetos dañados puede aumentar si reclutas gente con trasfondos especializados. La eficiencia de las herramientas tiene un límite de [color=%negative%]50%[/color]."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.desc (assets.Supplies)
    {
        // las cuatro piezas de arriba llegan unidas en un solo desc
        mode = "pattern"
        en = "<desc:str>\nItems can be repaired while camping or out in the open. However, in that case, only one item can be repaired at a time per bro.\nYou can carry [color=%positive%]<max:int>[/color] units at most.\nTool efficiency when repairing damaged items may be increased by recruiting specialized backgrounds. Tool efficiency is capped at [color=%negative%]50%[/color]."
        es = "<desc:t>\nLos objetos pueden repararse en el campamento o a la intemperie. Sin embargo, en ese caso, cada hermano solo puede reparar un objeto a la vez.\nPuedes llevar como máximo [color=%positive%]<max>[/color] unidades.\nLa eficiencia de las herramientas al reparar objetos dañados puede aumentar si reclutas gente con trasfondos especializados. La eficiencia de las herramientas tiene un límite de [color=%negative%]50%[/color]."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.push().text
    {
        // text = "[color=%positive%]"+ this.Math.round((1 - toolEfficiency) * 100) + "%[/color] Tool Efficiency"
        mode = "pattern"
        en = "[color=%positive%]<eff:int>%[/color] Tool Efficiency"
        es = "[color=%positive%]<eff>%[/color] de eficiencia de herramientas"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.push().text
    {
        // text = "[color=%positive%]" + this.Math.round(toolEfficiency * 100) + "%[/color] Tool usage percent out"
        mode = "pattern"
        en = "[color=%positive%]<pct:int>%[/color] Tool usage percent out"
        es = "[color=%positive%]<pct>%[/color] de uso de herramientas"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.desc
    {
        // local desc = "Number of tools on hand to repair equipment. One tool is required to repair " + tent.getConversionRate() + " points of item condition. More tools can be purchased in towns or can be salvaged from equipment while camping ";
        mode = "pattern"
        en = "Number of tools on hand to repair equipment. One tool is required to repair <rate:str> points of item condition. More tools can be purchased in towns or can be salvaged from equipment while camping "
        es = "Cantidad de herramientas disponibles para reparar equipo. Se necesita una herramienta para reparar <rate> puntos de estado de un objeto. Puedes comprar más herramientas en las ciudades u obtenerlas desguazando equipo en el campamento "
    }
    // en = "<desc:str>  You can carry <maxarmorparts:int> units at most."
    // en base_es
    // context: tooltip_events.o.general_queryUIElementTooltipData.desc
    {
        // local desc = "Number of tools required to repair the selected equipment. One tool is required to repair " + tent.getConversionRate() + " points of item condition.";
        mode = "pattern"
        en = "Number of tools required to repair the selected equipment. One tool is required to repair <rate:str> points of item condition."
        es = "Cantidad de herramientas necesarias para reparar el equipo seleccionado. Se necesita una herramienta para reparar <rate> puntos de estado de un objeto."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.text
    {
        en = "Required Supplies"
        es = "Suministros necesarios"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.desc
    {
        en = "Number of people assigned to repair duty. The more assigned, the quicker equipment can be repaired."
        es = "Cantidad de gente asignada a las reparaciones. Cuanta más gente asignes, más rápido se podrá reparar el equipo."
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.text
    {
        en = "Assigned Brothers"
        es = "Hermanos asignados"
    }
    // context: tooltip_events.o.general_queryUIElementTooltipData.ret.text
    {
        // text = "Total repair modifier is [color=%positive%]" + repair.Craft + " units per hour[/color]"
        mode = "pattern"
